# The front end's driver: `prism_zero run prismc/*.prism -- FILE [OUT]` reads FILE through
# `Fs.Contents`, lexes and parses it, and writes its tree in `prism_syntax`'s S-expression
# notation, then its diagnostics, through `Fs.Output` to OUT (`FILE.sexp` when OUT is not
# given): byte for byte what `cargo run -p prism_syntax --example dump -- FILE` prints. With
# `--tokens` it writes the tokens in the layout corpus's notation instead, as `dump --tokens`
# does, and with `--fragment` it parses the file as a run of statements (`dump --fragment`).
# A file with a lexical or parse error is written all the same, and then the program gives
# up with the diagnostics, which the CLI World prints before it exits 1.
#
# With `--check FILE...` it parses every file of a program, adds the prelude's files from
# `--prelude DIR` (`prelude` when not given) that the program does not replace, and runs
# the checker (README, Checker): the diagnostics, then a count, go to `--out OUT` when
# given, and the program gives up with them when there is an error. `--world FAM,FAM`
# names the families a World answers, for the root row check. `--typed FILE...` does the
# same and writes the typed program (typed.prism) as S-expressions before the
# diagnostics, which follow it as `;` comments.
#
# Written by Claude, 31 October 2026, on the claude-self-hosting branch. Subject to change:
# Jimmy rewrites it by hand, and an implementer reading it uses their own discretion.
emit Fs.* | Process.* | Prelude.*
use Fs.*
use Ast.*
use Lexer.*
use Parser.*
use Sexp.*
use CheckErrors.*
use CheckTypes.*
use CheckEnv.*
use CheckPasses.*
use Typed
use Lower
use Emit

# What the driver asks of the front end, and what it hands back.
type Job = record:
    tokens: Bool
    fragment: Bool
    text: Text
derive ^Eq, ^Show

type Outcome = record:
    text: Text
    failed: Bool
    report: Text
derive ^Eq, ^Show

# A file the front end refused: its diagnostics are the message.
tag Prismc.Refused of Fault

# The front end over one file, run through `@Run` (decisions.md D7: the parser is
# `unbounded`).
Front: unbounded fn Job -> Outcome
fn Front job:
    if job.tokens:
        let lexed = LexFile job.text
        let report = RenderDiags job.text, lexed.diags
        Outcome(text="{RenderTokens lexed.tokens}{report}\n", failed=(AnyErrors lexed.diags), report=report)
    else:
        let parsed = if job.fragment: ParseFragment job.text else: ParseFile job.text
        let report = RenderDiags job.text, parsed.diags
        Outcome(text="{SexpModule parsed.tree}{report}\n", failed=(AnyErrors parsed.diags), report=report)

# Whether a diagnostic is an error: out-of-scope features are reported and pass.
AnyErrors: fn [Diag] -> Bool
fn AnyErrors ds = Fold ds, False, \|seen, d| seen or d.stage != "out"

# `line:col: message`, one-based, one per line (prism_syntax/src/diag.rs).
RenderDiags: fn Text, [Diag] -> Text
fn RenderDiags text, ds:
    let starts = LineStarts text
    Join (Each ds, \|d| RenderDiag starts, d), "\n"

RenderDiag: fn [Nat], Diag -> Text
fn RenderDiag starts, d:
    let line = LineOf starts, d.span.start
    let col = (Or (d.span.start -? (Or starts[line], 0)), 0) + 1
    let at = "{line + 1}:{col}"
    match d.?feature:
        ? f: "{at}: out of scope ({f}): {d.message}"
        nil: "{at}: {d.message}"

# Where each line begins, as a character offset.
LineStarts: fn Text -> [Nat]
fn LineStarts text:
    let ((starts, ignore)) = Fold (Chars text), (([[0]], 0)), \|((acc, i)), c| if c == "\n": (((Push acc, i + 1), i + 1)) else: ((acc, i + 1))
    starts

# The zero-based line holding an offset: the last line that starts at or before it.
LineOf: fn [Nat], Nat -> Nat
fn LineOf starts, offset = Dec (Fold starts, 0, \|n, s| if s <= offset: n + 1 else: n)

# What the checker is asked to check: the program's files and the prelude's, by path and
# text, and the World's families.
type CheckJob = record:
    files: [((Text, Text))]
    prelude: [((Text, Text))]
    world: [Text]
    typed: Bool
    unused: Bool
derive ^Eq, ^Show

# The prelude's files, as compiler zero supplies them beside the prelude.
let preludeFiles = [["prelude.prism", "ui.prism", "fs.prism", "process.prism", "time.prism", "test.prism", "gui.prism"]]

# The value an option takes: the argument after it.
?OptionValue: fn [Text], Text -> ?Text
fn ?OptionValue args, name = Fold (Range0 (Len args)), nil, \|?found, i| if args[i] == ? name: args[i + 1] else: ?found

# What is wrong with a mode's options: each argument starting with `-` that is neither one
# of `flags` nor one of `valued` (which take the argument after them), and a `valued`
# option with nothing after it. A mode refuses these rather than ignoring them.
BadOptions: fn [Text], [Text], [Text] -> [Text]
fn BadOptions args, flags, valued:
    let ((bad, owed)) = Fold args, (([[]], "")), \|((acc, owed)), a|
        if owed != "": ((acc, ""))
        else: if HasText valued, a: ((acc, a))
        else: if (Take a, 1) == "-" and not (HasText flags, a): (((AddText acc, "unknown option {a}"), ""))
        else: ((acc, ""))
    if owed == "": bad else: AddText bad, "{owed} takes a value"

# Gives up with `message`, as a refused program does.
@Refuse: fn Text -> @unit
fn @Refuse message:
    !started <- @started
    let !~gaveUp: !~unit = Error(kind=Prismc.Refused, message=message) on !started
    ignore <- Prelude.Unwrap(value=!~gaveUp)

# The arguments that are neither options nor the values options take.
PlainArgs: fn [Text] -> [Text]
fn PlainArgs args:
    let takesValue = [["--prelude", "--out", "--world"]]
    let ((kept, ignore)) = Fold args, (([[]], False)), \|((acc, skip)), a|
        if skip: ((acc, False))
        else: if HasText takesValue, a: ((acc, True))
        else: if (Take a, 2) == "--": ((acc, False))
        else: (((Push acc, a), False))
    kept

# The checker over a program: every file parsed, the prelude's files the program does not
# replace (a module of the same name, or a tag of its family, replaces one), then checked.
CheckFiles: unbounded fn CheckJob -> Outcome
fn CheckFiles job:
    let parsed = Each job.files, \|((path, text))| ((path, text, (ParseFile text)))
    let userMods = Fold parsed, [[]], \|acc, ((ignore, ignore, p))| Push acc, (ModName p.tree)
    let userFams = Fold parsed, [[]], \|acc, ((ignore, ignore, p))| Append acc, (TagFamilies p.tree)
    let preParsed = Each job.prelude, \|((path, text))| ((path, text, (ParseFile text)))
    let kept = Filter preParsed, \|((ignore, ignore, p))| not (HasText userMods, (ModName p.tree)) and not (AnyIn (TagFamilies p.tree), userFams)
    let all = Append parsed, kept
    let parseDiags = Fold all, "", \|acc, ((path, text, p))| if AnyErrors p.diags: "{acc}{RenderParse path, text, p.diags}" else: acc
    if parseDiags != "": Outcome(text="{parseDiags}parse errors\n", failed=True, report="{parseDiags}parse errors")
    else:
        let srcs = Each all, \|((path, text, ignore))| MkSrc path, text
        let trees = Each all, \|((ignore, ignore, p))| p.tree
        let report = CheckProgram srcs, trees, job.world, (Len parsed), job.typed, job.unused
        let summary = if report.errors == 0: "no errors\n" else: "{report.errors} error{if report.errors == 1: "" else: "s"}\n"
        let shown = if job.typed: "{Typed.TypedSexp srcs, trees, (Len parsed), report.typed}{Commented "{report.text}{summary}"}" else: "{report.text}{summary}"
        Outcome(text=shown, failed=(report.errors > 0), report="{report.text}{summary}")

# Text as `;` comment lines, after the typed program.
Commented: fn Text -> Text
fn Commented t = Concat (Each (Filter (Split t, "\n"), \|l| l != ""), \|l| "; {l}\n")

TagFamilies: fn Module -> [Text]
fn TagFamilies m = Fold m.decls, [[]], \|acc, d| match d.kind:
    DTag t: Push acc, (Join (Take t.name.path, (Dec (Len t.name.path))), ".")
    otherwise: acc

AnyIn: fn [Text], [Text] -> Bool
fn AnyIn xs, ys = Fold xs, False, \|seen, x| seen or HasText ys, x

RenderParse: fn Text, Text, [Diag] -> Text
fn RenderParse path, text, ds = Concat (Each (Filter ds, \|d| d.stage != "out"), \|d| "{path}:{RenderDiag (LineStarts text), d}\n")

@main:
    args <- Process.Args
    let checking = Fold args, False, \|seen, a| seen or a == "--check" or a == "--typed"
    let compiling = (Or args[0], "") == "compile"
    if compiling: @CompileMain (Drop args, 1)
    else: if checking: @CheckMain args
    else: @FrontMain args

# `--check FILE...`: every file read, then the checker run through `@Run`; an option it
# does not know is refused.
@CheckMain: fn [Text] -> @unit
fn @CheckMain args:
    let bad = BadOptions args, [["--check", "--typed", "--unused"]], [["--prelude", "--out", "--world"]]
    if (Len bad) > 0: @Refuse "{Join bad, "; "} (--check takes --typed, --unused, --prelude DIR, --out FILE, --world W,...)"
    else: @CheckChecked args

@CheckChecked: fn [Text] -> @unit
fn @CheckChecked args:
    let files = PlainArgs args
    let dir = Or (?OptionValue args, "--prelude"), "prelude"
    let ?out = ?OptionValue args, "--out"
    let world = match ?OptionValue args, "--world":
        ? w: Split w, ","
        nil: [[]]
    let prelude = Each preludeFiles, \|f| "{dir}/{f}"
    let paths = Append files, prelude
    $sources <- for p <- paths:
        Fs.Contents(path=p)
    ignore <- rebuild $sources:
        @Check files, prelude, world, ?out, (HasText args, "--typed"), (HasText args, "--unused"), _

# One run of the checker, once every file is read; a prelude file that is missing is left
# out.
@Check: fn [Text], [Text], [Text], ?Text, Bool, Bool, (Nat ==> ~Contents) -> @unit
fn @Check files, prelude, world, ?out, typed, unused, contents:
    let n = Len files
    let texts = Each (Range0 (Len (Append files, prelude))), \|i| ContentsText (Or contents[i], (~ Contents(text="")))
    let mine = Each (Range0 n), \|i| (((Or files[i], ""), (Or texts[i], "")))
    let theirs = Each (Range0 (Len prelude)), \|i| (((Or prelude[i], ""), (Or texts[n + i], "")))
    let present = Filter theirs, \|((ignore, t))| t != ""
    let job = CheckJob(files=mine, prelude=present, world=world, typed=typed, unused=unused)
    !done <- @Run CheckFiles, job
    $?outcome <- nil then ? !done
    ignore <- rebuild $?outcome:
        @FinishCheck ?out, _

ContentsText: fn ~Contents -> Text
fn ContentsText (~ c) = c.text
fn ContentsText (Error(..)) = ""

@FinishCheck: fn ?Text, ?Outcome -> @unit
fn @FinishCheck ?out, nil:
    @ unit
fn @FinishCheck ?out, (? o):
    ignore <- @WriteOut ?out, o.text
    !started <- @started
    let !~verdict = (if o.failed: Error(kind=Prismc.Refused, message=o.report) else: ~ unit) on !started
    ignore <- Prelude.Unwrap(value=!~verdict)

@WriteOut: fn ?Text, Text -> @unit
fn @WriteOut nil, ignore:
    @ unit
fn @WriteOut (? path), text:
    ignore <- Fs.Output(path=path, text=$ text)
    @ unit

# The front end proper: the tree, the tokens or a fragment of one file.
@FrontMain: fn [Text] -> @unit
fn @FrontMain args:
    let tokens = Fold args, False, \|seen, a| seen or a == "--tokens"
    let fragment = Fold args, False, \|seen, a| seen or a == "--fragment"
    let names = Fold args, [[]], \|acc, a| if (Take a, 2) == "--": acc else: Push acc, a
    let file = Or names[0], ""
    let out = Or names[1], "{file}.sexp"
    $~source <- Fs.Contents(path=file)
    ignore <- rebuild $~source:
        @Compile Job(tokens=tokens, fragment=fragment, text=""), file, out, _

# One file, once its contents are read.
@Compile: fn Job, Text, Text, ~Contents -> @unit
fn @Compile job, file, out, (~ c):
    let full = update job:
        &_.text <= c.text
    !done <- @Run Front, full
    $?outcome <- nil then ? !done
    ignore <- rebuild $?outcome:
        @Finish out, _
fn @Compile job, file, out, (Error(message=m, ..)):
    !started <- @started
    let !~gaveUp: !~unit = Error(kind=Prismc.Refused, message="cannot read {file}: {m}") on !started
    ignore <- Prelude.Unwrap(value=!~gaveUp)

# Writes the output, and gives up with the diagnostics when there was an error.
@Finish: fn Text, ?Outcome -> @unit
fn @Finish out, nil:
    @ unit
fn @Finish out, (? o):
    ignore <- Fs.Output(path=out, text=$ o.text)
    !started <- @started
    let !~verdict = (if o.failed: Error(kind=Prismc.Refused, message=o.report) else: ~ unit) on !started
    ignore <- Prelude.Unwrap(value=!~verdict)

# ---------------------------------------------------------------------------------------
# `compile FILES|DIR... -o OUT`: the back end (lower.prism, emit.prism, templates/)
# ---------------------------------------------------------------------------------------

# `compile FILES|DIR... -o OUT [--name NAME] [--prelude DIR] [--runtime PATH] [--target rust|cpp]`: a
# directory stands for every `.prism` and `.prismtest` under it (`Fs.List`, which
# prismc's `Fs` declares); every file is read, with the prelude's files the program does
# not replace; the program is parsed, checked (and refused on an error), lowered and
# emitted through `@Run` as a Rust crate in OUT whose dependencies on `prism_rtl` and the
# Worlds are found at `--runtime PATH` (by default `..` per directory of OUT, so OUT is
# under the repository root); with `--target cpp`, as a C++ program over `runtime/cpp`
# (emit_cpp.prism). A `.prismtest` is read with the `.prism` of its name (pick
# PT of the README). An option it does not know, a target but `rust` or `cpp`, or an
# option with no value after it is refused.
@CompileMain: fn [Text] -> @unit
fn @CompileMain opts:
    let bad = BadOptions opts, [[]], compileValued
    let target = Or (?OptionValue opts, "--target"), "rust"
    if (Len bad) > 0: @Refuse "{Join bad, "; "} (compile takes -o OUT, --name NAME, --prelude DIR, --runtime PATH, --target rust|cpp)"
    else: if target != "rust" and target != "cpp": @Refuse "unknown target {target} (rust, cpp)"
    else: @CompileChecked opts

# The options of `compile` that take a value.
let compileValued = [["-o", "--prelude", "--name", "--runtime", "--target"]]

@CompileChecked: fn [Text] -> @unit
fn @CompileChecked opts:
    let named = CompileFiles opts
    let dirs = Filter named, \|f| not (IsSourcePath f)
    let files = Filter named, \|f| IsSourcePath f
    let out = Or (?OptionValue opts, "-o"), "prismc-out"
    let settings = CompileSettings(out=out, prelude=(Or (?OptionValue opts, "--prelude"), "prelude"), name=(Or (?OptionValue opts, "--name"), "program"), runtime=(Or (?OptionValue opts, "--runtime"), (RuntimeFor out)), target=(Or (?OptionValue opts, "--target"), "rust"))
    $listed <- for d <- dirs:
        Fs.List(dir=d)
    ignore <- rebuild $listed:
        @CompileRead settings, (Append files, (Fold (Values _), [[]], \|acc, l| Append acc, l))

type CompileSettings = record:
    out: Text
    prelude: Text
    name: Text
    runtime: Text
    target: Text
derive ^Eq, ^Show

IsSourcePath: fn Text -> Bool
fn IsSourcePath f = (EndsWithText f, ".prism") or EndsWithText f, ".prismtest"

EndsWithText: fn Text, Text -> Bool
fn EndsWithText t, suffix = (Len t) >= (Len suffix) and (Drop t, (Or ((Len t) -? (Len suffix)), 0)) == suffix

# `..` per directory of OUT, which is relative to the repository root.
RuntimeFor: fn Text -> Text
fn RuntimeFor out:
    let parts = Filter (Split out, "/"), \|p| p != "" and p != "."
    if (Len parts) == 0: "." else: Join (Each parts, \|ignore| ".."), "/"

# The files of a `compile`: the arguments that are neither options nor their values.
CompileFiles: fn [Text] -> [Text]
fn CompileFiles args:
    let ((kept, ignore)) = Fold args, (([[]], False)), \|((acc, skip)), a|
        if skip: ((acc, False))
        else: if HasText compileValued, a: ((acc, True))
        else: if (Take a, 1) == "-": ((acc, False))
        else: (((Push acc, a), False))
    kept

# Every source read, then the compile through `@Run`.
@CompileRead: fn CompileSettings, [Text] -> @unit
fn @CompileRead settings, files:
    let prelude = Each preludeFiles, \|f| "{settings.prelude}/{f}"
    $sources <- for p <- (Append files, prelude):
        Fs.Contents(path=p)
    ignore <- rebuild $sources:
        @CompileAll settings, files, prelude, _

# What the back end is asked to compile, and what it gives back.
type CompileJob = record:
    files: [((Text, Text))]
    prelude: [((Text, Text))]
    name: Text
    runtime: Text
    target: Text
derive ^Eq, ^Show

type Compiled = record:
    files: [((Text, Text))]
    failed: Bool
    report: Text
derive ^Eq, ^Show

@CompileAll: fn CompileSettings, [Text], [Text], (Nat ==> ~Contents) -> @unit
fn @CompileAll settings, files, prelude, contents:
    let n = Len files
    let texts = Each (Range0 (Len (Append files, prelude))), \|i| ContentsText (Or contents[i], (~ Contents(text="")))
    let mine = Each (Range0 n), \|i| (((Or files[i], ""), (Or texts[i], "")))
    let theirs = Each (Range0 (Len prelude)), \|i| (((Or prelude[i], ""), (Or texts[n + i], "")))
    let present = Filter theirs, \|((ignore, t))| t != ""
    !done <- @Run CompileProgram, CompileJob(files=mine, prelude=present, name=settings.name, runtime=settings.runtime, target=settings.target)
    $?outcome <- nil then ? !done
    ignore <- rebuild $?outcome:
        @FinishCompile settings.out, _

# The back end over a program: its `.prismtest`s joined to their `.prism`s, every file
# parsed, the prelude's files it does not replace, the checker (refusing on an error, as
# `--check` reports it), then lowering and emission.
CompileProgram: unbounded fn CompileJob -> Compiled
fn CompileProgram job:
    let tests = Filter job.files, \|((p, ignore))| EndsWithText p, ".prismtest"
    let progs = Filter job.files, \|((p, ignore))| not (EndsWithText p, ".prismtest")
    let joined = Each progs, \|((p, t))| ((p, (WithTests p, t, tests)))
    let parsed = Each joined, \|((path, text))| ((path, text, (ParseFile text)))
    let userMods = Fold parsed, [[]], \|acc, ((ignore, ignore, pr))| Push acc, (ModName pr.tree)
    let userFams = Fold parsed, [[]], \|acc, ((ignore, ignore, pr))| Append acc, (TagFamilies pr.tree)
    let preParsed = Each job.prelude, \|((path, text))| ((path, text, (ParseFile text)))
    let kept = Filter preParsed, \|((ignore, ignore, pr))| not (HasText userMods, (ModName pr.tree)) and not (AnyIn (TagFamilies pr.tree), userFams)
    let all = Append parsed, kept
    let parseDiags = Fold all, "", \|acc, ((path, text, pr))| if AnyErrors pr.diags: "{acc}{RenderParse path, text, pr.diags}" else: acc
    if parseDiags != "": Compiled(files=[[]], failed=True, report="{parseDiags}parse errors")
    else:
        let srcs = Each all, \|((path, text, ignore))| MkSrc path, text
        let trees = Each all, \|((ignore, ignore, pr))| pr.tree
        let report = CheckProgram srcs, (Each trees, \|t| WithoutTests t), [[]], (Len parsed), True, False
        if report.errors > 0: Compiled(files=[[]], failed=True, report="{report.text}{report.errors} error{if report.errors == 1: "" else: "s"}")
        else:
            let model = Lower.LowerProgram srcs, trees, (Len parsed), report.typed, job.name
            let scripts = Each tests, \|((p, ignore))| p
            let files = if job.target == "cpp": EmitCpp.EmitCpp model, job.runtime, scripts else: Emit.EmitCrate model, job.runtime, scripts
            let refused = Fold files, [[]], \|acc, ((path, text))| Fold (Refusals text), acc, \|a, r| AddText a, "{path}: {r}"
            if (Len refused) == 0: Compiled(files=files, failed=False, report="")
            else: Compiled(files=files, failed=True, report="{Concat (Each refused, \|r| "error[not-lowered]: {r}\n")}{Len refused} construct{if (Len refused) == 1: "" else: "s"} the back end does not lower (the crate is written, with a `compile_error!` at each)")

# What lowering refused, as the emitted text marks it (`Lower.Refusal`, whose words these
# are): each distinct message once.
Refusals: fn Text -> [Text]
fn Refusals text:
    let marker = "compile_error!(\"prismc does not lower "
    let parts = Split text, marker
    Fold (Drop parts, 1), [[]], \|acc, part| AddText acc, (Or (Split part, "\")")[0], part)

# A tree without its `test` declarations: the checker reads a test's blueprint by its
# root's signature, which a `@name:` block has none of, so tests are checked by running
# them (pick PT); `check` blocks stay, and are checked.
WithoutTests: fn Module -> Module
fn WithoutTests m = update m:
    &_.decls <= Each (Filter &_.decls, \|d| not (IsTestDecl d)), \|d| WithoutPatterns d

# A `check` line's pattern is the Test World's to read from the script, not the
# checker's: the line's expression is checked alone (pick PT).
WithoutPatterns: fn Decl -> Decl
fn WithoutPatterns d = match d.kind:
    DCheck c: update d:
        &_.kind <= DCheck (CheckWithoutPatterns c)
    otherwise: d

CheckWithoutPatterns: fn CheckDecl -> CheckDecl
fn CheckWithoutPatterns c = update c:
    &_.lines <= Each &_.lines, \|l| LineWithoutPattern l

LineWithoutPattern: fn CheckLine -> CheckLine
fn LineWithoutPattern l = update l:
    &_.pattern <= nil

IsTestDecl: fn Decl -> Bool
fn IsTestDecl d = match d.kind:
    DTest ignore: True
    otherwise: False

# A `.prism` file's text with the `.prismtest` of its name after it: a test script holds
# declarations of its module (examples/README.md) and has no `module` line of its own.
WithTests: fn Text, Text, [((Text, Text))] -> Text
fn WithTests path, text, tests:
    let stem = Take path, (Or ((Len path) -? 6), 0)
    Fold tests, text, \|acc, ((tp, tt))| if tp == "{stem}.prismtest": "{acc}\n{tt}" else: acc

# Writes the crate, and gives up with the diagnostics when the compile failed.
@FinishCompile: fn Text, ?Compiled -> @unit
fn @FinishCompile out, nil:
    @ unit
fn @FinishCompile out, (? o):
    ignore <- for ((path, text)) <- o.files:
        Fs.Output(path="{out}/{path}", text=$ text)
    !started <- @started
    let !~verdict = (if o.failed: Error(kind=Prismc.Refused, message=o.report) else: ~ unit) on !started
    ignore <- Prelude.Unwrap(value=!~verdict)
