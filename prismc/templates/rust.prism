# The Rust template set (Templates ch. 2, code templates; Compiler ch. 4, "Templates, and
# two template sets"): every item of the emitted Rust as a function-form template with
# doubled braces. A placeholder alone on its line stands for whole lines indented to its
# column, so a nested piece comes out indented as written. The templates decide nothing
# (K9): lowering decided, emit.prism spelled each part and chose the template.
#
# Written by Claude, 1 November 2026, on the claude-self-hosting branch. Subject to change:
# Jimmy rewrites it by hand, and an implementer reading it uses their own discretion.
module RustTemplates
emit r

# ---------------------------------------------------------------------------------------
# Comments
# ---------------------------------------------------------------------------------------

# A doc comment: each line of `text` after `///`.
TmDoc: fn Text -> Text
fn TmDoc text = if text == "": "" else: Concat (Each (Split text, "\n"), \|l| if l == "": "///\n" else: "/// {l}\n")

# A doc comment that quotes Prism source.
TmSourceDoc: fn Text, Text -> Text
fn TmSourceDoc lead, source = if lead == "": TmSourceOnly source else: TmSourceLed lead, source

TmSourceOnly: fn Text -> Text
fn TmSourceOnly source = inline_text <rust>
/// ```prism
<@TmQuoted text={{source}}/>
/// ```
</rust>

TmSourceLed: fn Text, Text -> Text
fn TmSourceLed lead, source = inline_text <rust>
/// {{lead}}
///
/// ```prism
<@TmQuoted text={{source}}/>
/// ```
</rust>

TmQuoted: fn Text -> Text
fn TmQuoted text = TmJoin (Each (Split text, "\n"), \|l| if l == "": "///" else: "/// {l}"), "\n"

TmJoin: fn [Text], Text -> Text
fn TmJoin xs, sep = Drop (Concat (Each xs, \|x| "{sep}{x}")), (Len sep)

# ---------------------------------------------------------------------------------------
# Files
# ---------------------------------------------------------------------------------------

# One Prism module's Rust module.
TmModule: fn Text, Text, Text, Text -> Text
fn TmModule prism, path, uses, items = inline_text <rust>
//! {{prism}}, from `{{path}}`, emitted by prismc: one Rust type per Prism type, a node
//! per root widget (docs/backend.md). Edit the Prism source, not this file.

use std::cell::{Cell, RefCell};
use std::rc::{Rc, Weak};

use prism_rtl::*;
use prism_rtl::pod::mismatch;

use crate::prelude::*;
{{uses}}

{{items}}
</rust>

# `Cargo.toml`: the library and the two Worlds, by path; the canvas World behind a feature,
# on by default for a program whose root emits `Gui`.
TmCargo: fn Text, Text, Text -> Text
fn TmCargo name, runtime, defaults = inline_text <rust>
# Emitted by prismc. Edit the Prism sources, not this file.
[package]
name = "{{name}}"
version = "0.1.0"
edition = "2024"

[workspace]

[[bin]]
name = "{{name}}"
path = "src/main.rs"

[dependencies]
prism_rtl = { path = "{{runtime}}/prism_runtime_lib" }
prism_world_cli = { path = "{{runtime}}/worlds/cli" }
prism_world_canvas_rtl = { path = "{{runtime}}/worlds/canvas_rtl", optional = true }

[features]
default = [{{defaults}}]
canvas = ["prism_world_canvas_rtl"]
</rust>

# `main.rs`: the modules, the programs, the Test World's registrations, and `main`, which
# picks the World (docs/backend.md: `Gui.*` at the root is the canvas, else the CLI;
# `--world` overrides; `test` runs the scripts under the Test World).
TmMain: fn Text, Text, Text, Text, Text, Text, Text -> Text
fn TmMain name, mods, programs, registrations, scripts, runRoot, world = inline_text <rust>
//! The program `{{name}}`, emitted by prismc from Prism (docs/backend.md): a crate over
//! `prism_rtl`, run under the CLI World, the canvas World or the Test World. Edit the
//! Prism sources, not these files.
#![allow(dead_code, unused_variables, unused_imports, unused_mut, unused_parens, unused_braces)]
#![allow(unreachable_patterns, unreachable_code, unused_labels, non_snake_case, non_camel_case_types)]
#![allow(clippy::all)]

{{mods}}

use std::rc::Rc;

use prism_rtl::*;

use crate::prelude::*;

{{programs}}

/// The Test World with every root a test names, and the compiled `check` blocks.
fn test_world() -> TestWorld {
    TestWorld::new()
        {{registrations}}
}

/// The test scripts compiled with the program: `test` runs these when given none.
const SCRIPTS: &[&str] = &[
    {{scripts}}
];

/// The World the root's row asks for.
const WORLD: &str = "{{world}}";

fn main() {
    let args: Vec<String> = std::env::args().skip(1).collect();
    let (world, rest) = prelude::world_option(&args, WORLD);
    let code = if args.first().map(String::as_str) == Some("test") || world == "test" {
        let scripts: Vec<String> = rest.into_iter().filter(|a| a != "test").collect();
        prelude::on_big_stack(move || prelude::run_scripts(&test_world(), &scripts, SCRIPTS))
    } else {
        run_root(&world, rest)
    };
    std::process::exit(code as i32);
}

/// The root under the World `world`.
fn run_root(world: &str, args: Vec<String>) -> u8 {
    {{runRoot}}
}
</rust>

# A `main` with no root: only the tests run.
TmNoRoot: fn Text -> Text
fn TmNoRoot name = inline_text <rust>
let _ = (world, args);
eprintln!("{{name}}: the program has no `@main`; `{{name}} test` runs its tests");
2
</rust>

# A root under the World its row asks for, or the one `--world` names.
TmRunRoot: fn Text -> Text
fn TmRunRoot program = inline_text <rust>
match world {
    "canvas" => prelude::run_canvas::<{{program}}>(),
    _ => prelude::on_big_stack(move || prism_world_cli::run::<{{program}}>(args)),
}
</rust>

