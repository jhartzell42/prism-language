</rust>

Build: fn Text, Text, Text, Text, Text, Text -> Text
fn Build name, params, ret, lets, inits, rest = inline_text <rust>
/// Built after propagation: holds take their initial values, places go out with
/// `cx.added`, and nothing fires.
pub fn build(path: Path, {{params}}cx: &mut Cx) -> {{ret}} {
    {{lets}}
    let node = Rc::new({{name}} { {{inits}} });
    {{rest}}
}
</rust>

Method: fn Text, Text, Text -> Text
fn Method doc, signature, body = inline_text <rust>
{{doc}}
{{signature}} {
    {{body}}
}
</rust>

# A `for`'s builder (docs/backend.md, "Dynamic structure"), run at the build and in the
# build list after a tick that changed its source, once. A kept row reads its entry through
# the block's `{{source}}` getter at its own read point: the builder writes nothing to it. A
# host's rows are built the same way over its child's document, with the host as their
# parent (pick HO).
ForBuild: fn Text, Text, Text, Text, Text, Text, Text, Text -> Text
fn ForBuild name, at, keyTy, valueTy, rowNode, source, parent, passed = inline_text <rust>
/// The rows of the `for` at `{{at}}`: rows whose key left are torn down, new keys are
/// built under it at `[k]` from the values after the tick; kept rows keep reading their
/// entry out of the source.
fn {{name}}_build(self: &Rc<Self>, cx: &mut Cx) -> Done {
    let items: Map<{{keyTy}}, {{valueTy}}> = self.{{source}}(cx);
    let old = self.{{name}}.borrow().clone();
    for (k, row) in old.iter() {
        if !items.contains_key(k) {
            row.leave_row(cx);
            cx.leave_later(row.clone());
        }
    }
    let mut next = Map::new();
    for (k, v) in items.iter() {
        let row = match old.get(k) {
            Some(row) => row.clone(),
            None => {{rowNode}}::build({{at}}.child(Segment::Key(k.to_pod())), k.clone(), v.clone(), {{parent}}{{passed}}, cx)?,
        };
        next.insert(k.clone(), row);
    }
    *self.{{name}}.borrow_mut() = next;
    // What the block reads of its rows (a `for` that gives a dynamic) moved.
    cx.dirty(self.clone());
    Ok(())
}
</rust>

# A `rebuild`'s builder: one generation at a time, at `{{pos}}/#g` (a widget of several
# clauses in a static position: at its caller's path).
GenBuild: fn Text, Text, Text, Text, Text, Text -> Text
fn GenBuild name, at, path, source, valueTy, select = inline_text <rust>
/// The `rebuild` at `{{at}}`: the old generation torn down (it ran to the end of the
/// tick), the next built at `{{path}}` from the source after the tick.
fn {{name}}_build(self: &Rc<Self>, cx: &mut Cx) -> Done {
    if let Some(old) = self.{{name}}.borrow_mut().take() {
        old.leave_row(cx);
        cx.leave_later(old);
    }
    let g = self.{{name}}_count.get();
    self.{{name}}_count.set(g + 1);
    let path = {{path}};
    let value: {{valueTy}} = {{source}};
    let row: Rc<dyn Row> = {{select}};
    *self.{{name}}.borrow_mut() = Some(row);
    Ok(())
}
</rust>

# A row's leaving: a `for` row keeps its entry's last value first (R8), its places are torn
# down, its subscriptions let go. A hosted row's `Row` methods follow (pick HO): its typed
# `deliver`, its `document`, its `document_moved`.
RowImpl: fn Text, Text, Text -> Text
fn RowImpl name, leaving, hosted = inline_text <rust>
impl Row for {{name}} {
    fn leave_row(&self, cx: &mut Cx) {
        {{leaving}}
    }
    {{hosted}}
}
</rust>

# `crate::Answer` (pick HO): an answer to an element, typed by its tag; a World's answer to
# a forwarded element decodes into it by the element's tag.
AnswerType: fn Text, Text, Text, Text -> Text
fn AnswerType cases, tags, accessors, decodes = inline_text <rust>
/// `Answer c`: an answer to an element, typed by its tag (Semantics ch. 9): what a host's
/// supplier answers a child place with, and what a World's answer to a forwarded element
/// decodes to, carrying the tag's output.
#[derive(Clone)]
pub enum Answer {
    {{cases}}
}

impl Answer {
    /// The tag the answer is for.
    pub fn tag(&self) -> &'static str {
        match self {
            {{tags}}
        }
    }
    {{accessors}}
}

impl prism_rtl::AnswerOf<Elem> for Answer {
    /// A World's answer to the element `e`, decoded by its tag.
    fn decode(e: &Elem, v: &Pod) -> Result<Answer, Fault> {
        match e {
            {{decodes}}
        }
    }
}
</rust>

# One accessor of `Answer`: the tag's value, or a fault naming the tag the answer was for.
AnswerGetter: fn Text, Text, Text, Text -> Text
fn AnswerGetter accessor, variant, tagName, ty = inline_text <rust>
/// A `{{tagName}}`'s answer.
pub fn {{accessor}}(&self) -> Result<{{ty}}, Fault> {
    match self {
        Answer::{{variant}}(v) => Ok(v.clone()),
        other => Err(Fault::answer(format!("an answer for {}, where {{tagName}}'s was expected", other.tag()))),
    }
}
</rust>

Answer: fn Text -> Text
fn Answer arms = inline_text <rust>
fn answer(self: Rc<Self>, at: &[Segment], v: &Pod, cx: &mut Cx) -> Done {
    match at {
        {{arms}}
        _ => return Err(Fault::answer(format!("no answering place at {}", Path(at.to_vec())))),
    }
    Ok(())
}
</rust>

Hook: fn Text, Text -> Text
fn Hook name, body = inline_text <rust>
fn {{name}}(self: Rc<Self>, cx: &mut Cx) -> Done {
    {{body}}
    Ok(())
}
</rust>

# A push to a place whose element answers a dynamic (`Node::push`, keyed by the element).
PushHook: fn Text -> Text
fn PushHook body = inline_text <rust>
fn push(self: Rc<Self>, element: &Pod, v: &Pod, cx: &mut Cx) -> Done {
    {{body}}
    Ok(())
}
</rust>

# The program around a root node, as every World drives it.
Program: fn Text, Text, Text, Text, Text -> Text
fn Program name, prism, node, decode, call = inline_text <rust>
/// The program of `@{{prism}}`: the root node and the runtime.
pub struct {{name}} {
    rt: Runtime,
    root: Rc<{{node}}>,
}

impl Program for {{name}} {
    fn build(args: &[Pod], ready: &dyn ReadyState) -> Result<(Self, TickOut), Fault> {
        {{decode}}
        let mut rt = Runtime::new();
        let mut cx = rt.build(ready);
        let root = {{call}};
        let out = rt.close(cx)?;
        Ok(({{name}} { rt, root }, out))
    }
    fn tick(&mut self, input: &TickIn, ready: &dyn ReadyState) -> Result<TickOut, Fault> {
        let root: Rc<dyn Node> = self.root.clone();
        self.rt.tick(&root, input, ready)
    }
    fn compact(&mut self) {
        self.rt.compact();
    }
}
</rust>

