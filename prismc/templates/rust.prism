# A record as a struct.
TmStruct: fn Text, Text, Text, Text -> Text
fn TmStruct doc, derives, head, fields = inline_text <rust>
{{doc}}
#[derive({{derives}})]
pub struct {{head}} {
    {{fields}}
}
</rust>

# A choice as an enum.
TmEnum: fn Text, Text, Text, Text -> Text
fn TmEnum doc, derives, head, cases = inline_text <rust>
{{doc}}
#[derive({{derives}})]
pub enum {{head}} {
    {{cases}}
}
</rust>

# A newtype as a tuple struct, a unit type as a unit struct.
TmTupleStruct: fn Text, Text, Text, Text -> Text
fn TmTupleStruct doc, derives, head, fields = inline_text <rust>
{{doc}}
#[derive({{derives}})]
pub struct {{head}}{{fields}};
</rust>

# An impl of a trait with one method.
TmImpl: fn Text, Text, Text, Text, Text -> Text
fn TmImpl generics, tr, ty, signature, body = inline_text <rust>
impl{{generics}} {{tr}} for {{ty}} {
    {{signature}} {
        {{body}}
    }
}
</rust>

# A `match self` of one arm per case.
TmMatchSelf: fn Text -> Text
fn TmMatchSelf arms = inline_text <rust>
match self {
    {{arms}}
}
</rust>

# A type with its own `^Show` crosses as its text and its structure (docs/backend.md,
# "Printing"): a key prints `0/[e2]/0` and still matches structurally.
TmShownPod: fn Text -> Text
fn TmShownPod structure = inline_text <rust>
let structure = {
    {{structure}}
};
Pod::Shown(show(self).as_str().into(), Box::new(structure))
</rust>

# A derived `FromPod`: the structure matched case by case.
TmFromPod: fn Text, Text -> Text
fn TmFromPod arms, want = inline_text <rust>
match p.structure() {
    {{arms}}
    other => mismatch("{{want}}", other),
}
</rust>

# A tag's struct: an element tag's `Level`, or a plain row value's fields.
TmTag: fn Text, Text, Text, Text, Text, Text -> Text
fn TmTag doc, derives, name, fields, tagName, pods = inline_text <rust>
{{doc}}
#[derive({{derives}})]
pub struct {{name}} {
    {{fields}}
}

impl {{name}} {
    /// The tag's qualified name, as its `Pod` carries it.
    pub const TAG: &'static str = "{{tagName}}";
}

impl ToPod for {{name}} {
    fn to_pod(&self) -> Pod {
        Pod::element("{{tagName}}", vec![{{pods}}])
    }
}

impl Show for {{name}} {
    fn show(&self, p: &mut Printer) {
        self.to_pod().show(p);
    }
}
</rust>

# A tag's struct read back from its `Pod`.
TmTagFromPod: fn Text, Text, Text -> Text
fn TmTagFromPod name, tagName, reads = inline_text <rust>
impl FromPod for {{name}} {
    fn from_pod(p: &Pod) -> Result<Self, Fault> {
        match p.tag() {
            Some("{{tagName}}") => Ok({{name}} { {{reads}} }),
            _ => prism_rtl::pod::mismatch("a {{tagName}}", p),
        }
    }
}
</rust>

# A row kind's enum: a variant per tag (pick RV).
TmRow: fn Text, Text, Text, Text, Text -> Text
fn TmRow doc, derives, name, cases, pods = inline_text <rust>
{{doc}}
#[derive({{derives}})]
pub enum {{name}} {
    {{cases}}
}

impl ToPod for {{name}} {
    fn to_pod(&self) -> Pod {
        match self {
            {{pods}}
        }
    }
}

impl Show for {{name}} {
    fn show(&self, p: &mut Printer) {
        self.to_pod().show(p);
    }
}
</rust>

TmRowFromPod: fn Text, Text -> Text
fn TmRowFromPod name, reads = inline_text <rust>
impl FromPod for {{name}} {
    fn from_pod(p: &Pod) -> Result<Self, Fault> {
        match p.tag() {
            {{reads}}
            _ => prism_rtl::pod::mismatch("a {{name}}", p),
        }
    }
}
</rust>

# ---------------------------------------------------------------------------------------
# Functions and jobs
# ---------------------------------------------------------------------------------------

TmFn: fn Text, Text, Text -> Text
fn TmFn doc, signature, body = inline_text <rust>
{{doc}}
{{signature}} {
    {{body}}
}
</rust>

# An unbounded function's step machine (D6): the job stopped at a cycle point, its
# `cycle`, and its `Start`.
TmJob: fn Text, Text, Text, Text, Text, Text, Text, Text, Text -> Text
fn TmJob doc, head, generics, bounded, fields, ret, body, start, startBody = inline_text <rust>
/// The step machine of `{{head}}`, stopped at a cycle point: the call about to be
/// entered. A tail call leaves no frame; any other call waits in a `Frame` around the
/// callee's job, so the job's stack is its frames.
///
{{doc}}
pub struct {{head}}{{generics}} {
    {{fields}}
}

impl{{bounded}} prism_rtl::Job<{{ret}}> for {{head}}{{generics}} {
    fn cycle(&self) -> prism_rtl::Turn<{{ret}}> {
        {{body}}
    }
}

/// `Start {{head}}, x`: what the function value is when passed to `@Run`.
{{start}} {
    {{startBody}}
}
</rust>

# ---------------------------------------------------------------------------------------
# Nodes
# ---------------------------------------------------------------------------------------

# A widget block's node: the struct, its constructor and methods, and the `Node` hooks.
TmNode: fn Text, Text, Text, Text, Text, Text, Text, Text -> Text
fn TmNode doc, name, fields, consts, build, methods, hooks, answer = inline_text <rust>
{{doc}}
pub struct {{name}} {
    path: Path,
    {{fields}}
}

impl {{name}} {
    {{consts}}
    {{build}}
    {{methods}}
}

impl Node for {{name}} {
    {{answer}}
    {{hooks}}
}
</rust>

TmBuild: fn Text, Text, Text, Text, Text, Text -> Text
fn TmBuild name, params, ret, lets, inits, rest = inline_text <rust>
/// Built after propagation: holds take their initial values, places go out with
/// `cx.added`, and nothing fires.
pub fn build(path: Path, {{params}}cx: &mut Cx) -> {{ret}} {
    {{lets}}
    let node = Rc::new({{name}} { {{inits}} });
    {{rest}}
}
</rust>

TmMethod: fn Text, Text, Text -> Text
fn TmMethod doc, signature, body = inline_text <rust>
{{doc}}
{{signature}} {
    {{body}}
}
</rust>

# A `for`'s builder (docs/backend.md, "Dynamic structure"), run at the build and in the
# build list after a tick that changed its source.
TmForBuild: fn Text, Text, Text, Text, Text, Text, Text -> Text
fn TmForBuild name, pos, source, keyTy, valueTy, rowNode, passed = inline_text <rust>
/// The rows of the `for` at place {{pos}}: rows whose key left are torn down, new keys
/// are built at `{{pos}}/[k]`, kept rows hear their entry; from the values after the tick.
fn {{name}}_build(self: &Rc<Self>, cx: &mut Cx) -> Done {
    let items: Map<{{keyTy}}, {{valueTy}}> = {{source}};
    let old = self.{{name}}.borrow().clone();
    for (k, row) in old.iter() {
        if !items.contains_key(k) {
            row.leave_row(cx);
            cx.leave_later(row.clone());
        }
    }
    let mut next = Map::new();
    for (k, v) in items.iter() {
        let row = match old.get(k) {
            Some(row) => {
                row.update(v.clone(), cx);
                row.clone()
            }
            None => {{rowNode}}::build(self.path.at({{pos}}).child(Segment::Key(k.to_pod())), k.clone(), v.clone(), Rc::downgrade(self){{passed}}, cx)?,
        };
        next.insert(k.clone(), row);
    }
    *self.{{name}}.borrow_mut() = next;
    Ok(())
}
</rust>

# A `rebuild`'s builder: one generation at a time, at `{{pos}}/#g`.
TmGenBuild: fn Text, Text, Text, Text, Text -> Text
fn TmGenBuild name, pos, source, valueTy, select = inline_text <rust>
/// The `rebuild` at place {{pos}}: the old generation torn down (it ran to the end of the
/// tick), the next built at `{{pos}}/#g` from the source after the tick.
fn {{name}}_build(self: &Rc<Self>, cx: &mut Cx) -> Done {
    if let Some(old) = self.{{name}}.borrow_mut().take() {
        old.leave_row(cx);
        cx.leave_later(old);
    }
    let g = self.{{name}}_count.get();
    self.{{name}}_count.set(g + 1);
    let path = self.path.at({{pos}}).child(Segment::Gen(g));
    let value: {{valueTy}} = {{source}};
    let row: Rc<dyn Row> = {{select}};
    *self.{{name}}.borrow_mut() = Some(row);
    Ok(())
}
</rust>

# A row's leaving.
TmRowImpl: fn Text, Text -> Text
fn TmRowImpl name, unsubscribe = inline_text <rust>
impl Row for {{name}} {
    fn leave_row(&self, cx: &mut Cx) {
        self.remove_places(cx);
        {{unsubscribe}}
    }
}
</rust>

TmAnswer: fn Text -> Text
fn TmAnswer arms = inline_text <rust>
fn answer(self: Rc<Self>, at: &[Segment], v: &Pod, cx: &mut Cx) -> Done {
    match at {
        {{arms}}
        _ => return Err(Fault::answer(format!("no answering place at {}", Path(at.to_vec())))),
    }
    Ok(())
}
</rust>

TmHook: fn Text, Text -> Text
fn TmHook name, body = inline_text <rust>
fn {{name}}(self: Rc<Self>, cx: &mut Cx) -> Done {
    {{body}}
    Ok(())
}
</rust>

# The program around a root node, as every World drives it.
TmProgram: fn Text, Text, Text, Text, Text -> Text
fn TmProgram name, prism, node, decode, call = inline_text <rust>
/// The program of `@{{prism}}`: the root node and the runtime.
pub struct {{name}} {
    rt: Runtime,
    root: Rc<{{node}}>,
}

impl Program for {{name}} {
    fn build(args: &[Pod], ready: &dyn ReadyState) -> Result<(Self, TickOut), Fault> {
        {{decode}}
        let mut rt = Runtime::new();
        let mut cx = rt.build(ready);
        let root = {{call}};
        let out = rt.close(cx)?;
        Ok(({{name}} { rt, root }, out))
    }
    fn tick(&mut self, input: &TickIn, ready: &dyn ReadyState) -> Result<TickOut, Fault> {
        let root: Rc<dyn Node> = self.root.clone();
        self.rt.tick(&root, input, ready)
    }
    fn compact(&mut self) {
        self.rt.compact();
    }
}
</rust>

