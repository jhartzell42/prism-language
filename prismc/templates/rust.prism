{{doc}}
#[derive({{derives}})]
pub enum {{name}} {
    {{cases}}
}

impl ToPod for {{name}} {
    fn to_pod(&self) -> Pod {
        match self {
            {{pods}}
        }
    }
}

impl Show for {{name}} {
    fn show(&self, p: &mut Printer) {
        self.to_pod().show(p);
    }
}
</rust>

RowFromPod: fn Text, Text -> Text
fn RowFromPod name, reads = inline_text <rust>
impl FromPod for {{name}} {
    fn from_pod(p: &Pod) -> Result<Self, Fault> {
        match p.tag() {
            {{reads}}
            _ => prism_rtl::pod::mismatch("a {{name}}", p),
