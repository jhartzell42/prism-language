# The separate checkers (Type System ch. 5, "The separate checkers, in order"), run over
# the elaborated program after inference, a definition that failed inference skipped: the
# prompt-cycle check per block with its summaries, the shrink check by the size-change
# principle with the `unbounded` color and D6's cycle rule, borrows and escapes in `&`
# blocks, the element bind table's remaining rows, inclusion with the forwarding-arm
# remainder, the root row, the full-stack name check (most of it made where each name is
# bound), and exhaustiveness over rows and choices (Maranget's usefulness, from memory).
# `CheckProgram` runs the whole checker over a program's files.
#
# Written by Claude, 31 October 2026, on the claude-self-hosting branch. Subject to change:
# Jimmy rewrites it by hand, and an implementer reading it uses their own discretion.
module CheckPasses
emit r
use Ast.*
use Lexer.*
use CheckErrors.*
use CheckTypes.*
use CheckEnv.*
use CheckExpr.*
use CheckBlocks.*
use Typed.*

# ---------------------------------------------------------------------------------------
# Exhaustiveness and reachability
# ---------------------------------------------------------------------------------------

# A pattern as the usefulness check reads it: anything, a constructor with its arguments,
# a literal (which never covers its type), a family arm (which matches its family's tags).
type Pat = choice:
    PtAny
    PtCon Text, [Pat]
    PtLit Text
    PtFam Text
derive ^Eq, ^Show

# A constructor of a type: its name as patterns spell it, its arity, its argument types,
# how a witness prints it.
type Ctor = record:
    name: Text
    arity: Nat
    args: [Ty]
    shown: Text
derive ^Eq, ^Show

# The constructors of a type when it has finitely many: a choice's, `Bool`'s, an optional's,
# a fault's, a tuple's, a record's, `unit`'s, a closed row's tags. `nil` for a type no
# finite set of constructors covers (numbers, texts, arrays, functions, open rows).
?CtorsOf: unbounded fn Env, St, Ty -> ?[Ctor]
fn ?CtorsOf env, st, t = match Walk st, t:
    TyCon "Bool", [[]]: ? [[Ctor(name="True", arity=0, args=[[]], shown="True"), Ctor(name="False", arity=0, args=[[]], shown="False")]]
    TyCon "unit", [[]]: ? [[Ctor(name="unit", arity=0, args=[[]], shown="unit")]]
    TySig "?", i: ? [[Ctor(name="?", arity=1, args=[[i]], shown="? _"), Ctor(name="nil", arity=0, args=[[]], shown="nil")]]
    TySig "~", i: ? [[Ctor(name="~", arity=1, args=[[i]], shown="~ _"), Ctor(name="Error", arity=2, args=[[(TyCon "Prelude.Fault", [[]]), tText]], shown="Error(..)")]]
    TyTuple ts: ? [[Ctor(name="tuple", arity=(Len ts), args=ts, shown="(({Join (Each ts, \|ignore| "_"), ", "}))")]]
    TyCon "Prelude.Error", [[]]: ? [[Ctor(name="Error", arity=2, args=[[(TyCon "Prelude.Fault", [[]]), tText]], shown="Error(..)")]]
    TyCon n, args: match env.g.types[n]:
        ? ti: match ti.body:
            BChoice cases: ? (Each cases, \|((cn, cargs))| CtorOfCase ti, cn, cargs, args)
            BRecord fields: ? [[Ctor(name=n, arity=(Len fields), args=(Each fields, \|((ignore, ft))| SubstQ (ParamInst ti.params, args), ft), shown="{BareName n}(..)")]]
            BRowKind: if IsRootModule env: ? (Each (TagsOfKind env, n), \|tg| TagCtor tg) else: nil
            otherwise: nil
        nil: if n == "Fault" or n == "Prelude.Fault": (if IsRootModule env: ? (Each (TagsOfKind env, "Prelude.Fault"), \|tg| TagCtor tg) else: nil) else: nil
    TyElem rw, ignore:
        let w = WalkRow st, rw
        if w.tail != TlClosed: nil
        else: ? (Each (TagsOfRow env, w), \|tg| TagCtor tg)
    TyElemAny rw:
        let w = WalkRow st, rw
        if w.tail != TlClosed: nil
        else: ? (Each (TagsOfRow env, w), \|tg| TagCtor tg)
    otherwise: nil

CtorOfCase: unbounded fn TyInfo, Text, [Ty], [Ty] -> Ctor
fn CtorOfCase ti, cn, cargs, args:
    let qk = QualKey ti.home, cn
    Ctor(name=qk, arity=(Len cargs), args=(Each cargs, \|a| SubstQ (ParamInst ti.params, args), a), shown=(if (Len cargs) == 0: cn else: "{cn} {Join (Each cargs, \|ignore| "_"), ", "}"))

TagCtor: fn TagInfo -> Ctor
fn TagCtor tg = Ctor(name="tag:{tg.name}", arity=(Len tg.fields), args=(Each tg.fields, \|((ignore, ft))| TyErr), shown=tg.name)

IsRootModule: fn Env -> Bool
fn IsRootModule env = env.home == ""

TagsOfKind: fn Env, Text -> [TagInfo]
fn TagsOfKind env, kind = Filter (Values env.g.tags), \|tg| tg.kind == kind or ((BareName tg.kind) == "Fault" and (BareName kind) == "Fault")

# The tags of a row: its families' element tags, less the tags an arm above took.
TagsOfRow: fn Env, Rw -> [TagInfo]
fn TagsOfRow env, w = Filter (Values env.g.tags), \|tg| tg.kind == "Element" and (HasText w.fams, tg.family) and not (HasText w.minus, tg.name)

# A pattern as a `Pat`, against the type it matches.
ToPat: unbounded fn Env, Pattern -> Pat
fn ToPat env, p = match p.kind:
    PName n:
        let bare = Or n.path[0], ""
        if (Len n.path) > 1 and HasKey env.g.tags, (Dotted n.path): PtCon "tag:{Dotted n.path}", [[]]
        else: if (IsUpperText bare) and (Len n.sigils) == 0 and (IsCtorName env, n): PtCon (CtorKey env, n), [[]]
        else: PtAny
    PIgnore: PtAny
    PLit l: PtLit (LitText l)
    PNeg l: PtLit "-{LitText l}"
    PUnit: PtCon "unit", [[]]
    PNil: PtCon "nil", [[]]
    PCtor n, args:
        if HasKey env.g.tags, (Dotted n.path): PtCon "tag:{Dotted n.path}", [[]]
        else: PtCon (CtorKey env, n), (Each args, \|a| ToPat env, a)
    PRecord n, fields, ignore: RecordPat env, n, fields
    PSigil s, q: PtCon s, [[(ToPat env, q)]]
    PTuple ps: PtCon "tuple", (Each ps, \|q| ToPat env, q)
    PArray ps: PtCon "len{Len ps}", (Each ps, \|q| ToPat env, q)
    PGroup q: ToPat env, q
    PFamily q: PtFam (Dotted q.path)

LitText: fn Literal -> Text
fn LitText l = match l.kind:
    LInt d: d
    LFloat d: d
    LChar c: "'{c}'"
    LText segs: Concat (Each segs, LitSegText)
    LDuration d, u: "{d}{u}"

LitSegText: fn TextSeg -> Text
fn LitSegText (SegPlain t) = t
fn LitSegText ignore = "\{\}"

CtorKey: fn Env, SName -> Text
fn CtorKey env, n:
    let ((?qk, ignore)) = ResolveValue env.g, env.home, n
    Or ?qk, (SNameKey n)

# A record or tag pattern, its fields in declaration order (`..` leaves the rest open).
RecordPat: unbounded fn Env, SName, [FieldPat] -> Pat
fn RecordPat env, n, fields:
    let name = Dotted n.path
    match env.g.tags[name]:
        ? tg:
            let names = Each tg.fields, \|((f, ignore))| f
            PtCon "tag:{name}", (Each names, \|f| FieldPatFor env, fields, names, f)
        nil:
            let qk = CtorKey env, n
            let fnames = if (BareName qk) == "Error": [["kind", "message"]] else: (Or env.g.ctors[qk], dummyCtor).fields
            let pkey = if (BareName qk) == "Error": "Error" else: qk
            PtCon pkey, (Each fnames, \|f| FieldPatFor env, fields, fnames, f)

let dummyCtor = CtorInfo(name="", owner="", params=[[]], args=[[]], fields=[[]], ty=TyErr, index=0)

FieldPatFor: unbounded fn Env, [FieldPat], [Text], Text -> Pat
fn FieldPatFor env, fields, names, f = Fold (Range0 (Len fields)), PtAny, \|acc, i| match fields[i]:
    ? fp: if (FieldPatName fp, names, i) == f: ToPat env, fp.pattern else: acc
    nil: acc

# Whether `q` is useful against the rows of `p` (Maranget's algorithm U), the columns
# typed by `tys`.
Useful: unbounded fn Env, St, [ [Pat] ], [Pat], [Ty] -> Bool
fn Useful env, st, rows, q, tys = match q[0]:
    nil: (Len rows) == 0
    ? q1:
        let t1 = Or tys[0], TyErr
        let rest = Drop tys, 1
        match q1:
            PtCon c, args:
                let ctor = CtorNamed env, st, t1, c, (Len args)
                Useful env, st, (Specialize rows, ctor), (Append args, (Drop q, 1)), (Append ctor.args, rest)
            PtLit l: Useful env, st, (SpecializeLit rows, l), (Drop q, 1), rest
            PtFam f: match ?CtorsOf env, st, t1:
                ? cs: Fold (Filter cs, \|c| (CtorFamily c) == f), False, \|seen, c| seen or Useful env, st, (Specialize rows, c), (Append (Wilds c.arity), (Drop q, 1)), (Append c.args, rest)
                nil: Useful env, st, (DefaultRows rows), (Drop q, 1), rest
            PtAny:
                let heads = HeadNames rows
                match ?CtorsOf env, st, t1:
                    ? cs:
                        if Complete cs, heads, rows:
                            Fold cs, False, \|seen, c| seen or Useful env, st, (Specialize rows, c), (Append (Wilds c.arity), (Drop q, 1)), (Append c.args, rest)
                        else: Useful env, st, (DefaultRows rows), (Drop q, 1), rest
                    nil: Useful env, st, (DefaultRows rows), (Drop q, 1), rest

CtorFamily: fn Ctor -> Text
fn CtorFamily c = if (Take c.name, 4) == "tag:": Dotted (Pop (Split (Drop c.name, 4), ".")) else: ""

Wilds: fn Nat -> [Pat]
fn Wilds n = Each (Range0 n), \|ignore| PtAny

# The constructor a pattern names, with its argument types.
CtorNamed: unbounded fn Env, St, Ty, Text, Nat -> Ctor
fn CtorNamed env, st, t, c, arity = match ?CtorsOf env, st, t:
    ? cs: match ?FindCtor cs, c:
        ? found: found
        nil: Ctor(name=c, arity=arity, args=(Each (Range0 arity), \|ignore| TyErr), shown=c)
    nil: Ctor(name=c, arity=arity, args=(Each (Range0 arity), \|ignore| TyErr), shown=c)

?FindCtor: fn [Ctor], Text -> ?Ctor
fn ?FindCtor cs, c = Fold cs, nil, \|?found, x| match ?found:
    ? f: ? f
    nil: if x.name == c or (BareName x.name) == (BareName c): ? x else: nil

# The rows that match constructor `c`, with its arguments spread.
Specialize: fn [ [Pat] ], Ctor -> [ [Pat] ]
fn Specialize rows, c = Fold rows, [[]], \|acc, prow| match prow[0]:
    ? (PtCon d, args): if d == c.name or (BareName d) == (BareName c.name): Push acc, (Append (Pad args, c.arity), (Drop prow, 1)) else: acc
    ? PtAny: Push acc, (Append (Wilds c.arity), (Drop prow, 1))
    ? (PtFam f): if (CtorFamily c) == f: Push acc, (Append (Wilds c.arity), (Drop prow, 1)) else: acc
    otherwise: acc

Pad: fn [Pat], Nat -> [Pat]
fn Pad args, n = if (Len args) >= n: Take args, n else: Append args, (Wilds (Or (n -? (Len args)), 0))

SpecializeLit: fn [ [Pat] ], Text -> [ [Pat] ]
fn SpecializeLit rows, l = Fold rows, [[]], \|acc, prow| match prow[0]:
    ? (PtLit m): if m == l: Push acc, (Drop prow, 1) else: acc
    ? PtAny: Push acc, (Drop prow, 1)
    otherwise: acc

DefaultRows: fn [ [Pat] ] -> [ [Pat] ]
fn DefaultRows rows = Fold rows, [[]], \|acc, prow| match prow[0]:
    ? PtAny: Push acc, (Drop prow, 1)
    otherwise: acc

HeadNames: fn [ [Pat] ] -> [Text]
fn HeadNames rows = Fold rows, [[]], \|acc, prow| match prow[0]:
    ? (PtCon c, ignore): AddText acc, c
    ? (PtFam f): AddText acc, "fam:{f}"
    otherwise: acc

# Whether the first column names every constructor (a family arm names its family's).
Complete: fn [Ctor], [Text], [ [Pat] ] -> Bool
fn Complete cs, heads, rows = (Len cs) > 0 and Fold cs, True, \|ok, c| ok and ((HasText heads, c.name) or (HasText (Each heads, \|h| BareName h), (BareName c.name)) or (HasText heads, "fam:{CtorFamily c}"))

# A value no row matches (Maranget's algorithm I), printed, or `nil` when the rows cover.
?Witness: unbounded fn Env, St, [ [Pat] ], [Ty] -> ?[Text]
fn ?Witness env, st, rows, tys = match tys[0]:
    nil: if (Len rows) == 0: ? [[]] else: nil
    ? t1:
        let rest = Drop tys, 1
        let heads = HeadNames rows
        match ?CtorsOf env, st, t1:
            ? cs:
                if Complete cs, heads, rows:
                    Fold cs, nil, \|?found, c| match ?found:
                        ? f: ? f
                        nil: match ?Witness env, st, (Specialize rows, c), (Append c.args, rest):
                            ? w: ? (Append [[(ShowWitness c, (Take w, c.arity))]], (Drop w, c.arity))
                            nil: nil
                else: match ?Witness env, st, (DefaultRows rows), rest:
                    ? w:
                        let missing = Filter cs, \|c| not ((HasText heads, c.name) or (HasText heads, "fam:{CtorFamily c}"))
                        let shown = match missing[0]:
                            ? c: c.shown
                            nil: "_"
                        ? (Append [[shown]], w)
                    nil: nil
            nil: match ?Witness env, st, (DefaultRows rows), rest:
                ? w: ? (Append [["_"]], w)
                nil: nil

ShowWitness: fn Ctor, [Text] -> Text
fn ShowWitness c, args:
    if c.name == "?": "? {Or args[0], "_"}"
    else: if c.name == "~": "~ {Or args[0], "_"}"
    else: if c.name == "tuple": "(({Join args, ", "}))"
    else: if (Len args) == 0 or (Fold args, True, \|ok, a| ok and a == "_"): c.shown
    else: "{BareName c.name} {Join args, ", "}"

# A match's arms (ch. 5, Closing): without `otherwise:` over an open row it is
# `row-not-closed`; a missing case is `not-exhaustive`; an arm nothing reaches is
# `unreachable`, except `otherwise:` over another module's families (Q-RW6).
MatchCoverage: unbounded fn Env, St, Ty, [Arm], Range -> St
fn MatchCoverage env, st, t, arms, span:
    let hasOtherwise = Fold arms, False, \|seen, a| seen or a.?pattern == nil
    let tys = [[t]]
    let ((rows, st2)) = Fold arms, (([[]], st)), \|((acc, s)), arm|
        let q = match arm.?pattern:
            ? p: [[(ToPat env, p)]]
            nil: [[PtAny]]
        let reachable = Useful env, s, acc, q, tys
        let ownsAll = OwnsRow env, s, t
        let s2 = if reachable: s else: if arm.?pattern == nil and not ownsAll: s else: ErrFix s, "unreachable", (ArmSpan arm), "this arm is never reached", "remove it, or put it above the arm that covers it"
        let acc2 = if arm.?guard == nil: Push acc, q else: acc
        ((acc2, s2))
    if hasOtherwise: st2
    else: if IsOpenRow env, st2, t: ErrFix st2, "row-not-closed", span, "a match over `{ShowTy st2, t}` needs `otherwise:`", "add an `otherwise:` arm: the row's variable may hold tags this match cannot name"
    else: match ?Witness env, st2, rows, tys:
        ? w: ErrFix st2, "not-exhaustive", span, "this match misses `{Join w, ", "}`", "add an arm for it, or `otherwise:`"
        nil: st2

ArmSpan: fn Arm -> Range
fn ArmSpan a = match a.?pattern:
    ? p: p.span
    nil: a.span

# A row the match cannot close: an element row with a tail, or a fault row in a library.
IsOpenRow: unbounded fn Env, St, Ty -> Bool
fn IsOpenRow env, st, t = match Walk st, t:
    TyElem rw, ignore: (WalkRow st, rw).tail != TlClosed
    TyElemAny rw: (WalkRow st, rw).tail != TlClosed
    TyCon n, [[]]: match env.g.types[n]:
        ? ti: ti.body == BRowKind and not (IsRootModule env)
        nil: (n == "Fault" or n == "Prelude.Fault") and not (IsRootModule env)
    otherwise: False

# Whether every family a row names is the matching module's own (Q-RW6).
OwnsRow: unbounded fn Env, St, Ty -> Bool
fn OwnsRow env, st, t = match Walk st, t:
    TyElem rw, ignore: Fold (WalkRow st, rw).fams, True, \|ok, f| ok and (Or env.g.famOwner[f], "") == env.home
    TyCon n, [[]]: match env.g.types[n]:
        ? ti: ti.body != BRowKind
        nil: not (n == "Fault" or n == "Prelude.Fault")
    otherwise: True

# A function's clauses are one match over its parameters.
ClauseCoverage: unbounded fn Env, St, [FnClause], [Ty], Range -> St
fn ClauseCoverage env, st, clauses, params, span:
    let ((rows, st2)) = Fold clauses, (([[]], st)), \|((acc, s)), c|
        let q = Each c.params, \|p| ToPat env, p
        let reachable = (Len q) != (Len params) or Useful env, s, acc, q, params
        let s2 = if reachable: s else: ErrFix s, "unreachable", c.span, "this clause is never reached", "remove it, or put it above the clause that covers it"
        (((Push acc, q), s2))
    if (Len params) == 0: st2
    else: match ?Witness env, st2, rows, params:
        ? w: ErrFix st2, "not-exhaustive", span, "these clauses miss `{Join w, ", "}`", "add a clause for it"
        nil: st2

# ---------------------------------------------------------------------------------------
# The prompt-cycle check (Semantics ch. 7, There are no cycles)
# ---------------------------------------------------------------------------------------

# The prelude's widget bindings whose result is not prompt in their argument: a deferral,
# a later firing, a job's result (D6); every other widget function is taken as prompt in
# everything it is given (the worst a blueprint parameter assumes, doubt PS). A name is
# one of them only when it resolves to the prelude's own declaration, never to a local or
# a program's own `@Defer`.
IsDelayedWidget: fn Text -> Bool
fn IsDelayedWidget n = HasText [["@Defer", "@Later", "@Run", "@Machine", "@started"]], n

# A cycle of prompt edges among a widget block's bindings is `prompt-cycle`, naming its
# bindings in order. A hold's value is delayed; a sample is delayed; a `rebuild`'s
# generation is built at the end of the tick.
BlockPromptCycles: unbounded fn Env, St, Block -> St
fn BlockPromptCycles env, st, b:
    let defs = Fold b.stmts, [[]], \|acc, s| Append acc, (StmtDefs s)
    let cx = PCx(g=env.g, home=env.home, lams=(LetLambdas b.stmts), base=(PromptBase env, b.stmts))
    let edges = Fold b.stmts, [[]], \|acc, s| Append acc, (PromptEdges env, st, cx, s, defs)
    let cyc = FindCycle defs, edges
    if (Len cyc) == 0: st
    else:
        let span = Fold b.stmts, b.span, \|sp, s| if HasText (StmtDefs s), (Or cyc[0], ""): s.span else: sp
        ErrFix st, "prompt-cycle", span, "a prompt cycle: {Join (Each cyc, \|n| "`{n}`"), ", "}", "break it with a hold: `$last <- start then ...` reads the value as the tick opened"

StmtDefs: unbounded fn Stmt -> [Text]
fn StmtDefs s = match s.kind:
    SBind p, ignore, ignore: PatternNames p
    SLet p, ignore, ignore: PatternNames p
    otherwise: [[]]

# The prompt edges a statement adds: from each name it defines to each name of the block
# its right side reads promptly.
PromptEdges: unbounded fn Env, St, PCx, Stmt, [Text] -> [((Text, Text))]
fn PromptEdges env, st, cx, s, defs = match s.kind:
    SBind ignore, ignore, (? ignore): [[]]
    SBind p, e, nil: Edges (PatternNames p), (PromptReads cx, e, defs)
    SLet p, ignore, e:
        let names = PatternNames p
        let layer = Fold names, "", \|acc, n| match env.locals[n]:
            ? sc: HeadSigil st, sc.ty
            nil: acc
        Edges names, (Filter (PromptReads cx, e, defs), \|n| ReadIsPrompt env, st, n, layer)
    otherwise: [[]]

Edges: fn [Text], [Text] -> [((Text, Text))]
fn Edges froms, tos = Fold froms, [[]], \|acc, f| Append acc, (Each tos, \|t| ((f, t)))

# Under an event the dynamics are sampled, which is delayed; a plain value's function
# reads are not a cycle (functions recurse).
ReadIsPrompt: unbounded fn Env, St, Text, Text -> Bool
fn ReadIsPrompt env, st, n, layer = match env.locals[n]:
    ? sc:
        let h = HeadSigil st, sc.ty
        if layer == "!": h == "!" or h == "@"
        else: if layer == "$": h == "$" or h == "!"
        else: match Walk st, sc.ty:
            TyFn ignore, ignore, ignore: False
            otherwise: (IsLowerText (Drop n, (Len (MarksOf n)))) and h == ""
    nil: False

# What the prompt walk resolves names against: the program and the block's module; the
# lambdas the block's `let`s bind, at any depth, by where each starts; the relations a
# right side of the block starts from (`PromptBase`).
type PCx = record:
    g: G
    home: Text
    lams: (Nat ==> Expr)
    base: (Text ==> Rel)
derive ^Eq, ^Show

# The relations every right side of a block starts from: the prelude's names that no
# local of the block's scope hides, and the block's own `let NAME = \|..| ..` lines
# (`lamlet:NAME`, pick PS).
PromptBase: unbounded fn Env, [Stmt] -> (Text ==> Rel)
fn PromptBase env, stmts:
    let pre = PreludeSeeds env.g, env.home
    let seeds = Fold (Keys pre), pre, \|m, k| if HasKey env.locals, (Drop k, 4): Remove m, k else: m
    Fold stmts, seeds, \|m, s| LamLetRels s, m

# A `let NAME = \|..| ..`: the name means that lambda where it is in scope, by where the
# lambda starts (pick PS), until something binds the name again (`Hide`).
LamLetRels: fn Stmt, (Text ==> Rel) -> (Text ==> Rel)
fn LamLetRels s, m = match s.kind:
    SLet p, ignore, e: match ((p.kind, (?LambdaOf e))):
        ((PName n, ? lam)): Insert m, "lamlet:{SNameKey n}", Rel(param=lam.span.start, strict=False)
        otherwise: m
    otherwise: m

?LambdaOf: fn Expr -> ?Expr
fn ?LambdaOf e = match e.kind:
    ELambda ignore, ignore: ? e
    EGroup x: ?LambdaOf x
    otherwise: nil

# Every lambda a `let` of these statements binds, at any depth, by where it starts.
LetLambdas: unbounded fn [Stmt] -> (Nat ==> Expr)
fn LetLambdas stmts = Fold (StmtsSpots stmts, {}), {}, \|m, sp| match sp:
    SpotStmt s, ignore: match s.kind:
        SLet ignore, ignore, e: match ?LambdaOf e:
            ? lam: Insert m, lam.span.start, lam
            nil: m
        otherwise: m
    otherwise: m

# The block's names a right side reads promptly, through the shrink check's one walk (pick
# GH): every name it mentions at any depth, a guard's, a method call's, a cast's and a
# template's included, except under a lambda, a local `fn` or a nested widget (a closure
# or a blueprint is not read where it is written), inside a `rebuild` or `for` (construction
# is never an edge), and in the arguments of a delayed widget binding. A traversal's step
# is read: the walk gives its body, not the lambda, since the traversal calls it now; so
# is a lambda passed to any function but a prelude widget function's, which may call it
# now. A name bound again inside the right side (a lambda's parameter, an arm's binder, an
# inner `let`) is not the block's. Every name is resolved: a delayed widget or a traversal
# is the prelude's only when the name resolves to the prelude's declaration.
PromptReads: unbounded fn PCx, Expr, [Text] -> [Text]
fn PromptReads cx, e, defs:
    let spots = PromptSpots cx, e, cx.base
    Fold spots, [[]], \|acc, sp| Fold (SpotSites sp), acc, \|a2, site| if (HasText defs, site.callee) and not (IsLocal site.rels, site.callee): AddText a2, site.callee else: a2

PromptSpots: unbounded fn PCx, Expr, (Text ==> Rel) -> [Spot]
fn PromptSpots cx, e, m = Fold (PromptKids cx, e, m), [[(SpotExpr e, m)]], \|acc, k| Append acc, (PromptKidSpots cx, k)

# The walk's children of an expression, less the ones that are not read promptly.
PromptKids: unbounded fn PCx, Expr, (Text ==> Rel) -> [Kid]
fn PromptKids cx, e, m = match e.kind:
    ELambda ignore, ignore: [[]]
    ERebuild ignore, ignore: [[]]
    EFor ignore, ignore, ignore: [[]]
    EWidgetBlock ignore: [[]]
    ECall c, ignore, ignore, ignore: PromptCallKids cx, e, (?CalleeName c), m
    EMethod ignore, n, ignore: PromptCallKids cx, e, (? (SNameKey n)), m
    otherwise: ExprKids e, m

# A call's children: none under a delayed widget binding; a lambda argument's body when
# the callee may call it now (anything but a prelude widget function).
PromptCallKids: unbounded fn PCx, Expr, ?Text, (Text ==> Rel) -> [Kid]
fn PromptCallKids cx, e, ?n, m = match ?n:
    ? n:
        let called = FollowLamLet cx, n, m
        if IsLocal m, n: Append called, (OpenLambdas cx, (ExprKids e, m))
        else: if (Len called) > 0: Append called, (OpenLambdas cx, (ExprKids e, m))
        else: match ?ResolveCallee cx.g, cx.home, n:
            ? k:
                if (IsPreludeKey cx.g, k) and (IsDelayedWidget (Drop k, 8)): [[]]
                else: if (IsPreludeKey cx.g, k) and (Take (Drop k, 8), 1) == "@": ExprKids e, m
                else: OpenLambdas cx, (ExprKids e, m)
            nil: OpenLambdas cx, (ExprKids e, m)
    nil: OpenLambdas cx, (ExprKids e, m)

# A lambda among the children read through its body, its parameters bound there; a name
# a block's `let` binds to a lambda (`let f = \|x| x + b`, then `Apply 1, f`) read through
# that lambda's body, by following the binding.
OpenLambdas: unbounded fn PCx, [Kid] -> [Kid]
fn OpenLambdas cx, kids = Fold kids, [[]], \|acc, k| match k:
    KidExpr x, m: match x.kind:
        ELambda ?ps, body: Push acc, (LambdaKid body, (Hide m, (PatternsNames (Or ?ps, [[]]))))
        EName n: Append (Push acc, k), (FollowLamLet cx, (SNameKey n), m)
        otherwise: Push acc, k
    otherwise: Push acc, k

# The body of the lambda a `let` bound `n` to, where `n` still means it (`lamlet:`), read
# with the relations of the block the prompt check is over (where the lambda was written,
# at its widest: an inner binding between the two hides nothing), its parameters bound;
# each lambda followed once along a path (`seen:START`), so a lambda that names itself ends.
FollowLamLet: unbounded fn PCx, Text, (Text ==> Rel) -> [Kid]
fn FollowLamLet cx, n, m = match m["lamlet:{n}"]:
    ? r:
        if HasKey m, "seen:{r.param}": [[]]
        else: match cx.lams[r.param]:
            ? lam: match lam.kind:
                ELambda ?ps, body:
                    let seen = Fold (Keys m), cx.base, \|m2, k| if (Take k, 5) == "seen:": Insert m2, k, noRel else: m2
                    [[(LambdaKid body, (Hide (Insert seen, "seen:{r.param}", noRel), (PatternsNames (Or ?ps, [[]]))))]]
                otherwise: [[]]
            nil: [[]]
    nil: [[]]

PromptKidSpots: unbounded fn PCx, Kid -> [Spot]
fn PromptKidSpots cx, k = match k:
    KidExpr x, m: PromptSpots cx, x, m
    KidStmts ss, m:
        let bm = BlockRels ss, m
        Fold ss, [[]], \|acc, s| Append acc, (PromptStmtSpots cx, s, bm)

PromptStmtSpots: unbounded fn PCx, Stmt, (Text ==> Rel) -> [Spot]
fn PromptStmtSpots cx, s, m = match s.kind:
    SFn ignore: [[(SpotStmt s, m)]]
    SWidget ignore: [[(SpotStmt s, m)]]
    otherwise: Fold (StmtKids s, m), [[(SpotStmt s, m)]], \|acc, k| Append acc, (PromptKidSpots cx, k)

# The first cycle among the edges, as its names in the order the block binds them.
FindCycle: unbounded fn [Text], [((Text, Text))] -> [Text]
fn FindCycle defs, edges = Fold defs, [[]], \|found, d| if (Len found) > 0: found else: CycleThrough defs, edges, d

CycleThrough: unbounded fn [Text], [((Text, Text))], Text -> [Text]
fn CycleThrough defs, edges, d:
    let fwd = ReachFrom edges, d
    if HasText fwd, d: Filter defs, \|x| (HasText fwd, x) and (HasText (ReachFrom edges, x), d)
    else: [[]]

ReachFrom: unbounded fn [((Text, Text))], Text -> [Text]
fn ReachFrom edges, d = Reach edges, (Each (Filter edges, \|((f, ignore))| f == d), \|((ignore, t))| t), [[]]

Reach: unbounded fn [((Text, Text))], [Text], [Text] -> [Text]
fn Reach edges, frontier, seen = match frontier[0]:
    nil: seen
    ? x:
        if HasText seen, x: Reach edges, (Drop frontier, 1), seen
        else: Reach edges, (Append (Drop frontier, 1), (Each (Filter edges, \|((f, ignore))| f == x), \|((ignore, t))| t)), (Push seen, x)

# ---------------------------------------------------------------------------------------
# `&` blocks: escapes, freezes, borrows (Semantics ch. 5)
# ---------------------------------------------------------------------------------------

IsLocalType: unbounded fn St, Ty -> Bool
fn IsLocalType st, t = match Walk st, t:
    TyCon "Buffer", ignore: True
    TyCon "Table", ignore: True
    TyArray e: IsLocalType st, e
    TyTuple ts: Fold ts, False, \|seen, x| seen or IsLocalType st, x
    TyMap k, v: (IsLocalType st, k) or IsLocalType st, v
    TySig ignore, i: IsLocalType st, i
    otherwise: False

# A block-local type only in `&` locals (`local-escapes`), nothing used after `Freeze`
# (`frozen`), one live reference per part (`borrow-overlap`).
AndBlockChecks: unbounded fn Env, St, Block, Ty -> St
fn AndBlockChecks env, st, b, t:
    let st1 = if IsLocalType st, t: ErrFix st, "local-escapes", b.span, "a `{BlockLocalName st, t}` cannot leave its block", "`Freeze` it into a plain value first" else: st
    let st2 = EscapeStmts env, st1, b.stmts
    let ((ignore, st3)) = FrozenStmts env, st2, b.stmts, {}
    BorrowStmts env, st3, b.stmts, [[]]

BlockLocalName: unbounded fn St, Ty -> Text
fn BlockLocalName st, t = match Walk st, t:
    TyCon n, ignore: n
    otherwise: "Buffer"

EscapeStmts: unbounded fn Env, St, [Stmt] -> St
fn EscapeStmts env, st, stmts = Fold stmts, st, \|s, stmt| match stmt.kind:
    SLet p, ignore, e: match p.kind:
        PName n:
            if (Take n.sigils, 1) == "&": s
            else: match env.locals[SNameKey n]:
                ? ignore: s
                nil: if CallsLocalMaker env, e: ErrFix s, "local-escapes", stmt.span, "a `Buffer` cannot leave its block: `{SNameKey n}` is no `&` local", "write `let &{SNameKey n} = ...`" else: s
        otherwise: s
    SWhile ignore, body: EscapeStmts env, s, body.stmts
    SExpr e: match e.kind:
        EIf ignore, tb, ?eb:
            let s2 = EscapeStmts env, s, tb.stmts
            match ?eb:
                ? x: EscapeStmts env, s2, x.stmts
                nil: s2
        EMatch ignore, arms: Fold arms, s, \|s3, a| EscapeStmts env, s3, a.body.stmts
        EFor ignore, ignore, body: EscapeStmts env, s, body.stmts
        otherwise: s
    otherwise: s

# A call of a block-local maker, `Buffer.Numbered n`, `Buffer.Empty` or `Table.Empty`, by
# what the name resolves to where it stands (the checker's own builtins), never by its text.
CallsLocalMaker: fn Env, Expr -> Bool
fn CallsLocalMaker env, e = match e.kind:
    ECall c, ignore, ignore, ignore: (?MakerOf env, c) != nil
    EName ignore: match ?MakerOf env, e:
        ? k: k != "Buffer.Numbered"
        nil: False
    EGroup x: CallsLocalMaker env, x
    otherwise: False

?MakerOf: fn Env, Expr -> ?Text
fn ?MakerOf env, c = match ?CalleeName c:
    ? n:
        if HasKey env.locals, n: nil
        else: match ?ResolveName env.g, env.home, n:
            ? k: if (IsLocalMaker k) and (Or env.g.vals[k], dummyVal).sort == "builtin": ? k else: nil
            nil: nil
    nil: nil

# After `Freeze &x`, `&x` is gone, as a Rust value after a move. A statement freezes what
# a call of the prelude's `Freeze` is given anywhere in it (resolved where it stands, pick
# RN: a local or a program's own `Freeze` freezes nothing), and a statement after it that
# names the local anywhere in it is `frozen`; a `let` that binds the name again makes a
# new local.
FrozenStmts: unbounded fn Env, St, [Stmt], (Text ==> Nat) -> (((Text ==> Nat), St))
fn FrozenStmts env, st, stmts, frozen:
    let pre = PreludeSeeds env.g, env.home
    let seeds = Fold (Keys pre), pre, \|m, k| if HasKey env.locals, (Drop k, 4): Remove m, k else: m
    let bm = BlockRels stmts, seeds
    Fold stmts, ((frozen, st)), \|((fz, s)), stmt|
        let spots = StmtSpots stmt, bm
        let reads = Fold spots, [[]], \|acc, sp| Append acc, (SpotRefs sp)
        let s2 = Fold reads, s, \|s1, ((n, sp))| match fz[n]:
            ? line: ErrFix s1, "frozen", sp, "`{n}` was frozen on line {line + 1}", "use the frozen value, or make a new local"
            nil: s1
        let fz1 = match stmt.kind:
            SLet p, ignore, ignore: Fold (PatternNames p), fz, \|m, n| Remove m, n
            otherwise: fz
        let fz2 = Fold spots, fz1, \|m, sp| Fold (SpotFreezes sp), m, \|m2, n| Insert m2, n, (CLineOf env.src.starts, stmt.span.start)
        ((fz2, s2))

# The `&` names a spot reads, with where.
SpotRefs: fn Spot -> [((Text, Range))]
fn SpotRefs (SpotExpr e, ignore) = match e.kind:
    EName n: if (Take n.sigils, 1) == "&": [[((SNameKey n, n.span))]] else: [[]]
    otherwise: [[]]
fn SpotRefs (SpotStmt ignore, ignore) = [[]]

# The `&` locals a spot's call of the prelude's `Freeze` is given.
SpotFreezes: unbounded fn Spot -> [Text]
fn SpotFreezes (SpotExpr e, m) = match ?CallOf e:
    ? ((c, args)): match ?CalleeName c:
        ? n: if PreIs m, n, "Freeze": Fold args, [[]], \|acc, a| Append acc, (Each (RefsIn a.value), \|((n2, ignore))| n2) else: [[]]
        nil: [[]]
    nil: [[]]
fn SpotFreezes (SpotStmt ignore, ignore) = [[]]

RefsIn: unbounded fn Expr -> [((Text, Range))]
fn RefsIn e = match e.kind:
    EName n: if (Take n.sigils, 1) == "&": [[((SNameKey n, n.span))]] else: [[]]
    ECall c, args, ignore, ignore: Fold args, (RefsIn c), \|acc, a| Append acc, (RefsIn a.value)
    EBinary ignore, l, r: Append (RefsIn l), (RefsIn r)
    EUnary ignore, x: RefsIn x
    EFreeSigil ignore, x: RefsIn x
    EField r, ignore, ignore: RefsIn r
    EIndex r, i: Append (RefsIn r), (RefsIn i)
    EGroup x: RefsIn x
    ETuple es: Fold es, [[]], \|acc, x| Append acc, (RefsIn x)
    EArray es: Fold es, [[]], \|acc, x| Append acc, (RefsIn x)
    otherwise: [[]]

# Inside `for &s <- &p:` the path `&p` is lent to the loop: a set through a path that
# overlaps it is `borrow-overlap`.
BorrowStmts: unbounded fn Env, St, [Stmt], [ [Text] ] -> St
fn BorrowStmts env, st, stmts, lent = Fold stmts, st, \|s, stmt| match stmt.kind:
    SSet t, ignore: CheckLent env, s, t, lent
    SAccum t, ignore, ignore: CheckLent env, s, t, lent
    SWhile ignore, body: BorrowStmts env, s, body.stmts, lent
    SExpr e: match e.kind:
        EFor ?binders, source, body:
            let path = RefPath source
            let lent2 = if (Len path) > 0 and ?binders != nil: Push lent, path else: lent
            BorrowStmts env, s, body.stmts, lent2
        EIf ignore, tb, ?eb:
            let s2 = BorrowStmts env, s, tb.stmts, lent
            match ?eb:
                ? x: BorrowStmts env, s2, x.stmts, lent
                nil: s2
        EMatch ignore, arms: Fold arms, s, \|s3, a| BorrowStmts env, s3, a.body.stmts, lent
        otherwise: s
    otherwise: s

CheckLent: unbounded fn Env, St, Expr, [ [Text] ] -> St
fn CheckLent env, st, t, lent:
    let path = RefPath t
    Fold lent, st, \|s, l| if (Len path) > 0 and (IsPrefix l, path) or (IsPrefix path, l): ErrFix s, "borrow-overlap", t.span, "`{Join l, "."}` is lent to the `for`", "set it after the loop, or loop over a copy" else: s

IsPrefix: fn [Text], [Text] -> Bool
fn IsPrefix a, b = (Len a) <= (Len b) and (Take b, (Len a)) == a

# A reference's path: its root `&` name and field steps (an index step ends it).
RefPath: unbounded fn Expr -> [Text]
fn RefPath e = match e.kind:
    EName n: if (Take n.sigils, 1) == "&": [[SNameKey n]] else: [[]]
    EField r, ignore, f:
        let p = RefPath r
        if (Len p) > 0: Push p, f.name else: p
    EIndex r, ignore:
        let p = RefPath r
        if (Len p) > 0: Push p, "[]" else: p
    EGroup x: RefPath x
    otherwise: [[]]

# ---------------------------------------------------------------------------------------
# The shrink check (Semantics ch. 7, Every tick ends)
# ---------------------------------------------------------------------------------------

# A size-change graph: edges from the caller's parameters to the callee's, strict or not.
type Sc = record:
    caller: Text
    callee: Text
    edges: [((Nat, Nat, Bool))]
    span: Range
    file: Nat
    arg: Text
derive ^Eq, ^Show

# What a name is known to be no larger (or strictly smaller) than: a parameter.
type Rel = record:
    param: Nat
    strict: Bool
derive ^Eq, ^Show

# What the shrink check reads of the program: its definitions with clauses (functions,
# impls' methods, traits' default methods), each by its key; the definitions a trait
# method's name calls, and each impl's definition of each method by where the impl stands
# (pick OP); the solver's choices (`NoteChoice`); the summaries (pick SM); the seeds each
# module's walks start from (`ModuleSeeds`).
type Shrink = record:
    g: G
    fns: [Def]
    byKey: (Text ==> Def)
    targets: (Text ==> [Text])
    implDefs: (Text ==> Text)
    choices: (Text ==> [Text])
    sums: (Text ==> Nat)
    seeds: (Text ==> (Text ==> Rel))
    localOf: (Text ==> Text)
    localBase: (Text ==> (Text ==> Rel))
derive ^Eq, ^Show

# The reference graph's cycles that the size-change principle cannot show end are
# `may-not-end`, unless every function on the cycle is declared unbounded (D6). A `while`
# is its own loop, checked in place.
ShrinkCheck: unbounded fn G, St, [Def] -> St
fn ShrinkCheck g, st, defs:
    let fns = Each (Filter defs, \|d| (Len (DefClauses d)) > 0), \|d| OwnKey d
    let byKey = Fold fns, {}, \|m, d| Insert m, d.qk, d
    let homes = Fold fns, [[]], \|acc, d| AddText acc, d.home
    let nats = NatMinusSeeds st
    let pre = Fold homes, {}, \|m, h| Insert m, h, (Fold (Keys nats), (PreludeSeeds g, h), \|m2, k| Insert m2, k, noRel)
    let sk0 = Shrink(g=g, fns=fns, byKey=byKey, targets=(MethodTargets g, fns), implDefs=(ImplDefs g, fns), choices=st.choices, sums={}, seeds=pre, localOf={}, localBase={})
    let sk1 = update sk0:
        &_.sums <= PartsSummaries sk0, fns
    let skg = update sk1:
        &_.seeds <= HofSeeds sk1, homes
    let walked = Each fns, \|d| DefWalk skg, d
    let sk = WithLocals skg, (Fold walked, [[]], \|acc, ((ignore, ignore, ls))| Append acc, ls)
    let refs = Append (Each walked, \|((k, rs, ignore))| ((k, rs))), (Each (Drop sk.fns, (Len fns)), \|d| ((d.qk, (DefRefs sk, d))))
    let keys = Each sk.fns, \|d| d.qk
    let sccs = Sccs keys, refs
    let st2 = Fold sccs, (NegativeTypes g, st), \|s, comp| ShrinkComponent sk, s, comp
    Fold fns, st2, \|s, d| LoopsOf sk, s, d

# ---- Pick NT. "A type that appears left of a function arrow in its own definition is a
# cycle" (Semantics ch. 7, "Finding the cycles"). `type R = choice: Wrap (fn R -> Nat)`
# lets `Omega r = Unwrap r, r` call itself through the function an `R` holds, and no call
# graph shows it: so the type is the cycle, and nothing in it shrinks. It is
# `may-not-end` at the type, unless every arrow the type stands left of is `unbounded
# fn`, whose calls are unbounded and spread the color as ch. 7 says. Left of an arrow is
# anywhere inside a parameter of a function type, at any depth; another type the
# definition names is read through its own definition, with its parameters filled, so a
# type reached through `Box R` or a mutual definition is found too.
NegativeTypes: unbounded fn G, St -> St
fn NegativeTypes g, st:
    let arrowy = ArrowyTypes g
    Fold (Keys g.types), st, \|s, n| NegativeType g, s, arrowy, n

# A type no arrow can reach (`ArrowyTypes`) stands left of none, and is not walked.
NegativeType: unbounded fn G, St, (Text ==> Bool), Text -> St
fn NegativeType g, s, arrowy, n = match g.types[n]:
    ? ti:
        let ((neg, ignore)) = if ti.file >= g.preludeFrom or not (HasKey arrowy, n): ((False, {})) else: NegWalks g, n, (BodyTys ti), False, {}
        if not neg: s
        else:
            let s0 = update s:
                &_.file <= ti.file
            let s1 = ErrFix s0, "may-not-end", ti.span, "`{BareName n}` stands left of a function arrow in its own definition: a call through the function it holds is a cycle, and nothing in it shrinks", "keep `{BareName n}` right of the arrow, or make the arrow `unbounded fn`, which makes every call through it unbounded"
            update s1:
                &_.file <= s.file
    nil: s

# The types whose definitions reach a function arrow: one written in it, or a type it
# names that does, to a fixed point (each round adds a type or ends).
ArrowyTypes: unbounded fn G -> (Text ==> Bool)
fn ArrowyTypes g:
    let names = Fold (Keys g.types), {}, \|m, n| match g.types[n]:
        ? ti: Insert m, n, (Fold (BodyTys ti), [[]], \|acc, t| UnionTexts acc, (TyNamesIn t))
        nil: m
    let direct = Fold (Keys g.types), {}, \|m, n| match g.types[n]:
        ? ti: if Fold (BodyTys ti), False, \|seen, t| seen or HasArrow t: Insert m, n, True else: m
        nil: m
    ArrowyFrom names, direct

ArrowyFrom: unbounded fn (Text ==> [Text]), (Text ==> Bool) -> (Text ==> Bool)
fn ArrowyFrom names, got:
    let next = Fold (Keys names), got, \|m, n| if HasKey m, n: m else: if Fold (Or names[n], [[]]), False, \|seen, r| seen or HasKey got, r: Insert m, n, True else: m
    if (Len (Keys next)) == (Len (Keys got)): got else: ArrowyFrom names, next

# The named types a type mentions at any depth, inside function types too.
TyNamesIn: unbounded fn Ty -> [Text]
fn TyNamesIn t = match t:
    TyCon c, args: Fold args, [[c]], \|acc, a| UnionTexts acc, (TyNamesIn a)
    TyFn ignore, ps, res: Fold ps, (TyNamesIn res), \|acc, a| UnionTexts acc, (TyNamesIn a)
    TyTuple ts: Fold ts, [[]], \|acc, a| UnionTexts acc, (TyNamesIn a)
    TyArray e: TyNamesIn e
    TyMap k, v: UnionTexts (TyNamesIn k), (TyNamesIn v)
    TySig ignore, i: TyNamesIn i
    TyAt i, ignore: TyNamesIn i
    TyElem ignore, i: TyNamesIn i
    TyAssoc ignore, i: TyNamesIn i
    otherwise: [[]]

HasArrow: unbounded fn Ty -> Bool
fn HasArrow t = match t:
    TyFn ignore, ignore, ignore: True
    TyCon ignore, args: Fold args, False, \|seen, a| seen or HasArrow a
    TyTuple ts: Fold ts, False, \|seen, a| seen or HasArrow a
    TyArray e: HasArrow e
    TyMap k, v: (HasArrow k) or HasArrow v
    TySig ignore, i: HasArrow i
    TyAt i, ignore: HasArrow i
    TyElem ignore, i: HasArrow i
    TyAssoc ignore, i: HasArrow i
    otherwise: False

# The types a definition is made of: a record's fields, a choice's cases' arguments, an
# alias's type.
BodyTys: fn TyInfo -> [Ty]
fn BodyTys ti = match ti.body:
    BRecord fields: Each fields, \|((ignore, t))| t
    BChoice cases: Fold cases, [[]], \|acc, ((ignore, args))| Append acc, args
    BAlias t: [[t]]
    otherwise: [[]]

# Whether `target` stands left of a bounded arrow in `t` (`b`: `t` itself already does).
# A named type is read through its definition with its arguments in, once per arguments
# and side for the whole walk (`seen`: what a type says once it says again); a walk that
# never closes (a type that grows its own arguments) is taken as the cycle.
NegWalk: unbounded fn G, Text, Ty, Bool, (Text ==> Bool) -> ((Bool, (Text ==> Bool)))
fn NegWalk g, target, t, b, seen = match t:
    TyCon c, args:
        if c == target: ((b, seen))
        else: match g.types[c]:
            ? ti:
                let sk = "{if b: "-" else: "+"}{ShowTy (NewSt 0), t}"
                if HasKey seen, sk: ((False, seen))
                else: if (Len (Keys seen)) > 400: ((True, seen))
                else: NegWalks g, target, (Each (BodyTys ti), \|bt| SubstQ (ParamInst ti.params, args), bt), b, (Insert seen, sk, True)
            nil: NegWalks g, target, args, b, seen
    TyFn col, ps, res:
        let ((bad, seen2)) = NegWalks g, target, ps, (b or col != CUnbound), seen
        if bad: ((True, seen2)) else: NegWalk g, target, res, b, seen2
    TyTuple ts: NegWalks g, target, ts, b, seen
    TyArray e: NegWalk g, target, e, b, seen
    TyMap k, v: NegWalks g, target, [[k, v]], b, seen
    TySig ignore, i: NegWalk g, target, i, b, seen
    TyAt i, ignore: NegWalk g, target, i, b, seen
    TyElem ignore, i: NegWalk g, target, i, b, seen
    TyAssoc ignore, i: NegWalk g, target, i, b, seen
    otherwise: ((False, seen))

NegWalks: unbounded fn G, Text, [Ty], Bool, (Text ==> Bool) -> ((Bool, (Text ==> Bool)))
fn NegWalks g, target, ts, b, seen = Fold ts, ((False, seen)), \|((bad, sn)), t| if bad: ((True, sn)) else: NegWalk g, target, t, b, sn

# Every `-?` whose operand the solver made a `Nat`, as `nat:FILE:START:END` (pick SW).
NatMinusSeeds: unbounded fn St -> (Text ==> Rel)
fn NatMinusSeeds st = Fold (Keys st.sizeTys), {}, \|m, k| match st.sizeTys[k]:
    ? t: if (Zonk st, t) == tNat: Insert m, "nat:{k}", noRel else: m
    nil: m

# A definition's clauses: a function's, an impl's method's, a trait's default method's;
# a top-level widget block's and a top-level `let`'s, each one clause without parameters.
# A widget that binds itself builds itself forever (Semantics ch. 7, "a widget function
# that binds itself is held to the same test"), and a `let` that reaches itself through
# the functions it calls never has a value: both are cycles of the reference graph, with
# no parameter to shrink.
DefClauses: fn Def -> [FnClause]
fn DefClauses d = match d.body:
    DbFn clauses: clauses
    DbMethod clauses, ignore, ignore: clauses
    DbDefault clauses, ignore: clauses
    DbWidget w: [[FnClause(name=(DefSName w.name), params=[[]], body=(BodyBlock w.body), span=w.span)]]
    DbLet l: [[FnClause(name=(DefOp d.name, l.span), params=[[]], body=(BodyExpr l.value), span=l.span)]]
    otherwise: [[]]

# Two impls' methods share a key (`Prelude.Show impl Show`), so here each is told apart by
# where its impl stands.
OwnKey: fn Def -> Def
fn OwnKey d = match d.body:
    DbMethod ignore, ignore, im: update d:
        &_.qk <= "{d.qk} #{im.file}.{im.span.start}"
    otherwise: d

# The trait method an impl's method or a default method defines.
?MethodOf: fn G, Def -> ?Text
fn ?MethodOf g, d = match d.body:
    DbMethod ignore, cls, ignore: ?MethodKey g, cls, d.name
    DbDefault ignore, cls: ?MethodKey g, cls, d.name
    otherwise: nil

# Pick OP: a trait method's name, an operator's spelling included, calls the definitions
# of that method in the program, each impl's and the default (`DispatchTargets` narrows
# them by the solver's choice at the call).
MethodTargets: fn G, [Def] -> (Text ==> [Text])
fn MethodTargets g, fns = Fold fns, {}, \|m, d| match ?MethodOf g, d:
    ? mk: Insert m, mk, (AddText (Or m[mk], [[]]), d.qk)
    nil: m

# Each impl's definition of each method, by the method and where the impl stands, as the
# solver's `impl:FILE.START` names it.
ImplDefs: fn G, [Def] -> (Text ==> Text)
fn ImplDefs g, fns = Fold fns, {}, \|m, d| match d.body:
    DbMethod ignore, ignore, im: match ?MethodOf g, d:
        ? mk: Insert m, "{mk}|{im.file}.{im.span.start}", d.qk
        nil: m
    otherwise: m

# The trait a method belongs to, when the key is a trait method's.
?MethodClass: fn G, Text -> ?Text
fn ?MethodClass g, k = match g.vals[k]:
    ? v: if v.sort != "method": nil else: match v.scheme.bounds[0]:
        ? ((ignore, cls)): ? cls
        nil: nil
    nil: nil

# The definitions a call of method `k` reaches, by what the solver chose at the call's
# place for the method's trait (pick OP): a written impl's definition of the method, or the
# trait's default when the impl has none; a derived impl reaches what its fields' types
# choose; a type variable under a bound, a packed value or a quantified `let`, every
# definition (sound); a built-in type, none of the program's. A call the solver noted
# nothing for reaches every definition.
DispatchTargets: unbounded fn Shrink, Def, Site, Text -> [Text]
fn DispatchTargets sk, d, site, k:
    let all = TargetsOf sk, k
    match ?MethodClass sk.g, k:
        nil: all
        ? cls:
            let ck = ChoiceKey d.file, site.span, cls
            match sk.choices[ck]:
                nil: all
                ? cs: Fold cs, [[]], \|acc, ch| UnionTexts acc, (ChoiceTargets sk, k, cls, all, ch, [[]])

ChoiceTargets: unbounded fn Shrink, Text, Text, [Text], Text, [Text] -> [Text]
fn ChoiceTargets sk, k, cls, all, ch, seen:
    if ch == "none": [[]]
    else: if (Take ch, 5) == "impl:": match sk.implDefs["{k}|{Drop ch, 5}"]:
        ? q: [[q]]
        nil: Filter all, \|q| q == k
    else: if (Take ch, 8) == "derived:": DerivedTargets sk, k, cls, all, (Drop ch, 8), seen
    else: all

# A derived impl calls the method on its fields: each field's type's own choice, a type
# parameter's coming from the call's other constraints at the same place.
DerivedTargets: unbounded fn Shrink, Text, Text, [Text], Text, [Text] -> [Text]
fn DerivedTargets sk, k, cls, all, n, seen:
    if HasText seen, n: [[]]
    else:
        let tys = match sk.g.types[n]:
            ? ti: match ti.body:
                BRecord fields: Each fields, \|((ignore, t))| t
                BChoice cases: Fold cases, [[]], \|acc, ((ignore, args))| Append acc, args
                BAlias t: [[t]]
                otherwise: [[]]
            nil: [[]]
        let heads = Fold tys, [[]], \|acc, t| UnionTexts acc, (TyHeads t)
        Fold heads, [[]], \|acc, h| UnionTexts acc, (HeadTargets sk, k, cls, all, h, (Push seen, n))

# The named types a field's type holds at any depth (a type variable, a function, an
# element hold none of the program's impls); `?` for one the walk cannot name.
TyHeads: fn Ty -> [Text]
fn TyHeads t = match t:
    TyCon n, args: Fold args, [[n]], \|acc, a| UnionTexts acc, (TyHeads a)
    TyTuple ts: Fold ts, [[]], \|acc, a| UnionTexts acc, (TyHeads a)
    TyArray e: TyHeads e
    TyMap a, b: UnionTexts (TyHeads a), (TyHeads b)
    TySig ignore, i: TyHeads i
    TyQ ignore: [[]]
    TyRigid ignore: [[]]
    TyFn ignore, ignore, ignore: [[]]
    TyElem ignore, ignore: [[]]
    TyElemAny ignore: [[]]
    otherwise: [["?"]]

HeadTargets: unbounded fn Shrink, Text, Text, [Text], Text, [Text] -> [Text]
fn HeadTargets sk, k, cls, all, h, seen:
    if h == "?": all
    else: if (BuiltinHas cls, h) or IsPrimType h: [[]]
    else: match (Filter (Or sk.g.impls[cls], [[]]), \|im| (?HeadKey im.head) == ? h)[0]:
        ? im: ChoiceTargets sk, k, cls, all, (ImplChoice im), seen
        nil: all

# The type a type's head names, when it is a named type.
?HeadKey: fn Ty -> ?Text
fn ?HeadKey (TyCon n, ignore) = ? n
fn ?HeadKey ignore = nil

TargetsOf: fn Shrink, Text -> [Text]
fn TargetsOf sk, k = Or sk.targets[k], [[k]]

# The signature a definition is declared by: its own, or its trait method's.
SigKeyOf: fn Shrink, Text -> Text
fn SigKeyOf sk, k = match sk.byKey[k]:
    ? d: Or (?MethodOf sk.g, d), k
    nil: k

# How a message names a definition: an impl's method by the method's name.
ShownKey: fn Text -> Text
fn ShownKey k = BareName (Or (Split (Or (?Last (Split k, " impl ")), k), " #")[0], k)

IsUnboundedKey: fn G, Text -> Bool
fn IsUnboundedKey g, k = match g.vals[k]:
    ? v: match v.scheme.ty:
        TyFn CUnbound, ignore, ignore: True
        otherwise: False
    nil: False

# ---- Pick CT, the call test for closures (Semantics ch. 7, "Finding the cycles"). A
# closure passed to a program function is cleared when the function only calls it: the
# parameter at that slot is, in every clause, the callee of calls (at any depth, but not
# inside a closure that may run later, `Later`) or passed whole to another cleared slot,
# and nothing else. Then the closure runs only inside that call, so its calls are read at
# the call site that passed it, with what the function's summary says it is given: for
# each of the closure's parameters `q`, the function's parameter it is no larger than (or
# strictly smaller than) at every call of the closure. `Spaced xs, SexpType` is then a
# call `SexpType x` with `x` a part of `xs`, as `Each xs, SexpType` is (doubt TR). A
# closure at any other place is a call with no edges where it is written (the reference
# graph). Both are greatest fixed points, each round read under the last round's seeds: a
# slot stays cleared while what is passed to it stays cleared, by induction on how deep
# the call that runs the closure is nested.

# A closure slot: the function, the parameter's place, the closure's arity.
type Slot = record:
    owner: Text
    at: Nat
    arity: Nat
derive ^Eq, ^Show

# The seeds of each module's walks: the prelude's names (`PreludeSeeds`), and every
# cleared slot's `acc:` and `sum:` entries.
HofSeeds: unbounded fn Shrink, [Text] -> (Text ==> (Text ==> Rel))
fn HofSeeds sk, homes:
    let cands = HofCandidates sk
    let cleared = ClearSlots sk, homes, cands, 0
    let sums = SlotSums sk, homes, cleared, (TopSums cleared), 0
    Fold homes, {}, \|m, h| Insert m, h, (SlotSeeds sk, h, cleared, sums, False)

# The slots whose parameter's declared type is a function, every clause binding it by a
# name (or `ignore`).
HofCandidates: fn Shrink -> [Slot]
fn HofCandidates sk = Fold sk.fns, [[]], \|acc, d| match d.body:
    DbFn clauses: match sk.g.vals[d.qk]:
        ? v: match v.scheme.ty:
            TyFn ignore, ps, ignore: Fold (Range0 (Len ps)), acc, \|a2, j| match ps[j]:
                ? (TyFn ignore, fps, ignore): if Fold clauses, True, \|ok, c| ok and SlotNamed c, j: Push a2, Slot(owner=d.qk, at=j, arity=(Len fps)) else: a2
                otherwise: a2
            otherwise: acc
        nil: acc
    otherwise: acc

SlotNamed: fn FnClause, Nat -> Bool
fn SlotNamed c, j = match c.params[j]:
    ? p: match p.kind:
        PName ignore: True
        PIgnore: True
        otherwise: False
    nil: False

# The name a clause gives a slot's parameter, or `""` for `ignore`.
SlotName: fn FnClause, Nat -> Text
fn SlotName c, j = match c.params[j]:
    ? p: match p.kind:
        PName n: SNameKey n
        otherwise: ""
    nil: ""

# The seeds of module `h` for these slots and summaries; `withTop` keeps the `⊤` entries
# the fixed point reads (a slot not yet narrowed), which the final seeds drop.
SlotSeeds: fn Shrink, Text, [Slot], (Text ==> Rel), Bool -> (Text ==> Rel)
fn SlotSeeds sk, h, slots, sums, withTop:
    let pre = Or sk.seeds[h], {}
    let start = if withTop: Insert pre, "⊤", Rel(param=topParam, strict=False) else: pre
    Fold slots, start, \|m, sl| Fold (Spellings sk.g, h, sl.owner), m, \|m2, sp|
        let m3 = Insert m2, "acc:{sp}:{sl.at}", Rel(param=sl.arity, strict=False)
        Fold (Range0 sl.arity), m3, \|m4, q| match sums["{sl.owner}:{sl.at}:{q}"]:
            ? r: if r.param == topParam and not withTop: m4 else: Insert m4, "sum:{sp}:{sl.at}:{q}", r
            nil: m4

# The spellings of a global name that resolve to it from module `h`: bare, qualified.
Spellings: fn G, Text, Text -> [Text]
fn Spellings g, h, k = Filter (AddText [[BareName k]], k), \|sp| (?ResolveName g, h, sp) == ? k

# Drop every slot whose parameter escapes, until none does.
ClearSlots: unbounded fn Shrink, [Text], [Slot], Nat -> [Slot]
fn ClearSlots sk, homes, slots, round:
    let sks = SeedsFor sk, homes, slots, {}, False
    let kept = Filter slots, \|sl| not (SlotEscapes sks, sl)
    if (Len kept) == (Len slots): kept
    else: if round > 20: [[]]
    else: ClearSlots sk, homes, kept, round + 1

SeedsFor: fn Shrink, [Text], [Slot], (Text ==> Rel), Bool -> Shrink
fn SeedsFor sk, homes, slots, sums, withTop = update sk:
    &_.seeds <= Fold homes, {}, \|m, h| Insert m, h, (SlotSeeds sk, h, slots, sums, withTop)

# Whether a slot's parameter is used but as a callee or passed to a cleared slot: a name
# that still means the parameter, read as a value; a call of it inside a closure that may
# run later.
SlotEscapes: unbounded fn Shrink, Slot -> Bool
fn SlotEscapes sk, sl = match sk.byKey[sl.owner]:
    ? d: Fold (DefClauses d), False, \|seen, c|
        let n = SlotName c, sl.at
        if seen or n == "": seen
        else: Fold (BodySpots c.body, (ClauseBase sk, d, c)), False, \|esc, sp| esc or SpotEscapes sp, n, sl.at
    nil: True

SpotEscapes: unbounded fn Spot, Text, Nat -> Bool
fn SpotEscapes sp, n, j = match sp:
    SpotExpr e, m: match e.kind:
        EName x: (SNameKey x) == n and IsSlotParam m, n, j
        otherwise: Fold (SpotSites sp), False, \|seen, site| seen or (site.callee == n and (IsSlotParam site.rels, n, j) and HasKey site.rels, "lam:")
    SpotStmt ignore, ignore: False

# Whether a name, where it stands, still means parameter `j` (nothing bound it again).
IsSlotParam: fn (Text ==> Rel), Text, Nat -> Bool
fn IsSlotParam m, n, j = m[n] == ? Rel(param=j, strict=False)

# Every summary entry `KEY:J:Q` at the start of the fixed point: anything (`⊤`).
TopSums: fn [Slot] -> (Text ==> Rel)
fn TopSums slots = Fold slots, {}, \|m, sl| Fold (Range0 sl.arity), m, \|m2, q| Insert m2, "{sl.owner}:{sl.at}:{q}", Rel(param=topParam, strict=False)

# Each round: every call of a slot's parameter, a forward to a cleared slot included,
# narrows what the summary says of each argument; a round that changes nothing ends it.
# One that never settles keeps no summary (sound: the closure's parameters relate to
# nothing).
SlotSums: unbounded fn Shrink, [Text], [Slot], (Text ==> Rel), Nat -> (Text ==> Rel)
fn SlotSums sk, homes, slots, sums, round:
    let sks = SeedsFor sk, homes, slots, sums, True
    let next = Fold slots, {}, \|m, sl|
        let calls = SlotCalls sks, sl
        Fold (Range0 sl.arity), m, \|m2, q| match ?MeetArgs calls, q:
            ? r: Insert m2, "{sl.owner}:{sl.at}:{q}", r
            nil: m2
    if next == sums: next
    else: if round > 12: {}
    else: SlotSums sk, homes, slots, next, round + 1

# The calls of a slot's parameter in every clause, read with the clause's summaries.
SlotCalls: unbounded fn Shrink, Slot -> [Site]
fn SlotCalls sk, sl = match sk.byKey[sl.owner]:
    ? d: Fold (DefClauses d), [[]], \|acc, c|
        let n = SlotName c, sl.at
        if n == "": acc
        else:
            let base = ClauseBase sk, d, c
            let rels = SummarySeeds sk, d, (BodySpots c.body, base), base
            Fold (BodySpots c.body, rels), acc, \|a2, sp| match sp:
                SpotExpr e, ignore: match e.kind:
                    EName ignore: a2
                    otherwise: Append a2, (Filter (SpotSites sp), \|site| site.callee == n and IsSlotParam site.rels, n, sl.at)
                otherwise: a2
    nil: [[]]

# What every call passes as argument `q`: the one parameter all of them are no larger
# than, strictly when all are strictly smaller; `⊤` when no call narrows it; `nil` when
# two disagree or one relates to nothing.
?MeetArgs: unbounded fn [Site], Nat -> ?Rel
fn ?MeetArgs calls, q = Fold calls, (? Rel(param=topParam, strict=False)), \|?acc, site| match ?acc:
    nil: nil
    ? acc: match site.args[q]:
        ? a: if a.?name != nil: nil else: match ?RelOf site.rels, a.value:
            ? r: if r.param == topParam: ? acc else: if acc.param == topParam: ? r else: if acc.param == r.param: ? Rel(param=r.param, strict=(acc.strict and r.strict)) else: nil
            nil: nil
        nil: nil

# The definitions a body mentions, resolved to their keys; a name bound where it stands
# (a parameter, a `let`, a pattern, a local `fn`) is not a global.
DefRefs: unbounded fn Shrink, Def -> [Text]
fn DefRefs sk, d = Fold (DefClauses d), [[]], \|acc, c| SpotsRefs sk, d, (BodySpots c.body, (ClauseBase sk, d, c)), acc

SpotsRefs: unbounded fn Shrink, Def, [Spot], [Text] -> [Text]
fn SpotsRefs sk, d, spots, acc = Fold spots, acc, \|a1, sp| Fold (SpotSites sp), a1, \|a2, site| match ?LocalTarget sk, d, site:
        ? t: AddText a2, t
        nil:
            if (IsLocal site.rels, site.callee) or HasKey sk.localOf, d.qk: a2
            else: match ?ResolveCallee sk.g, d.home, site.callee:
                ? k: Fold (TargetsOf sk, k), a2, \|a3, t| if HasKey sk.byKey, t: AddText a3, t else: a3
                nil: a2

# ---- Pick LF. A local `fn` or widget is a definition of the shrink check too. This
# never ends, and nothing global is on its cycle:
#
#     fn Grow n:
#         fn Spin k = Spin k
#         Spin n
#
# A call of a local is never a global's (pick RN), so `Spin k` was an edge to nothing.
# Each local, every clause of it at any depth of a definition's body (`fn` lines of one
# name in one block are one local), is a definition keyed by where it stands, its walk
# starting from the relations where it is written less what they say of names (a captured
# name is no parameter of the local) and its own parameters'. A call of a name that means
# that local where it stands (`lfn:NAME`, by where the block's first clause of it starts)
# is a call of it. A local's calls of globals stay where they were, read in place as the
# enclosing definition's (its captured names related to the enclosing parameters), so the
# local's own graphs are its calls of locals; a cycle among locals is cleared when the
# enclosing definition is `unbounded fn`.
WithLocals: unbounded fn Shrink, [((Def, Text, Text, (Text ==> Rel), ?FnClause, ?WidgetDecl))] -> Shrink
fn WithLocals sk, found:
    let ((bases, owners, clauses, wdecls)) = Fold found, (({}, {}, {}, {})), \|((bs, os, cs, ws)), ((d, gk, n, m, ?c, ?w))|
        let qk = LocalKey n, d.qk, gk
        let bs2 = if HasKey bs, qk: bs else: Insert bs, qk, (Marks m)
        let os2 = Insert os, qk, d.qk
        let cs2 = match ?c:
            ? c: Insert cs, qk, (Push (Or cs[qk], [[]]), c)
            nil: cs
        let ws2 = match ?w:
            ? w: Insert ws, qk, ((d, w))
            nil: ws
        ((bs2, os2, cs2, ws2))
    let fnDefs = Fold (Keys clauses), [[]], \|acc, qk| match ((owners[qk], clauses[qk])):
        ((? oq, ? cl)): match sk.byKey[oq]:
            ? d: Push acc, Def(qk=qk, name=(Or (Split qk, " #")[0], qk), home=d.home, file=d.file, span=d.span, body=(DbFn cl))
            nil: acc
        otherwise: acc
    let wDefs = Fold (Keys wdecls), [[]], \|acc, qk| match wdecls[qk]:
        ? ((d, w)): Push acc, Def(qk=qk, name=(SNameKey w.name), home=d.home, file=d.file, span=w.span, body=(DbWidget w))
        nil: acc
    let locals = Append fnDefs, wDefs
    update sk:
        &_.fns <= Append &_.fns, locals
        &_.byKey <= Fold locals, &_.byKey, \|m, d| Insert m, d.qk, d
        &_.localOf <= owners
        &_.localBase <= bases

# A local's key: its name, the top-level definition that holds it, where its block's
# first clause of it stands (`FILE.START`).
LocalKey: fn Text, Text, Text -> Text
fn LocalKey n, owner, gk = "{n} #local {owner} {gk}"

# A top-level definition's references (`DefRefs`) and every local `fn` clause and local
# widget its body holds, at any depth, from one walk: each local with where its name's
# block group stands, its name, and the relations where it is written.
DefWalk: unbounded fn Shrink, Def -> ((Text, [Text], [((Def, Text, Text, (Text ==> Rel), ?FnClause, ?WidgetDecl))]))
fn DefWalk sk, d:
    let ((refs, locals)) = Fold (DefClauses d), (([[]], [[]])), \|((rs, ls)), c|
        let spots = BodySpots c.body, (ClauseBase sk, d, c)
        (((SpotsRefs sk, d, spots, rs), (Fold spots, ls, \|a2, sp| Append a2, (SpotLocal d, sp))))
    ((d.qk, refs, locals))

SpotLocal: fn Def, Spot -> [((Def, Text, Text, (Text ==> Rel), ?FnClause, ?WidgetDecl))]
fn SpotLocal d, sp = match sp:
    SpotStmt s, m: match s.kind:
        SFn f:
            let n = DefNameText f.name
            match m["lfn:{n}"]:
                ? r: [[((d, "{d.file}.{r.param}", n, m, (? f), nil))]]
                nil: [[]]
        SWidget w:
            let n = SNameKey w.name
            match m["lfn:{n}"]:
                ? r: [[((d, "{d.file}.{r.param}", n, m, nil, (? w)))]]
                nil: [[]]
        otherwise: [[]]
    otherwise: [[]]

# The local a site calls, when its name means one where it stands (pick LF).
?LocalTarget: fn Shrink, Def, Site -> ?Text
fn ?LocalTarget sk, d, site = match site.rels["lfn:{site.callee}"]:
    ? r: ? (LocalKey site.callee, (Or sk.localOf[d.qk], d.qk), "{d.file}.{r.param}")
    nil: nil

# The relations a clause's walk starts from: its module's seeds, its parameters'.
ClauseBase: unbounded fn Shrink, Def, FnClause -> (Text ==> Rel)
fn ClauseBase sk, d, c = match sk.localBase[d.qk]:
    ? b: ParamRelsOn b, c.params
    nil: ParamRelsOn (Insert (Or sk.seeds[d.home], {}), "file:", Rel(param=d.file, strict=False)), c.params

# The key a site's name calls: an operator by its spelling, as inference reads it; a
# template call's `<@Name` as `@Name`, else `Name`, as lowering reads it.
?ResolveCallee: fn G, Text, Text -> ?Text
fn ?ResolveCallee g, m, n = if IsOpText n: ?ResolveOp g, m, n else: match ?ResolveName g, m, n:
    ? k: ? k
    nil: if (Take n, 1) == "@": ?ResolveName g, m, (Drop n, 1) else: nil

?ResolveOp: fn G, Text, Text -> ?Text
fn ?ResolveOp g, m, op:
    let ((?k, ignore)) = ResolveValue g, m, (SName(sigils="", path=[[op]], span=Range(start=0, end=0)))
    ?k

# An operator's spelling: no letter in it.
IsOpText: fn Text -> Bool
fn IsOpText n = (Len n) > 0 and not (Fold (Chars n), False, \|seen, ch| seen or (IsUpper ch) or (IsLower ch) or ch == "_")

?ResolveName: fn G, Text, Text -> ?Text
fn ?ResolveName g, m, n:
    let marks = MarksOf n
    let path = Split (Drop n, (Len marks)), "."
    let ((?k, ignore)) = ResolveValue g, m, (SName(sigils=marks, path=path, span=Range(start=0, end=0)))
    ?k

# Every name a statement mentions, at any depth (`CheckBlocks.DepOrder` reads it too).
NamesInStmt: unbounded fn Stmt -> [Text]
fn NamesInStmt s = SpotsNames (StmtSpots s, {})

# Strongly connected components with a cycle (Kosaraju's two passes, from memory): a
# depth-first post-order over the graph, then the reversed graph read in the reverse of
# that order, each new root collecting its component. A component counts when it has two
# definitions or one that names itself.
Sccs: unbounded fn [Text], [((Text, [Text]))] -> [ [Text] ]
fn Sccs keys, refs:
    let adj = Fold refs, {}, \|m, ((k, rs))| Insert m, k, rs
    let rev = Fold refs, {}, \|m, ((k, rs))| Fold rs, m, \|m2, r| Insert m2, r, (Push (Or m2[r], [[]]), k)
    let ((ignore, post)) = Fold keys, (({}, [[]])), \|((seen, out)), k| PostVisit adj, seen, out, k
    let ((ignore2, comps)) = Fold (Reverse2 post), (({}, [[]])), \|((seen, acc)), k|
        if HasKey seen, k: ((seen, acc))
        else:
            let ((seen2, comp)) = Collect rev, seen, [[]], k
            ((seen2, (Push acc, comp)))
    Filter comps, \|c| (Len c) > 1 or (Fold c, False, \|self, k| self or HasText (Or adj[k], [[]]), k)

PostVisit: unbounded fn (Text ==> [Text]), (Text ==> Bool), [Text], Text -> (((Text ==> Bool), [Text]))
fn PostVisit adj, seen, out, k:
    if HasKey seen, k: ((seen, out))
    else:
        let ((seen2, out2)) = Fold (Or adj[k], [[]]), (((Insert seen, k, True), out)), \|((s, o)), n| PostVisit adj, s, o, n
        ((seen2, (Push out2, k)))

Collect: unbounded fn (Text ==> [Text]), (Text ==> Bool), [Text], Text -> (((Text ==> Bool), [Text]))
fn Collect rev, seen, comp, k:
    if HasKey seen, k: ((seen, comp))
    else: Fold (Or rev[k], [[]]), (((Insert seen, k, True), (Push comp, k))), \|((s, c)), n| Collect rev, s, c, n

# One cycle of the reference graph: cleared when every function on it is unbounded,
# else every idempotent size-change graph of the composition closure needs a strictly
# smaller edge from a parameter to itself.
ShrinkComponent: unbounded fn Shrink, St, [Text] -> St
fn ShrinkComponent sk, st, comp:
    if Fold comp, True, \|ok, k| ok and IsUnboundedKey sk.g, (SigKeyOf sk, (Or sk.localOf[k], k)): st
    else:
        let graphs = Fold sk.fns, [[]], \|acc, d| if HasText comp, d.qk: Append acc, (CallGraphs sk, d, comp) else: acc
        let closure = Closure graphs
        let bad = Filter closure, \|sc| sc.caller == sc.callee and (Compose sc, sc).edges == sc.edges and not (Fold sc.edges, False, \|seen, ((a, b, s))| seen or (a == b and s))
        match bad[0]:
            ? sc:
                let s2 = update st:
                    &_.file <= sc.file
                let what = if sc.arg == "": "" else: " on `{sc.arg}`"
                let st3 = ErrFix s2, "may-not-end", sc.span, "`{ShownKey sc.caller}` calls {if sc.caller == sc.callee: "itself" else: "`{ShownKey sc.callee}`"}{what}, not smaller than what it was given", "make an argument shrink (a part taken apart by `match`, or the `? m` of `match n -? 1`), or mark the cycle's functions `unbounded fn`"
                update st3:
                    &_.file <= st.file
            nil: st

# Every call from `d` into the component, as a size-change graph. A name mentioned but
# not called is a call with no edges.
CallGraphs: unbounded fn Shrink, Def, [Text] -> [Sc]
fn CallGraphs sk, d, comp = Fold (DefClauses d), [[]], \|acc, c| Append acc, (ClauseGraphs sk, d, c, comp)

ClauseGraphs: unbounded fn Shrink, Def, FnClause, [Text] -> [Sc]
fn ClauseGraphs sk, d, c, comp:
    let base = ClauseBase sk, d, c
    let rels = SummarySeeds sk, d, (BodySpots c.body, base), base
    Fold (BodySites c.body, rels), [[]], \|acc, site| match ?LocalTarget sk, d, site:
        ? t: if HasText comp, t: Push acc, (SiteGraph sk, d, site, t) else: acc
        nil:
            if (IsLocal site.rels, site.callee) or HasKey sk.localOf, d.qk: acc
            else: match ?ResolveCallee sk.g, d.home, site.callee:
                ? k: Fold (DispatchTargets sk, d, site, k), acc, \|acc2, t| if HasText comp, t: Push acc2, (SiteGraph sk, d, site, t) else: acc2
                nil: acc

# One call as a size-change graph: an edge from what each argument is no larger than to
# the parameter it fills.
SiteGraph: unbounded fn Shrink, Def, Site, Text -> Sc
fn SiteGraph sk, d, site, k:
    let edges = Fold (ArgSlots sk, site.args, k), [[]], \|es, ((j, a))| match ?RelOf site.rels, a.value:
        ? r: Push es, ((r.param, j, r.strict))
        nil: es
    let argText = match site.args[0]:
        ? a: ExprName a.value
        nil: ""
    Sc(caller=d.qk, callee=k, edges=edges, span=site.span, file=d.file, arg=argText)

# Each argument with the callee's parameter it fills: a positional one by its place among
# the positional ones; a named one (a template call's attribute, `<@Item depth={{d}}/>`)
# by name, the parameter every clause of the callee that names it gives that place, and
# none when no clause names it or two disagree.
ArgSlots: unbounded fn Shrink, [Arg], Text -> [((Nat, Arg))]
fn ArgSlots sk, args, k:
    let ((ignore, out)) = Fold args, ((0, [[]])), \|((pos, acc)), a| match a.?name:
        nil: ((pos + 1, (Push acc, ((pos, a)))))
        ? id: match ?ParamNamed sk, k, id.name:
            ? j: ((pos, (Push acc, ((j, a)))))
            nil: ((pos, acc))
    out

?ParamNamed: unbounded fn Shrink, Text, Text -> ?Nat
fn ?ParamNamed sk, k, name:
    let clauses = DefClauses (Or sk.byKey[k], dummyDef)
    if name == "#body": match clauses[0]:
        ? c: if (Len c.params) > 0: ? (Dec (Len c.params)) else: nil
        nil: nil
    else: ?ParamNamedIn clauses, name

# The place every clause that names `name` gives it (pick TK's rule, as the checker reads a
# template call's attributes).
?ParamNamedIn: unbounded fn [FnClause], Text -> ?Nat
fn ?ParamNamedIn clauses, name:
    let found = Fold clauses, [[]], \|acc, c| Fold (Range0 (Len c.params)), acc, \|a2, i| match c.params[i]:
        ? p: if (ParamNameOf p) == name and not (HasNat a2, i): Push a2, i else: a2
        nil: a2
    if (Len found) == 1: found[0] else: nil

# The name a parameter pattern gives its parameter, without its marks: `depth`, `$text`.
ParamNameOf: unbounded fn Pattern -> Text
fn ParamNameOf p = match p.kind:
    PName n:
        let text = SNameKey n
        Drop text, (Len (MarksOf text))
    PGroup q: ParamNameOf q
    otherwise: ""

ExprName: fn Expr -> Text
fn ExprName e = match e.kind:
    EName n: SNameKey n
    EGroup x: ExprName x
    otherwise: ""

# A clause's parameters: a name is no larger than its parameter, a part taken apart by the
# clause's pattern is strictly smaller; each is a local where the clause stands.
ParamRels: unbounded fn [Pattern] -> (Text ==> Rel)
fn ParamRels ps = ParamRelsOn {}, ps

ParamRelsOn: unbounded fn (Text ==> Rel), [Pattern] -> (Text ==> Rel)
fn ParamRelsOn base, ps = Fold (Range0 (Len ps)), (Hide base, (PatternsNames ps)), \|m, i| match ps[i]:
    ? p: match p.kind:
        PName n: Insert m, (SNameKey n), Rel(param=i, strict=False)
        otherwise: Fold (PatternNames p), m, \|m2, n| Insert m2, n, Rel(param=i, strict=True)
    nil: m

# ---- Relations are scoped. A name relates to what its own binding makes of it: bound
# again (a `let`, a pattern, a lambda's parameter, a `for`'s binder, a local `fn`), it
# relates to nothing but what its new definition relates to; a `match` arm's or an `if`'s
# bindings are seen only in that arm. A part is what a `match` takes apart in the arm that
# took it (Semantics ch. 7), not a name another arm happens to share.

# Forget what outer bindings said of these names, and mark them local where they are
# bound: a call of one is not a call of a global of the same name, a `Fold` bound here is
# not the prelude's. The map's other entries have a `:` in their keys, which no name has:
# `local:NAME`, `pre:NAME` (the name resolves to the prelude's declaration), `fn:NAME`
# (a summary, pick SM), `acc:NAME:J` and `sum:NAME:J:Q` (a closure parameter, pick CT),
# `lam:` (inside a closure that may run later), `ne:NAME` (the name is known non-empty
# here, pick SM), `lamlet:NAME` (a block's `let NAME = \|..| ..`, by where the lambda
# starts, pick PS), `lfn:NAME` (a local `fn` or widget, by where its block's first
# clause of it starts, pick LF), `file:` (the file the walk is in) and `nat:FILE:START:END` (a `-?` the
# solver made a `Nat`'s, pick SW). Binding a name again forgets its `ne:` and `lamlet:`.
Hide: fn (Text ==> Rel), [Text] -> (Text ==> Rel)
fn Hide m, names = Fold names, m, \|m2, n| Insert (Remove (Remove (Remove (Remove m2, n), "ne:{n}"), "lamlet:{n}"), "lfn:{n}"), "local:{n}", noRel

let noRel = Rel(param=0, strict=False)

IsLocal: fn (Text ==> Rel), Text -> Bool
fn IsLocal m, n = HasKey m, "local:{n}"

# Whether a name, where it stands, is the prelude's declaration `Prelude.BARE` (bare or
# qualified).
PreIs: fn (Text ==> Rel), Text, Text -> Bool
fn PreIs m, n, bare = (n == bare or n == "Prelude.{bare}") and (HasKey m, "pre:{n}") and not (IsLocal m, n)

# The prelude's names the checks read for what they mean, and the spellings of each that
# resolve to the prelude's own declaration from module `h`: the module `Prelude`'s, never
# a local's or a program module's of the same name.
let preludeNames = [["Drop", "Take", "Filter", "Remove", "Min", "Values", "Keys", "?Step", "Fold", "Each", "Push", "Insert", "Append", "Freeze", "-?", "@Defer", "@Later", "@Run", "@Machine", "@started"]]

PreludeSeeds: fn G, Text -> (Text ==> Rel)
fn PreludeSeeds g, h = Fold preludeNames, {}, \|m, n|
    let q = "Prelude.{n}"
    if not (IsPreludeKey g, q): m
    else: Fold [[n, q]], m, \|m2, sp| if (?ResolveCallee g, h, sp) == ? q: Insert m2, "pre:{sp}", noRel else: m2

# A key is the prelude's when module `Prelude` declares it in one of the prelude's own
# files (from `g.preludeFrom` on), by module identity, never by the text of the name: a
# program's own `module Prelude` is one of the program's files.
IsPreludeKey: fn G, Text -> Bool
fn IsPreludeKey g, q = match g.vals[q]:
    ? v: (Take q, 8) == "Prelude." and v.home == "Prelude" and v.file >= g.preludeFrom
    nil: False

# A block is one binding group, so its names hide the outer ones on every line of it; then
# each `let` and bind, in page order, relates its names from its subject.
BlockRels: unbounded fn [Stmt], (Text ==> Rel) -> (Text ==> Rel)
fn BlockRels stmts, m = Fold stmts, (LocalFnMarks stmts, (Hide m, (StmtsBinders stmts))), \|m2, s| LamLetRels s, (StmtRels s, m2)

# Each local `fn` and widget of a block, by where its first clause starts (pick LF).
LocalFnMarks: fn [Stmt], (Text ==> Rel) -> (Text ==> Rel)
fn LocalFnMarks stmts, m = Fold stmts, m, \|m2, s|
    let ?n = match s.kind:
        SFn f: ? (DefNameText f.name)
        SWidget w: ? (SNameKey w.name)
        otherwise: nil
    match ?n:
        ? n: if HasKey m2, "lfn:{n}": m2 else: Insert m2, "lfn:{n}", Rel(param=s.span.start, strict=False)
        nil: m2

# The names a block's own statements bind.
StmtsBinders: unbounded fn [Stmt] -> [Text]
fn StmtsBinders stmts = Fold stmts, [[]], \|acc, s| match s.kind:
    SLet p, ignore, ignore: UnionTexts acc, (PatternNames p)
    SBind p, ignore, ignore: UnionTexts acc, (PatternNames p)
    SFn f: AddText acc, (DefNameText f.name)
    SWidget w: AddText acc, (SNameKey w.name)
    otherwise: acc

StmtRels: unbounded fn Stmt, (Text ==> Rel) -> (Text ==> Rel)
fn StmtRels s, m = match s.kind:
    SLet p, ignore, e: BindRels p, e, m, False
    SBind p, e, nil: BindRels p, e, m, True
    otherwise: m

# The relations a `match` arm's or a bind's pattern makes from its subject: the pattern's
# names hide what outer bindings said of them, then relate to what the subject is no
# larger than.
BindRels: unbounded fn Pattern, Expr, (Text ==> Rel), Bool -> (Text ==> Rel)
fn BindRels p, e, m, refutable:
    let ?base = ?RelOf m, e
    let ?dec = ?DecrementOf m, e
    let h = NonEmptyRels (Hide m, (PatternNames p)), p, e, refutable
    match p.kind:
        PName n: match ?base:
            ? r: Insert h, (SNameKey n), r
            nil: match ?dec:
                ? r: if refutable: Insert h, (SNameKey n), r else: h
                nil: h
        PSigil "?", inner: match ?dec:
            ? r: Fold (PatternNames inner), h, \|m2, n| Insert m2, n, r
            nil: match ?base:
                ? r: Fold (PatternNames inner), h, \|m2, n| Insert m2, n, Rel(param=r.param, strict=True)
                nil: h
        otherwise: match ?base:
            ? r: Fold (PatternNames p), h, \|m2, n| Insert m2, n, Rel(param=r.param, strict=True)
            nil: h

# A refutable pattern that took an element shows the collection non-empty where it binds
# (pick SM, `Drop`): the `? x` of `xs[i]`, or an array pattern of one element or more on
# `xs`. A pattern that binds the collection's name again shows nothing.
NonEmptyRels: unbounded fn (Text ==> Rel), Pattern, Expr, Bool -> (Text ==> Rel)
fn NonEmptyRels m, p, e, refutable = if not refutable: m else: match ?NonEmptyName p, e:
    ? n: if HasText (PatternNames p), n: m else: Insert m, "ne:{n}", noRel
    nil: m

?NonEmptyName: fn Pattern, Expr -> ?Text
fn ?NonEmptyName p, e = match e.kind:
    EGroup x: ?NonEmptyName p, x
    EIndex r, ignore: match p.kind:
        PSigil "?", ignore: ?NameOf r
        PGroup q: ?NonEmptyName q, e
        otherwise: nil
    EName n: match p.kind:
        PArray ps: if (Len ps) > 0: ? (SNameKey n) else: nil
        PGroup q: ?NonEmptyName q, e
        otherwise: nil
    otherwise: nil

?NameOf: fn Expr -> ?Text
fn ?NameOf e = match e.kind:
    EName n: ? (SNameKey n)
    EGroup x: ?NameOf x
    otherwise: nil

# A `match` arm's relations before its block: its pattern's, from the subject.
ArmPatRels: unbounded fn Expr, Arm, (Text ==> Rel) -> (Text ==> Rel)
fn ArmPatRels s, a, m = match a.?pattern:
    ? p: BindRels p, s, m, True
    nil: m

# An `if`'s `then` block's relations before the block: a `? x <- e` condition's pattern's.
CondRels: unbounded fn Cond, (Text ==> Rel) -> (Text ==> Rel)
fn CondRels c, m = match c:
    CondBind p, x, ignore: BindRels p, x, m, True
    CondExpr ignore: m

# The prelude's traversals hand their closure the collection's elements, each a part of
# it (Semantics ch. 7, Keep shrinking; doubt TR): `Fold xs, z, \|acc, x| ...`, `Each xs,
# \|x| ...` and `Filter xs, \|x| ...` over a collection no larger than a parameter bind
# the element strictly smaller than the parameter; a `Fold` over a map binds its key and
# value so. Every parameter of the step hides the outer names it shares.
StepRels: unbounded fn (Text ==> Rel), Expr, [Pattern], Nat -> (Text ==> Rel)
fn StepRels m, coll, ps, at:
    let h = Hide m, (Fold ps, [[]], \|a, p| UnionTexts a, (PatternNames p))
    match ?RelOf m, coll:
        ? r: Fold (Drop ps, at), h, \|m2, p| Fold (PatternNames p), m2, \|m3, n| Insert m3, n, Rel(param=r.param, strict=True)
        nil: h

# ---- The walk. Every expression and statement of a body, at any depth, listed once with
# the relations in scope where it stands: a `match` guard, a method call's receiver and
# arguments, named arguments, text and template placeholders, `if`, `while` and `given:`
# conditions, `require` and `forbid`, `update` statements, lambda bodies, local `fn`s and
# widgets. The call sites, the names a body mentions, the names it binds and the loops it
# holds are all read from this one list, so no reader misses a form another one sees.

# A place the walk stops: an expression or a statement, with its relations.
type Spot = choice:
    SpotExpr Expr, (Text ==> Rel)
    SpotStmt Stmt, (Text ==> Rel)
derive ^Eq, ^Show

# What a node holds one level down: an expression, or a block's statements, each with the
# relations it is read under.
type Kid = choice:
    KidExpr Expr, (Text ==> Rel)
    KidStmts [Stmt], (Text ==> Rel)
derive ^Eq, ^Show

ExprSpots: unbounded fn Expr, (Text ==> Rel) -> [Spot]
fn ExprSpots e, m = Fold (ExprKids e, m), [[(SpotExpr e, m)]], \|acc, k| Append acc, (KidSpots k)

KidSpots: unbounded fn Kid -> [Spot]
fn KidSpots (KidExpr x, m) = ExprSpots x, m
fn KidSpots (KidStmts ss, m) = StmtsSpots ss, m

# A block is one binding group: its statements are read under the block's relations.
StmtsSpots: unbounded fn [Stmt], (Text ==> Rel) -> [Spot]
fn StmtsSpots stmts, m:
    let bm = BlockRels stmts, m
    Fold stmts, [[]], \|acc, s| Append acc, (StmtSpots s, bm)

StmtSpots: unbounded fn Stmt, (Text ==> Rel) -> [Spot]
fn StmtSpots s, m = Fold (StmtKids s, m), [[(SpotStmt s, m)]], \|acc, k| Append acc, (KidSpots k)

BodySpots: unbounded fn FnBody, (Text ==> Rel) -> [Spot]
fn BodySpots (BodyExpr e), m = ExprSpots e, m
fn BodySpots (BodyBlock b), m = StmtsSpots b.stmts, m

ExprKids: unbounded fn Expr, (Text ==> Rel) -> [Kid]
fn ExprKids e, m = match e.kind:
    ECall c, args, ignore, ignore: CallKids c, args, m
    EMethod r, n, args: CallKids (MethodCallee n), (MethodArgs r, args), m
    EBinary ignore, l, r: ExprsKids [[l, r]], m
    ESuffixed ignore, ignore, l, r: ExprsKids [[l, r]], m
    EIndex r, i: ExprsKids [[r, i]], m
    EUnary ignore, x: [[(KidExpr x, m)]]
    EFreeSigil ignore, x: [[(KidExpr x, m)]]
    EField r, ignore, ignore: [[(KidExpr r, m)]]
    ETopicIndex x: [[(KidExpr x, m)]]
    EGroup x: [[(KidExpr x, m)]]
    ETypeArgs x, ignore: [[(KidExpr x, m)]]
    ECast x, ignore, ignore: [[(KidExpr x, m)]]
    ENonEmpty x: [[(KidExpr x, m)]]
    EAny x: [[(KidExpr x, m)]]
    ETuple es: ExprsKids es, m
    EArray es: ExprsKids es, m
    EMap kvs: Fold kvs, [[]], \|acc, ((k, v))| Append acc, (ExprsKids [[k, v]], m)
    ELit l: match l.kind:
        LText segs: Fold segs, [[]], \|acc, sg| match sg:
            SegPlaceholder x: Push acc, (KidExpr x, m)
            otherwise: acc
        otherwise: [[]]
    ELambda ?ps, body: [[(LambdaKid body, (Later (Hide m, (PatternsNames (Or ?ps, [[]])))))]]
    EIf c, t, ?el:
        let withThen = Push (CondKids c, m), (KidStmts t.stmts, (CondRels c, m))
        match ?el:
            ? b: Push withThen, (KidStmts b.stmts, m)
            nil: withThen
    EMatch s, arms: Fold arms, [[(KidExpr s, m)]], \|acc, a|
        let am = ArmPatRels s, a, m
        Push (Append acc, (OptKids a.?guard, am)), (KidStmts a.body.stmts, am)
    ERebuild s, b: [[(KidExpr s, m), (KidStmts b.stmts, (Later m))]]
    EUpdate s, b: [[(KidExpr s, m), (KidStmts b.stmts, m)]]
    EMonad s, b: [[(KidExpr s, m), (KidStmts b.stmts, m)]]
    EFor ?fb, s, b:
        let names = match ?fb:
            ? fb: UnionTexts (PatternNames fb.first), (OptNames fb.?second)
            nil: [[]]
        [[(KidExpr s, m), (KidStmts b.stmts, (Hide m, names))]]
    EGiven b: [[(KidStmts b.stmts, m)]]
    EWidgetBlock b: [[(KidStmts b.stmts, (Later m))]]
    ETemplate t: TemplateKids t.parts, m
    otherwise: [[]]

StmtKids: unbounded fn Stmt, (Text ==> Rel) -> [Kid]
fn StmtKids s, m = match s.kind:
    SBind ignore, e, ?t: Append [[(KidExpr e, m)]], (OptKids ?t, m)
    SIgnore e: [[(KidExpr e, m)]]
    SLet ignore, ignore, e: [[(KidExpr e, m)]]
    SFn f: [[(BodyKid f.body, (Later (Hide m, (PatternsNames f.params))))]]
    SWidget w: [[(KidStmts w.body.stmts, (Later m))]]
    SSet t, v: ExprsKids [[t, v]], m
    SAccum t, ignore, v: ExprsKids [[t, v]], m
    SRequire c: [[(KidExpr c, m)]]
    SForbid c: [[(KidExpr c, m)]]
    SReturn e: [[(KidExpr e, m)]]
    SWhile c, b: Push (CondKids c, m), (KidStmts b.stmts, (CondRels c, m))
    SExpr e: [[(KidExpr e, m)]]
    otherwise: [[]]

# A condition's subject, and a `? x <- e if g` guard, which sees the pattern's names.
CondKids: unbounded fn Cond, (Text ==> Rel) -> [Kid]
fn CondKids c, m = match c:
    CondExpr x: [[(KidExpr x, m)]]
    CondBind ignore, x, ?g: Append [[(KidExpr x, m)]], (OptKids ?g, (CondRels c, m))

# A call's children: its callee unless a name calls it (the call is that name's site),
# and its arguments. A traversal hands its step the collection's elements, so a step
# lambda's body reads them as parts (`StepRels`), and a named step is a call of its own
# (`CallSites`). A closure passed where a program function only calls it (pick CT,
# `acc:` entries) is read the same way: a lambda's body with its parameters related as
# the function's summary says, a named function as a call of its own.
CallKids: unbounded fn Expr, [Arg], (Text ==> Rel) -> [Kid]
fn CallKids c, args, m:
    let callee = match ?CalleeName c:
        ? ignore: [[]]
        nil: [[(KidExpr c, m)]]
    match ?TraversalOf m, c, args:
        nil: match ?AccCallee m, c, args:
            ? cn: Append callee, (Fold (Range0 (Len args)), [[]], \|acc, i| Append acc, (AccKids m, cn, args, i))
            nil: Append callee, (ExprsKids (Each args, \|a| a.value), m)
        ? ((coll, step, at)):
            let others = Fold (Range0 (Len args)), callee, \|acc, i| if i == at + 1: acc else: match args[i]:
                ? a: Push acc, (KidExpr a.value, m)
                nil: acc
            match step.kind:
                ELambda (? ps), body: Push others, (LambdaKid body, (StepRels m, coll, ps, at))
                EName ignore: others
                otherwise: Push others, (KidExpr step, m)

# Inside a closure that may run after the walk's function returned (a lambda but a
# traversal's step or a closure argument pick CT clears, a local `fn`, a blueprint), for
# pick CT's test that a closure parameter is only called.
Later: fn (Text ==> Rel) -> (Text ==> Rel)
fn Later m = Insert m, "lam:", noRel

# The callee of a call with a closure slot pick CT clears: a global name, every argument
# by position.
?AccCallee: fn (Text ==> Rel), Expr, [Arg] -> ?Text
fn ?AccCallee m, c, args = match ?CalleeName c:
    ? cn:
        if IsLocal m, cn: nil
        else: if not (Fold args, True, \|ok, a| ok and a.?name == nil): nil
        else: if Fold (Range0 (Len args)), False, \|seen, i| seen or HasKey m, "acc:{cn}:{i}": ? cn else: nil
    nil: nil

# An argument at a cleared closure slot: a lambda's body, its parameters related by the
# summary; a name, nothing here (its call is `AccSites`').
AccKids: unbounded fn (Text ==> Rel), Text, [Arg], Nat -> [Kid]
fn AccKids m, cn, args, i:
    let a = Or args[i], dummyArg
    if not (HasKey m, "acc:{cn}:{i}"): [[(KidExpr a.value, m)]]
    else: match a.value.kind:
        ELambda ?ps, body: [[(LambdaKid body, (AccLambdaRels m, cn, i, (Or ?ps, [[]]), args))]]
        EName ignore: [[]]
        otherwise: [[(KidExpr a.value, m)]]

# A lambda at slot `j` of `cn`: its parameter `q` is what the summary says the function
# passes there, read from the call's own arguments (`sum:CN:J:Q` names the parameter of
# `cn` it is no larger than, or strictly smaller than).
AccLambdaRels: unbounded fn (Text ==> Rel), Text, Nat, [Pattern], [Arg] -> (Text ==> Rel)
fn AccLambdaRels m, cn, j, ps, args:
    let h = Hide m, (PatternsNames ps)
    Fold (Range0 (Len ps)), h, \|m2, q| match ((m["sum:{cn}:{j}:{q}"], ps[q])):
        ((? s, ? p)): if s.param == topParam: m2 else: match args[s.param]:
            ? a: match ?RelOf m, a.value:
                ? r: match p.kind:
                    PName n: Insert m2, (SNameKey n), Rel(param=r.param, strict=(r.strict or s.strict))
                    otherwise: Fold (PatternNames p), m2, \|m3, n| Insert m3, n, Rel(param=r.param, strict=True)
                nil: m2
            nil: m2
        otherwise: m2

# The summary of a closure parameter nothing has narrowed yet (pick CT's fixed point).
let topParam = 9999

TemplateKids: unbounded fn [TemplatePart], (Text ==> Rel) -> [Kid]
fn TemplateKids parts, m = Fold parts, [[]], \|acc, p| match p:
    TpPlaceholder x, ignore: Push acc, (KidExpr x, m)
    TpBlock b: Push acc, (KidStmts b.stmts, m)
    TpCall n, args, ?ps, span: Push acc, (KidExpr (TemplateCallExpr n, args, ?ps, span), m)
    otherwise: acc

# `<@Name attr={{v}}>body</@Name>` is the call `Name` with its attributes as named
# arguments and its body, a text, in the callee's last parameter (Templates ch. 2; pick
# TK): the body is the argument named `#body`, which no attribute can be.
TemplateCallExpr: fn SName, [Arg], ?[TemplatePart], Range -> Expr
fn TemplateCallExpr n, args, ?ps, span:
    let body = match ?ps:
        ? ps: [[Arg(name=(? Ident(name="#body", span=span)), value=(Expr(kind=(ETemplate (Template(keyword="InlineText", lang="", delims="double", parts=ps, span=span))), span=span)), span=span)]]
        nil: [[]]
    Expr(kind=(ECall (Expr(kind=(EName n), span=n.span)), (Append args, body), False, False), span=span)

ArgOf: fn Expr -> Arg
fn ArgOf x = Arg(name=nil, value=x, span=x.span)

ExprsKids: fn [Expr], (Text ==> Rel) -> [Kid]
fn ExprsKids xs, m = Each xs, \|x| KidExpr x, m

OptKids: fn ?Expr, (Text ==> Rel) -> [Kid]
fn OptKids (? x), m = [[(KidExpr x, m)]]
fn OptKids nil, ignore = [[]]

LambdaKid: fn LambdaBody, (Text ==> Rel) -> Kid
fn LambdaKid (LbExpr x), m = KidExpr x, m
fn LambdaKid (LbBlock b), m = KidStmts b.stmts, m

BodyKid: fn FnBody, (Text ==> Rel) -> Kid
fn BodyKid (BodyExpr x), m = KidExpr x, m
fn BodyKid (BodyBlock b), m = KidStmts b.stmts, m

PatternsNames: unbounded fn [Pattern] -> [Text]
fn PatternsNames ps = Fold ps, [[]], \|a, p| UnionTexts a, (PatternNames p)

# The name a call applies, when its callee is one (`F`, `F<<T>>`).
?CalleeName: fn Expr -> ?Text
fn ?CalleeName c = match c.kind:
    EName n: ? (SNameKey n)
    ETypeArgs t, ignore: match t.kind:
        EName n: ? (SNameKey n)
        otherwise: nil
    otherwise: nil

# `recv.Method args` is the call `Method recv, args`, as inference reads it.
MethodCallee: fn SName -> Expr
fn MethodCallee n = Expr(kind=(EName n), span=n.span)

MethodArgs: fn Expr, [Arg] -> [Arg]
fn MethodArgs r, args = Append [[Arg(name=nil, value=r, span=r.span)]], args

# A call in a clause's body with the relations in scope where it stands; a name mentioned
# without being called is a call with no arguments.
type Site = record:
    callee: Text
    args: [Arg]
    span: Range
    rels: (Text ==> Rel)
derive ^Eq, ^Show

BodySites: unbounded fn FnBody, (Text ==> Rel) -> [Site]
fn BodySites body, m = Fold (BodySpots body, m), [[]], \|acc, sp| Append acc, (SpotSites sp)

# The calls at one spot: a name (a call with no arguments when nothing applies it), a call
# or method call of a name, an operator (its trait method's, pick OP), a template call,
# and a traversal's named step.
SpotSites: unbounded fn Spot -> [Site]
fn SpotSites (SpotStmt ignore, ignore) = [[]]
fn SpotSites (SpotExpr e, m) = match e.kind:
    EName n: [[Site(callee=(SNameKey n), args=[[]], span=e.span, rels=m)]]
    ECall c, args, ignore, ignore: CallSites c, args, e.span, m
    EMethod r, n, args: CallSites (MethodCallee n), (MethodArgs r, args), e.span, m
    EBinary op, l, r: if IsCalledOp op: [[Site(callee=op, args=[[(ArgOf l), (ArgOf r)]], span=e.span, rels=m)]] else: [[]]
    otherwise: [[]]

# The binary operators that are a trait method's: all but the built-in forms.
IsCalledOp: fn Text -> Bool
fn IsCalledOp op = not (HasText [["and", "or", "on", "<|", "mod"]], op)

# A call of a name, and a traversal's named step (doubt TR): `Fold xs, z, F` is a call
# `F z, x` for each `x` of `xs`, an `Each` or a `Filter` `F x`, with the element written
# `(xs).element` so the relation reads it as a part. A named function at a closure slot
# pick CT clears is a call of its own (`AccSites`).
CallSites: unbounded fn Expr, [Arg], Range, (Text ==> Rel) -> [Site]
fn CallSites c, args, span, m:
    let direct = match ?CalleeName c:
        ? n: [[Site(callee=n, args=args, span=span, rels=m)]]
        nil: [[]]
    match ?TraversalOf m, c, args:
        ? ((coll, step, at)): match step.kind:
            EName n:
                let callArgs = if at == 1: [[(Or args[1], dummyArg), (ArgOf (PartOf coll))]] else: [[ArgOf (PartOf coll)]]
                Push direct, Site(callee=(SNameKey n), args=callArgs, span=step.span, rels=m)
            otherwise: direct
        nil: match ?AccCallee m, c, args:
            ? cn: Append direct, (AccSites m, cn, args)
            nil: direct

# `x.element`: a part of `x`, for the relations.
PartOf: fn Expr -> Expr
fn PartOf x = Expr(kind=(EField x, "", Ident(name="element", span=x.span)), span=x.span)

# A name at a cleared closure slot of `cn` is called as the summary says: its argument `q`
# is the call's argument the summary names, or a part of it.
AccSites: fn (Text ==> Rel), Text, [Arg] -> [Site]
fn AccSites m, cn, args = Fold (Range0 (Len args)), [[]], \|acc, j| match ((m["acc:{cn}:{j}"], args[j])):
    ((? ar, ? a)): match a.value.kind:
        EName f: Push acc, Site(callee=(SNameKey f), args=(Each (Range0 ar.param), \|q| AccArg m, cn, j, q, args), span=a.value.span, rels=m)
        otherwise: acc
    otherwise: acc

AccArg: fn (Text ==> Rel), Text, Nat, Nat, [Arg] -> Arg
fn AccArg m, cn, j, q, args = match m["sum:{cn}:{j}:{q}"]:
    ? s:
        if s.param == topParam: ArgOf topExpr
        else: match args[s.param]:
            ? a: ArgOf (if s.strict: PartOf a.value else: a.value)
            nil: dummyArg
    nil: dummyArg

# What a slot not yet narrowed passes (pick CT's fixed point reads it as anything).
let topExpr = Expr(kind=(EName (SName(sigils="", path=[["⊤"]], span=Range(start=0, end=0)))), span=Range(start=0, end=0))

# The names a spot mentions: what it calls (an operator, a template call), a local
# widget's name.
SpotsNames: unbounded fn [Spot] -> [Text]
fn SpotsNames spots = Fold spots, [[]], \|acc, sp| UnionTexts acc, (SpotNames sp)

SpotNames: unbounded fn Spot -> [Text]
fn SpotNames sp:
    let called = Each (SpotSites sp), \|s| s.callee
    match sp:
        SpotExpr ignore, ignore: called
        SpotStmt s, ignore: match s.kind:
            SWidget w: AddText called, (SNameKey w.name)
            otherwise: called

# A call of the prelude's `Fold`, `Each` or `Filter` (by resolution, never a local or a
# program's own): its collection, its step, and the position of the step's first element
# parameter.
?TraversalOf: fn (Text ==> Rel), Expr, [Arg] -> ?((Expr, Expr, Nat))
fn ?TraversalOf m, c, args = match c.kind:
    EName n:
        let name = SNameKey n
        if (PreIs m, name, "Fold") and (Len args) == 3: match ((args[0], args[2])):
            ((? a, ? s)): ? ((a.value, s.value, 1))
            otherwise: nil
        else: if ((PreIs m, name, "Each") or (PreIs m, name, "Filter")) and (Len args) == 2: match ((args[0], args[1])):
            ((? a, ? s)): ? ((a.value, s.value, 0))
            otherwise: nil
        else: nil
    otherwise: nil

?LastExpr: fn Block -> ?Expr
fn ?LastExpr b = match ?Last b.stmts:
    ? s: match s.kind:
        SExpr x: ? x
        otherwise: nil
    nil: nil

# What an expression is known to be no larger than: a parameter, a field of one (a part),
# a text or array with something dropped from its front (strictly smaller only where a
# pattern took an element of it, `ne:`; `Drop` of an empty list is the empty list). A map's children are its parts
# (Semantics ch. 7, Keep shrinking; doubt TR): `Values m` and `Keys m` are no larger than
# `m`, so a traversal over them hands out parts, and `m[k]` is no larger than `m`, so the
# `? e` of a match on it is a part; an index on an array is its element likewise. A call
# of a function whose summary returns parts of its parameter `i`, or of a prelude function
# that returns no more than its first argument (`fn:NAME` in the map, seeded by
# `SummarySeeds`; picks SM and SW), is no larger than its argument `i`. A call is read in
# either spelling, `Kids xs` or `xs.Kids`.
?RelOf: unbounded fn (Text ==> Rel), Expr -> ?Rel
fn ?RelOf m, e = match e.kind:
    EName n: m[SNameKey n]
    EField r, ignore, ignore: match ?RelOf m, r:
        ? x: ? Rel(param=x.param, strict=True)
        nil: nil
    EIndex r, ignore: ?RelOf m, r
    EGroup x: ?RelOf m, x
    otherwise: match ?CallOf e:
        ? ((c, args)): if IsNonNatMin m, e, c: nil else: ?RelOfCall m, c, args
        nil: nil

# A call of the prelude's `Min` that the solver did not make a `Nat`'s: no larger than
# nothing, since `Min` by `^Ord` may return its second argument, of any size (pick SW).
IsNonNatMin: fn (Text ==> Rel), Expr, Expr -> Bool
fn IsNonNatMin m, e, c = match ?CalleeName c:
    ? n: if PreIs m, n, "Min": not (IsNatAt m, e) else: False
    nil: False

# Whether the solver made the operand at this expression a `Nat` (`nat:` entries).
IsNatAt: fn (Text ==> Rel), Expr -> Bool
fn IsNatAt m, e = match m["file:"]:
    ? f: HasKey m, "nat:{f.param}:{e.span.start}:{e.span.end}"
    nil: False

?RelOfCall: unbounded fn (Text ==> Rel), Expr, [Arg] -> ?Rel
fn ?RelOfCall m, c, args = match c.kind:
    EName n:
        let name = SNameKey n
        if (PreIs m, name, "Drop") and (Len args) == 2 and IsPositiveLit (Or args[1], dummyArg).value:
            match args[0]:
                ? a: match ?RelOf m, a.value:
                    ? x: ? Rel(param=x.param, strict=(x.strict or KnownNonEmpty m, a.value))
                    nil: nil
                nil: nil
        else: if ((PreIs m, name, "Values") or (PreIs m, name, "Keys")) and (Len args) == 1: ?RelOf m, (Or args[0], dummyArg).value
        else: match ?NoLargerArg m, c, args:
            ? a: ?RelOf m, a
            nil: nil
    otherwise: nil

# Whether a pattern above, in scope here, took an element of this name (`NonEmptyRels`).
KnownNonEmpty: fn (Text ==> Rel), Expr -> Bool
fn KnownNonEmpty m, e = match ?NameOf e:
    ? n: HasKey m, "ne:{n}"
    nil: False

# A call in either spelling: `F x, y`, or `x.F y` as `F x, y`, as inference reads it.
?CallOf: fn Expr -> ?((Expr, [Arg]))
fn ?CallOf e = match e.kind:
    ECall c, args, ignore, ignore: ? ((c, args))
    EMethod r, n, args: ? (((MethodCallee n), (MethodArgs r, args)))
    otherwise: nil

# The argument a call's result is no larger than: the summarized parameter's (pick SM),
# or a prelude function's first (pick SW), by the clause's `fn:NAME` entries.
?NoLargerArg: fn (Text ==> Rel), Expr, [Arg] -> ?Expr
fn ?NoLargerArg m, c, args = match ?CalleeName c:
    ? n: if IsLocal m, n: nil else: match m["fn:{n}"]:
        ? s: match args[s.param]:
            ? a: ? a.value
            nil: nil
        nil: nil
    nil: nil

# The prelude's functions that return no more than their first argument (pick SW), as the
# prelude declares them.
IsNoLargerPrelude: fn G, Text -> Bool
fn IsNoLargerPrelude g, k = (HasText [["Prelude.Take", "Prelude.Drop", "Prelude.Filter", "Prelude.Remove", "Prelude.Min"]], k) and IsPreludeKey g, k

# ---- Summaries: a function that returns parts of its parameter `i` (Semantics ch. 7, the
# size-change principle across the call). A clause's result is within parameter `i` when
# it is no larger than it (`?RelOf`), an array or map literal of its parts, a `match` or
# `if` whose every arm is, a `Filter` or an `Each` of parts over a collection within it,
# or a `Fold` over one from an empty or within start whose step returns its accumulator
# or the accumulator with parts added (`Push`, `Insert`, `Append` of a within). A part is
# strictly smaller than parameter `i`, or a tuple of such: a tuple is not a recursive
# type, so a cycle reaches only its pieces. A summary reads its body without other
# summaries, so it never depends on itself.
PartsSummaries: unbounded fn Shrink, [Def] -> (Text ==> Nat)
fn PartsSummaries sk, fns = Fold fns, {}, \|m, d| match d.body:
    DbFn clauses:
        let n = match clauses[0]:
            ? c0: Len c0.params
            nil: 0
        let ok = Filter (Range0 n), \|i| Fold clauses, True, \|okc, c| okc and ClauseWithin (ClauseBase sk, d, c), c, i
        match ok[0]:
            ? i: Insert m, d.qk, i
            nil: m
    otherwise: m

ClauseWithin: unbounded fn (Text ==> Rel), FnClause, Nat -> Bool
fn ClauseWithin base, c, i = match c.body:
    BodyExpr e: Within base, i, e
    BodyBlock b: WithinBlock base, i, b

Within: unbounded fn (Text ==> Rel), Nat, Expr -> Bool
fn Within m, i, e = match ?RelOf m, e:
    ? r: r.param == i
    nil: match e.kind:
        EArray es: Fold es, True, \|ok, x| ok and Part m, i, x
        EMap kvs: Fold kvs, True, \|ok, ((k, v))| ok and (Part m, i, k) and Part m, i, v
        EGroup x: Within m, i, x
        EMatch s, arms: Fold arms, True, \|ok, a| ok and WithinBlock (ArmPatRels s, a, m), i, a.body
        EIf c, t, (? el): (WithinBlock (CondRels c, m), i, t) and WithinBlock m, i, el
        EUpdate start, b: (Within m, i, start) and UpdateWithin (Insert m, "&_", Rel(param=i, strict=False)), i, b
        otherwise: match ?CallOf e:
            ? ((c, args)): match ?TraversalOf m, c, args:
                ? ((coll, step, at)): (Within m, i, coll) and StepWithin m, i, (ExprName c), coll, step, at, (Or args[1], dummyArg).value
                nil: False
            nil: False

# An `update` block over a start within `i` stays within it when every set of `&_`, at any
# depth, is no larger than `&_` (`&_ <= next`, with `next` from `?Step &_`), and nothing
# adds to `&_` or sets a field of it.
UpdateWithin: unbounded fn (Text ==> Rel), Nat, Block -> Bool
fn UpdateWithin m, i, b = Fold (StmtsSpots b.stmts, m), True, \|ok, sp| ok and SpotKeepsWithin sp, i

SpotKeepsWithin: unbounded fn Spot, Nat -> Bool
fn SpotKeepsWithin (SpotStmt s, m), i = match s.kind:
    SSet t, value:
        if (Take (RefPath t), 1) != [["&_"]]: True
        else: (RefPath t) == [["&_"]] and Within m, i, value
    SAccum t, ignore, ignore: (Take (RefPath t), 1) != [["&_"]]
    otherwise: True
fn SpotKeepsWithin (SpotExpr ignore, ignore), ignore = True

# A block's last expression, read with the block's relations.
WithinBlock: unbounded fn (Text ==> Rel), Nat, Block -> Bool
fn WithinBlock m, i, b = Within (BlockRels b.stmts, m), i, (LastOr b)

# A traversal's step, for `Within`: a `Filter` keeps elements, an `Each` must map them to
# parts, a `Fold` must start within and build on its accumulator.
StepWithin: unbounded fn (Text ==> Rel), Nat, Text, Expr, Expr, Nat, Expr -> Bool
fn StepWithin m, i, f, coll, step, at, z:
    if PreIs m, f, "Filter": True
    else: match step.kind:
        ELambda (? ps), body:
            let sm = StepRels m, coll, ps, at
            let ((bm, x)) = match body:
                LbExpr y: ((sm, y))
                LbBlock b: (((BlockRels b.stmts, sm), (LastOr b)))
            if PreIs m, f, "Each": Part bm, i, x
            else: match ps[0]:
                ? acc: match acc.kind:
                    PName n: (Within m, i, z) and BuildsOn bm, i, (SNameKey n), x
                    otherwise: False
                nil: False
        otherwise: False

# A block's last expression, or one that is within nothing.
LastOr: fn Block -> Expr
fn LastOr b = Or (?LastExpr b), dummyArg.value

# A `Fold` step's result: the accumulator, or the accumulator with parts added.
BuildsOn: unbounded fn (Text ==> Rel), Nat, Text, Expr -> Bool
fn BuildsOn m, i, acc, e = match e.kind:
    EName n: (SNameKey n) == acc
    EGroup x: BuildsOn m, i, acc, x
    EMatch s, arms: Fold arms, True, \|ok, a| ok and not (HasText (OptNames a.?pattern), acc) and BuildsOnBlock (ArmPatRels s, a, m), i, acc, a.body
    EIf c, t, (? el): (not (HasText (CondNames c), acc)) and (BuildsOnBlock (CondRels c, m), i, acc, t) and BuildsOnBlock m, i, acc, el
    otherwise: match ?CallOf e:
        ? ((c, args)): BuildsOnCall m, i, acc, c, args
        nil: False

# `Push acc, x`, `Insert acc, k, v`, `Append acc, ys`, in either spelling.
BuildsOnCall: unbounded fn (Text ==> Rel), Nat, Text, Expr, [Arg] -> Bool
fn BuildsOnCall m, i, acc, c, args:
    let f = ExprName c
    let onAcc = BuildsOn m, i, acc, (Or args[0], dummyArg).value
    let rest = Each (Drop args, 1), \|a| a.value
    let parts = Fold rest, True, \|ok, x| ok and Part m, i, x
    if not onAcc: False
    else: if (PreIs m, f, "Push") and (Len rest) == 1: parts
    else: if (PreIs m, f, "Insert") and (Len rest) == 2: parts
    else: if (PreIs m, f, "Append") and (Len rest) == 1: Within m, i, (Or rest[0], dummyArg.value)
    else: False

# A block's last expression, for `BuildsOn`; a block that binds the accumulator's name
# again no longer means the accumulator by it.
BuildsOnBlock: unbounded fn (Text ==> Rel), Nat, Text, Block -> Bool
fn BuildsOnBlock m, i, acc, b = (not (HasText (StmtsBinders b.stmts), acc)) and BuildsOn (BlockRels b.stmts, m), i, acc, (LastOr b)

CondNames: unbounded fn Cond -> [Text]
fn CondNames (CondBind p, ignore, ignore) = PatternNames p
fn CondNames (CondExpr ignore) = [[]]

Part: unbounded fn (Text ==> Rel), Nat, Expr -> Bool
fn Part m, i, e = match e.kind:
    ETuple es: Fold es, True, \|ok, x| ok and Part m, i, x
    EGroup x: Part m, i, x
    otherwise: match ?RelOf m, e:
        ? r: r.param == i and r.strict
        nil: False

# The summaries a clause's calls use, as `fn:NAME` entries of its relations, each the
# callee's parameter: a summarized function's (pick SM), a prelude function's that
# returns no more than its first argument (pick SW). A call of a name bound where it
# stands (a parameter, a `let`, a lambda's or an arm's pattern, a local `fn`) is not the
# global function's, which `?NoLargerArg` checks at each call. `spots` is the clause's
# walk.
SummarySeeds: unbounded fn Shrink, Def, [Spot], (Text ==> Rel) -> (Text ==> Rel)
fn SummarySeeds sk, d, spots, rels = Fold (Fold spots, [[]], \|acc, sp| Append acc, (SpotSites sp)), rels, \|m, site| if IsLocal site.rels, site.callee: m else: match ?ResolveCallee sk.g, d.home, site.callee:
    ? k: match sk.sums[k]:
        ? i: Insert m, "fn:{site.callee}", Rel(param=i, strict=False)
        nil: if IsNoLargerPrelude sk.g, k: Insert m, "fn:{site.callee}", Rel(param=0, strict=False) else: m
    nil: m

OptNames: unbounded fn ?Pattern -> [Text]
fn OptNames (? p) = PatternNames p
fn OptNames nil = [[]]

let dummyArg = Arg(name=nil, value=Expr(kind=EError, span=Range(start=0, end=0)), span=Range(start=0, end=0))

# `n -? k` with `k` a positive literal: the `? m` of a match on it is strictly smaller
# than `n` (Semantics ch. 7, a smaller natural number); `?Step c` likewise for a cursor.
?DecrementOf: unbounded fn (Text ==> Rel), Expr -> ?Rel
fn ?DecrementOf m, e = match e.kind:
    EBinary "-?", l, r: if (IsPositiveLit r) and IsNatMinus m, e: ?Smaller m, l else: nil
    EGroup x: ?DecrementOf m, x
    otherwise: match ?CallOf e:
        ? ((c, args)): match ?CalleeName c:
            ? n: if PreIs m, n, "?Step": ?Smaller m, (Or args[0], dummyArg).value else: nil
            nil: nil
        nil: nil

# Whether a `-?` is the prelude's on `Nat`: the name resolves to the prelude's `-?` where
# it stands (pick RN), and the solver made its operand a `Nat` (`nat:` entries, from
# `St.sizeTys`). An `Int`'s `-?` goes down forever, and a program's own `-?` is anything.
IsNatMinus: fn (Text ==> Rel), Expr -> Bool
fn IsNatMinus m, e = (PreIs m, "-?", "-?") and IsNatAt m, e

?Smaller: unbounded fn (Text ==> Rel), Expr -> ?Rel
fn ?Smaller m, x = match ?RelOf m, x:
    ? r: ? Rel(param=r.param, strict=True)
    nil: nil

IsPositiveLit: fn Expr -> Bool
fn IsPositiveLit e = match e.kind:
    ELit l: match l.kind:
        LInt d: d != "0"
        otherwise: False
    EGroup x: IsPositiveLit x
    otherwise: False

# The composition closure of the size-change graphs, to its fixed point: each round
# composes the graphs the last round found with the call graphs, and a round that finds
# nothing new ends it. It ends because the graphs are finitely many: a caller, a callee,
# and a set of edges between their parameters. A cap on the rounds would stop before a
# long cycle's bad graph is found, and accept it.
Closure: unbounded fn [Sc] -> [Sc]
fn Closure graphs = ClosureFrom graphs, (Dedup graphs), (Dedup graphs)

Dedup: fn [Sc] -> [Sc]
fn Dedup gs = Fold gs, [[]], \|acc, g| if HasSc acc, g: acc else: Push acc, g

ClosureFrom: unbounded fn [Sc], [Sc], [Sc] -> [Sc]
fn ClosureFrom base, acc, frontier:
    let fresh = Fold frontier, [[]], \|out, a| Fold base, out, \|out2, b| AddComposed acc, out2, a, b
    if (Len fresh) == 0: acc
    else: ClosureFrom base, (Append acc, fresh), fresh

AddComposed: fn [Sc], [Sc], Sc, Sc -> [Sc]
fn AddComposed acc, out, a, b:
    if a.callee != b.caller: out
    else:
        let c = Compose a, b
        if (HasSc acc, c) or (HasSc out, c): out else: Push out, c

HasSc: fn [Sc], Sc -> Bool
fn HasSc xs, c = Fold xs, False, \|seen, x| seen or (x.caller == c.caller and x.callee == c.callee and x.edges == c.edges)

# `a` then `b`: an edge for every path, strict when either step is.
Compose: fn Sc, Sc -> Sc
fn Compose a, b:
    let pairs = Fold a.edges, [[]], \|acc, ((x, y, s1))| Fold b.edges, acc, \|acc2, ((y2, z, s2))| if y == y2: AddEdge acc2, x, z, (s1 or s2) else: acc2
    Sc(caller=a.caller, callee=b.callee, edges=(SortEdges pairs), span=a.span, file=a.file, arg=a.arg)

AddEdge: fn [((Nat, Nat, Bool))], Nat, Nat, Bool -> [((Nat, Nat, Bool))]
fn AddEdge es, x, z, s:
    let others = Filter es, \|((a, b, ignore))| not (a == x and b == z)
    let had = Fold es, False, \|seen, ((a, b, t))| seen or (a == x and b == z and t)
    Push others, ((x, z, (s or had)))

SortEdges: fn [((Nat, Nat, Bool))] -> [((Nat, Nat, Bool))]
fn SortEdges es = Fold es, [[]], \|acc, e| Append (Push (Filter acc, \|x| EdgeBefore x, e), e), (Filter acc, \|x| not (EdgeBefore x, e))

EdgeBefore: fn ((Nat, Nat, Bool)), ((Nat, Nat, Bool)) -> Bool
fn EdgeBefore ((a1, b1, ignore)), ((a2, b2, ignore)) = a1 < a2 or (a1 == a2 and b1 < b2)

# A `while` in a bounded function, wherever it stands (the walk), keeps shrinking when
# some local it sets gets strictly smaller than itself on every path through its body
# (Semantics ch. 5, `while` and every tick ends). In an unbounded function the same
# check decides where the cycle points are (D6): a loop it does not clear is noted in
# the typed tables (`unshrunk`), each of its turns a cycle, and is no error.
LoopsOf: unbounded fn Shrink, St, Def -> St
fn LoopsOf sk, st, d:
    let unb = IsUnboundedKey sk.g, (SigKeyOf sk, d.qk)
    if unb and not st.recording: st
    else:
        let s0 = update st:
            &_.file <= d.file
        let s1 = Fold (DefClauses d), s0, \|s, c| ClauseLoops sk, s, d, c, unb
        update s1:
            &_.file <= st.file

ClauseLoops: unbounded fn Shrink, St, Def, FnClause, Bool -> St
fn ClauseLoops sk, st, d, c, unb:
    let base = ClauseBase sk, d, c
    let spots0 = BodySpots c.body, base
    if not (Fold spots0, False, \|seen, sp| seen or IsWhileSpot sp): st
    else:
        let spots = BodySpots c.body, (SummarySeeds sk, d, spots0, base)
        Fold (Filter spots, \|sp| IsWhileSpot sp), st, \|s, sp| match sp:
            SpotStmt w, m: match w.kind:
                SWhile cond, body: CheckWhile s, cond, body, w.span, d.name, (Marks m), unb
                otherwise: s
            otherwise: s

# A walk's relations less what they say of names: only the entries that are not names
# (`local:`, `pre:`, `fn:`, ...), so a loop's measures start from nothing but where the
# loop stands.
Marks: fn (Text ==> Rel) -> (Text ==> Rel)
fn Marks m = Fold (Keys m), m, \|m2, k| if Contains k, ":": m2 else: Remove m2, k

IsWhileSpot: fn Spot -> Bool
fn IsWhileSpot (SpotStmt s, ignore) = match s.kind:
    SWhile ignore, ignore: True
    otherwise: False
fn IsWhileSpot (SpotExpr ignore, ignore) = False

# `seeds` are the entries where the loop stands that are not names (`Marks`): its
# summaries, its locals, the prelude's names, so a set reads them as a call does.
CheckWhile: unbounded fn St, Cond, Block, Range, Text, (Text ==> Rel), Bool -> St
fn CheckWhile st, c, body, span, name, seeds, unb:
    let vars = SetTargets body.stmts
    # Each local the loop sets is no larger than itself, its own measure `i`, so what a
    # pattern takes apart from it is smaller (relations scoped as for calls).
    let base = Fold (Range0 (Len vars)), seeds, \|m, i| Insert m, (Or vars[i], ""), Rel(param=i, strict=False)
    let rels = CondRels c, base
    let ok = Fold (Range0 (Len vars)), False, \|seen, i| seen or AllPathsStrict body.stmts, (Or vars[i], ""), i, rels
    if ok: st
    else: if unb: NoteUnshrunk st, span
    else: ErrFix st, "may-not-end", span, "this loop in `{name}` may not end: nothing it sets gets smaller on every turn", "set a local from `&x -? 1` through a pattern, as `while ? left <- &fuel -? 1:`, or mark `{name}` `unbounded fn`"

NoteUnshrunk: fn St, Range -> St
fn NoteUnshrunk st, span = update st:
    &_.typed.unshrunk <= Push &_.typed.unshrunk, (AtHere st, span)

# The roots of the references a loop sets, at any depth of its body: the walk's every
# statement, a nested loop's, an `if`'s or `match`'s, a `for`'s, a nested `update`'s, a
# `let` value's, a lambda's.
SetTargets: unbounded fn [Stmt] -> [Text]
fn SetTargets stmts = Fold (StmtsSpots stmts, {}), [[]], \|acc, sp| UnionTexts acc, (SpotSetRoot sp)

SpotSetRoot: unbounded fn Spot -> [Text]
fn SpotSetRoot (SpotStmt s, ignore) = match s.kind:
    SSet t, ignore: Take (RefPath t), 1
    SAccum t, ignore, ignore: Take (RefPath t), 1
    otherwise: [[]]
fn SpotSetRoot (SpotExpr ignore, ignore) = [[]]

# Whether `v`, measure `vi`, gets strictly smaller on every path through the statements,
# each set read with the relations in scope where it stands. A path is the statements of
# the body, and an `if`'s or a `match`'s arms; a set anywhere else (a nested loop, a
# `for`, a nested `update`, a lambda) is on no path for sure, so it may only keep `v`
# strictly smaller.
AllPathsStrict: unbounded fn [Stmt], Text, Nat, (Text ==> Rel) -> Bool
fn AllPathsStrict stmts, v, vi, outer:
    let rels = BlockRels stmts, outer
    Fold stmts, False, \|ok, s| match s.kind:
        SSet t, value:
            if (RefPath t) == [[v]]: (if IsZeroLit value: ok else: SetsStrict value, v, vi, rels)
            else: ok and not (StmtSetsWeak s, v, vi, rels)
        SExpr e: match e.kind:
            EIf c, tb, ?eb:
                let tr = CondRels c, rels
                match ?eb:
                    ? b: if (AllPathsStrict tb.stmts, v, vi, tr) and (AllPathsStrict b.stmts, v, vi, rels): True else: ok and not (SetsWeak tb.stmts, v, vi, tr) and not (SetsWeak b.stmts, v, vi, rels)
                    nil: ok and not (SetsWeak tb.stmts, v, vi, tr)
            EMatch subj, arms:
                if Fold arms, True, \|allArms, a| allArms and AllPathsStrict a.body.stmts, v, vi, (ArmPatRels subj, a, rels): True
                else: ok and not (Fold arms, False, \|anyArm, a| anyArm or SetsWeak a.body.stmts, v, vi, (ArmPatRels subj, a, rels))
            otherwise: ok and not (StmtSetsWeak s, v, vi, rels)
        otherwise: ok and not (StmtSetsWeak s, v, vi, rels)

# Whether some set of `v` among the statements, at any depth, is not strictly smaller: a
# `+=` or a set whose value is not, through a field of `v` (`&v.kids <= ...`) too.
SetsWeak: unbounded fn [Stmt], Text, Nat, (Text ==> Rel) -> Bool
fn SetsWeak stmts, v, vi, outer = Fold (StmtsSpots stmts, outer), False, \|seen, sp| seen or SpotSetsWeak sp, v, vi

StmtSetsWeak: unbounded fn Stmt, Text, Nat, (Text ==> Rel) -> Bool
fn StmtSetsWeak s, v, vi, rels = Fold (StmtSpots s, rels), False, \|seen, sp| seen or SpotSetsWeak sp, v, vi

SpotSetsWeak: unbounded fn Spot, Text, Nat -> Bool
fn SpotSetsWeak (SpotStmt s, m), v, vi = match s.kind:
    SSet t, value: (Take (RefPath t), 1) == [[v]] and not (SetsStrict value, v, vi, m) and not ((RefPath t) == [[v]] and IsZeroLit value)
    SAccum t, ignore, ignore: (Take (RefPath t), 1) == [[v]]
    otherwise: False
fn SpotSetsWeak (SpotExpr ignore, ignore), ignore, ignore = False

# `&v <= 0` is no decrease of its own (a literal is smaller only than a local known to be
# greater), but it keeps one: after `&fuel <= left` on the same path, `0` is no larger than
# `left`, the bottom of `Nat`, as `-?` takes the local to be.
IsZeroLit: fn Expr -> Bool
fn IsZeroLit e = match e.kind:
    ELit l: match l.kind:
        LInt d: d == "0"
        otherwise: False
    EGroup x: IsZeroLit x
    otherwise: False

# Pick SW: a value set into `v` is strictly smaller than `v` itself (its measure `vi`), not
# than some other local, when the relations in scope where the set stands say so (a
# name, a field or an index of a part of `v`, `Drop` of `v` by a positive literal, a
# summarized call on a part); when it is a call that returns no more than an argument
# strictly smaller than `v` (a summarized function's parameter, pick SM; the prelude's
# `Take`, `Drop`, `Filter`, `Remove` and `Min`, on their first); `x -? k` of such an `x`;
# never a literal: `0` is smaller only than a local known to be greater, which the
# checker cannot know (`while True: &n <= 0` sets `0` forever); `IsZeroLit` lets a `0`
# keep a decrease made earlier on the same path.
SetsStrict: unbounded fn Expr, Text, Nat, (Text ==> Rel) -> Bool
fn SetsStrict e, v, vi, rels = match e.kind:
    EGroup x: SetsStrict x, v, vi, rels
    EBinary "-?", l, ignore: (IsNatMinus rels, e) and SetsStrict l, v, vi, rels
    otherwise: (RelStrict rels, e, vi) or (CallStrict e, v, vi, rels)

RelStrict: unbounded fn (Text ==> Rel), Expr, Nat -> Bool
fn RelStrict rels, e, vi = match ?RelOf rels, e:
    ? r: r.strict and r.param == vi
    nil: False

CallStrict: unbounded fn Expr, Text, Nat, (Text ==> Rel) -> Bool
fn CallStrict e, v, vi, rels = match ?CallOf e:
    ? ((c, args)): if IsNonNatMin rels, e, c: False else: match ?NoLargerArg rels, c, args:
        ? a: SetsStrict a, v, vi, rels
        nil: False
    nil: False

# ---------------------------------------------------------------------------------------
# Inclusion and the forwarding-arm remainder (ch. 5, pass 5)
# ---------------------------------------------------------------------------------------

# Every `R1 ≤ R2` from index `from` on: a child's row within its scope's (`row-outside`),
# and at an arm that emits its scrutinee, the remainder within the host's row
# (`forwarding`, naming each tag left). A flexible tail unsolved on the left becomes empty
# (doubt RI).
DischargeIncls: unbounded fn G, St, Nat -> St
fn DischargeIncls g, st, from:
    let batch = Drop st.incls, from
    Fold batch, st, \|s, inc| DischargeOne g, s, (Through s, inc, batch)

# An obligation into a row still unknown that another obligation of the batch puts within
# a known one is checked against the known one: a supplier's arms emit into the row a host
# document's bind then puts in the host's scope.
Through: unbounded fn St, Incl, [Incl] -> Incl
fn Through st, inc, batch:
    let sup = WalkRow st, inc.sup
    match sup.tail:
        TlFlex n:
            if (Len sup.fams) > 0: inc
            else: Fold batch, inc, \|acc, other|
                let sub = WalkRow st, other.sub
                if (Len sub.fams) == 0 and sub.tail == (TlFlex n) and other != inc:
                    update acc:
                        &_.sup <= other.sup
                else: acc
        otherwise: inc

DischargeOne: unbounded fn G, St, Incl -> St
fn DischargeOne g, st, inc:
    let sub = WalkRow st, inc.sub
    let sup = WalkRow st, inc.sup
    let st1 = match sub.tail:
        TlFlex n: CloseTail st, n
        otherwise: st
    let sub2 = WalkRow st1, inc.sub
    let left = Filter sub2.fams, \|f| not (HasText sup.fams, f) and (Len (TagsLeft g, f, sub2.minus)) > 0
    let tailBad = match ((sub2.tail, sup.tail)):
        ((TlRigid a, TlRigid b)): a != b
        ((TlRigid ignore, ignore)): True
        otherwise: False
    if (Len left) == 0 and not tailBad: st1
    else:
        let s0 = update st1:
            &_.file <= inc.file
        let tags = Fold left, [[]], \|acc, f| Append acc, (TagsLeft g, f, sub2.minus)
        let s1 = if inc.forward: ErrFix s0, "forwarding", inc.span, "forwarding {Join tags, ", "} from a scope that emits {ShowRow sup}", "answer {if (Len tags) == 1: "it" else: "them"} above this arm, for example `{Or tags[0], ""}(..): @ never`" else: ErrFix s0, "row-outside", inc.span, "a child that emits `{ShowRow sub2}` in a scope that emits `{ShowRow sup}`", "widen the scope's `emit` row, or host the child with `@HostDocument`"
        update s1:
            &_.file <= st1.file

TagsLeft: fn G, Text, [Text] -> [Text]
fn TagsLeft g, fam, minus = Filter (Or g.families[fam], [[]]), \|t| not (HasText minus, t) and (IsElementTag g, t)

IsElementTag: fn G, Text -> Bool
fn IsElementTag g, t = match g.tags[t]:
    ? tg: tg.kind == "Element"
    nil: False

CloseTail: fn St, Nat -> St
fn CloseTail st, n = update st:
    &_.rows <= Insert &_.rows, n, emptyRow

# ---------------------------------------------------------------------------------------
# The program
# ---------------------------------------------------------------------------------------

# What the checker says of a program: its diagnostics, rendered, and the root row.
type Report = record:
    text: Text
    errors: Nat
    rootRow: Text
    typed: TProgram
derive ^Eq, ^Show

# The whole checker over a program's files (each already parsed): the environment, every
# definition, the separate checkers, the root row against `world` when one is named.
CheckProgram: unbounded fn [Src], [Module], [Text], Nat, Bool -> Report
fn CheckProgram srcs, trees, world, shown, recording:
    let ((g0a, stb)) = BuildG srcs, trees
    # The prelude is the files from `shown` on (pick RN): a program's own `module Prelude`
    # is one of its files, and means nothing special.
    let g0 = update g0a:
        &_.preludeFrom <= shown
    let st0 = update stb:
        &_.recording <= recording
    let ((g1, st1)) = TopLets g0, st0
    let ((failed, st2)) = Fold g1.defs, (([[]], st1)), \|((bad, s)), d|
        let before = Len s.diags
        let s2 = CheckDef g1, s, d
        let bad2 = if (Len s2.diags) > before: Push bad, (OwnKey d).qk else: bad
        ((bad2, s2))
    let st2b = update st2:
        &_.level <= 0
    let st3 = DefaultWants g1, st2b, [[]]
    # A failed impl's method is its impl's alone: two impls' methods share a key, so the
    # list keys each by where its impl stands (`OwnKey`).
    let good = Filter g1.defs, \|d| not (HasText failed, (OwnKey d).qk)
    let st4 = ShrinkCheck g1, st3, good
    let ((rootRow, st5)) = RootRow g1, st4, world
    let diags = SortDiags (Filter st5.diags, \|d| d.file < shown)
    let text = Concat (Each diags, \|d| RenderCDiag srcs, d)
    let typed = if recording: TypedOf g1, st5, shown else: emptyTyped
    Report(text=text, errors=(Len diags), rootRow=rootRow, typed=typed)

# The typed output: every recorded type followed to its end, and the scheme of every
# top-level definition of the program's own files.
TypedOf: unbounded fn G, St, Nat -> TProgram
fn TypedOf g, st, shown:
    let z = ZonkTyped st
    let vals = Filter (Values g.vals), \|v| v.file < shown and v.sort != "builtin" and (Or g.mods[v.home], dummyMod).file == v.file
    update z:
        &_.defs <= Each vals, \|v| DefNote(at=At(file=v.file, span=v.span), name=v.qk, scheme=(ZonkScheme st, v.scheme))

ZonkScheme: unbounded fn St, Scheme -> Scheme
fn ZonkScheme st, sc = update sc:
    &_.ty <= Zonk st, &_.ty

# Top-level `let`s without a signature, inferred first in the order written, each
# generalized as a local `let` is; their monomorphic variables stay open to the rest of the
# program and default at its end (doubt TL0).
TopLets: unbounded fn G, St -> ((G, St))
fn TopLets g, st:
    let unsigned = Filter g.defs, \|d| (IsLetDef d) and not (HasKey g.vals, d.qk)
    let ((g1, st1)) = Fold unsigned, ((g, st)), \|((gg, s)), d|
        let ((v, s2)) = FreshVar s, False, d.name
        let gg2 = update gg:
            &_.vals <= Insert &_.vals, d.qk, ValInfo(qk=d.qk, scheme=(Mono v), sort="let", hasSig=False, home=d.home, file=d.file, span=d.span)
        ((gg2, s2))
    Fold unsigned, ((g1, st1)), \|((gg, s)), d| match d.body:
        DbLet l:
            let env = DefEnv gg, d
            let s0 = update s:
                &_.file <= d.file
                &_.level <= 1
            let pre = (Or gg.vals[d.qk], dummyVal).scheme.ty
            let s1 = Check env, s0, l.value, pre
            let s2 = SolveWants gg, s1, [[]], False
            let s3 = update s2:
                &_.level <= 0
            let t = Zonk s3, pre
            let ((keep, bounds, s4)) = WantsAbove s3, t, (IsLambda l.value)
            let ((sc, s5)) = if HoldsNode s4, t: ((Mono t, s4)) else: Generalize s4, t, keep, bounds
            let gg2 = update gg:
                &_.vals <= Insert &_.vals, d.qk, ValInfo(qk=d.qk, scheme=sc, sort="let", hasSig=False, home=d.home, file=d.file, span=d.span)
            ((gg2, (DischargeIncls gg, (LayerQuestions (ResolveFields gg, (CheckColors s5), True)), 0)))
        otherwise: ((gg, s))

let dummyVal = ValInfo(qk="", scheme=(Mono TyErr), sort="", hasSig=False, home="", file=0, span=Range(start=0, end=0))

IsLetDef: fn Def -> Bool
fn IsLetDef d = match d.body:
    DbLet ignore: True
    otherwise: False

# The environment a definition's body starts in: its module's row, with the module's row
# variable rigid (as its signatures' bodies see it).
DefEnv: fn G, Def -> Env
fn DefEnv g, d:
    let info = Or g.mods[d.home], dummyMod
    let scope = match info.emitRw.tail:
        TlQ v: Rw(fams=info.emitRw.fams, minus=[[]], tail=(TlRigid v))
        otherwise: info.emitRw
    Env(g=g, home=d.home, file=d.file, src=(Or g.srcs[d.file], (MkSrc "", "")), locals={}, scope=scope, givens=[[]], mark="", inUpdate=False, defName=d.name, refine={}, pending=[[]])

# One definition: its body against its signature; its constraints solved and defaulted;
# its row obligations discharged.
CheckDef: unbounded fn G, St, Def -> St
fn CheckDef g, st, d:
    let env = DefEnv g, d
    let inclsBefore = Len st.incls
    let s0 = update st:
        &_.file <= d.file
        &_.level <= 1
        &_.color <= CBound
        &_.colorWhy <= ""
        &_.colorFlex <= [[]]
        &_.cleqs <= [[]]
    let s1 = match d.body:
        DbFn clauses: match g.vals[d.qk]:
            ? v: CheckClauses env, s0, d.name, clauses, v.scheme, d.span
            nil: s0
        DbWidget w: CheckWidgetDef env, s0, d, w
        DbLet l: match g.vals[d.qk]:
            ? v:
                if v.hasSig: Check env, s0, l.value, (Skolemize v.scheme)
                else: s0
            nil: s0
        DbMethod clauses, cls, im: CheckMethod env, s0, d, clauses, cls, im
        DbDefault clauses, cls: match ?MethodKey g, cls, d.name:
            ? mk: match g.vals[mk]:
                ? v: CheckClauses env, s0, d.name, clauses, v.scheme, d.span
                nil: s0
            nil: s0
        DbCheck c: Fold c.lines, s0, \|s, line|
            let ((t, s2)) = Infer env, s, line.expr
            match line.?pattern:
                ? p:
                    let ((ignore, s3)) = BindPattern env, s2, p, t, True
                    s3
                nil: s2
        DbTest t:
            let ((bt, s2)) = Infer env, s0, t.blueprint
            match Walk s2, bt:
                TyAt ignore, ignore: s2
                TyErr: s2
                other: Err s2, "mismatch", t.blueprint.span, "a test builds a blueprint; this is `{ShowTy s2, other}`"
    let solved = CheckColors (SolveWants g, s1, env.givens, False)
    let defaulted = LayerQuestions (ResolveFields g, (DefaultDef g, solved), True)
    let discharged = DischargeIncls g, defaulted, inclsBefore
    update discharged:
        &_.level <= 0

# The end of a definition: its own variables default (doubt LD); the top-level `let`s'
# monomorphic ones wait for the program's end.
DefaultDef: unbounded fn G, St -> St
fn DefaultDef g, st:
    let mine = Filter st.wants, \|w| match Walk st, w.ty:
        TyFlex n: (InfoOf st, n).level >= 1
        otherwise: True
    let theirs = Filter st.wants, \|w| match Walk st, w.ty:
        TyFlex n: (InfoOf st, n).level < 1
        otherwise: False
    let st1 = update st:
        &_.wants <= mine
    let s2 = DefaultWants g, st1, [[]]
    update s2:
        &_.wants <= Append theirs, &_.wants

# A top-level widget, `@labels:`, against its signature `@labels: @unit`, or inferred.
CheckWidgetDef: unbounded fn Env, St, Def, WidgetDecl -> St
fn CheckWidgetDef env, st, d, w = match env.g.vals[d.qk]:
    ? v: match Skolemize v.scheme:
        TyAt inner, rw:
            let env2 = update env:
                &_.scope <= rw
                &_.mark <= "@"
            let ((t, st2)) = InferWidgetBlock env2, st, w.body
            NoteFn (Unify st2, inner, t, w.span), w.span, d.name, CBound, st2.color
        other: Err st, "mismatch", w.span, "`{d.name}` is declared `{ShowTy st, other}`; a widget block builds a blueprint"
    nil:
        let ((t, st2)) = InferWidgetBlock env, st, w.body
        NoteFn st2, w.span, d.name, CBound, st2.color

?MethodKey: fn G, Text, Text -> ?Text
fn ?MethodKey g, cls, name = Fold (Or g.traits[cls], dummyTrait).methods, nil, \|?found, k| match ?found:
    ? f: ? f
    nil: if (BareName k) == name or (Drop k, (Len (Or g.traits[cls], dummyTrait).home) + 1) == name: ? k else: nil

# An impl's method against its trait's signature at the impl's head (ch. 3): the head's
# variables rigid, the impl's bounds givens.
CheckMethod: unbounded fn Env, St, Def, [FnClause], Text, ImplInfo -> St
fn CheckMethod env, st, d, clauses, cls, im = match ?MethodKey env.g, cls, d.name:
    nil: Err st, "mismatch", d.span, "`^{BareName cls}` has no method `{d.name}`"
    ? mk: match env.g.vals[mk]:
        nil: st
        ? v:
            let ti = Or env.g.traits[cls], dummyTrait
            let head = SubstQ (Inst(tys=(Fold im.qs, {}, \|m, q| Insert m, q, (TyRigid q)), rows={}, cols={})), im.head
            let ty = SubstQ (Inst(tys={ti.param: head}, rows={}, cols={})), v.scheme.ty
            let sc = Scheme(qs=(Filter v.scheme.qs, \|q| q != ti.param), plainQs=[[]], rqs=v.scheme.rqs, cqs=v.scheme.cqs, cjoins=v.scheme.cjoins, bounds=(Filter v.scheme.bounds, \|((q, ignore))| q != ti.param), ty=ty)
            let env2 = update env:
                &_.givens <= im.bounds
            CheckClauses env2, st, d.name, clauses, sc, d.span

# The root row (ch. 5, pass 6): `@main`'s row, the program row when `emit` is implied,
# reported; against a World's families when the command names them (`world-row`).
RootRow: unbounded fn G, St, [Text] -> ((Text, St))
fn RootRow g, st, world = match g.mods[""]:
    nil: (("", st))
    ? info:
        let shown = ShowRow info.emitRw
        if (Len world) == 0: ((shown, st))
        else:
            let missing = Filter info.emitRw.fams, \|f| not (HasText world, f)
            if (Len missing) == 0: ((shown, st))
            else:
                let s0 = update st:
                    &_.file <= info.file
                ((shown, (ErrFix s0, "world-row", info.tree.span, "the program emits {Join (Each missing, \|f| "`{f}.*`"), ", "}, which this World does not answer", "host the tags it cannot answer, or run under a World that answers them")))
