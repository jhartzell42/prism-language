# `Lower.Expr`, a child module of `Lower`.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit r
use Lower.*
use Lower.Types.*
use Lower.Patterns.*
use Lower.Templates.*
use Lower.Functions.*
use Lower.Jobs.*
use Lower.Program.*
use Syntax.*
use Syntax.Decls.*
use Syntax.Lexer.*
use Syntax.Lexer.Chars.*
use Syntax.Lexer.Layout.*
use Syntax.Lexer.Words.*
use Syntax.Lexer.Literals.*
use Syntax.Lexer.Templates.*
use Syntax.Lexer.Corpus.*
use Check.Errors.*
use Check.Types.*
use Check.Types.Recording.*
use Check.Types.Unify.*
use Check.Types.Schemes.*
use Check.Types.Colors.*
use Check.Env.*
use Check.Env.Names.*
use Check.Env.Reading.*
use Check.Env.Decls.*
use Check.Env.Traits.*
use Check.Typed.*
use Check.Typed.Print.*
use Lower.Model.*
use Lower.Node.*
use Lower.Node.Def.*
use Lower.Node.Elements.*
use Lower.Node.Static.*
use Lower.Node.Dynamics.*
use Lower.Node.Finish.*
use Lower.Node.Keyed.*
use Lower.Node.Switch.*

# ---------------------------------------------------------------------------------------
# Literals
# ---------------------------------------------------------------------------------------

# A Rust string literal's inside.
Escape: fn Text -> Text
fn Escape t = MapChars t, \|c| CharEscape c

CharEscape: fn Text -> Text
fn CharEscape "\\" = "\\\\"
fn CharEscape "\"" = "\\\""
fn CharEscape "\n" = "\\n"
fn CharEscape "\t" = "\\t"
fn CharEscape "\u{d}" = "\\r"
fn CharEscape "\u{0}" = "\\0"
fn CharEscape "'" = "\\'"
fn CharEscape c = c

# A number literal of a numeric type.
Number: fn OutTy, Text, Bool -> Ex
fn Number t, digits, neg:
    let clean = DecimalDigits (Concat (SplitOn digits, "_"))
    let signed = if neg: "-{clean}" else: clean
    match t:
        OutNat: XNat clean
        OutInt: XInt signed
        OutU8: (XByte clean)
        OutFloat: XFloat (if Contains clean, ".": signed else: "{signed}.0")
        otherwise: XInt signed

# A literal's digits in plain decimal, every digit kept: a radix literal (`0x`, `0o`,
# `0b`) converted and a decimal one without its leading zeros, so each printer writes
# them in its own language unchanged (C++ reads `010` as octal and has no `0o`). A
# decimal fraction, and digits that are plain decimal already, stay as they are.
DecimalDigits: fn Text -> Text
fn DecimalDigits d:
    let r = if (Head d) == "0": Head (AfterFirst d) else: ""
    let base: Nat = if r == "x": 16 else: if r == "o": 8 else: if r == "b": 2 else: 10
    let ds = if base == 10: d else: AfterFirst (AfterFirst d)
    if (Contains d, ".") or (Head d) != "0" or d == "0": d else: "{FoldChars ds, 0, \|n, c| n * base + (HexValue c)}"

LiteralValue: unbounded fn Lx, Env, Literal, Range, Bool -> Vl
fn LiteralValue lx, env, l, span, neg:
    let t = OutTyOf lx, (Peel (TypeAt lx, span))
    match l.kind:
        LInt d: VlOwned (Number t, d, neg), t
        LFloat d: VlOwned (XFloat (if neg: "-{d}" else: d)), OutFloat
        LChar c: VlOwned (XChar c), OutChar
        LDuration d, u: VlOwned (XDuration (if neg: "-{DurationNanos d, u}" else: "{DurationNanos d, u}")), OutDuration
        LText segs: TextValue lx, env, segs
        LRegex r: match r.?replacement:
            nil: VlOwned (XRegex r.pattern, r.flags), OutRegex
            ? t: VlOwned (XReplacement r.pattern, t, r.flags), OutReplacement

# A text, interpolated: `Text::from(format!(..))`, a `Text`, a `Char` or a number placed
# as it is and any other value through `^Show` (Type System ch. 4; `ShownPart`).
TextValue: unbounded fn Lx, Env, [TextSeg] -> Vl
fn TextValue lx, env, segs:
    let plain = Fold segs, True, \|ok, s| ok and IsPlainSeg s
    if plain: VlOwned (XText (Concat (Each segs, \|s| PlainText s))), OutText
    else: VlOwned (XFormat (Each segs, \|s| SegEx lx, env, s)), OutText

IsPlainSeg: fn TextSeg -> Bool
fn IsPlainSeg (SegPlain ignore) = True
fn IsPlainSeg (SegPlaceholder ignore) = False

PlainText: fn TextSeg -> Text
fn PlainText (SegPlain t) = t
fn PlainText (SegPlaceholder ignore) = ""

SegEx: unbounded fn Lx, Env, TextSeg -> Ex
fn SegEx lx, env, (SegPlain t) = XText t
fn SegEx lx, env, (SegPlaceholder e):
    let v = ValueOf lx, env, e
    ShownPart v

# A placeholder's text (Jimmy: interpolation is display, `^Show` is debug): a `Text`, a
# `Char` or a number as it displays, itself; anything else, which has no display of its
# own, as it shows.
ShownPart: fn Vl -> Ex
fn ShownPart v = match ValueTy v:
    OutText: Ref v
    OutChar: Ref v
    OutNat: Ref v
    OutInt: Ref v
    OutU8: Ref v
    otherwise: XCall (HelperRef "show"), [[Ref v]]

# ---------------------------------------------------------------------------------------
# Plain expressions (claude/backend.md, "Functions and lifting": a plain function takes
# references, its clauses one `match`)
# ---------------------------------------------------------------------------------------

# What lowering cannot lower fails loudly: a `compile_error!` naming the construct, which
# `CompileProgram` finds in the emitted files and reports as a refusal, the crate still
# written for reading.
Refusal: fn Text -> Ex
fn Refusal what = XRefusal what

# `?` of a value, which must be a temporary: the C++ printer's TRY moves out of its operand,
# so `?` of a place (a local, a field, a part of one) is refused, naming the place.
TryOf: fn Ex -> Ex
fn TryOf x = if IsNamedPlace x: InternalBug "`?` of the place `{PlaceStem x}`, which C++'s TRY would move out of (only a temporary may be tried)" else: XTry x

IsNamedPlace: fn Ex -> Bool
fn IsNamedPlace x = match x:
    XVar ignore: True
    XField ignore, ignore: True
    XFieldOf ignore, ignore, ignore: True
    XPart ignore, ignore: True
    XTarget ignore: True
    XRef y: IsNamedPlace y
    XDeref y: IsNamedPlace y
    otherwise: False

let loweringRefusal = "prismc does not lower "

RefusalDo: fn Text -> Do
fn RefusalDo what = DoExpr (Refusal what)

# A guard no checked program reaches: an internal error, "a prismc bug: ..", marked in the
# emitted files as a refusal is and reported by `CompileProgram` as `error[internal]`.
let internalBug = "a prismc bug: "

InternalBug: fn Text -> Ex
fn InternalBug what = XRefusal "{internalBug}{what}"

InternalBugDo: fn Text -> Do
fn InternalBugDo what = DoExpr (InternalBug what)

# The same for a type the lowering cannot spell.
InternalBugType: fn Text -> OutTy
fn InternalBugType what = OutRefused "{internalBug}{what}"

ValueOf: unbounded fn Lx, Env, Expr -> Vl
fn ValueOf lx, env, e = match env.spans[PlaceKey lx, e.span]:
    ? v: v
    nil: UnboundValueOf lx, env, e

# An event's value inside the expression that maps it is bound by the event's place in
# the source (`Env.spans`), so the map is the plain expression over that value.
UnboundValueOf: unbounded fn Lx, Env, Expr -> Vl
fn UnboundValueOf lx, env, e:
    let v = if lx.whole: WholeValueOf lx, env, e
    else: if IsWholeObject lx, e: SampledObject lx, env, e
    else: if IsEventValue lx, env, e: EventValueOf lx, env, e
    else: ValueByKind lx, env, e
    AsFailure lx, e, v

# An `Error` value where the checker found it to be a `~T`'s failure (its `faults`): the
# `~T` failing with it, at its type (C++ deduces nothing from a failure: `auto`, an
# optional's or a map's element). One already made the failure (a constructor whose own
# place is the `~T`) is kept.
AsFailure: unbounded fn Lx, Expr, Vl -> Vl
fn AsFailure lx, e, v = match lx.faults[PlaceKey lx, e.span]:
    ? ft: if (ValueTy v) == OutError: Failing (Own v), (OutTyOf lx, (Peel (SubstTy lx, ft))) else: v
    nil: v

# The failure of a `~T` with an `Error`, at the `~T`'s type.
Failing: fn Ex, OutTy -> Vl
fn Failing x, t = VlOwned (XTyped (XCtor (RefRuntime "std::Err"), [[x]]), t), t

# ---------------------------------------------------------------------------------------
# Time taken whole (Type System ch. 4, Application: "A sigiled parameter is not lifted
# over"; gap LF)
# ---------------------------------------------------------------------------------------

# Whether a named function takes a dynamic or an event whole: a `$` or `!` below the top of
# a parameter or of its result. One with them only on top is lowered lifted, its time values
# read at the caller's read point, which no program can tell apart; one that gives a
# blueprint takes its events as event values already.
IsWholeFn: fn Lx, Text -> Bool
fn IsWholeFn lx, qk = HasKey lx.wholeFns, qk

# The functions that take time whole: by their signature, and those whose dynamics are only
# on top of their types but whose bodies pass one whole (`$First $a = Or (Wrap $a)[0], ($
# 0)`): lifting such a body over its parameters would leave a dynamic it builds nothing to
# be read at, so it takes and gives the dynamics too. Grown until no body adds one.
WholeFns: unbounded fn Lx -> (Text ==> Bool)
fn WholeFns lx:
    let fns = Fold lx.g.defs, [[]], \|acc, d| match d.body:
        DbFn clauses: match lx.g.vals[d.qk]:
            ? v: Push acc, ((d, clauses, v))
            nil: acc
        otherwise: acc
    # and those with an element parameter (gap LE): a `$` field of the element is a
    # `Dynamic` with no read point in the body, so the function gives its time whole and its
    # callers read it (an implementation choice: `e.$field` is a `$T` either way, Type System
    # ch. 4)
    let bySig = Fold fns, {}, \|m, ((d, ignore, v))| if (IsWholeSig v.scheme.ty) or HasElementParam v.scheme.ty: Insert m, d.qk, True else: m
    # and those a call takes with time below the top of what it gives (`$Sel (True on
    # !swap), $a, $b`, a `!$Nat`: lifted over a plain parameter, the call gives the dynamic
    # it returns whole, Type System ch. 4)
    let known = Fold fns, {}, \|m, ((d, ignore, v))| match v.scheme.ty:
        TyFn ignore, ignore, r: if (LayerOf r) == LyDyn or (LayerOf r) == LyEv: Insert m, d.qk, True else: m
        otherwise: m
    let start = Fold lx.g.defs, bySig, \|m, d|
        let lxd = update lx:
            &_.file <= d.file
            &_.home <= d.home
            &_.site <= d.home
        Fold (DefExprs d), m, \|m2, x| match x.kind:
            ECall c, ignore, ignore, ignore:
                let qk = CalleeKey lxd, c
                if (HasKey known, qk) and TimeWithin (TypeAt lxd, x.span): Insert m2, qk, True else: m2
            otherwise: m2
    GrowWhole lx, fns, start, (Len fns)

# Every expression of a definition's body.
DefExprs: unbounded fn Def -> [Expr]
fn DefExprs d = match d.body:
    DbFn clauses: Fold clauses, [[]], \|acc, c| Append acc, (BodyExprs c.body)
    DbMethod clauses, ignore, ignore: Fold clauses, [[]], \|acc, c| Append acc, (BodyExprs c.body)
    DbDefault clauses, ignore: Fold clauses, [[]], \|acc, c| Append acc, (BodyExprs c.body)
    DbWidget w: StmtsExprs w.body.stmts
    DbLet l: ExprsIn l.value
    otherwise: [[]]

GrowWhole: unbounded fn Lx, [((Def, [FnClause], ValInfo))], (Text ==> Bool), Nat -> (Text ==> Bool)
fn GrowWhole lx, fns, set, fuel:
    let lxs = update lx:
        &_.wholeFns <= set
    let next = Fold fns, set, \|m, ((d, clauses, v))|
        if (HasKey m, d.qk) or not (DynOnlyOnTop v.scheme.ty): m
        else:
            let lxf = update lxs:
                &_.file <= d.file
                &_.home <= d.home
                &_.site <= d.home
            let exprs = Fold clauses, [[]], \|acc, c| Append acc, (BodyExprs c.body)
            if Fold exprs, False, \|seen, x| seen or IsWholeObject lxf, x: Insert m, d.qk, True else: m
    if fuel == 0 or (Len (Keys next)) == (Len (Keys set)): next else: GrowWhole lx, fns, next, (Dec fuel)

# Whether a signature's only time is `$` on top of parameters or the result.
DynOnlyOnTop: fn Ty -> Bool
fn DynOnlyOnTop t = match t:
    TyFn ignore, ps, r:
        let all = Push ps, r
        let tops = Filter all, \|p| match p:
            TySig "$", i: not (HasTime i)
            otherwise: False
        (Len tops) > 0 and (Len tops) + (Len (Filter all, \|p| not (HasTime p))) == (Len all)
    otherwise: False

HasElementParam: fn Ty -> Bool
fn HasElementParam t = match t:
    TyFn ignore, ps, r: (not (HasBlueprint r)) and Fold ps, False, \|seen, p| seen or match Peel p:
        TyElem ignore, ignore: True
        otherwise: False
    otherwise: False

IsWholeSig: fn Ty -> Bool
fn IsWholeSig t = match t:
    TyFn ignore, ps, r: (not (HasBlueprint r)) and Fold (Push ps, r), False, \|seen, p| seen or TimeWithin p
    otherwise: False

# Whether an expression outside such a function is a `Dynamic` value rather than a reader:
# a call of one, an application the checker did not lift whose type holds a dynamic and
# that takes one of these, an index into one, or a name whose type holds a dynamic below
# the top (a bundle aside, which a node binds part by part).
IsWholeObject: unbounded fn Lx, Expr -> Bool
fn IsWholeObject lx, e = match e.kind:
    EGroup x: IsWholeObject lx, x
    EIndex r, ignore: IsWholeObject lx, r
    EName ignore:
        let t = TypeAt lx, e.span
        (TimeWithin t) and (LayerOf t) != LyDyn and (LayerOf t) != LyEv and not (IsBundle t)
    ECall c, args, ignore, ignore:
        let qk = CalleeKey lx, c
        # a lifted application of one takes its operands' values (`KidsOf $e`), as any
        # lifted application does
        if not (NotLifted lx, e.span): False
        else: if (qk != "") and IsWholeFn lx, qk: True
        else: if HasKey lx.g.ctors, qk: False
        else: (NotLifted lx, e.span) and Fold args, False, \|seen, a| seen or (IsWholeObject lx, a.value) or HoldsTimeWhole lx, a.value
    otherwise: False

# An argument that can only be taken whole: its type holds a dynamic or an event below the
# top (`[[(($a, 1))]]` to a generic function), a bundle aside.
HoldsTimeWhole: fn Lx, Expr -> Bool
fn HoldsTimeWhole lx, x:
    let t = TypeAt lx, x.span
    (TimeWithin t) and not (IsBundle t)

NotLifted: fn Lx, Range -> Bool
fn NotLifted lx, span = match lx.apps[PlaceKey lx, span]:
    ? ap: ap.layer != "$" and ap.layer != "!"
    nil: True

# Such a value where a reader is wanted: built with its time values whole, and sampled at
# the read point when it is a dynamic. A plain function's body has no read point (gap LE).
SampledObject: unbounded fn Lx, Env, Expr -> Vl
fn SampledObject lx, env, e:
    let t = OutTyOf lx, (Peel (TypeAt lx, e.span))
    let lxw = update lx:
        &_.whole <= True
    let obj = Own (ValueByKind lxw, env, e)
    if (LayerOf (TypeAt lx, e.span)) != LyDyn: VlOwned obj, (OutTyOf lx, (TypeAt lx, e.span))
    else: if lx.noCx: VlOwned (Refusal "`{SrcText lx, lx.file, e.span}`, a dynamic a function gives whole, read in a plain function, which has no read point (gap LE)"), t
    else: VlOwned (XMethod obj, "sample", [[XCx]]), t

# A value in a function that takes time whole, or in a call of one: a dynamic is a
# `Dynamic`. A node's reader is the live dynamic its line made for it (`WholeArgs`), never a
# copy of its value; one with none is refused. `$ v` is a constant; a lift the checker made
# over dynamics maps them (`map`, `map2`, paired up beyond two).
WholeValueOf: unbounded fn Lx, Env, Expr -> Vl
fn WholeValueOf lx, env, e:
    let full = TypeAt lx, e.span
    let lxp = update lx:
        &_.whole <= False
    if (LayerOf full) != LyDyn: if IsEventValue lx, env, e: EventValueOf lx, env, e else: ValueByKind lx, env, e
    else: match e.kind:
        EGroup x: ValueOf lx, env, x
        EName n: match env.names["#whole{e.span.start}:{e.span.end}"]:
            ? (BnLocal x, mode, dt): LocalPlace x, mode, dt
            otherwise:
                let v = ValueByKind lx, env, e
                let local = (Len n.path) == 1 and match env.names[SNameKey n]:
                    ? (BnLocal ignore, ignore, ignore): True
                    otherwise: False
                match ValueTy v:
                    OutDyn ignore: v
                    # a local's value, never written again where it is bound (a root
                    # widget's argument): the constant it is
                    other if local: VlOwned (XCall (HelperRef "dyn_constant"), [[Own v]]), (OutDyn other)
                    # a global dynamic (`let $four = $ 4`): no node writes it, so it is
                    # the constant its getter gives
                    other if (Len n.path) > 1 or not (HasKey env.names, (SNameKey n)): VlOwned (XCall (HelperRef "dyn_constant"), [[Own v]]), (OutDyn other)
                    otherwise: VlOwned (Refusal "`{SrcText lx, lx.file, e.span}` passed whole to a function that takes it so, where it has no live dynamic to give: a reader with no value at the build where the line reads it (gap LF)"), (OutDyn (OutTyOf lx, (Peel full)))
        # `$ $q` is lifted over `$q` (a bare type variable lifts, Type System ch. 4): a map
        # to a constant of each value
        EFreeSigil "$", x: if not (NotLifted lx, e.span): DynamicLift lx, env, e
        else: if (LayerOf (TypeAt lx, x.span)) == LyDyn: ValueOf lx, env, x else: VlOwned (XCall (HelperRef "dyn_constant"), [[Own (ValueOf lxp, env, x)]]), (OutDyn (OutTyOf lx, (Peel full)))
        otherwise:
            if not (NotLifted lx, e.span): DynamicLift lx, env, e
            else: ValueByKind lx, env, e

# An expression's operands as a lift maps them: a lifted `if` or `match` maps its
# condition or scrutinee and its arms' results (`if $useB: $ $q else: $ $p`, a `$$Nat`
# whose arms are maps themselves).
MappedOperands: fn Expr -> [Expr]
fn MappedOperands e = match e.kind:
    EIf c, t, ?el:
        let cs = match c:
            CondExpr x: [[x]]
            otherwise: [[]]
        let els = match ?el:
            ? b: BlockResult b
            nil: [[]]
        Append (Append cs, (BlockResult t)), els
    EMatch sc, arms: Fold arms, [[sc]], \|acc, a| Append acc, (BlockResult a.body)
    otherwise: Operands e

# A block's result expression, when its last line is one.
BlockResult: fn Block -> [Expr]
fn BlockResult b = Fold b.stmts, [[]], \|ignore, st| match st.kind:
    SExpr x: [[x]]
    otherwise: [[]]

# A lift over the dynamics among an expression's operands, each a `Dynamic`: the plain
# expression over their values, mapped; two are read together, one update event firing
# when either moves.
DynamicLift: unbounded fn Lx, Env, Expr -> Vl
fn DynamicLift lx, env, e:
    let full = TypeAt lx, e.span
    let t = OutTyOf lx, (Peel full)
    let srcs = Filter (MappedOperands e), \|x| (LayerOf (TypeAt lx, x.span)) == LyDyn
    let lxp = update lx:
        &_.whole <= False
    let caps = Filter (WithInstances env, (ReadNames (ExprsIn e))), \|n| match env.names[n]:
        ? (BnLocal ignore, ignore, ignore): True
        otherwise: False
    let ((dos, env1)) = Fold caps, (([[]], env)), \|((acc, en)), n| match env.names[n]:
        ? (BnLocal rs, mode, ct):
            let local = "{PlaceStem rs}_c"
            (((Push acc, (DoLet (PaBind local), (Own (LocalPlace rs, mode, ct)))), (Bind en, n, (BnLocal (XVar local), Owned, ct))))
        otherwise: ((acc, en))
    let names = Each (Range0 (Len srcs)), \|i| "y_dyn{i}"
    let env2 = Fold (Range0 (Len srcs)), env1, \|en, i| match srcs[i]:
        ? x: BindSpan en, (PlaceKey lx, x.span), (VlPlace (XVar (Or names[i], "y")), ByRef, (OutTyOf lx, (Peel (TypeAt lx, x.span))))
        nil: en
    let pas = Each (Range0 (Len srcs)), \|i| PaTyped (PaBind (Or names[i], "y")), (OutRef (OutTyOf lx, (Peel (TypeAt lx, (Or srcs[i], e).span))))
    let body = Own (ValueByKind lxp, env2, e)
    let objs = Each srcs, \|x| Own (ValueOf lx, env, x)
    let lets = Each (Range0 (Len objs)), \|i| DoLet (PaBind "src_dyn{i}"), (Or objs[i], XUnit)
    match objs:
        # no dynamic among the operands (`$"replaced"` taken whole): a constant
        [[]]: VlOwned (XBlock dos, (XCall (HelperRef "dyn_constant"), [[body]])), (OutDyn t)
        [[ignore]]: VlOwned (XBlock (Append dos, lets), (XMethod (XVar "src_dyn0"), "map", [[(XClosure True, pas, body)]])), (OutDyn t)
        [[ignore, ignore]]: VlOwned (XBlock (Append dos, lets), (XMethod (XVar "src_dyn0"), "map2", [[(XRef (XVar "src_dyn1")), (XClosure True, pas, body)]])), (OutDyn t)
        otherwise:
            # three or more: paired up left to right (`map2` into a tuple), then mapped
            # once; each pairing's update event fires once a tick, so the last one does
            let tys = Each srcs, \|x| OutTyOf lx, (Peel (TypeAt lx, x.span))
            let ((paired, pty)) = Fold (Filter (Range0 (Len srcs)), \|i| i > 0), (((XVar "src_dyn0"), (Or tys[0], OutUnit))), \|((acc, at)), i|
                let it = Or tys[i], OutUnit
                let pair = XClosure True, [[(PaTyped (PaBind "l"), (OutRef at)), (PaTyped (PaBind "r"), (OutRef it))]], (XTuple [[(XClone (XVar "l")), (XClone (XVar "r"))]])
                (((XMethod acc, "map2", [[(XRef (XVar "src_dyn{i}")), pair]]), (OutTuple [[at, it]])))
            let n = Len srcs
            let unpack = Each (Range0 n), \|i| DoLet (PaBind (Or names[i], "y")), (XClone (TuplePath (XVar "t"), n, i))
            let env3 = Fold (Range0 n), env1, \|en, i| match srcs[i]:
                ? x: BindSpan en, (PlaceKey lx, x.span), (VlPlace (XVar (Or names[i], "y")), Owned, (Or tys[i], OutUnit))
                nil: en
            let body3 = Own (ValueByKind lxp, env3, e)
            let last = XClosure True, [[(PaTyped (PaBind "t"), (OutRef pty))]], (XBlock unpack, body3)
            VlOwned (XBlock (Append dos, lets), (XMethod paired, "map", [[last]])), (OutDyn t)

# Source `i` of `n` in the tuple pairing builds, `((y0, y1), y2)`: the first two under
# `n - 2` firsts, any later one the second of its pairing.
TuplePath: fn Ex, Nat, Nat -> Ex
fn TuplePath t, n, i:
    let depth = if i == 0: Dec n else: Or (n -? i), 0
    let inner = Fold (Range0 (Dec depth)), t, \|acc, ignore| XPart acc, 0
    if i == 0: XPart inner, 0 else: XPart inner, 1

# An expression of an event type outside the pipe that maps it (no event of it is bound
# by its place): an event value, `prism_rtl::Event`, built by the library's combinators
# (a function with a `!` parameter, a supplier's `@ !Filter (?ClickTo p, !in)`).
IsEventValue: unbounded fn Lx, Env, Expr -> Bool
fn IsEventValue lx, env, e = match e.kind:
    EName ignore: False
    EGroup ignore: False
    otherwise: ((LayerOf (TypeAt lx, e.span)) == LyEv) and (not (Fold (Operands e), False, \|bound, c| bound or HasKey env.spans, (PlaceKey lx, c.span))) and ((HasEventSource lx, env, e) or (?UpdatedValue lx, env, e) != nil)

# `!Updated $d` where `$d` is a dynamic value here (a live dynamic its line made for a
# supplier's closure, `WholeArgs`, or a local `Dynamic`, a parameter taken whole): the
# event value of its updates (the prelude's `updated`). Its dynamic.
?UpdatedValue: unbounded fn Lx, Env, Expr -> ?Expr
fn ?UpdatedValue lx, env, e = match e.kind:
    EGroup x: ?UpdatedValue lx, env, x
    ECall c, args, ignore, ignore: if (CalleeKey lx, c) != "Prelude.!Updated": nil else: match args[0]:
        ? a: match a.value.kind:
            EName n: if HasKey env.names, "#whole{a.value.span.start}:{a.value.span.end}": ? a.value else: match env.names[SNameKey n]:
                ? (BnLocal ignore, ignore, (OutDyn ignore)): ? a.value
                otherwise: nil
            otherwise: nil
        nil: nil
    otherwise: nil

# Whether an event expression stands over an event value: a local of an event type (a
# parameter taken as one), or a node's event that has its value port. A lifted function's
# body (`fn !Bump $n, !go = $n + 1 on !go`) has neither: its events are its firing.
HasEventSource: unbounded fn Lx, Env, Expr -> Bool
fn HasEventSource lx, env, e = Fold (Operands e), False, \|found, c| found or IsEventSource lx, env, c

IsEventSource: unbounded fn Lx, Env, Expr -> Bool
fn IsEventSource lx, env, c:
    if (LayerOf (TypeAt lx, c.span)) != LyEv: False
    else: match c.kind:
        EName n: match env.names[SNameKey n]:
            ? (BnLocal ignore, ignore, (OutEvent ignore)): True
            ? (BnEv ignore, ignore): HasKey env.names, "{SNameKey n}#port"
            otherwise: False
        EGroup x: IsEventSource lx, env, x
        otherwise: (HasEventSource lx, env, c) or (?UpdatedValue lx, env, c) != nil

EventValueOf: unbounded fn Lx, Env, Expr -> Vl
fn EventValueOf lx, env, e:
    let t = OutTyOf lx, (Peel (TypeAt lx, e.span))
    let et = OutEvent t
    let ?filtered = match e.kind:
        ECall c, args, ignore, ignore: if (CalleeKey lx, c) == "Prelude.!Filter": args[0] else: nil
        otherwise: nil
    match ?filtered:
        ? a: VlOwned (XMethod (Own (ValueOf lx, env, a.value)), "filter_some", [[]]), et
        nil: match ?UpdatedValue lx, env, e:
          ? d: VlOwned (XCall (HelperRef "updated"), [[Ref (WholeValueOf lx, env, d)]]), et
          nil:
            let evs = Filter (Operands e), \|x| (LayerOf (TypeAt lx, x.span)) == LyEv
            match evs:
                [[one]]:
                    let src = Own (ValueOf lx, env, one)
                    let it = OutTyOf lx, (Peel (TypeAt lx, one.span))
                    let caps = Filter (WithInstances env, (ReadNames (ExprsIn e))), \|n| match env.names[n]:
                        ? (BnLocal ignore, ignore, ignore): True
                        otherwise: False
                    let ((dos, env1)) = Fold caps, (([[]], env)), \|((acc, en)), n| match env.names[n]:
                        ? (BnLocal rs, mode, ct):
                            let local = "{PlaceStem rs}_c"
                            (((Push acc, (DoLet (PaBind local), (Own (LocalPlace rs, mode, ct)))), (Bind en, n, (BnLocal (XVar local), Owned, ct))))
                        otherwise: ((acc, en))
                    let env2 = BindSpan env1, (PlaceKey lx, one.span), (VlPlace (XVar "y_ev"), ByRef, it)
                    let body = Own (ValueByKind lx, env2, e)
                    let mapped = XMethod src, "map", [[(XClosure True, [[(PaTyped (PaBind "y_ev"), (OutRef it))]], body)]]
                    VlOwned (XBlock (Push dos, (DoLet (PaBind "src_ev"), src)), (XMethod (XVar "src_ev"), "map", [[(XClosure True, [[(PaTyped (PaBind "y_ev"), (OutRef it))]], body)]])), et
                otherwise: VlOwned (InternalBug "an event value of several events"), et

# An expression the checker lifted over a `?` or `~` at the plain layer is its plain value
# under a `match` of each operand it peeled; any other is lowered by its kind.
ValueByKind: unbounded fn Lx, Env, Expr -> Vl
fn ValueByKind lx, env, e = match lx.lifts[PlaceKey lx, e.span]:
    ? ln if (Len ln.operands) > 0: LiftedValue lx, env, e, ln
    otherwise: PlainValueByKind lx, env, e

# A plain-layer lift (Type System ch. 4, `?` and `~` at the plain layer): each operand the
# checker peeled is matched in turn, left to right, and the expression is its plain value
# over the peeled values, wrapped back: `nil` (an `Error`, the leftmost) if any operand was
# one. Inside, each operand's place holds its peeled value, typed so, and the expression
# its plain type, with no lift left at it.
LiftedValue: unbounded fn Lx, Env, Expr, LiftNote -> Vl
fn LiftedValue lx, env, e, ln:
    let at = PlaceKey lx, e.span
    let t = OutTyOf lx, (Peel (TypeAt lx, e.span))
    let inner = InnerTy (TypeAt lx, e.span)
    let selfOperand = Fold ln.operands, False, \|f, r| f or r == e.span
    let missing = Fold ln.operands, False, \|f, r| f or (?OperandAt e, r) == nil
    if inner == TyErr or selfOperand or missing: VlOwned (Refusal "a lift over `{ln.sigil}` at `{SrcText lx, lx.file, e.span}` of {KindWords e.kind}"), t
    else:
        let lx1 = update lx:
            &_.tys <= Insert &_.tys, at, inner
            &_.lifts <= Insert &_.lifts, at, LiftNote(at=ln.at, sigil=ln.sigil, operands=[[]])
        let lx2 = Fold ln.operands, lx1, \|l, r| update l:
            &_.tys <= Insert &_.tys, (PlaceKey lx, r), (InnerTy (TypeAt lx, r))
        VlOwned (LiftOperands lx, lx2, env, e, ln.sigil, ln.operands, t), t

# The operands from the first: its value matched, the rest inside its arm.
LiftOperands: unbounded fn Lx, Lx, Env, Expr, Text, [Range], OutTy -> Ex
fn LiftOperands lx, lxIn, env, e, sigil, operands, t = match operands:
    [[]]: XTyped (XCtor (RefRuntime (if sigil == "~": "std::Ok" else: "std::Some")), [[Own (PlainValueByKind lxIn, env, e)]]), t
    otherwise:
        let r = Or operands[0], e.span
        let sv = ValueOf lx, env, (Or (?OperandAt e, r), dummyExpr)
        let it = OutTyOf lx, (InnerTy (TypeAt lx, r))
        let owned = match sv:
            VlOwned ignore, ignore: True
            otherwise: False
        let mode = if owned: Owned else: ByRef
        let x = "o{r.start}_{r.end}"
        let env2 = BindSpan env, (PlaceKey lx, r), (VlPlace (XVar x), mode, it)
        let body = LiftOperands lx, lxIn, env2, e, sigil, (Drop operands, 1), t
        let failArm = if sigil == "~": XArm(pat=(PaCtor (RefRuntime "std::Err"), [[PaBind "{x}_e"]]), conds=[[]], body=(XCtor (RefRuntime "std::Err"), [[Own (VlPlace (XVar "{x}_e"), mode, OutError)]]))
        else: XArm(pat=(PaUnit (RefRuntime "std::None")), conds=[[]], body=(XTyped (XNone), t))
        let arms = [[XArm(pat=(PaCtor (RefRuntime (if sigil == "~": "std::Ok" else: "std::Some")), [[PaBind x]]), conds=[[]], body=body), failArm]]
        XMatch (if owned: Own sv else: Ref sv), arms, False, t

# The operand of an expression at a place: a field read's receiver, an argument, an
# operator's operand.
?OperandAt: fn Expr, Range -> ?Expr
fn ?OperandAt e, r = Fold (DirectOperands e), nil, \|?found, x| if ?found == nil and x.span == r: ? x else: ?found

DirectOperands: fn Expr -> [Expr]
fn DirectOperands e = match e.kind:
    EGroup x: DirectOperands x
    ECall ignore, args, ignore, ignore: Each args, \|a| a.value
    EMethod r, ignore, args: Append [[r]], (Each args, \|a| a.value)
    EBinary ignore, l, r: [[l, r]]
    EUnary ignore, x: [[x]]
    EFreeSigil ignore, x: [[x]]
    EField r, ignore, ignore: [[r]]
    EIndex r, i: [[r, i]]
    EMap kvs: Fold kvs, [[]], \|acc, ((k, v))| Append acc, [[k, v]]
    # an interpolated text's holes: it is the text builder applied to each
    ELit l: match l.kind:
        LText segs: Fold segs, [[]], \|acc, sg| match sg:
            SegPlaceholder x: Push acc, x
            otherwise: acc
        otherwise: [[]]
    otherwise: [[]]

PlainValueByKind: unbounded fn Lx, Env, Expr -> Vl
fn PlainValueByKind lx, env, e:
    let t = OutTyOf lx, (Peel (TypeAt lx, e.span))
    match e.kind:
        EName n: NameValue lx, env, n, e.span
        ELit l: LiteralValue lx, env, l, e.span, False
        EUnit ignore: VlOwned (XUnit), OutUnit
        EBound b: match env.names[b]:
            ? (BnLocal rs, mode, bt): LocalPlace rs, mode, bt
            otherwise: VlOwned (Refusal "`{b}` outside a `for`"), t
        ENil ignore: VlOwned (XTyped (XNone), t), t
        ETuple es: VlOwned (XTuple (Each es, \|x| Own (ValueOf lx, env, x))), t
        EArray [[]]: VlOwned (XTyped (XCall (RefRuntime "rt::Array::new"), [[]]), t), t
        # an optional's or a fault's elements at their type: C++ deduces no vector from a
        # value and a failure (`[[~ 1, Error(..)]]`)
        EArray es: VlOwned (XCall (RefRuntime "rt::Array::from"), [[XVec (Each es, \|x| ElementAt t, (Own (ValueOf lx, env, x)))]]), t
        EMap [[]]: VlOwned (XTyped (XCall (RefRuntime "rt::Map::new"), [[]]), t), t
        EMap kvs: VlOwned (XCall (HelperRef "map_of"), [[XVec (Each kvs, \|((k, v))| XTuple [[Own (ValueOf lx, env, k), Own (ValueOf lx, env, v)]])]]), t
        EGroup x: ValueOf lx, env, x
        ECall c, args, ignore, ignore: Application lx, env, c, args, e.span
        EMethod r, m, args: Application lx, env, (Expr(kind=(EName m), span=m.span)), (Append [[Arg(marks="", ?name=nil, value=r, span=r.span)]], args), e.span
        EBinary op, l, r: BinaryValue lx, env, op, l, r, e.span
        EUnary "not", x: VlOwned (XUnary OpNot, (AsBool (ValueOf lx, env, x))), OutBool
        EUnary "neg", x: match x.kind:
            ELit l: LiteralValue lx, env, l, x.span, True
            otherwise:
                let v = ValueOf lx, env, x
                if IsCopy t: VlOwned (XUnary OpNeg, (Copy v)), t else: VlOwned (XUnary OpNeg, (Ref v)), t
        EUnary ignore, x: ValueOf lx, env, x
        # at its type: C++ deduces a bare value from `auto x = ~ 3`
        EFreeSigil "?", x: VlOwned (XTyped (XCtor (RefRuntime "std::Some"), [[Own (ValueOf lx, env, x)]]), t), t
        EFreeSigil "~", x: VlOwned (XTyped (XCtor (RefRuntime "std::Ok"), [[Own (ValueOf lx, env, x)]]), t), t
        EFreeSigil "@", x: PureBlueprint lx, env, x, t
        # a value of `$$a` holds a `$a` (`Peel`): `$ v` there is a constant of `v`, as in a
        # map's body over `$ $q`
        EFreeSigil "$", x:
            let v = ValueOf lx, env, x
            match ((t, (ValueTy v))):
                ((OutDyn ignore, OutDyn ignore)): v
                ((OutDyn ignore, ignore)): VlOwned (XCall (HelperRef "dyn_constant"), [[Own v]]), t
                otherwise: v
        EFreeSigil ignore, x: ValueOf lx, env, x
        EField r, ignore, name: FieldValue lx, env, r, name.name
        EIndex r, i: IndexValue lx, env, r, i, t
        ELambda ?ps, body: LambdaValue lx, env, e, (Or ?ps, [[]]), body
        EIf c, thenB, ?elseB: IfValue lx, env, c, thenB, ?elseB, t
        EMatch s, arms: MatchValue lx, env, s, arms, t, e.span
        ETemplate tp: TemplateValue lx, env, tp
        ECast x, ignore, checked: if checked: CheckedCastValue lx, env, x, t else: ValueOf lx, env, x
        ENonEmpty x: ValueOf lx, env, x
        ETypeArgs x, ignore: ValueOf lx, env, x
        EGiven b: GivenValue lx, env, b, t, e.span
        EUpdate target, b: UpdateValue lx, env, target, b, t, e.span
        EAny x: AnyValue lx, env, x, (TypeAt lx, e.span)
        otherwise: VlOwned (Refusal "{KindWords e.kind} as a value"), t

# `any x` (Type System ch. 5, "Existentials are dictionaries"): the value with the impls of
# the existential's bounds at its type, taken while its type is known; an `any ^Show` is
# a `dyn Show`. `^Show`, `^Eq` and `^Ord` are the runtime's packing's own; a program's
# trait gives its dictionary at the value's type (`PackedDef`), and so does each trait
# above it. A bound with neither (another trait of the prelude; a program's trait with a
# method that cannot be asked of a packed value, `?PackedDefOf`) is refused.
AnyValue: unbounded fn Lx, Env, Expr, Ty -> Vl
fn AnyValue lx, env, x, t:
    let v = Own (ValueOf lx, env, x)
    let packedTy = OutNamed (RefRuntime "prism_rtl::Packed"), [[]]
    match Peel t:
        TyAny bounds:
            if IsShowOnly bounds: VlOwned (XCall (RefRuntime "std::Rc::new"), [[v]]), OutShowAny
            else:
                let all = BoundsClosed lx, bounds
                let refused = Fold all, "", \|found, b| if found != "": found else: if IsPackingBound b: "" else: match lx.g.traits[b]:
                    ? tr: if (?PackedDefOf lx, tr) == nil: "an existential of `^{BareName b}`: a method with a type parameter of its own, or one that takes the trait's type inside another type or in no parameter, cannot be asked of a hidden value" else: ""
                    nil: "an existential of `^{BareName b}`: a packed value takes `^Eq`, `^Ord`, `^Show` and the program's traits"
                if refused != "": VlOwned (Refusal refused), packedTy
                else:
                    let packing = Fold all, (XCall (RefRuntime "prism_rtl::Packed::of"), [[v]]), \|acc, b| if IsPackingBound b: XMethod acc, "with_{Lower (BareName b)}", [[]] else: match lx.g.traits[b]:
                        ? tr: XMethod acc, "with_dictionary", [[(XPath (PackedDictionaryOf lx, tr))]]
                        nil: acc
                    VlOwned (XMethod packing, "packed", [[]]), packedTy
        otherwise: VlOwned (XCall (RefRuntime "std::Rc::new"), [[v]]), OutShowAny

# A bound the runtime's packing takes by itself.
IsPackingBound: fn Text -> Bool
fn IsPackingBound b = HasText [["Prelude.Show", "Prelude.Eq", "Prelude.Ord", "Show", "Eq", "Ord"]], b

# An existential's bounds with every trait above them (a trait's impl needs its
# supertraits' impls), each once.
BoundsClosed: fn Lx, [Text] -> [Text]
fn BoundsClosed lx, bounds = Fold (Range0 8), bounds, \|acc, ignore| Fold acc, acc, \|a, b| match lx.g.traits[b]:
    ? tr: UnionTexts a, tr.supers
    nil: a

# `@ x` as a value (a supplier's arm; pick HO): a blueprint with no places whose output is
# `x`, typed as the tag's variant of `crate::Answer`, so the arm must stand under a tag
# pattern on the live element (`Ui.Button(..): @ !tap`), which binds the tag (`#tag`). A
# plain value, or a constant dynamic (`@ $ (~ Contents(..))`), is the place's first value
# once; an event's firings are answers, each a tick late; `never` answers nothing. A dynamic
# that is not a constant (`@ $hold`) answers through prism_rtl's `dynamic_blueprint`
# (`DynamicBlueprint`).
PureBlueprint: unbounded fn Lx, Env, Expr, OutTy -> Vl
fn PureBlueprint lx, env, x, t:
    let isNever = match x.kind:
        EName n:
            let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
            ?qk == ? "Prelude.never"
        otherwise: False
    if isNever: VlOwned (XCall (RefRuntime "prism_rtl::never_blueprint::<crate::Elem, crate::Answer>"), [[]]), t
    else: match env.names["#tag"]:
        # outside a tag's arm (a host's `let @seven = @ 7`, given by the arm that matched the
        # tag): the answer as plain data, `Answer`'s case of no tag, which the place that
        # takes it reads at its own tag's type (the accessors of `crate::Answer`)
        nil:
            let plainTy = OutTyOf lx, (Peel (TypeAt lx, x.span))
            if not (IsBundleAnswer lx, x) and not (Podable plainTy): VlOwned (Refusal "`@ {SrcText lx, lx.file, x.span}` outside a tag arm, an answer that is no plain data"), t
            else: PureBlueprint lx, (Bind (Bind env, "#tag", (BnLocal (XPath untaggedRef), Owned, OutUnit)), "#tagfirst", (BnLocal (XPath untaggedRef), Owned, OutUnit)), x, t
        ? (BnLocal (XPath variant), ignore, ignore) if IsBundleAnswer lx, x: BundleBlueprint lx, env, x, variant, t
        ? (BnLocal (XPath variant), ignore, ignore): match LayerOf (TypeAt lx, x.span):
            LyEv:
                let wrapped = XMethod (AnswerEvent lx, env, x), "map", [[(XClosure False, [[PaBind "v"]], (Tagged variant, (XClone (XVar "v"))))]]
                VlOwned (XCall (RefRuntime "prism_rtl::event_blueprint::<crate::Elem, _>"), [[wrapped]]), t
            LyDyn: match ?DynamicAnswer lx, x:
                nil: match x.kind:
                    EFreeSigil "$", inner: PlainBlueprint lx, env, inner, variant, t
                    otherwise: VlOwned (InternalBug "`@ {SrcText lx, lx.file, x.span}`, a supplier's dynamic answer of no known form"), t
                ? d: DynamicBlueprint lx, env, x, d, variant, t
            otherwise: PlainBlueprint lx, env, x, variant, t
        otherwise: VlOwned (InternalBug "a supplier's answer under a tag the arm does not name"), t

# `@ ((x, !e))` under a bundle tag's arm (Type System ch. 2, "Bundles"; pick HO): a tuple
# whose parts are plain values and one event. The plain parts are the place's first value,
# the tag's first-value variant of `Answer` (`AnswerCase.first`), read at the place's
# build; each firing of the event an answer, a tick late (prism_rtl's `bundle_blueprint`).
IsBundleAnswer: fn Lx, Expr -> Bool
fn IsBundleAnswer lx, x = match x.kind:
    EGroup y: IsBundleAnswer lx, y
    ETuple es: Fold es, False, \|f, y| f or (LayerOf (TypeAt lx, y.span)) == LyEv
    # a bundle not written as a tuple (`@ pair`, `pair` a `let`): by its type
    otherwise: match TypeAt lx, x.span:
        TyTuple ts: Fold ts, False, \|f, part| f or (LayerOf part) == LyEv
        otherwise: False

# An answer's event. `never` alone names no type its `map` can read (`@ ((never, $
# "offline"))`), so it is a `let` of the checker's type for it; any other event has its
# type from what makes it.
AnswerEvent: unbounded fn Lx, Env, Expr -> Ex
fn AnswerEvent lx, env, ev = match ev.kind:
    EGroup y: AnswerEvent lx, env, y
    EName n:
        let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
        if ?qk == ? "Prelude.never": XBlock [[(DoLet (PaTyped (PaBind "answer_event"), (OutTyOf lx, (TypeAt lx, ev.span))), (Own (ValueOf lx, env, ev)))]], (XVar "answer_event")
        else: Own (ValueOf lx, env, ev)
    otherwise: Own (ValueOf lx, env, ev)

BundleBlueprint: unbounded fn Lx, Env, Expr, Ref, OutTy -> Vl
fn BundleBlueprint lx, env, x, variant, t = match x.kind:
    EGroup y: BundleBlueprint lx, env, y, variant, t
    ETuple es:
        let plain = Filter es, \|y| (LayerOf (TypeAt lx, y.span)) == LyPlain
        let evs = Filter es, \|y| (LayerOf (TypeAt lx, y.span)) == LyEv
        let others = Filter es, \|y| (LayerOf (TypeAt lx, y.span)) == LyDyn
        match ((env.names["#tagfirst"], evs, others)):
            ((? (BnLocal (XPath firstVariant), ignore, ignore), [[ev]], [[]])):
                let firstVal = match plain:
                    [[y]]: Own (ValueOf lx, env, y)
                    otherwise: XTuple (Each plain, \|y| Own (ValueOf lx, env, y))
                let wrapped = XMethod (AnswerEvent lx, env, ev), "map", [[(XClosure False, [[PaBind "v"]], (Tagged variant, (XClone (XVar "v"))))]]
                VlOwned (XCall (RefRuntime "prism_rtl::bundle_blueprint::<crate::Elem, _>"), [[(Tagged firstVariant, firstVal), wrapped]]), t
            # a constant `$` part beside the event and no plain part (`@ ((never, $
            # "offline"))`, Semantics ch. 9): its value the place's first value, once
            ((? (BnLocal (XPath firstVariant), ignore, ignore), [[ev]], [[d]])) if (Len plain) == 0 and (?ConstantDynamic d) != nil:
                let firstVal = Own (ValueOf lx, env, (Or (?ConstantDynamic d), d))
                let wrapped = XMethod (AnswerEvent lx, env, ev), "map", [[(XClosure False, [[PaBind "v"]], (Tagged variant, (XClone (XVar "v"))))]]
                VlOwned (XCall (RefRuntime "prism_rtl::bundle_blueprint::<crate::Elem, _>"), [[(Tagged firstVariant, firstVal), wrapped]]), t
            otherwise: VlOwned (Refusal "`@ {SrcText lx, lx.file, x.span}`, a bundle answer with two event parts, or a `$` part that is no constant or stands beside a plain part"), t
    # a bundle that is a value already (`@ pair`): its parts are the tuple's, the plain
    # ones cloned out for the first value, the event's mapped to the tag's variant
    otherwise: match TypeAt lx, x.span:
        TyTuple ts:
            let places = Range0 (Len ts)
            let LayerAt = \|i| LayerOf (Or ts[i], TyErr)
            let plain = Filter places, \|i| (LayerAt i) == LyPlain
            let evs = Filter places, \|i| (LayerAt i) == LyEv
            let others = Filter places, \|i| (LayerAt i) == LyDyn
            let whole = XVar "bundle_answer"
            match ((env.names["#tagfirst"], evs, others)):
                ((? (BnLocal (XPath firstVariant), ignore, ignore), [[ev]], [[]])):
                    let firstVal = match plain:
                        [[i]]: XClone (XPart whole, i)
                        otherwise: XTuple (Each plain, \|i| XClone (XPart whole, i))
                    let wrapped = XMethod (XPart whole, ev), "map", [[(XClosure False, [[PaBind "v"]], (Tagged variant, (XClone (XVar "v"))))]]
                    VlOwned (XBlock [[(DoLet (PaBind "bundle_answer"), (Own (ValueOf lx, env, x)))]], (XCall (RefRuntime "prism_rtl::bundle_blueprint::<crate::Elem, _>"), [[(Tagged firstVariant, firstVal), wrapped]])), t
                otherwise: VlOwned (Refusal "`@ {SrcText lx, lx.file, x.span}`, a bundle answer given as a value with two event parts or a `$` part"), t
        otherwise: VlOwned (InternalBug "`@ {SrcText lx, lx.file, x.span}`, a bundle answer whose type is no tuple"), t

# `$ x` written in place: the `x` of a constant dynamic.
?ConstantDynamic: fn Expr -> ?Expr
fn ?ConstantDynamic d = match d.kind:
    EGroup y: ?ConstantDynamic y
    EFreeSigil "$", inner: ? inner
    otherwise: nil

PlainBlueprint: unbounded fn Lx, Env, Expr, Ref, OutTy -> Vl
fn PlainBlueprint lx, env, x, variant, t = VlOwned (XCall (RefRuntime "prism_rtl::plain_blueprint::<crate::Elem, _>"), [[(Tagged variant, (Own (ValueOf lx, env, x)))]]), t

# `@ $d` with `$d` a dynamic of the host that is not a constant (round 3 DY): prism_rtl's
# `dynamic_blueprint` over a `Dynamic` of the tag's `Answer` whose read is the owner's getter
# for `d` through the owner's link, and, while the owner's node is being made, `d`'s value at
# the build (`InitEnv`); its update port is the getter's, fired by the writes behind `d`
# (`DynamicAnswers`). The first value is read at the row's build, each later update is a push
# delivered the next tick.
DynamicBlueprint: unbounded fn Lx, Env, Expr, Expr, Ref, OutTy -> Vl
fn DynamicBlueprint lx, env, x, d, variant, t = match ((env.names["#dyn{DynKey x}"], env.names["#owner"])):
    ((? (BnLocal (XVar getter), ignore, dt), ? (BnLocal (XVar owner), ignore, ignore))):
        let atBuild = Own (ValueOf lx, (InitEnv env), d)
        let arms = [[XArm(pat=(PaCtor (RefRuntime "std::Some"), [[PaBind "owner"]]), conds=[[]], body=(Tagged variant, (XMethod (XVar "owner"), getter, [[XCx]]))), XArm(pat=(PaUnit (RefRuntime "std::None")), conds=[[]], body=(Tagged variant, (XClone (XVar "at_build"))))]]
        let read = XClosure True, [[(PaTyped (PaBind "cx"), (OutRef (OutNamed (RefRuntime "rt::Cx"), [[]])))]], (XMatch (XMethod (XVar "link"), "owner", [[]]), arms, False, (OutNamed answerRef, [[]]))
        let dynamic = XBlock [[(DoLet (PaBind "link"), (XClone (XVar owner))), (DoLet (PaBind "at_build"), atBuild)]], (XCall (RefRuntime "prism_rtl::Dynamic::of"), [[read, (XRef (XVar "{getter}_portx"))]])
        VlOwned (XCall (RefRuntime "prism_rtl::dynamic_blueprint::<crate::Elem, _>"), [[dynamic]]), t
    otherwise: VlOwned (Refusal "`@ {SrcText lx, lx.file, x.span}`, a supplier's dynamic answer that reads what has no value at the owner's build (a structural dynamic, or a name of the parent)"), t

# An answer in its tag's case of `crate::Answer`; with no tag, as plain data in the case
# of no tag (`untaggedRef`).
Tagged: fn Ref, Ex -> Ex
fn Tagged variant, value = if variant == untaggedRef: XCtor variant, [[(XMethod value, "to_pod", [[]])]] else: XCtor variant, [[value]]

# `@Element e` as a value: the forwarding blueprint, the child's element re-emitted in the
# host's scope.
ElementBlueprint: unbounded fn Lx, Env, [Arg], OutTy -> Vl
fn ElementBlueprint lx, env, args, t = match args[0]:
    ? a: VlOwned (XCall (RefRuntime "prism_rtl::element_blueprint::<crate::Elem, crate::Answer>"), [[Ref (ValueOf lx, env, a.value)]]), t
    nil: VlOwned (InternalBug "`@Element` without its element"), t

# `xs as [a]+?`: the collection when it has an element, else `nil`.
CheckedCastValue: unbounded fn Lx, Env, Expr, OutTy -> Vl
fn CheckedCastValue lx, env, x, t:
    let helper = match OutTyOf lx, (Peel (TypeAt lx, x.span)):
        OutMap ignore, ignore: "non_empty_map"
        otherwise: "non_empty"
    VlOwned (XTyped (XCall (HelperRef helper), [[Ref (ValueOf lx, env, x)]]), t), t

# The construct an expression is, in words, for a refusal (`Refusal`).
KindWords: fn ExprKind -> Text
fn KindWords k = match k:
    ESuffixed op, ignore, ignore, ignore: "a suffixed `{op}`"
    EFreeSigil sg, ignore: "a free `{sg}`"
    ETopicField ignore: "a topic field (`&_.f` outside an `update`)"
    ETopicIndex ignore: "a topic index"
    ENonEmpty ignore: "a non-empty literal"
    EAbsent: "an absent value"
    ERest: "a `..` rest"
    ELambda ignore, ignore: "a lambda"
    ERebuild ignore, ignore: "a `rebuild` outside a widget block"
    EFor ignore, ignore, ignore: "a `for` outside a widget block"
    EWidgetBlock ignore: "a widget block"
    EMonad ignore, ignore: "a monadic block"
    ELens ignore: "a lens"
    EError: "an expression the parser could not read"
    otherwise: "an expression"

# A name: a local, or a global value, constructor or `let`.
NameValue: unbounded fn Lx, Env, SName, Range -> Vl
fn NameValue lx, env, n, span:
    let nkey = NameKeyAt lx, env, n, span
    let t = OutTyOf lx, (Peel (TypeAt lx, span))
    let ?local = if (Len n.path) == 1: env.names[nkey] else: nil
    match ?local:
        ? (BnLocal rs, mode, lt): LocalPlace rs, mode, lt
        ? (BnHold f, ht): VlOwned (XMethod (XField XSelf, "{f}"), "get", [[XCx]]), ht
        ? (BnDyn x, ignore, dt): VlOwned x, dt
        ? (BnEv ignore, et): match env.names["{nkey}#port"]:
            ? (BnLocal pf, ignore, ignore): VlOwned (XCall (RefRuntime "prism_rtl::Event::of"), [[XRef pf]]), (OutEvent (OutTyOf lx, (Peel (Peel (TypeAt lx, span)))))
            otherwise: VlOwned (Refusal "an event read as a value"), et
        # a named bundle that is one value of the build (`BundleValue`)
        ? (BnParts ignore): match env.names["{nkey}#value"]:
            ? (BnLocal rs, mode, lt): LocalPlace rs, mode, lt
            otherwise: VlOwned (Refusal "a tuple pattern's binding as a value"), t
        ? (BnWidget ignore, ignore, ignore, ignore): VlOwned (InternalBug "a widget parameter read as a plain value"), t
        ? (BnLocalFn cs): LocalFnValue (LocalFnLx lx, span), env, cs, t
        ? (BnLocalWidget ignore): VlOwned (Refusal "a widget defined in a block read as a blueprint value (it is lowered where a line applies it)"), t
        nil: match (if (Len n.path) == 1: env.names["{nkey}#blueprint"] else: nil):
          # a blueprint a `let` of a widget block names, read as a value: its expression
          ? (BnWidget x, ignore, ignore, ignore): ValueOf lx, env, x
          otherwise:
            let ((?qk, why)) = ResolveValue lx.g, lx.home, n
            match ?qk:
                ? "True": VlOwned (XBool True), OutBool
                ? "False": VlOwned (XBool False), OutBool
                ? "Prelude.never": VlOwned (XCall (RefRuntime "rt::Event::never"), [[]]), t
                ? qk: if why == "answer": AnswerFn lx, qk, t
                else: match lx.g.tags[qk]:
                    ? tg if tg.kind != "Prelude.Fault" and why == "tag": TagValue lx, env, tg, [[]]
                    otherwise: GlobalValue lx, qk, span, t
                nil: VlOwned (InternalBug "the name {nkey}, which nothing declares"), t

# A global named, not called: a constructor with no fields, a top-level `let` (its
# getter), a fault kind, or a function as a value.
GlobalValue: unbounded fn Lx, Text, Range, OutTy -> Vl
fn GlobalValue lx, qk, span, t = match lx.g.ctors[qk]:
    ? c:
        let arity = if (Len c.fields) > 0: Len c.fields else: Len c.args
        match t:
            OutFn pts, ignore: if arity > 0: CtorFn lx, c, pts, span, t, False else: CtorApp lx, emptyEnv, c, [[]], span
            OutJobFn a, ignore:
                let pts = match a:
                    OutTuple ts: if arity == 1: [[a]] else: ts
                    otherwise: [[a]]
                if arity > 0: CtorFn lx, c, pts, span, t, True else: CtorApp lx, emptyEnv, c, [[]], span
            otherwise: CtorApp lx, emptyEnv, c, [[]], span
    nil: match lx.g.tags[qk]:
        # a fault kind named: a `Fault` value, its name (`fault_kind`); `Error(kind=..)`
        # and `==` against an `Error`'s `kind` take it so
        ? tg: VlOwned (XCall (HelperRef "fault_kind"), [[XStr tg.name]]), OutPod
        nil: if Fold lx.g.defs, False, \|f, d| f or (d.qk == qk and IsLetDef d): VlOwned (XCall (ValueRef lx, qk), [[]]), t
        else: match lx.g.vals[qk]:
            ? v if (IsWidgetFn v) and not (IsValueWidget lx, qk): VlOwned (Refusal (WidgetValueWords qk)), t
            ? v:
                let isLet = Fold lx.g.defs, False, \|f, d| f or (d.qk == qk and IsLetDef d)
                if isLet: VlOwned (XCall (ValueRef lx, qk), [[]]), t
                else: if v.sort == "method": MethodFn lx, v, span, t
                else: match t:
                    OutJobFn a, ignore:
                        let ((ps, ignore2)) = SchemeParts lx, qk
                        let names = Each (Range0 (Len ps)), \|i| "a{i}"
                        let pa = if (Len ps) == 1: PaTyped (PaBind "a0"), a else: PaTyped (PaTuple (Each names, \|nm| PaBind nm)), a
                        let f = XClosure False, [[pa]], (XCall (HelperRef "entered"), [[(XCall (StartRef lx, qk), (Each names, \|nm| XVar nm))]])
                        VlOwned (XCast (XCall (RefRuntime "std::Rc::new"), [[f]]), t), t
                    # a generic function's value is a closure calling it, at the types the
                    # closure's parameters say (a target with function templates names
                    # none of them by its path alone)
                    OutFn pts, ignore if (Len v.scheme.qs) > 0:
                        let names = Each (Range0 (Len pts)), \|i| "a{i}"
                        let pas = Each (Range0 (Len pts)), \|i| PaTyped (PaBind (Or names[i], "a")), (OutRef (Or pts[i], OutUnit))
                        VlOwned (XCall (RefRuntime "std::Rc::new"), [[(XClosure False, pas, (XCall (ValueRef lx, qk), (Each names, \|nm| XVar nm)))]]), t
                    otherwise: VlOwned (XCall (RefRuntime "std::Rc::new"), [[XPath (ValueRef lx, qk)]]), t
            nil: VlOwned (InternalBug "the global {qk}"), t

# A widget function: its result a blueprint.
IsWidgetFn: fn ValInfo -> Bool
fn IsWidgetFn v = match v.scheme.ty:
    TyFn ignore, ignore, (TyAt ignore, ignore): True
    otherwise: False

# A widget function as a value that is not one (pick HO): a supplier whose blueprint
# builds places, or a widget that answers no element.
WidgetValueWords: fn Text -> Text
fn WidgetValueWords qk = "the widget function {BareName qk} as a value: a blueprint value is a supplier's answer that builds no place (`@ x`, `@Element e`, a `match` of them); one with places is a widget-function blueprint as an answer (pick HO)"

IsLetDef: fn Def -> Bool
fn IsLetDef d = match d.body:
    DbLet ignore: True
    otherwise: False

# The `Start` of an unbounded function as the model refers to it.
StartRef: fn Lx, Text -> Ref
fn StartRef lx, qk:
    let owner = match lx.g.vals[qk]:
        ? v: v.home
        nil: OwnerOf qk
    RefIn lx, owner, "start_{Or lx.rsNames[qk], (Snake (BareName qk))}"

# `f a, b`.
Application: unbounded fn Lx, Env, Expr, [Arg], Range -> Vl
fn Application lx, env, callee, args, span:
    let t = OutTyOf lx, (Peel (TypeAt lx, span))
    match callee.kind:
        EName n:
            let nkey = NameKeyAt lx, env, n, callee.span
            let ?local = if (Len n.path) == 1: env.names[nkey] else: nil
            match ?local:
                ? (BnLocalFn cs): InlineLocalFn (LocalFnLx lx, callee.span), env, cs, args, t
                ? b:
                    let f = NameValue lx, env, n, callee.span
                    match ValueTy f:
                        OutJobFn ignore, ignore:
                            VlOwned (XCall (HelperRef "run_to_end"), [[(StartCall f, (StartArgs lx, env, f, args))]]), t
                        otherwise: VlOwned (XApply (Ref f), (Each args, \|a| Argument lx, env, a.value)), t
                nil:
                    let ((?qk, why)) = ResolveValue lx.g, lx.home, n
                    match ?qk:
                        # A tag and a record may share a key (`Fs.Contents`); the name
                        # resolved to the tag only when written with its family.
                        ? qk: match lx.g.tags[qk]:
                            ? tg if why == "tag": TagValue lx, env, tg, args
                            otherwise: if why == "answer": AnswerValue lx, env, qk, args, t
                            else: if qk == "Prelude.@Element": ElementBlueprint lx, env, args, t
                            else: GlobalCall lx, env, qk, args, span, callee.span, t
                        nil: VlOwned (InternalBug "a call of {nkey}, which nothing declares"), t
        EGroup x: Application lx, env, x, args, span
        otherwise:
            let f = ValueOf lx, env, callee
            match ValueTy f:
                OutJobFn ignore, ignore: VlOwned (XCall (HelperRef "run_to_end"), [[(StartCall f, (StartArgs lx, env, f, args))]]), t
                otherwise: VlOwned (XApply (Ref f), (Each args, \|a| Argument lx, env, a.value)), t

# A local function called: its body inlined, each parameter a local bound to its
# argument (the caller's environment, which the function's block shares). One whose body
# reaches its own name again is a recursion (`RecursiveLocalFn`).
InlineLocalFn: unbounded fn Lx, Env, [FnClause], [Arg], OutTy -> Vl
fn InlineLocalFn lx, env0, cs, args, t:
    let c = Or cs[0], dummyClause
    let names = Each c.params, \|p| PlainBinder lx, p
    let mark = "#inlining{c.span.start}"
    let env = Bind env0, mark, (BnLocal XUnit, Owned, OutUnit)
    if LocalFnReachesItself env0, cs: RecursiveLocalFn lx, env0, cs, args, t
    else: if HasKey env0.names, mark: VlOwned (InternalBug "a local function inlined in its own body ({DefNameText c.name})"), t
    else: if (Len cs) > 1 or Fold names, False, \|bad, nm| bad or nm == "": InlineLocalFnMatched lx, env0, env, cs, args, t
    else:
        let ((dos, env2)) = Fold (Range0 (Len names)), (([[]], env)), \|((acc, en)), i|
            let nm = Or names[i], ""
            let rs = "{LocalName lx, nm}_{c.span.start}"
            let v = match args[i]:
                ? a: ValueOf lx, env0, a.value
                nil: VlOwned (XUnit), OutUnit
            let bt = ValueTy v
            (((Push acc, (DoLet (PaBind rs), (Own v))), (Bind en, nm, (BnLocal (XVar rs), Owned, bt))))
        VlOwned (XBlock dos, (FnBodyValue lx, env2, c.body)), t

# The lowering at a use of a local function: one the checker generalized (Type System
# ch. 5, "A local `let` generalizes") is lowered where it is used, at that use's
# instantiation, so a closure of it is made once per use, at the type used there.
LocalFnLx: fn Lx, Range -> Lx
fn LocalFnLx lx, span = match lx.useInsts[PlaceKey lx, span]:
    ? u: AtInstance lx, (InstAt lx, u)
    nil: lx

# Whether a local function's body reaches the function's own name, itself or through the
# block's other local functions (each is inlined where it is called, so what its body
# names the caller's body names).
LocalFnReachesItself: unbounded fn Env, [FnClause] -> Bool
fn LocalFnReachesItself env, cs:
    let c = Or cs[0], dummyClause
    HasText (LocalFnNamesClosed env, (LocalFnClauseNames cs)), (DefNameText c.name)

LocalFnClauseNames: unbounded fn [FnClause] -> [Text]
fn LocalFnClauseNames cs = Fold cs, [[]], \|acc, c| match c.body:
    BodyBlock b: UnionTexts acc, (ReadNames (BlockExprs b))
    BodyExpr x: UnionTexts acc, (ReadNames (ExprsIn x))

LocalFnNamesClosed: unbounded fn Env, [Text] -> [Text]
fn LocalFnNamesClosed env, names:
    let more = Fold names, names, \|acc, n| match env.names[n]:
        ? (BnLocalFn cs): UnionTexts acc, (LocalFnClauseNames cs)
        otherwise: acc
    if (Len more) == (Len names): names else: LocalFnNamesClosed env, more

# A local function that calls itself (Semantics ch. 4: a `fn` line is a function of its
# block, and a function may call itself). A closure cannot name itself, so the prelude's
# `recursive` ties the knot: the function is one closure that takes itself first (`go`,
# what its body calls for the function's own name) and its arguments owned, as one value
# (a tuple when there are several); the call gives the closure and the first arguments.
# The closure borrows what it reads of the block, as an inlined body does. The clauses
# are matched in order, as at any call of a function with patterns.
RecursiveLocalFn: unbounded fn Lx, Env, [FnClause], [Arg], OutTy -> Vl
fn RecursiveLocalFn lx, env0, cs, args, t:
    let c = Or cs[0], dummyClause
    let mark = "#recursing{c.span.start}"
    let owned = Each args, \|a| Own (ValueOf lx, env0, a.value)
    let packed = if (Len owned) == 1: Or owned[0], XUnit else: XTuple owned
    match env0.names[mark]:
        ? (BnLocal again, ignore, ignore): VlOwned (XApply again, [[packed]]), t
        otherwise:
            let again = "{LocalName lx, (DefNameText c.name)}_{c.span.start}"
            let atCall = Each args, \|a| SubstTy lx, (TypeAt lx, a.value.span)
            let argTys = match Peel (SubstTy lx, (TypeAt lx, c.span)):
                TyFn col, ps, r: if HasQuant (TyFn col, ps, r): atCall else: ps
                otherwise: atCall
            let outs = Each argTys, \|a| OutTyOf lx, a
            let argTy = if (Len outs) == 1: Or outs[0], OutUnit else: OutTuple outs
            let names = Each (Range0 (Len outs)), \|i| "{again}_{i}"
            let pa = if (Len names) == 1: PaTyped (PaBind (Or names[0], "")), argTy else: PaTyped (PaTuple (Each names, \|nm| PaBind nm)), argTy
            let env = Bind env0, mark, (BnLocal (XVar again), Owned, OutUnit)
            let body = LocalFnMatch lx, env, cs, (Each names, \|nm| XVar nm), argTys, t
            let step = XClosure False, [[(PaBind again), pa]], (Own body)
            VlOwned (XCallAt (HelperRef "recursive"), [[argTy, t]], [[(XRef step), packed]]), t

# A local function whose parameters are patterns, or of several clauses, called: the
# arguments, owned, matched against each clause's patterns in order (the checker has them
# exhaustive), its body over what they bind.
InlineLocalFnMatched: unbounded fn Lx, Env, Env, [FnClause], [Arg], OutTy -> Vl
fn InlineLocalFnMatched lx, callEnv, env, cs, args, t:
    let first = Or cs[0], dummyClause
    let vals = Each (Range0 (Len first.params)), \|i| match args[i]:
        ? a: Own (ValueOf lx, callEnv, a.value)
        nil: XUnit
    LocalFnMatch lx, env, cs, vals, (Each args, \|a| TypeAt lx, a.value.span), t

# A local function's clauses over its arguments' values, each owned: one `match` of them
# as a tuple, an arm per clause. `argTys` are the arguments' types, where a pattern that
# is no name is read (a literal pattern has no type of its own: `fn Medal 0` of a Nat is
# a Nat's 0).
LocalFnMatch: unbounded fn Lx, Env, [FnClause], [Ex], [Ty], OutTy -> Vl
fn LocalFnMatch lx, env, cs, vals, argTys, t:
    let first = Or cs[0], dummyClause
    let arms = Each cs, \|c|
        let pos = Each (Range0 (Len c.params)), \|i|
            let p = Or c.params[i], dummyPat
            let pt = match p.kind:
                PName n: BinderTy lx, n.span
                otherwise: Or argTys[i], (TypeAt lx, p.span)
            RustPat lx, p, pt, Owned, "l{c.span.start}_{i}"
        let env2 = BindAll env, (Fold pos, [[]], \|acc, o| Append acc, o.binds)
        XArm(pat=(PaTuple (Each pos, \|o| o.pa)), conds=(Fold pos, [[]], \|acc, o| Append acc, o.conds), body=(FnBodyValue lx, env2, c.body))
    ArmsValue (XTuple vals), arms, "l{first.span.start}", t

# A local function's binding with one more clause (`fn` lines in clauses, Semantics ch. 4):
# a clause after one of the same name in the block is its next.
WithClause: fn Env, Text, FnClause -> Bn
fn WithClause env, name, c = match env.names[name]:
    ? (BnLocalFn cs) if (Fold cs, False, \|f, k| f or k.span == c.span) == False: BnLocalFn (Push cs, c)
    otherwise: BnLocalFn [[c]]

# A local function as a value (`Fold xs, 0, Add`): a closure made where it is named, at
# the type it is used at there (`LocalFnLx`). One of a single clause is that clause as a
# lambda; one of several clauses is one closure whose body matches its arguments against
# the clauses' patterns in order.
LocalFnValue: unbounded fn Lx, Env, [FnClause], OutTy -> Vl
fn LocalFnValue lx, env, cs, t:
    let c = Or cs[0], dummyClause
    match t:
        OutJobFn a, ignore: JobLocalFn lx, env, cs, t, a
        OutFn pts, r: if (Len cs) == 1: PlainLambda lx, env, c.params, (ClauseLambdaBody c), t else: LocalClausesClosure lx, env, cs, pts, r, t
        otherwise: VlOwned (InternalBug "a local function as a value of a type that is no function's ({DefNameText c.name})"), t

ClauseLambdaBody: fn FnClause -> LambdaBody
fn ClauseLambdaBody c = match c.body:
    BodyExpr e: LbExpr e
    BodyBlock b: LbBlock b

LocalClausesClosure: unbounded fn Lx, Env, [FnClause], [OutTy], OutTy, OutTy -> Vl
fn LocalClausesClosure lx, env, cs, pts, r, ft:
    let c = Or cs[0], dummyClause
    let reads = Fold cs, [[]], \|acc, k| UnionTexts acc, (LambdaReads k.params, (ClauseLambdaBody k))
    let ((dos, env1)) = LambdaCaptures env, (WithInstances env, reads)
    let names = Each (Range0 (Len pts)), \|i| "a{c.span.start}_{i}"
    let pas = Each (Range0 (Len pts)), \|i| PaTyped (PaBind (Or names[i], "")), (OutRef (Or pts[i], OutUnit))
    let vals = Each (Range0 (Len pts)), \|i| Own (LocalPlace (XVar (Or names[i], "")), ByRef, (Or pts[i], OutUnit))
    let argTys = match Peel (SubstTy lx, (TypeAt lx, c.span)):
        TyFn ignore, ps, ignore: ps
        otherwise: [[]]
    let v = LocalFnMatch lx, env1, cs, vals, argTys, r
    VlOwned (XBlock dos, (XCast (XCall (RefRuntime "std::Rc::new"), [[(XClosure True, pas, (Own v))]]), ft)), ft

HasQuant: fn Ty -> Bool
fn HasQuant t = match t:
    TyQ ignore: True
    TyCon ignore, xs: Fold xs, False, \|f, x| f or HasQuant x
    TyFn ignore, ps, r: (HasQuant r) or Fold ps, False, \|f, x| f or HasQuant x
    TyTuple xs: Fold xs, False, \|f, x| f or HasQuant x
    TyArray x: HasQuant x
    TyMap k, v: (HasQuant k) or HasQuant v
    TySig ignore, x: HasQuant x
    TyAt x, ignore: HasQuant x
    TyElem ignore, x: HasQuant x
    otherwise: False

# An argument as a parameter takes it: borrowed, a lambda as a borrowed closure.
Argument: unbounded fn Lx, Env, Expr -> Ex
fn Argument lx, env, e = match env.spans[PlaceKey lx, e.span]:
    ? v: Ref v
    nil: ArgumentByKind lx, env, e

ArgumentByKind: unbounded fn Lx, Env, Expr -> Ex
fn ArgumentByKind lx, env, e = match e.kind:
    ELambda ?ps, body: XRef (LambdaArg lx, env, (Or ?ps, [[]]), body, (LambdaParamTys lx, e, (Len (Or ?ps, [[]]))))
    # a group the checker found a `~T`'s failure at keeps its place (`AsFailure`)
    EGroup x: if HasKey lx.faults, (PlaceKey lx, e.span): Ref (ValueOf lx, env, e) else: Argument lx, env, x
    EName n:
        let t = TypeAt lx, e.span
        match Peel t:
            TyFn CBound, ignore, ignore:
                let ?local = if (Len n.path) == 1: env.names[NameKeyAt lx, env, n, e.span] else: nil
                match ?local:
                    ? ignore: ClosureRef (ValueOf lx, env, e)
                    nil:
                        let ((?qk, why)) = ResolveValue lx.g, lx.home, n
                        match ?qk:
                            ? qk: if (HasKey lx.g.ctors, qk) or why == "answer" or IsMethodKey lx, qk: ClosureRef (ValueOf lx, env, e) else: XRef (XPath (ValueRef lx, qk))
                            nil: Ref (ValueOf lx, env, e)
            otherwise: Ref (ValueOf lx, env, e)
    otherwise: Ref (ValueOf lx, env, e)

# An argument at its parameter's declared type: a lambda where the parameter is a type
# variable (a fold's accumulator `b`) is a function value, held as every function value is,
# not the borrowed closure only a parameter of a function type takes.
ArgumentAt: unbounded fn Lx, Env, Ty, Expr -> Ex
fn ArgumentAt lx, env, declared, e = match Peel declared:
    TyFn ignore, ignore, ignore: Argument lx, env, e
    otherwise: if IsLambdaValue e: Ref (ValueOf lx, env, e) else: Argument lx, env, e

IsLambdaValue: fn Expr -> Bool
fn IsLambdaValue e = match e.kind:
    ELambda ignore, ignore: True
    EGroup x: IsLambdaValue x
    otherwise: False

# A bounded function value where a `&dyn Fn` is taken: a parameter that is one already
# passes on; a closure held in an `Rc` is borrowed through it (`&*f`).
ClosureRef: fn Vl -> Ex
fn ClosureRef (VlPlace x, ByRef, t) = x
fn ClosureRef (VlPlace x, ignore, t) = XRef (XDeref x)
fn ClosureRef (VlOwned x, t) = XRef (XDeref x)

# A tag applied as a value (pick RV): a plain row kind's value is its enum's variant
# around the tag's struct (`Draw::DrawRect(DrawRect { .. })`). An element applied is a
# description (`ElementValue`).
TagValue: unbounded fn Lx, Env, TagInfo, [Arg] -> Vl
fn TagValue lx, env, tg, args:
    let ((variant, structPath)) = TagPaths lx, tg
    let t = OutNamed (KindRef lx, tg.kind), [[]]
    match tg.kind:
        "Element": ElementValue lx, env, tg, args
        "Prelude.Fault": VlOwned (Refusal "a fault kind applied ({tg.name})"), t
        otherwise:
            let named = Fold args, False, \|f, a| f or IsNamedArg a
            let fields = Each (Range0 (Len tg.fields)), \|i|
                let ((fname, fty)) = Or tg.fields[i], (("", TyErr))
                let ?arg = if named: ?TagArg args, fname else: match args[i]:
                    ? a: ? a.value
                    nil: nil
                let v = match ?arg:
                    ? x: RecodedField lx, fty, (Own (ValueOf lx, env, x))
                    nil: (XCall (RefRuntime "std::Default::default"), [[]])
                (((FieldSpell tg.home, fname, fty), v))
            VlOwned (XCtor variant, [[(XRecord structPath, fields)]]), t

# `Ui.Button.Answer click`, a tag's answer constructor applied (rulings round 12, AQ): the
# tag's variant of `crate::Answer` over what the tag's answer carries (`AnswerTy`).
AnswerValue: unbounded fn Lx, Env, Text, [Arg], OutTy -> Vl
fn AnswerValue lx, env, constructor, args, t = match ((lx.g.tags[AnswerTag constructor], args[0])):
    ((? tg, ? a)): VlOwned (XCtor (AnswerVariant tg), [[(OwnAs (AnswerTy lx, tg), (ValueOf lx, env, a.value))]]), t
    otherwise: VlOwned (InternalBug "the answer constructor {constructor} of no tag or with no argument"), t

# `Ui.Button.Answer` named, not applied (`Each cs, Ui.Button.Answer`): a closure building
# the tag's variant from its argument, as a constructor's function value is (`CtorFn`),
# which a bounded value takes by reference and a `Start` owns.
AnswerFn: unbounded fn Lx, Text, OutTy -> Vl
fn AnswerFn lx, constructor, t = match lx.g.tags[AnswerTag constructor]:
    ? tg:
        let carried = AnswerTy lx, tg
        match t:
            OutJobFn a, ignore:
                let made = XCtor (AnswerVariant tg), [[(OwnAs carried, (VlPlace (XVar "a0"), Owned, a))]]
                VlOwned (XCast (XCall (RefRuntime "std::Rc::new"), [[(XClosure True, [[(PaTyped (PaBind "a0"), a)]], (XCall (HelperRef "once_job"), [[(XClosure True, [[]], (XCtor (RefRuntime "prism_rtl::Turn::Finished"), [[made]]))]]))]]), t), t
            otherwise:
                let made = XCtor (AnswerVariant tg), [[(OwnAs carried, (VlPlace (XVar "a0"), ByRef, carried))]]
                VlOwned (XCall (RefRuntime "std::Rc::new"), [[(XClosure False, [[(PaTyped (PaBind "a0"), (OutRef carried))]], made)]]), t
    nil: VlOwned (InternalBug "the answer constructor {constructor} of no tag"), t

# An element applied as a plain value (gap LE; Type System ch. 2, "Names and sigils":
# `Ui.Button(..)` before anything binds it is a plain value): a description, plain data
# with no read point, live only where a statement or a host places it
# (`prism_rtl::element_blueprint`). It holds its fields as given, a `$` field its
# `Dynamic` and an event field its `Event` (the tag's `_desc` record, which a pattern
# matches), its level over time, mapped from its `$` fields, and its requests, each event
# field's firings as the field's request (`RequestField`).
ElementValue: unbounded fn Lx, Env, TagInfo, [Arg] -> Vl
fn ElementValue lx, env, tg, args:
    let ((variant, structPath)) = TagPaths lx, tg
    let descPath = RefIn lx, tg.home, (DescStructOf tg)
    let t = OutLive (OutNamed elemRef, [[]])
    let lxw = update lx:
        &_.whole <= True
    let named = Fold args, False, \|f, a| f or IsNamedArg a
    let n = Len tg.fields
    # each field given, by its index, with its argument
    let argued = Fold (Range0 n), [[]], \|acc, i|
        let ((fname, fty)) = Or tg.fields[i], (("", TyErr))
        let ?arg = if named: ?TagArg args, fname else: match args[i]:
            ? a: ? a.value
            nil: nil
        match ?arg:
            ? x: Push acc, ((i, x))
            nil: acc
    let missing = Filter (Range0 n), \|i| not (Fold argued, False, \|seen, ((j, ignore))| seen or j == i)
    let Local = \|i| "desc_f{i}"
    let FieldOf = \|i| Or tg.fields[i], (("", TyErr))
    let TyAt = \|i| match FieldOf i:
        ((ignore, ft)): ft
    let LayerAt = \|i| LayerOf (TyAt i)
    let NameAt = \|i| match FieldOf i:
        ((fname, ignore)): fname
    let lets = Each argued, \|((i, x))|
        let ((fname, fty)) = FieldOf i
        let v = match LayerOf fty:
            LyPlain: Own (ValueOf lx, env, x)
            otherwise: Own (ValueOf lxw, env, x)
        # a generic tag's field is held as plain data (`TagFieldOut`)
        DoLet (PaBind (Local i)), (RecodedWhole lx, fty, v)
    let Spell = \|i| match FieldOf i:
        ((fname, fty)): FieldSpell tg.home, fname, fty
    let desc = XRecord descPath, (Each argued, \|((i, ignore))| (((Spell i), (XClone (XVar (Local i))))))
    # the level: the plain fields' values and the `$` fields' values, mapped together
    let dyns = Filter argued, \|((i, ignore))| (LayerAt i) == LyDyn
    let names = Each (Range0 (Len dyns)), \|k| "desc_y{k}"
    let NameOfDyn = \|i| Fold (Range0 (Len dyns)), "", \|found, k| match dyns[k]:
        ? ((j, ignore)): if j == i: Or names[k], "" else: found
        nil: found
    # the level holds its event fields' events too (`LevelEvents`, ruling EP)
    let inLevel = Filter argued, \|((i, ignore))| (LayerAt i) != LyEv or (Len (LevelEvents tg)) > 0
    let levelFields = Each inLevel, \|((i, ignore))|
        if (LayerAt i) == LyDyn: (((Spell i), (XClone (XVar (NameOfDyn i))))) else: (((Spell i), (XClone (XVar "{Local i}_l"))))
    let level = XCtor variant, [[(XRecord structPath, levelFields)]]
    let keeps = Each (Filter inLevel, \|((i, ignore))| (LayerAt i) != LyDyn), \|((i, ignore))| DoLet (PaBind "{Local i}_l"), (XClone (XVar (Local i)))
    let tys = Each dyns, \|((i, ignore))| TagFieldOut lx, (TyAt i)
    let mapped = match dyns:
        [[]]: XCall (HelperRef "dyn_constant"), [[level]]
        [[((i, ignore))]]: XMethod (XVar (Local i)), "map", [[(XClosure True, [[(PaTyped (PaBind (Or names[0], "y")), (OutRef (Or tys[0], OutUnit)))]], level)]]
        otherwise:
            # paired up left to right (`map2` into a tuple), then mapped once
            let first = match dyns[0]:
                ? ((i, ignore)): XVar (Local i)
                nil: XUnit
            let ((paired, pty)) = Fold (Filter (Range0 (Len dyns)), \|k| k > 0), ((first, (Or tys[0], OutUnit))), \|((acc, at)), k|
                let it = Or tys[k], OutUnit
                let src = match dyns[k]:
                    ? ((i, ignore)): XVar (Local i)
                    nil: XUnit
                let pair = XClosure True, [[(PaTyped (PaBind "l"), (OutRef at)), (PaTyped (PaBind "r"), (OutRef it))]], (XTuple [[(XClone (XVar "l")), (XClone (XVar "r"))]])
                (((XMethod acc, "map2", [[(XRef src), pair]]), (OutTuple [[at, it]])))
            let m = Len dyns
            let unpack = Each (Range0 m), \|k| DoLet (PaBind (Or names[k], "y")), (XClone (TuplePath (XVar "t"), m, k))
            XMethod paired, "map", [[(XClosure True, [[(PaTyped (PaBind "t"), (OutRef pty))]], (XBlock unpack, level))]]
    let made = XCall (RefRuntime "prism_rtl::described"), [[desc, (XBlock keeps, mapped)]]
    # each event field's firings, the field's request
    let evs = Filter argued, \|((i, ignore))| (LayerAt i) == LyEv
    let requested = Fold evs, made, \|acc, ((i, ignore))|
        let ((fname, fty)) = FieldOf i
        let field = if (Len (Filter tg.fields, \|((ignore, ft))| (LayerOf ft) == LyEv)) > 1: fname else: ""
        let fieldEx = if field == "": XNone else: XCtor (RefRuntime "std::Some"), [[XStr field]]
        let pods = XMethod (XVar (Local i)), "map", [[(XClosure True, [[(PaTyped (PaBind "v"), (OutRef (TagFieldOut lx, fty)))]], (XMethod (XVar "v"), "to_pod", [[]]))]]
        XMethod acc, "request", [[fieldEx, pods]]
    let value = XCall (RefRuntime "prism_rtl::described_element"), [[requested]]
    if (Len missing) > 0: VlOwned (InternalBug "an element value ({tg.name}) without its field `{Or (Each missing, \|i| NameAt i)[0], ""}`"), t
    else: VlOwned (XBlock lets, value), t

# A call of a global: a constructor, a trait method, a prelude function, a program's own.
GlobalCall: unbounded fn Lx, Env, Text, [Arg], Range, Range, OutTy -> Vl
fn GlobalCall lx, env, qk, args, span, cspan, t:
    match lx.g.ctors[qk]:
        ? c: CtorApp lx, env, c, args, span
        nil: match lx.g.vals[qk]:
            ? v if (IsWidgetFn v) and not (IsValueWidget lx, qk): VlOwned (Refusal (WidgetValueWords qk)), t
            ? v:
                if v.sort == "method": MethodCall lx, env, v, args, span, t
                else: if v.home == "Prelude": PreludeCall lx, env, qk, args, span, t
                else:
                    let callArgs = ArgsFor lx, env, v, args
                    let call = match ?TypeArgsAt lx, qk, v.scheme, cspan:
                        ? tys: XCallAt (ValueRef lx, qk), tys, callArgs
                        nil: XCall (ValueRef lx, qk), callArgs
                    let declared = ResultRepr lx, v
                    let declaredTy = match v.scheme.ty:
                        TyFn ignore, ignore, r: Peel r
                        other: Peel other
                    if (HasJobFn declared) and not (HasJobFn t): match ?RecordStartsAsBounded lx, call, declaredTy, (Peel (SubstTy lx, (TypeAt lx, span))), t:
                        ? made: VlOwned made, t
                        nil: AsInstance call, declared, t
                    else: AsInstance call, declared, t
            nil: VlOwned (InternalBug "a call of {qk}"), t

# A record a call returns whose type arguments hold a `Start` the call made bounded
# (`Holder (u fn Nat -> Nat)` at a call that makes `u` bounded): the record made again,
# each field as its type at the call has it (`StartsAsBounded`, by the field's type under
# the declared arguments and under the call's). `nil` for any other type: a choice's
# argument and a named type inside another type stay refused there.
?RecordStartsAsBounded: unbounded fn Lx, Ex, Ty, Ty, OutTy -> ?Ex
fn ?RecordStartsAsBounded lx, x, declaredTy, instanceTy, t = match ((declaredTy, instanceTy)):
    (((TyCon n, declaredArgs), (TyCon m, instanceArgs))) if n == m: match lx.g.ctors[n]:
        ? c:
            let owner = Or lx.g.types[c.owner], dummyTyInfo
            match owner.body:
                BRecord ignore:
                    if (Len c.fields) == 0: nil
                    else:
                        let tyPath = RefIn lx, owner.home, (TypeItemName c.owner)
                        let fields = Each (Range0 (Len c.fields)), \|i|
                            let ft = Or c.args[i], TyErr
                            let spelled = FieldSpell (OwnerOf c.owner), (Or c.fields[i], ""), ft
                            let declaredField = OutTyOf lx, (Instantiated ft, c.params, declaredArgs)
                            let instanceField = OutTyOf lx, (Instantiated ft, c.params, instanceArgs)
                            let boxed = RcField lx, c.name, i
                            let read = Own (VlPlace (FieldOfEx lx, (XVar "held_record"), declaredTy, spelled), (if boxed: RcOwned else: Owned), declaredField)
                            let wrapped = StartsAsBounded read, declaredField, instanceField, i + 1
                            ((spelled, (if boxed: XCall (RefRuntime "std::Rc::new"), [[wrapped]] else: wrapped)))
                        ? (XBlock [[(DoLet (PaBind "held_record"), x)]], (XTyped (XRecord tyPath, fields), t))
                otherwise: nil
        nil: nil
    otherwise: nil

# A generic function's type arguments at a call, in its type parameters' order, when one of
# them is in no parameter's type (`?Nothing: fn Nat -> ?a`): read off the callee's type at
# the call against its scheme. The rest are deduced from the arguments: nil.
?TypeArgsAt: unbounded fn Lx, Text, Scheme, Range -> ?[OutTy]
fn ?TypeArgsAt lx, qk, sc, cspan:
    let generics = Each (FnGenerics lx, qk, sc), \|((g, ignore))| g
    let ((pts, ignore)) = SignatureOut lx, qk, sc
    let deduced = Fold pts, [[]], \|acc, p| UnionTexts acc, (TyParamsIn p)
    if Fold generics, True, \|all, g| all and HasText deduced, g: nil
    else:
        let qs = Filter sc.qs, \|q| HasText generics, (Camel q)
        let ?m = ?InstanceMatch sc.ty, (TypeAt lx, cspan), {}
        ? (Each qs, \|q| TypeArgOf lx, qk, ?m, q)

# An array literal's element, at the element type when that is an optional or a fault.
ElementAt: fn OutTy, Ex -> Ex
fn ElementAt (OutArray (OutRes e)), x = XTyped x, (OutRes e)
fn ElementAt (OutArray (OutOpt e)), x = XTyped x, (OutOpt e)
fn ElementAt ignore, x = x

# One type argument of a call (`?TypeArgsAt`); one the callee's type there does not give is
# refused.
TypeArgOf: unbounded fn Lx, Text, ?(Text ==> Ty), Text -> OutTy
fn TypeArgOf lx, qk, ?m, q = match ?m:
    ? m: match m[q]:
        ? x: OutTyOf lx, x
        nil: InternalBugType "the type `{q}` of a call of `{BareName qk}`, which its type at the call does not give"
    nil: InternalBugType "the type arguments of a call of `{BareName qk}`, whose type at the call does not match its signature"

# One-way matching of a scheme's type against its type at a use: each quantified variable's
# type there.
?InstanceMatch: unbounded fn Ty, Ty, (Text ==> Ty) -> ?(Text ==> Ty)
fn ?InstanceMatch pat, t, m = match ((pat, t)):
    ((TyQ v, x)): match m[v]:
        ? y: if y == x: ? m else: nil
        nil: ? (Insert m, v, x)
    (((TyCon a, xs), (TyCon b, ys))): if a == b and (Len xs) == (Len ys): ?InstanceMatchAll xs, ys, m else: nil
    ((TyTuple xs, TyTuple ys)): if (Len xs) == (Len ys): ?InstanceMatchAll xs, ys, m else: nil
    ((TyArray x, TyArray y)): ?InstanceMatch x, y, m
    (((TyMap k1, v1), (TyMap k2, v2))): ?InstanceMatchAll [[k1, v1]], [[k2, v2]], m
    (((TySig s1, i1), (TySig s2, i2))): if s1 == s2: ?InstanceMatch i1, i2, m else: nil
    (((TyFn ignore, ps, r), (TyFn ignore, qs, s))): if (Len ps) == (Len qs): ?InstanceMatchAll (Push ps, r), (Push qs, s), m else: nil
    # an associated type at a variable decides nothing about it: its instance is already
    # normalized
    (((TyAssoc ignore, ignore, ignore), ignore)): ? m
    otherwise: if pat == t: ? m else: nil

?InstanceMatchAll: unbounded fn [Ty], [Ty], (Text ==> Ty) -> ?(Text ==> Ty)
fn ?InstanceMatchAll xs, ys, m = Fold (Range0 (Len xs)), (? m), \|?acc, i| match ?acc:
    ? mm: ?InstanceMatch (Or xs[i], TyErr), (Or ys[i], TyErr), mm
    nil: nil

# What a named function returns as its Rust signature has it: a function of the
# function's own color variable is a `Start` (`OutJobFn`), whatever color a call gives it.
ResultRepr: unbounded fn Lx, ValInfo -> OutTy
fn ResultRepr lx, v = match v.scheme.ty:
    TyFn ignore, ignore, r: OutTyOf lx, (Peel r)
    other: OutTyOf lx, (Peel other)

# A call's result as its instantiation wants it: a `Start` where the call made the
# function's color bounded is wrapped as the bounded function it is, each call run to its
# end at once (`run_to_end`, which a bounded job reaches in its first cycles). A
# `Start` inside the value (`[u fn Nat -> Nat]` at a call that makes `u` bounded) is
# reached through what holds it (`StartsAsBounded`).
AsInstance: unbounded fn Ex, OutTy, OutTy -> Vl
fn AsInstance call, declared, t = if (HasJobFn declared) and not (HasJobFn t): VlOwned (StartsAsBounded call, declared, t, 0), t else: VlOwned call, t

# A value as its type at a call has it, each `Start` in it wrapped as the bounded function
# the call made it (`WrapAsBounded`): through an array (the prelude's `each`), an optional,
# a `~T`, a tuple, a map's values and a function's result, to any depth. `depth` keeps the
# names of nested levels apart. A `Start` held by a function's own parameter or by a named
# type's argument is refused, loudly: nothing here rebuilds those.
StartsAsBounded: unbounded fn Ex, OutTy, OutTy, Nat -> Ex
fn StartsAsBounded x, declared, t, depth:
    let inner = "s{depth}"
    if not (HasJobFn declared): x
    else: match ((declared, t)):
        # a `Start` whose own result holds one (`fn Nat -> (u fn Nat -> Nat)` given by a
        # function of the color): each application runs its job to the end and wraps
        # what the job gives
        (((OutJobFn ignore, dr), (OutFn pts, er))) if HasJobFn dr:
            let jobName = "job_fn_{depth}"
            let names = Each (Range0 (Len pts)), \|i| "a{i}"
            let pas = Each (Range0 (Len pts)), \|i| PaTyped (PaBind (Or names[i], "a")), (OutRef (Or pts[i], OutUnit))
            let arg = if (Len pts) == 1: XClone (XVar "a0") else: XTuple (Each names, \|nm| XClone (XVar nm))
            let ran = XCall (HelperRef "run_to_end"), [[(XApply (XVar jobName), [[arg]])]]
            XBlock [[(DoLet (PaBind jobName), x)]], (XCast (XCall (RefRuntime "std::Rc::new"), [[(XClosure True, pas, (StartsAsBounded ran, dr, er, depth + 1))]]), t)
        (((OutJobFn ignore, ignore), (OutFn pts, ignore))): WrapAsBounded x, pts, t
        ((OutArray d, OutArray e)): XCall (HelperRef "each"), [[(XRef x), (XRef (XClosure False, [[(PaTyped (PaBind inner), (OutRef d))]], (StartsAsBounded (XClone (XVar inner)), d, e, depth + 1)))]]
        ((OutOpt d, OutOpt e)):
            let some = XArm(pat=(PaCtor (RefRuntime "std::Some"), [[PaBind inner]]), conds=[[]], body=(XCtor (RefRuntime "std::Some"), [[(StartsAsBounded (XVar inner), d, e, depth + 1)]]))
            let none = XArm(pat=(PaUnit (RefRuntime "std::None")), conds=[[]], body=XNone)
            XMatch x, [[some, none]], False, t
        ((OutRes d, OutRes e)):
            let ok = XArm(pat=(PaCtor (RefRuntime "std::Ok"), [[PaBind inner]]), conds=[[]], body=(XCtor (RefRuntime "std::Ok"), [[(StartsAsBounded (XVar inner), d, e, depth + 1)]]))
            let failed = XArm(pat=(PaCtor (RefRuntime "std::Err"), [[PaBind inner]]), conds=[[]], body=(XCtor (RefRuntime "std::Err"), [[(XVar inner)]]))
            XMatch x, [[ok, failed]], False, t
        ((OutTuple ds, OutTuple es)):
            let names = Each (Range0 (Len ds)), \|i| "{inner}_{i}"
            let parts = Each (Range0 (Len ds)), \|i| StartsAsBounded (XVar (Or names[i], "")), (Or ds[i], OutUnit), (Or es[i], OutUnit), depth + 1
            XBlock [[(DoLet (PaTuple (Each names, \|nm| PaBind nm)), x)]], (XTuple parts)
        # a map's values (a key holds no function): the map made again, each value wrapped
        (((OutMap dk, dv), (OutMap ek, ev))):
            let keyName = "{inner}_key"
            let step = XClosure False, [[(PaTyped (PaBind "{inner}_made"), (OutRef t)), (PaTyped (PaBind keyName), (OutRef dk)), (PaTyped (PaBind inner), (OutRef dv))]], (XCall (HelperRef "insert"), [[(XVar "{inner}_made"), (XVar keyName), (XRef (StartsAsBounded (XClone (XVar inner)), dv, ev, depth + 1))]])
            XCall (HelperRef "fold_map"), [[(XRef x), (XRef (XCast (XCall (RefRuntime "rt::Map::new"), [[]]), t)), (XRef step)]]
        # a function whose result holds one and whose parameters hold none: a function
        # that calls it and wraps what it gives
        (((OutFn dps, dr), (OutFn eps, er))) if not (Fold dps, False, \|f, p| f or HasJobFn p):
            let names = Each (Range0 (Len dps)), \|i| "{inner}_{i}"
            let pas = Each (Range0 (Len dps)), \|i| PaTyped (PaBind (Or names[i], "")), (OutRef (Or dps[i], OutUnit))
            let applied = XApply (XVar "{inner}_fn"), (Each names, \|nm| XVar nm)
            XBlock [[(DoLet (PaBind "{inner}_fn"), x)]], (XCast (XCall (RefRuntime "std::Rc::new"), [[(XClosure True, pas, (StartsAsBounded applied, dr, er, depth + 1))]]), t)
        otherwise: Refusal "a function value of its callee's own color in a named type or in another function's parameter, inside the value a call returns, at a call that makes the color bounded"

HasJobFn: unbounded fn OutTy -> Bool
fn HasJobFn t = match t:
    OutJobFn ignore, ignore: True
    OutOpt i: HasJobFn i
    OutRes i: HasJobFn i
    OutArray i: HasJobFn i
    OutMap k, v: (HasJobFn k) or HasJobFn v
    OutTuple ts: Fold ts, False, \|f, x| f or HasJobFn x
    OutNamed ignore, ts: Fold ts, False, \|f, x| f or HasJobFn x
    OutFn ps, r: Fold ps, (HasJobFn r), \|f, x| f or HasJobFn x
    otherwise: False

# A `Start` as the bounded function its call made it: each application runs its job to
# the end.
WrapAsBounded: fn Ex, [OutTy], OutTy -> Ex
fn WrapAsBounded f, pts, target:
    let names = Each (Range0 (Len pts)), \|i| "a{i}"
    let pas = Each (Range0 (Len pts)), \|i| PaTyped (PaBind (Or names[i], "a")), (OutRef (Or pts[i], OutUnit))
    let arg = if (Len pts) == 1: XClone (XVar "a0") else: XTuple (Each names, \|nm| XClone (XVar nm))
    let body = XCall (HelperRef "run_to_end"), [[(XApply (XVar "job_fn"), [[arg]])]]
    XBlock [[(DoLet (PaBind "job_fn"), f)]], (XCast (XCall (RefRuntime "std::Rc::new"), [[(XClosure True, pas, body)]]), target)

# A function's arguments, borrowed; a bare `Error(..)` where the parameter is a `~T` is
# that `~T`'s failure, made where the checker found it one (`AsFailure`).
ArgsFor: unbounded fn Lx, Env, ValInfo, [Arg] -> [Ex]
fn ArgsFor lx, env, v, args:
    let ps = match v.scheme.ty:
        TyFn ignore, xs, ignore: xs
        otherwise: [[]]
    Each (Range0 (Len args)), \|i|
        let a = Or args[i], (Arg(marks="", ?name=nil, value=dummyExpr, span=Range(start=0, end=0)))
        let toUnbounded = match Peel (Or ps[i], TyErr):
            TyFn CBound, ignore, ignore: False
            TyFn ignore, ignore, ignore: True
            otherwise: False
        # a function that takes time whole, applied lifted outside such a body (`$Sel
        # (True on !swap), $a, $b`): its sigiled dynamics go in whole, the live dynamics
        # their line made (`WholeArgs`); the lifted arguments are values
        let wholeAt = (not lx.whole) and (IsWholeFn lx, v.qk) and (LayerOf (Or ps[i], TyErr)) == LyDyn
        if toUnbounded: XRef (AsJobValue lx, env, a.value)
        else: if wholeAt:
            let lxw = update lx:
                &_.whole <= True
            XRef (Own (ValueOf lxw, env, a.value))
        else: ArgumentAt lx, env, (Or ps[i], TyErr), a.value

let dummyExpr = Expr(kind=EError, span=Range(start=0, end=0))

# A constructor applied (claude/backend.md: a record is a struct, a choice an enum with
# recursive payloads behind `Rc`, a newtype a tuple struct, a unit type a unit struct).
CtorApp: unbounded fn Lx, Env, CtorInfo, [Arg], Range -> Vl
fn CtorApp lx, env, c, args, span:
    let t = OutTyOf lx, (Peel (TypeAt lx, span))
    let owner = Or lx.g.types[c.owner], dummyTyInfo
    let tyPath = RefIn lx, owner.home, (TypeItemName c.owner)
    let vals = CtorArgs lx, env, c, args
    match c.owner:
        "Bool": VlOwned (XBool (c.name == "True")), OutBool
        "Prelude.Error":
            let msg = Or vals[1], (XText "")
            # the kind is a `Fault` value (`fault_kind`): the error keeps its name
            let made = match Or vals[0], (XStr ""):
                XStr name: XCall (RefRuntime "rt::Error::new"), [[(XStr name), msg]]
                kind: XCall (HelperRef "error_of"), [[(XRef kind), msg]]
            match t:
                OutRes ignore: Failing made, t
                otherwise: VlOwned made, OutError
        otherwise: match owner.body:
            BRecord fs:
                if (Len c.fields) == 0: VlOwned (XPath tyPath), t
                else:
                    let made = XRecord tyPath, (Each (Range0 (Len c.fields)), \|i| (((FieldSpell (OwnerOf c.owner), (Or c.fields[i], ""), (Or c.args[i], TyErr)), (Or vals[i], (XCall (RefRuntime "std::Default::default"), [[]])))))
                    # a generic record with its type said, which a printer whose target
                    # deduces it from the fields (C++, by copy from a nested one) spells
                    if (Len owner.params) > 0: VlOwned (XTyped made, (BuiltTy t)), t
                    else: VlOwned made, t
            BChoice cases:
                let isUnitType = (Len cases) == 1 and (Len c.args) == 0 and IsLowerText (BareName c.name)
                # a newtype is a tuple struct (a struct in C++), built by its own name
                let isNewtype = (Len cases) == 1 and (BareName c.name) == (BareName c.owner)
                let path = if isUnitType or isNewtype: tyPath else: RefChild tyPath, (Camel (BareName c.name))
                let made = if (Len c.args) == 0: XPath path else: XCtor path, vals
                # a generic choice's case with the choice's type said, which a printer
                # whose target cannot infer the type arguments spells (C++)
                if (Len owner.params) > 0 and not isUnitType and not isNewtype: VlOwned (XTyped made, (BuiltTy t)), t
                else: VlOwned made, t
            otherwise: VlOwned (InternalBug "a constructor of {c.owner}"), t

# The type a constructor builds: its own, or the result of the function it is used as.
BuiltTy: fn OutTy -> OutTy
fn BuiltTy t = match t:
    OutFn ignore, r: r
    OutJobFn ignore, r: r
    otherwise: t

# A constructor used as a function value (`OnePattern p, CkExpect`): a closure building
# it from its arguments, which a bounded value takes by reference and a `Start` owns.
CtorFn: unbounded fn Lx, CtorInfo, [OutTy], Range, OutTy, Bool -> Vl
fn CtorFn lx, c, pts, span, t, job:
    let names = Each (Range0 (Len pts)), \|i| "a{i}"
    # Each argument stands at a place no source has, bound to its parameter.
    let fakes = Each (Range0 (Len pts)), \|i| Arg(marks="", ?name=nil, value=(Expr(kind=EAbsent, span=Range(start=(4000000000 + i), end=(4000000000 + i)))), span=Range(start=0, end=0))
    let env = Fold (Range0 (Len pts)), emptyEnv, \|en, i| BindSpan en, (PlaceKey lx, (Range(start=(4000000000 + i), end=(4000000000 + i)))), (VlPlace (XVar (Or names[i], "a")), (if job: Owned else: ByRef), (Or pts[i], OutUnit))
    let made = Own (CtorApp lx, env, c, fakes, span)
    if job:
        let a = match t:
            OutJobFn x, ignore: x
            otherwise: OutUnit
        let pa = if (Len pts) == 1: PaTyped (PaBind "a0"), a else: PaTyped (PaTuple (Each names, \|nm| PaBind nm)), a
        VlOwned (XCast (XCall (RefRuntime "std::Rc::new"), [[(XClosure True, [[pa]], (XCall (HelperRef "once_job"), [[(XClosure True, [[]], (XCtor (RefRuntime "prism_rtl::Turn::Finished"), [[made]]))]]))]]), t), t
    else:
        let pas = Each (Range0 (Len pts)), \|i| PaTyped (PaBind (Or names[i], "a")), (OutRef (Or pts[i], OutUnit))
        VlOwned (XCall (RefRuntime "std::Rc::new"), [[(XClosure False, pas, made)]]), t

IsNamedArg: fn Arg -> Bool
fn IsNamedArg a = match a.?name:
    ? ignore: True
    nil: False

# A constructor's arguments, by position or by field name, owned, an `Rc` where the
# field is recursive.
CtorArgs: unbounded fn Lx, Env, CtorInfo, [Arg] -> [Ex]
fn CtorArgs lx, env, c, args:
    let named = Fold args, False, \|f, a| f or IsNamedArg a
    let ordered = if named: Each c.fields, \|f| Fold args, nil, \|?found, a| match a.?name:
        ? n: if n.name == f: ? a.value else: ?found
        nil: ?found
    else: Each args, \|a| ? a.value
    Each (Range0 (Len ordered)), \|i| match ordered[i]:
        ? (? x):
            let v = Own (ValueOf lx, env, x)
            if c.owner == "Prelude.Error" and i == 0: v
            else: if RcField lx, c.name, i: XCall (RefRuntime "std::Rc::new"), [[v]] else: v
        otherwise: (XCall (RefRuntime "std::Default::default"), [[]])

# A trait method applied: the operator a builtin, derived or written impl answers (an
# `impl ^Eq` is emitted as Rust's `PartialEq` and `Eq`, so `==` reaches it), or the method of a
# program's own trait.
MethodCall: unbounded fn Lx, Env, ValInfo, [Arg], Range, OutTy -> Vl
fn MethodCall lx, env, v, args, span, t:
    let cls = Or (Each v.scheme.bounds, \|((ignore, c))| c)[0], ""
    let m = BareName v.qk
    let vals = Each args, \|a| ValueOf lx, env, a.value
    if (HasPrefix cls, "Prelude."): PreludeMethod lx, cls, m, vals, span, t
    else:
        let tr = Or lx.g.traits[cls], dummyTraitInfo
        let mname = Or lx.rsNames[v.qk], (Snake m)
        # a method whose type is only in its result is called at the type the call gives,
        # which the checker's impl note at the call says
        if IsResultOnly lx, v.qk, tr.param: match ?SelfAt lx, span, cls:
            ? self: VlOwned (XCallSelf (RefIn lx, tr.home, (TraitName cls)), mname, self, (ArgsFor lx, env, v, args)), t
            nil: VlOwned (InternalBug "a call of `{m}` at a type the checker did not record"), t
        else:
            let path = RefIn lx, tr.home, "{TraitName cls}::{mname}"
            VlOwned (XCall path, (ArgsFor lx, env, v, args)), t

IsMethodKey: fn Lx, Text -> Bool
fn IsMethodKey lx, qk = match lx.g.vals[qk]:
    ? v: v.sort == "method"
    nil: False

# A trait method named, not applied (`Each ns, Blank`): a closure calling it with its
# arguments, each at a place no source has (as `CtorFn`), so the call is lowered as any
# call of the method is: at the type the checker solved the trait at where the name
# stands. The checker notes that type at the name for every want it solves (`Solved`, by
# the span the name's scheme was instantiated at), a given and a quantified one included,
# so a method whose type is only in its result has it there (`MethodCall`'s `?SelfAt`).
MethodFn: unbounded fn Lx, ValInfo, Range, OutTy -> Vl
fn MethodFn lx, v, span, t = match t:
    OutFn pts, rt:
        let names = Each (Range0 (Len pts)), \|i| "a{i}"
        let fakes = Each (Range0 (Len pts)), \|i| Arg(marks="", ?name=nil, value=(Expr(kind=EAbsent, span=Range(start=(4000000000 + i), end=(4000000000 + i)))), span=Range(start=0, end=0))
        let env = Fold (Range0 (Len pts)), emptyEnv, \|en, i| BindSpan en, (PlaceKey lx, (Range(start=(4000000000 + i), end=(4000000000 + i)))), (VlPlace (XVar (Or names[i], "a")), ByRef, (Or pts[i], OutUnit))
        let made = Own (MethodCall lx, env, v, fakes, span, rt)
        let pas = Each (Range0 (Len pts)), \|i| PaTyped (PaBind (Or names[i], "a")), (OutRef (Or pts[i], OutUnit))
        VlOwned (XCall (RefRuntime "std::Rc::new"), [[(XClosure False, pas, made)]]), t
    otherwise: VlOwned (Refusal "the trait method `{BareName v.qk}` as an unbounded function's value"), t

# The type a call's want of a trait was solved at (its impl note).
?SelfAt: unbounded fn Lx, Range, Text -> ?OutTy
fn ?SelfAt lx, span, cls = Fold (Or lx.impls[PlaceKey lx, span], [[]]), nil, \|?found, n| match ?found:
    ? x: ? x
    nil: if n.cls == cls: ? (OutTyOf lx, (SubstTy lx, n.ty)) else: nil

let dummyTraitInfo = TraitInfo(name="", home="", param="a", supers=[[]], methods=[[]], defaults=[[]], assocs=[[]], assocDefaults=[[]], file=0, span=Range(start=0, end=0))

PreludeMethod: unbounded fn Lx, Text, Text, [Vl], Range, OutTy -> Vl
fn PreludeMethod lx, cls, m, vals, span, t:
    let a = Or vals[0], (VlOwned (XUnit), OutUnit)
    let b = Or vals[1], (VlOwned (XUnit), OutUnit)
    match m:
        "Show": VlOwned (XCall (HelperRef "show_text"), [[Ref a]]), OutText
        "Compare": VlOwned (XCall (HelperRef "compare"), [[Ref a, Ref b]]), t
        "Children": VlOwned (XCall (HelperRef "children"), [[Ref a]]), t
        otherwise: OpValue lx, m, a, b, span, t

# A binary operator.
BinaryValue: unbounded fn Lx, Env, Text, Expr, Expr, Range -> Vl
fn BinaryValue lx, env, op, l, r, span:
    let t = OutTyOf lx, (Peel (TypeAt lx, span))
    match op:
        "and": VlOwned (XBin OpAnd, (AsBool (ValueOf lx, env, l)), (AsBool (ValueOf lx, env, r))), OutBool
        "or": VlOwned (XBin OpOr, (AsBool (ValueOf lx, env, l)), (AsBool (ValueOf lx, env, r))), OutBool
        # In a function lifted over an event (`fn !Bump $n, !go = $n + 1 on !go`), the
        # function runs at the event's firing, so `x on !e` is `x` read there.
        "on": ValueOf lx, env, l
        otherwise: OpValue lx, op, (ValueOf lx, env, l), (ValueOf lx, env, r), span, t

# An operator over two values of the left one's type (Type System ch. 3: `^Eq`, `^Ord`,
# `^Num` on the built-in numbers; `/` gives `?a` on the integers, doubt QD).
OpValue: fn Lx, Text, Vl, Vl, Range, OutTy -> Vl
fn OpValue lx, op, a, b, span, t:
    let at = ValueTy a
    let generic = match at:
        OutGen ignore: True
        otherwise: False
    if HasText [["==", "!=", "<", "<=", ">", ">="]], op: VlOwned (OpOf op, (Ref a), (Ref b)), OutBool
    else: if op == "mod": VlOwned (XMethod (Ref a), "modulo", [[Ref b]]), t
    else: if generic: VlOwned (XCall (RefRuntime "rt::Num::{NumMethod op}"), [[Ref a, Ref b]]), t
    else: if op == "/":
        if at == OutFloat: VlOwned (XBin OpDiv, (Copy a), (Copy b)), t
        else: VlOwned (XMethod (Ref a), "div", [[Ref b]]), t
    else: if op == "-?":
        if at == OutNat: VlOwned (XMethod (Ref a), "checked_sub", [[Ref b]]), t
        else: VlOwned (XCtor (RefRuntime "std::Some"), [[(XBin OpSub, (Ref a), (Ref b))]]), t
    else: if op == "+?": VlOwned (XCtor (RefRuntime "std::Some"), [[(XBin OpAdd, (Ref a), (Ref b))]]), t
    else: if op == "*?": VlOwned (XCtor (RefRuntime "std::Some"), [[(XBin OpMul, (Ref a), (Ref b))]]), t
    else: if IsCopy at: VlOwned (OpOf op, (Copy a), (Copy b)), t
    else: VlOwned (OpOf op, (Ref a), (Ref b)), t

# A Prism operator of two operands in the model; one the model has no operator for is
# refused.
OpOf: fn Text, Ex, Ex -> Ex
fn OpOf op, a, b = match ?BinOpOf op:
    ? o: XBin o, a, b
    nil: InternalBug "the operator `{op}`"

NumMethod: fn Text -> Text
fn NumMethod "+" = "add"
fn NumMethod "-" = "sub"
fn NumMethod "*" = "mul"
fn NumMethod "/" = "div_opt"
fn NumMethod "+?" = "add_opt"
fn NumMethod "-?" = "sub_opt"
fn NumMethod "*?" = "mul_opt"
fn NumMethod other = "add"

# A prelude function (prelude/prelude.prism; its Rust is `Emit.Rust.Prelude`): borrowed
# arguments, the variant for a text or a map where one name serves several (doubt LZ).
PreludeCall: unbounded fn Lx, Env, Text, [Arg], Range, OutTy -> Vl
fn PreludeCall lx, env, qk, args, span, t:
    let name = Or lx.rsNames[qk], (Snake (BareName qk))
    let first = match args[0]:
        ? a: OutTyOf lx, (Peel (TypeAt lx, a.value.span))
        nil: OutUnit
    let variant = PreludeVariant name, first
    match ?PreludeJob lx, env, variant, args:
        ? job: VlOwned (XCall (HelperRef "run_to_end"), [[job]]), t
        nil:
            let ps = match lx.g.vals[qk]:
                ? v: match v.scheme.ty:
                    TyFn ignore, xs, ignore: xs
                    otherwise: [[]]
                nil: [[]]
            VlOwned (XCall (HelperRef variant), (Each (Range0 (Len args)), \|i| ArgumentAt lx, env, (Or ps[i], TyErr), (Or args[i], (Arg(marks="", ?name=nil, value=dummyExpr, span=Range(start=0, end=0)))).value)), t

# D8 in the back end: `Fold`, `Each` and `Filter` given a closure that is not bounded are
# the prelude's job versions (`fold_job`), the closure a `Start`: each call it makes is a
# call of an unbounded function, a cycle point inside a job (D6). Direct-style code runs
# the job to its result; a job makes it a frame or a tail call. The arguments owned.
?PreludeJob: unbounded fn Lx, Env, Text, [Arg] -> ?Ex
fn ?PreludeJob lx, env, variant, args:
    if HasText [["fold", "fold_map", "each", "each_map", "filter", "filter_map"]], variant:
        let last = Or args[Dec (Len args)], (Arg(marks="", ?name=nil, value=dummyExpr, span=Range(start=0, end=0)))
        match OutTyOf lx, (Peel (TypeAt lx, last.value.span)):
            OutJobFn ignore, ignore:
                let front = Each (Take args, (Dec (Len args))), \|a| Own (ValueOf lx, env, a.value)
                ? (XCall (HelperRef "{variant}_job"), (Push front, (AsJobValue lx, env, last.value)))
            otherwise: nil
    else: nil

# A call of a prelude function that is a job here (`?PreludeJob`).
?PreludeJobCall: unbounded fn Lx, Env, Expr -> ?Ex
fn ?PreludeJobCall lx, env, e = match e.kind:
    ECall c, args, ignore, ignore: match c.kind:
        EName n:
            if (Len n.path) == 1 and HasKey env.names, (SNameKey n): nil
            else:
                let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
                match ?qk:
                    ? qk: match lx.g.vals[qk]:
                        ? v:
                            if v.home == "Prelude":
                                let name = Or lx.rsNames[qk], (Snake (BareName qk))
                                let first = match args[0]:
                                    ? a: OutTyOf lx, (Peel (TypeAt lx, a.value.span))
                                    nil: OutUnit
                                ?PreludeJob lx, env, (PreludeVariant name, first), args
                            else: nil
                        nil: nil
                    nil: nil
        otherwise: nil
    otherwise: nil

# A value where a `Start` is wanted (an unbounded or color-polymorphic parameter): a
# lambda is a job lambda, a `Start` is itself, and a bounded function value is wrapped
# in a job that answers in its first cycle.
AsJobValue: unbounded fn Lx, Env, Expr -> Ex
fn AsJobValue lx, env, e = match e.kind:
    EGroup x: AsJobValue lx, env, x
    otherwise:
        let target = match Peel (TypeAt lx, e.span):
            TyFn ignore, ps, r: OutJobFn (RustTyOfParams lx, ps), (OutTyOf lx, r)
            other: OutTyOf lx, other
        let a = match target:
            OutJobFn x, ignore: x
            otherwise: OutUnit
        match e.kind:
            ELambda ?ps, body: Own (JobLambda lx, env, (Or ?ps, [[]]), body, target, a, (EntersLambda lx, e))
            otherwise:
                let v = ValueOf lx, env, e
                match ValueTy v:
                    OutFn pts, ignore: WrapAsJob (Own v), pts, target, a
                    otherwise: Own v

# A bounded function value as a `Start`: its job answers in its first cycle.
WrapAsJob: fn Ex, [OutTy], OutTy, OutTy -> Ex
fn WrapAsJob f, pts, target, a:
    let names = Each (Range0 (Len pts)), \|i| "a{i}"
    let pa = if (Len pts) == 1: PaTyped (PaBind "a0"), a else: PaTyped (PaTuple (Each names, \|nm| PaBind nm)), a
    let call = XApply (XVar "fy"), (Each names, \|nm| XRef (XVar nm))
    let body = XBlock [[(DoLet (PaBind "fy"), (XClone (XVar "f")))]], (XCall (HelperRef "once_job"), [[(XClosure True, [[]], (XCtor (RefRuntime "prism_rtl::Turn::Finished"), [[call]]))]])
    XBlock [[(DoLet (PaBind "f"), f)]], (XCast (XCall (RefRuntime "std::Rc::new"), [[(XClosure True, [[pa]], body)]]), target)

# A named function's arguments, owned, as its job's fields take them: a function
# parameter that is not bounded takes a `Start`.
NamedArgsOwned: unbounded fn Lx, Env, Text, [Arg] -> [Ex]
fn NamedArgsOwned lx, env, qk, args:
    let ((ps, ignore)) = SchemeParts lx, qk
    Each (Range0 (Len args)), \|i|
        let a = Or args[i], (Arg(marks="", ?name=nil, value=dummyExpr, span=Range(start=0, end=0)))
        match Peel (Or ps[i], TyErr):
            TyFn CBound, ignore, ignore: Own (ValueOf lx, env, a.value)
            TyFn ignore, ignore, ignore: AsJobValue lx, env, a.value
            otherwise: Own (ValueOf lx, env, a.value)

# A `Start` value's arguments, owned: one whose parameter type is a `Start` is made one.
StartArgs: unbounded fn Lx, Env, Vl, [Arg] -> [Ex]
fn StartArgs lx, env, f, args:
    let pts = match ValueTy f:
        OutJobFn (OutTuple ts), ignore: if (Len args) == 1: [[OutTuple ts]] else: ts
        OutJobFn a, ignore: [[a]]
        otherwise: [[]]
    Each (Range0 (Len args)), \|i|
        let a = Or args[i], (Arg(marks="", ?name=nil, value=dummyExpr, span=Range(start=0, end=0)))
        match Or pts[i], OutUnit:
            OutJobFn ignore, ignore: AsJobValue lx, env, a.value
            otherwise: Own (ValueOf lx, env, a.value)

PreludeVariant: fn Text, OutTy -> Text
fn PreludeVariant name, first = match first:
    OutText: if name == "len": "len_text" else: name
    OutMap ignore, ignore: if HasText [["len", "fold", "each", "filter"]], name: "{name}_map" else: name
    otherwise: name

# `r.field`: a place when `r` is one (Type System ch. 1, "Sigils on fields": `r.?f` reads
# the same field).
FieldValue: unbounded fn Lx, Env, Expr, Text -> Vl
fn FieldValue lx, env, r, name:
    let rv = ValueOf lx, env, r
    let rty = Peel (TypeAt lx, r.span)
    let ((ft, rc, f)) = FieldInfo lx, rty, name
    let mode = if rc: RcOwned else: Owned
    let x = match rv:
        VlPlace y, ignore, ignore: y
        VlOwned y, ignore: y
    # an `Error`'s `kind` is kept as its name: read, it is a `Fault` value (`kind_of`)
    match rty:
        TyCon "Prelude.Error", ignore if name == "kind": VlOwned (XCall (HelperRef "kind_of"), [[(XRef x)]]), OutPod
        otherwise: VlPlace (FieldOfEx lx, x, rty, f), mode, ft

# A field of a value of the program's type `rty`, by its owner type (`XFieldOf`); a type
# lowering refused to name (`FieldInfo` says so) reads by the name alone.
FieldOfEx: fn Lx, Ex, Ty, Text -> Ex
fn FieldOfEx lx, x, rty, f = match ?FieldOwner lx, rty:
    ? owner: XFieldOf x, owner, f
    nil: XField x, f

# The program's record type whose field a value of type `rty` has.
?FieldOwner: fn Lx, Ty -> ?Ref
fn ?FieldOwner lx, rty = match rty:
    TyCon "Prelude.Error", ignore: nil
    TyCon n, ignore: match lx.g.types[n]:
        ? ti: ? (RefIn lx, ti.home, (TypeItemName n))
        nil: nil
    otherwise: nil

# A record field's Rust type and whether it is behind an `Rc`.
FieldInfo: unbounded fn Lx, Ty, Text -> ((OutTy, Bool, Text))
fn FieldInfo lx, rty, name = match rty:
    # the runtimes' `Error`, a builtin record: `kind` (a `Fault`) and `message`, both plain
    TyCon "Prelude.Error", ignore: (((if name == "kind": OutPod else: OutText), False, (FieldSpell "Prelude", name, tText)))
    TyCon n, args: match lx.g.ctors[n]:
        ? c:
            let ?fix = Fold (Range0 (Len c.fields)), nil, \|?found, i| if (Or c.fields[i], "") == name: ? i else: ?found
            match ?fix:
                ? i:
                    let ft = Or c.args[i], TyErr
                    let inst = Instantiated ft, c.params, args
                    (((OutTyOf lx, inst), (RcField lx, c.name, i), (FieldSpell (OwnerOf c.owner), (Or c.fields[i], name), ft)))
                nil: (((InternalBugType "a field {name}"), False, (FieldByName lx, name)))
        nil: (((InternalBugType "a field {name}"), False, (FieldByName lx, name)))
    otherwise: (((InternalBugType "a field {name} of a non-record"), False, (FieldByName lx, name)))

# A field's spelling where lowering has no record type for the place it is read from (an
# update's `&_[k].f`, a pattern's binder): the one every record with a field of that name
# gives it, the record the checker resolved being among them.
FieldByName: unbounded fn Lx, Text -> Text
fn FieldByName lx, name:
    let spellings = Fold (Values lx.g.ctors), [[]], \|acc, c| Fold (Range0 (Len c.fields)), acc, \|a, i| if (Or c.fields[i], "") == name: AddText a, (FieldSpell (OwnerOf c.owner), name, (Or c.args[i], TyErr)) else: a
    match spellings:
        [[one]]: one
        otherwise: Snake name

# A field's declared type with the record's parameters replaced by its arguments.
Instantiated: unbounded fn Ty, [Text], [Ty] -> Ty
fn Instantiated t, params, args = match t:
    TyQ q:
        let ?hit = Fold (Range0 (Len params)), nil, \|?found, i| if (Or params[i], "") == q: args[i] else: ?found
        Or ?hit, t
    TyCon n, xs: TyCon n, (Each xs, \|x| Instantiated x, params, args)
    TyFn c, ps, res: TyFn c, (Each ps, \|x| Instantiated x, params, args), (Instantiated res, params, args)
    TyTuple ts: TyTuple (Each ts, \|x| Instantiated x, params, args)
    TyArray e: TyArray (Instantiated e, params, args)
    TyMap k, v: TyMap (Instantiated k, params, args), (Instantiated v, params, args)
    TySig s, i: TySig s, (Instantiated i, params, args)
    TyAssoc tr, n, a: TyAssoc tr, n, (Instantiated a, params, args)
    otherwise: t

# `xs[i]`: an optional, of an array or a map (a text has no index: the checker refuses it).
IndexValue: unbounded fn Lx, Env, Expr, Expr, OutTy -> Vl
fn IndexValue lx, env, r, i, t:
    let rt = OutTyOf lx, (Peel (TypeAt lx, r.span))
    let f = match rt:
        OutMap ignore, ignore: HelperRef "get"
        otherwise: HelperRef "index"
    VlOwned (XCall f, [[(Argument lx, env, r), (Argument lx, env, i)]]), (OutOpt t)

# The names an expression or block reads, for a closure's captures.
ReadNames: unbounded fn [Expr] -> [Text]
fn ReadNames es = Fold es, [[]], \|acc, x| match x.kind:
    EName n: if (Len n.path) == 1: AddText acc, (SNameKey n) else: acc
    otherwise: acc

LambdaExprs: unbounded fn LambdaBody -> [Expr]
fn LambdaExprs (LbExpr x) = ExprsIn x
fn LambdaExprs (LbBlock b) = BlockExprs b

# The one-part names among expressions that no scope hides where they stand; each scope is
# the names an inner binder binds and the range it binds them over.
FreeReads: unbounded fn [Expr], [(([Text], Range))] -> [Text]
fn FreeReads es, outer:
    let scopes = Fold es, outer, \|acc, e| Append acc, (ScopesOf e)
    Fold es, [[]], \|acc, e| match e.kind:
        EName n:
            let nkey = SNameKey n
            let hidden = Fold scopes, False, \|seen, ((names, r))| seen or ((HasText names, nkey) and r.start <= e.span.start and e.span.start < r.end)
            if (Len n.path) != 1 or hidden: acc else: AddText acc, nkey
        otherwise: acc

# The scopes an expression opens directly (its nested expressions open their own).
ScopesOf: unbounded fn Expr -> [(([Text], Range))]
fn ScopesOf e = match e.kind:
    ELambda ?ps, body:
        let names = Fold (Or ?ps, [[]]), [[]], \|acc, q| Append acc, (PatternNames q)
        let inner = match body:
            LbBlock b: BlockScopes b
            otherwise: [[]]
        Push inner, ((names, e.span))
    EMatch ignore, arms: Fold arms, [[]], \|acc, a|
        let names = match a.?pattern:
            ? q: PatternNames q
            nil: [[]]
        Append (Push acc, ((names, a.span))), (BlockScopes a.body)
    EIf c, t, ?el:
        let bound = match c:
            CondBind q, ignore, ignore: [[((PatternNames q, t.span))]]
            otherwise: [[]]
        let elseScopes = match ?el:
            ? b: BlockScopes b
            nil: [[]]
        Append (Append bound, (BlockScopes t)), elseScopes
    EFor ?binders, ignore, b:
        let names = match ?binders:
            ? fb: Append (PatternNames fb.first), (OptPatternNames fb.?second)
            nil: [[]]
        Push (BlockScopes b), ((names, b.span))
    ERebuild ignore, b: BlockScopes b
    EGiven b: BlockScopes b
    EUpdate ignore, b: BlockScopes b
    EWidgetBlock b: BlockScopes b
    EMonad ignore, b: BlockScopes b
    otherwise: [[]]

OptPatternNames: unbounded fn ?Pattern -> [Text]
fn OptPatternNames (? q) = PatternNames q
fn OptPatternNames nil = [[]]

# An inner block's names, each from its line to the block's end, and a local function's
# parameters over its clause.
BlockScopes: unbounded fn Block -> [(([Text], Range))]
fn BlockScopes b = Fold b.stmts, [[]], \|acc, s|
    let own = Push acc, ((Check.Blocks.GroupDefs s, Range(start=s.span.start, end=b.span.end)))
    match s.kind:
        SFn f: Push own, (((Fold f.params, [[]], \|ps, q| Append ps, (PatternNames q)), f.span))
        otherwise: own

# A local's copy that a closure captures (`x`), and a copy of that each call takes (`y`):
# names of their own, so no `let` rebinds a name from itself (pick UN).
CaptureName: fn Ex -> Text
fn CaptureName rs = "{PlaceStem rs}x"

CopyName: fn Ex -> Text
fn CopyName rs = "{PlaceStem rs}y"

# A local a loop's continuation takes from before the loop (`z`).
OuterName: fn Ex -> Text
fn OuterName rs = "{PlaceStem rs}z"

# The names a lambda's body reads from around it: none its parameters or an inner binder
# hides, so a parameter named as a local of the block is no capture.
LambdaReads: unbounded fn [Pattern], LambdaBody -> [Text]
fn LambdaReads ps, body:
    let own = Fold ps, [[]], \|acc, q| Append acc, (PatternNames q)
    Filter (FreeReads (LambdaExprs body), [[]]), \|n| not (HasText own, n)

# A lambda as a value: `Rc::new(move |..| ..)`, its captures cloned in first
# (claude/backend.md, "`fn a -> b` as a value").
LambdaValue: unbounded fn Lx, Env, Expr, [Pattern], LambdaBody -> Vl
fn LambdaValue lx, env, e, ps, body:
    let ft = OutTyOf lx, (Peel (TypeAt lx, e.span))
    match ft:
        OutJobFn a, ignore: JobLambda lx, env, ps, body, ft, a, (EntersLambda lx, e)
        otherwise: PlainLambda lx, env, ps, body, ft

LambdaCaptures: unbounded fn Env, [Text] -> (([Do], Env))
fn LambdaCaptures env, read:
    let caps0 = Filter read, \|n| match env.names[n]:
        ? (BnLocal ignore, ignore, ignore): True
        otherwise: False
    # An event the body reads as a value is its port, captured too; a hold or dynamic `let`
    # the body reads has its value at the build captured, for a supplier's dynamic answer
    # (round 3 DY).
    # and the live dynamics the block's line made (`WholeArgs`, `#whole{span}`): the body
    # may read one (`!Updated $state` as an event value, a call taking `$d` whole)
    let wholes = Filter (Keys env.names), \|n| HasPrefix n, "#whole"
    let caps1 = Append (Append (Append caps0, (Filter (Each read, \|n| "{n}#port"), \|n| HasKey env.names, n)), (Filter (Each read, \|n| "{n}#init"), \|n| HasKey env.names, n)), wholes
    # and a named bundle's value (`BundleValue`)
    let caps = Append caps1, (Filter (Each read, \|n| "{n}#value"), \|n| HasKey env.names, n)
    let ((dos, env1)) = Fold caps, (([[]], env)), \|((acc, en)), n| match env.names[n]:
        ? (BnLocal rs, mode, ct):
            let local = CaptureName rs
            let d = DoLet (PaBind local), (Own (LocalPlace rs, mode, ct))
            (((Push acc, d), (Bind en, n, (BnLocal (XVar local), Owned, ct))))
        otherwise: ((acc, en))
    ((dos, env1))

PlainLambda: unbounded fn Lx, Env, [Pattern], LambdaBody, OutTy -> Vl
fn PlainLambda lx, env, ps, body, ft:
    let pts = match ft:
        OutFn xs, ignore: xs
        otherwise: [[]]
    let ((dos, env1)) = LambdaCaptures env, (WithInstances env, (LambdaReads ps, body))
    let ((pas, env2)) = ClosureParams lx, env1, ps, pts, True
    let v = LambdaBodyValue (WholeLambda lx, pts), env2, body
    # Cast to its function type, so that two lambdas meet where one type is wanted (an
    # array's elements, an `if`'s or a `match`'s arms), each a closure type of its own.
    VlOwned (XBlock dos, (XCast (XCall (RefRuntime "std::Rc::new"), [[(XClosure True, pas, (Own v))]]), ft)), ft

# A lambda's parameter types, written on the closure so that rustc need not infer them
# from its use (`fold(&xs, &None, &(|found: &Option<T>, x: &A| ..))`); none when one is
# not known.
LambdaParamTys: unbounded fn Lx, Expr, Nat -> [OutTy]
fn LambdaParamTys lx, e, n:
    let ts = match OutTyOf lx, (Peel (TypeAt lx, e.span)):
        OutFn xs, ignore: xs
        OutJobFn a, ignore: match a:
            OutTuple xs: if n == 1: [[a]] else: xs
            otherwise: [[a]]
        otherwise: [[]]
    if (Len ts) == n and Fold ts, True, \|ok, t| ok and IsKnownTy t: ts else: [[]]

IsKnownTy: unbounded fn OutTy -> Bool
fn IsKnownTy t = match t:
    OutRefused ignore: False
    OutOpt x: IsKnownTy x
    OutRes x: IsKnownTy x
    OutArray x: IsKnownTy x
    OutRc x: IsKnownTy x
    OutMap k, v: (IsKnownTy k) and IsKnownTy v
    OutTuple xs: Fold xs, True, \|ok, x| ok and IsKnownTy x
    OutNamed ignore, xs: Fold xs, True, \|ok, x| ok and IsKnownTy x
    OutFn xs, r: (Fold xs, True, \|ok, x| ok and IsKnownTy x) and IsKnownTy r
    OutJobFn a, b: (IsKnownTy a) and IsKnownTy b
    otherwise: True

# A lambda of unbounded type as a value: a `Start` like a named unbounded function's
# (claude/backend.md), `Rc<dyn Fn(A) -> Rc<dyn Job<B>>>`, whose job is the lambda's body
# lowered as a job body (`once_job`): a call in it is a tail call or a frame, as in any
# job. The arguments come as one value, a tuple when there are several; each borrowed
# local the body reads is cloned in, and cloned again per call, since the body's job
# owns what it reads. A lambda whose own type is not bounded is `entered`: a call of it is
# a cycle point however it is reached (D6); a bounded lambda given where a `Start` is
# wanted answers in its first cycle.
JobLambda: unbounded fn Lx, Env, [Pattern], LambdaBody, OutTy, OutTy, Bool -> Vl
fn JobLambda lx, env, ps, body, ft, a, enter:
    let caps = Filter (WithInstances env, (LambdaReads ps, body)), \|n| match env.names[n]:
        ? (BnLocal ignore, ignore, ignore): True
        otherwise: False
    let ((dos, env1)) = Fold caps, (([[]], env)), \|((acc, en)), n| match env.names[n]:
        ? (BnLocal rs, mode, ct):
            let d = DoLet (PaBind (CaptureName rs)), (Own (LocalPlace rs, mode, ct))
            (((Push acc, d), (Bind en, n, (BnLocal (XVar (CaptureName rs)), Owned, ct))))
        otherwise: ((acc, en))
    # each call's own copy of what the lambda captured, which its job takes
    let ((again, envAgain)) = Fold caps, (([[]], env1)), \|((acc, en)), n| match env1.names[n]:
        ? (BnLocal rs, ignore, ct): (((Push acc, (DoLet (PaBind (CopyName rs)), (Own (LocalPlace rs, Owned, ct)))), (Bind en, n, (BnLocal (XVar (CopyName rs)), Owned, ct))))
        otherwise: ((acc, en))
    let pts = match a:
        OutTuple ts: if (Len ps) == 1: [[a]] else: ts
        otherwise: [[a]]
    # The body sees what it captured and its parameters, nothing borrowed from outside.
    let env1b = OnlyCaptured envAgain, caps
    # Each parameter arrives owned as `p{i}` and is taken apart in the body by its
    # pattern (`\|((en, s)), stmt|`), as any `let` would.
    let pos = Each (Range0 (Len ps)), \|i|
        let p = Or ps[i], dummyPat
        RustPat lx, p, (BinderTyOfPattern lx, p), Owned, "p{i}_"
    let unpack = Fold (Range0 (Len pos)), [[]], \|acc, i| match pos[i]:
        ? po: Append (Push acc, (DoLet po.pa, (XVar "p{i}"))), (Each po.conds, \|c| CondAsLet c)
        nil: acc
    # A name parameter's type is the `Start`'s (a function parameter is a `Start` there).
    let pos2 = Each (Range0 (Len pos)), \|i| match pos[i]:
        ? po: match (Or ps[i], dummyPat).kind:
            PName ignore: update po:
                &_.binds <= Each &_.binds, \|((n, b))| match b:
                    BnLocal rs, mode, bt: ((n, (BnLocal rs, mode, (Or pts[i], bt))))
                    otherwise: ((n, b))
            otherwise: po
        nil: PatOut(pa=PaWild, conds=[[]], binds=[[]])
    let env2 = Fold pos2, env1b, \|en, po| BindAll en, po.binds
    let names = Each (Range0 (Len ps)), \|i| "p{i}"
    let pa = if (Len ps) == 1: PaTyped (PaBind "p0"), a else: PaTyped (PaTuple (Each names, \|nm| PaBind nm)), a
    let tail0 = match body:
        LbExpr x: Tail lx, env2, x
        LbBlock bl: TailBlock lx, env2, bl
    let tail = if (Len unpack) == 0: tail0 else: XBlock unpack, tail0
    let job0 = XCall (HelperRef "once_job"), [[(XClosure True, [[]], tail)]]
    let job = if enter: XCall (HelperRef "entered"), [[job0]] else: job0
    let call = if (Len again) == 0: job else: XBlock again, job
    VlOwned (XBlock dos, (XCast (XCall (RefRuntime "std::Rc::new"), [[(XClosure True, [[pa]], call)]]), ft)), ft

# A local function that is not bounded as a value (`@Run Step, 3` over `fn Step` lines of
# the block): a `Start` as a job lambda is (`JobLambda`), its job the clauses as one job
# body, the arguments matched against each clause's patterns in order (`ClausesBody` over
# `TailBody`, as a named unbounded function's job is). Entering it is a cycle point (D6).
JobLocalFn: unbounded fn Lx, Env, [FnClause], OutTy, OutTy -> Vl
fn JobLocalFn lx, env, cs, ft, a:
    let first = Or cs[0], dummyClause
    let reads = Fold cs, [[]], \|acc, k| UnionTexts acc, (LambdaReads k.params, (ClauseLambdaBody k))
    let caps = Filter (WithInstances env, reads), \|n| match env.names[n]:
        ? (BnLocal ignore, ignore, ignore): True
        otherwise: False
    let ((dos, env1)) = Fold caps, (([[]], env)), \|((acc, en)), n| match env.names[n]:
        ? (BnLocal rs, mode, ct):
            let d = DoLet (PaBind (CaptureName rs)), (Own (LocalPlace rs, mode, ct))
            (((Push acc, d), (Bind en, n, (BnLocal (XVar (CaptureName rs)), Owned, ct))))
        otherwise: ((acc, en))
    # each call's own copy of what the function captured, which its job takes
    let ((again, envAgain)) = Fold caps, (([[]], env1)), \|((acc, en)), n| match env1.names[n]:
        ? (BnLocal rs, ignore, ct): (((Push acc, (DoLet (PaBind (CopyName rs)), (Own (LocalPlace rs, Owned, ct)))), (Bind en, n, (BnLocal (XVar (CopyName rs)), Owned, ct))))
        otherwise: ((acc, en))
    let count = Len first.params
    let argTys = match Peel (SubstTy lx, (TypeAt lx, first.span)):
        TyFn ignore, ps, ignore: ps
        otherwise: [[]]
    let owned = Each (Range0 count), \|i| "p{i}"
    let pa = if count == 1: PaTyped (PaBind "p0"), a else: PaTyped (PaTuple (Each owned, \|nm| PaBind nm)), a
    # the job owns its arguments; the clauses match them by reference, as a named
    # function's clauses match its parameters
    let borrowed = Each (Range0 count), \|i| DoLet (PaBind "argument{i}"), (XRef (XVar "p{i}"))
    let names = Each (Range0 count), \|i| (("argument{i}", True))
    let tail = XBlock borrowed, (ClausesBody lx, (OnlyCaptured envAgain, caps), cs, names, argTys, TailBody, "l{first.span.start}_", OutTurn)
    let job = XCall (HelperRef "entered"), [[(XCall (HelperRef "once_job"), [[(XClosure True, [[]], tail)]])]]
    let call = if (Len again) == 0: job else: XBlock again, job
    VlOwned (XBlock dos, (XCast (XCall (RefRuntime "std::Rc::new"), [[(XClosure True, [[pa]], call)]]), ft)), ft

# Whether a lambda's own checked type is not bounded (unbounded, or a color variable):
# entering it is a cycle point (D6).
EntersLambda: fn Lx, Expr -> Bool
fn EntersLambda lx, e = match Peel (TypeAt lx, e.span):
    TyFn CBound, ignore, ignore: False
    TyFn ignore, ignore, ignore: True
    otherwise: False

# An environment of only the locals a closure captured (its other borrowed locals cannot
# live in it); holds, dynamics and events stay.
OnlyCaptured: fn Env, [Text] -> Env
fn OnlyCaptured env, caps = update env:
    &_.names <= Fold (Keys env.names), {}, \|m, k| match env.names[k]:
        ? (BnLocal rs, mode, t): if (HasText caps, k) or mode == Owned: Insert m, k, (BnLocal rs, mode, t) else: m
        ? b: Insert m, k, b
        nil: m

# A condition a closure parameter's pattern leaves (a payload behind an `Rc`), as a
# `let` in the body: a parameter's pattern is irrefutable, so it holds.
CondAsLet: fn Cc -> Do
fn CondAsLet (CcLet pa, x) = DoLet pa, x
fn CondAsLet (CcIf x) = DoExpr (XUnit)

# A lambda passed to a parameter: a borrowed closure, its types from the parameter.
LambdaArg: unbounded fn Lx, Env, [Pattern], LambdaBody, [OutTy] -> Ex
fn LambdaArg lx, env, ps, body, pts:
    let ((pas, env2)) = ClosureParams lx, env, ps, pts, (Len pts) > 0
    let v = LambdaBodyValue (WholeLambda lx, pts), env2, body
    XClosure False, pas, (Own v)

# A lambda whose parameters are dynamics or events, or hold them, has them whole (an
# instantiation can make one so: `MapF (\|v| (Fst v) + 1), [[(($a, 1))]]`, gap LF): its body
# lifts by mapping them.
WholeLambda: fn Lx, [OutTy] -> Lx
fn WholeLambda lx, pts = if lx.whole or not (Fold pts, False, \|seen, t| seen or OutHasTime t): lx else: update lx:
    &_.whole <= True

OutHasTime: fn OutTy -> Bool
fn OutHasTime t = match t:
    OutDyn ignore: True
    OutEvent ignore: True
    OutRef x: OutHasTime x
    OutOpt x: OutHasTime x
    OutRes x: OutHasTime x
    OutArray x: OutHasTime x
    OutMap k, v: (OutHasTime k) or OutHasTime v
    OutTuple ts: Fold ts, False, \|seen, x| seen or OutHasTime x
    OutNamed ignore, ts: Fold ts, False, \|seen, x| seen or OutHasTime x
    otherwise: False

LambdaBodyValue: unbounded fn Lx, Env, LambdaBody -> Vl
fn LambdaBodyValue lx, env, (LbExpr x) = ValueOf lx, env, x
fn LambdaBodyValue lx, env, (LbBlock b) = BlockValue lx, env, b

# Closure parameters: irrefutable patterns, each a reference; typed when the closure is
# a value.
ClosureParams: unbounded fn Lx, Env, [Pattern], [OutTy], Bool -> (([Pa], Env))
fn ClosureParams lx, env, ps, pts, typed = Fold (Range0 (Len ps)), (([[]], env)), \|((acc, en)), i| match ps[i]:
    ? p:
        let po = RustPat lx, p, (BinderTyOfPattern lx, p), ByRef, "a{p.span.start}"
        let en2 = BindAll en, po.binds
        let pa = if typed: PaTyped po.pa, (OutRef (Or pts[i], (OutRefused "a parameter"))) else: po.pa
        (((Push acc, pa), en2))
    nil: ((acc, en))

BindAll: fn Env, [((Text, Bn))] -> Env
fn BindAll env, bs = Fold bs, env, \|en, ((n, b))| Bind en, n, b

# A pattern's type, as the checker recorded it for its binder or the pattern.
BinderTyOfPattern: fn Lx, Pattern -> Ty
fn BinderTyOfPattern lx, p = match p.kind:
    PName n: BinderTy lx, n.span
    otherwise: TypeAt lx, p.span

# `if c: a else: b`, and `if p <- e: ..` as a `match`.
IfValue: unbounded fn Lx, Env, Cond, Block, ?Block, OutTy -> Vl
fn IfValue lx, env, c, thenB, ?elseB, t:
    let elseV = match ?elseB:
        ? b: OwnAs t, (BlockValue lx, env, b)
        nil: XUnit
    match c:
        CondExpr x: VlOwned (XIf (AsBool (ValueOf lx, env, x)), (OwnAs t, (BlockValue lx, env, thenB)), elseV), t
        CondBind p, x, ?g:
            let sv = ValueOf lx, env, x
            let po = RustPat lx, p, (TypeAt lx, x.span), ByRef, "c{x.span.start}"
            let env2 = BindAll env, po.binds
            let guard = match ?g:
                ? ge: [[CcIf (AsBool (ValueOf lx, env2, ge))]]
                nil: [[]]
            let arm = XArm(pat=po.pa, conds=(Append po.conds, guard), body=(OwnAs t, (BlockValue lx, env2, thenB)))
            let other = XArm(pat=PaWild, conds=[[]], body=elseV)
            ArmsValue (Ref sv), [[arm, other]], "c{x.span.start}", t

# A `match` or an if-let chain over arms: `match` when every condition is a guard, the
# chain when one goes through an `Rc` (a Rust pattern cannot).
ArmsValue: fn Ex, [XArm], Text, OutTy -> Vl
fn ArmsValue scrut, arms, label, t:
    let chain = Fold arms, False, \|f, a| f or Fold a.conds, False, \|f2, c| f2 or IsLetCond c
    let guarded = Fold arms, False, \|f, a| f or (Len a.conds) > 0
    if chain: VlOwned (XChain label, scrut, arms, t), t
    else: VlOwned (XMatch scrut, arms, guarded, t), t

IsLetCond: fn Cc -> Bool
fn IsLetCond (CcLet ignore, ignore) = True
fn IsLetCond (CcIf ignore) = False

# `match s: arms` (a plain `match`; widget blocks lower theirs in the block's node).
MatchValue: unbounded fn Lx, Env, Expr, [Arm], OutTy, Range -> Vl
fn MatchValue lx, env, s, arms, t, span:
    let sv = ValueOf lx, env, s
    let sty = TypeAt lx, s.span
    let label = "m{span.start}"
    let byRef = Each (Range0 (Len arms)), \|i| ArmPat lx, (Or arms[i], dummyArm).?pattern, sty, ByRef, "{label}_{i}"
    let chain = Fold byRef, False, \|f, po| f or Fold po.conds, False, \|f2, c| f2 or IsLetCond c
    let owned = match sv:
        VlOwned ignore, ignore: not chain
        otherwise: False
    let pats = if owned: Each (Range0 (Len arms)), \|i| ArmPat lx, (Or arms[i], dummyArm).?pattern, sty, Owned, "{label}_{i}" else: byRef
    let xarms = Each (Range0 (Len arms)), \|i|
        let arm = Or arms[i], dummyArm
        let po = Or pats[i], (PatOut(pa=PaWild, conds=[[]], binds=[[]]))
        let env2 = BindAll env, po.binds
        let guard = match arm.?guard:
            ? ge: [[CcIf (AsBool (ValueOf lx, env2, ge))]]
            nil: [[]]
        let env3 = if owned: MovedOnce lx, env2, arm, po.binds else: env2
        XArm(pat=po.pa, conds=(Append po.conds, guard), body=(Own (BlockValue lx, env3, arm.body)))
    let scrut = if owned: Own sv else: Ref sv
    ArmsValue scrut, xarms, label, t

# Gap OC: a binder of an owned scrutinee that its arm's body reads once is moved there, not
# cloned: its one read is bound by its place to the binder as a value. Only where that is
# plain to see: the name once in the body's text and not in the guard's, and no lambda or
# loop in the body (a read there may run more than once, or outlive the arm).
MovedOnce: unbounded fn Lx, Env, Arm, [((Text, Bn))] -> Env
fn MovedOnce lx, env, arm, binds = Fold binds, env, \|en, ((nkey, bn))| match bn:
    BnLocal (XVar rs), Owned, bt: match ?OnlyRead lx, arm, nkey:
        ? x: BindSpan en, (PlaceKey lx, x.span), (VlOwned (XVar rs), bt)
        nil: en
    otherwise: en

?OnlyRead: unbounded fn Lx, Arm, Text -> ?Expr
fn ?OnlyRead lx, arm, nkey:
    let text = SrcText lx, lx.file, arm.body.span
    let inGuard = match arm.?guard:
        ? ge: (WordCount (SrcText lx, lx.file, ge.span), nkey) > 0
        nil: False
    let reads = Filter (BlockExprs arm.body), \|x| match x.kind:
        EName n: (Len n.path) == 1 and (SNameKey n) == nkey
        otherwise: False
    let plain = not inGuard and (WordCount text, nkey) == 1 and not (Contains text, "\\|") and (Len (Matches %/\b(while|for)\b/, text)) == 0
    if plain and (Len reads) == 1: reads[0] else: nil

# How often a name stands in a text as a whole word, its sigils included.
WordCount: fn Text, Text -> Nat
fn WordCount text, name = Len (Filter (Matches %/[?~$!@&]*[A-Za-z_][A-Za-z0-9_]*/, text), \|m| m.text == name)

let dummyArm = Arm(?pattern=nil, ?guard=nil, body=Block(stmts=[[]], inline=True, span=Range(start=0, end=0)), span=Range(start=0, end=0))

ArmPat: unbounded fn Lx, ?Pattern, Ty, Holding, Text -> PatOut
fn ArmPat lx, (? p), ty, mode, fresh = RustPat lx, p, ty, mode, fresh
fn ArmPat lx, nil, ty, mode, fresh = PatOut(pa=PaWild, conds=[[]], binds=[[]])

# A block of `let`s and a last expression, in page order (gap DG of the README: the
# group's dependency order is the checker's to give).
BlockValue: unbounded fn Lx, Env, Block -> Vl
fn BlockValue lx, env, b = if IsGivenBlock b.stmts: GivenValue lx, env, b, (BlockTy lx, b), b.span else: PlainBlockValue lx, env, b

# A block of binds and guards is a `given:` (Semantics ch. 4), whether or not the word is
# written: a function's body may be one.
IsGivenBlock: fn [Stmt] -> Bool
fn IsGivenBlock stmts = Fold stmts, False, \|f, s| f or IsGuardish s

IsGuardish: fn Stmt -> Bool
fn IsGuardish s = match s.kind:
    SBind ignore, ignore, nil: True
    SRequire ignore: True
    SForbid ignore: True
    otherwise: False

BlockTy: unbounded fn Lx, Block -> OutTy
fn BlockTy lx, b = match (Or b.stmts[Dec (Len b.stmts)], dummyStmtL).kind:
    SExpr x: OutTyOf lx, (Peel (TypeAt lx, x.span))
    otherwise: OutUnit

PlainBlockValue: unbounded fn Lx, Env, Block -> Vl
fn PlainBlockValue lx, env, b:
    let n = Len b.stmts
    let ((dos, env2, ?last)) = Fold (Range0 n), (([[]], env, nil)), \|((acc, en, ?lv)), i|
        let s = Or b.stmts[i], dummyStmtL
        if i + 1 == n: match s.kind:
            SExpr x: ((acc, en, ? (ValueOf lx, en, x)))
            otherwise:
                let ((more, en2)) = BlockStmt lx, en, s
                (((Append acc, more), en2, nil))
        else:
            let ((more, en2)) = BlockStmt lx, en, s
            (((Append acc, more), en2, ?lv))
    let last = Or ?last, (VlOwned (XUnit), OutUnit)
    if (Len dos) == 0: last
    else: VlOwned (XBlock dos, (Own last)), (ValueTy last)

let dummyStmtL = Stmt(kind=(SExpr (Expr(kind=EError, span=Range(start=0, end=0)))), span=Range(start=0, end=0))

# One statement of an expression block.
BlockStmt: unbounded fn Lx, Env, Stmt -> (([Do], Env))
fn BlockStmt lx, env, s = match s.kind:
    SLet p, ignore, x: match p.kind:
        PName n: match lx.gens[PlaceKey lx, n.span]:
            ? gn: GenericLet lx, env, n, gn, x
            nil: PlainLet lx, env, s, p, x
        otherwise: PlainLet lx, env, s, p, x
    SExpr x: (([[DoExpr (Own (ValueOf lx, env, x))]], env))
    SSignature ignore: (([[]], env))
    # a local function: inlined where it is called, a closure where it is a value
    SFn f: (([[]], (Bind env, (DefNameText f.name), (WithClause env, (DefNameText f.name), f))))
    otherwise: (([[InternalBugDo "a statement this back end does not lower yet"]], env))

# A generalized local `let` (pick LG): its value lowered once per distinct instantiation
# its uses have, each a binding of its own (`twin_fn_0`, `twin_fn_1`; one alone keeps the
# plain name), each use bound to its instantiation's. An instantiation is this one's (an
# enclosing generalized `let`'s) applied to what the use gives the variables. With no use
# there is nothing to lower.
GenericLet: unbounded fn Lx, Env, SName, GenNote, Expr -> (([Do], Env))
fn GenericLet lx, env, n, gn, x:
    let nkey = SNameKey n
    let distinct = Instantiations lx, gn
    let one = (Len distinct) == 1
    let rs = LocalNameAt lx, nkey, n.span
    Fold (Range0 (Len distinct)), (([[]], env)), \|((dos, en)), k|
        let ((tys, cols)) = Or distinct[k], (([[]], [[]]))
        let lxk = AtInstance lx, ((tys, cols))
        let rk = if one: rs else: "{rs}w{k}"
        let bkey = if k == 0: nkey else: "{nkey}#inst{k}"
        let bt = OutTyOf lxk, (Peel (BinderTy lxk, n.span))
        let v = ValueOf lxk, env, x
        let en1 = Bind en, bkey, (BnLocal (XVar rk), Owned, bt)
        let en2 = update en1:
            &_.uses <= Insert &_.uses, "{nkey}#{Show ((tys, cols))}", bkey
        let d = DoLet (PaBind rk), (Own v)
        (((Push dos, d), en2))

# The distinct instantiations a generalized `let`'s uses have, in page order. A use
# inside another generalized `let` (`Take` used in `Builder`) may be at that one's
# variables: it stands for each of that one's instantiations.
Instantiations: unbounded fn Lx, GenNote -> [(([((Text, Ty))], [((Text, Col))]))]
fn Instantiations lx, gn = Fold (Or lx.insts[GenKey gn], [[]]), [[]], \|acc, u|
    Fold (Expanded lx, (InstAt lx, u)), acc, \|a, i| if Fold a, False, \|seen, j| seen or (Show j) == (Show i): a else: Push a, i

Expanded: unbounded fn Lx, (([((Text, Ty))], [((Text, Col))])) -> [(([((Text, Ty))], [((Text, Col))]))]
fn Expanded lx, i = match ?OpenQ lx, i:
    nil: [[i]]
    ? q: match lx.genOfQ[q]:
        ? g: Fold (Instantiations lx, g), [[]], \|acc, gi|
            let lx2 = AtInstance lx, gi
            Append acc, (Expanded lx2, (SubstInst lx2, i))
        nil: [[i]]

SubstInst: fn Lx, (([((Text, Ty))], [((Text, Col))])) -> (([((Text, Ty))], [((Text, Col))]))
fn SubstInst lx, ((tys, cols)):
    let tys2 = Each tys, \|((q, t))| ((q, (SubstTy lx, t)))
    let cols2 = Each cols, \|((q, c))| ((q, (InstCol lx, c)))
    ((tys2, cols2))

# The first quantified variable an instantiation still has that no instantiation being
# lowered gives.
?OpenQ: unbounded fn Lx, (([((Text, Ty))], [((Text, Col))])) -> ?Text
fn ?OpenQ lx, ((tys, cols)):
    let fromCols = Fold cols, [[]], \|acc, ((ignore, c))| Append acc, (OpenCols lx, c)
    let all = Fold tys, fromCols, \|acc, ((ignore, t))| Append acc, (OpenTyQs lx, t)
    all[0]

OpenCols: fn Lx, Col -> [Text]
fn OpenCols lx, (CQ q) = if (HasKey lx.genOfQ, q) and not (HasKey lx.csubst, q): [[q]] else: [[]]
fn OpenCols lx, c = [[]]

OpenTyQs: unbounded fn Lx, Ty -> [Text]
fn OpenTyQs lx, t = match t:
    TyFlex n: if (HasKey lx.genOfQ, "'{n}") and not (HasKey lx.subst, "'{n}"): [["'{n}"]] else: [[]]
    TyFn c, ps, res: Fold (Push ps, res), (OpenCols lx, c), \|acc, x| Append acc, (OpenTyQs lx, x)
    TyCon ignore, args: Fold args, [[]], \|acc, x| Append acc, (OpenTyQs lx, x)
    TyTuple ts: Fold ts, [[]], \|acc, x| Append acc, (OpenTyQs lx, x)
    TyArray e: OpenTyQs lx, e
    TyMap k, v: Append (OpenTyQs lx, k), (OpenTyQs lx, v)
    TySig ignore, i: OpenTyQs lx, i
    TyAt i, ignore: OpenTyQs lx, i
    TyElem ignore, o: OpenTyQs lx, o
    TyAssoc ignore, ignore, a: OpenTyQs lx, a
    otherwise: [[]]

# Lowering at an instantiation: its variables' types and colors in the substitution.
AtInstance: fn Lx, (([((Text, Ty))], [((Text, Col))])) -> Lx
fn AtInstance lx, ((tys, cols)) = update lx:
    &_.subst <= Fold tys, &_.subst, \|m, ((q, t))| Insert m, q, t
    &_.csubst <= Fold cols, &_.csubst, \|m, ((q, c))| Insert m, q, c

# A widget block's `let` (a node's field, of one type): a generalized one is lowered at
# its uses' instantiation when they have one; at several it is a field per instantiation
# (`?ManyInstances`).
WidgetLetLx: unbounded fn Lx, Range -> Lx
fn WidgetLetLx lx, span = match lx.gens[PlaceKey lx, span]:
    ? gn: match Instantiations lx, gn:
        [[i]]: AtInstance lx, i
        otherwise: lx
    nil: lx

# A use's instantiation at the one being lowered: each variable's type and color.
InstAt: fn Lx, InstNote -> (([((Text, Ty))], [((Text, Col))]))
fn InstAt lx, u:
    let tys = Each u.tys, \|((q, t))| ((q, (SubstTy lx, t)))
    let cols = Each u.cols, \|((q, c))| ((q, (InstCol lx, c)))
    ((tys, cols))

GenKey: fn GenNote -> Text
fn GenKey gn = Or (Append gn.tys, gn.cols)[0], ""

InstKey: fn InstNote -> Text
fn InstKey u = Or (Append (Each u.tys, \|((q, ignore))| q), (Each u.cols, \|((q, ignore))| q))[0], ""

ColName: fn Col -> Text
fn ColName (CQ q) = q
fn ColName c = ""

PlainLet: unbounded fn Lx, Env, Stmt, Pattern, Expr -> (([Do], Env))
fn PlainLet lx, env, s, p, x:
        let v = ValueOf lx, env, x
        let po = RustPat lx, p, (TypeAt lx, x.span), Owned, "l{s.span.start}"
        (([[(DoLet po.pa, (Own v))]], (BindAll env, po.binds)))
