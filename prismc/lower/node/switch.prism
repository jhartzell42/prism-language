# ---------------------------------------------------------------------------------------
# `rebuild` and `@Switch` (claude/backend.md, "Dynamic structure"; Compiler ch. 3)
# ---------------------------------------------------------------------------------------

# A row's environments from its block's: `_` the generation's value (or the `for` entry),
# and each event of the block the row's body names a source of the row, fed by the
# block's port for it.
RowEnv: unbounded fn Wx, Wx, Env, Block -> ((Wx, Wx, Env))
fn RowEnv parent, rowWx, menv, body = RowEnvNames parent, rowWx, menv, (ReadNames (BlockExprs body))

# The names a row reads, closed over the block's local functions and local widgets: one
# the row calls or applies is lowered in the row, so what its body reads the row reads.
RowNamesClosed: unbounded fn Env, [Text] -> [Text]
fn RowNamesClosed menv, names:
    let more0 = Fold names, names, \|acc, n| match menv.names[n]:
        ? (BnLocalWidget b): UnionTexts acc, (ReadNames (BlockExprs b))
        ? (BnLocalFn cs): Fold cs, acc, \|a, c| UnionTexts a, (ReadNames (ClauseExprs c))
        otherwise: acc
    # an element a `let` of the block names, placed in the row (`WithElementLets`): what
    # its fields read
    let more1 = Fold names, more0, \|acc, n| match menv.names["{n}#element"]:
        ? (BnWidget x, ignore, ignore, ignore): UnionTexts acc, (ReadNames (ExprsIn x))
        otherwise: acc
    # and a blueprint a `let` of the block names, built in the row: what it reads
    let more = Fold names, more1, \|acc, n| match menv.names["{n}#blueprint"]:
        ? (BnWidget x, ignore, ignore, ignore): UnionTexts acc, (ReadNames (ExprsIn x))
        otherwise: acc
    if (Len more) == (Len names): names else: RowNamesClosed menv, more

ClauseExprs: unbounded fn FnClause -> [Expr]
fn ClauseExprs c = match c.body:
    BodyBlock b: BlockExprs b
    BodyExpr x: ExprsIn x

# `RowEnv` over the names read. A local function and a local widget of the block are the
# row's as they are the block's. A widget parameter's argument is the caller's text with
# the caller's environments: applied in the row it is lowered there, so its environments
# are the row's view of the caller's (the caller's events through ports of the row, its
# values and dynamics through the parent).
RowEnvNames: unbounded fn Wx, Wx, Env, [Text] -> ((Wx, Wx, Env))
fn RowEnvNames parent, rowWx, menv, written:
    let names = RowNamesClosed menv, written
    let elements0 = Fold names, (WholeOfBlock menv, emptyEnv, False), \|en, n| match menv.names["{n}#element"]:
        ? held: Bind en, "{n}#element", held
        nil: en
    let elements = Fold names, elements0, \|en, n| match menv.names["{n}#blueprint"]:
        ? held: Bind en, "{n}#blueprint", held
        nil: en
    Fold names, ((parent, rowWx, elements)), \|((p, r, env)), n| match menv.names[n]:
        ? (BnLocal rs, mode, t): ((p, r, (Bind env, n, (BnLocal (OverParent rs), Owned, t))))
        ? (BnLocalWidget b): ((p, r, (Bind env, n, (BnLocalWidget b))))
        ? (BnLocalFn cs): ((p, r, (Bind env, n, (BnLocalFn cs))))
        ? (BnWidget x, ignore, cmenv, clx):
            let ((p2, r2, inner)) = RowEnvNames p, r, cmenv, (ReadNames (ExprsIn x))
            ((p2, r2, (Bind env, n, (BnWidget x, (BuildSpelling inner), inner, clx))))
        ? (BnEv er, t):
            let pname = (GnOf p, er.node).name
            let ((rs, r1)) = FreshName r, (Snake n)
            let ((id, r2)) = AddGn r1, rs, t, GnPort, 0
            let r3 = update r2:
                &_.subs <= Push &_.subs, ((pname, rs, t))
            let p2 = if HasText p.ports, pname: p else: Connect (WithPort p, pname), (EvRefOf p, er.node), (SkPort pname)
            ((p2, r3, (Bind env, n, (BnEv (EvRefOf r3, id), t))))
        # The block's dynamics and holds, read through the parent at the row's read point,
        # each a `ParentRead` in what it reads, so a generation's place that reads one is
        # live and the block's writes of it mark the generation (gap DY).
        ? (BnDyn (XMethod recv, m, xs), ignore, t):
            if recv == (XSelf): ((p, r, (Bind env, n, (BnDyn (XMethod parentRef, m, xs), [[ParentRead m]], t))))
            else: RowParamEnv p, r, env, menv, n
        ? (BnDyn ignore, ignore, ignore): RowParamEnv p, r, env, menv, n
        ? (BnHold f, t): ((p, r, (Bind env, n, (BnDyn (XMethod (XField parentRef, f), "get", [[XCx]]), [[ParentRead f]], t))))
        # a bundle the block names whole: each part as the block's name of its kind is
        ? (BnParts bs):
            let ((p2, r2, over)) = RowPartsBn p, r, n, bs
            ((p2, r2, (Bind env, n, (BnParts over))))
        otherwise: ((p, r, env))

# A named bundle's parts as a row reads them (`RowEnvNames`): a plain part and a dynamic
# of the block's own through the parent, an event through a port of the row.
RowPartsBn: unbounded fn Wx, Wx, Text, [?Bn] -> ((Wx, Wx, [?Bn]))
fn RowPartsBn parent, rowWx, n, parts = Fold parts, ((parent, rowWx, [[]])), \|((p, r, acc)), ?b|
    let ((p2, r2, ?over)) = RowPartBn p, r, "{n}_{Len acc}", ?b
    ((p2, r2, (Append acc, [[?over]])))

RowPartBn: unbounded fn Wx, Wx, Text, ?Bn -> ((Wx, Wx, ?Bn))
fn RowPartBn p, r, n, ?b = match ?b:
    ? (BnLocal rs, mode, t): ((p, r, (? (BnLocal (OverParent rs), Owned, t))))
    # (a bundle's event part is bound with no type of its own, `BundleBn`: the type is
    # its node's in the block)
    ? (BnEv er, ignore):
        let pname = (GnOf p, er.node).name
        let t = (GnOf p, er.node).ty
        let ((rs, r1)) = FreshName r, (Snake n)
        let ((id, r2)) = AddGn r1, rs, t, GnPort, 0
        let r3 = update r2:
            &_.subs <= Push &_.subs, ((pname, rs, t))
        let p2 = if HasText p.ports, pname: p else: Connect (WithPort p, pname), (EvRefOf p, er.node), (SkPort pname)
        ((p2, r3, (? (BnEv (EvRefOf r3, id), t))))
    ? (BnDyn ex, rds, t):
        if (OnSelfRooted ex) and Fold rds, True, \|f, rd| f and IsOwnRead rd: ((p, r, (? (BnDyn (OverParent ex), (Each rds, \|rd| AsParentRead rd), t))))
        else: ((p, r, (? (BnLocal (Refusal "a dynamic part of a named bundle read by a row of a row, which stands on no node of the row's block"), Owned, t))))
    ? (BnHold f, t): ((p, r, (? (BnDyn (XMethod (XField parentRef, f), "get", [[XCx]]), [[ParentRead f]], t))))
    ? (BnParts bs):
        let ((p2, r2, over)) = RowPartsBn p, r, n, bs
        ((p2, r2, (? (BnParts over))))
    otherwise: ((p, r, nil))

# The block's live dynamics (`WholeArgs`, bound under `#whole{span}` for every reader its
# lines pass whole, the lines of its rows' bodies too) as a row reads them: the block's
# fields through the row's `parent`, in the row's methods, or through its `parent`
# argument in its build (`build`).
WholeOfBlock: fn Env, Env, Bool -> Env
fn WholeOfBlock menv, env, build = Fold (Keys menv.names), env, \|en, k| if not (HasPrefix k, "#whole"): en else: match menv.names[k]:
    ? (BnLocal rs, mode, t):
        let over = OverParent rs
        if not build: Bind en, k, (BnLocal over, Owned, t)
        else: match ?ThroughParent over:
            ? x: Bind en, k, (BnLocal x, Owned, t)
            nil: en
    otherwise: en

# A widget parameter's dynamic as a row reads it: through its getter (`BindParam`).
RowParamEnv: fn Wx, Wx, Env, Env, Text -> ((Wx, Wx, Env))
fn RowParamEnv p, r, env, menv, n = match menv.names["{n}#row"]:
    ? (BnDyn (XMethod ignore, m, xs), ignore, t): ((p, r, (Bind env, n, (BnDyn (XMethod parentRef, m, xs), [[ParentRead m]], t))))
    # any other dynamic that stands on the block's own node (a hold that starts from a
    # late result, `PreBindName`): the same expression through the parent
    otherwise: match menv.names[n]:
        ? (BnDyn ex, rds, t) if (OnSelfRooted ex) and Fold rds, True, \|f, rd| f and IsOwnRead rd: ((p, r, (Bind env, n, (BnDyn (OverParent ex), (Each rds, \|rd| AsParentRead rd), t))))
        otherwise: ((p, r, env))

# A place of the block as a row's methods read it: through the parent (a row of a row reads
# its own parent's places through that row's parent in turn).
OverParent: fn Ex -> Ex
fn OverParent x = match x:
    XSelf: parentRef
    XField y, f: XField (OverParent y), f
    XFieldOf y, o, f: XFieldOf (OverParent y), o, f
    XPart y, k: XPart (OverParent y), k
    XMethod y, m, xs: XMethod (OverParent y), m, xs
    XUpgrade y: XUpgrade (OverParent y)
    otherwise: XField parentRef, (PlaceStem x)

# The block, as a row's methods read it through the row's `parent` field, and as the
# row's build reads it through its `parent` argument.
let parentRef = XMethod (XUpgrade (XField XSelf, "parent")), "expect", [[XStr "the block outlives its rows"]]
let parentArg = XMethod (XUpgrade (XVar "parent")), "expect", [[XStr "the block outlives its rows"]]

WithPort: fn Wx, Text -> Wx
fn WithPort wx, pname = update wx:
    &_.ports <= Push &_.ports, pname

RebuildLine: unbounded fn Wx, Env, Env, Expr, Block, Expr, ?Bn -> ((Wx, Wres))
fn RebuildLine wx, benv, menv, scrut, body, e, ?bound:
    let lx = wx.lx
    let pos = wx.pos
    let wx1 = update wx:
        &_.pos <= NextPos &_.pos
    let ((srcEx, reads)) = DynamicExpr wx1, menv, scrut
    let vt = OutTyOf lx, (Peel (TypeAt lx, scrut.span))
    let ((name, wx2)) = FreshName wx1, "generation"
    if GivesDynamic (TypeAt lx, e.span): RebuildDynamic wx2, menv, body, srcEx, reads, vt, name, pos
    else:
        let ((upId, wx3)) = match ?bound:
            ? (BnEv er, ignore): ((er.node, wx2))
            otherwise: AddGn wx2, "{name}_fired", (OutTyOf lx, (Peel (TypeAt lx, e.span))), GnNamed, 0
        let ((cases, wx4)) = GenCases wx3, menv, body, vt, name
        let rowDefs = Each cases, \|c| c.node
        let select = GenSelect wx4, menv, body, cases, pos, [[]], True
        let wx5 = update wx4:
            &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, at=(PlaceAt wx, "self", pos), source=srcEx, valueTy=vt, select=select, transparent=False, width=0, moved=(Or (?HostedRows wx), ""), early=False, gappy=False, rebased=False)
            &_.genHolds <= Push &_.genHolds, ((name, reads))
            &_.rows <= Fold rowDefs, &_.rows, \|acc, rd| Append (Push acc, rd), rd.children
            &_.getters <= Push &_.getters, (GenUp name, (GnOf wx4, upId).name, (GnOf wx4, upId).ty)
        ((wx5, (WrEv (EvRefOf wx5, upId))))

# Whether a `rebuild` hands back a dynamic: `$$a` (its generations give `$a`), or `$a` over
# a plain result, rather than an event, `$!a`, or nothing.
GivesDynamic: fn Ty -> Bool
fn GivesDynamic t = match t:
    TySig "$", (TySig "$", ignore): True
    TySig "$", (TySig "!", ignore): False
    TySig "$", (TyCon "unit", [[]]): False
    TySig "$", ignore: True
    TyAt i, ignore: GivesDynamic i
    otherwise: False

# A `rebuild` that hands back a dynamic (Semantics ch. 7): the current generation's result
# as a `Dynamic` (`result_dynamic`), a structural dynamic of the block (pick ST). The build
# keeps the newborn generation's dynamic in `{name}_result_live` and marks the snapshot,
# which the construction step takes after the generation is built, so the `rebuild`'s
# dynamic `{name}_result` takes the newborn's result one tick behind and is published the
# tick after; `@Flatten` adopts it from there (`FlattenLine`). A generation whose own hold
# behind its result is written tells the block through `{name}_result_moved`.
RebuildDynamic: unbounded fn Wx, Env, Block, Ex, [Read], OutTy, Text, Pos -> ((Wx, Wres))
fn RebuildDynamic wx, menv, body, srcEx, reads, vt, name, pos:
    let rowName = "{wx.node}Gen{RowSuffix wx}"
    let whole = GenRowOf wx, menv, body, vt, rowName, name
    # the rebuild's dynamic holds the generation's dynamic result, or its plain one
    let ?shape = match whole.?dynResult:
        ? rt: ? (((OutDyn rt), "result_dynamic"))
        nil: match whole.?plainResult:
            ? rt: ? ((rt, "result_value"))
            nil: nil
    match ?shape:
        nil:
            let wx2 = update whole.parent:
                &_.build <= Push &_.build, (RefusalDo "a `rebuild` whose generation gives a dynamic it does not lower")
            ((wx2, WrUnit))
        ? ((dynTy, taken)):
            let result = "{name}_result"
            let live = "{result}_live"
            let what = "the dynamic of the `rebuild` at place {PlaceText pos}"
            let tail = Append (Append [[(XWeak XSelf)]], (HostedPassed wx)), [[XCx]]
            let built = TryOf (XCall (RefChild (SiteRef wx.lx, whole.node.name), "build"), (Append [[(XVar "path"), (XVar "value")]], tail))
            let kept = DoAssign (XDeref (XMethod (XField XSelf, live), "borrow_mut", [[]])), (XCtor (RefRuntime "std::Some"), [[(XMethod (XVar "row"), taken, [[]])]])
            let marked = DoExpr (XMethod (XField XSelf, "{result}_snap"), "mark", [[XCx]])
            let select = XBlock [[(DoLet (PaBind "row"), built), kept, marked]], (XVar "row")
            let current = XMethod (XClone (XMethod (XField XSelf, "{live}"), "borrow", [[]])), "expect", [[(XStr "a `rebuild` has a generation from its build on")]]
            let wx2 = update whole.parent:
                &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, at=(PlaceAt wx, "self", pos), source=srcEx, valueTy=vt, select=select, transparent=False, width=0, moved=(Or (?HostedRows wx), ""), early=False, gappy=False, rebased=False)
                &_.genHolds <= Push &_.genHolds, ((name, reads))
                &_.rows <= Append (Push &_.rows, whole.node), whole.node.children
                &_.taken <= Append &_.taken, [[result, live, "{result}_now", "{result}_snap", "{result}_publish", "{result}_moved"]]
                &_.fields <= Append &_.fields, [[((live, (OutCell (OutOpt dynTy)), "the current generation's result, which the snapshot of the `rebuild`'s dynamic is taken from")), (("{result}_snap", (OutSnapshot dynTy), "the `rebuild` at place {PlaceText pos}'s dynamic, structural: its snapshots, the generations' results and the lagged dynamic (pick ST)"))]]
                &_.moves <= Push &_.moves, ((live, (XCall (RefRuntime "std::RefCell::new"), [[XNone]])))
                &_.inits <= Push &_.inits, (("{result}_snap", (XCall (RefRuntime "rt::Snapshot::new"), [[XStr what]])))
                &_.getters <= Append &_.getters, [[(MethDef(name="{result}_now", recv=RecvRef, params=[[]], cx=CxRef, ret=dynTy, body=[[]], tail=current, doc="The current generation's result: what the snapshot of the `rebuild`'s dynamic is taken from (pick ST).")), (SnapGetter result, dynTy, "The `rebuild`'s dynamic, its generation's result, a structural dynamic (pick ST): one tick behind the generations, the snapshot of the tick before the tick the read point is after.")]]
                &_.snaps <= Push &_.snaps, SnapDef(name=result, live="{result}_now", ty=dynTy, eq=False, builder=name, before=False, what=what)
            ((wx2, (WrDyn (XMethod (XSelf), result, [[XCx]]), [[OwnRead result]], dynTy)))

# A widget of several clauses in a static position (Semantics ch. 8): the clause is chosen
# at the build from the arguments, which are plain, so it is a generation built once (its
# source, the first argument, never changes), each clause a row (`ClauseRowOf`). The
# generation is transparent: its node stands at the caller's path and its places take the
# caller's positions from the call's on, as an inlined widget's do, the caller forwarding
# the World's answers there to it. Clauses with different numbers of places take the
# widest one's positions, so the caller's later places have one position whichever clause
# is chosen (pick CS).
ClauseWidgetLine: unbounded fn Wx, Env, Env, Expr, Block, Text, ValInfo, Expr, [Arg] -> ((Wx, Wres))
fn ClauseWidgetLine wx, benv, menv, scrut, call, qk, v, e, args:
    let lx = wx.lx
    let outTy = OutTyOf lx, (OutOf (TypeAt lx, e.span))
    let layer = ResultLayer (TypeAt lx, e.span)
    if IsBundle (LineOutFull lx, e): BundleClauseLine wx, menv, scrut, call, qk, v, e
    else: if layer == LyPlain and outTy != OutUnit: EarlyClauseLine wx, benv, menv, scrut, qk, v, e, args, outTy
    else: if layer == LyDyn: DynClauseLine wx, menv, scrut, call, qk, v, e
    else: StaticClauseLine wx, menv, scrut, call, qk, v, e

# The layer of what a line gives: a blueprint's output's, or the value's own.
ResultLayer: fn Ty -> Layer
fn ResultLayer t = match t:
    TyAt i, ignore: LayerOf i
    otherwise: LayerOf t

# A static widget of several clauses whose result is a dynamic (Semantics ch. 4 and 8: the
# clause's `@ $d` is the caller's binding, a dynamic it reads and follows): the generation
# is built as a static one is (`StaticClauseLine`), after the block's node; the row the
# arguments choose hands its `result_dynamic` to the block, which keeps it in `{name}_res`
# and reads it at the read point through the line's getter. A write behind it in the row
# calls the block's `{name}_result_moved`, which marks the block's readers of it, in that
# tick; a write of the block's own behind it marks them as any write of the block's does.
DynClauseLine: unbounded fn Wx, Env, Expr, Block, Text, ValInfo, Expr -> ((Wx, Wres))
fn DynClauseLine wx, menv, scrut, call, qk, v, e:
    let lx = wx.lx
    let pos = wx.pos
    let callArgs = match ?ClauseCall lx, call:
        ? ((ignore, xs)): xs
        nil: [[]]
    let ((srcEx, reads)) = DynamicExpr wx, menv, scrut
    let vt = OutTyOf lx, (Peel (TypeAt lx, scrut.span))
    let ((name, wx1)) = FreshName wx, "generation"
    let res = "{name}_res"
    let clauses = ClausesOf lx.g, qk
    let rowName = "{wx.node}Gen{RowSuffix wx}"
    let ((rows, wx2)) = Fold (Range0 (Len clauses)), (([[]], wx1)), \|((acc, w)), i|
        let c = Or clauses[i], dummyClause
        let cr = ClauseRowOf w, menv, c, v, "{rowName}{i}", name, True, (OutWeak wx.node), callArgs, False
        (((Push acc, cr), cr.parent))
    let width = Fold rows, 0, \|acc, cr| Max acc, cr.width
    let cases = Each rows, \|cr| cr.case
    let rowObj = OutObj (OutNamed (RefRuntime "rt::Row"), [[]])
    # the arguments as the block's methods read them: `_`, in a generation's row, is the
    # row's own value
    let scrutEx = ClauseScrutinee lx, menv, v, callArgs
    let tail = Append (Append [[(XWeak XSelf)]], (HostedPassed wx)), [[XCx]]
    let gaps = RowGaps rows, width
    let arms = Fold cases, [[]], \|built, c|
        let i = Len built
        let made = TryOf (XCall (RefChild (SiteRef lx, c.node.name), "build"), (Append (Append [[(XClone (XVar "path"))]], c.passed), tail))
        let kept = DoAssign (XDeref (XMethod (XField XSelf, res), "borrow_mut", [[]])), (XCtor (RefRuntime "std::Some"), [[(XMethod (XVar "row"), "result_dynamic", [[]])]])
        Push built, (XArm(pat=c.pat, conds=c.conds, body=(XBlock (Append [[(DoLet (PaBind "row"), made), kept]], (GapSet name, (Or gaps[i], nil))), (XCast (XVar "row"), rowObj))))
    let select = WithRowBase wx, "self", pos, (Own (ArmsValue scrutEx, arms, "'select", rowObj))
    let wx3 = update wx2:
        &_.pos <= Pos(scope=pos.scope, at=pos.at + width)
        &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, at=(PlaceAt wx, "self", pos), source=srcEx, valueTy=vt, select=select, transparent=True, width=width, moved=(Or (?HostedRows wx), ""), early=False, gappy=(IsGappy gaps), rebased=False)
        &_.genHolds <= Push &_.genHolds, ((name, reads))
        &_.rows <= Fold cases, &_.rows, \|acc, gc| Append (Push acc, gc.node), gc.node.children
    KeptDynResult wx3, name, rows

# A static widget of several clauses whose clauses end on a bundle (Type System ch. 2,
# "Bundles and sparse tuples"; Semantics ch. 8: the left side of `<-` is a pattern for the
# output): the generation is built as a static one is, after the block's node, and the row
# the arguments choose hands the block its bundle part by part (`RowPartsOut`,
# `KeepParts`): an event part fires the block's event, a dynamic part is kept and read
# through its getter, a plain part is late.
BundleClauseLine: unbounded fn Wx, Env, Expr, Block, Text, ValInfo, Expr -> ((Wx, Wres))
fn BundleClauseLine wx, menv, scrut, call, qk, v, e:
    let lx = wx.lx
    let pos = wx.pos
    let callArgs = match ?ClauseCall lx, call:
        ? ((ignore, xs)): xs
        nil: [[]]
    let ((srcEx, reads)) = DynamicExpr wx, menv, scrut
    let vt = OutTyOf lx, (Peel (TypeAt lx, scrut.span))
    let ((name, wx1)) = FreshName wx, "generation"
    let clauses = ClausesOf lx.g, qk
    let rowName = "{wx.node}Gen{RowSuffix wx}"
    let ((rows, wx2)) = Fold (Range0 (Len clauses)), (([[]], wx1)), \|((acc, w)), i|
        let c = Or clauses[i], dummyClause
        let cr = ClauseRowOf w, menv, c, v, "{rowName}{i}", name, True, (OutWeak wx.node), callArgs, False
        (((Push acc, cr), cr.parent))
    let width = Fold rows, 0, \|acc, cr| Max acc, cr.width
    let cases = Each rows, \|cr| cr.case
    let rowObj = OutObj (OutNamed (RefRuntime "rt::Row"), [[]])
    let kept = KeepParts wx2, name, (RowsBundle rows), (BundlePartTys (LineOutFull lx, e))
    let scrutEx = ClauseScrutinee lx, menv, v, callArgs
    let tail = Append (Append [[(XWeak XSelf)]], (HostedPassed wx)), [[XCx]]
    let gaps = RowGaps rows, width
    let arms = Fold cases, [[]], \|built, c|
        let i = Len built
        let made = TryOf (XCall (RefChild (SiteRef lx, c.node.name), "build"), (Append (Append [[(XClone (XVar "path"))]], c.passed), tail))
        Push built, (XArm(pat=c.pat, conds=c.conds, body=(XBlock (Append (Append [[(DoLet (PaBind "row"), made)]], kept.keeps), (GapSet name, (Or gaps[i], nil))), (XCast (XVar "row"), rowObj))))
    let select = WithRowBase wx, "self", pos, (Own (ArmsValue scrutEx, arms, "'select", rowObj))
    let wx3 = update kept.wx:
        &_.pos <= Pos(scope=pos.scope, at=pos.at + width)
        &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, at=(PlaceAt wx, "self", pos), source=srcEx, valueTy=vt, select=select, transparent=True, width=width, moved=(Or (?HostedRows wx), ""), early=False, gappy=(IsGappy gaps), rebased=False)
        &_.genHolds <= Push &_.genHolds, ((name, reads))
        &_.rows <= Fold cases, &_.rows, \|acc, gc| Append (Push acc, gc.node), gc.node.children
    ((wx3, (WrParts kept.results)))

StaticClauseLine: unbounded fn Wx, Env, Expr, Block, Text, ValInfo, Expr -> ((Wx, Wres))
fn StaticClauseLine wx, menv, scrut, call, qk, v, e:
    let lx = wx.lx
    let callArgs = match ?ClauseCall lx, call:
        ? ((ignore, xs)): xs
        nil: [[]]
    let pos = wx.pos
    let ((srcEx, reads)) = DynamicExpr wx, menv, scrut
    let vt = OutTyOf lx, (Peel (TypeAt lx, scrut.span))
    let ((name, wx1)) = FreshName wx, "generation"
    # what the call gives when built: the type at `e` is the blueprint's where the call is an
    # `if` arm's value (gap AW), its output where a bind takes it
    let ((upId, wx2)) = AddGn wx1, "{name}_fired", (OutTyOf lx, (OutOf (TypeAt lx, e.span))), GnNamed, 0
    let clauses = ClausesOf lx.g, qk
    let rowName = "{wx.node}Gen{RowSuffix wx}"
    let ((rows, wx3)) = Fold (Range0 (Len clauses)), (([[]], wx2)), \|((acc, w)), i|
        let c = Or clauses[i], dummyClause
        let cr = ClauseRowOf w, menv, c, v, "{rowName}{i}", name, True, (OutWeak wx.node), callArgs, False
        (((Push acc, cr), cr.parent))
    # clauses of different widths take the widest one's positions (pick CS)
    let width = Fold rows, 0, \|acc, cr| Max acc, cr.width
    let cases = Each rows, \|cr| cr.case
    let gaps = RowGaps rows, width
    let select = WithRowBase wx, "self", pos, (GenSelect wx3, menv, call, cases, pos, (Each gaps, \|?g| GapSet name, ?g), False)
    let wx4 = update wx3:
        &_.pos <= Pos(scope=pos.scope, at=pos.at + width)
        &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, at=(PlaceAt wx, "self", pos), source=srcEx, valueTy=vt, select=select, transparent=True, width=width, moved=(Or (?HostedRows wx), ""), early=False, gappy=(IsGappy gaps), rebased=False)
        &_.genHolds <= Push &_.genHolds, ((name, reads))
        &_.rows <= Fold cases, &_.rows, \|acc, gc| Append (Push acc, gc.node), gc.node.children
        &_.getters <= Push &_.getters, (GenUp name, (GnOf wx3, upId).name, (GnOf wx3, upId).ty)
    # a widget of `@unit` gives nothing back (a `for` whose rows end on it gathers nothing)
    if (OutTyOf lx, (OutOf (TypeAt lx, e.span))) == OutUnit: ((wx4, WrUnit)) else: ((wx4, (WrEv (EvRefOf wx4, upId))))

# A static widget of several clauses whose result is plain (Semantics ch. 4: `@ v` lifts a
# plain value; ch. 8: `<-` builds the child and binds its result), which the block reads
# at its build: its generation is built in the block's own build, before the block's node,
# at the line's point, the clause chosen by matching the arguments as the block's build
# reads them; the row holds the block through a link (`prism_rtl::Link`, as a host's
# supplier does), linked once the node is made, and hands its plain result back with
# itself. The node keeps the row as its generation from then on, built once (pick CS).
EarlyClauseLine: unbounded fn Wx, Env, Env, Expr, Text, ValInfo, Expr, [Arg], OutTy -> ((Wx, Wres))
fn EarlyClauseLine wx, benv, menv, scrut, qk, v, e, args, outTy:
    let lx = wx.lx
    let pos = wx.pos
    let ((name, wx1)) = FreshName wx, "generation"
    let link = "{name}_link"
    let first = "{name}_first"
    let rowLocal = "{name}_row"
    let linkTy = OutNamed (RefRuntime "prism_rtl::Link"), [[(OutNamed (SiteRef lx, wx.node), [[]])]]
    let clauses = ClausesOf lx.g, qk
    let rowName = "{wx.node}Gen{RowSuffix wx}"
    let ((rows, wx2)) = Fold (Range0 (Len clauses)), (([[]], wx1)), \|((acc, w)), i|
        let c = Or clauses[i], dummyClause
        let cr = ClauseRowOf w, menv, c, v, "{rowName}{i}", name, True, linkTy, args, False
        (((Push acc, cr), cr.parent))
    let width = Fold rows, 0, \|acc, cr| Max acc, cr.width
    let cases = Each rows, \|cr| cr.case
    let rowObj = OutObj (OutNamed (RefRuntime "rt::Row"), [[]])
    # the clause chosen and built: in the block's build, through the link made there; in
    # the node's own method (never called again: the arguments do not change), through the
    # link it keeps
    # in a hosted scope the row is given its host: in the build the local, in the node's
    # method its field
    let hostAtBuild = match ?HostedRows wx:
        ? ignore: [[(XClone (XVar (HostLocal wx, pos)))]]
        nil: [[]]
    let Made = \|c, parent, host| TryOf (XCall (RefChild (SiteRef lx, c.node.name), "build"), (Append (Append [[(XClone (XVar "path"))]], c.passed), (Append (Append [[parent]], host), [[XCx]])))
    let gaps = RowGaps rows, width
    let gapNow = "{name}_gap_now"
    let earlyArms = Fold cases, [[]], \|built, c|
        let i = Len built
        Push built, (XArm(pat=c.pat, conds=c.conds, body=(XBlock [[(DoLet (PaBind "row"), (Made c, (XClone (XVar link)), hostAtBuild))]], (XTuple [[(XMethod (XVar "row"), "result_value", [[]]), (XCast (XClone (XVar "row")), rowObj), (Or (Or gaps[i], nil), (XIndex 0))]]))))
    let methodArms = Each cases, \|c| XArm(pat=c.pat, conds=c.conds, body=(XCast (Made c, (XClone (XField XSelf, link)), (HostedPassed wx)), rowObj))
    let atBuild = ClauseScrutinee lx, benv, v, args
    # the arguments as the node's methods read them (in a generation's row `_` is the
    # row's own value, never the builder's `value`, which here is unit)
    let inMethod = ClauseScrutinee lx, menv, v, args
    let built = WithRowBase wx, "", pos, (Own (ArmsValue atBuild, earlyArms, "'select", (OutTuple [[outTy, rowObj, OutCount]])))
    let select = WithRowBase wx, "self", pos, (Own (ArmsValue inMethod, methodArms, "'select", rowObj))
    let wx3 = update wx2:
        &_.taken <= Append &_.taken, [[link, first, rowLocal, gapNow]]
        &_.lets <= Append &_.lets, [[(DoLet (PaTyped (PaBind link), linkTy), (XCall (RefRuntime "prism_rtl::Link::<{wx.node}>::new"), [[]])), (DoLet (PaTuple [[(PaBind first), (PaBind rowLocal), (PaBind gapNow)]]), built)]]
        &_.fields <= Push &_.fields, ((link, linkTy, "the link the generation at place {PlaceText pos} holds this node through, built before it"))
        &_.inits <= Push &_.inits, ((link, (XClone (XVar link))))
        &_.build <= Push &_.build, (DoExpr (XMethod (XVar link), "link", [[(XRef (XVar "node"))]]))
        &_.fallible <= True
        &_.pos <= Pos(scope=pos.scope, at=pos.at + width)
        &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, at=(PlaceAt wx, "self", pos), source=(XUnit), valueTy=OutUnit, select=select, transparent=True, width=width, moved=(Or (?HostedRows wx), ""), early=True, gappy=(IsGappy gaps), rebased=False)
        &_.genHolds <= Push &_.genHolds, ((name, [[]]))
        &_.rows <= Fold cases, &_.rows, \|acc, gc| Append (Push acc, gc.node), gc.node.children
    ((wx3, (WrPlain (XClone (XVar first)), outTy)))

# A building `match` built early (`IsEarlyChoiceAt`): its generation is built in the
# block's own build, before the block's node, at the line's point, the arm chosen by
# matching the scrutinee as the build reads it, as a static widget of several clauses
# with a plain result is (`EarlyClauseLine`). The arm's row reads nothing of the block
# and holds it through a link; it hands its plain result back with itself, a value of
# the build. The node keeps the row as its generation from then on, built once.
EarlyChoiceLine: unbounded fn Wx, Env, Env, Expr, [Arm], Expr -> ((Wx, Wres))
fn EarlyChoiceLine wx, benv, menv, s, arms, e:
    let lx = wx.lx
    let pos = wx.pos
    let outTy = ChoiceOutTy lx, e
    let sty = TypeAt lx, s.span
    let ((name, wx1)) = FreshName wx, "arm"
    let link = "{name}_link"
    let first = "{name}_first"
    let rowLocal = "{name}_row"
    let linkTy = OutNamed (RefRuntime "prism_rtl::Link"), [[(OutNamed (SiteRef lx, wx.node), [[]])]]
    let rowName = "{wx.node}Arm{RowSuffix wx}"
    let ((rows, wx2)) = Fold (Range0 (Len arms)), (([[]], wx1)), \|((acc, w)), i|
        let a = Or arms[i], dummyArmS
        let cr = ArmRowOf w, menv, lx, [[a.?pattern]], [[sty]], nil, a.body, "{rowName}{i}", name, True, False, linkTy, [[]], [[]], [[]], False
        (((Push acc, cr), cr.parent))
    let width = Fold rows, 0, \|acc, cr| Max acc, cr.width
    let cases = Each rows, \|cr| cr.case
    let rowObj = OutObj (OutNamed (RefRuntime "rt::Row"), [[]])
    let hostAtBuild = match ?HostedRows wx:
        ? ignore: [[(XClone (XVar (HostLocal wx, pos)))]]
        nil: [[]]
    let Made = \|c, parent, host| TryOf (XCall (RefChild (SiteRef lx, c.node.name), "build"), (Append (Append [[(XClone (XVar "path"))]], c.passed), (Append (Append [[parent]], host), [[XCx]])))
    let gaps = RowGaps rows, width
    let gapNow = "{name}_gap_now"
    let earlyArms = Fold cases, [[]], \|built, c|
        let i = Len built
        Push built, (XArm(pat=c.pat, conds=c.conds, body=(XBlock [[(DoLet (PaBind "row"), (Made c, (XClone (XVar link)), hostAtBuild))]], (XTuple [[(XMethod (XVar "row"), "result_value", [[]]), (XCast (XClone (XVar "row")), rowObj), (Or (Or gaps[i], nil), (XIndex 0))]]))))
    let methodArms = Each cases, \|c| XArm(pat=c.pat, conds=c.conds, body=(XCast (Made c, (XClone (XField XSelf, link)), (HostedPassed wx)), rowObj))
    let atBuild = XTuple [[(Argument lx, benv, s)]]
    let inMethod = XTuple [[(Argument lx, menv, s)]]
    let built = WithRowBase wx, "", pos, (Own (ArmsValue atBuild, earlyArms, "'select", (OutTuple [[outTy, rowObj, OutCount]])))
    let select = WithRowBase wx, "self", pos, (Own (ArmsValue inMethod, methodArms, "'select", rowObj))
    let wx3 = update wx2:
        &_.taken <= Append &_.taken, [[link, first, rowLocal, gapNow]]
        &_.lets <= Append &_.lets, [[(DoLet (PaTyped (PaBind link), linkTy), (XCall (RefRuntime "prism_rtl::Link::<{wx.node}>::new"), [[]])), (DoLet (PaTuple [[(PaBind first), (PaBind rowLocal), (PaBind gapNow)]]), built)]]
        &_.fields <= Push &_.fields, ((link, linkTy, "the link the arm at place {PlaceText pos} holds this node through, built before it"))
        &_.inits <= Push &_.inits, ((link, (XClone (XVar link))))
        &_.build <= Push &_.build, (DoExpr (XMethod (XVar link), "link", [[(XRef (XVar "node"))]]))
        &_.fallible <= True
        &_.pos <= Pos(scope=pos.scope, at=pos.at + width)
        &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, at=(PlaceAt wx, "self", pos), source=(XUnit), valueTy=OutUnit, select=select, transparent=True, width=width, moved=(Or (?HostedRows wx), ""), early=True, gappy=(IsGappy gaps), rebased=False)
        &_.genHolds <= Push &_.genHolds, ((name, [[]]))
        &_.rows <= Fold cases, &_.rows, \|acc, gc| Append (Push acc, gc.node), gc.node.children
    ((wx3, (WrPlain (XClone (XVar first)), outTy)))

let dummyArmS = Arm(?pattern=nil, ?guard=nil, body=dummyBlockS, span=Range(start=0, end=0))

# Whether the node's places go to a host's document rather than the World's.
IsHostedScope: fn Wx -> Bool
fn IsHostedScope wx = wx.pos.scope > 0 or (IsSome wx.?hostedBy)

IsSome: fn ?a -> Bool
fn IsSome (? ignore) = True
fn IsSome nil = False

# One generation's node, for the block or for one clause of the widget it applies.
type GenCase = record:
    node: NodeDef
    params: [((Text, OutTy))]
    pat: Pa
    conds: [Cc]
    # What each parameter is built from: the arm's binders, owned.
    passed: [Ex]

GenCases: unbounded fn Wx, Env, Block, OutTy, Text -> (([GenCase], Wx))
fn GenCases wx, menv, body, vt, name:
    let lx = wx.lx
    let rowName = "{wx.node}Gen{RowSuffix wx}"
    match ?ClauseCall lx, body:
        ? ((qk, args)):
            let clauses = ClausesOf lx.g, qk
            let v = ValOf lx, qk
            Fold (Range0 (Len clauses)), (([[]], wx)), \|((acc, w)), i|
                let c = Or clauses[i], dummyClause
                let cr = ClauseRowOf w, menv, c, v, "{rowName}{i}", name, False, (OutWeak wx.node), args, False
                # a `rebuild` of a clause call hands back no plain result
                let p2 = match cr.?plain:
                    ? ignore: update cr.parent:
                        &_.build <= Push &_.build, (InternalBugDo "a `rebuild` that hands back no dynamic whose generation is a widget of several clauses ending on a plain result")
                    nil: cr.parent
                (((Push acc, cr.case), p2))
        nil:
            let whole = GenRowOf wx, menv, body, vt, rowName, name
            ((([[GenCase(node=whole.node, params=[[(("value", vt))]], pat=PaWild, conds=[[]], passed=[[(XVar "value")]])]]), whole.parent))

# A generation's body that is one application of a widget of several clauses: the widget
# and the arguments.
?ClauseCall: fn Lx, Block -> ?((Text, [Arg]))
fn ?ClauseCall lx, body = match body.stmts:
    [[st]]: match st.kind:
        SExpr x: ?ClauseCallX lx, x
        SIgnore x: ?ClauseCallX lx, x
        otherwise: nil
    otherwise: nil

?ClauseCallX: fn Lx, Expr -> ?((Text, [Arg]))
fn ?ClauseCallX lx, x = match x.kind:
    ECall c, args, ignore, ignore:
        let qk = BlueprintQk lx, c
        if (Len (ClausesOf lx.g, qk)) > 1: ? ((qk, args)) else: nil
    otherwise: nil

type ClauseRow = record:
    case: GenCase
    parent: Wx
    # The clause's plain result, kept in the row's field and read by `result_value`, when
    # it ends on one.
    ?plain: OutTy
    # What a clause's dynamic result reads of its block, and its type (`DynClauseLine`).
    resultReads: [Read]
    ?resultTy: OutTy
    # How many places the clause has: the positions it takes in its caller when it stands
    # there (`ClauseWidgetLine`).
    width: Nat
    # Whether a generation of the row's own leaves positions unbuilt (`GenDef.gappy`): the
    # row has `inner_gap`.
    inner: Bool
    # The row's bundle result, part by part (`RowPartsOut`); empty when it ends on none.
    parts: [RowPart]

# One clause's generation: its parameters' binders the row's fields, chosen by matching
# the arguments (in the block, `_` the generation's value).
# `zeroBased`: a row shared by every call of a widget that calls itself
# (`SharedClauseLine`): its places are numbered from 0, whatever its caller's position.
ClauseRowOf: unbounded fn Wx, Env, FnClause, ValInfo, Text, Text, Bool, OutTy, [Arg], Bool -> ClauseRow
fn ClauseRowOf wx, menv, c, v, rowName, genName, transparent, parentTy, args, zeroBased:
    let lx = wx.lx
    let lxc = InModuleAt lx, v.file, v.home, lx.site
    let ptys = match v.scheme.ty:
        TyFn ignore, ps, ignore: ps
        otherwise: [[]]
    # a blueprint parameter (and a widget function's) is no value of the row: its argument
    # is the caller's text, built where the clause applies it (`ArmRowOf`, `widgets`), so
    # its pattern matches nothing of the scrutinee (`ClauseScrutinee`)
    # (a shared row holds no block: its blueprint parameter is a value of the row, a
    # field as a plain parameter's binder is, applied as a blueprint value is,
    # `ValueBlueprintLine`)
    let valued = zeroBased and parentTy == OutUnit
    let widgets = if valued: [[]] else: Fold (Range0 (Len c.params)), [[]], \|acc, i| match ((ptys[i], c.params[i], args[i])):
        ((? pt, ? p, ? a)) if IsBlueprintParam pt:
            let bn = PlainBinder lxc, p
            if bn == "": acc else: Push acc, ((bn, a.value))
        otherwise: acc
    # (and its `$` or event parameter is the caller's live `Dynamic` or `Event`, a value
    # of the row too, `LiveParams`: no pattern matches it)
    let pats = Each (Range0 (Len c.params)), \|i| match ((ptys[i], c.params[i])):
        ((? pt, ? p)) if (IsBlueprintParam pt) and not valued: nil
        ((? pt, ? p)) if valued and IsLiveParam pt: nil
        ((ignore, ?p)): ?p
    let body = match c.body:
        BodyBlock b: b
        BodyExpr x: Block(stmts=[[(Stmt(kind=(SExpr x), span=x.span))]], inline=True, span=x.span)
    # a `$` parameter's binder is the caller's dynamic, read through the row's parent where
    # the caller's own reading of it stands (Type System ch. 1; the caller's writes behind
    # it mark the row's places, `GenMarked`), never its value at the build
    let ((dyns, wxd)) = if valued: (((LiveShapes lxc, c, ptys), wx)) else: Fold (Range0 (Len c.params)), (([[]], wx)), \|((acc, w)), i| match ((ptys[i], c.params[i], args[i])):
        ((? pt, ? p, ? a)) if (LayerOf pt) == LyDyn:
            let bn = PlainBinder lxc, p
            if bn == "": ((acc, w))
            else:
                let ((b, w2)) = ClauseDynArg w, menv, a.value, (OutTyOf lxc, (Peel pt))
                (((Push acc, ((bn, b))), w2))
        otherwise: ((acc, w))
    ArmRowOf wxd, menv, lxc, pats, ptys, nil, body, rowName, genName, transparent, False, parentTy, dyns, [[]], widgets, zeroBased

# Whether a parameter of a widget that calls itself is held by its shared rows as the
# caller's live value: a `$` parameter (a `Dynamic`) or an event parameter (an `Event`)
# with no time below its top.
IsLiveParam: fn Ty -> Bool
fn IsLiveParam pt = ((LayerOf pt) == LyDyn or (LayerOf pt) == LyEv) and not (HasTime (Peel pt))

HasLiveParam: fn ValInfo -> Bool
fn HasLiveParam v = match v.scheme.ty:
    TyFn ignore, ps, ignore: Fold ps, False, \|found, pt| found or IsLiveParam pt
    otherwise: False

# A shared row's live parameters in their order (`ArmRowOf`, `LiveParams`): each binder
# with the type of the value the row holds, a `Dynamic`'s or an `Event`'s.
LiveShapes: unbounded fn Lx, FnClause, [Ty] -> [((Text, Bn))]
fn LiveShapes lxc, c, ptys = Fold (Range0 (Len c.params)), [[]], \|acc, i| match ((ptys[i], c.params[i])):
    ((? pt, ? p)) if IsLiveParam pt:
        let t = OutTyOf lxc, (Peel pt)
        Push acc, (((PlainBinder lxc, p), (BnLocal XUnit, Owned, (if (LayerOf pt) == LyDyn: OutDyn t else: OutEvent t))))
    otherwise: acc

# A shared row's live parameters (`IsLiveParam`): the row is built with the caller's
# `Dynamic` or `Event` and keeps it in a field, bound under `#whole#{name}` so that a
# call inside hands the same value on (`SharedScrutinee`), an arm's row of the row's
# reading it through its parent (`WholeOfBlock`).
# - A `$` parameter is read through the row's getter `{f}_value`, which samples the
#   dynamic at the read point; the row follows the dynamic's update event
#   (`prism_rtl::Follow`), and each firing marks what reads the getter
#   (`{f}_result_moved`, as a clause's dynamic result moving does).
# - An event parameter is a port node of the row's graph, fed by a subscription the
#   build makes to the event's port, as an event a function gave whole is
#   (`EventObjectRef`).
# Gives the row, its build and method environments' new names, and the build's
# parameters, in the parameters' order.
LiveParams: fn Wx, [((Text, Bn))] -> ((Wx, Env, Env, [((Text, OutTy))]))
fn LiveParams r0, lives = Fold lives, ((r0, emptyEnv, emptyEnv, [[]])), \|((r, be, me, params)), ((bn, shape))| match shape:
    BnLocal ignore, ignore, (OutDyn t):
        let ((f, r1)) = FreshName r, "{Snake bn}_param"
        let res = "{f}_res"
        let getter = "{f}_value"
        let follow = "{f}_follow"
        let init = "{f}_init"
        let followed = DoExpr (XMethod (XField (XVar "node"), follow), "follow", [[(XRef (XField (XField (XVar "node"), res), "updates")), (XRef (XVar "node")), (XPath (RefChild (SiteRef r.lx, r.node), "{f}_result_moved"))]])
        let r2 = update r1:
            &_.taken <= Append &_.taken, [[res, getter, follow, init, "{f}_result_moved"]]
            &_.fields <= Append &_.fields, [[((res, (OutDyn t), "`{bn}`, a `$` parameter of a widget that calls itself: the caller's dynamic")), ((follow, (OutNamed (RefRuntime "prism_rtl::Follow"), [[]]), "the subscription to `{bn}`'s update event"))]]
            &_.inits <= Push &_.inits, ((res, (XClone (XVar res))))
            &_.moves <= Push &_.moves, ((follow, (XCall (RefRuntime "prism_rtl::Follow::new"), [[]])))
            &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind init), t), (XMethod (XVar res), "sample", [[XCx]]))
            &_.inited <= Append &_.inited, [[res, getter]]
            &_.build <= Push &_.build, followed
            &_.getters <= Push &_.getters, (MethDef(name=getter, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=(XMethod (XField XSelf, res), "sample", [[XCx]]), doc="`{bn}`, a `$` parameter, at the read point."))
            &_.dynReads <= Insert &_.dynReads, getter, [[OwnRead res]]
            &_.clauseResults <= Push &_.clauseResults, f
        let be2 = Bind (Bind (Bind be, bn, (BnDyn (XMethod (XVar res), "sample", [[XCx]]), [[OwnRead getter]], t)), "{bn}#init", (BnLocal (XVar init), Owned, t)), "#whole#{bn}", (BnLocal (XVar res), Owned, (OutDyn t))
        let me2 = Bind (Bind me, bn, (BnDyn (XMethod XSelf, getter, [[XCx]]), [[OwnRead getter]], t)), "#whole#{bn}", (BnLocal (XField XSelf, res), Owned, (OutDyn t))
        ((r2, be2, me2, (Push params, ((res, (OutDyn t))))))
    BnLocal ignore, ignore, (OutEvent t):
        let ((f, r1)) = FreshName r, "{Snake bn}_param"
        let ev = "{f}_ev"
        let ((id, r2)) = AddGn r1, f, t, GnPort, 0
        let port = XClosure False, [[PaBind "ev"]], (XRef (XField (XVar "ev"), "port"))
        let call = XClosure False, [[PaBind "n", PaBind "v", PaBind "cx"]], (XMethod (XVar "n"), f, [[XClone (XVar "v"), XCx]])
        let sub = DoExpr (XCall (HelperRef "subscribe_row"), [[(XRef (XVar "node")), (XCtor (RefRuntime "std::Some"), [[(XCall (RefRuntime "std::Rc::new"), [[(XClone (XField (XVar "node"), ev))]])]]), port, call, (XRef (XField (XVar "node"), "{f}_sub"))]])
        let r3 = update (AddField r2, "{f}_sub", (OutNamed (RefRuntime "std::Cell"), [[(OutOpt (OutNamed (RefRuntime "rt::Handle"), [[]]))]]), "the subscription to `{bn}`", (XCall (RefRuntime "std::Cell::new"), [[XNone]])):
            &_.taken <= Append &_.taken, [[ev, "{f}_sub"]]
            &_.fields <= Push &_.fields, ((ev, (OutEvent t), "`{bn}`, an event parameter of a widget that calls itself: the caller's event"))
            &_.inits <= Push &_.inits, ((ev, (XClone (XVar ev))))
            &_.build <= Push &_.build, sub
        let b = BnEv (EvRefOf r3, id), t
        let be2 = Bind (Bind be, bn, b), "#whole#{bn}", (BnLocal (XVar ev), Owned, (OutEvent t))
        let me2 = Bind (Bind me, bn, b), "#whole#{bn}", (BnLocal (XField XSelf, ev), Owned, (OutEvent t))
        ((r3, be2, me2, (Push params, ((ev, (OutEvent t))))))
    otherwise: ((r, be, me, params))

# How many positions a generation of a widget that calls itself takes in its block's
# numbering (`SharedClauseLine`): more than any call builds, so the places after it have
# positions of their own whatever the call builds, and the generation's gap is what it
# did not build of them.
let wideGeneration = 1048576

# Whether a widget of several clauses that calls itself is lowered as shared rows
# (`SharedClauseLine`): its parameters are plain, it gives nothing or a plain value back,
# it has no type parameter, and its places go to the World. A blueprint parameter is
# taken too, as a value of the row (`prism_rtl::Blueprint`), where the widget gives
# nothing back and the call's argument is a blueprint value the lowering can make
# (`IsBlueprintValued`); a `$` or an event parameter too, as the caller's live value
# (`LiveParams`), where the widget gives nothing back. Any other is lowered level by
# level (`TooDeep`).
IsSharable: unbounded fn Wx, Env, ValInfo, Expr, [Arg] -> Bool
fn IsSharable wx, menv, v, e, args:
    let ptys = match v.scheme.ty:
        TyFn ignore, ps, ignore: ps
        otherwise: [[]]
    let plainResult = (ResultLayer (TypeAt wx.lx, e.span)) == LyPlain and not (IsBundle (LineOutFull wx.lx, e))
    let plainParams = Fold ptys, True, \|ok, pt| ok and (LayerOf pt) == LyPlain and not (IsWidgetFnTy pt)
    let valuedParams = Fold (Range0 (Len ptys)), True, \|ok, i| ok and match ptys[i]:
        ? pt: if IsWidgetFnTy pt: False else: if (LayerOf pt) == LyBlueprint: IsBlueprintValued wx.lx, menv, args[i] else: (LayerOf pt) == LyPlain or IsLiveParam pt
        nil: True
    let nothingBack = (OutTyOf wx.lx, (OutOf (TypeAt wx.lx, e.span))) == OutUnit
    (not (IsHostedScope wx)) and plainResult and (Len (RigidsIn v.scheme.ty)) == 0 and (plainParams or (valuedParams and nothingBack))

# Whether a call of a widget is lowered as shared rows where it stands: inside the
# widget's own clauses; and, for a widget that calls itself with a live parameter, at
# every call, the first too, so that each level is handed the caller's `Dynamic` or
# `Event` (a row lowered level by level reads its caller's names through its parent).
SharesAt: unbounded fn Wx, Env, Text, ValInfo, Expr, [Arg] -> Bool
fn SharesAt wx, menv, qk, v, e, args = ((Recursion wx.inlining, qk) > 0 or ((HasLiveParam v) and CallsItself wx.lx, qk)) and IsSharable wx, menv, v, e, args

# The calls of an expression that are lowered as shared rows and hand a live parameter
# on (`SharesAt`), by their keys: the line makes a live dynamic for each reader such a
# call is given (`WholeArgsAt`).
SharedLiveCalls: unbounded fn Wx, Env, Expr -> [Text]
fn SharedLiveCalls wx, menv, e = Fold (ExprsIn e), [[]], \|acc, x| match x.kind:
    ECall c, args, ignore, ignore:
        let qk = BlueprintQk wx.lx, c
        match wx.lx.g.vals[qk]:
            ? v: if (HasLiveParam v) and (IsWidgetTy (WidgetResultOf v.scheme.ty)) and SharesAt wx, menv, qk, v, x, args: Push acc, (DynKey x) else: acc
            nil: acc
    otherwise: acc

# Whether a call's blueprint argument is a value where the call stands: a blueprint the
# node holds (a pattern's binder, a shared row's own parameter), or a widget the program
# reads as a value (`Lx.valued`), named in place or through the caller's own parameter.
IsBlueprintValued: unbounded fn Lx, Env, ?Arg -> Bool
fn IsBlueprintValued lx, menv, ?a = match ?a:
    nil: False
    ? a: match (Ungrouped a.value).kind:
        EName n: match (if (Len n.path) == 1: menv.names[SNameKey n] else: nil):
            ? (BnLocal ignore, ignore, ignore): True
            ? (BnWidget x, ignore, ignore, clx): HasKey lx.valued, (BlueprintQk clx, x)
            nil: HasKey lx.valued, (BlueprintQk lx, a.value)
            otherwise: False
        otherwise: False

# The arguments of a widget that calls itself as its shared rows' patterns match them
# (`SharedCaseOf`): each plain argument's value, and each blueprint argument as a value,
# the caller's own blueprint parameter read as the widget it names.
SharedScrutinee: unbounded fn Lx, Env, ValInfo, [Arg] -> Ex
fn SharedScrutinee lx, env, v, args:
    let ptys = match v.scheme.ty:
        TyFn ignore, ps, ignore: ps
        otherwise: [[]]
    let parts = Each (Range0 (Len args)), \|i| match ((ptys[i], args[i])):
        ((? pt, ? a)) if (LayerOf pt) == LyBlueprint: match (Ungrouped a.value).kind:
            EName n: match (if (Len n.path) == 1: env.names[SNameKey n] else: nil):
                ? (BnWidget x, ignore, cmenv, clx): Ref (ValueOf clx, cmenv, x)
                otherwise: Argument lx, env, a.value
            otherwise: Argument lx, env, a.value
        # a live parameter: the `Dynamic` or `Event` a shared row holds, handed on as it
        # is; any other argument as the value its line made (`WholeArgsAt`, an event's
        # value form)
        ((? pt, ? a)) if IsLiveParam pt: match (Ungrouped a.value).kind:
            EName n: match (if (Len n.path) == 1: env.names["#whole#{SNameKey n}"] else: nil):
                ? (BnLocal x, mode, lt): Ref (LocalPlace x, mode, lt)
                otherwise: Ref (ValueOf (AsWhole lx), env, a.value)
            otherwise: Ref (ValueOf (AsWhole lx), env, a.value)
        ((ignore, ? a)): Argument lx, env, a.value
        otherwise: XUnit
    XTuple parts

AsWhole: fn Lx -> Lx
fn AsWhole lx = update lx:
    &_.whole <= True

# A widget of several clauses applied inside its own clause (Semantics ch. 8: a widget
# may call itself, as deep as its data; ruling TC: places are counted as they are built).
# Lowering the call level by level never ends, so the widget's clauses are lowered once
# more as rows shared by every further call: one row type per clause, numbered from 0,
# built with `base`, holding no block (a clause with plain parameters and no result
# reads none), each telling how many places it built (`built`). The call is a
# transparent generation `wideGeneration` positions wide, gappy: the block keeps what
# the row did not build of them, so its later places are counted as built. The rows are
# made at the first such call and named in `Lx.shared`, where the calls inside them find
# them.
SharedClauseLine: unbounded fn Wx, Env, Expr, Text, ValInfo, Expr, [Arg] -> ((Wx, Wres))
fn SharedClauseLine wx, menv, scrut, qk, v, e, args:
    let lx = wx.lx
    let pos = wx.pos
    let ((srcEx, reads)) = DynamicExpr wx, menv, scrut
    let vt = OutTyOf lx, (Peel (TypeAt lx, scrut.span))
    let ((name, wx1)) = FreshName wx, "generation"
    let clauses = ClausesOf lx.g, qk
    let ((cases, wx2)) = match lx.shared[qk]:
        ? known: ((known, wx1))
        nil:
            let stem = "{wx.node}Rec{RowSuffix wx}C"
            let heads = Each (Range0 (Len clauses)), \|i| SharedCaseOf lx, v, (Or clauses[i], dummyClause), "{stem}{i}"
            let inside = update wx1:
                &_.lx <= WithShared lx, qk, heads
            let ((rows, made)) = Fold (Range0 (Len clauses)), (([[]], inside)), \|((acc, w)), i|
                let cr = ClauseRowOf w, menv, (Or clauses[i], dummyClause), v, "{stem}{i}", name, True, OutUnit, args, True
                (((Push acc, cr), cr.parent))
            let back = update made:
                &_.lx <= lx
                &_.rows <= Fold rows, &_.rows, \|acc, cr| Append (Push acc, cr.case.node), cr.case.node.children
            ((heads, back))
    let rowObj = OutObj (OutNamed (RefRuntime "rt::Row"), [[]])
    let gap = XBin OpSub, (XIndex wideGeneration), (XMethod (XVar "row"), "built", [[]])
    # a plain result: each clause's row keeps it (`result_value`, `ArmRowOf`), and the
    # block keeps it from the row's build on, late (`WrLate`), as a building `match` keeps
    # its arm's (`BuildingChoiceLine`)
    let outTy = OutTyOf lx, (OutOf (TypeAt lx, e.span))
    let res = "{name}_res"
    let keeps = if outTy == OutUnit: [[]] else: [[(DoAssign (XDeref (XMethod (XField XSelf, res), "borrow_mut", [[]])), (XCtor (RefRuntime "std::Some"), [[(XMethod (XVar "row"), "result_value", [[]])]]))]]
    let arms = Each cases, \|((rowNode, pat, conds, passed))|
        let built = TryOf (XCall (RefChild (SiteRef lx, rowNode), "build"), (Append (Append [[(XClone (XVar "path"))]], passed), [[XUnit, XCx]]))
        XArm(pat=pat, conds=conds, body=(XBlock (Append (Append [[(DoLet (PaBind "row"), built)]], keeps), (GapSet name, (? gap))), (XCast (XVar "row"), rowObj)))
    let select = WithRowBase wx, "self", pos, (Own (ArmsValue (SharedScrutinee lx, menv, v, args), arms, "'select", rowObj))
    let wx3 = update wx2:
        &_.pos <= Pos(scope=pos.scope, at=pos.at + wideGeneration)
        &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, at=(PlaceAt wx, "self", pos), source=srcEx, valueTy=vt, select=select, transparent=True, width=wideGeneration, moved="", early=False, gappy=True, rebased=True)
        &_.genHolds <= Push &_.genHolds, ((name, reads))
    if outTy == OutUnit: ((wx3, WrUnit))
    else:
        let read = XClone (XMethod (XMethod (XMethod (XField XSelf, res), "borrow", [[]]), "as_ref", [[]]), "expect", [[(XStr "a row built before what reads its result")]])
        let wx4 = update wx3:
            &_.taken <= Push &_.taken, res
            &_.fields <= Push &_.fields, ((res, (OutCell (OutOpt outTy)), "the plain result of the widget that calls itself, kept from its row's build on"))
            &_.inits <= Push &_.inits, ((res, (XCall (RefRuntime "std::RefCell::new"), [[XNone]])))
        ((wx4, (WrLate read, outTy)))

WithShared: fn Lx, Text, [((Text, Pa, [Cc], [Ex]))] -> Lx
fn WithShared lx, qk, cases = update lx:
    &_.shared <= Insert &_.shared, qk, cases

# One clause of a shared widget as a call chooses and builds it: its row, the pattern
# and conditions over the arguments, and what the row's `build` is passed (the pattern's
# binders, then `row_base`), as `ArmRowOf` makes them for the row itself.
SharedCaseOf: unbounded fn Lx, ValInfo, FnClause, Text -> ((Text, Pa, [Cc], [Ex]))
fn SharedCaseOf lx, v, c, rowName:
    let lxc = InModuleAt lx, v.file, v.home, lx.site
    let ptys = match v.scheme.ty:
        TyFn ignore, ps, ignore: ps
        otherwise: [[]]
    # a live parameter (`IsLiveParam`) matches anything and is handed on whole
    let live = Filter (Range0 (Len c.params)), \|i| IsLiveParam (Or ptys[i], TyErr)
    let pos = Each (Range0 (Len c.params)), \|i| if HasNat live, i: PatOut(pa=(PaBind "live{i}"), conds=[[]], binds=[[]]) else: ArmPat lxc, c.params[i], (Or ptys[i], TyErr), ByRef, "c{i}"
    let binds = Fold pos, {}, \|m, o| Fold o.binds, m, \|m2, ((n, b))| Insert m2, n, b
    let named = Fold c.params, [[]], \|acc, p| Append acc, (PatternBinders p)
    let binders = Filter named, \|((bn, ignore))| HasKey binds, bn
    let passed = Each binders, \|((bn, ignore))| match binds[bn]:
        ? (BnLocal rs, mode, bt): Own (VlPlace rs, mode, bt)
        otherwise: XClone (XVar (Snake bn))
    let handed = Each live, \|i| XClone (XVar "live{i}")
    ((rowName, (PaTuple (Each pos, \|o| o.pa)), (Fold pos, [[]], \|acc, o| Append acc, o.conds), (Push (Append passed, handed), (XVar "row_base"))))


# Whether a widget's parameter takes a blueprint or a widget function: the caller's text,
# never a value (`BindParam`).
IsBlueprintParam: fn Ty -> Bool
fn IsBlueprintParam pt = (LayerOf pt) == LyBlueprint or IsWidgetFnTy pt

# The arguments of a widget of several clauses as its clauses' patterns match them: each
# plain argument's value; nothing for a blueprint, which no pattern matches.
ClauseScrutinee: unbounded fn Lx, Env, ValInfo, [Arg] -> Ex
fn ClauseScrutinee lx, env, v, args:
    let ptys = match v.scheme.ty:
        TyFn ignore, ps, ignore: ps
        otherwise: [[]]
    XTuple (Each (Range0 (Len args)), \|i| ClauseArgument lx, env, ptys[i], args[i])

ClauseArgument: unbounded fn Lx, Env, ?Ty, ?Arg -> Ex
fn ClauseArgument lx, env, ?pt, ?a = match ((?pt, ?a)):
    ((? pt, ? a)) if IsBlueprintParam pt: XUnit
    ((ignore, ? a)): Argument lx, env, a.value
    otherwise: XUnit

# A caller's dynamic argument as a clause's row reads it: through its `parent`, the reads
# the caller's ones of the block (`ParentRead`). One the caller itself reads through its
# own parent (the caller is a row, the dynamic its block's) is a getter of the caller,
# whose reads are the caller's: the clause's row reads the getter through its parent, and
# the caller, hearing its block's write behind it, marks the clause's row as it marks any
# row that reads a name of its own.
ClauseDynArg: unbounded fn Wx, Env, Expr, OutTy -> ((Bn, Wx))
fn ClauseDynArg wx, menv, x, t:
    let ((ex, reads)) = DynamicExpr wx, menv, x
    let ok = (OnSelfRooted ex) and Fold reads, True, \|f, r| f and IsOwnRead r
    if ok: (((BnDyn (OverParent ex), (Each reads, \|r| AsParentRead r), t), wx))
    else:
        let ((getter, w1)) = FreshName wx, "clause_dynamic"
        let w2 = update w1:
            &_.getters <= Push &_.getters, (MethDef(name=getter, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=ex, doc="A dynamic argument of a widget of several clauses, as its row reads it through this node."))
            &_.dynReads <= Insert &_.dynReads, getter, reads
        (((BnDyn (XMethod parentRef, getter, [[XCx]]), [[ParentRead getter]], t), w2))

AsParentRead: fn Read -> Read
fn AsParentRead (OwnRead m) = ParentRead m
fn AsParentRead (ParentRead m) = ParentRead m

# Whether a node's expression reads only through `self`.
OnSelfRooted: fn Ex -> Bool
fn OnSelfRooted x = match x:
    XSelf: True
    XField y, ignore: OnSelfRooted y
    XFieldOf y, ignore, ignore: OnSelfRooted y
    XPart y, ignore: OnSelfRooted y
    XMethod y, ignore, ignore: OnSelfRooted y
    otherwise: False

# One arm's generation, of a widget's clause or of a building `match` or `if`: the binders
# of its patterns (`nil` matches anything) the row's fields, chosen by matching the
# scrutinees, a guard (read in the block, with the binders) a condition of the arm. A
# clause's body reads its binders alone (it is its own function's); an arm of a `match` in
# a block reads the block's names too (`readsBlock`, through `RowEnv`), its binders over
# them. The row holds its block as `parentTy`: weakly, or through a link when the
# generation is built before the block's node (`EarlyClauseLine`).
# `widgets`: a clause's blueprint parameters, each with the caller's argument, bound as an
# inlined widget's are (`BindParam`): the argument's text with the caller's environments
# as the row sees them (`RowEnvNames`), built where the clause applies the parameter.
# `zeroBased`: the row's places are numbered from 0, not from its block's position, and
# it tells how many it built (`built`): a row shared by every call of a widget that calls
# itself (`SharedClauseLine`).
ArmRowOf: unbounded fn Wx, Env, Lx, [?Pattern], [Ty], ?Expr, Block, Text, Text, Bool, Bool, OutTy, [((Text, Bn))], [((Text, Text))], [((Text, Expr))], Bool -> ClauseRow
fn ArmRowOf wx, menv, lxc, pats, ptys, ?guard, body, rowName, genName, transparent, readsBlock, parentTy, dynsGiven, ups, widgets, zeroBased:
    let upName = "{genName}_up"
    let pos = Each (Range0 (Len pats)), \|i| ArmPat lxc, (Or pats[i], nil), (Or ptys[i], TyErr), ByRef, "c{i}"
    let pa = PaTuple (Each pos, \|o| o.pa)
    let binds = Fold pos, {}, \|m, o| Fold o.binds, m, \|m2, ((n, b))| Insert m2, n, b
    let guardConds = match ?guard:
        ? g: [[CcIf (AsBool (ValueOf lxc, (BindAll menv, (Fold pos, [[]], \|acc, o| Append acc, o.binds)), g))]]
        nil: [[]]
    # the names the patterns bind: a bare case name (`Quiet`) binds nothing (gap AW)
    let named = Fold pats, [[]], \|acc, ?p| Append acc, (OptBinders ?p)
    # a shared row's `dyns` are its live parameters, values it holds (`LiveParams`)
    let lives = if zeroBased and parentTy == OutUnit: dynsGiven else: [[]]
    let dyns = if zeroBased and parentTy == OutUnit: [[]] else: dynsGiven
    let dynNames = Append (Each dyns, \|((n, ignore))| n), (Each widgets, \|((n, ignore))| n)
    let binders = Filter named, \|((bn, ignore))| (HasKey binds, bn) and not (HasText dynNames, bn)
    let fields = Each binders, \|((bn, r))| (((Snake bn), (OutTyOf lxc, (Peel (BinderTy lxc, r))), bn))
    # a transparent row is built with `base`, where its first position stands as built
    # (ruling TC; `PlaceNumber`)
    let baseField = if transparent: [[(("base", OutCount, "where the row's first position stands as built"))]] else: [[]]
    let rowFields = Append (Push (Each fields, \|((f, t, bn))| ((f, t, "`{bn}`"))), (("parent", parentTy, "the node of the `rebuild`"))), baseField
    let rowInits = Append (Each fields, \|((f, ignore, ignore))| ((f, (XClone (XVar f))))), (if transparent: [[(("base", (XVar "base")))]] else: [[]])
    let rowTaken = Append (Append nodeHooks, (Push (Push (Each fields, \|((f, ignore, ignore))| f), "parent"), "result_value")), [["base", "place", "seat", "inner_gap"]]
    let r00 = NewWx lxc, rowName, rowFields, rowInits, [[(("parent", (XClone (XVar "parent"))))]], [[]], {}, rowTaken, wx.inlining, (?HostedRows wx)
    # standing in its caller, the arm's places are numbered from the caller's position
    # (the row's own scope, 0: in a hosted scope the row's places are its host's through
    # the row's `?hostedBy`, as a `for` row's are)
    let first = if zeroBased: 0 else: wx.pos.at
    let r0p = if transparent: (update r00:
        &_.pos <= Pos(scope=0, at=first)) else: r00
    let r0b = if transparent: (update r0p:
        &_.based <= ? first) else: r0p
    let ((r0, liveBe, liveMe, liveParams)) = LiveParams r0b, lives
    # a clause's body is its own function's: no name in it is its caller's (only an arm of a
    # `match` in the block reads the block's names, its events through ports of the row)
    let ((p1a, r1a, ports)) = if readsBlock: RowEnv wx, r0, menv, body else: ((wx, r0, emptyEnv))
    let ((p1, r1, widgetEnv)) = Fold widgets, ((p1a, r1a, emptyEnv)), \|((p, r, en)), ((bn, x))|
        let ((p2, r2, inner)) = RowEnvNames p, r, menv, (ReadNames (ExprsIn x))
        ((p2, r2, (Bind en, bn, (BnWidget x, (BuildSpelling inner), inner, wx.lx))))
    let ((be0, me0)) = Fold fields, ((emptyEnv, emptyEnv)), \|((b, m)), ((f, t, bn))| BindPlain b, m, bn, f, t
    let dynEnv = BindAll emptyEnv, dyns
    let me = OverEnv (OverEnv (OverEnv me0, dynEnv), liveMe), widgetEnv
    let be = OverEnv (OverEnv (OverEnv be0, (BuildSpelling dynEnv)), liveBe), widgetEnv
    # a binder hides the block's name it shadows
    let r2u = if readsBlock: BlockInto r1, (OverEnv (BuildSpelling ports), be), (OverEnv ports, me), body else: BlockInto r1, be, me, body
    # the row's events its block prebound (`SplitBlockInto`): each fires the block's
    let r2 = Fold ups, r2u, \|r, ((mine, blocks))| match (Filter r.gns, \|g| g.name == mine and g.kind == GnNamed)[0]:
        ? g: Connect r, (EvRefOf r, g.id), (SkUp blocks)
        nil: update r:
            &_.build <= Push &_.build, (InternalBugDo "the event `{mine}` of a split block's lower lines has no node in their row")
    # a bundle: handed to the block part by part (`RowPartsOut`)
    let ((r2b, parts)) = match r2.result:
        WrParts ps: RowPartsOut r2, genName, "", ps
        otherwise: ((r2, [[]]))
    let ((r3, ?plain)) = match r2.result:
        WrEv r: (((Connect r2, r, (SkUp upName)), nil))
        WrParts ignore: ((r2b, nil))
        # a plain result, computed at the generation's build and kept in a field of the
        # row, read by the block that built it: early for a clause (`EarlyClauseLine`),
        # after its node for an arm of a building `match` or `if` (`BuildingChoiceLine`)
        WrPlain ex, rt:
            let ((f, rf)) = FreshName r2, "result"
            let r2p = update rf:
                &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind f), rt), ex)
                &_.fields <= Push &_.fields, ((f, rt, "the clause's plain result"))
                &_.inits <= Push &_.inits, ((f, (XClone (XVar f))))
                &_.getters <= Push &_.getters, (MethDef(name="result_value", recv=RecvRef, params=[[]], cx=CxNone, ret=rt, body=[[]], tail=(XClone (XField XSelf, f)), doc="The clause's plain result, which the block that built the generation reads."))
            ((r2p, ? rt))
        # a late plain result: the row reads it from itself, its own rows built by then
        WrLate ex, rt: (((update r2:
            &_.getters <= Push &_.getters, (MethDef(name="result_value", recv=RecvRef, params=[[]], cx=CxNone, ret=rt, body=[[]], tail=ex, doc="The clause's plain result, which the block that built the generation reads."))), ? rt))
        # a dynamic result: the row's getter `result` and `result_dynamic`, a write behind it
        # telling the block (`GenResult`, `DynClauseLine`)
        WrDyn ex, rds, rt: (((GenResult r2, genName, ex, rds, rt), nil))
        otherwise: ((r2, nil))
    let baseParam = if transparent: [[(("base", OutCount))]] else: [[]]
    # a shared row tells how many places it built: its positions less what its own
    # generations left unbuilt
    let ownGaps = (Len (Filter r3.gens, \|gd| gd.gappy and gd.pos.scope == 0)) > 0
    let positions = XIndex (Or (r2.pos.at -? r0.pos.at), 0)
    let r3b = if not zeroBased: r3 else: update r3:
        &_.taken <= Push &_.taken, "built"
        &_.getters <= Push &_.getters, (MethDef(name="built", recv=RecvRef, params=[[]], cx=CxNone, ret=OutCount, body=[[]], tail=(if ownGaps: XBin OpSub, positions, (XMethod XSelf, "inner_gap", [[]]) else: positions), doc="How many places the row built (ruling TC: places are counted as they are built)."))
    let node = FinishNode r3b, rowName, (Append (Append (Append (Each fields, \|((f, t, ignore))| ((f, t))), liveParams), baseParam), (Append [[(("parent", parentTy))]], (HostedParams wx))), True
    let p2 = GenMarked p1, genName, r3b
    let passed0 = Each fields, \|((f, t, bn))| match binds[bn]:
        ? (BnLocal rs, mode, bt): Own (VlPlace rs, mode, bt)
        otherwise: XClone (XVar f)
    # the block's `row_base` where it builds the row (`WithRowBase`)
    let passed = if transparent: Push passed0, (XVar "row_base") else: passed0
    let inner = (Len (Filter r3.gens, \|gd| gd.gappy and gd.pos.scope == 0)) > 0
    ClauseRow(case=GenCase(node=node, params=(Each fields, \|((f, t, ignore))| ((f, t))), pat=pa, conds=(Append (Fold pos, [[]], \|acc, o| Append acc, o.conds), guardConds), passed=passed), parent=p2, width=(Or (r2.pos.at -? r0.pos.at), 0), inner=inner, parts=parts, ?plain=?plain, resultReads=(ResultParentReads r2), ?resultTy=(?ResultDynTy r2))

?ResultDynTy: fn Wx -> ?OutTy
fn ?ResultDynTy r = match r.result:
    WrDyn ignore, ignore, rt: ? rt
    otherwise: nil

# What a row's dynamic result reads of its block.
ResultParentReads: fn Wx -> [Read]
fn ResultParentReads r = match r.result:
    WrDyn ignore, rds, ignore: Filter (ReadsClosed r.dynReads, rds), \|rd| IsParentRead rd
    otherwise: [[]]

IsParentRead: fn Read -> Bool
fn IsParentRead (ParentRead ignore) = True
fn IsParentRead (OwnRead ignore) = False

OptBinders: unbounded fn ?Pattern -> [((Text, Range))]
fn OptBinders (? p) = PatternBinders p
fn OptBinders nil = [[]]

# `inner`'s names over `outer`'s.
OverEnv: fn Env, Env -> Env
fn OverEnv outer, inner = Fold (Keys inner.names), outer, \|en, k| match inner.names[k]:
    ? b: Bind en, k, b
    nil: en

# A building `match` or `if` over a plain scrutinee (Semantics ch. 4: "The arm is fixed for
# the life of the block and adds no path segment"; ch. 8, a widget block is transparent):
# a generation built once, at the build, as a static widget of several clauses is
# (`ClauseWidgetLine`), each arm a row chosen by its pattern and guard, standing at the
# block's path, its places in the block's sequence; arms of different widths take the
# widest one's positions (pick CS). The arm's block reads the block's names (through the
# row's `parent`, `RowEnv`) and its pattern's binders (the row's fields). An arm's event
# result fires the line's event.
# `outTy` and `layer` are what the arms give back. An arm that ends on a plain result keeps
# it in its row, and the node keeps it too, in `{name}_res`, from the arm's build on: the
# line's result is late (`WrLate`), read there by the lines a split block builds after the
# arm (`SplitBlockInto`), or by whatever reads the block's own result.
# `ups`: the rows' events the block prebound, each with the block's method it fires
# (`SplitBlockInto`).
# `outFull`: what the arms give back as the checker has it; arms that end on a bundle hand
# it to the block part by part (`KeepParts`), a plain part late.
BuildingChoiceLine: unbounded fn Wx, Env, Ex, [?Pattern], Ty, [?Expr], [Block], OutTy, Layer, Ty, [((Text, Text))] -> ((Wx, Wres))
fn BuildingChoiceLine wx, menv, scrut, pats, sty, guards, bodies, outTy, layer, outFull, ups:
    let lx = wx.lx
    let pos = wx.pos
    let bundled = IsBundle outFull
    let ((name, wx1)) = FreshName wx, "arm"
    let ((upId, wx2)) = AddGn wx1, "{name}_fired", (if bundled: OutUnit else: outTy), GnNamed, 0
    let rowName = "{wx.node}Arm{RowSuffix wx}"
    let ((rows, wx3)) = Fold (Range0 (Len bodies)), (([[]], wx2)), \|((acc, w)), i|
        let cr = ArmRowOf w, menv, lx, [[(Or pats[i], nil)]], [[sty]], (Or guards[i], nil), (Or bodies[i], dummyBlockS), "{rowName}{i}", name, True, True, (OutWeak wx.node), [[]], ups, [[]], False
        (((Push acc, cr), cr.parent))
    let width = Fold rows, 0, \|acc, cr| Max acc, cr.width
    let cases = Each rows, \|cr| cr.case
    let isDyn = layer == LyDyn
    let plainRows = Filter rows, \|cr| IsSome cr.?plain
    let allPlain = (Len plainRows) == (Len rows)
    let res = "{name}_res"
    let tail = Append (Append [[(XWeak XSelf)]], (HostedPassed wx)), [[XCx]]
    let rowObj = OutObj (OutNamed (RefRuntime "rt::Row"), [[]])
    # an arm's dynamic result kept by the block (`DynClauseLine`)
    let kept = DoAssign (XDeref (XMethod (XField XSelf, res), "borrow_mut", [[]])), (XCtor (RefRuntime "std::Some"), [[(XMethod (XVar "row"), "result_dynamic", [[]])]])
    # an arm's plain result kept by the block
    let keptPlain = DoAssign (XDeref (XMethod (XField XSelf, res), "borrow_mut", [[]])), (XCtor (RefRuntime "std::Some"), [[(XMethod (XVar "row"), "result_value", [[]])]])
    let gaps = RowGaps rows, width
    let bundle = if bundled: KeepParts wx3, name, (RowsBundle rows), (BundlePartTys outFull) else: KeptParts(wx=wx3, keeps=[[]], results=[[]])
    let arms = Fold cases, [[]], \|built, c|
        let i = Len built
        let made = TryOf (XCall (RefChild (SiteRef lx, c.node.name), "build"), (Append (Append [[(XClone (XVar "path"))]], c.passed), tail))
        let set = GapSet name, (Or gaps[i], nil)
        let keeps = Append (Append (if isDyn: [[kept]] else: if allPlain: [[keptPlain]] else: [[]]), bundle.keeps), set
        let body = if (Len keeps) == 0: XCast made, rowObj else: XBlock (Append [[(DoLet (PaBind "row"), made)]], keeps), (XCast (XVar "row"), rowObj)
        Push built, (XArm(pat=c.pat, conds=c.conds, body=body))
    let select = WithRowBase wx, "self", pos, (Own (ArmsValue (XTuple [[scrut]]), arms, "'select", (OutObj (OutNamed (RefRuntime "rt::Row"), [[]]))))
    let wx4 = update bundle.wx:
        &_.pos <= Pos(scope=pos.scope, at=pos.at + width)
        &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, at=(PlaceAt wx, "self", pos), source=(XUnit), valueTy=OutUnit, select=select, transparent=True, width=width, moved=(Or (?HostedRows wx), ""), early=False, gappy=(IsGappy gaps), rebased=False)
        &_.genHolds <= Push &_.genHolds, ((name, [[]]))
        &_.rows <= Fold cases, &_.rows, \|acc, gc| Append (Push acc, gc.node), gc.node.children
        &_.getters <= Push &_.getters, (GenUp name, (GnOf wx3, upId).name, (GnOf wx3, upId).ty)
    if bundled: ((wx4, (WrParts bundle.results)))
    else: if isDyn: KeptDynResult wx4, name, rows
    else: if (Len plainRows) > 0:
        if allPlain:
            let read = XClone (XMethod (XMethod (XMethod (XField XSelf, res), "borrow", [[]]), "as_ref", [[]]), "expect", [[(XStr "an arm built before what reads its result")]])
            let wx5 = update wx4:
                &_.taken <= Push &_.taken, res
                &_.fields <= Push &_.fields, ((res, (OutCell (OutOpt outTy)), "the arm's plain result, kept from its build on"))
                &_.inits <= Push &_.inits, ((res, (XCall (RefRuntime "std::RefCell::new"), [[XNone]])))
            ((wx5, (WrLate read, outTy)))
        else:
            let wx5 = update wx4:
                &_.build <= Push &_.build, (InternalBugDo "a building `match` or `if` whose arms do not all end on a plain result")
            ((wx5, WrUnit))
    else: if outTy == OutUnit: ((wx4, WrUnit)) else: ((wx4, (WrEv (EvRefOf wx4, upId))))

# A generation's dynamic result kept by the block in `{name}_res` (a static clause's, an arm
# of a building `match`'s): the line's getter reads it at the read point; a write behind it
# in the row marks the block's readers (`{name}_result_moved`), and a write of the block's
# own behind it marks them as any write of the block's does.
KeptDynResult: fn Wx, Text, [ClauseRow] -> ((Wx, Wres))
fn KeptDynResult wx, name, rows:
    let t = match (Or (Each rows, \|cr| cr.?resultTy)[0], nil):
        ? x: x
        nil: OutUnit
    KeptDyn wx, name, t, (Fold rows, [[]], \|acc, cr| UnionReads acc, cr.resultReads)

# A row's dynamic the block keeps in `{name}_res`: its type, and what it reads of the
# block (the rows' reads through their parent).
KeptDyn: fn Wx, Text, OutTy, [Read] -> ((Wx, Wres))
fn KeptDyn wx, name, t, parentReads:
    let res = "{name}_res"
    let getter = "{name}_value"
    let behind = Fold parentReads, [[OwnRead res]], \|a, rd| match rd:
        ParentRead m: AddRead a, (OwnRead m)
        OwnRead m: AddRead a, (OwnRead m)
    let read = XMethod (XMethod (XMethod (XMethod (XField XSelf, res), "borrow", [[]]), "as_ref", [[]]), "expect", [[(XStr "a generation built with its block")]]), "sample", [[XCx]]
    let wx2 = update wx:
        &_.taken <= Append &_.taken, [[res, getter, "{name}_result_moved"]]
        &_.fields <= Push &_.fields, ((res, (OutCell (OutOpt (OutDyn t))), "the generation's dynamic result"))
        &_.inits <= Push &_.inits, ((res, (XCall (RefRuntime "std::RefCell::new"), [[XNone]])))
        &_.getters <= Push &_.getters, (MethDef(name=getter, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=read, doc="The generation's dynamic result at the read point."))
        &_.dynReads <= Insert &_.dynReads, getter, behind
        &_.clauseResults <= Push &_.clauseResults, name
    ((wx2, (WrDyn (XMethod (XSelf), getter, [[XCx]]), [[OwnRead getter]], t)))

# `match s:` with building arms.
MatchGenLine: unbounded fn Wx, Env, Expr, [Arm], Expr -> ((Wx, Wres))
fn MatchGenLine wx, menv, s, arms, e = BuildingChoiceLine wx, menv, (Argument wx.lx, menv, s), (Each arms, \|a| a.?pattern), (TypeAt wx.lx, s.span), (Each arms, \|a| a.?guard), (Each arms, \|a| a.body), (ChoiceOutTy wx.lx, e), (ResultLayer (TypeAt wx.lx, e.span)), (LineOutFull wx.lx, e), [[]]

# What a building `match` or `if` gives back, lowered.
ChoiceOutTy: unbounded fn Lx, Expr -> OutTy
fn ChoiceOutTy lx, e = OutTyOf lx, (OutOf (TypeAt lx, e.span))

# `if c:` and `if p <- x:` with building arms: the condition a guard, or the pattern
# matched against `x`.
IfGenLine: unbounded fn Wx, Env, Cond, Block, Block, Expr -> ((Wx, Wres))
fn IfGenLine wx, menv, c, thenB, elseB, e = match c:
    CondExpr x: BuildingChoiceLine wx, menv, (XUnit), [[nil, nil]], (TyCon "unit", [[]]), [[(? x), nil]], [[thenB, elseB]], (ChoiceOutTy wx.lx, e), (ResultLayer (TypeAt wx.lx, e.span)), (LineOutFull wx.lx, e), [[]]
    CondBind p, x, ?g: BuildingChoiceLine wx, menv, (Argument wx.lx, menv, x), [[(? p), nil]], (TypeAt wx.lx, x.span), [[?g, nil]], [[thenB, elseB]], (ChoiceOutTy wx.lx, e), (ResultLayer (TypeAt wx.lx, e.span)), (LineOutFull wx.lx, e), [[]]

let dummyBlockS = Block(stmts=[[]], inline=True, span=Range(start=0, end=0))

type GenRow = record:
    node: NodeDef
    parent: Wx
    # The generation's result when it is a dynamic: its type (the row has `result` and
    # `result_dynamic`); when it is a plain value, its type (the row has `result_value`).
    ?dynResult: OutTy
    ?plainResult: OutTy

# A generation's node: its `_` a plain field, the block's events it names through ports,
# its result forwarded up to the `rebuild`'s.
GenRowOf: unbounded fn Wx, Env, Block, OutTy, Text, Text -> GenRow
fn GenRowOf wx, menv, body, vt, rowName, genName:
    let lx = wx.lx
    let upName = "{genName}_up"
    let r00 = NewWx lx, rowName, [[(("value", vt, "the generation's value, `_`")), (("parent", (OutWeak wx.node), "the node of the `rebuild`"))]], [[(("value", (XClone (XVar "value"))))]], [[(("parent", (XClone (XVar "parent"))))]], [[]], {}, (Append nodeHooks, [["value", "parent", "result", "result_dynamic"]]), wx.inlining, (?HostedRows wx)
    # a block that ends on a bundle gives it as one value (`WholeResultOf`)
    let r0 = update (GenCurrent r00, wx, genName):
        &_.wholeResultAt <= BundleResultKey lx, body
    let ((p1, r1, ports)) = RowEnv wx, r0, menv, body
    let be = Bind (BuildSpelling ports), "_", (BnLocal (XVar "value"), Owned, vt)
    let me = Bind ports, "_", (BnLocal (XField XSelf, "value"), Owned, vt)
    let r2 = BlockInto r1, be, me, body
    let ((r3, ?dynResult, ?plainResult)) = match r2.result:
        WrEv r: (((Connect r2, r, (SkUp upName)), nil, nil))
        WrDyn ex, resultReads, rt: (((GenResult r2, genName, ex, resultReads, rt), ? rt, nil))
        # a plain result: computed at the generation's build, kept in a field of the row
        WrPlain ex, rt:
            let ((f, rf)) = FreshName r2, "result"
            let r2p = update rf:
                &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind f), rt), ex)
                &_.fields <= Push &_.fields, ((f, rt, "the generation's plain result"))
                &_.inits <= Push &_.inits, ((f, (XClone (XVar f))))
                &_.getters <= Push &_.getters, (MethDef(name="result_value", recv=RecvRef, params=[[]], cx=CxNone, ret=rt, body=[[]], tail=(XClone (XField XSelf, f)), doc="The generation's plain result, which the `rebuild`'s dynamic is while the generation stands."))
            ((r2p, nil, ? rt))
        WrLate ex, rt: (((update r2:
            &_.getters <= Push &_.getters, (MethDef(name="result_value", recv=RecvRef, params=[[]], cx=CxNone, ret=rt, body=[[]], tail=ex, doc="The generation's plain result, which the `rebuild`'s dynamic is while the generation stands."))), nil, ? rt))
        WrParts ignore:
            let r2b = update r2:
                &_.build <= Push &_.build, (RefusalDo "a `rebuild` whose block ends on a bundle that is not written out as a tuple where the block ends")
            ((r2b, nil, nil))
        otherwise: ((r2, nil, nil))
    let r4 = GenHears r3, genName
    GenRow(node=(FinishNode r4, rowName, (Append [[(("value", vt)), (("parent", (OutWeak wx.node)))]], (HostedParams wx)), True), parent=(GenMarked p1, genName, r3), ?dynResult=?dynResult, ?plainResult=?plainResult)

# A generation's dynamic result (a `rebuild` handing back `$$a`): the getter `result`, the
# `Dynamic` the block keeps of it, and the block told through `{genName}_result_moved` when
# a hold of the generation's own behind it is written.
GenResult: fn Wx, Text, Ex, [Read], OutTy -> Wx
fn GenResult r, genName, ex, resultReads, rt = GenResultNamed r, "result", "result_dynamic", "{genName}_result_moved", ex, resultReads, rt

# The same under the names given: the getter, the `Dynamic` of it, and the block's method
# a write behind it calls (a bundle's dynamic parts each have their own, `RowPartOut`).
GenResultNamed: fn Wx, Text, Text, Text, Ex, [Read], OutTy -> Wx
fn GenResultNamed r, getter, dynamic, moved, ex, resultReads, rt:
    let ownBehind = Filter (ReadsClosed r.dynReads, resultReads), \|rd| match rd:
        OwnRead ignore: True
        ParentRead ignore: False
    let made = XCall (RefRuntime "rt::Dynamic::of"), [[(XClosure True, [[PaBind "cx"]], (XMethod (XVar "me"), getter, [[XCx]])), (XRef (XCall (RefRuntime "std::Rc::new"), [[(XCall (RefRuntime "rt::Port::new"), [[]])]]))]]
    let doc = "The generation's result as a dynamic, which the block keeps while the generation is current; the block hears it move through `{moved}`, not through the dynamic's port."
    update r:
        &_.getters <= Append &_.getters, [[(MethDef(name=getter, recv=RecvRef, params=[[]], cx=CxRef, ret=rt, body=[[]], tail=ex, doc="The generation's result, which its block reads.")), (MethDef(name=dynamic, recv=RecvRc, params=[[]], cx=CxNone, ret=(OutDyn rt), body=[[(DoLet (PaBind "me"), (XClone XSelf))]], tail=made, doc=doc))]]
        &_.resultMoved <= if (Len ownBehind) > 0: Push &_.resultMoved, ((moved, ownBehind)) else: &_.resultMoved

# A bundle a row hands its block, part by part (Type System ch. 2, "Bundles and sparse
# tuples"): what each part is, by its place in the bundle (`p0`, `p1`, inside a bundle of
# the bundle `p1_0`).
type RowPart = choice:
    # an event: the row fires the block's `{generation}_{place}_up`
    RowPartEvent Text
    # a dynamic: the row's `result_{place}` and `result_dynamic_{place}`, its type, and
    # what it reads of the block
    RowPartDynamic Text, OutTy, [Read]
    # a plain value: the row's `result_value_{place}`, and its type
    RowPartPlain Text, OutTy
    RowPartNothing
    RowPartParts [RowPart]
derive ^Eq, ^Show

# The row's side of a bundle: each event part fires up, each dynamic part has its getter,
# its `Dynamic` and the block's method a write behind it calls, each plain part is kept in
# a field (a late one read from the row itself, its own rows built by then).
RowPartsOut: unbounded fn Wx, Text, Text, [Wres] -> ((Wx, [RowPart]))
fn RowPartsOut r, genName, prefix, parts = Fold (Range0 (Len parts)), ((r, [[]])), \|((w, acc)), i|
    let place = if prefix == "": "p{i}" else: "{prefix}_{i}"
    let ((w2, part)) = RowPartOut w, genName, place, (Or parts[i], WrUnit)
    ((w2, (Push acc, part)))

RowPartOut: unbounded fn Wx, Text, Text, Wres -> ((Wx, RowPart))
fn RowPartOut r, genName, place, part = match part:
    WrEv er: (((Connect r, er, (SkUp "{genName}_{place}_up")), (RowPartEvent place)))
    WrDyn ex, rds, rt:
        let parentReads = Filter (ReadsClosed r.dynReads, rds), \|rd| IsParentRead rd
        (((GenResultNamed r, "result_{place}", "result_dynamic_{place}", "{genName}_{place}_result_moved", ex, rds, rt), (RowPartDynamic place, rt, parentReads)))
    WrPlain ex, rt:
        let ((f, rf)) = FreshName r, "result"
        let r2 = update rf:
            &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind f), rt), ex)
            &_.fields <= Push &_.fields, ((f, rt, "a plain part of the row's bundle"))
            &_.inits <= Push &_.inits, ((f, (XClone (XVar f))))
            &_.getters <= Push &_.getters, (MethDef(name="result_value_{place}", recv=RecvRef, params=[[]], cx=CxNone, ret=rt, body=[[]], tail=(XClone (XField XSelf, f)), doc="A plain part of the row's bundle, which the block that built the row reads."))
        ((r2, (RowPartPlain place, rt)))
    WrLate ex, rt: (((update r:
        &_.getters <= Push &_.getters, (MethDef(name="result_value_{place}", recv=RecvRef, params=[[]], cx=CxNone, ret=rt, body=[[]], tail=ex, doc="A plain part of the row's bundle, which the block that built the row reads."))), (RowPartPlain place, rt)))
    WrParts inner:
        let ((r2, ps)) = RowPartsOut r, genName, place, inner
        ((r2, (RowPartParts ps)))
    WrHosted inner, ignore: RowPartOut r, genName, place, inner
    WrUnit: ((r, RowPartNothing))

# The bundle the rows of one generation hand their block: the first row's parts, a
# dynamic part reading of the block what any row's reads.
RowsBundle: unbounded fn [ClauseRow] -> [RowPart]
fn RowsBundle rows = Fold rows, (Or (Each rows, \|cr| cr.parts)[0], [[]]), \|acc, cr| MergeRowParts acc, cr.parts

MergeRowParts: unbounded fn [RowPart], [RowPart] -> [RowPart]
fn MergeRowParts xs, ys = Each (Range0 (Len xs)), \|i| match (((Or xs[i], RowPartNothing), (Or ys[i], RowPartNothing))):
    (((RowPartDynamic place, t, a), (RowPartDynamic ignore, ignore, b))): RowPartDynamic place, t, (UnionReads a, b)
    (((RowPartParts a), (RowPartParts b))): RowPartParts (MergeRowParts a, b)
    ((x, ignore)): x

# The block's side of a row's bundle: the results its line gives, and what the block
# does where the row just built is the local `row`.
type KeptParts = record:
    wx: Wx
    keeps: [Do]
    results: [Wres]

# Each part kept by the block of the generation `name`: an event part is a node of the
# block's graph the row fires through `{name}_{place}_up`; a dynamic part is kept in
# `{name}_{place}_res` and read through its getter, a write behind it in the row marking
# the block's readers (`KeptDyn`); a plain part is kept in `{name}_{place}_res` from the
# row's build on, late (`WrLate`). `tys`: the parts' types as the checker has them.
KeepParts: unbounded fn Wx, Text, [RowPart], [Ty] -> KeptParts
fn KeepParts wx, name, parts, tys = Fold (Range0 (Len parts)), (KeptParts(wx=wx, keeps=[[]], results=[[]])), \|acc, i|
    let ((w, keeps, res)) = KeepPart acc.wx, name, (Or parts[i], RowPartNothing), (Or tys[i], TyErr)
    KeptParts(wx=w, keeps=(Append acc.keeps, keeps), results=(Push acc.results, res))

KeepPart: unbounded fn Wx, Text, RowPart, Ty -> ((Wx, [Do], Wres))
fn KeepPart wx, name, part, ty = match part:
    RowPartEvent place:
        let et = OutTyOf wx.lx, (Peel ty)
        let fired = "{name}_{place}_fired"
        let ((id, w1)) = AddGn wx, fired, et, GnNamed, 0
        let w2 = update w1:
            &_.taken <= Append &_.taken, [[fired, "{name}_{place}_up"]]
            &_.getters <= Push &_.getters, (MethDef(name="{name}_{place}_up", recv=RecvRc, params=[[(("v", et))]], cx=CxMut, ret=OutUnit, body=[[(SelfCall fired, [[(XVar "v")]])]], tail=(XUnit), doc="An event part of the generation's bundle fires the line's event."))
        ((w2, [[]], (WrEv (EvRefOf w2, id))))
    RowPartDynamic place, t, reads:
        let ((w1, res)) = KeptDyn wx, "{name}_{place}", t, reads
        let kept = DoAssign (XDeref (XMethod (XField XSelf, "{name}_{place}_res"), "borrow_mut", [[]])), (XCtor (RefRuntime "std::Some"), [[(XMethod (XVar "row"), "result_dynamic_{place}", [[]])]])
        ((w1, [[kept]], res))
    RowPartPlain place, t:
        let res = "{name}_{place}_res"
        let kept = DoAssign (XDeref (XMethod (XField XSelf, res), "borrow_mut", [[]])), (XCtor (RefRuntime "std::Some"), [[(XMethod (XVar "row"), "result_value_{place}", [[]])]])
        let read = XClone (XMethod (XMethod (XMethod (XField XSelf, res), "borrow", [[]]), "as_ref", [[]]), "expect", [[(XStr "a row built before what reads its result")]])
        let w1 = update wx:
            &_.taken <= Push &_.taken, res
            &_.fields <= Push &_.fields, ((res, (OutCell (OutOpt t)), "a plain part of the generation's bundle, kept from the row's build on"))
            &_.inits <= Push &_.inits, ((res, (XCall (RefRuntime "std::RefCell::new"), [[XNone]])))
        ((w1, [[kept]], (WrLate read, t)))
    RowPartParts inner:
        let kept = KeepParts wx, name, inner, (BundlePartTys ty)
        ((kept.wx, kept.keeps, (WrParts kept.results)))
    RowPartNothing: ((wx, [[]], WrUnit))

# The place of the expression a block ends on with `@`, when that is a bundle: the key
# `WholeResultOf` knows the result line by; "" otherwise.
BundleResultKey: fn Lx, Block -> Text
fn BundleResultKey lx, body = match (Or body.stmts[Dec (Len body.stmts)], dummyStmtL).kind:
    SExpr y: match y.kind:
        EFreeSigil "@", x: if IsBundle (TypeAt lx, x.span): ResultKey lx, x else: ""
        otherwise: ""
    otherwise: ""

ResultKey: fn Lx, Expr -> Text
fn ResultKey lx, x = "{lx.file}:{x.span.start}:{x.span.end}"

# The block's writes behind what a generation's places read mark the generation (gap DY;
# `RowMarks` of kind `GenerationRow`: the current one is dirtied), and the block's names the
# generation hears a write behind (`RowHears`: what its `!Updated` nodes and its own
# builders read through the parent) tell the current one through `parent_wrote_{m}`, as a
# `for` row is told (pick RE). A generation the block replaces in the same tick builds
# nothing (`GenCurrent`): its builders stand until it is replaced (`sem-ch07-paged`).
GenMarked: fn Wx, Text, Wx -> Wx
fn GenMarked parent, genName, rowWx:
    let reads = RowPlaceReads rowWx
    let hears = UpdatedHears rowWx
    let builds = Filter (RowHears rowWx), \|m| not (HasText hears, m)
    let ported = Fold (Append hears, builds), parent, \|w, m| AddField w, "{genName}_wrote_{m}_port", (OutPort OutUnit), "the current generation of `{genName}` hears a write behind `{m}`", (XCall (RefRuntime "rt::Port::new"), [[]])
    if (Len reads) == 0 and (Len hears) == 0 and (Len builds) == 0: parent
    else: update ported:
        &_.rowMarks <= Push &_.rowMarks, RowMarks(builder=genName, reads=reads, wrote=hears, builds=builds, kind=GenerationRow)

# A generation's side of `GenMarked`: the block holds the current generation as a `Row`,
# which names no method of it, so each name it hears is a port of the block,
# `{genName}_wrote_{m}`, the generation subscribes to (`subscribe_row`, as a row hears a
# block's event), its firing heard by `wrote_{m}` as `parent_wrote_{m}`.
GenHears: fn Wx, Text -> Wx
fn GenHears r, genName = Fold (RowHears r), r, \|w, m| update w:
    &_.subs <= Push &_.subs, (("{genName}_wrote_{m}", "wrote_{m}", OutUnit))
    &_.taken <= Push &_.taken, "wrote_{m}"
    &_.getters <= Push &_.getters, (MethDef(name="wrote_{m}", recv=RecvRc, params=[[(("v", OutUnit))]], cx=CxMut, ret=OutUnit, body=[[DoExpr (XMethod (XSelf), "parent_wrote_{m}", [[XCx]])]], tail=(XUnit), doc="The block wrote behind its `{m}`: as `parent_wrote_{m}`."))

# Whether a generation is still its block's current one after the tick: it has not left
# (`left`, set as its places are torn down), the block will not replace it at the build
# (its `{genName}_stale`), and a generation block is current in turn. A write behind a name
# both the `rebuild`'s source and the generation's builders read lists both for the build,
# in either order; the generation's build runs only while it is current, so a generation
# the tick replaces builds nothing (Semantics ch. 7: the old generation runs to the end of
# the tick, and the build comes after it).
GenCurrent: fn Wx, Wx, Text -> Wx
fn GenCurrent r, parent, genName:
    let stale = XMethod (XField parentRef, "{genName}_stale"), "get", [[]]
    let blockCurrent = if parent.genOf == "": XUnary OpNot, stale else: XBin OpAnd, (XUnary OpNot, stale), (XMethod parentRef, "current", [[]])
    let tail = XBin OpAnd, (XUnary OpNot, (XMethod (XField XSelf, "left"), "get", [[]])), blockCurrent
    let r2 = AddField r, "left", (OutNamed (RefRuntime "std::Cell"), [[OutBool]]), "the generation left: its block replaced it", (XCall (RefRuntime "std::Cell::new"), [[XBool False]])
    update r2:
        &_.genOf <= genName
        &_.taken <= Append &_.taken, [["left", "current"]]
        &_.getters <= Push &_.getters, (MethDef(name="current", recv=RecvRef, params=[[]], cx=CxNone, ret=OutBool, body=[[]], tail=tail, doc="Whether this generation is still its block's current one after the tick: it builds only then."))

# A row's names as its constructor spells them: the block through the `parent` argument.
BuildSpelling: fn Env -> Env
fn BuildSpelling env = Fold (Keys env.names), env, \|en, k| match env.names[k]:
    ? (BnLocal rs, mode, t): match ?ThroughParent rs:
        ? x: Bind en, k, (BnLocal x, mode, t)
        nil: en
    ? (BnDyn (XMethod rs, m, xs), ds, t): match ?ThroughParent rs:
        ? x: Bind en, k, (BnDyn (XMethod x, m, xs), ds, t)
        nil: en
    ? (BnParts bs): Bind en, k, (BnParts (PartsAtBuild bs))
    otherwise: en

# A named bundle's parts as a row's constructor spells them (`BuildSpelling`).
# (A bundle inside the bundle keeps its parts as they are.)
PartsAtBuild: fn [?Bn] -> [?Bn]
fn PartsAtBuild parts = Each parts, \|?b| ?PartSpelledAtBuild ?b

?PartSpelledAtBuild: fn ?Bn -> ?Bn
fn ?PartSpelledAtBuild ?b = match ?b:
    ? (BnLocal rs, mode, t): match ?ThroughParent rs:
        ? x: ? (BnLocal x, mode, t)
        nil: ?b
    otherwise: ?b

# The generation built: the one case, its row's constructor. `ofRebuild`: the clause
# call is a `rebuild`'s whole block, so its `_` is the builder's `value`; a static
# clause call reads its arguments as the block's methods do.
GenSelect: unbounded fn Wx, Env, Block, [GenCase], Pos, [ [Do] ], Bool -> Ex
fn GenSelect wx, menv, body, cases, pos, sets, ofRebuild:
    let tail = Append (Append [[(XWeak XSelf)]], (HostedPassed wx)), [[XCx]]
    match ?ClauseCall wx.lx, body:
        nil: match cases[0]:
            ? c: TryOf (XCall (RefChild (SiteRef wx.lx, c.node.name), "build"), (Append [[(XVar "path"), (XVar "value")]], tail))
            nil: InternalBug "a `rebuild` with no generation"
        ? ((qk, args)):
            let env = if ofRebuild: Bind menv, "_", (BnLocal (XVar "value"), Owned, OutUnit) else: menv
            let scrut = ClauseScrutinee wx.lx, env, (ValOf wx.lx, qk), args
            let rowObj = OutObj (OutNamed (RefRuntime "rt::Row"), [[]])
            let arms = Fold cases, [[]], \|built, c|
                let i = Len built
                let made = TryOf (XCall (RefChild (SiteRef wx.lx, c.node.name), "build"), (Append (Append [[(XClone (XVar "path"))]], c.passed), tail))
                # what the row left unbuilt, kept by the block (`GapSet`)
                let set = Or sets[i], [[]]
                Push built, (XArm(pat=c.pat, conds=c.conds, body=(if (Len set) == 0: XCast made, rowObj else: XBlock (Append [[(DoLet (PaBind "row"), made)]], set), (XCast (XVar "row"), rowObj))))
            Own (ArmsValue scrut, arms, "'select", (OutObj (OutNamed (RefRuntime "rt::Row"), [[]])))

# What each row of a transparent generation leaves unbuilt of the generation's `width`
# positions (ruling TC), read where the row is the local `row`: its own shortfall and
# what its own generations left; `nil` for a row that builds every position.
RowGaps: fn [ClauseRow], Nat -> [?Ex]
fn RowGaps rows, width = Each rows, \|cr|
    let short = Or (width -? cr.width), 0
    if cr.inner: ? (XBin OpAdd, (XIndex short), (XMethod (XVar "row"), "inner_gap", [[]]))
    else: if short > 0: ? (XIndex short) else: nil

IsGappy: fn [?Ex] -> Bool
fn IsGappy gaps = Fold gaps, False, \|f, ?g| f or IsSome ?g

# The block keeps what the row it built left unbuilt (`GenDef.gappy`).
GapSet: fn Text, ?Ex -> [Do]
fn GapSet name, (? x) = [[DoExpr (XMethod (XField XSelf, "{name}_gap"), "set", [[x]])]]
fn GapSet name, nil = [[]]

# A transparent generation's rows are built with where the generation's first position
# stands as built, `row_base` (`ArmRowOf`): `recv` as `PlaceNumber` takes it.
WithRowBase: fn Wx, Text, Pos, Ex -> Ex
fn WithRowBase wx, recv, pos, select = XBlock [[(DoLet (PaBind "row_base"), (PlaceNumber wx, recv, pos))]], select

# The `rebuild`'s up-forwarding: a generation's result fires the block's event.
GenUp: fn Text, Text, OutTy -> MethDef
fn GenUp name, upName, t = MethDef(name="{name}_up", recv=RecvRc, params=[[(("v", t))]], cx=CxMut, ret=OutUnit, body=[[(SelfCall upName, [[(XVar "v")]])]], tail=(XUnit), doc="The current generation's result fires the `rebuild`'s.")

# The answers a generation's places get through the block: under `pos/#g` to the current
# generation; for a transparent one, at each of its positions in the block, whole.
GenForwards: fn GenDef -> [((Pa, Ex))]
fn GenForwards gd:
    if IsWideGen gd: [[]]
    else: if gd.transparent: Each (Range0 gd.width), \|i|
        let current = XClone (XMethod (XField XSelf, "{gd.name}"), "borrow", [[]])
        let body = XBlock [[(DoLet (PaBind "row"), current), (DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "row"]]), (XVar "row"), [[DoExpr (TryOf (XMethod (XVar "row"), "answer", [[(XVar "at"), (XVar "v"), XCx]]))]], [[]])]], (XUnit)
        (((PosPat (Pos(scope=gd.pos.scope, at=gd.pos.at + i)), [[PaRest ""]]), body))
    else: [[(((PosPat gd.pos, genTail), (ForwardGen gd)))]]

# A transparent generation that holds a call of a widget that calls itself, or is one
# (`SharedClauseLine`): too wide for an arm per position.
IsWideGen: fn GenDef -> Bool
fn IsWideGen gd = gd.transparent and gd.width >= wideGeneration

# The answers the node's wide generations get, in one last arm over any path: the
# generation whose positions the answer's first segment is among hands it on, to a
# shared row with the position counted from the generation's first (`rebased`); an
# answer among none is at no place.
WideForward: fn [GenDef] -> [((Pa, Ex))]
fn WideForward gens:
    let none = [[(DoReturn (XCtor (RefRuntime "std::Err"), [[(XCall (RefRuntime "rt::Fault::answer"), [[(XStr "no answering place at this position")]])]]))]]
    let chain = Fold gens, none, \|rest, gd|
        let current = XClone (XMethod (XField XSelf, "{gd.name}"), "borrow", [[]])
        let moved = if gd.rebased: [[(DoLet (PaBind "rebased"), (XCall (HelperRef "rebased"), [[(XVar "at"), (XIndex gd.pos.at)]]))]] else: [[]]
        let path = if gd.rebased: XCall (HelperRef "segments_of"), [[XRef (XVar "rebased")]] else: XVar "at"
        let handed = Append moved, [[(DoLet (PaBind "row"), current), (DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "row"]]), (XVar "row"), [[DoExpr (TryOf (XMethod (XVar "row"), "answer", [[path, (XVar "v"), XCx]]))]], [[]])]]
        [[(DoIf (XCall (HelperRef "within_positions"), [[(XVar "at"), (XIndex gd.pos.at), (XIndex gd.width)]]), handed, rest)]]
    if (Len gens) == 0: [[]] else: [[(((PaSlice [[PaRest ""]]), (XBlock chain, (XUnit))))]]

ForwardGen: fn GenDef -> Ex
fn ForwardGen gd:
    let current = XClone (XMethod (XField XSelf, "{gd.name}"), "borrow", [[]])
    let isCurrent = XBin OpEq, (XBin OpAdd, (XDeref (XVar "g")), (XIndex 1)), (XMethod (XField XSelf, "{gd.name}_count"), "get", [[]])
    XBlock [[(DoLet (PaBind "row"), current), (DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "row"]]), (XVar "row"), [[(DoIf isCurrent, [[DoExpr (TryOf (XMethod (XVar "row"), "answer", [[(XVar "rest"), (XVar "v"), XCx]]))]], [[]])]], [[]])]], (XUnit)

# `@Flatten $$x` over a `rebuild`'s dynamic `$$x` (claude/backend.md, "Dynamic structure";
# Semantics ch. 7): a field with the current inner, a hold of the generation's `Dynamic`,
# adopted at the build from the `rebuild`'s dynamic and afterwards among the first firings
# of the tick after the one in which the `rebuild`'s dynamic moved (`MovedBy`); the
# `@Flatten`'s dynamic samples the inner at the read point, so after n it has the value
# after n of the inner its outer held after n-1.
FlattenLine: unbounded fn Wx, Env, [Arg], ?Bn -> ((Wx, Wres))
fn FlattenLine wx, menv, args, ?bound:
    let ?named = match args[0]:
        ? a: match a.value.kind:
            EName n: match menv.names[SNameKey n]:
                ? (BnDyn (XMethod (XSelf), m, ignore), ignore, (OutDyn t)): ? ((m, t))
                otherwise: nil
            otherwise: nil
        nil: nil
    let ?outer = match ?named:
        ? ((m, t)): Fold wx.gens, nil, \|?acc, gd| if "{gd.name}_result" == m: ? ((m, gd.name, t)) else: ?acc
        nil: nil
    match ?outer:
        nil: match args[0]:
            ? a: HeldFlatten wx, menv, a.value, ?bound
            nil: ((wx, WrUnit))
        ? ((m, gen, t)):
            let ((name, wx1)) = match ?bound:
                ? (BnHold f, ignore): ((f, wx))
                # bound as a widget's result (`IsGetterBuiltin`): the getter the name was pre-bound to
                ? (BnDyn (XMethod (XSelf), f, ignore), ignore, ignore): ((f, wx))
                otherwise: FreshName wx, "flatten"
            let inner = "{name}_inner"
            let first = DoExpr (XMethod (XField (XVar "node"), "{inner}"), "set", [[(XCtor (RefRuntime "std::Some"), [[(XMethod (XVar "node"), m, [[XCx]])]]), XCx]])
            let sample = XMethod (XMethod (XMethod (XField XSelf, "{inner}"), "get", [[XCx]]), "expect", [[(XStr "`@Flatten` adopts its first inner at the build")]]), "sample", [[XCx]]
            let wx2 = update wx1:
                &_.taken <= Append &_.taken, [[inner, "{name}_adopt"]]
                &_.fields <= Push &_.fields, ((inner, (OutHold (OutOpt (OutDyn t))), "`@Flatten`'s current inner: the dynamic of the generation it adopted"))
                &_.moves <= Push &_.moves, ((inner, (XCall (RefRuntime "rt::Hold::new"), [[XNone, XCx]])))
                &_.build <= Push &_.build, first
                &_.getters <= Push &_.getters, (MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=sample, doc="`@Flatten`'s dynamic: its current inner at the read point."))
                &_.dynReads <= Insert &_.dynReads, name, [[OwnRead inner]]
                &_.flattens <= Push &_.flattens, FlatDef(name=name, outer=m, generation=gen, held=False, ty=t)
            ((wx2, (WrDyn (XMethod (XSelf), name, [[XCx]]), [[OwnRead inner]], t)))

# `@Flatten $$x` over any other dynamic of dynamics (Semantics Appendix B; the Compiler
# seed, `@Flatten`; the coordinator's ruling FV): `$$x` is the live dynamic its line made
# (`WholeArgs`), a `Dynamic` of `Dynamic`s, whose update event the flatten follows
# (`{name}_ofollow`). Its firing at n queues the adoption for the first firings of n+1,
# owed (`Adoption`), which takes the inner the outer holds after n, follows that inner's
# update event (`{name}_follow`) and fires as a write of the inner does. No dynamics are
# compared: an adoption of the same inner fires again. It shares the `rebuild` flatten's
# mechanism (`Adoption`, `Cx::answer_later`) rather than the swap list: the flatten fires
# at n+1 with no input of its own, so that tick must be owed, and nothing of the outer's
# write at n reaches n's own propagation (the Compiler seed, "No prompt binding").
HeldFlatten: unbounded fn Wx, Env, Expr, ?Bn -> ((Wx, Wres))
fn HeldFlatten wx, menv, x, ?bound:
    let t = OutTyOf wx.lx, (Peel (Peel (TypeAt wx.lx, x.span)))
    match menv.names["#whole{DynKey x}"]:
        ? (BnLocal (XField (XSelf), dyn), ignore, ignore):
            let ((name, wx1)) = match ?bound:
                ? (BnHold f, ignore): ((f, wx))
                # bound as a widget's result (`IsGetterBuiltin`): the getter the name was pre-bound to
                ? (BnDyn (XMethod (XSelf), f, ignore), ignore, ignore): ((f, wx))
                otherwise: FreshName wx, "flatten"
            let inner = "{name}_inner"
            let follow = "{name}_follow"
            let ofollow = "{name}_ofollow"
            let innerNow = XMethod (XMethod (XField (XVar "node"), inner), "get", [[XCx]]), "expect", [[(XStr "`@Flatten` adopts its first inner at the build")]]
            let followed = DoExpr (XMethod (XField (XVar "node"), follow), "follow", [[(XRef (XField innerNow, "updates")), (XRef (XVar "node")), (XPath (RefChild (SiteRef wx.lx, wx.node), "{name}_moved"))]])
            let ofollowed = DoExpr (XMethod (XField (XVar "node"), ofollow), "follow", [[(XRef (XField (XField (XVar "node"), dyn), "updates")), (XRef (XVar "node")), (XPath (RefChild (SiteRef wx.lx, wx.node), "{name}_outer_moved"))]])
            let sample = XMethod (XMethod (XMethod (XField XSelf, "{inner}"), "get", [[XCx]]), "expect", [[(XStr "`@Flatten` adopts its first inner at the build")]]), "sample", [[XCx]]
            let followTy = OutNamed (RefRuntime "prism_rtl::Follow"), [[]]
            let wx2 = update wx1:
                &_.taken <= Append &_.taken, [[inner, follow, ofollow, "{name}_adopt", "{name}_moved", "{name}_outer_moved"]]
                &_.fields <= Append &_.fields, [[((inner, (OutHold (OutOpt (OutDyn t))), "`@Flatten`'s current inner: the one its outer held when it adopted")), ((follow, followTy, "the subscription to the inner's update event")), ((ofollow, followTy, "the subscription to the outer's update event"))]]
                &_.moves <= Append &_.moves, [[((inner, (XCall (RefRuntime "rt::Hold::new"), [[(XCtor (RefRuntime "std::Some"), [[(XMethod (XVar dyn), "sample", [[XCx]])]]), XCx]]))), ((follow, (XCall (RefRuntime "prism_rtl::Follow::new"), [[]]))), ((ofollow, (XCall (RefRuntime "prism_rtl::Follow::new"), [[]])))]]
                &_.build <= Append &_.build, [[followed, ofollowed]]
                &_.getters <= Push &_.getters, (MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=sample, doc="`@Flatten`'s dynamic: its current inner at the read point."))
                &_.dynReads <= Insert &_.dynReads, name, [[OwnRead inner]]
                &_.flattens <= Push &_.flattens, FlatDef(name=name, outer=dyn, generation="", held=True, ty=t)
            ((wx2, (WrDyn (XMethod (XSelf), name, [[XCx]]), [[OwnRead inner]], t)))
        otherwise:
            let wx2 = update wx:
                &_.build <= Push &_.build, (RefusalDo "`@Flatten` of `{SrcText wx.lx, wx.lx.file, x.span}`, a dynamic of dynamics with no live dynamic at the build where the line reads it (gap LF)")
            ((wx2, WrUnit))

# `for k, $v <- $each:` over `$(k ==> $v)` (Semantics ch. 4, ruling FV; a host document's
# entries, `$(Path ==> $Elem c)`, and `@PerKey`'s inners): `$v` is the row's entry flattened.
# `{name}_inner` is the current inner, a hold set at the row's construction to the entry's
# value (the `value` its builder hands it, so the row's own builders read `$v` from the
# start), and `{name}_follow` its subscription to the inner's update event, which tells the
# row through `{name}_moved` (what reads `$v` reads it again, in that tick). When the
# `for`'s builder, walking the keys after a write of the source, finds another dynamic than
# the inner under the row's kept key, it tells the row (`{name}_replaced`, `ForBuild`), which
# queues the adoption for the start of the tick after (`{name}_adopt`, through
# `Cx::answer_later`, so that tick is owed; rulings VL, TK). No row is woken to ask.
EntryFlatten: unbounded fn Wx, OutTy, ?Bn -> ((Wx, Wres))
fn EntryFlatten wx, t, ?bound:
    let ((name, wx1)) = match ?bound:
        ? (BnHold f, ignore): ((f, wx))
        # bound as a widget's result (`IsGetterBuiltin`): the getter the name was pre-bound to
        ? (BnDyn (XMethod (XSelf), f, ignore), ignore, ignore): ((f, wx))
        otherwise: FreshName wx, "flatten"
    let inner = "{name}_inner"
    let follow = "{name}_follow"
    let followed = DoExpr (XMethod (XField (XVar "node"), follow), "follow", [[(XRef (XField (XMethod (XVar "node"), "entry", [[XCx]]), "updates")), (XRef (XVar "node")), (XPath (RefChild (SiteRef wx.lx, wx.node), "{name}_moved"))]])
    let sample = XMethod (XMethod (XMethod (XField XSelf, "{inner}"), "get", [[XCx]]), "expect", [[(XStr "`@Flatten` adopts its first inner at the build")]]), "sample", [[XCx]]
    let wx2 = update wx1:
        &_.taken <= Append &_.taken, [[inner, follow, "{name}_adopt", "{name}_moved", "{name}_replaced"]]
        &_.fields <= Append &_.fields, [[((inner, (OutHold (OutOpt (OutDyn t))), "`@Flatten`'s current inner: the row's entry it adopted")), ((follow, (OutNamed (RefRuntime "prism_rtl::Follow"), [[]]), "the subscription to the inner's update event"))]]
        &_.moves <= Append &_.moves, [[((inner, (XCall (RefRuntime "rt::Hold::new"), [[(XCtor (RefRuntime "std::Some"), [[(XClone (XVar "value"))]]), XCx]]))), ((follow, (XCall (RefRuntime "prism_rtl::Follow::new"), [[]])))]]
        &_.build <= Push &_.build, followed
        &_.getters <= Push &_.getters, (MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=sample, doc="`@Flatten`'s dynamic: its current inner at the read point."))
        &_.dynReads <= Insert &_.dynReads, name, [[OwnRead inner]]
        &_.flattens <= Push &_.flattens, FlatDef(name=name, outer="entry", generation="", held=False, ty=t)
    ((wx2, (WrDyn (XMethod (XSelf), name, [[XCx]]), [[OwnRead inner]], t)))

# `@Switch $!a`: the event its `rebuild` forwards. Any other dynamic of events (`@Switch
# (!MergeAll $evs)`, a map over a dynamic list) is refused: its event is not the inner
# the outer holds.
SwitchLine: unbounded fn Wx, Env, [Arg] -> ((Wx, Wres))
fn SwitchLine wx, menv, args = match args[0]:
    ? a:
        let rebuilt = match a.value.kind:
            EName n: match menv.names[SNameKey n]:
                ? (BnEv ignore, ignore): True
                otherwise: False
            otherwise: False
        if rebuilt:
            let ((r, wx2)) = EventRef wx, menv, a.value
            ((wx2, (WrEv r)))
        else: HeldSwitch wx, menv, a.value
    nil: ((wx, WrUnit))

# `@Switch $!x` over any other dynamic of events (round 47 SW; the Compiler seed, `@Switch`:
# the switch listens to the inner the dynamic holds after each tick, from n+1, with no
# catch-up). The outer is a live `Dynamic<Event<a>>`, made once the node is (`{name}_outer`,
# a name's live dynamic from `WholeArgs`, or a lifted expression, `@Switch (!MergeAll
# $evs)`, evaluated whole); the inner's firings reach the graph through a port node,
# `{name}`, as an event value's do (`EventObjectRef`), heard by a runtime `Listen`. The
# outer's update event puts the node on the swap list (`{name}_outer_moved`,
# `Cx::swap_later`), and `swap`, after the tick's propagation, listens to the inner the
# outer then holds and lets go of the old one.
HeldSwitch: unbounded fn Wx, Env, Expr -> ((Wx, Wres))
fn HeldSwitch wx, menv, x:
    let lx = wx.lx
    let t = OutTyOf lx, (Peel (Peel (TypeAt lx, x.span)))
    let lxw = update lx:
        &_.whole <= True
    let ((name, w1)) = FreshName wx, "switched"
    let ((id, w2)) = AddGn w1, name, t, GnPort, 0
    let outer = "{name}_outer"
    let listen = "{name}_listen"
    let ofollow = "{name}_ofollow"
    let outerTy = OutDyn (OutEvent t)
    let made = MethDef(name="{outer}_made", recv=RecvRef, params=[[]], cx=CxRef, ret=outerTy, body=[[]], tail=(Own (ValueOf lxw, menv, x)), doc="`{SrcText lx, lx.file, x.span}`, the switch's outer, as a live dynamic.")
    let outerNow = XMethod (XMethod (XField (XVar "node"), outer), "get", [[XCx]]), "expect", [[(XStr "`@Switch`'s outer is made at the build")]]
    let setOuter = DoExpr (XMethod (XField (XVar "node"), outer), "set", [[(XCtor (RefRuntime "std::Some"), [[(XMethod (XVar "node"), "{outer}_made", [[XCx]])]]), XCx]])
    let listened = DoExpr (XMethod (XField (XVar "node"), listen), "listen", [[(XRef (XMethod outerNow, "sample", [[XCx]])), (XRef (XVar "node")), (XPath (RefChild (SiteRef lx, wx.node), name))]])
    let followed = DoExpr (XMethod (XField (XVar "node"), ofollow), "follow", [[(XRef (XField outerNow, "updates")), (XRef (XVar "node")), (XPath (RefChild (SiteRef lx, wx.node), "{name}_outer_moved"))]])
    let moved = MethDef(name="{name}_outer_moved", recv=RecvRc, params=[[]], cx=CxMut, ret=OutUnit, body=[[DoExpr (XMethod (XCx), "swap_later", [[(XClone XSelf)]])]], tail=(XUnit), doc="The switch's outer fired: after the tick's propagation the switch takes the inner it then holds.")
    let w3 = update w2:
        &_.taken <= Append &_.taken, [[outer, listen, ofollow, "{outer}_made", "{name}_outer_moved"]]
        &_.fields <= Append &_.fields, [[((outer, (OutHold (OutOpt outerTy)), "`@Switch`'s outer, made at the build")), ((listen, (OutNamed (RefRuntime "prism_rtl::Listen"), [[t]]), "the subscription to the switch's current inner")), ((ofollow, (OutNamed (RefRuntime "prism_rtl::Follow"), [[]]), "the subscription to the outer's update event"))]]
        &_.moves <= Append &_.moves, [[((outer, (XCall (RefRuntime "rt::Hold::new"), [[XNone, XCx]]))), ((listen, (XCall (RefRuntime "std::Default::default"), [[]]))), ((ofollow, (XCall (RefRuntime "prism_rtl::Follow::new"), [[]])))]]
        &_.build <= Append &_.build, [[setOuter, listened, followed]]
        &_.getters <= Append &_.getters, [[made, moved]]
        &_.switches <= Push &_.switches, name
    ((w3, (WrEv (EvRefOf w3, id))))

# The `swap` hook's body: each held switch listens to the inner its outer holds now.
SwapBody: fn Wx -> [Do]
fn SwapBody wx = Each wx.switches, \|name|
    let outerNow = XMethod (XMethod (XField XSelf, "{name}_outer"), "get", [[XCx]]), "expect", [[(XStr "`@Switch`'s outer is made at the build")]]
    DoExpr (XMethod (XField XSelf, "{name}_listen"), "listen", [[(XRef (XMethod outerNow, "sample", [[XCx]])), (XRef (XClone XSelf)), (XPath (RefChild (SiteRef wx.lx, wx.node), name))]])
