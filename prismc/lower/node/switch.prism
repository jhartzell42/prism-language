# ---------------------------------------------------------------------------------------
# `rebuild` and `@Switch` (claude/backend.md, "Dynamic structure"; Compiler ch. 3)
# ---------------------------------------------------------------------------------------

# A row's environments from its block's: `_` the generation's value (or the `for` entry),
# and each event of the block the row's body names a source of the row, fed by the
# block's port for it.
RowEnv: unbounded fn Wx, Wx, Env, Block -> ((Wx, Wx, Env))
fn RowEnv parent, rowWx, menv, body:
    let names = ReadNames (BlockExprs body)
    Fold names, ((parent, rowWx, emptyEnv)), \|((p, r, env)), n| match menv.names[n]:
        ? (BnLocal rs, mode, t): ((p, r, (Bind env, n, (BnLocal (OverParent rs), Owned, t))))
        ? (BnEv er, t):
            let pname = (GnOf p, er.node).name
            let ((rs, r1)) = FreshName r, (Snake n)
            let ((id, r2)) = AddGn r1, rs, t, GnPort, 0
            let r3 = update r2:
                &_.subs <= Push &_.subs, ((pname, rs, t))
            let p2 = if HasText p.ports, pname: p else: Connect (WithPort p, pname), (EvRefOf p, er.node), (SkPort pname)
            ((p2, r3, (Bind env, n, (BnEv (EvRefOf r3, id), t))))
        # The block's dynamics and holds, read through the parent at the row's read point,
        # each a `ParentRead` in what it reads, so a generation's place that reads one is
        # live and the block's writes of it mark the generation (gap DY).
        ? (BnDyn (XMethod recv, m, xs), ignore, t):
            if recv == (XSelf): ((p, r, (Bind env, n, (BnDyn (XMethod parentRef, m, xs), [[ParentRead m]], t))))
            else: RowParamEnv p, r, env, menv, n
        ? (BnDyn ignore, ignore, ignore): RowParamEnv p, r, env, menv, n
        ? (BnHold f, t): ((p, r, (Bind env, n, (BnDyn (XMethod (XField parentRef, f), "get", [[XCx]]), [[ParentRead f]], t))))
        otherwise: ((p, r, env))

# A widget parameter's dynamic as a row reads it: through its getter (`BindParam`).
RowParamEnv: fn Wx, Wx, Env, Env, Text -> ((Wx, Wx, Env))
fn RowParamEnv p, r, env, menv, n = match menv.names["{n}#row"]:
    ? (BnDyn (XMethod ignore, m, xs), ignore, t): ((p, r, (Bind env, n, (BnDyn (XMethod parentRef, m, xs), [[ParentRead m]], t))))
    otherwise: ((p, r, env))

# A place of the block as a row's methods read it: through the parent (a row of a row reads
# its own parent's places through that row's parent in turn).
OverParent: fn Ex -> Ex
fn OverParent x = match x:
    XSelf: parentRef
    XField y, f: XField (OverParent y), f
    XFieldOf y, o, f: XFieldOf (OverParent y), o, f
    XPart y, k: XPart (OverParent y), k
    XMethod y, m, xs: XMethod (OverParent y), m, xs
    XUpgrade y: XUpgrade (OverParent y)
    otherwise: XField parentRef, (PlaceStem x)

# The block, as a row's methods read it through the row's `parent` field, and as the
# row's build reads it through its `parent` argument.
let parentRef = XMethod (XUpgrade (XField XSelf, "parent")), "expect", [[XStr "the block outlives its rows"]]
let parentArg = XMethod (XUpgrade (XVar "parent")), "expect", [[XStr "the block outlives its rows"]]

WithPort: fn Wx, Text -> Wx
fn WithPort wx, pname = update wx:
    &_.ports <= Push &_.ports, pname

RebuildLine: unbounded fn Wx, Env, Env, Expr, Block, Expr, ?Bn -> ((Wx, Wres))
fn RebuildLine wx, benv, menv, scrut, body, e, ?bound:
    let lx = wx.lx
    let pos = wx.pos
    let wx1 = update wx:
        &_.pos <= NextPos &_.pos
    let ((srcEx, reads)) = DynamicExpr wx1, menv, scrut
    let vt = OutTyOf lx, (Peel (TypeAt lx, scrut.span))
    let ((name, wx2)) = FreshName wx1, "generation"
    if GivesDynamic (TypeAt lx, e.span): RebuildDynamic wx2, menv, body, srcEx, reads, vt, name, pos
    else:
        let ((upId, wx3)) = match ?bound:
            ? (BnEv er, ignore): ((er.node, wx2))
            otherwise: AddGn wx2, "{name}_fired", (OutTyOf lx, (Peel (TypeAt lx, e.span))), GnNamed, 0
        let ((cases, wx4)) = GenCases wx3, menv, body, vt, name
        let rowDefs = Each cases, \|c| c.node
        let select = GenSelect wx4, menv, body, cases, pos
        let wx5 = update wx4:
            &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, at=(PlaceAt wx, "self", pos), source=srcEx, valueTy=vt, select=select, transparent=False, width=0, moved=(Or (?HostedRows wx), ""), early=False)
            &_.genHolds <= Push &_.genHolds, ((name, reads))
            &_.rows <= Fold rowDefs, &_.rows, \|acc, rd| Append (Push acc, rd), rd.children
            &_.getters <= Push &_.getters, (GenUp name, (GnOf wx4, upId).name, (GnOf wx4, upId).ty)
        ((wx5, (WrEv (EvRefOf wx5, upId))))

# Whether a `rebuild` hands back a dynamic: `$$a` (its generations give `$a`), or `$a` over
# a plain result, rather than an event, `$!a`, or nothing.
GivesDynamic: fn Ty -> Bool
fn GivesDynamic t = match t:
    TySig "$", (TySig "$", ignore): True
    TySig "$", (TySig "!", ignore): False
    TySig "$", (TyCon "unit", [[]]): False
    TySig "$", ignore: True
    TyAt i, ignore: GivesDynamic i
    otherwise: False

# A `rebuild` that hands back a dynamic (Semantics ch. 7): the current generation's result
# as a `Dynamic` (`result_dynamic`), a structural dynamic of the block (pick ST). The build
# keeps the newborn generation's dynamic in `{name}_result_live` and marks the snapshot,
# which the construction step takes after the generation is built, so the `rebuild`'s
# dynamic `{name}_result` takes the newborn's result one tick behind and is published the
# tick after; `@Flatten` adopts it from there (`FlattenLine`). A generation whose own hold
# behind its result is written tells the block through `{name}_result_moved`.
RebuildDynamic: unbounded fn Wx, Env, Block, Ex, [Read], OutTy, Text, Pos -> ((Wx, Wres))
fn RebuildDynamic wx, menv, body, srcEx, reads, vt, name, pos:
    let rowName = "{wx.node}Gen{RowSuffix wx}"
    let whole = GenRowOf wx, menv, body, vt, rowName, name
    # the rebuild's dynamic holds the generation's dynamic result, or its plain one
    let ?shape = match whole.?dynResult:
        ? rt: ? (((OutDyn rt), "result_dynamic"))
        nil: match whole.?plainResult:
            ? rt: ? ((rt, "result_value"))
            nil: nil
    match ?shape:
        nil:
            let wx2 = update whole.parent:
                &_.build <= Push &_.build, (RefusalDo "a `rebuild` whose generation gives a dynamic it does not lower")
            ((wx2, WrUnit))
        ? ((dynTy, taken)):
            let result = "{name}_result"
            let live = "{result}_live"
            let what = "the dynamic of the `rebuild` at place {PlaceText pos}"
            let tail = Append (Append [[(XWeak XSelf)]], (HostedPassed wx)), [[XCx]]
            let built = TryOf (XCall (RefChild (SiteRef wx.lx, whole.node.name), "build"), (Append [[(XVar "path"), (XVar "value")]], tail))
            let kept = DoAssign (XDeref (XMethod (XField XSelf, live), "borrow_mut", [[]])), (XCtor (RefRuntime "std::Some"), [[(XMethod (XVar "row"), taken, [[]])]])
            let marked = DoExpr (XMethod (XField XSelf, "{result}_snap"), "mark", [[XCx]])
            let select = XBlock [[(DoLet (PaBind "row"), built), kept, marked]], (XVar "row")
            let current = XMethod (XClone (XMethod (XField XSelf, "{live}"), "borrow", [[]])), "expect", [[(XStr "a `rebuild` has a generation from its build on")]]
            let wx2 = update whole.parent:
                &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, at=(PlaceAt wx, "self", pos), source=srcEx, valueTy=vt, select=select, transparent=False, width=0, moved=(Or (?HostedRows wx), ""), early=False)
                &_.genHolds <= Push &_.genHolds, ((name, reads))
                &_.rows <= Append (Push &_.rows, whole.node), whole.node.children
                &_.taken <= Append &_.taken, [[result, live, "{result}_now", "{result}_snap", "{result}_publish", "{result}_moved"]]
                &_.fields <= Append &_.fields, [[((live, (OutCell (OutOpt dynTy)), "the current generation's result, which the snapshot of the `rebuild`'s dynamic is taken from")), (("{result}_snap", (OutSnapshot dynTy), "the `rebuild` at place {PlaceText pos}'s dynamic, structural: its snapshots, the generations' results and the lagged dynamic (pick ST)"))]]
                &_.moves <= Push &_.moves, ((live, (XCall (RefRuntime "std::RefCell::new"), [[XNone]])))
                &_.inits <= Push &_.inits, (("{result}_snap", (XCall (RefRuntime "rt::Snapshot::new"), [[XStr what]])))
                &_.getters <= Append &_.getters, [[(MethDef(name="{result}_now", recv=RecvRef, params=[[]], cx=CxRef, ret=dynTy, body=[[]], tail=current, doc="The current generation's result: what the snapshot of the `rebuild`'s dynamic is taken from (pick ST).")), (SnapGetter result, dynTy, "The `rebuild`'s dynamic, its generation's result, a structural dynamic (pick ST): one tick behind the generations, the snapshot of the tick before the tick the read point is after.")]]
                &_.snaps <= Push &_.snaps, SnapDef(name=result, live="{result}_now", ty=dynTy, eq=False, builder=name, before=False, what=what)
            ((wx2, (WrDyn (XMethod (XSelf), result, [[XCx]]), [[OwnRead result]], dynTy)))

# A widget of several clauses in a static position (Semantics ch. 8): the clause is chosen
# at the build from the arguments, which are plain, so it is a generation built once (its
# source, the first argument, never changes), each clause a row (`ClauseRowOf`). The
# generation is transparent: its node stands at the caller's path and its places take the
# caller's positions from the call's on, as an inlined widget's do, the caller forwarding
# the World's answers there to it. Clauses with different numbers of places take the
# widest one's positions, so the caller's later places have one position whichever clause
# is chosen (pick CS).
ClauseWidgetLine: unbounded fn Wx, Env, Env, Expr, Block, Text, ValInfo, Expr, [Arg] -> ((Wx, Wres))
fn ClauseWidgetLine wx, benv, menv, scrut, call, qk, v, e, args:
    let lx = wx.lx
    let outTy = OutTyOf lx, (OutOf (TypeAt lx, e.span))
    let layer = ResultLayer (TypeAt lx, e.span)
    if layer == LyPlain and outTy != OutUnit: EarlyClauseLine wx, benv, menv, scrut, qk, v, e, args, outTy
    else: if layer == LyDyn: DynClauseLine wx, menv, scrut, call, qk, v, e
    else: StaticClauseLine wx, menv, scrut, call, qk, v, e

# The layer of what a line gives: a blueprint's output's, or the value's own.
ResultLayer: fn Ty -> Layer
fn ResultLayer t = match t:
    TyAt i, ignore: LayerOf i
    otherwise: LayerOf t

# A static widget of several clauses whose result is a dynamic (Semantics ch. 4 and 8: the
# clause's `@ $d` is the caller's binding, a dynamic it reads and follows): the generation
# is built as a static one is (`StaticClauseLine`), after the block's node; the row the
# arguments choose hands its `result_dynamic` to the block, which keeps it in `{name}_res`
# and reads it at the read point through the line's getter. A write behind it in the row
# calls the block's `{name}_result_moved`, which marks the block's readers of it, in that
# tick; a write of the block's own behind it marks them as any write of the block's does.
DynClauseLine: unbounded fn Wx, Env, Expr, Block, Text, ValInfo, Expr -> ((Wx, Wres))
fn DynClauseLine wx, menv, scrut, call, qk, v, e:
    let lx = wx.lx
    let pos = wx.pos
    let callArgs = match ?ClauseCall lx, call:
        ? ((ignore, xs)): xs
        nil: [[]]
    let ((srcEx, reads)) = DynamicExpr wx, menv, scrut
    let vt = OutTyOf lx, (Peel (TypeAt lx, scrut.span))
    let ((name, wx1)) = FreshName wx, "generation"
    let res = "{name}_res"
    let clauses = ClausesOf lx.g, qk
    let rowName = "{wx.node}Gen{RowSuffix wx}"
    let ((rows, wx2)) = Fold (Range0 (Len clauses)), (([[]], wx1)), \|((acc, w)), i|
        let c = Or clauses[i], dummyClause
        let cr = ClauseRowOf w, menv, c, v, "{rowName}{i}", name, True, (OutWeak wx.node), callArgs
        (((Push acc, cr), cr.parent))
    let width = Fold rows, 0, \|acc, cr| Max acc, cr.width
    let cases = Each rows, \|cr| cr.case
    let rowObj = OutObj (OutNamed (RefRuntime "rt::Row"), [[]])
    let env = Bind menv, "_", (BnLocal (XVar "value"), Owned, OutUnit)
    let scrutEx = XTuple (Each callArgs, \|a| Argument lx, env, a.value)
    let tail = Append (Append [[(XWeak XSelf)]], (HostedPassed wx)), [[XCx]]
    let arms = Each cases, \|c|
        let made = TryOf (XCall (RefChild (SiteRef lx, c.node.name), "build"), (Append (Append [[(XClone (XVar "path"))]], c.passed), tail))
        let kept = DoAssign (XDeref (XMethod (XField XSelf, res), "borrow_mut", [[]])), (XCtor (RefRuntime "std::Some"), [[(XMethod (XVar "row"), "result_dynamic", [[]])]])
        XArm(pat=c.pat, conds=c.conds, body=(XBlock [[(DoLet (PaBind "row"), made), kept]], (XCast (XVar "row"), rowObj)))
    let select = Own (ArmsValue scrutEx, arms, "'select", rowObj)
    let wx3 = update wx2:
        &_.pos <= Pos(scope=pos.scope, at=pos.at + width)
        &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, at=(PlaceAt wx, "self", pos), source=srcEx, valueTy=vt, select=select, transparent=True, width=width, moved=(Or (?HostedRows wx), ""), early=False)
        &_.genHolds <= Push &_.genHolds, ((name, reads))
        &_.rows <= Fold cases, &_.rows, \|acc, gc| Append (Push acc, gc.node), gc.node.children
    KeptDynResult wx3, name, rows

StaticClauseLine: unbounded fn Wx, Env, Expr, Block, Text, ValInfo, Expr -> ((Wx, Wres))
fn StaticClauseLine wx, menv, scrut, call, qk, v, e:
    let lx = wx.lx
    let callArgs = match ?ClauseCall lx, call:
        ? ((ignore, xs)): xs
        nil: [[]]
    let pos = wx.pos
    let ((srcEx, reads)) = DynamicExpr wx, menv, scrut
    let vt = OutTyOf lx, (Peel (TypeAt lx, scrut.span))
    let ((name, wx1)) = FreshName wx, "generation"
    # what the call gives when built: the type at `e` is the blueprint's where the call is an
    # `if` arm's value (gap AW), its output where a bind takes it
    let ((upId, wx2)) = AddGn wx1, "{name}_fired", (OutTyOf lx, (OutOf (TypeAt lx, e.span))), GnNamed, 0
    let clauses = ClausesOf lx.g, qk
    let rowName = "{wx.node}Gen{RowSuffix wx}"
    let ((rows, wx3)) = Fold (Range0 (Len clauses)), (([[]], wx2)), \|((acc, w)), i|
        let c = Or clauses[i], dummyClause
        let cr = ClauseRowOf w, menv, c, v, "{rowName}{i}", name, True, (OutWeak wx.node), callArgs
        (((Push acc, cr), cr.parent))
    # clauses of different widths take the widest one's positions (pick CS)
    let width = Fold rows, 0, \|acc, cr| Max acc, cr.width
    let cases = Each rows, \|cr| cr.case
    let select = GenSelect wx3, menv, call, cases, pos
    let wx4 = update wx3:
        &_.pos <= Pos(scope=pos.scope, at=pos.at + width)
        &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, at=(PlaceAt wx, "self", pos), source=srcEx, valueTy=vt, select=select, transparent=True, width=width, moved=(Or (?HostedRows wx), ""), early=False)
        &_.genHolds <= Push &_.genHolds, ((name, reads))
        &_.rows <= Fold cases, &_.rows, \|acc, gc| Append (Push acc, gc.node), gc.node.children
        &_.getters <= Push &_.getters, (GenUp name, (GnOf wx3, upId).name, (GnOf wx3, upId).ty)
    ((wx4, (WrEv (EvRefOf wx4, upId))))

# A static widget of several clauses whose result is plain (Semantics ch. 4: `@ v` lifts a
# plain value; ch. 8: `<-` builds the child and binds its result), which the block reads
# at its build: its generation is built in the block's own build, before the block's node,
# at the line's point, the clause chosen by matching the arguments as the block's build
# reads them; the row holds the block through a link (`prism_rtl::Link`, as a host's
# supplier does), linked once the node is made, and hands its plain result back with
# itself. The node keeps the row as its generation from then on, built once (pick CS).
EarlyClauseLine: unbounded fn Wx, Env, Env, Expr, Text, ValInfo, Expr, [Arg], OutTy -> ((Wx, Wres))
fn EarlyClauseLine wx, benv, menv, scrut, qk, v, e, args, outTy:
    let lx = wx.lx
    let pos = wx.pos
    let ((name, wx1)) = FreshName wx, "generation"
    let link = "{name}_link"
    let first = "{name}_first"
    let rowLocal = "{name}_row"
    let linkTy = OutNamed (RefRuntime "prism_rtl::Link"), [[(OutNamed (SiteRef lx, wx.node), [[]])]]
    let clauses = ClausesOf lx.g, qk
    let rowName = "{wx.node}Gen{RowSuffix wx}"
    let ((rows, wx2)) = Fold (Range0 (Len clauses)), (([[]], wx1)), \|((acc, w)), i|
        let c = Or clauses[i], dummyClause
        let cr = ClauseRowOf w, menv, c, v, "{rowName}{i}", name, True, linkTy, args
        (((Push acc, cr), cr.parent))
    let width = Fold rows, 0, \|acc, cr| Max acc, cr.width
    let cases = Each rows, \|cr| cr.case
    let rowObj = OutObj (OutNamed (RefRuntime "rt::Row"), [[]])
    # the clause chosen and built: in the block's build, through the link made there; in
    # the node's own method (never called again: the arguments do not change), through the
    # link it keeps
    # in a hosted scope the row is given its host: in the build the local, in the node's
    # method its field
    let hostAtBuild = match ?HostedRows wx:
        ? ignore: [[(XClone (XVar (HostLocal wx, pos)))]]
        nil: [[]]
    let Made = \|c, parent, host| TryOf (XCall (RefChild (SiteRef lx, c.node.name), "build"), (Append (Append [[(XClone (XVar "path"))]], c.passed), (Append (Append [[parent]], host), [[XCx]])))
    let earlyArms = Each cases, \|c| XArm(pat=c.pat, conds=c.conds, body=(XBlock [[(DoLet (PaBind "row"), (Made c, (XClone (XVar link)), hostAtBuild))]], (XTuple [[(XMethod (XVar "row"), "result_value", [[]]), (XCast (XVar "row"), rowObj)]])))
    let methodArms = Each cases, \|c| XArm(pat=c.pat, conds=c.conds, body=(XCast (Made c, (XClone (XField XSelf, link)), (HostedPassed wx)), rowObj))
    let atBuild = XTuple (Each args, \|a| Argument lx, benv, a.value)
    let inMethod = XTuple (Each args, \|a| Argument lx, (Bind menv, "_", (BnLocal (XVar "value"), Owned, OutUnit)), a.value)
    let built = Own (ArmsValue atBuild, earlyArms, "'select", (OutTuple [[outTy, rowObj]]))
    let select = Own (ArmsValue inMethod, methodArms, "'select", rowObj)
    let wx3 = update wx2:
        &_.taken <= Append &_.taken, [[link, first, rowLocal]]
        &_.lets <= Append &_.lets, [[(DoLet (PaTyped (PaBind link), linkTy), (XCall (RefRuntime "prism_rtl::Link::<{wx.node}>::new"), [[]])), (DoLet (PaTuple [[(PaBind first), (PaBind rowLocal)]]), built)]]
        &_.fields <= Push &_.fields, ((link, linkTy, "the link the generation at place {PlaceText pos} holds this node through, built before it"))
        &_.inits <= Push &_.inits, ((link, (XClone (XVar link))))
        &_.build <= Push &_.build, (DoExpr (XMethod (XVar link), "link", [[(XRef (XVar "node"))]]))
        &_.fallible <= True
        &_.pos <= Pos(scope=pos.scope, at=pos.at + width)
        &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, at=(PlaceAt wx, "self", pos), source=(XUnit), valueTy=OutUnit, select=select, transparent=True, width=width, moved=(Or (?HostedRows wx), ""), early=True)
        &_.genHolds <= Push &_.genHolds, ((name, [[]]))
        &_.rows <= Fold cases, &_.rows, \|acc, gc| Append (Push acc, gc.node), gc.node.children
    ((wx3, (WrPlain (XClone (XVar first)), outTy)))

# Whether the node's places go to a host's document rather than the World's.
IsHostedScope: fn Wx -> Bool
fn IsHostedScope wx = wx.pos.scope > 0 or (IsSome wx.?hostedBy)

IsSome: fn ?a -> Bool
fn IsSome (? ignore) = True
fn IsSome nil = False

# One generation's node, for the block or for one clause of the widget it applies.
type GenCase = record:
    node: NodeDef
    params: [((Text, OutTy))]
    pat: Pa
    conds: [Cc]
    # What each parameter is built from: the arm's binders, owned.
    passed: [Ex]

GenCases: unbounded fn Wx, Env, Block, OutTy, Text -> (([GenCase], Wx))
fn GenCases wx, menv, body, vt, name:
    let lx = wx.lx
    let rowName = "{wx.node}Gen{RowSuffix wx}"
    match ?ClauseCall lx, body:
        ? ((qk, args)):
            let clauses = ClausesOf lx.g, qk
            let v = ValOf lx, qk
            Fold (Range0 (Len clauses)), (([[]], wx)), \|((acc, w)), i|
                let c = Or clauses[i], dummyClause
                let cr = ClauseRowOf w, menv, c, v, "{rowName}{i}", name, False, (OutWeak wx.node), args
                # a `rebuild` of a clause call hands back no plain result
                let p2 = match cr.?plain:
                    ? ignore: update cr.parent:
                        &_.build <= Push &_.build, (RefusalDo "a `rebuild` whose generation is a widget of several clauses ending on a plain result")
                    nil: cr.parent
                (((Push acc, cr.case), p2))
        nil:
            let whole = GenRowOf wx, menv, body, vt, rowName, name
            ((([[GenCase(node=whole.node, params=[[(("value", vt))]], pat=PaWild, conds=[[]], passed=[[(XVar "value")]])]]), whole.parent))

# A generation's body that is one application of a widget of several clauses: the widget
# and the arguments.
?ClauseCall: fn Lx, Block -> ?((Text, [Arg]))
fn ?ClauseCall lx, body = match body.stmts:
    [[st]]: match st.kind:
        SExpr x: ?ClauseCallX lx, x
        SIgnore x: ?ClauseCallX lx, x
        otherwise: nil
    otherwise: nil

?ClauseCallX: fn Lx, Expr -> ?((Text, [Arg]))
fn ?ClauseCallX lx, x = match x.kind:
    ECall c, args, ignore, ignore:
        let qk = BlueprintQk lx, c
        if (Len (ClausesOf lx.g, qk)) > 1: ? ((qk, args)) else: nil
    otherwise: nil

type ClauseRow = record:
    case: GenCase
    parent: Wx
    # The clause's plain result, kept in the row's field and read by `result_value`, when
    # it ends on one.
    ?plain: OutTy
    # What a clause's dynamic result reads of its block, and its type (`DynClauseLine`).
    resultReads: [Read]
    ?resultTy: OutTy
    # How many places the clause has: the positions it takes in its caller when it stands
    # there (`ClauseWidgetLine`).
    width: Nat

# One clause's generation: its parameters' binders the row's fields, chosen by matching
# the arguments (in the block, `_` the generation's value).
ClauseRowOf: unbounded fn Wx, Env, FnClause, ValInfo, Text, Text, Bool, OutTy, [Arg] -> ClauseRow
fn ClauseRowOf wx, menv, c, v, rowName, genName, transparent, parentTy, args:
    let lx = wx.lx
    let lxc = InModuleAt lx, v.file, v.home, lx.site
    let ptys = match v.scheme.ty:
        TyFn ignore, ps, ignore: ps
        otherwise: [[]]
    let pats = Each c.params, \|p| ? p
    let body = match c.body:
        BodyBlock b: b
        BodyExpr x: Block(stmts=[[(Stmt(kind=(SExpr x), span=x.span))]], inline=True, span=x.span)
    # a `$` parameter's binder is the caller's dynamic, read through the row's parent where
    # the caller's own reading of it stands (Type System ch. 1; the caller's writes behind
    # it mark the row's places, `GenMarked`), never its value at the build
    let dyns = Fold (Range0 (Len c.params)), [[]], \|acc, i| match ((ptys[i], c.params[i], args[i])):
        ((? pt, ? p, ? a)) if (LayerOf pt) == LyDyn:
            let bn = PlainBinder lxc, p
            if bn == "": acc else: Push acc, ((bn, (ClauseDynArg wx, menv, a.value, (OutTyOf lxc, (Peel pt)))))
        otherwise: acc
    ArmRowOf wx, menv, lxc, pats, ptys, nil, body, rowName, genName, transparent, False, parentTy, dyns

# A caller's dynamic argument as a clause's row reads it: through its `parent`, the reads
# the caller's ones of the block (`ParentRead`); one that does not stand on the caller's
# own node is refused.
ClauseDynArg: unbounded fn Wx, Env, Expr, OutTy -> Bn
fn ClauseDynArg wx, menv, x, t:
    let ((ex, reads)) = DynamicExpr wx, menv, x
    let over = OverParent ex
    let ok = (OnSelfRooted ex) and Fold reads, True, \|f, r| f and match r:
        OwnRead ignore: True
        ParentRead ignore: False
    if ok: BnDyn over, (Each reads, \|r| AsParentRead r), t
    else: BnDyn (Refusal "a widget of several clauses given a dynamic its caller reads through its own parent"), [[]], t

AsParentRead: fn Read -> Read
fn AsParentRead (OwnRead m) = ParentRead m
fn AsParentRead (ParentRead m) = ParentRead m

# Whether a node's expression reads only through `self`.
OnSelfRooted: fn Ex -> Bool
fn OnSelfRooted x = match x:
    XSelf: True
    XField y, ignore: OnSelfRooted y
    XFieldOf y, ignore, ignore: OnSelfRooted y
    XPart y, ignore: OnSelfRooted y
    XMethod y, ignore, ignore: OnSelfRooted y
    otherwise: False

# One arm's generation, of a widget's clause or of a building `match` or `if`: the binders
# of its patterns (`nil` matches anything) the row's fields, chosen by matching the
# scrutinees, a guard (read in the block, with the binders) a condition of the arm. A
# clause's body reads its binders alone (it is its own function's); an arm of a `match` in
# a block reads the block's names too (`readsBlock`, through `RowEnv`), its binders over
# them. The row holds its block as `parentTy`: weakly, or through a link when the
# generation is built before the block's node (`EarlyClauseLine`).
ArmRowOf: unbounded fn Wx, Env, Lx, [?Pattern], [Ty], ?Expr, Block, Text, Text, Bool, Bool, OutTy, [((Text, Bn))] -> ClauseRow
fn ArmRowOf wx, menv, lxc, pats, ptys, ?guard, body, rowName, genName, transparent, readsBlock, parentTy, dyns:
    let upName = "{genName}_up"
    let pos = Each (Range0 (Len pats)), \|i| ArmPat lxc, (Or pats[i], nil), (Or ptys[i], TyErr), ByRef, "c{i}"
    let pa = PaTuple (Each pos, \|o| o.pa)
    let binds = Fold pos, {}, \|m, o| Fold o.binds, m, \|m2, ((n, b))| Insert m2, n, b
    let guardConds = match ?guard:
        ? g: [[CcIf (AsBool (ValueOf lxc, (BindAll menv, (Fold pos, [[]], \|acc, o| Append acc, o.binds)), g))]]
        nil: [[]]
    # the names the patterns bind: a bare case name (`Quiet`) binds nothing (gap AW)
    let named = Fold pats, [[]], \|acc, ?p| Append acc, (OptBinders ?p)
    let dynNames = Each dyns, \|((n, ignore))| n
    let binders = Filter named, \|((bn, ignore))| (HasKey binds, bn) and not (HasText dynNames, bn)
    let fields = Each binders, \|((bn, r))| (((Snake bn), (OutTyOf lxc, (Peel (BinderTy lxc, r))), bn))
    let rowFields = Push (Each fields, \|((f, t, bn))| ((f, t, "`{bn}`"))), (("parent", parentTy, "the node of the `rebuild`"))
    let rowInits = Each fields, \|((f, ignore, ignore))| ((f, (XClone (XVar f))))
    let rowTaken = Append nodeHooks, (Push (Push (Each fields, \|((f, ignore, ignore))| f), "parent"), "result_value")
    let r00 = NewWx lxc, rowName, rowFields, rowInits, [[(("parent", (XVar "parent")))]], [[]], {}, rowTaken, wx.inlining, (?HostedRows wx)
    # standing in its caller, the arm's places are numbered from the caller's position
    # (the row's own scope, 0: in a hosted scope the row's places are its host's through
    # the row's `?hostedBy`, as a `for` row's are)
    let r0 = if transparent: (update r00:
        &_.pos <= Pos(scope=0, at=wx.pos.at)) else: r00
    # a clause's body is its own function's: no name in it is its caller's (only an arm of a
    # `match` in the block reads the block's names, its events through ports of the row)
    let ((p1, r1, ports)) = if readsBlock: RowEnv wx, r0, menv, body else: ((wx, r0, emptyEnv))
    let ((be0, me0)) = Fold fields, ((emptyEnv, emptyEnv)), \|((b, m)), ((f, t, bn))| BindPlain b, m, bn, f, t
    let dynEnv = BindAll emptyEnv, dyns
    let me = OverEnv me0, dynEnv
    let be = OverEnv be0, (BuildSpelling dynEnv)
    # a binder hides the block's name it shadows
    let r2 = if readsBlock: BlockInto r1, (OverEnv (BuildSpelling ports), be), (OverEnv ports, me), body else: BlockInto r1, be, me, body
    let ((r3, ?plain)) = match r2.result:
        WrEv r: (((Connect r2, r, (SkUp upName)), nil))
        WrParts ignore: (((update r2:
            &_.build <= Push &_.build, (RefusalDo "a widget of several clauses whose clause ends on a bundle")), nil))
        # a plain result, computed at the generation's build and kept in a field of the
        # row, read by the block that built it early (`EarlyClauseLine`); an arm of a
        # building `match` or `if` hands back none but an event
        WrPlain ex, rt:
            if readsBlock: (((update r2:
                &_.build <= Push &_.build, (RefusalDo "a building `match` or `if` whose arm ends on a plain result")), nil))
            else:
                let ((f, rf)) = FreshName r2, "result"
                let r2p = update rf:
                    &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind f), rt), ex)
                    &_.fields <= Push &_.fields, ((f, rt, "the clause's plain result"))
                    &_.inits <= Push &_.inits, ((f, (XClone (XVar f))))
                    &_.getters <= Push &_.getters, (MethDef(name="result_value", recv=RecvRef, params=[[]], cx=CxNone, ret=rt, body=[[]], tail=(XClone (XField XSelf, f)), doc="The clause's plain result, which the block that built the generation reads."))
                ((r2p, ? rt))
        # a dynamic result: the row's getter `result` and `result_dynamic`, a write behind it
        # telling the block (`GenResult`, `DynClauseLine`)
        WrDyn ex, rds, rt: (((GenResult r2, genName, ex, rds, rt), nil))
        otherwise: ((r2, nil))
    let node = FinishNode r3, rowName, (Append (Push (Each fields, \|((f, t, ignore))| ((f, t))), (("parent", parentTy))), (HostedParams wx)), True
    let p2 = GenMarked p1, genName, r3
    let passed = Each fields, \|((f, t, bn))| match binds[bn]:
        ? (BnLocal rs, mode, bt): Own (VlPlace rs, mode, bt)
        otherwise: XClone (XVar f)
    ClauseRow(case=GenCase(node=node, params=(Each fields, \|((f, t, ignore))| ((f, t))), pat=pa, conds=(Append (Fold pos, [[]], \|acc, o| Append acc, o.conds), guardConds), passed=passed), parent=p2, width=(Or (r2.pos.at -? r0.pos.at), 0), ?plain=?plain, resultReads=(ResultParentReads r2), ?resultTy=(?ResultDynTy r2))

?ResultDynTy: fn Wx -> ?OutTy
fn ?ResultDynTy r = match r.result:
    WrDyn ignore, ignore, rt: ? rt
    otherwise: nil

# What a row's dynamic result reads of its block.
ResultParentReads: fn Wx -> [Read]
fn ResultParentReads r = match r.result:
    WrDyn ignore, rds, ignore: Filter (ReadsClosed r.dynReads, rds), \|rd| IsParentRead rd
    otherwise: [[]]

IsParentRead: fn Read -> Bool
fn IsParentRead (ParentRead ignore) = True
fn IsParentRead (OwnRead ignore) = False

OptBinders: unbounded fn ?Pattern -> [((Text, Range))]
fn OptBinders (? p) = PatternBinders p
fn OptBinders nil = [[]]

# `inner`'s names over `outer`'s.
OverEnv: fn Env, Env -> Env
fn OverEnv outer, inner = Fold (Keys inner.names), outer, \|en, k| match inner.names[k]:
    ? b: Bind en, k, b
    nil: en

# A building `match` or `if` over a plain scrutinee (Semantics ch. 4: "The arm is fixed for
# the life of the block and adds no path segment"; ch. 8, a widget block is transparent):
# a generation built once, at the build, as a static widget of several clauses is
# (`ClauseWidgetLine`), each arm a row chosen by its pattern and guard, standing at the
# block's path, its places in the block's sequence; arms of different widths take the
# widest one's positions (pick CS). The arm's block reads the block's names (through the
# row's `parent`, `RowEnv`) and its pattern's binders (the row's fields). An arm's event
# result fires the line's event.
BuildingChoiceLine: unbounded fn Wx, Env, Ex, [?Pattern], Ty, [?Expr], [Block], Expr -> ((Wx, Wres))
fn BuildingChoiceLine wx, menv, scrut, pats, sty, guards, bodies, e:
    let lx = wx.lx
    let pos = wx.pos
    let ((name, wx1)) = FreshName wx, "arm"
    let outTy = OutTyOf lx, (OutOf (TypeAt lx, e.span))
    let ((upId, wx2)) = AddGn wx1, "{name}_fired", outTy, GnNamed, 0
    let rowName = "{wx.node}Arm{RowSuffix wx}"
    let ((rows, wx3)) = Fold (Range0 (Len bodies)), (([[]], wx2)), \|((acc, w)), i|
        let cr = ArmRowOf w, menv, lx, [[(Or pats[i], nil)]], [[sty]], (Or guards[i], nil), (Or bodies[i], dummyBlockS), "{rowName}{i}", name, True, True, (OutWeak wx.node), [[]]
        (((Push acc, cr), cr.parent))
    let width = Fold rows, 0, \|acc, cr| Max acc, cr.width
    let cases = Each rows, \|cr| cr.case
    let isDyn = (ResultLayer (TypeAt lx, e.span)) == LyDyn
    let res = "{name}_res"
    let tail = Append (Append [[(XWeak XSelf)]], (HostedPassed wx)), [[XCx]]
    let rowObj = OutObj (OutNamed (RefRuntime "rt::Row"), [[]])
    # an arm's dynamic result kept by the block (`DynClauseLine`)
    let kept = DoAssign (XDeref (XMethod (XField XSelf, res), "borrow_mut", [[]])), (XCtor (RefRuntime "std::Some"), [[(XMethod (XVar "row"), "result_dynamic", [[]])]])
    let arms = Each cases, \|c|
        let made = TryOf (XCall (RefChild (SiteRef lx, c.node.name), "build"), (Append (Append [[(XClone (XVar "path"))]], c.passed), tail))
        let body = if isDyn: XBlock [[(DoLet (PaBind "row"), made), kept]], (XCast (XVar "row"), rowObj) else: XCast made, rowObj
        XArm(pat=c.pat, conds=c.conds, body=body)
    let select = Own (ArmsValue (XTuple [[scrut]]), arms, "'select", (OutObj (OutNamed (RefRuntime "rt::Row"), [[]])))
    let wx4 = update wx3:
        &_.pos <= Pos(scope=pos.scope, at=pos.at + width)
        &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, at=(PlaceAt wx, "self", pos), source=(XUnit), valueTy=OutUnit, select=select, transparent=True, width=width, moved=(Or (?HostedRows wx), ""), early=False)
        &_.genHolds <= Push &_.genHolds, ((name, [[]]))
        &_.rows <= Fold cases, &_.rows, \|acc, gc| Append (Push acc, gc.node), gc.node.children
        &_.getters <= Push &_.getters, (GenUp name, (GnOf wx3, upId).name, (GnOf wx3, upId).ty)
    if isDyn: KeptDynResult wx4, name, rows
    else: if outTy == OutUnit: ((wx4, WrUnit)) else: ((wx4, (WrEv (EvRefOf wx4, upId))))

# A generation's dynamic result kept by the block in `{name}_res` (a static clause's, an arm
# of a building `match`'s): the line's getter reads it at the read point; a write behind it
# in the row marks the block's readers (`{name}_result_moved`), and a write of the block's
# own behind it marks them as any write of the block's does.
KeptDynResult: fn Wx, Text, [ClauseRow] -> ((Wx, Wres))
fn KeptDynResult wx, name, rows:
    let res = "{name}_res"
    let getter = "{name}_value"
    let t = match (Or (Each rows, \|cr| cr.?resultTy)[0], nil):
        ? x: x
        nil: OutUnit
    let behind = Fold rows, [[OwnRead res]], \|acc, cr| Fold cr.resultReads, acc, \|a, rd| match rd:
        ParentRead m: AddRead a, (OwnRead m)
        OwnRead m: AddRead a, (OwnRead m)
    let read = XMethod (XMethod (XMethod (XMethod (XField XSelf, res), "borrow", [[]]), "as_ref", [[]]), "expect", [[(XStr "a generation built with its block")]]), "sample", [[XCx]]
    let wx2 = update wx:
        &_.taken <= Append &_.taken, [[res, getter, "{name}_result_moved"]]
        &_.fields <= Push &_.fields, ((res, (OutCell (OutOpt (OutDyn t))), "the generation's dynamic result"))
        &_.inits <= Push &_.inits, ((res, (XCall (RefRuntime "std::RefCell::new"), [[XNone]])))
        &_.getters <= Push &_.getters, (MethDef(name=getter, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=read, doc="The generation's dynamic result at the read point."))
        &_.dynReads <= Insert &_.dynReads, getter, behind
        &_.clauseResults <= Push &_.clauseResults, name
    ((wx2, (WrDyn (XMethod (XSelf), getter, [[XCx]]), [[OwnRead getter]], t)))

# `match s:` with building arms.
MatchGenLine: unbounded fn Wx, Env, Expr, [Arm], Expr -> ((Wx, Wres))
fn MatchGenLine wx, menv, s, arms, e = BuildingChoiceLine wx, menv, (Argument wx.lx, menv, s), (Each arms, \|a| a.?pattern), (TypeAt wx.lx, s.span), (Each arms, \|a| a.?guard), (Each arms, \|a| a.body), e

# `if c:` and `if p <- x:` with building arms: the condition a guard, or the pattern
# matched against `x`.
IfGenLine: unbounded fn Wx, Env, Cond, Block, Block, Expr -> ((Wx, Wres))
fn IfGenLine wx, menv, c, thenB, elseB, e = match c:
    CondExpr x: BuildingChoiceLine wx, menv, (XUnit), [[nil, nil]], (TyCon "unit", [[]]), [[(? x), nil]], [[thenB, elseB]], e
    CondBind p, x, ?g: BuildingChoiceLine wx, menv, (Argument wx.lx, menv, x), [[(? p), nil]], (TypeAt wx.lx, x.span), [[?g, nil]], [[thenB, elseB]], e

let dummyBlockS = Block(stmts=[[]], inline=True, span=Range(start=0, end=0))

type GenRow = record:
    node: NodeDef
    parent: Wx
    # The generation's result when it is a dynamic: its type (the row has `result` and
    # `result_dynamic`); when it is a plain value, its type (the row has `result_value`).
    ?dynResult: OutTy
    ?plainResult: OutTy

# A generation's node: its `_` a plain field, the block's events it names through ports,
# its result forwarded up to the `rebuild`'s.
GenRowOf: unbounded fn Wx, Env, Block, OutTy, Text, Text -> GenRow
fn GenRowOf wx, menv, body, vt, rowName, genName:
    let lx = wx.lx
    let upName = "{genName}_up"
    let r0 = NewWx lx, rowName, [[(("value", vt, "the generation's value, `_`")), (("parent", (OutWeak wx.node), "the node of the `rebuild`"))]], [[(("value", (XClone (XVar "value"))))]], [[(("parent", (XVar "parent")))]], [[]], {}, (Append nodeHooks, [["value", "parent", "result", "result_dynamic"]]), wx.inlining, (?HostedRows wx)
    let ((p1, r1, ports)) = RowEnv wx, r0, menv, body
    let be = Bind (BuildSpelling ports), "_", (BnLocal (XVar "value"), Owned, vt)
    let me = Bind ports, "_", (BnLocal (XField XSelf, "value"), Owned, vt)
    let r2 = BlockInto r1, be, me, body
    let ((r3, ?dynResult, ?plainResult)) = match r2.result:
        WrEv r: (((Connect r2, r, (SkUp upName)), nil, nil))
        WrDyn ex, resultReads, rt: (((GenResult r2, genName, ex, resultReads, rt), ? rt, nil))
        # a plain result: computed at the generation's build, kept in a field of the row
        WrPlain ex, rt:
            let ((f, rf)) = FreshName r2, "result"
            let r2p = update rf:
                &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind f), rt), ex)
                &_.fields <= Push &_.fields, ((f, rt, "the generation's plain result"))
                &_.inits <= Push &_.inits, ((f, (XClone (XVar f))))
                &_.getters <= Push &_.getters, (MethDef(name="result_value", recv=RecvRef, params=[[]], cx=CxNone, ret=rt, body=[[]], tail=(XClone (XField XSelf, f)), doc="The generation's plain result, which the `rebuild`'s dynamic is while the generation stands."))
            ((r2p, nil, ? rt))
        WrParts ignore:
            let r2b = update r2:
                &_.build <= Push &_.build, (RefusalDo "a `rebuild` whose block ends on a bundle")
            ((r2b, nil, nil))
        otherwise: ((r2, nil, nil))
    let r4 = GenHears r3, genName
    GenRow(node=(FinishNode r4, rowName, (Append [[(("value", vt)), (("parent", (OutWeak wx.node)))]], (HostedParams wx)), True), parent=(GenMarked p1, genName, r3), ?dynResult=?dynResult, ?plainResult=?plainResult)

# A generation's dynamic result (a `rebuild` handing back `$$a`): the getter `result`, the
# `Dynamic` the block keeps of it, and the block told through `{genName}_result_moved` when
# a hold of the generation's own behind it is written.
GenResult: fn Wx, Text, Ex, [Read], OutTy -> Wx
fn GenResult r, genName, ex, resultReads, rt:
    let ownBehind = Filter (ReadsClosed r.dynReads, resultReads), \|rd| match rd:
        OwnRead ignore: True
        ParentRead ignore: False
    let made = XCall (RefRuntime "rt::Dynamic::of"), [[(XClosure True, [[PaBind "cx"]], (XMethod (XVar "me"), "result", [[XCx]])), (XRef (XCall (RefRuntime "std::Rc::new"), [[(XCall (RefRuntime "rt::Port::new"), [[]])]]))]]
    let doc = "The generation's result as a dynamic, which the block keeps while the generation is current; the block hears it move through `{genName}_result_moved`, not through the dynamic's port."
    update r:
        &_.getters <= Append &_.getters, [[(MethDef(name="result", recv=RecvRef, params=[[]], cx=CxRef, ret=rt, body=[[]], tail=ex, doc="The generation's result, which the `rebuild` hands back.")), (MethDef(name="result_dynamic", recv=RecvRc, params=[[]], cx=CxNone, ret=(OutDyn rt), body=[[(DoLet (PaBind "me"), (XClone XSelf))]], tail=made, doc=doc))]]
        &_.resultMoved <= if (Len ownBehind) > 0: ? (("{genName}_result_moved", ownBehind)) else: nil

# The block's writes behind what a generation's places read mark the generation (gap DY;
# `RowMarks` of kind `GenerationRow`: the current one is dirtied), and the block's names it
# hears a write behind (`UpdatedHears`: its `!Updated` nodes' reads through the parent)
# tell the current one through `parent_wrote_{m}`, as a `for` row is told (pick RE). Its
# own builders over the block's names are not told: a generation's `rebuild` over them
# stands until the generation is replaced (`sem-ch07-paged`).
GenMarked: fn Wx, Text, Wx -> Wx
fn GenMarked parent, genName, rowWx:
    let reads = RowPlaceReads rowWx
    let hears = UpdatedHears rowWx
    let ported = Fold hears, parent, \|w, m| AddField w, "{genName}_wrote_{m}_port", (OutPort OutUnit), "the current generation of `{genName}` hears a write behind `{m}`", (XCall (RefRuntime "rt::Port::new"), [[]])
    let unheard = Filter (RowHears rowWx), \|m| not (HasText hears, m)
    if (Len reads) == 0 and (Len hears) == 0 and (Len unheard) == 0: parent
    else: update ported:
        &_.rowMarks <= Push &_.rowMarks, RowMarks(builder=genName, reads=reads, wrote=hears, unheard=unheard, kind=GenerationRow)

# A generation's side of `GenMarked`: the block holds the current generation as a `Row`,
# which names no method of it, so each name it hears is a port of the block,
# `{genName}_wrote_{m}`, the generation subscribes to (`subscribe_row`, as a row hears a
# block's event), its firing heard by `wrote_{m}` as `parent_wrote_{m}`.
GenHears: fn Wx, Text -> Wx
fn GenHears r, genName = Fold (UpdatedHears r), r, \|w, m| update w:
    &_.subs <= Push &_.subs, (("{genName}_wrote_{m}", "wrote_{m}", OutUnit))
    &_.taken <= Push &_.taken, "wrote_{m}"
    &_.getters <= Push &_.getters, (MethDef(name="wrote_{m}", recv=RecvRc, params=[[(("v", OutUnit))]], cx=CxMut, ret=OutUnit, body=[[DoExpr (XMethod (XSelf), "parent_wrote_{m}", [[XCx]])]], tail=(XUnit), doc="The block wrote behind its `{m}`: as `parent_wrote_{m}`."))

# A row's names as its constructor spells them: the block through the `parent` argument.
BuildSpelling: fn Env -> Env
fn BuildSpelling env = Fold (Keys env.names), env, \|en, k| match env.names[k]:
    ? (BnLocal rs, mode, t): match ?ThroughParent rs:
        ? x: Bind en, k, (BnLocal x, mode, t)
        nil: en
    ? (BnDyn (XMethod rs, m, xs), ds, t): match ?ThroughParent rs:
        ? x: Bind en, k, (BnDyn (XMethod x, m, xs), ds, t)
        nil: en
    otherwise: en

# The generation built: the one case, its row's constructor.
GenSelect: unbounded fn Wx, Env, Block, [GenCase], Pos -> Ex
fn GenSelect wx, menv, body, cases, pos:
    let tail = Append (Append [[(XWeak XSelf)]], (HostedPassed wx)), [[XCx]]
    match ?ClauseCall wx.lx, body:
        nil: match cases[0]:
            ? c: TryOf (XCall (RefChild (SiteRef wx.lx, c.node.name), "build"), (Append [[(XVar "path"), (XVar "value")]], tail))
            nil: Refusal "a `rebuild` with no generation"
        ? ((qk, args)):
            let env = Bind menv, "_", (BnLocal (XVar "value"), Owned, OutUnit)
            let scrut = XTuple (Each args, \|a| Argument wx.lx, env, a.value)
            let arms = Each cases, \|c|
                let made = TryOf (XCall (RefChild (SiteRef wx.lx, c.node.name), "build"), (Append (Append [[(XClone (XVar "path"))]], c.passed), tail))
                XArm(pat=c.pat, conds=c.conds, body=(XCast made, (OutObj (OutNamed (RefRuntime "rt::Row"), [[]]))))
            Own (ArmsValue scrut, arms, "'select", (OutObj (OutNamed (RefRuntime "rt::Row"), [[]])))

# The `rebuild`'s up-forwarding: a generation's result fires the block's event.
GenUp: fn Text, Text, OutTy -> MethDef
fn GenUp name, upName, t = MethDef(name="{name}_up", recv=RecvRc, params=[[(("v", t))]], cx=CxMut, ret=OutUnit, body=[[(SelfCall upName, [[(XVar "v")]])]], tail=(XUnit), doc="The current generation's result fires the `rebuild`'s.")

# The answers a generation's places get through the block: under `pos/#g` to the current
# generation; for a transparent one, at each of its positions in the block, whole.
GenForwards: fn GenDef -> [((Pa, Ex))]
fn GenForwards gd:
    if gd.transparent: Each (Range0 gd.width), \|i|
        let current = XClone (XMethod (XField XSelf, "{gd.name}"), "borrow", [[]])
        let body = XBlock [[(DoLet (PaBind "row"), current), (DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "row"]]), (XVar "row"), [[DoExpr (TryOf (XMethod (XVar "row"), "answer", [[(XVar "at"), (XVar "v"), XCx]]))]], [[]])]], (XUnit)
        (((PosPat (Pos(scope=gd.pos.scope, at=gd.pos.at + i)), [[PaRest ""]]), body))
    else: [[(((PosPat gd.pos, genTail), (ForwardGen gd)))]]

ForwardGen: fn GenDef -> Ex
fn ForwardGen gd:
    let current = XClone (XMethod (XField XSelf, "{gd.name}"), "borrow", [[]])
    let isCurrent = XBin OpEq, (XBin OpAdd, (XDeref (XVar "g")), (XIndex 1)), (XMethod (XField XSelf, "{gd.name}_count"), "get", [[]])
    XBlock [[(DoLet (PaBind "row"), current), (DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "row"]]), (XVar "row"), [[(DoIf isCurrent, [[DoExpr (TryOf (XMethod (XVar "row"), "answer", [[(XVar "rest"), (XVar "v"), XCx]]))]], [[]])]], [[]])]], (XUnit)

# `@Flatten $$x` over a `rebuild`'s dynamic `$$x` (claude/backend.md, "Dynamic structure";
# Semantics ch. 7): a field with the current inner, a hold of the generation's `Dynamic`,
# adopted at the build from the `rebuild`'s dynamic and afterwards among the first firings
# of the tick after the one in which the `rebuild`'s dynamic moved (`MovedBy`); the
# `@Flatten`'s dynamic samples the inner at the read point, so after n it has the value
# after n of the inner its outer held after n-1.
FlattenLine: unbounded fn Wx, Env, [Arg], ?Bn -> ((Wx, Wres))
fn FlattenLine wx, menv, args, ?bound:
    let ?named = match args[0]:
        ? a: match a.value.kind:
            EName n: match menv.names[SNameKey n]:
                ? (BnDyn (XMethod (XSelf), m, ignore), ignore, (OutDyn t)): ? ((m, t))
                otherwise: nil
            otherwise: nil
        nil: nil
    let ?outer = match ?named:
        ? ((m, t)): Fold wx.gens, nil, \|?acc, gd| if "{gd.name}_result" == m: ? ((m, gd.name, t)) else: ?acc
        nil: nil
    match ?outer:
        nil: match args[0]:
            ? a: HeldFlatten wx, menv, a.value, ?bound
            nil: ((wx, WrUnit))
        ? ((m, gen, t)):
            let ((name, wx1)) = match ?bound:
                ? (BnHold f, ignore): ((f, wx))
                # bound as a widget's result (`IsGetterBuiltin`): the getter the name was pre-bound to
                ? (BnDyn (XMethod (XSelf), f, ignore), ignore, ignore): ((f, wx))
                otherwise: FreshName wx, "flatten"
            let inner = "{name}_inner"
            let first = DoExpr (XMethod (XField (XVar "node"), "{inner}"), "set", [[(XCtor (RefRuntime "std::Some"), [[(XMethod (XVar "node"), m, [[XCx]])]]), XCx]])
            let sample = XMethod (XMethod (XMethod (XField XSelf, "{inner}"), "get", [[XCx]]), "expect", [[(XStr "`@Flatten` adopts its first inner at the build")]]), "sample", [[XCx]]
            let wx2 = update wx1:
                &_.taken <= Append &_.taken, [[inner, "{name}_adopt"]]
                &_.fields <= Push &_.fields, ((inner, (OutHold (OutOpt (OutDyn t))), "`@Flatten`'s current inner: the dynamic of the generation it adopted"))
                &_.moves <= Push &_.moves, ((inner, (XCall (RefRuntime "rt::Hold::new"), [[XNone, XCx]])))
                &_.build <= Push &_.build, first
                &_.getters <= Push &_.getters, (MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=sample, doc="`@Flatten`'s dynamic: its current inner at the read point."))
                &_.dynReads <= Insert &_.dynReads, name, [[OwnRead inner]]
                &_.flattens <= Push &_.flattens, FlatDef(name=name, outer=m, generation=gen, held=False, ty=t)
            ((wx2, (WrDyn (XMethod (XSelf), name, [[XCx]]), [[OwnRead inner]], t)))

# `@Flatten $$x` over any other dynamic of dynamics (Semantics Appendix B; the Compiler
# seed, `@Flatten`; the coordinator's ruling FV): `$$x` is the live dynamic its line made
# (`WholeArgs`), a `Dynamic` of `Dynamic`s, whose update event the flatten follows
# (`{name}_ofollow`). Its firing at n queues the adoption for the first firings of n+1,
# owed (`Adoption`), which takes the inner the outer holds after n, follows that inner's
# update event (`{name}_follow`) and fires as a write of the inner does. No dynamics are
# compared: an adoption of the same inner fires again. It shares the `rebuild` flatten's
# mechanism (`Adoption`, `Cx::answer_later`) rather than the swap list: the flatten fires
# at n+1 with no input of its own, so that tick must be owed, and nothing of the outer's
# write at n reaches n's own propagation (the Compiler seed, "No prompt binding").
HeldFlatten: unbounded fn Wx, Env, Expr, ?Bn -> ((Wx, Wres))
fn HeldFlatten wx, menv, x, ?bound:
    let t = OutTyOf wx.lx, (Peel (Peel (TypeAt wx.lx, x.span)))
    match menv.names["#whole{DynKey x}"]:
        ? (BnLocal (XField (XSelf), dyn), ignore, ignore):
            let ((name, wx1)) = match ?bound:
                ? (BnHold f, ignore): ((f, wx))
                # bound as a widget's result (`IsGetterBuiltin`): the getter the name was pre-bound to
                ? (BnDyn (XMethod (XSelf), f, ignore), ignore, ignore): ((f, wx))
                otherwise: FreshName wx, "flatten"
            let inner = "{name}_inner"
            let follow = "{name}_follow"
            let ofollow = "{name}_ofollow"
            let innerNow = XMethod (XMethod (XField (XVar "node"), inner), "get", [[XCx]]), "expect", [[(XStr "`@Flatten` adopts its first inner at the build")]]
            let followed = DoExpr (XMethod (XField (XVar "node"), follow), "follow", [[(XRef (XField innerNow, "updates")), (XRef (XVar "node")), (XPath (RefChild (SiteRef wx.lx, wx.node), "{name}_moved"))]])
            let ofollowed = DoExpr (XMethod (XField (XVar "node"), ofollow), "follow", [[(XRef (XField (XField (XVar "node"), dyn), "updates")), (XRef (XVar "node")), (XPath (RefChild (SiteRef wx.lx, wx.node), "{name}_outer_moved"))]])
            let sample = XMethod (XMethod (XMethod (XField XSelf, "{inner}"), "get", [[XCx]]), "expect", [[(XStr "`@Flatten` adopts its first inner at the build")]]), "sample", [[XCx]]
            let followTy = OutNamed (RefRuntime "prism_rtl::Follow"), [[]]
            let wx2 = update wx1:
                &_.taken <= Append &_.taken, [[inner, follow, ofollow, "{name}_adopt", "{name}_moved", "{name}_outer_moved"]]
                &_.fields <= Append &_.fields, [[((inner, (OutHold (OutOpt (OutDyn t))), "`@Flatten`'s current inner: the one its outer held when it adopted")), ((follow, followTy, "the subscription to the inner's update event")), ((ofollow, followTy, "the subscription to the outer's update event"))]]
                &_.moves <= Append &_.moves, [[((inner, (XCall (RefRuntime "rt::Hold::new"), [[(XCtor (RefRuntime "std::Some"), [[(XMethod (XVar dyn), "sample", [[XCx]])]]), XCx]]))), ((follow, (XCall (RefRuntime "prism_rtl::Follow::new"), [[]]))), ((ofollow, (XCall (RefRuntime "prism_rtl::Follow::new"), [[]])))]]
                &_.build <= Append &_.build, [[followed, ofollowed]]
                &_.getters <= Push &_.getters, (MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=sample, doc="`@Flatten`'s dynamic: its current inner at the read point."))
                &_.dynReads <= Insert &_.dynReads, name, [[OwnRead inner]]
                &_.flattens <= Push &_.flattens, FlatDef(name=name, outer=dyn, generation="", held=True, ty=t)
            ((wx2, (WrDyn (XMethod (XSelf), name, [[XCx]]), [[OwnRead inner]], t)))
        otherwise:
            let wx2 = update wx:
                &_.build <= Push &_.build, (RefusalDo "`@Flatten` of `{SrcText wx.lx, wx.lx.file, x.span}`, a dynamic of dynamics with no live dynamic at the build where the line reads it (gap LF)")
            ((wx2, WrUnit))

# `for k, $v <- $each:` over `$(k ==> $v)` (Semantics ch. 4, ruling FV; a host document's
# entries, `$(Path ==> $Elem c)`, and `@PerKey`'s inners): `$v` is the row's entry flattened.
# `{name}_inner` is the current inner, a hold set at the row's construction to the entry's
# value (the `value` its builder hands it, so the row's own builders read `$v` from the
# start), and `{name}_follow` its subscription to the inner's update event, which tells the
# row through `{name}_moved` (what reads `$v` reads it again, in that tick). When the
# `for`'s builder, walking the keys after a write of the source, finds another dynamic than
# the inner under the row's kept key, it tells the row (`{name}_replaced`, `ForBuild`), which
# queues the adoption for the start of the tick after (`{name}_adopt`, through
# `Cx::answer_later`, so that tick is owed; rulings VL, TK). No row is woken to ask.
EntryFlatten: unbounded fn Wx, OutTy, ?Bn -> ((Wx, Wres))
fn EntryFlatten wx, t, ?bound:
    let ((name, wx1)) = match ?bound:
        ? (BnHold f, ignore): ((f, wx))
        # bound as a widget's result (`IsGetterBuiltin`): the getter the name was pre-bound to
        ? (BnDyn (XMethod (XSelf), f, ignore), ignore, ignore): ((f, wx))
        otherwise: FreshName wx, "flatten"
    let inner = "{name}_inner"
    let follow = "{name}_follow"
    let followed = DoExpr (XMethod (XField (XVar "node"), follow), "follow", [[(XRef (XField (XMethod (XVar "node"), "entry", [[XCx]]), "updates")), (XRef (XVar "node")), (XPath (RefChild (SiteRef wx.lx, wx.node), "{name}_moved"))]])
    let sample = XMethod (XMethod (XMethod (XField XSelf, "{inner}"), "get", [[XCx]]), "expect", [[(XStr "`@Flatten` adopts its first inner at the build")]]), "sample", [[XCx]]
    let wx2 = update wx1:
        &_.taken <= Append &_.taken, [[inner, follow, "{name}_adopt", "{name}_moved", "{name}_replaced"]]
        &_.fields <= Append &_.fields, [[((inner, (OutHold (OutOpt (OutDyn t))), "`@Flatten`'s current inner: the row's entry it adopted")), ((follow, (OutNamed (RefRuntime "prism_rtl::Follow"), [[]]), "the subscription to the inner's update event"))]]
        &_.moves <= Append &_.moves, [[((inner, (XCall (RefRuntime "rt::Hold::new"), [[(XCtor (RefRuntime "std::Some"), [[(XClone (XVar "value"))]]), XCx]]))), ((follow, (XCall (RefRuntime "prism_rtl::Follow::new"), [[]])))]]
        &_.build <= Push &_.build, followed
        &_.getters <= Push &_.getters, (MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=sample, doc="`@Flatten`'s dynamic: its current inner at the read point."))
        &_.dynReads <= Insert &_.dynReads, name, [[OwnRead inner]]
        &_.flattens <= Push &_.flattens, FlatDef(name=name, outer="entry", generation="", held=False, ty=t)
    ((wx2, (WrDyn (XMethod (XSelf), name, [[XCx]]), [[OwnRead inner]], t)))

# `@Switch $!a`: the event its `rebuild` forwards. Any other dynamic of events (`@Switch
# (!MergeAll $evs)`, a map over a dynamic list) is refused: its event is not the inner
# the outer holds.
SwitchLine: unbounded fn Wx, Env, [Arg] -> ((Wx, Wres))
fn SwitchLine wx, menv, args = match args[0]:
    ? a:
        let rebuilt = match a.value.kind:
            EName n: match menv.names[SNameKey n]:
                ? (BnEv ignore, ignore): True
                otherwise: False
            otherwise: False
        if rebuilt:
            let ((r, wx2)) = EventRef wx, menv, a.value
            ((wx2, (WrEv r)))
        else: HeldSwitch wx, menv, a.value
    nil: ((wx, WrUnit))

# `@Switch $!x` over any other dynamic of events (round 47 SW; the Compiler seed, `@Switch`:
# the switch listens to the inner the dynamic holds after each tick, from n+1, with no
# catch-up). The outer is a live `Dynamic<Event<a>>`, made once the node is (`{name}_outer`,
# a name's live dynamic from `WholeArgs`, or a lifted expression, `@Switch (!MergeAll
# $evs)`, evaluated whole); the inner's firings reach the graph through a port node,
# `{name}`, as an event value's do (`EventObjectRef`), heard by a runtime `Listen`. The
# outer's update event puts the node on the swap list (`{name}_outer_moved`,
# `Cx::swap_later`), and `swap`, after the tick's propagation, listens to the inner the
# outer then holds and lets go of the old one.
HeldSwitch: unbounded fn Wx, Env, Expr -> ((Wx, Wres))
fn HeldSwitch wx, menv, x:
    let lx = wx.lx
    let t = OutTyOf lx, (Peel (Peel (TypeAt lx, x.span)))
    let lxw = update lx:
        &_.whole <= True
    let ((name, w1)) = FreshName wx, "switched"
    let ((id, w2)) = AddGn w1, name, t, GnPort, 0
    let outer = "{name}_outer"
    let listen = "{name}_listen"
    let ofollow = "{name}_ofollow"
    let outerTy = OutDyn (OutEvent t)
    let made = MethDef(name="{outer}_made", recv=RecvRef, params=[[]], cx=CxRef, ret=outerTy, body=[[]], tail=(Own (ValueOf lxw, menv, x)), doc="`{SrcText lx, lx.file, x.span}`, the switch's outer, as a live dynamic.")
    let outerNow = XMethod (XMethod (XField (XVar "node"), outer), "get", [[XCx]]), "expect", [[(XStr "`@Switch`'s outer is made at the build")]]
    let setOuter = DoExpr (XMethod (XField (XVar "node"), outer), "set", [[(XCtor (RefRuntime "std::Some"), [[(XMethod (XVar "node"), "{outer}_made", [[XCx]])]]), XCx]])
    let listened = DoExpr (XMethod (XField (XVar "node"), listen), "listen", [[(XRef (XMethod outerNow, "sample", [[XCx]])), (XRef (XVar "node")), (XPath (RefChild (SiteRef lx, wx.node), name))]])
    let followed = DoExpr (XMethod (XField (XVar "node"), ofollow), "follow", [[(XRef (XField outerNow, "updates")), (XRef (XVar "node")), (XPath (RefChild (SiteRef lx, wx.node), "{name}_outer_moved"))]])
    let moved = MethDef(name="{name}_outer_moved", recv=RecvRc, params=[[]], cx=CxMut, ret=OutUnit, body=[[DoExpr (XMethod (XCx), "swap_later", [[(XClone XSelf)]])]], tail=(XUnit), doc="The switch's outer fired: after the tick's propagation the switch takes the inner it then holds.")
    let w3 = update w2:
        &_.taken <= Append &_.taken, [[outer, listen, ofollow, "{outer}_made", "{name}_outer_moved"]]
        &_.fields <= Append &_.fields, [[((outer, (OutHold (OutOpt outerTy)), "`@Switch`'s outer, made at the build")), ((listen, (OutNamed (RefRuntime "prism_rtl::Listen"), [[t]]), "the subscription to the switch's current inner")), ((ofollow, (OutNamed (RefRuntime "prism_rtl::Follow"), [[]]), "the subscription to the outer's update event"))]]
        &_.moves <= Append &_.moves, [[((outer, (XCall (RefRuntime "rt::Hold::new"), [[XNone, XCx]]))), ((listen, (XCall (RefRuntime "std::Default::default"), [[]]))), ((ofollow, (XCall (RefRuntime "prism_rtl::Follow::new"), [[]])))]]
        &_.build <= Append &_.build, [[setOuter, listened, followed]]
        &_.getters <= Append &_.getters, [[made, moved]]
        &_.switches <= Push &_.switches, name
    ((w3, (WrEv (EvRefOf w3, id))))

# The `swap` hook's body: each held switch listens to the inner its outer holds now.
SwapBody: fn Wx -> [Do]
fn SwapBody wx = Each wx.switches, \|name|
    let outerNow = XMethod (XMethod (XField XSelf, "{name}_outer"), "get", [[XCx]]), "expect", [[(XStr "`@Switch`'s outer is made at the build")]]
    DoExpr (XMethod (XField XSelf, "{name}_listen"), "listen", [[(XRef (XMethod outerNow, "sample", [[XCx]])), (XRef (XClone XSelf)), (XPath (RefChild (SiteRef wx.lx, wx.node), name))]])
