# `Lower.Node.Def`, a child module of `Lower.Node`.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit r
use Lower.Node.*
use Lower.Node.Elements.*
use Lower.Node.Static.*
use Lower.Node.Dynamics.*
use Lower.Node.Finish.*
use Lower.Node.Keyed.*
use Lower.Node.Switch.*
use Syntax.*
use Syntax.Decls.*
use Syntax.Lexer.*
use Syntax.Lexer.Chars.*
use Syntax.Lexer.Layout.*
use Syntax.Lexer.Words.*
use Syntax.Lexer.Literals.*
use Syntax.Lexer.Templates.*
use Syntax.Lexer.Corpus.*
use Check.Errors.*
use Check.Types.*
use Check.Types.Recording.*
use Check.Types.Unify.*
use Check.Types.Schemes.*
use Check.Types.Colors.*
use Check.Env.*
use Check.Env.Names.*
use Check.Env.Reading.*
use Check.Env.Decls.*
use Check.Env.Traits.*
use Check.Typed.*
use Check.Typed.Print.*
use Lower.*
use Lower.Types.*
use Lower.Expr.*
use Lower.Patterns.*
use Lower.Templates.*
use Lower.Functions.*
use Lower.Jobs.*
use Lower.Program.*
use Lower.Model.*

# ---------------------------------------------------------------------------------------
# A node from a widget definition
# ---------------------------------------------------------------------------------------

# A widget (`@name:` or `fn @Name params:` with one clause) as a node: its parameters are
# its constructor's and fields; its block lowers into the node.
NodeDefOf: unbounded fn Lx, Text, [Pattern], Block, Scheme, Bool -> NodeDef
fn NodeDefOf lx, qk, params, body, sc, isRoot:
    let name = NodeName qk
    let ptys = match sc.ty:
        TyFn ignore, ps, ignore: ps
        otherwise: [[]]
    let wx0 = NewWx lx, name, [[]], [[]], [[]], [[]], {}, nodeHooks, [[]], nil
    let ((ps, wx1, benv, menv)) = Fold (Range0 (Len params)), (([[]], wx0, emptyEnv, emptyEnv)), \|((acc, w, be, me)), i|
        let p = Or params[i], dummyPat
        let nkey = PlainBinder lx, p
        let base = if nkey == "": "arg{i}" else: LocalNameAt lx, nkey, p.span
        let ((rs, w2)) = FreshName w, base
        let t = OutTyOf lx, (Peel (Or ptys[i], TyErr))
        let w3 = update w2:
            &_.fields <= Push &_.fields, ((rs, t, "a parameter"))
            &_.inits <= Push &_.inits, ((rs, (XClone (XVar rs))))
        let ((be2, me2)) = BindPlain be, me, nkey, rs, t
        (((Push acc, ((rs, t))), w3, be2, me2))
    let wx2 = BlockInto wx1, benv, menv, body
    let wx3 = if isRoot: RootResult wx2 else: wx2
    FinishNode wx3, qk, ps, False

# A node's expression of itself, as its build reads it once the node is made.
OverNode: fn Ex -> Ex
fn OverNode x = match x:
    XSelf: XVar "node"
    XField y, f: XField (OverNode y), f
    XMethod y, m, xs: XMethod (OverNode y), m, xs
    XClone y: XClone (OverNode y)
    otherwise: x

# The root's result goes to the World (claude/backend.md: `cx.result(..)`).
RootResult: unbounded fn Wx -> Wx
fn RootResult wx = RootResultOf wx, wx.result

# One result told the World: an event's firings, a dynamic at the build and whenever it
# moves, a plain value at the build. A bundle is told part by part (Type System ch. 2,
# "Bundles and sparse tuples"): its plain parts at the build, each firing of its event
# parts after, each dynamic part at the build and in each tick it moves, in the bundle's
# order (a tick holds every result told in it). Each dynamic part has its own getter and
# its own last value told (`RootResultStem`).
RootResultOf: unbounded fn Wx, Wres -> Wx
fn RootResultOf wx, res = match res:
    WrEv r: Connect wx, r, SkResult
    WrDyn x, rds, t:
        let k = Len wx.rootDyns
        update wx:
            &_.rootDyns <= Push &_.rootDyns, ((x, rds, t))
            &_.taken <= Append &_.taken, [[(RootResultStem "result_value", k), (RootResultStem "result_last", k)]]
            &_.getters <= Push &_.getters, MethDef(name=(RootResultStem "result_value", k), recv=RecvRef, params=[[]], cx=CxRef, ret=OutPod, body=[[]], tail=(XMethod x, "to_pod", [[]]), doc="The root's dynamic result, pulled after the tick.")
            &_.fields <= Push &_.fields, (((RootResultStem "result_last", k), (OutCell (OutOpt OutPod)), "the result the World last heard"))
            &_.moves <= Push &_.moves, (((RootResultStem "result_last", k), (XCall (RefRuntime "std::RefCell::new"), [[XNone]])))
            &_.build <= Push &_.build, (DoScope (ResultTold (XVar "node"), k))
    WrPlain x, ignore: update wx:
        &_.build <= Push &_.build, (DoExpr (XMethod (XCx), "result", [[(XCtor (RefRuntime "rt::Outcome::Value"), [[(XMethod x, "to_pod", [[]])]])]]))
    # a late result: read from the node once its rows are built
    WrLate x, ignore: update wx:
        &_.build <= Push &_.build, (DoExpr (XMethod (XCx), "result", [[(XCtor (RefRuntime "rt::Outcome::Value"), [[(XMethod (OverNode x), "to_pod", [[]])]])]]))
    WrParts parts: Fold parts, wx, \|w, part| RootResultOf w, part
    otherwise: wx

# A block's statements into the node, names bound before any line is read (one binding
# group): the bound events, holds and dynamics first, with each hold's value at the build;
# then every line in page order, which decides positions; then the build's `let`s put in
# the order of what the lines read (Semantics ch. 4: the order of the lines decides
# positions and nothing else), so a line reads at the build a name bound below it.
BlockInto: unbounded fn Wx, Env, Env, Block -> Wx
fn BlockInto wx, benv0, menv0, b:
    let ((benv, menv)) = WithElementLets wx.lx, benv0, menv0, b
    let env = WithLocalWidgets menv, b
    let wxe = update wx:
        &_.earlyChoices <= Fold (Range0 (Len b.stmts)), &_.earlyChoices, \|acc, i| if IsEarlyChoiceAt wx.lx, env, b, i: AddText acc, (EarlyChoiceKey (Or b.stmts[i], dummyStmtL)) else: if IsPureChoiceAt wx.lx, env, b, i, 16: AddText acc, (PureChoiceStmtKey (Or b.stmts[i], dummyStmtL)) else: acc
    match ?LateLineAt wx.lx, menv, b, 16:
        ? k: SplitBlockInto wxe, benv, menv, b, k
        nil:
            let ((wx2, ignore, ignore)) = LinesInto wxe, benv, menv, b, False
            wx2

# A building `match` whose plain result a line above it takes as a value at the build (a
# widget's plain argument, a builder's rows; Semantics ch. 4: the order of a group's
# lines decides positions and nothing else): its generation is built early, in the
# block's own build before the node (`EarlyChoiceLine`), so the result is a value of the
# build like any other and the block is not split at the line. That works where the
# arms read nothing of the block (the node does not exist yet when the arm is built) and
# no arm has a guard; any other such line is late, and the line above that takes its name
# is refused there (`BindLate`).
IsEarlyChoiceAt: unbounded fn Lx, Env, Block, Nat -> Bool
fn IsEarlyChoiceAt lx, menv, b, i = match (Or b.stmts[i], dummyStmtL).kind:
    SBind p, e, nil: match (Ungrouped e).kind:
        EMatch ignore, arms:
            let names = Filter (PatternNames p), \|n| not (IsTimeName n)
            let plain = (IsPlainResult lx, e) and not (IsBundle (LineOutFull lx, e))
            let unguarded = Fold arms, True, \|ok, a| ok and a.?guard == nil
            let blockDefs = Fold b.stmts, [[]], \|acc, st| UnionTexts acc, (Check.Blocks.GroupDefs st)
            let closed = Fold arms, True, \|ok, a|
                let own = match a.?pattern:
                    ? q: PatternNames q
                    nil: [[]]
                ok and Fold (FreeReads (BlockExprs a.body), [[((own, a.span))]]), True, \|ok2, n| ok2 and (not (HasKey menv.names, n)) and not (HasText blockDefs, n)
            let taken = Fold (Range0 i), False, \|f, j| f or TakesAtBuild lx, (Or b.stmts[j], dummyStmtL), names
            plain and unguarded and closed and taken and not (IsPureChoiceAt lx, menv, b, i, 16)
        otherwise: False
    otherwise: False

# A building `match` or `if` whose plain result a building `match` or `if` above it reads
# (Semantics ch. 4: the order of a group's lines decides positions and nothing else;
# ruling TC: places are counted as they are built). The line above builds a row or
# another by the result, so the places of the line's own row take their numbers from a
# count that reads the result that row gives: no order of building the two rows numbers
# both. Where every arm gives its result from what it reads of the block, of its own
# pattern and of its own plain `let`s, and from nothing its own lines build, the result
# needs no row: it is computed in the block's build as a plain `match` or `if` over the
# same arms, each arm its plain `let`s and its result (`PureChoiceValue`), a value of the
# build like any other. The line is not late then, the block is not split at it, and both
# lines are built in place order as any generations are. What the arms read must have a
# value at the build: no plain name another late line of the block binds.
IsPureChoiceAt: unbounded fn Lx, Env, Block, Nat, Nat -> Bool
fn IsPureChoiceAt lx, menv, b, i, depth = match (Or b.stmts[i], dummyStmtL).kind:
    SBind p, e, nil:
        let names = Filter (PatternNames p), \|n| not (IsTimeName n)
        let plain = (IsPlainResult lx, e) and not (IsBundle (LineOutFull lx, e))
        let taken = Fold (Range0 i), False, \|f, j| f or ((IsChoiceLine (Or b.stmts[j], dummyStmtL)) and TakesAtBuild lx, (Or b.stmts[j], dummyStmtL), names)
        if not (plain and taken): False
        else: match ?PureChoice e:
            ? ((heads, bodies)):
                let lateDefs = Fold (Range0 (Len b.stmts)), [[]], \|acc, j| if j == i: acc else: match (Or b.stmts[j], dummyStmtL).kind:
                    SBind q, x, nil: if IsLateExpr lx, menv, x, depth: UnionTexts acc, (Filter (PatternNames q), \|n| not (IsTimeName n)) else: acc
                    otherwise: acc
                let read = FreeReads (Fold bodies, heads, \|acc, body| Append acc, (BlockExprs (PureArm lx, body))), [[]]
                (Fold bodies, True, \|ok, body| ok and IsPureArm lx, body) and Fold read, True, \|ok, n| ok and not (HasText lateDefs, n)
            nil: False
    otherwise: False

# Whether a line is a building `match` or `if`.
IsChoiceLine: fn Stmt -> Bool
fn IsChoiceLine st:
    let ?line = match st.kind:
        SBind ignore, e, nil: ? e
        SIgnore e: ? e
        SExpr e: ? e
        otherwise: nil
    match ?line:
        ? e: match (Ungrouped e).kind:
            EIf ignore, ignore, ignore: True
            EMatch ignore, ignore: True
            otherwise: False
        nil: False

# A building `match` or `if` with an `else`, as what its arms are chosen by (the
# scrutinee and the guards, or the condition) and its arms' blocks.
?PureChoice: unbounded fn Expr -> ?(([Expr], [Block]))
fn ?PureChoice e = match (Ungrouped e).kind:
    EMatch s, arms: ? (((Fold arms, (ExprsIn s), \|acc, a| Append acc, (GuardExprs a.?guard)), (Each arms, \|a| a.body)))
    EIf c, thenB, (? elseB): ? (((CondExprs c), [[thenB, elseB]]))
    otherwise: nil

GuardExprs: unbounded fn ?Expr -> [Expr]
fn GuardExprs (? g) = ExprsIn g
fn GuardExprs nil = [[]]

# A `let` of plain names whose value holds no event and no dynamic.
IsPlainLet: unbounded fn Lx, Stmt -> Bool
fn IsPlainLet lx, st = match st.kind:
    SLet p, ignore, e: (Fold (PatternNames p), True, \|ok, n| ok and not (IsTimeName n)) and not (TimeWithin (TypeAt lx, e.span))
    otherwise: False

# An arm's block as the value it gives: its plain `let`s and the expression it ends on
# with `@`.
PureArm: unbounded fn Lx, Block -> Block
fn PureArm lx, body:
    let lets = Filter (Take body.stmts, (Dec (Len body.stmts))), \|st| IsPlainLet lx, st
    match (Or body.stmts[Dec (Len body.stmts)], dummyStmtL).kind:
        SExpr y: match y.kind:
            EFreeSigil "@", v: Block(stmts=(Push lets, (Stmt(kind=(SExpr v), span=v.span))), inline=body.inline, span=body.span)
            otherwise: Block(stmts=lets, inline=body.inline, span=body.span)
        otherwise: Block(stmts=lets, inline=body.inline, span=body.span)

# Whether an arm ends on `@ v` and gives `v` from nothing its own lines build or bind
# but its plain `let`s.
IsPureArm: unbounded fn Lx, Block -> Bool
fn IsPureArm lx, body:
    let ends = match (Or body.stmts[Dec (Len body.stmts)], dummyStmtL).kind:
        SExpr y: match y.kind:
            EFreeSigil "@", ignore: True
            otherwise: False
        otherwise: False
    let defs = Fold body.stmts, [[]], \|acc, st| if IsPlainLet lx, st: acc else: UnionTexts acc, (Check.Blocks.GroupDefs st)
    ends and Fold (FreeReads (BlockExprs (PureArm lx, body)), [[]]), True, \|ok, n| ok and not (HasText defs, n)

# The plain result of a pure building `match` or `if` (`IsPureChoiceAt`), computed in the
# block's build: the same choice over each arm's plain `let`s and result.
PureChoiceValue: unbounded fn Lx, Env, Expr -> Vl
fn PureChoiceValue lx, benv, e:
    let t = OutTyOf lx, (OutOf (TypeAt lx, e.span))
    match (Ungrouped e).kind:
        EMatch s, arms: MatchValue lx, benv, s, (Each arms, \|a| PureArmOf lx, a), t, e.span
        EIf c, thenB, (? elseB): IfValue lx, benv, c, (PureArm lx, thenB), (? (PureArm lx, elseB)), t
        otherwise: VlOwned (InternalBug "a pure building choice that is no `match` and no `if` with an `else`"), t

PureArmOf: unbounded fn Lx, Arm -> Arm
fn PureArmOf lx, a = Arm(?pattern=a.?pattern, ?guard=a.?guard, body=(PureArm lx, a.body), span=a.span)

# The key a pure building choice's line is known by (in `Wx.earlyChoices`).
PureChoiceKey: fn Expr -> Text
fn PureChoiceKey e = "pure:{InitKey (Ungrouped e)}"

PureChoiceStmtKey: fn Stmt -> Text
fn PureChoiceStmtKey s = match s.kind:
    SBind ignore, e, nil: PureChoiceKey e
    otherwise: ""

# The key an early building `match` line is known by (`Wx.earlyChoices`).
EarlyChoiceKey: fn Stmt -> Text
fn EarlyChoiceKey s = match s.kind:
    SBind ignore, e, nil: InitKey (Ungrouped e)
    otherwise: ""

# Whether a line takes one of some names as a value at the build: a line that builds and
# is no element's (an element's field is live over a late name's getter, `ElementLine`).
TakesAtBuild: unbounded fn Lx, Stmt, [Text] -> Bool
fn TakesAtBuild lx, st, names:
    let ?line = match st.kind:
        SBind ignore, e, nil: ? e
        SIgnore e: ? e
        SExpr e: ? e
        otherwise: nil
    match ?line:
        ? e:
            let tagName = match (Ungrouped e).kind:
                ECall c, ignore, ignore, ignore: TagNameOf lx, c
                EName ignore: TagNameOf lx, (Ungrouped e)
                otherwise: ""
            let placed = match lx.g.tags[tagName]:
                ? tg: tg.kind == "Element"
                nil: False
            (not placed) and Fold (ReadsOfLine st), False, \|f, n| f or HasText names, n
        nil: False

# A block's `let`s of an element tag applied (`let made = Ui.Label(..)`; Semantics ch. 8,
# "Elements and the element statement": the `let` is a value and `@Element made` a
# blueprint, the element statement at the same path): each name's expression is kept
# under `{name}#element`, and `@Element made` as a line is that element's line
# (`ElementCallLine`), lowered in the placing line's environments. A name no line reads
# but to place it is marked `{name}#placed`: its `let` is no value of the node, and
# nothing is lowered for it.
WithElementLets: unbounded fn Lx, Env, Env, Block -> ((Env, Env))
fn WithElementLets lx, benv, menv, b = Fold b.stmts, ((benv, menv)), \|((be, me)), s| match s.kind:
    SLet p, ignore, e: match p.kind:
        PName n:
            # a blueprint (`let @w = @Tile k`; Semantics ch. 8: a blueprint builds nothing
            # until a block applies it): the name is its expression, kept under
            # `{name}#blueprint` and built by each line that applies it, in that line's
            # environments (`WidgetLine`); read as a value it is the expression in its
            # place (`NameValue`). The `let` is no value of the node.
            if (LayerOf (BinderTy lx, n.span)) == LyBlueprint:
                let held = BnWidget (Ungrouped e), emptyEnv, emptyEnv, lx
                let nkey = SNameKey n
                (((Bind (Bind be, "{nkey}#blueprint", held), "{nkey}#placed", held), (Bind (Bind me, "{nkey}#blueprint", held), "{nkey}#placed", held)))
            else: if not (IsTagApplication lx, e): ((be, me))
            else:
                let nkey = SNameKey n
                let held = BnWidget (Ungrouped e), emptyEnv, emptyEnv, lx
                let others = Filter b.stmts, \|st| (HasText (ReadsOfLine st), nkey) and (?PlacedName lx, st) != (? nkey)
                let be1 = Bind be, "{nkey}#element", held
                let me1 = Bind me, "{nkey}#element", held
                if (Len others) == 0: (((Bind be1, "{nkey}#placed", held), (Bind me1, "{nkey}#placed", held))) else: ((be1, me1))
        otherwise: ((be, me))
    otherwise: ((be, me))

# The name a line places with `@Element` (`@Element made`, `!go <- @Element button`).
?PlacedName: unbounded fn Lx, Stmt -> ?Text
fn ?PlacedName lx, s:
    let ?line = match s.kind:
        SBind ignore, e, nil: ? e
        SIgnore e: ? e
        SExpr e: ? e
        otherwise: nil
    match ?line:
        ? e: match (Ungrouped e).kind:
            ECall c, args, ignore, ignore:
                if (CalleeKey lx, c) != "Prelude.@Element": nil
                else: match args[0]:
                    ? a: match (Ungrouped a.value).kind:
                        EName n: if (Len n.path) == 1: ? (SNameKey n) else: nil
                        otherwise: nil
                    nil: nil
            otherwise: nil
        nil: nil

# Whether a `let` binds a name that is only placed (`WithElementLets`).
IsPlacedLet: fn Env, Pattern -> Bool
fn IsPlacedLet menv, p = match p.kind:
    PName n: HasKey menv.names, "{SNameKey n}#placed"
    otherwise: False

# A `let` whose pattern is one name of a bundle (`let pair = ((3, !go))`, `let same =
# pair`), by that name.
?BundleLetName: unbounded fn Lx, Stmt -> ?Text
fn ?BundleLetName lx, s = match s.kind:
    SLet p, ignore, ignore: match ?OneName p:
        ? n: if IsBundle (BinderTy (WidgetLetLx lx, n.span), n.span): ? (SNameKey n) else: nil
        nil: nil
    otherwise: nil

# A block's lines with each `let` that names a bundle moved above the first line that
# reads the name, when that line stands above the `let` (Semantics ch. 4, "Binding groups
# and cycles": any line may use any name the block binds, and the order of a group's
# lines decides positions and nothing else; a `let` builds no place, so where it stands
# decides nothing). A bundle's name is its parts, bound where its `let` is lowered
# (`WidgetStmt`), so the lines that read the name are lowered after it. One `let` moves
# at a time, so a bundle named after another follows it up.
BundleLetsEarly: unbounded fn Lx, [Stmt], Nat -> [Stmt]
fn BundleLetsEarly lx, stmts, fuel:
    let ?move = Fold (Range0 (Len stmts)), nil, \|?found, i| if IsSome ?found: ?found else: match ?BundleLetName lx, (Or stmts[i], dummyStmtL):
        ? nkey: Fold (Range0 i), nil, \|?first, j| if IsSome ?first: ?first else: if HasText (ReadsOfLine (Or stmts[j], dummyStmtL)), nkey: ? ((i, j)) else: nil
        nil: nil
    match ?move:
        ? ((i, j)) if fuel > 0:
            let moved = Or stmts[i], dummyStmtL
            BundleLetsEarly lx, (Append (Push (Take stmts, j), moved), (Filter (Drop stmts, j), \|st| not (HasStmt [[moved]], st))), (Dec fuel)
        otherwise: stmts

# Whether a line is the block's last as it is written.
IsLastLine: fn ?Stmt, Stmt -> Bool
fn IsLastLine (? last), st = HasStmt [[last]], st
fn IsLastLine nil, st = False

# A block's lines lowered into the node, and the environments after them. `open`: the
# block goes on after these lines (`SplitBlockInto`), so the last of them is not its
# result.
LinesInto: unbounded fn Wx, Env, Env, Block, Bool -> ((Wx, Env, Env))
fn LinesInto wx, benv0, menv0, b, open:
    # a `let` that names a bundle stands above the first line that reads the name
    # (`BundleLetsEarly`)
    let stmts = BundleLetsEarly wx.lx, b.stmts, (Len b.stmts)
    let ?last = b.stmts[Dec (Len b.stmts)]
    # the plain `let`s that read a late name are late themselves, marked before any name
    # is bound (`MarkLateLets`), their getters made once every name is (`LateLetGetters`)
    let fns = Fold (Filter stmts, IsFnLine), emptyEnv, \|en, s| match s.kind:
        SFn c: Bind en, (DefNameText c.name), (WithClause en, (DefNameText c.name), c)
        otherwise: en
    let ((wx0, benv, menv)) = MarkLateLets wx, benv0, menv0, fns, stmts, (Len stmts)
    let ((wx1p, be1, me1)) = Fold stmts, ((wx0, benv, menv)), \|((w, be, me)), s| PreBind w, be, me, s
    let wx1 = LateLetGetters wx1p, me1, stmts
    let order = BuildOrder stmts
    let ((wx2, be2)) = Fold order, ((wx1, be1)), \|((w, be)), comp| Fold comp, ((w, be)), \|((w2, be3)), i| PreInit w2, be3, me1, (Or stmts[i], dummyStmtL)
    let n = Len stmts
    let start = Len wx2.lets
    let ((wx3, be4, me4, ends)) = Fold (Range0 n), ((wx2, be2, me1, [[]])), \|((w, be, me, acc)), i|
        let ((w2, be3, me3)) = WidgetStmt w, be, me, (Or stmts[i], dummyStmtL), (not open) and (IsLastLine ?last, (Or stmts[i], dummyStmtL))
        ((w2, be3, me3, (Push acc, (Len w2.lets))))
    (((BuildInOrder wx3, stmts, order, start, ends), be4, me4))

# A late result (`WrLate`) is a plain result its node can read only once its rows are
# built: the plain result of a building `match` or `if` (the arm's row keeps it), and of a
# block split around such a line (`SplitBlockInto`), which the lines below the split give.

# The first line of a block that binds a late result (`n <- match mode: ..`, Semantics ch.
# 4 and ch. 8): where the block's build is split. `menv` gives the widget parameters and
# the local widgets a line may apply.
?LateLineAt: unbounded fn Lx, Env, Block, Nat -> ?Nat
fn ?LateLineAt lx, menv, b, depth:
    let env = WithLocalWidgets menv, b
    Fold (Range0 (Len b.stmts)), nil, \|?found, i| match ?found:
        ? k: ? k
        nil: match (Or b.stmts[i], dummyStmtL).kind:
            SBind ignore, e, nil: if (IsLateExpr lx, env, e, depth) and not ((IsEarlyChoiceAt lx, env, b, i) or IsPureChoiceAt lx, env, b, i, depth): ? i else: nil
            otherwise: nil

# An environment with a block's own local widgets (`@line:` and its block), as `PreBind`
# binds them.
WithLocalWidgets: fn Env, Block -> Env
fn WithLocalWidgets env, b = Fold b.stmts, env, \|en, s| match s.kind:
    SWidget w: Bind en, (SNameKey w.name), (BnLocalWidget w.body)
    otherwise: en

# Whether a building line's result is late: a building `match` or `if` whose arms end on a
# plain result, a widget block that ends late, a widget of one clause applied whose block
# does, a widget parameter applied whose argument is late, or a local widget whose block
# is. `depth` bounds the walk through widgets that apply each other.
IsLateExpr: unbounded fn Lx, Env, Expr, Nat -> Bool
fn IsLateExpr lx, menv, e, depth = match e.kind:
    EGroup x: IsLateExpr lx, menv, x, depth
    EIf ignore, ignore, (? ignore): IsPlainResult lx, e
    EMatch ignore, ignore: IsPlainResult lx, e
    EWidgetBlock b: IsLateBlock lx, menv, b, depth
    otherwise:
        let ((callee, args)) = match e.kind:
            ECall c, xs, ignore, ignore: ((c, xs))
            otherwise: ((e, [[]]))
        match callee.kind:
            EName n:
                let ?local = if (Len n.path) != 1: nil else: match menv.names["{SNameKey n}#blueprint"]:
                    # a blueprint a `let` of the block names: its expression, here
                    ? (BnWidget x, ignore, ignore, ignore): ? (BnWidget x, emptyEnv, menv, lx)
                    otherwise: menv.names[SNameKey n]
                match ?local:
                    # a widget parameter applied: its argument, in its caller's environment
                    ? (BnWidget x, ignore, cmenv, clx): depth > 0 and IsLateExpr clx, cmenv, x, (Dec depth)
                    ? (BnLocalWidget wb): depth > 0 and IsLateBlock lx, menv, wb, (Dec depth)
                    # a blueprint value the node holds, applied (`AppliedBlueprintLine`):
                    # what it gives is known once it is built, after the node
                    ? (BnLocal ignore, ignore, ignore): (Len args) == 0 and (LayerOf (TypeAt lx, e.span)) == LyBlueprint and IsPlainResult lx, e
                    otherwise:
                        let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
                        match ?q:
                            # `@Element e` of an element value (a parameter, a call's
                            # result) is its blueprint applied (`ElementCallLine`,
                            # `AppliedBlueprintLine`): a plain answer is known once the
                            # blueprint is built, after the node
                            ? "Prelude.@Element": match args[0]:
                                ? a: (not (IsTagApplication lx, a.value)) and (not (IsSome (?ElementLet menv, a.value))) and IsPlainResult lx, e
                                nil: False
                            ? q: match lx.g.vals[q]:
                                ? v if IsRecursingCall lx, q, v, e: True
                                ? v: match ?OneBody lx, q:
                                    ? body: depth > 0 and (IsPlainResult lx, e) and IsLateBlock (InModuleAt lx, v.file, v.home, lx.site), (CalleeWidgetEnv lx, menv, q, v, args), body, (Dec depth)
                                    # a widget of several clauses that ends on a bundle
                                    # with a plain part (`BundleClauseLine`)
                                    nil: (Len (ClausesOf lx.g, q)) > 1 and (IsBundle (LineOutFull lx, e)) and IsPlainResult lx, e
                                nil: False
                            nil: False
            otherwise: False

# Whether a call is of a widget that calls itself, written inside that widget's own body,
# and sharable (`IsSharable`) with a plain result: past the first level it is a
# generation of shared rows built after its block's node (`SharedClauseLine`), so its
# result is late. In a hosted scope the call is lowered level by level and its result may
# have a value at the build: the block is split all the same (`SplitBlockInto` keeps
# such a value in a field).
IsRecursingCall: unbounded fn Lx, Text, ValInfo, Expr -> Bool
fn IsRecursingCall lx, q, v, e:
    let ptys = match v.scheme.ty:
        TyFn ignore, ps, ignore: ps
        otherwise: [[]]
    (HasText lx.recursing, q) and (IsPlainResult lx, e) and (not (IsBundle (LineOutFull lx, e))) and (Len (RigidsIn v.scheme.ty)) == 0 and Fold ptys, True, \|ok, pt| ok and (LayerOf pt) == LyPlain and not (IsWidgetFnTy pt)

# The environment a widget of one clause reads its widget parameters in, for lateness: each
# blueprint parameter bound to the call's argument with the caller's environment.
CalleeWidgetEnv: unbounded fn Lx, Env, Text, ValInfo, [Arg] -> Env
fn CalleeWidgetEnv lx, menv, qk, v, args:
    let lxc = InModuleAt lx, v.file, v.home, lx.site
    let ptys = match v.scheme.ty:
        TyFn ignore, ps, ignore: ps
        otherwise: [[]]
    match ClausesOf lx.g, qk:
        [[c]]: Fold (Range0 (Len c.params)), emptyEnv, \|en, i| match ((c.params[i], ptys[i], args[i])):
            ((? p, ? pt, ? a)) if (LayerOf pt) == LyBlueprint: Bind en, (PlainBinder lxc, p), (BnWidget a.value, emptyEnv, menv, lx)
            otherwise: en
        otherwise: emptyEnv

# The block of a widget of one clause (`InlineWidget`).
?OneBody: unbounded fn Lx, Text -> ?Block
fn ?OneBody lx, qk = match ?WidgetDeclOf lx.g, qk:
    ? wd: ? wd.body
    nil: match ClausesOf lx.g, qk:
        [[c]]: match c.body:
            BodyBlock b: ? b
            BodyExpr x: ? (Block(stmts=[[Stmt(kind=(SExpr x), span=x.span)]], inline=True, span=x.span))
        otherwise: nil

# Whether a block's result is late: it ends on a plain result, and it is split, or its
# last line's own result is late.
IsLateBlock: unbounded fn Lx, Env, Block, Nat -> Bool
fn IsLateBlock lx, menv, b, depth = match (Or b.stmts[Dec (Len b.stmts)], dummyStmtL).kind:
    SExpr x: (IsPlainResult lx, x) and ((IsSome (?LateLineAt lx, menv, b, depth)) or IsLateExpr lx, (WithLocalWidgets menv, b), x, depth)
    otherwise: False

# Whether a building line gives a plain value its block may read at the build: a plain
# result that is not unit, or a bundle with such a part (Type System ch. 2, "Bundles and
# sparse tuples").
IsPlainResult: unbounded fn Lx, Expr -> Bool
fn IsPlainResult lx, e = PlainIn lx, (LineOutFull lx, e)

PlainIn: unbounded fn Lx, Ty -> Bool
fn PlainIn lx, t = match t:
    TyTuple ts if IsBundle t: Fold ts, False, \|found, x| found or PlainIn lx, x
    otherwise: (LayerOf t) == LyPlain and (OutTyOf lx, (Peel t)) != OutUnit

# What a building line gives back as the checker has it, its layers kept: a blueprint's
# output, an element's output.
LineOutFull: fn Lx, Expr -> Ty
fn LineOutFull lx, e:
    let full = TypeAt lx, e.span
    match Peel full:
        TyElem ignore, o: o
        otherwise: match full:
            TyAt i, ignore: i
            otherwise: full

# What a building line gives back, lowered, and its layer: a blueprint's result, an
# element's output (a label's is unit, a button's its event).
LineResult: unbounded fn Lx, Expr -> ((OutTy, Layer))
fn LineResult lx, e:
    let full = TypeAt lx, e.span
    match Peel full:
        TyElem ignore, o: (((OutTyOf lx, (Peel o)), (LayerOf o)))
        otherwise: (((OutTyOf lx, (OutOf full)), (ResultLayer full)))

# A block whose line `k` binds a late result (Semantics ch. 4: a building `match`'s arm is
# fixed for the life of the block and adds no path segment; ch. 8: `<-` builds the child
# and binds its result, and a block's places are born in source order): the block's build
# is split around that line. The line's row is built once, after the node, and reads the
# block's names through it; the node keeps its plain result (`BuildingChoiceLine`). The
# lines below that build a place, or that read at their build what such a line binds, are
# one more generation, built once after that row, at the block's next positions, the
# line's pattern its binder and the kept result its value; it reads the block's names
# through the node as an arm does, and its result is the block's: an event's or a
# dynamic's as an arm's is, a plain one late.
# The order of the lines decides positions and nothing else (Semantics ch. 4), so the
# node's lines and the lower generation's read each other:
# - the lines below the split that build no place (a hold, a `let`, a local function, a
#   local widget) and read nothing a lower place line binds but events are the node's
#   (`HoistedLines`), lowered with the lines above;
# - an event a lower place line binds is a node of the block too, prebound, which the
#   lower generation's own event fires (`PreBindUps`);
# - the line's names are bound in the node's methods to getters over the kept result
#   (`BindLate`), so a hold's step, a dynamic `let` and a place's live field read them; a
#   hold whose first value reads one is set when the line's row is built (`HoldLine`).
SplitBlockInto: unbounded fn Wx, Env, Env, Block, Nat -> Wx
fn SplitBlockInto wx00, benv00, menv00, b, k:
    let lx = wx00.lx
    # the late first values of an enclosing split wait for their own line
    let outerLate = wx00.lateInits
    let wxa = update wx00:
        &_.lateInits <= [[]]
    let s = Or b.stmts[k], dummyStmtL
    # a split line that binds a bundle: its events and dynamics are names of the node,
    # prebound as any line's are, and only its plain parts are late
    let bundled = match s.kind:
        SBind ignore, e, nil: IsBundle (LineOutFull lx, e)
        otherwise: False
    let ((wx, benv, menv)) = if bundled: PreBind wxa, benv00, menv00, s else: ((wxa, benv00, menv00))
    let lateNames = match s.kind:
        SBind p, ignore, nil: Filter (PatternNames p), \|n| not (IsTimeName n)
        otherwise: [[]]
    let below = Drop b.stmts, k + 1
    # a plain `let` below the split that a line above it reads is the node's, late as
    # what it reads is (`MarkLateLets`)
    let aboveReads = Fold (Take b.stmts, k), [[]], \|acc, st| UnionTexts acc, (ReadsOfLine st)
    let hoisted = HoistedLines below, lateNames, aboveReads
    let staying0 = Filter below, \|st| not (HasStmt hoisted, st)
    # the block's result is its last line's: when that line is the node's, the lower
    # generation gives nothing back
    let lastHoisted = match b.stmts[Dec (Len b.stmts)]:
        ? st: (k + 1 < (Len b.stmts)) and HasStmt hoisted, st
        nil: False
    let staying = if lastHoisted: Unresulted staying0 else: staying0
    let head = Block(stmts=(Append (Take b.stmts, k), hoisted), inline=b.inline, span=b.span)
    let rest = Block(stmts=staying, inline=b.inline, span=b.span)
    let ((wxu, beu, meu, ups)) = PreBindUps wx, benv, menv, staying
    # a bundle bound whole to one name (`both <- @Choose mode`): the name is its parts,
    # bound once the line is built (`BindWhole`)
    let ?whole = if not bundled: nil else: match s.kind:
        SBind p, ignore, nil: ?OneName p
        otherwise: nil
    let ((wxl, bel, mel, lates)) = match ((?whole, s.kind)):
        (((? n), (SBind ignore, e, nil))):
            let ((w, be, me)) = PreBindWhole wxu, beu, meu, n, (BundlePartTys (LineOutFull lx, e))
            ((w, be, me, [[]]))
        otherwise: BindLate wxu, beu, meu, s
    let ((wx0, be0, me0)) = LinesInto wxl, bel, mel, head, True
    let ((wx1w, be1w, me1w)) = Fold (LineExprs s), ((wx0, be0, me0)), \|((w, be, me)), e| WholeArgs w, be, me, e, False
    let ((wx1, be1, me1)) = Fold (LineExprs s), ((wx1w, be1w, me1w)), \|((w, be, me)), e| BlueprintValuesAt w, be, me, e, (IsLetOfBlueprint s)
    match s.kind:
        SBind p, e, nil:
            let ((wx2a, late)) = BuildLine wx1, be1, me1, e, nil
            # a bundle's plain parts, each read from the node once its row is built
            let ((wx2, partReads)) = LateParts wx2a, late
            let ((wx2k, kept)) = match late:
                WrLate read, ignore: ((wx2, read))
                WrParts ignore: ((wx2, (XTuple (Each partReads, \|((ignore, read))| read))))
                # a line taken for late whose result has a value at the build after all (a
                # widget that calls itself, lowered level by level, `IsRecursingCall`):
                # kept in a field of the node and read there, as a late one is
                WrPlain ex, t:
                    let ((f, w1)) = FreshName wx2, "split_result"
                    let w2 = update w1:
                        &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind f), t), ex)
                        &_.fields <= Push &_.fields, ((f, t, "the plain result of the line a block is split at"))
                        &_.inits <= Push &_.inits, ((f, (XClone (XVar f))))
                    ((w2, (XClone (XField XSelf, f))))
                otherwise: ((wx2, (Refusal "a block split at a line whose result is not late")))
            let wx2g = LateGetters wx2k, lates, kept, partReads
            # a bundle's events and dynamics, bound in the node as its line binds them
            let ((wx2b, ignore, me2)) = match ((late, p.kind, ?whole)):
                (((WrParts parts), ignore, ? n)): BindWhole wx2g, be1, me1, n, parts, partReads
                (((WrParts parts), PTuple ps, nil)): BindParts wx2g, be1, me1, (Each parts, \|q| if IsTimePart q: q else: WrUnit), ps
                otherwise: ((wx2g, be1, me1))
            let wx2s = update (WithLateInits wx2b, wx2b.lateInits):
                &_.lateInits <= outerLate
            if (Len staying) == 0: SetResult wx2s, WrUnit
            else:
                # what the lines below give back: the block's result
                let ((outTy, layer, outFull)) = match (Or rest.stmts[Dec (Len rest.stmts)], dummyStmtL).kind:
                    SExpr x:
                        let ((t, ly)) = LineResult lx, x
                        ((t, ly, (LineOutFull lx, x)))
                    otherwise: ((OutUnit, LyPlain, (TyCon "unit", [[]])))
                # the lower generation binds its own events: it reads none of them as the block's
                let rowEnv = WithoutNames me2, (Each ups, \|((nkey, ignore, ignore))| nkey)
                # its binder: the line's pattern over the kept result; of a bundle, the
                # patterns of its plain parts over their reads
                let ((scrut, pats, sty)) = if not bundled: ((kept, [[? p]], (OutOf (TypeAt lx, e.span)))) else: LowerBinder lx, p, e, partReads
                let ((wx3, res)) = BuildingChoiceLine wx2s, rowEnv, scrut, pats, sty, [[nil]], [[rest]], outTy, layer, outFull, (Each ups, \|((ignore, mine, blocks))| ((mine, blocks)))
                SetResult wx3, res
        otherwise: update wx1:
            &_.build <= Push &_.build, (InternalBugDo "a block split at a line that binds nothing")

# The one name a pattern is (`both`, `(both)`).
?OneName: fn Pattern -> ?SName
fn ?OneName p = match p.kind:
    PName n: ? n
    PGroup q: ?OneName q
    otherwise: nil

# A bundle with a late plain part bound whole to one name where its block is split
# (Type System ch. 2, "Bundles": a bundle is a plain aggregate, so a name binds it): the
# name is its parts (`BnParts`), bound before any line of the block is lowered
# (`PreBindWhole`), so a line above the split reads the name as a line below does
# (Semantics ch. 4: the order of a group's lines decides positions and nothing else). An
# event part is a node of the block, which the line's event feeds once the line is built
# (`BindWhole`); a dynamic part a getter of the node, defined then; a plain part a getter
# of the node over its read (`LateParts`), with no value at the build, so the name is
# late (`{name}#late`): a building line above the split that reads it is built after the
# row that gives the part (`DeferredLine`), and the lines below the split read it through
# the node (`RowEnvNames`). `tys`: the parts' types as the checker has them.
PreBindWhole: unbounded fn Wx, Env, Env, SName, [Ty] -> ((Wx, Env, Env))
fn PreBindWhole wx, benv, menv, n, tys:
    let nkey = SNameKey n
    let ((wx2, builds, methods)) = PreBindWholeParts wx, nkey, (LocalNameAt wx.lx, nkey, n.span), tys
    let marker = BnLocal (Refusal "the bundle `{nkey}`, whose plain part is late, read as one value at its block's build"), Owned, OutUnit
    let ((wx3, me3)) = LateBundleValue wx2, (Bind (Bind menv, nkey, (BnParts methods)), "{nkey}#late", marker), nkey, (LocalNameAt wx.lx, nkey, n.span), methods, (OutTyOf wx.lx, (TyTuple tys))
    ((wx3, (Bind (Bind (Bind benv, nkey, (BnParts builds)), "{nkey}#late", marker), "{nkey}#value", marker), me3))

# A late bundle as one value (Type System ch. 2, "Bundles": a plain aggregate, a value a
# function takes), for what reads its name as a value from the node's methods (a place's
# field over `StepOf both`, a late `let`, a hold's step): a getter of the node, bound
# under `{name}#value`, that gives the tuple of its parts as the node has them: a plain
# part its read (a late part's getter), an event part the event of a port the part's
# node fires (as a named event's value form, `PreBindName`), a `$` part a live `Dynamic`
# of the node (`LiveDynamic`). At the build the bundle has no value (its plain part is
# late). A bundle with a bundle inside has no such value here, as a bundle that is not
# late has none (`BundleValue`).
LateBundleValue: unbounded fn Wx, Env, Text, Text, [?Bn], OutTy -> ((Wx, Env))
fn LateBundleValue wx, menv, nkey, stem, methods, t:
    let simple = (Len methods) > 0 and Fold methods, True, \|ok, ?part| ok and match ?part:
        ? (BnEv ignore, ignore): True
        ? (BnDyn ignore, ignore, ignore): True
        ? (BnHold ignore, ignore): True
        ? (BnLocal ignore, ignore, ignore): True
        otherwise: False
    if not simple: ((wx, menv))
    else:
        let ((values, wx1)) = Fold (Range0 (Len methods)), (([[]], wx)), \|((acc, w)), i| match ?PartOf methods, i:
            ? (BnEv r, ignore):
                let et = (GnOf w, r.node).ty
                let ((rs, w1)) = FreshName w, "{stem}_value{i}"
                let pf = "{rs}_v_port"
                let pt = OutRc (OutPort et)
                let w2 = update (Connect w1, r, (SkPort "{rs}_v")):
                    &_.taken <= Push &_.taken, pf
                    &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind pf), pt), (XCall (RefRuntime "std::Rc::new"), [[(XCall (RefRuntime "rt::Port::new"), [[]])]]))
                    &_.fields <= Push &_.fields, ((pf, pt, "part {i} of the late bundle `{nkey}` as a value: the port it fires"))
                    &_.moves <= Push &_.moves, ((pf, (XClone (XVar pf))))
                (((Push acc, (XCall (RefRuntime "prism_rtl::Event::of"), [[(XRef (XField XSelf, pf))]])), w2))
            ? (BnDyn ex, reads, dt):
                let ((made, w1)) = LiveDynamic w, "{stem}_value{i}", ex, reads, dt, "part {i} of the late bundle `{nkey}`"
                (((Push acc, (InNode made)), w1))
            ? (BnHold f, dt):
                let ((made, w1)) = LiveDynamic w, "{stem}_value{i}", (XMethod (XField XSelf, f), "get", [[XCx]]), [[OwnRead f]], dt, "part {i} of the late bundle `{nkey}`"
                (((Push acc, (InNode made)), w1))
            ? (BnLocal ex, mode, pt): (((Push acc, (Own (VlPlace ex, mode, pt))), w))
            otherwise: ((acc, w))
        let ((getter, wx2)) = FreshName wx1, "late_{stem}_bundle"
        let wx3 = update wx2:
            &_.getters <= Push &_.getters, (MethDef(name=getter, recv=RecvRef, params=[[]], cx=CxNone, ret=t, body=[[]], tail=(XTuple values), doc="The late bundle `{nkey}` as one value, read once the row that gives its late part is built."))
        ((wx3, (Bind menv, "{nkey}#value", (BnLocal (XMethod XSelf, getter, [[]]), Owned, t))))

# A build's local that is moved into a field of its own name, as the node's methods read
# it (`LiveDynamic` gives the local).
InNode: fn Ex -> Ex
fn InNode ex = match ex:
    XClone (XVar name): XClone (XField XSelf, name)
    other: other

PreBindWholeParts: unbounded fn Wx, Text, Text, [Ty] -> ((Wx, [?Bn], [?Bn]))
fn PreBindWholeParts wx, nkey, stem, tys = Fold tys, ((wx, [[]], [[]])), \|((w, builds, methods)), ty|
    let lx = w.lx
    let i = Len builds
    let t = OutTyOf lx, (Peel ty)
    if IsBundle ty:
        let ((w2, bs, ms)) = PreBindWholeParts w, nkey, "{stem}_{i}", (BundlePartTys ty)
        ((w2, (Append builds, [[(? (BnParts bs))]]), (Append methods, [[(? (BnParts ms))]])))
    else: match LayerOf ty:
        LyEv:
            let ((rs, w1)) = FreshName w, "{stem}_part{i}"
            let ((id, w2)) = AddGn w1, rs, (OutTyOf lx, (Peel (Peel ty))), GnNamed, 0
            let b = BnEv (EvRefOf w2, id), t
            ((w2, (Append builds, [[(? b)]]), (Append methods, [[(? b)]])))
        LyDyn:
            let ((rs, w1)) = FreshName w, "{stem}_part{i}"
            let b = BnDyn (XMethod (XSelf), rs, [[XCx]]), [[OwnRead rs]], t
            ((w1, (Append builds, [[(? b)]]), (Append methods, [[(? b)]])))
        otherwise:
            let ((getter, w1)) = FreshName w, "late_{stem}_p{i}"
            let unbuilt = BnLocal (Refusal "a late plain part of the bundle `{nkey}` read at its block's build by a line of the block's node"), Owned, t
            ((w1, (Append builds, [[(? unbuilt)]]), (Append methods, [[(? (BnLocal (XMethod XSelf, getter, [[]]), Owned, t))]])))

# The parts of a bundle bound whole where its block is split, once its line is built
# (`PreBindWhole` named them): the line's event feeds the part's node, its dynamic is the
# part's getter, a plain part's getter reads it from the node (`LateParts`' read at the
# top of the bundle; inside a bundle of the bundle a late part's own read, and a part
# with a value at the build kept in a field).
BindWhole: unbounded fn Wx, Env, Env, SName, [Wres], [((Nat, Ex))] -> ((Wx, Env, Env))
fn BindWhole wx, benv, menv, n, parts, partReads = match menv.names[SNameKey n]:
    ? (BnParts pre): (((BindWholeParts wx, (SNameKey n), pre, parts, (? partReads)), benv, menv))
    otherwise: (((update wx:
        &_.build <= Push &_.build, (InternalBugDo "the bundle `{SNameKey n}` bound whole where its block is split, whose name was not bound before its lines")), benv, menv))

BindWholeParts: unbounded fn Wx, Text, [?Bn], [Wres], ?[((Nat, Ex))] -> Wx
fn BindWholeParts wx, nkey, pre, parts, ?reads = Fold (Range0 (Len parts)), wx, \|w, i| match (((?PartOf pre, i), (Or parts[i], WrUnit))):
    (((? (BnEv er, ignore)), (WrEv r))): if er.owner != w.node: Crossed w, "the bound event of node `{er.owner}` (its graph node {er.node})" else: if r.node == er.node: w else: Connect w, r, (SkNode er.node)
    (((? (BnDyn (XMethod XSelf, rs, ignore), ignore, ignore)), (WrDyn ex, rds, t))): update w:
        &_.getters <= Push &_.getters, (MethDef(name=rs, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=ex, doc="A dynamic part of the bundle `{nkey}`."))
        &_.dynReads <= Insert &_.dynReads, rs, rds
    (((? (BnParts inner)), (WrParts ps))): BindWholeParts w, nkey, inner, ps, nil
    (((? (BnParts inner)), (WrHosted (WrParts ps), ignore))): BindWholeParts w, nkey, inner, ps, nil
    (((? (BnLocal (XMethod XSelf, getter, ignore), ignore, t)), part)):
        let ?top = match ?reads:
            ? partReads: ?PartRead partReads, i
            nil: nil
        let ((?read, w1)) = match ((?top, part)):
            (((? read), ignore)): (((? read), w))
            ((nil, (WrLate read, ignore))): (((? read), w))
            ((nil, (WrPlain ex, pt))):
                let ((kept, w2)) = KeptPart [[]], w, ex, pt, "a plain part of the bundle `{nkey}`"
                ((kept[0], w2))
            otherwise: ((nil, w))
        match ?read:
            ? read: update w1:
                &_.getters <= Push &_.getters, (MethDef(name=getter, recv=RecvRef, params=[[]], cx=CxNone, ret=t, body=[[]], tail=read, doc="A late plain part of the bundle `{nkey}`, read once the row that gives it is built."))
            nil: update w1:
                &_.build <= Push &_.build, (InternalBugDo "part {i} of the bundle `{nkey}`, bound as a plain value, which its line gives as none")
    otherwise: update w:
        &_.build <= Push &_.build, (InternalBugDo "part {i} of the bundle `{nkey}`, which its line gives as another kind than its type")

# Whether a name is an event's or a dynamic's, by its sigil.
IsTimeName: fn Text -> Bool
fn IsTimeName n = (HasPrefix n, "$") or (HasPrefix n, "!")

# Whether a part of a bundle is an event, a dynamic or a bundle of its own, which its
# line binds in the node (`BindParts`), rather than a plain value.
IsTimePart: fn Wres -> Bool
fn IsTimePart part = match part:
    WrEv ignore: True
    WrDyn ignore, ignore, ignore: True
    WrParts ignore: True
    WrHosted ignore, ignore: True
    otherwise: False

# The plain parts of a bundle bound where its block is split, each by its place in the
# bundle with what reads it from the node: a late part's read; a part with a value at the
# build is kept in a field of the node and read there, so the lines below read every
# plain part the same way.
LateParts: fn Wx, Wres -> ((Wx, [((Nat, Ex))]))
fn LateParts wx, late = match late:
    WrParts parts: Fold (Range0 (Len parts)), ((wx, [[]])), \|((w, acc)), i| match parts[i]:
        ? (WrLate read, ignore): ((w, (Push acc, ((i, read)))))
        ? (WrPlain ex, t):
            let ((f, w1)) = FreshName w, "bundle_part"
            let w2 = update w1:
                &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind f), t), ex)
                &_.fields <= Push &_.fields, ((f, t, "a plain part of a bundle bound where its block is split"))
                &_.inits <= Push &_.inits, ((f, (XClone (XVar f))))
            ((w2, (Push acc, ((i, (XClone (XField XSelf, f)))))))
        otherwise: ((w, acc))
    otherwise: ((wx, [[]]))

# The read of the bundle's part at a place, when it is a plain part.
?PartRead: fn [((Nat, Ex))], Nat -> ?Ex
fn ?PartRead reads, i = Fold reads, nil, \|?found, ((j, read))| if j == i: ? read else: ?found

# What the lower generation of a block split at a bundle's line matches, and against
# what: the patterns of the bundle's plain parts over their reads (one part: its pattern
# over its read; several: a tuple of each; none: nothing).
LowerBinder: fn Lx, Pattern, Expr, [((Nat, Ex))] -> ((Ex, [?Pattern], Ty))
fn LowerBinder lx, p, e, partReads:
    let tys = BundlePartTys (LineOutFull lx, e)
    let ps = match p.kind:
        PTuple qs: qs
        otherwise: [[]]
    let bound = Filter partReads, \|((i, ignore))| i < (Len ps)
    match bound:
        [[]]: ((XUnit, [[nil]], (TyCon "unit", [[]])))
        [[((i, read))]]: ((read, [[ps[i]]], (Or tys[i], TyErr)))
        otherwise: (((XTuple (Each bound, \|((ignore, read))| read)), [[? (Pattern(kind=(PTuple (Each bound, \|((i, ignore))| Or ps[i], dummyPat)), span=p.span))]], (TyTuple (Each bound, \|((i, ignore))| Or tys[i], TyErr))))

HasStmt: fn [Stmt], Stmt -> Bool
fn HasStmt sts, st = Fold sts, False, \|f, x| f or (x.span.start == st.span.start and x.span.end == st.span.end)

# Lines whose last gives nothing back: a bare building line last is built and its result
# dropped.
Unresulted: fn [Stmt] -> [Stmt]
fn Unresulted sts = match sts[Dec (Len sts)]:
    ? last: match last.kind:
        SExpr e: match e.kind:
            EFreeSigil "@", ignore: sts
            otherwise: Push (Take sts, (Dec (Len sts))), (Stmt(kind=(SIgnore e), span=last.span))
        otherwise: sts
    nil: sts

# The lines below a split that are the node's: a hold, a `let`, a local function, a local
# widget, a signature, which build no place, and which read nothing bound by a line that
# stays below but events (those fire up, `PreBindUps`). A plain `let` that reads the
# split line's names stays too: its value is a local of the lower generation's build.
# What a line that stays binds, the lines that read it stay with it.
HoistedLines: unbounded fn [Stmt], [Text], [Text] -> [Stmt]
fn HoistedLines below, lateNames, aboveReads:
    let candidates = Filter below, \|st| match st.kind:
        SBind ignore, ignore, (? ignore): True
        SLet ignore, ignore, ignore: True
        SFn ignore: True
        SWidget ignore: True
        SSignature ignore: True
        SEmit ignore: True
        otherwise: False
    let fixed = Filter below, \|st| not (HasStmt candidates, st)
    HoistedAmong candidates, (Fold fixed, [[]], \|acc, st| UnionTexts acc, (NonEventDefs st)), lateNames, aboveReads

# Whether a `let`'s pattern is one name that a line above the split reads (a `let`
# hoisted from below the split is one name).
IsOneNameReadAbove: fn Pattern, [Text] -> Bool
fn IsOneNameReadAbove p, aboveReads = match p.kind:
    PName n: HasText aboveReads, (SNameKey n)
    otherwise: False

HoistedAmong: unbounded fn [Stmt], [Text], [Text], [Text] -> [Stmt]
fn HoistedAmong candidates, blocking, lateNames, aboveReads:
    let Stays = \|st|
        let reads = ReadsOfLine st
        let plainLet = match st.kind:
            SLet p, ignore, ignore: (Fold (PatternNames p), False, \|f, n| f or not ((HasPrefix n, "$") or (HasPrefix n, "!"))) and not IsOneNameReadAbove p, aboveReads
            otherwise: False
        (Fold reads, False, \|f, n| f or HasText blocking, n) or (plainLet and Fold reads, False, \|f, n| f or HasText lateNames, n)
    let out = Filter candidates, Stays
    if (Len out) == 0: candidates
    else: HoistedAmong (Filter candidates, \|st| not (HasStmt out, st)), (Fold out, blocking, \|acc, st| UnionTexts acc, (NonEventDefs st)), lateNames, aboveReads

# The block's names a line reads anywhere in it (`ReadsAtBuild` is the build's alone).
ReadsOfLine: unbounded fn Stmt -> [Text]
fn ReadsOfLine s = match s.kind:
    SFn f: FreeReads (StmtExprs s), [[(((Fold f.params, [[]], \|acc, q| Append acc, (PatternNames q)), f.span))]]
    otherwise: FreeReads (StmtExprs s), [[]]

NonEventDefs: unbounded fn Stmt -> [Text]
fn NonEventDefs s = Filter (Check.Blocks.GroupDefs s), \|d| not (HasPrefix d, "!")

# The events the lines that stay below a split bind, prebound in the node as its own
# (`PreBindName`): a line of the node reads one as any event of the block, and the lower
# generation's own event fires it (`ArmRowOf`, `ups`). Each: the name, the lower
# generation's node for it (named as `PreBindName` names it there), the block's method.
PreBindUps: unbounded fn Wx, Env, Env, [Stmt] -> ((Wx, Env, Env, [((Text, Text, Text))]))
fn PreBindUps wx, benv, menv, staying:
    let binders = Fold staying, [[]], \|acc, st| match st.kind:
        SBind p, ignore, nil: Append acc, (Each (Filter (BinderNames p), \|n| HasPrefix (SNameKey n), "!"), \|n| ((n, AsBind)))
        SLet p, ignore, ignore: Append acc, (Each (Filter (BinderNames p), \|n| HasPrefix (SNameKey n), "!"), \|n| ((n, AsLet)))
        otherwise: acc
    Fold binders, ((wx, benv, menv, [[]])), \|((w, be, me, acc)), ((n, how))|
        let ((w2, be2, me2)) = PreBindName w, be, me, n, how
        match me2.names[SNameKey n]:
            ? (BnEv er, ignore): ((w2, be2, me2, (Push acc, (((SNameKey n), (LocalNameAt (WidgetLetLx w.lx, n.span), (SNameKey n), n.span), (GnOf w2, er.node).name)))))
            otherwise: ((w2, be2, me2, acc))

# An environment without some names.
WithoutNames: fn Env, [Text] -> Env
fn WithoutNames env, gone:
    let bare = update env:
        &_.names <= {}
    Fold (Keys env.names), bare, \|en, nm| match env.names[nm]:
        ? bn: if HasText gone, nm: en else: Bind en, nm, bn
        nil: en

# The names a split line binds, as the node's lines read them (`SplitBlockInto`): in the
# methods a getter over the kept result (`LateGetters`); at the build nothing, since the
# result is not built until the node is (`{name}#late` marks the name, `NamesInited`). A
# name, or a tuple of names, is bound so; another pattern's names are the lower
# generation's alone.
BindLate: unbounded fn Wx, Env, Env, Stmt -> ((Wx, Env, Env, [LateName]))
fn BindLate wx, benv, menv, s = match s.kind:
    SBind p, e, nil:
        let partTys = BundlePartTys (LineOutFull wx.lx, e)
        let parts = match p.kind:
            PName n: [[((n, nil, nil))]]
            PGroup q: match q.kind:
                PName n: [[((n, nil, nil))]]
                otherwise: [[]]
            # of a bundle's pattern, the plain parts' names: an event's or a dynamic's is
            # a name of the node (`SplitBlockInto`); a plain part taken apart by a
            # pattern of its own (`((((n, name)), !go))`) gives each name it binds, read
            # out of the part by that pattern
            PTuple ps: Fold (Range0 (Len ps)), [[]], \|acc, i| match (Or ps[i], dummyPat).kind:
                PName n: if IsTimeName (SNameKey n): acc else: Push acc, ((n, ? i, nil))
                otherwise:
                    let partTy = Or partTys[i], TyErr
                    if IsBundle partTy: acc
                    else: Fold (BinderNames (Or ps[i], dummyPat)), acc, \|a, n| if IsTimeName (SNameKey n): a else: Push a, ((n, ? i, ? (((Or ps[i], dummyPat), partTy))))
            otherwise: [[]]
        Fold parts, ((wx, benv, menv, [[]])), \|((w, be, me, acc)), ((n, ?part, ?within))|
            let nkey = SNameKey n
            let t = OutTyOf w.lx, (Peel (BinderTy w.lx, n.span))
            let ((getter, w2)) = FreshName w, "late_{LocalNameAt w.lx, nkey, n.span}"
            let unbuilt = BnLocal (Refusal "the late result `{nkey}` read at its block's build by a line of the block's node (a place's constant field or a plain `let` above the line that binds it)"), Owned, t
            let be2 = Bind (Bind be, nkey, unbuilt), "{nkey}#late", unbuilt
            let me2 = Bind (Bind me, nkey, (BnLocal (XMethod XSelf, getter, [[]]), Owned, t)), "{nkey}#late", unbuilt
            ((w2, be2, me2, (Push acc, (LateName(getter=getter, ?part=?part, ty=t, name=nkey, ?within=?within)))))
    otherwise: ((wx, benv, menv, [[]]))

# A late name's getter (`BindLate`): the part of the bundle it reads (none: the whole
# result), its type, and the pattern that takes the part apart with the part's type when
# the name is inside one.
type LateName = record:
    getter: Text
    ?part: Nat
    ty: OutTy
    name: Text
    ?within: ((Pattern, Ty))

# The getters `BindLate` named, over the kept result: the result, or its part, or the
# name a pattern binds inside the part.
# `partReads`: a bundle's plain parts, each read by itself (`LateParts`).
LateGetters: unbounded fn Wx, [LateName], Ex, [((Nat, Ex))] -> Wx
fn LateGetters wx, lates, kept, partReads = Fold lates, wx, \|w, late|
    let read = match late.?part:
        ? i: match ?PartRead partReads, i:
            ? read: read
            nil: XClone (XPart kept, i)
        nil: kept
    let tail = match late.?within:
        ? ((q, partTy)):
            let o = RustPat w.lx, q, partTy, ByRef, "late_part"
            let ?bound = Fold o.binds, nil, \|?found, ((k, b))| if k == late.name: ? b else: ?found
            match ?bound:
                ? (BnLocal rs, mode, vt):
                    let arm = XArm(pat=o.pa, conds=o.conds, body=(Own (VlPlace rs, mode, vt)))
                    let other = XArm(pat=PaWild, conds=[[]], body=(XUnreachable))
                    XBlock [[(DoLet (PaTyped (PaBind "late_part"), (OutTyOf w.lx, (Peel partTy))), read)]], (Own (ArmsValue (XRef (XVar "late_part")), [[arm, other]], "'bound", late.ty))
                otherwise: InternalBug "the late name `{late.name}`, which the pattern of its part does not bind"
        nil: read
    update w:
        &_.getters <= Push &_.getters, (MethDef(name=late.getter, recv=RecvRef, params=[[]], cx=CxNone, ret=late.ty, body=[[]], tail=tail, doc="A late result, read once the row that gives it is built."))

# The late first values (`HoldLine`) set where the generation that gives the late result
# is built: the last generation the split line made, after its row.
WithLateInits: fn Wx, [Do] -> Wx
fn WithLateInits wx, sets:
    if (Len sets) == 0: wx
    else: match wx.gens[Dec (Len wx.gens)]:
        ? gd:
            let gd2 = update gd:
                &_.select <= XBlock (Append [[(DoLet (PaBind "row"), gd.select)]], sets), (XVar "row")
            update wx:
                &_.gens <= Push (Take &_.gens, (Dec (Len &_.gens))), gd2
        nil: update wx:
            &_.build <= Push &_.build, (InternalBugDo "a late result with no generation that gives it")

# Whether an expression reads a split line's name (`BindLate`) or a `let` that is late
# (`MarkLateLets`), itself or through a function defined in the block.
ReadsLate: unbounded fn Env, Expr -> Bool
fn ReadsLate env, e = ReadsLateVia env, env, e

# `fns`: the environment that binds the block's local functions, whose bodies' reads are
# the reads of what calls them.
ReadsLateVia: unbounded fn Env, Env, Expr -> Bool
fn ReadsLateVia fns, env, e = Fold (RowNamesClosed fns, (FreeReads (ExprsIn e), [[]])), False, \|f, n| f or HasKey env.names, "{n}#late"

IsFnLine: fn Stmt -> Bool
fn IsFnLine s = match s.kind:
    SFn ignore: True
    otherwise: False

# A plain `let` in a split block's node whose value reads a late name (Semantics ch. 4: the
# order of a group's lines decides positions and nothing else): the `let` is late too.
# Each name it binds is bound as a split line's is (`BindLate`): in the methods a getter
# that computes the value from the node, at the build nothing, under `{name}#late`. What
# reads it reads it as a late name: a place's field is live over it (`ElementLine`), a
# hold that starts from it is set when the result is built, another plain `let` is late
# in turn (so the marking runs until nothing more is marked). A `let` of a pattern (a
# tuple's, a record's, `let ((low, high)) = Sides n`) is late with every name it binds.
MarkLateLets: unbounded fn Wx, Env, Env, Env, [Stmt], Nat -> ((Wx, Env, Env))
fn MarkLateLets wx, benv, menv, fns, stmts, fuel:
    # (a bundle written out whose plain part reads a late name: the name is marked, its
    # parts bound at its line, `LateBundleLet`)
    # (and a `let` whose tuple pattern takes a late bundle apart: each plain name the
    # tuple names is late, its getter made at the `let`'s line, `LatePartNames`)
    let ((wx2, be2, me2, grew)) = Fold stmts, ((wx, benv, menv, False)), \|((w, be, me, ch)), s| if IsLateBundleStmt w.lx, fns, me, s: (MarkLateBundle w, be, me, s) else: Fold (Append (LateLetNames w.lx, fns, me, s), (LatePartNames me, s)), ((w, be, me, ch)), \|((w1, be1, me1, ignore)), n|
        let nkey = SNameKey n
        let t = OutTyOf w1.lx, (Peel (BinderTy w1.lx, n.span))
        let ((getter, w2)) = FreshName w1, "late_{LocalNameAt w1.lx, nkey, n.span}"
        let unbuilt = BnLocal (Refusal "the late `let` `{nkey}` read at its block's build by a line of the block's node that takes a value there (a widget's plain argument, a builder's plain local)"), Owned, t
        ((w2, (Bind (Bind be1, nkey, unbuilt), "{nkey}#late", unbuilt), (Bind (Bind me1, nkey, (BnLocal (XMethod XSelf, getter, [[]]), Owned, t)), "{nkey}#late", unbuilt), True))
    if grew and fuel > 0: MarkLateLets wx2, be2, me2, fns, stmts, (Dec fuel) else: ((wx2, be2, me2))

# Whether a statement is a `let` of a name whose value is a bundle written out with a
# plain part that reads a late name (`let pair = ((n + 1, !go))`, `n` late), not yet
# marked.
IsLateBundleStmt: unbounded fn Lx, Env, Env, Stmt -> Bool
fn IsLateBundleStmt lx, fns, me, s = match s.kind:
    SLet p, ignore, e: match ?BundleWritten lx, p, e:
        ? ((n, tuple)): (not (HasKey me.names, "{SNameKey n}#late")) and HasLatePlainPart lx, fns, me, tuple
        # another name for a late bundle (`let same = both`) is late as it is
        nil: match ?LateBundleAlias me, p, e:
            ? n: not (HasKey me.names, "{SNameKey n}#late")
            nil: False
    otherwise: False

# A `let` of a name whose value is a name marked late and bound to no plain value (a late
# bundle's): the name.
?LateBundleAlias: unbounded fn Env, Pattern, Expr -> ?SName
fn ?LateBundleAlias me, p, e = match ((p.kind, e.kind)):
    ((PGroup q, ignore)): ?LateBundleAlias me, q, e
    ((ignore, EGroup x)): ?LateBundleAlias me, p, x
    ((PName n, EName m)): if (Len m.path) == 1 and (HasKey me.names, "{SNameKey m}#late") and IsLateBundleName me, (SNameKey m): ? n else: nil
    otherwise: nil

# Whether a late name is a bundle's: bound to its parts, or not bound yet (a bundle
# written out is bound at its line).
IsLateBundleName: fn Env, Text -> Bool
fn IsLateBundleName me, nkey = match me.names[nkey]:
    ? (BnParts ignore): True
    nil: True
    otherwise: False

# Whether a bundle written out has a plain part that reads a late name, at any depth.
HasLatePlainPart: unbounded fn Lx, Env, Env, Expr -> Bool
fn HasLatePlainPart lx, fns, me, tuple = match (Ungrouped tuple).kind:
    ETuple xs: Fold xs, False, \|found, y| found or (if IsBundle (TypeAt lx, y.span): HasLatePlainPart lx, fns, me, y else: (IsPlainPartTy (TypeAt lx, y.span)) and ReadsLateVia fns, me, y)
    otherwise: False

# Whether a part of a bundle is a plain value by its type.
IsPlainPartTy: fn Ty -> Bool
fn IsPlainPartTy t = not ((LayerOf t) == LyEv or (LayerOf t) == LyDyn or IsBundle t)

# The name of such a `let` marked late (`{name}#late`, so a building line that reads it
# waits for the late result, `DeferredLine`) and a late bundle (`{name}#latebundle`,
# which its line reads, `WidgetStmt`).
MarkLateBundle: unbounded fn Wx, Env, Env, Stmt -> ((Wx, Env, Env, Bool))
fn MarkLateBundle wx, be, me, s = match s.kind:
    SLet p, ignore, e: match ?BundleWritten wx.lx, p, e:
        ? ((n, ignore)):
            let nkey = SNameKey n
            let marker = BnLocal (Refusal "the bundle `{nkey}`, whose plain part reads a late result, read as one value at its block's build"), Owned, OutUnit
            ((wx, (Bind (Bind be, "{nkey}#late", marker), "{nkey}#latebundle", marker), (Bind (Bind me, "{nkey}#late", marker), "{nkey}#latebundle", marker), True))
        nil: match ?LateBundleAlias me, p, e:
            ? n:
                let marker = BnLocal (Refusal "the bundle `{SNameKey n}`, another name of a late bundle, read as one value at its block's build"), Owned, OutUnit
                ((wx, (Bind be, "{SNameKey n}#late", marker), (Bind me, "{SNameKey n}#late", marker), True))
            nil: ((wx, be, me, False))
    otherwise: ((wx, be, me, False))

# A `let` of a name whose value is a bundle written out with a plain part that reads a
# late name (Semantics ch. 4: the order of a group's lines decides positions and nothing
# else): the name is its parts. A plain part that reads a late name is a getter of the
# node, computed from the node once the row that gives the late result is built, as a
# late `let` is (`LateLetGetters`), with no value at the build; every other part is its
# own result, a plain one a field (`FieldedParts`); a bundle inside the same way.
LateBundleLet: unbounded fn Wx, Env, Env, SName, Expr -> ((Wx, Env, Env))
fn LateBundleLet wx, benv, menv, n, tuple:
    let nkey = SNameKey n
    let ((wx2, builds, methods)) = LateBundleParts wx, benv, menv, nkey, (LocalNameAt wx.lx, nkey, n.span), tuple
    # as one value, for what reads the name so from the node's methods (`LateBundleValue`)
    let ((wx3, me3)) = LateBundleValue wx2, (Bind menv, nkey, (BnParts methods)), nkey, (LocalNameAt wx.lx, nkey, n.span), methods, (OutTyOf wx.lx, (TypeAt wx.lx, tuple.span))
    ((wx3, (Bind benv, nkey, (BnParts builds)), me3))

LateBundleParts: unbounded fn Wx, Env, Env, Text, Text, Expr -> ((Wx, [?Bn], [?Bn]))
fn LateBundleParts wx, benv, menv, nkey, stem, tuple:
    let es = match (Ungrouped tuple).kind:
        ETuple xs: xs
        otherwise: [[]]
    Fold es, ((wx, [[]], [[]])), \|((w, builds, methods)), y|
        let lx = w.lx
        let i = Len builds
        let ty = TypeAt lx, y.span
        if (IsBundle ty) and HasLatePlainPart lx, menv, menv, y:
            let ((w2, bs, ms)) = LateBundleParts w, benv, menv, nkey, "{stem}_{i}", y
            ((w2, (Append builds, [[(? (BnParts bs))]]), (Append methods, [[(? (BnParts ms))]])))
        else: if (IsPlainPartTy ty) and ReadsLate menv, y:
            let t = OutTyOf lx, (Peel ty)
            let ((getter, w1)) = FreshName w, "late_{stem}_p{i}"
            let w2 = update w1:
                &_.getters <= Push &_.getters, (MethDef(name=getter, recv=RecvRef, params=[[]], cx=CxNone, ret=t, body=[[]], tail=(Own (ValueOf lx, menv, y)), doc="A plain part of the bundle `{nkey}` that reads a late result: computed from the node once the row that gives the result is built."))
            let unbuilt = BnLocal (Refusal "a late plain part of the bundle `{nkey}` read at its block's build by a line of the block's node"), Owned, t
            ((w2, (Append builds, [[(? unbuilt)]]), (Append methods, [[(? (BnLocal (XMethod XSelf, getter, [[]]), Owned, t))]])))
        else:
            let ((res, w1)) = ResultOf w, benv, menv, y
            let ((w2, bs, ms)) = FieldedParts w1, "{stem}_{i}", [[res]]
            ((w2, (Append builds, [[(?PartOf bs, 0)]]), (Append methods, [[(?PartOf ms, 0)]])))

# The plain names a `let`'s tuple pattern names at its top, when the `let`'s value is a
# name of a late bundle (`let ((step, !go)) = both`, `both` bound below with a late
# plain part) and the name is not late yet: each is late as the bundle is, read through
# a getter of the node that the `let`'s line gives its part to (`BindNamedPart`).
LatePartNames: unbounded fn Env, Stmt -> [SName]
fn LatePartNames me, s = match s.kind:
    SLet p, ignore, e: if not (TakesLateBundle me, p, e): [[]] else: match (UngroupedPattern p).kind:
        PTuple ps: Fold ps, [[]], \|acc, q| match q.kind:
            PName n: if (IsTimeName (SNameKey n)) or HasKey me.names, "{SNameKey n}#late": acc else: Push acc, n
            otherwise: acc
        otherwise: [[]]
    otherwise: [[]]

# Whether a `let` is a tuple pattern over a name of a late bundle. Its line takes the
# bundle apart (`BindNamedParts`) though every plain name it binds is late.
TakesLateBundle: unbounded fn Env, Pattern, Expr -> Bool
fn TakesLateBundle me, p, e = match (((Ungrouped e).kind, (UngroupedPattern p).kind)):
    ((EName m, PTuple ignore)): (Len m.path) == 1 and (HasKey me.names, "{SNameKey m}#late") and IsLateBundleName me, (SNameKey m)
    otherwise: False

UngroupedPattern: fn Pattern -> Pattern
fn UngroupedPattern p = match p.kind:
    PGroup q: UngroupedPattern q
    otherwise: p

# The names of a `let` that becomes late: each a plain value of one type, none late yet,
# and the `let`'s value reads a late name. None when the `let` is not such a one.
LateLetNames: unbounded fn Lx, Env, Env, Stmt -> [SName]
fn LateLetNames lx, fns, me, s = match s.kind:
    SLet p, ignore, e:
        let names = BinderNames p
        let plain = Fold names, True, \|ok, n|
            let nkey = SNameKey n
            let full = BinderTy lx, n.span
            ok and not ((IsTimeName nkey) or (HasKey me.names, "{nkey}#late") or (HasKey me.names, "{nkey}#placed") or (LayerOf full) != LyPlain or (TimeWithin full) or (IsBundle full) or (IsSome (?ManyInstances lx, n.span)))
        if (Len names) > 0 and plain and ReadsLateVia fns, me, e: names else: [[]]
    otherwise: [[]]

# Whether a `let` names a late bundle (`MarkLateBundle`).
IsLateBundleLet: fn Env, Pattern -> Bool
fn IsLateBundleLet menv, p = match p.kind:
    PName n: HasKey menv.names, "{SNameKey n}#latebundle"
    PGroup q: IsLateBundleLet menv, q
    otherwise: False

# Whether a `let` binds late names (`MarkLateLets`).
IsLateLet: unbounded fn Env, Pattern -> Bool
fn IsLateLet menv, p:
    let names = BinderNames p
    (Len names) > 0 and Fold names, True, \|ok, n| ok and HasKey menv.names, "{SNameKey n}#late"

# The late `let`s' getters, the value computed from the node in its methods. A pattern's
# `let` has one for the whole value, which each name's getter matches by the pattern.
LateLetGetters: unbounded fn Wx, Env, [Stmt] -> Wx
fn LateLetGetters wx, menv, stmts = Fold stmts, wx, \|w, s| match s.kind:
    SLet p, ignore, e: if (not (IsLateLet menv, p)) or TakesLateBundle menv, p, e: w else: match p.kind:
        PName n: match menv.names[SNameKey n]:
            ? (BnLocal (XMethod XSelf, getter, ignore), ignore, t): update w:
                &_.getters <= Push &_.getters, (MethDef(name=getter, recv=RecvRef, params=[[]], cx=CxNone, ret=t, body=[[]], tail=(Own (ValueOf w.lx, menv, e)), doc="`{SNameKey n}`, a `let` that reads a late result: computed from the node once the row that gives the result is built."))
            otherwise: w
        otherwise:
            let ty = Peel (TypeAt w.lx, e.span)
            let t = OutTyOf w.lx, ty
            let ((whole, w1)) = FreshName w, "late_whole"
            let o = RustPat w.lx, p, ty, ByRef, "late_whole_value"
            let w2 = update w1:
                &_.getters <= Push &_.getters, (MethDef(name=whole, recv=RecvRef, params=[[]], cx=CxNone, ret=t, body=[[]], tail=(Own (ValueOf w.lx, menv, e)), doc="`{SrcText w.lx, w.lx.file, e.span}`, the value a late `let`'s pattern takes apart: computed from the node once the row that gives the late result is built."))
            Fold (BinderNames p), w2, \|w3, n| match ((menv.names[SNameKey n], (Fold o.binds, nil, \|?found, ((k, b))| if k == SNameKey n: ? b else: ?found))):
                (((? (BnLocal (XMethod XSelf, getter, ignore), ignore, bt)), (? (BnLocal rs, mode, vt)))):
                    let arm = XArm(pat=o.pa, conds=o.conds, body=(Own (VlPlace rs, mode, vt)))
                    let other = XArm(pat=PaWild, conds=[[]], body=(XUnreachable))
                    let tail = XBlock [[(DoLet (PaTyped (PaBind "late_whole_value"), t), (XMethod XSelf, whole, [[]]))]], (Own (ArmsValue (XRef (XVar "late_whole_value")), [[arm, other]], "'bound", bt))
                    update w3:
                        &_.getters <= Push &_.getters, (MethDef(name=getter, recv=RecvRef, params=[[]], cx=CxNone, ret=bt, body=[[]], tail=tail, doc="`{SNameKey n}`, a name of a `let`'s pattern that reads a late result."))
                otherwise: update w3:
                    &_.build <= Push &_.build, (InternalBugDo "the name `{SNameKey n}` of a late `let`'s pattern, which the pattern does not bind")
    otherwise: w

# A name's value at the build, `{name}#init`, bound before any line so that a line above
# reads it (`InitEnv`), in the build's order: a hold's, the local `{f}_init` its line
# computes; a dynamic `let`'s, the local `{rs}_init`, when everything it reads has a value
# at the build (as `LetLine` decides it at its line). `BuildInOrder` puts their `let`s
# before the readers'.
PreInit: unbounded fn Wx, Env, Env, Stmt -> ((Wx, Env))
fn PreInit wx, benv, menv, s = match s.kind:
    SBind p, ignore, (? ignore): match ?BindingOf menv, p:
        ? (BnHold f, t):
            let wx2 = update wx:
                &_.inited <= AddText &_.inited, f
            ((wx2, (Bind benv, "{PatText p}#init", (BnLocal (XVar "{f}_init"), Owned, t))))
        otherwise: ((wx, benv))
    # a place whose element answers a dynamic (`$~real <- Fs.Contents(..)`): its first value,
    # asked in the build's `let`s, the local `{f}_init` (`ElementOutputOf`)
    SBind p, placed, nil: match ?BindingOf menv, p:
        ? (BnHold f, t): if not (IsDynamicPlace wx.lx, placed): ((wx, benv)) else:
            let wx2 = update wx:
                &_.inited <= AddText &_.inited, f
            ((wx2, (Bind benv, "{PatText p}#init", (BnLocal (XVar "{f}_init"), Owned, t))))
        # a bundle's place (`((id, $state)) <- Pad.Port(..)`): each `$` part's hold has its
        # part of the first value, the local `{f}_init` (`BundleOutputOf`)
        ? (BnParts ignore): if not (IsBundlePlace wx.lx, placed): ((wx, benv)) else: match p.kind:
            PTuple qs: Fold qs, ((wx, benv)), \|((w, be)), q| match ?BindingOfName menv, q:
                ? (BnHold f, t):
                    let w2 = update w:
                        &_.inited <= AddText &_.inited, f
                    ((w2, (Bind be, "{PatText q}#init", (BnLocal (XVar "{f}_init"), Owned, t))))
                otherwise: ((w, be))
            otherwise: ((wx, benv))
        otherwise: ((wx, benv))
    SLet p, ignore, e: match ?BindingOf menv, p:
        # the getter its prebinding named (`PreBindName`)
        ? (BnDyn (XMethod XSelf, rs, ignore), ignore, t):
            let ((ignore, reads)) = DynamicExpr wx, menv, e
            let wx2 = update wx:
                &_.dynReads <= Insert &_.dynReads, rs, reads
            if (AllInited wx2, reads) and (NamesInited benv, e):
                let wx3 = update wx2:
                    &_.inited <= AddText &_.inited, rs
                ((wx3, (Bind benv, "{PatText p}#init", (BnLocal (XVar "{rs}_init"), Owned, t))))
            else: ((wx2, benv))
        otherwise: ((wx, benv))
    otherwise: ((wx, benv))

# The build's `let`s from `start` on, each line's run ending at its entry of `ends`, in the
# order of what the lines read at the build: a line's run after the runs of the lines that
# bind a name it reads, ties in page order. Lines that read each other at the build (a
# cycle the checker let through) cannot be ordered and are refused.
BuildInOrder: unbounded fn Wx, [Stmt], [ [Nat] ], Nat, [Nat] -> Wx
fn BuildInOrder wx, stmts, order, start, ends:
    let n = Len stmts
    let last = Or ends[Dec n], start
    let runs = Each (Range0 n), \|i|
        let from = if i == 0: start else: Or ends[Dec i], start
        Take (Drop wx.lets, from), (Or ((Or ends[i], from) -? from), 0)
    let lets = Fold order, (Take wx.lets, start), \|acc, comp| Fold comp, acc, \|acc2, i| Append acc2, (Or runs[i], [[]])
    let cyclic = Filter order, \|comp| (Len comp) > 1 and Fold comp, False, \|seen, i| seen or (Len (Or runs[i], [[]])) > 0
    # a link to the node reads nothing and is shared by the lines after the one that made
    # it (`whole_owner`): it stands before every line's run
    let links = Filter lets, IsLinkLet
    let wx2 = update wx:
        &_.lets <= Append (Append links, (Filter lets, \|d| not (IsLinkLet d))), (Drop wx.lets, last)
    Fold cyclic, wx2, \|w, comp| update w:
        &_.build <= Push &_.build, (InternalBugDo "lines that read each other at the build ({Join (Fold comp, [[]], \|acc, i| Append acc, (Check.Blocks.GroupDefs (Or stmts[i], dummyStmtL))), ", "}): a cycle among values")

# The `let` of a node's link (`prism_rtl::Link::<Node>::new()`), made before the node and
# linked once it is.
IsLinkLet: fn Do -> Bool
fn IsLinkLet d = match d:
    DoLet (PaBind ignore), (XCall (RefRuntime made), [[]]): HasPrefix made, "prism_rtl::Link::<"
    otherwise: False

# A block's lines in strongly connected components of what each reads at the build, each
# after the ones it reads, ties in page order. An event has no value at the build (its port
# is made before any line), so reading one is no edge; a line reading its own name is none.
BuildOrder: unbounded fn [Stmt] -> [ [Nat] ]
fn BuildOrder stmts:
    let n = Len stmts
    let defs = Each stmts, \|s| Filter (Check.Blocks.GroupDefs s), \|d| not (HasPrefix d, "!")
    let reads = Each stmts, \|s| ReadsAtBuild s
    let deps = Each (Range0 n), \|i| Filter (Range0 n), \|j| j != i and Fold (Or defs[j], [[]]), False, \|seen, d| seen or HasText (Or reads[i], [[]]), d
    let reach = Each (Range0 n), \|i| Check.Blocks.ReachIdx deps, (Or deps[i], [[]]), [[]]
    let comps = Each (Range0 n), \|i| Filter (Range0 n), \|j| j == i or ((HasNat (Or reach[i], [[]]), j) and (HasNat (Or reach[j], [[]]), i))
    Check.Blocks.EmitGroups comps, deps, [[]], [[]]

# The block's names a line reads at the build: a hold's initial value (its step is heard
# after the build), a local function's body less its parameters, anything else's
# expressions; a name an inner binder hides (a lambda's or an arm's pattern, an inner
# block's `let`) is not the block's.
ReadsAtBuild: unbounded fn Stmt -> [Text]
fn ReadsAtBuild s = match s.kind:
    SBind ignore, init, (? ignore): FreeReads (ExprsIn init), [[]]
    SFn f: FreeReads (StmtExprs s), [[(((Fold f.params, [[]], \|acc, q| Append acc, (PatternNames q)), f.span))]]
    otherwise: FreeReads (StmtExprs s), [[]]

# Names first: a bound event is a node of its own, a hold or a bound dynamic a field, a
# dynamic `let` a getter.
PreBind: unbounded fn Wx, Env, Env, Stmt -> ((Wx, Env, Env))
fn PreBind wx, benv, menv, s = match s.kind:
    SBind p, init, ?step:
        # a `$` place of a hosted child whose host answers late (`Wx.lateHosts`) has no
        # first value until the node stands (`LateFirstPlace`)
        let latePlace = ?step == nil and (HasNat wx.lateHosts, wx.pos.scope) and ((IsDynamicPlace wx.lx, init) or IsBundlePlace wx.lx, init)
        let how = if latePlace: AsLatePlace else: if ?step == nil and (GivesResult wx.lx, menv, init): AsResult else: if ?step != nil and (ReadsLate menv, init): AsLateHold else: HowBound ?step
        match p.kind:
            PName n: PreBindName wx, benv, menv, n, how
            PTuple ps: Fold ps, ((wx, benv, menv)), \|((w, be, me)), q| match q.kind:
                PName n: PreBindName w, be, me, n, how
                # a pattern inside the tuple: each name it binds (`BindPatternResult`)
                otherwise: if ?step == nil: (Fold (BinderNames q), ((w, be, me)), \|((w2, be2, me2)), n| PreBindName w2, be2, me2, n, how) else: ((w, be, me))
            otherwise: if ?step == nil: (Fold (BinderNames p), ((wx, benv, menv)), \|((w2, be2, me2)), n| PreBindName w2, be2, me2, n, how) else: ((wx, benv, menv))
    # a `let` of any other pattern (a record's, a constructor's, a tuple inside a tuple):
    # each name it binds (`BindPatternResult`)
    SLet p, ignore, e: if (IsLateLet menv, p) and not (TakesLateBundle menv, p, e): ((wx, benv, menv)) else: match p.kind:
        PName n: if IsPlacedLet menv, p: ((wx, benv, menv)) else: PreBindName wx, benv, menv, n, AsLet
        PTuple ps: Fold ps, ((wx, benv, menv)), \|((w, be, me)), q| match q.kind:
            # (a plain name of a late bundle's part is late already, `LatePartNames`)
            PName n: if HasKey me.names, "{SNameKey n}#late": ((w, be, me)) else: PreBindName w, be, me, n, AsLet
            otherwise: Fold (BinderNames q), ((w, be, me)), \|((w2, be2, me2)), n| PreBindName w2, be2, me2, n, AsLet
        otherwise: Fold (BinderNames p), ((wx, benv, menv)), \|((w2, be2, me2)), n| PreBindName w2, be2, me2, n, AsLet
    SFn c:
        let fname = DefNameText c.name
        ((wx, (Bind benv, fname, (WithClause benv, fname, c)), (Bind menv, fname, (WithClause menv, fname, c))))
    # a widget defined in the block (`@line:` and its block): its block, lowered where
    # the name is applied (`LocalWidgetLine`)
    SWidget w: ((wx, (Bind benv, (SNameKey w.name), (BnLocalWidget w.body)), (Bind menv, (SNameKey w.name), (BnLocalWidget w.body))))
    otherwise: ((wx, benv, menv))

# The names a pattern binds, as written: every name in it that is no constructor's (a
# constructor's is UpperCamelCase).
BinderNames: unbounded fn Pattern -> [SName]
fn BinderNames p = match p.kind:
    PName n: if IsUpperText (Base (SNameKey n)): [[]] else: [[n]]
    PCtor ignore, ps: Fold ps, [[]], \|acc, q| Append acc, (BinderNames q)
    PRecord ignore, fs, ignore: Fold fs, [[]], \|acc, f| Append acc, (BinderNames f.pattern)
    PTuple ps: Fold ps, [[]], \|acc, q| Append acc, (BinderNames q)
    PArray ps: Fold ps, [[]], \|acc, q| Append acc, (BinderNames q)
    PGroup q: BinderNames q
    otherwise: [[]]

# Whether a pattern is a name, `ignore`, or a tuple of those: what `BindPlainResult` binds
# part by part.
IsNamesPattern: fn Pattern -> Bool
fn IsNamesPattern p = match p.kind:
    PName ignore: True
    PIgnore: True
    PGroup q: IsNamesPattern q
    PTuple ps: Fold ps, True, \|ok, q| ok and match q.kind:
        PName ignore: True
        PIgnore: True
        otherwise: False
    otherwise: False

# A widget's plain result bound by any other pattern (a record's or a constructor's, a
# tuple inside a tuple; Semantics ch. 4 and ch. 8): the result is a local of the build,
# matched once there, and each name the pattern binds is moved into the field its
# prebinding named (`BinderNames`, `BindPlain`), as a name's is. The checker lets only a
# pattern that cannot fail stand here.
BindPatternResult: unbounded fn Wx, Env, Pattern, Ex, OutTy, Ty -> Wx
fn BindPatternResult wx, menv, p, ex, t, ty:
    let ((tmp, wx1)) = FreshName wx, "result"
    let o = RustPat wx.lx, p, ty, ByRef, tmp
    # each binder with a field: its field, its type, and its value out of the match
    let bound = Fold (BinderNames p), [[]], \|acc, n| match ((menv.names[SNameKey n], (Fold o.binds, nil, \|?found, ((k, b))| if k == SNameKey n: ? b else: ?found))):
        (((? (BnLocal rx, ignore, bt)), (? (BnLocal rs, mode, vt)))): Push acc, (((PlaceStem rx), bt, (Own (VlPlace rs, mode, vt))))
        otherwise: acc
    let all = OutTuple (Each bound, \|((ignore, bt, ignore))| bt)
    let arm = XArm(pat=o.pa, conds=o.conds, body=(XTuple (Each bound, \|((ignore, ignore, v))| v)))
    let other = XArm(pat=PaWild, conds=[[]], body=(XUnreachable))
    let matched = Own (ArmsValue (XRef (XVar tmp)), [[arm, other]], "'bound", all)
    let wx2 = update wx1:
        &_.lets <= Append &_.lets, [[(DoLet (PaTyped (PaBind tmp), t), ex), (DoLet (PaTyped (PaTuple (Each bound, \|((f, ignore, ignore))| PaBind f)), all), matched)]]
        &_.fields <= Append &_.fields, (Each bound, \|((f, bt, ignore))| ((f, bt, "a name of a widget's result")))
        &_.inits <= Append &_.inits, (Each bound, \|((f, ignore, ignore))| ((f, (XClone (XVar f)))))
    if (Len bound) == (Len (BinderNames p)): wx2 else: RefusePlainResult wx2, p

# How a line binds its name: `$x <- init then step` (a hold), `p <- e` (a bind), `let`.
type HowBound = choice:
    AsHold
    AsBind
    AsLet
    AsResult                   # `p <- e` where `e` is a widget the node inlines: its result
    AsLateHold                 # a hold whose first value reads a late result (`BindLate`)
    AsLatePlace                # a `$` place whose first value is asked once the node stands (`Wx.lateHosts`)
derive ^Eq, ^Show

# Whether a bind line's right side is a widget this node inlines, a widget block or a widget
# parameter applied, whose result is an expression of the node's, never a sink a builtin
# writes: its dynamic is then a getter of the node, defined when the line is lowered, so a
# line above may read it (one binding group, Semantics ch. 4).
GivesResult: unbounded fn Lx, Env, Expr -> Bool
fn GivesResult lx, menv, e = match e.kind:
    EGroup x: GivesResult lx, menv, x
    EWidgetBlock ignore: True
    # a builder that gives a bundle: each dynamic part is a getter of the node (`BindParts`)
    EFor ignore, ignore, ignore: IsBundle (LineOutFull lx, e)
    EMatch ignore, ignore: IsBundle (LineOutFull lx, e)
    EIf ignore, ignore, ignore: IsBundle (LineOutFull lx, e)
    otherwise:
        let callee = match e.kind:
            ECall c, ignore, ignore, ignore: c
            otherwise: e
        match callee.kind:
            EName n: match menv.names[SNameKey n]:
                ? (BnWidget ignore, ignore, ignore, ignore): True
                otherwise: if HasKey menv.names, "{SNameKey n}#blueprint": True else:
                    let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
                    match ?q:
                        ? q: (IsGetterBuiltin q) or (IsHostBuiltin q) or ((not (IsPreludeName q)) and (lx.g.vals[q] != nil) and IsWidgetTy (Peel (TypeAt lx, e.span)))
                        nil: False
            otherwise: False

# a prelude widget (`@Distinct`, `@Flatten`, a host) may write the name it is bound to
IsPreludeName: fn Text -> Bool
fn IsPreludeName q = (?Find %/^Prelude\./, q) != nil

# A builtin whose dynamic is a getter of the node named for the name it is bound to
# (`DistinctLine`, `PerKeyLine`, `FlattenLine`): bound as a widget's result, so a line above
# it reads the getter.
IsGetterBuiltin: fn Text -> Bool
fn IsGetterBuiltin q = q == "Prelude.@Distinct" or q == "Prelude.@PerKey" or q == "Prelude.@Flatten"

# A host (`@HostDocument` and its forms), whose document is a getter of the node: a line
# above it may read `$doc`, through a getter named for the name it is bound to
# (`BindHosted`).
IsHostBuiltin: fn Text -> Bool
fn IsHostBuiltin q = q == "Prelude.@HostDocument" or q == "Prelude.@HostSome" or q == "Prelude.@HostList"

IsWidgetTy: fn Ty -> Bool
fn IsWidgetTy t = match t:
    TyAt ignore, ignore: True
    otherwise: False

HowBound: fn ?Expr -> HowBound
fn HowBound (? ignore) = AsHold
fn HowBound nil = AsBind

PreBindName: unbounded fn Wx, Env, Env, SName, HowBound -> ((Wx, Env, Env))
fn PreBindName wx, benv, menv, n, how:
    let lx = WidgetLetLx wx.lx, n.span
    let nkey = SNameKey n
    let full = BinderTy lx, n.span
    let layer = LayerOf full
    let t = OutTyOf lx, (Peel full)
    # spelled as a local (`f_f3`), never as one of lowering's own temporaries (`f`, `a0`)
    let ((rs, wx1)) = FreshName wx, (LocalNameAt lx, nkey, n.span)
    # a bundle bound to a name (the window library's generic `r`) is its parts' bindings,
    # bound where its line is lowered (`BundleBn`)
    # (a `let` of a bundle is the bundle it names, bound at its line: `WidgetStmt`)
    if (how == AsBind or how == AsResult or how == AsLet or how == AsLatePlace) and IsBundle full: ((wx, benv, menv))
    else: if layer == LyEv or IsSwitched full:
        let et = OutTyOf lx, (Peel (Peel full))
        let ((id, wx2)) = AddGn wx1, rs, et, GnNamed, 0
        let b = BnEv (EvRefOf wx2, id), t
        # Its value form (`!x` passed to a function, read by a supplier): a port the event
        # fires, made before the node so that a closure in the build can hold it.
        let pf = "{rs}_v_port"
        let pt = OutRc (OutPort et)
        let wx3 = update (Connect wx2, (EvRefOf wx2, id), (SkPort "{rs}_v")):
            &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind pf), pt), (XCall (RefRuntime "std::Rc::new"), [[(XCall (RefRuntime "rt::Port::new"), [[]])]]))
            &_.fields <= Push &_.fields, ((pf, pt, "`{nkey}` as a value: the port it fires"))
            &_.moves <= Push &_.moves, ((pf, (XClone (XVar pf))))
        let be = Bind (Bind benv, nkey, b), "{nkey}#port", (BnLocal (XVar pf), Owned, pt)
        let me = Bind (Bind menv, nkey, b), "{nkey}#port", (BnLocal (XField XSelf, pf), Owned, pt)
        ((wx3, be, me))
    else: match ((layer, how)):
        ((LyDyn, AsLet)):
            let b = BnDyn (XMethod (XSelf), rs, [[XCx]]), [[OwnRead rs]], t
            ((wx1, (Bind benv, nkey, b), (Bind menv, nkey, b)))
        # a value holding dynamics a function gave whole (gap LF): a reader too, its
        # dynamics made again from what they read whenever that moves
        ((ignore, AsLet)) if (TimeWithin full) and not (IsBundle full):
            let b = BnDyn (XMethod (XSelf), rs, [[XCx]]), [[OwnRead rs]], (OutTyOf lx, full)
            ((wx1, (Bind benv, nkey, b), (Bind menv, nkey, b)))
        ((LyDyn, AsResult)):
            let b = BnDyn (XMethod (XSelf), rs, [[XCx]]), [[OwnRead rs]], t
            ((wx1, (Bind benv, nkey, b), (Bind menv, nkey, b)))
        # a hold with no value until the late result it starts from is built: read as the
        # value it holds from then on (`HoldLine`)
        ((LyDyn, AsLateHold)):
            let b = BnDyn (XMethod (XMethod (XField XSelf, rs), "get", [[XCx]]), "expect", [[(XStr "a hold that starts from a late result is set when that result is built")]]), [[OwnRead rs]], t
            ((wx1, (Bind benv, nkey, b), (Bind menv, nkey, b)))
        # a place's hold with no value until its first value is asked, once the node
        # stands: read as the value it holds from then on (`LateFirstPlace`)
        ((LyDyn, AsLatePlace)):
            let b = LatePlaceBn rs, t
            ((wx1, (Bind benv, nkey, b), (Bind menv, nkey, b)))
        ((LyDyn, ignore)):
            let b = BnHold rs, t
            ((wx1, (Bind benv, nkey, b), (Bind menv, nkey, b)))
        otherwise: match ?ManyInstances wx.lx, n.span:
            # A generalized `let` used at several instantiations (gap LW, first ruling): a
            # field per instantiation, each use bound to its own, as `GenericLet` binds a
            # local per instantiation.
            ? insts: Fold (Range0 (Len insts)), ((wx1, benv, menv)), \|((w, be, me)), k|
                let inst = Or insts[k], (([[]], [[]]))
                let lxk = AtInstance wx.lx, inst
                let tk = OutTyOf lxk, (Peel (BinderTy lxk, n.span))
                let ((rk, w2)) = if k == 0: ((rs, w)) else: FreshName w, "{rs}_{k}"
                let bkey = if k == 0: nkey else: "{nkey}#inst{k}"
                let ((be2, me2)) = BindPlain be, me, bkey, rk, tk
                let ukey = "{nkey}#{Show inst}"
                ((w2, (WithUse be2, ukey, bkey), (WithUse me2, ukey, bkey)))
            nil:
                let ((be, me)) = BindPlain benv, menv, nkey, rs, t
                ((wx1, be, me))

# A late place's hold `f` as its readers read it: the value it holds once its first value
# is asked.
LatePlaceBn: fn Text, OutTy -> Bn
fn LatePlaceBn f, t = BnDyn (XMethod (XMethod (XField XSelf, f), "get", [[XCx]]), "expect", [[(XStr "a hosted place's first value is asked once its node stands")]]), [[OwnRead f]], t

# The hold of a name bound as a late place's (`LatePlaceBn`).
?LatePlaceHold: fn ?Bn -> ?Text
fn ?LatePlaceHold (? (BnDyn (XMethod (XMethod (XField XSelf, f), "get", ignore), "expect", ignore), ignore, ignore)) = ? f
fn ?LatePlaceHold ?other = nil

WithUse: fn Env, Text, Text -> Env
fn WithUse env, ukey, bkey = update env:
    &_.uses <= Insert &_.uses, ukey, bkey

# A widget block's generalized `let`'s instantiations, when its uses have several.
?ManyInstances: unbounded fn Lx, Range -> ?[(([((Text, Ty))], [((Text, Col))]))]
fn ?ManyInstances lx, span = match lx.gens[PlaceKey lx, span]:
    ? gn:
        let insts = Instantiations lx, gn
        if (Len insts) > 1: ? insts else: nil
    nil: nil

# `$!a`: a dynamic of events, which `@Switch` hears (a `rebuild` handing back an event is a
# builder and a switch in one path, round 46 RD): it binds as the event its generation
# forwards.
IsSwitched: fn Ty -> Bool
fn IsSwitched t = match t:
    TySig "$", (TySig "!", ignore): True
    otherwise: False

# The binding a prebound name has.
?BindingOf: fn Env, Pattern -> ?Bn
fn ?BindingOf env, p = match p.kind:
    PName n: env.names[SNameKey n]
    PTuple ps: ? (BnParts (Each ps, \|q| ?BindingOfName env, q))
    otherwise: nil

?BindingOfName: fn Env, Pattern -> ?Bn
fn ?BindingOfName env, p = match p.kind:
    PName n: env.names[SNameKey n]
    otherwise: nil

# The expressions a statement is made of, as a line of a widget block reads them.
LineExprs: fn Stmt -> [Expr]
fn LineExprs s = match s.kind:
    SBind ignore, e, (? step): [[e, step]]
    SBind ignore, e, nil: [[e]]
    SIgnore e: [[e]]
    SLet ignore, ignore, e: [[e]]
    SExpr e: [[e]]
    otherwise: [[]]

# Whether a statement is a `let` that names a blueprint (`let @w = @line`): its value
# stands in a value's place (`BlueprintValuesAt`).
IsLetOfBlueprint: fn Stmt -> Bool
fn IsLetOfBlueprint s = match s.kind:
    SLet ignore, ignore, ignore: True
    otherwise: False

# One statement of a widget block.
WidgetStmt: unbounded fn Wx, Env, Env, Stmt, Bool -> ((Wx, Env, Env))
fn WidgetStmt wx0, benv0, menv0, s, last:
    # every reader the line passes whole to a function, wherever it stands in the line, as
    # its live dynamic (gap LF)
    # (a hold of dynamics takes its initial value whole, `HoldLine`)
    let heldInit = match s.kind:
        SBind p, init, (? ignore): if IsHeldHold wx0.lx, p: InitKey init else: ""
        otherwise: ""
    # a hold's step is heard after the build: its live dynamics are late (`WholeArgsAt`)
    let stepKey = match s.kind:
        SBind ignore, ignore, (? step): InitKey step
        otherwise: ""
    let ((wxw, benvw, menvw)) = Fold (LineExprs s), ((wx0, benv0, menv0)), \|((w, be, me)), e| WholeArgsAt w, be, me, e, (InitKey e) == heldInit, (InitKey e) == stepKey
    # and every widget of the block the line reads as a blueprint value
    let ((wx, benv, menv)) = Fold (LineExprs s), ((wxw, benvw, menvw)), \|((w, be, me)), e| BlueprintValuesAt w, be, me, e, (IsLetOfBlueprint s)
    let lx = wx.lx
    match s.kind:
        SBind p, e, nil:
            let ((wx2, res)) = BuildLine wx, benv, menv, e, (?BindingOf menv, p)
            let wx3 = BindRes wx2, menv, p, res
            match ((res, p.kind)):
                (((WrDyn ex, rds, t), PName n)):
                    let b = BnDyn ex, rds, t
                    ResultGetter wx3, menv, n, ex, rds, t, (Bind benv, (SNameKey n), b), (Bind menv, (SNameKey n), b)
                (((WrHosted inner, doc), PTuple ps)): BindHosted wx3, benv, menv, inner, doc, ps
                (((WrParts parts), PTuple ps)): BindParts wx2, benv, menv, parts, ps
                # a bundle bound whole to one name: the name is its parts, each plain
                # part a field of the node (`FieldedParts`)
                (((WrParts parts), PName n)):
                    let ((wx4, builds, methods)) = FieldedParts wx3, (Snake (SNameKey n)), parts
                    ((wx4, (Bind benv, (SNameKey n), (BnParts builds)), (Bind menv, (SNameKey n), (BnParts methods))))
                (((WrPlain ex, t), ignore)): if IsNamesPattern p: (((BindPlainResult wx3, menv, p, ex, t), benv, menv)) else: (((BindPatternResult wx3, menv, p, ex, t, (OutOf (TypeAt lx, e.span))), benv, menv))
                # a late result is bound where its block is split (`SplitBlockInto`): a
                # line that binds one here was not seen to be late (`IsLateExpr`)
                # a pure building choice's result is computed in the build
                # (`PureChoiceValue`); the row's own copy of it is not read
                (((WrLate ignore, t), ignore)) if HasText wx.earlyChoices, (PureChoiceKey e):
                    let ex = Own (PureChoiceValue lx, benv, e)
                    if IsNamesPattern p: (((BindPlainResult wx3, menv, p, ex, t), benv, menv)) else: (((BindPatternResult wx3, menv, p, ex, t, (OutOf (TypeAt lx, e.span))), benv, menv))
                (((WrLate ignore, ignore), ignore)): (((update wx3:
                    &_.build <= Push &_.build, (InternalBugDo "a late plain result bound where its block is not split")), benv, menv))
                otherwise: ((wx3, benv, menv))
        SBind p, init, (? step):
            let ((wx2, be2)) = HoldLine wx, benv, menv, p, init, step
            ((wx2, be2, menv))
        SIgnore e:
            let ((wx2, ignore)) = BuildLine wx, benv, menv, e, nil
            ((wx2, benv, menv))
        SLet p, ignore, e: match ?BundleNamed menv, p, e:
            # a bundle given another name (`let same = both`): the same parts, in the
            # build as the build spells them (a row's build reads its block through its
            # `parent` argument, `BuildSpelling`)
            ? ((n, b)):
                let atBuild = match ?BundleNamed benv, p, e:
                    ? ((ignore, spelled)): spelled
                    nil: b
                ((wx, (Bind benv, (SNameKey n), atBuild), (Bind menv, (SNameKey n), b)))
            # a late bundle is its parts (`LateBundleLet`)
            nil: match (if IsLateBundleLet menv, p: ?BundleWritten lx, p, e else: nil):
              ? ((n, tuple)): LateBundleLet wx, benv, menv, n, tuple
              nil:
                # an element only placed is no value of the node (`WithElementLets`); a
                # late `let` is a getter of the node (`MarkLateLets`)
                if (IsPlacedLet menv, p) or ((IsLateLet menv, p) and not (TakesLateBundle menv, p, e)): ((wx, benv, menv))
                else: match ?BundleWritten lx, p, e:
                  # a bundle written out and named (`let pair = (("mock", 2 on !go))`): each
                  # part its own result, as `@ ((..))` gives them, the name its parts, each
                  # plain part a field of the node (`FieldedParts`)
                  ? ((n, tuple)):
                    let ((res, wx2)) = ResultOf wx, benv, menv, tuple
                    let ((wx2f, builds, methods)) = FieldedParts wx2, (Snake (SNameKey n)), (ResultParts res)
                    BundleValue wx2f, (Bind benv, (SNameKey n), (BnParts builds)), (Bind menv, (SNameKey n), (BnParts methods)), n, tuple, (BnRes (BnParts builds))
                  nil: match ?NamedBundleTaken menv, p, e:
                    # a named bundle taken apart by a tuple pattern
                    # (`let ((ten, ((!more, $guests)))) = all`, `BindNamedParts`)
                    ? ((ps, methods)):
                        let builds = match ?NamedBundleTaken benv, p, e:
                            ? ((ignore, bs)): PlainAtBuild methods, bs
                            nil: methods
                        BindNamedParts wx, benv, menv, ps, (BundlePartTys (TypeAt lx, e.span)), methods, builds
                    nil:
                        let ((wx2, be2)) = LetLine wx, benv, menv, p, e
                        ((wx2, be2, menv))
        SExpr e: match e.kind:
            EFreeSigil "@", x:
                let ((res, wx2)) = if wx.wholeResultAt != "" and wx.wholeResultAt == ResultKey lx, x: WholeResultOf wx, benv, menv, x else: ResultOf wx, benv, menv, x
                let wx3 = update wx2:
                    &_.result <= res
                ((wx3, benv, menv))
            otherwise:
                let ((wx2, res)) = BuildLine wx, benv, menv, e, nil
                let wx3 = if last: SetResult wx2, res else: wx2
                ((wx3, benv, menv))
        SEmit ignore: ((wx, benv, menv))
        SSignature ignore: ((wx, benv, menv))
        SFn c: ((wx, benv, menv))
        # a widget defined in the block builds nothing where it is defined (`PreBind`)
        SWidget ignore: ((wx, benv, menv))
        otherwise:
            let wx2 = update wx:
                &_.build <= Push &_.build, (InternalBugDo "a statement of a widget block that is none of its kinds")
            ((wx2, benv, menv))

# A `let` of a name whose value is a bundle written out as a tuple: the name and the tuple.
?BundleWritten: unbounded fn Lx, Pattern, Expr -> ?((SName, Expr))
fn ?BundleWritten lx, p, e = match ((p.kind, e.kind)):
    ((PName n, ETuple ignore)): if IsBundle (TypeAt lx, e.span): ? ((n, e)) else: nil
    ((ignore, EGroup x)): ?BundleWritten lx, p, x
    otherwise: nil

# A named bundle of plain parts and events as one value of the build (Type System ch. 2,
# "Bundles": a plain aggregate with functor values inside), for what reads the name as a
# value (a supplier's `@ pair`): each event part fires a port made before the node, as a
# named event's value form does (`PreBindName`), and the tuple of the plain parts and those
# ports' events is a field, bound under `{name}#value`; a `$` part is in it as a live
# `Dynamic` of the node (`LiveDynamic`). A bundle with a bundle inside has no such value
# here, and its name read as a value is refused there.
BundleValue: unbounded fn Wx, Env, Env, SName, Expr, Wres -> ((Wx, Env, Env))
fn BundleValue wx, benv, menv, n, tuple, res:
    let lx = wx.lx
    let nkey = SNameKey n
    let parts = match res:
        WrParts ps: ps
        otherwise: [[]]
    let es = match tuple.kind:
        ETuple xs: xs
        otherwise: [[]]
    let simple = (Len parts) > 0 and (Len parts) == (Len es) and Fold parts, True, \|ok, part| ok and match part:
        WrEv ignore: True
        WrPlain ignore, ignore: True
        WrDyn ignore, ignore, ignore: True
        otherwise: False
    if not simple: ((wx, benv, menv))
    else:
        let ((values, wx1)) = Fold (Range0 (Len parts)), (([[]], wx)), \|((acc, w)), i| match ((parts[i], es[i])):
            ((? (WrEv r), ? y)):
                let et = OutTyOf lx, (Peel (Peel (TypeAt lx, y.span)))
                let ((rs, w1)) = FreshName w, "{Snake nkey}_part{i}"
                let pf = "{rs}_v_port"
                let pt = OutRc (OutPort et)
                let w2 = update (Connect w1, r, (SkPort "{rs}_v")):
                    &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind pf), pt), (XCall (RefRuntime "std::Rc::new"), [[(XCall (RefRuntime "rt::Port::new"), [[]])]]))
                    &_.fields <= Push &_.fields, ((pf, pt, "part {i} of `{nkey}` as a value: the port it fires"))
                    &_.moves <= Push &_.moves, ((pf, (XClone (XVar pf))))
                (((Push acc, (XCall (RefRuntime "prism_rtl::Event::of"), [[(XRef (XVar pf))]])), w2))
            ((? (WrPlain ex, ignore), ignore)): (((Push acc, ex), w))
            # a `$` part: the node's dynamic as a live `Dynamic` (`LiveDynamic`)
            ((? (WrDyn ex, reads, dt), ignore)):
                let ((dyn, w1)) = LiveDynamic w, "{Snake nkey}_part{i}", ex, reads, dt, "part {i} of `{nkey}`"
                (((Push acc, dyn), w1))
            otherwise: ((acc, w))
        let t = OutTyOf lx, (TypeAt lx, tuple.span)
        let ((vf, wx2)) = FreshName wx1, "{Snake nkey}_bundle"
        let wx3 = update wx2:
            &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind vf), t), (XTuple values))
            &_.fields <= Push &_.fields, ((vf, t, "`{nkey}`, a bundle, as one value"))
            &_.inits <= Push &_.inits, ((vf, (XClone (XVar vf))))
        ((wx3, (Bind benv, "{nkey}#value", (BnLocal (XVar vf), Owned, t)), (Bind menv, "{nkey}#value", (BnLocal (XField XSelf, vf), Owned, t))))

# A `let` of a name whose value is a name bound to a bundle's parts: the name and the
# parts.
?BundleNamed: unbounded fn Env, Pattern, Expr -> ?((SName, Bn))
fn ?BundleNamed menv, p, e = match ((p.kind, e.kind)):
    ((PName n, EName m)): match (if (Len m.path) == 1: menv.names[SNameKey m] else: nil):
        ? (BnParts bs): ? ((n, (BnParts bs)))
        otherwise: nil
    ((ignore, EGroup x)): ?BundleNamed menv, p, x
    otherwise: nil

# A host's child's result bound to the first part of the line's pattern, whatever type
# the checker gave the name (a generic `a` in the window library's `((r, $elems))`): an
# event or a dynamic as itself, so `@ r` gives it on. The child's document is bound to the
# second part: a dynamic of the owner's, its getter `host_k_doc` (pick HO), in place of the
# hold the prebinding took it for.
BindHosted: unbounded fn Wx, Env, Env, Wres, Bn, [Pattern] -> ((Wx, Env, Env))
fn BindHosted wx, benv, menv, res, doc, ps:
    let ?r = match res:
        WrEv r: ? (BnEv r, OutUnit)
        WrDyn ex, rds, t: ? (BnDyn ex, rds, t)
        WrParts ignore: ? (BundleBn res)
        otherwise: nil
    # the child's plain result (`@ "{w}{n}"` last in its block) is a value of the build,
    # bound as any widget's plain result is (`BindPlainResult`)
    let wx0 = match ((res, ps[0])):
        (((WrPlain ex, t), ? p)): BindPlainResult wx, menv, p, ex, t
        (((WrLate ignore, ignore), ? ignore)): update wx:
            &_.build <= Push &_.build, (InternalBugDo "a hosted child's late plain result bound where its block is not split")
        otherwise: wx
    let wx1 = PartGetter (PartGetter wx0, menv, ps[0], ?r), menv, ps[1], (? doc)
    let ((be1, me1)) = BindPart benv, menv, ps[0], ?r
    BindPart2 wx1, be1, me1, ps[1], (? doc)

# A dynamic part of a host's line, read above the line through the getter its name was
# prebound to (`IsHostBuiltin`): that getter, reading the part.
PartGetter: fn Wx, Env, ?Pattern, ?Bn -> Wx
fn PartGetter wx, menv, ?p, ?b = match ((?p, ?b)):
    ((? p, ? (BnDyn ex, rds, t))): match p.kind:
        PName n:
            let ((w2, ignore, ignore)) = ResultGetter wx, menv, n, ex, rds, t, emptyEnv, emptyEnv
            w2
        otherwise: wx
    otherwise: wx

BindPart: fn Env, Env, ?Pattern, ?Bn -> ((Env, Env))
fn BindPart benv, menv, ?p, ?b = match ((?p, ?b)):
    ((? p, ? b)): match p.kind:
        PName n: (((Bind benv, (SNameKey n), b), (Bind menv, (SNameKey n), b)))
        otherwise: ((benv, menv))
    otherwise: ((benv, menv))

BindPart2: fn Wx, Env, Env, ?Pattern, ?Bn -> ((Wx, Env, Env))
fn BindPart2 wx, benv, menv, ?p, ?b:
    let ((be, me)) = BindPart benv, menv, ?p, ?b
    ((wx, be, me))

# A bundle's parts bound by a tuple pattern, part by part: an event to the node its name
# was prebound to, a dynamic as itself, a plain value as a local, a nested bundle by its
# own pattern or as its name's parts.
BindParts: unbounded fn Wx, Env, Env, [Wres], [Pattern] -> ((Wx, Env, Env))
fn BindParts wx, benv, menv, parts, ps = Fold (Range0 (Len ps)), ((wx, benv, menv)), \|((w, be, me)), i| match ((ps[i], parts[i])):
    ((? p, ? part)): match ((part, p.kind)):
        ((WrEv r, PName ignore)): (((BindRes w, me, p, part), be, me))
        ((WrParts inner, PTuple qs)): BindParts w, be, me, inner, qs
        ((ignore, PName n)): match part:
            WrUnit: ((w, be, me))
            WrDyn ex, rds, t:
                let b = BnDyn ex, rds, t
                ResultGetter w, me, n, ex, rds, t, (Bind be, (SNameKey n), b), (Bind me, (SNameKey n), b)
            # a plain part: computed in the build's `let`s and moved into the field its
            # name was prebound to, as a widget's plain result is (`BindPlainResult`), so
            # the build reads the local and the methods the field
            WrPlain ex, t if IsFieldPart me.names[SNameKey n]: (((BindPlainResult w, me, p, ex, t), be, me))
            # a bundle inside the bundle bound to a name: its parts, each plain one a field
            WrParts inner:
                let ((w2, builds, methods)) = FieldedParts w, (Snake (SNameKey n)), inner
                ((w2, (Bind be, (SNameKey n), (BnParts builds)), (Bind me, (SNameKey n), (BnParts methods))))
            otherwise:
                let b = BundleBn part
                ((w, (Bind be, (SNameKey n), b), (Bind me, (SNameKey n), b)))
        otherwise: ((w, be, me))
    otherwise: ((w, be, me))

# A name prebound as a plain value's field of the node (`BindPlain`).
IsFieldPart: fn ?Bn -> Bool
fn IsFieldPart (? (BnLocal (XField XSelf, ignore), ignore, ignore)) = True
fn IsFieldPart ?other = False

# The parts of a bundle result.
ResultParts: fn Wres -> [Wres]
fn ResultParts res = match res:
    WrParts parts: parts
    otherwise: [[]]

# A bundle's parts as a name bound to the whole bundle has them (Type System ch. 2,
# "Bundles": a bundle is a plain aggregate, so a name binds it): an event and a dynamic as
# the line gives them; a plain part with a value at the build computed once in the
# build's `let`s and kept in a field of the node, so the build reads the local, the
# methods the field, and a row the field through its parent; a bundle inside the same
# way. Gives the parts as the build binds them and as the methods do.
FieldedParts: unbounded fn Wx, Text, [Wres] -> ((Wx, [?Bn], [?Bn]))
fn FieldedParts wx, stem, parts = Fold parts, ((wx, [[]], [[]])), \|((w, builds, methods)), part|
    let i = Len builds
    match part:
        WrPlain ex, t:
            let ((f, w1)) = FreshName w, "{stem}_part{i}"
            let w2 = update w1:
                &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind f), t), ex)
                &_.fields <= Push &_.fields, ((f, t, "plain part {i} of the bundle `{stem}`"))
                &_.inits <= Push &_.inits, ((f, (XClone (XVar f))))
            ((w2, (Append builds, [[(? (BnLocal (XVar f), Owned, t))]]), (Append methods, [[(? (BnLocal (XField XSelf, f), Owned, t))]])))
        WrParts inner:
            let ((w2, bs, ms)) = FieldedParts w, "{stem}_part{i}", inner
            ((w2, (Append builds, [[(? (BnParts bs))]]), (Append methods, [[(? (BnParts ms))]])))
        WrHosted inner, ignore:
            let ((w2, bs, ms)) = FieldedParts w, "{stem}_part{i}", [[inner]]
            ((w2, (Append builds, [[(?PartOf bs, 0)]]), (Append methods, [[(?PartOf ms, 0)]])))
        otherwise:
            let b = BundleBn part
            ((w, (Append builds, [[(? b)]]), (Append methods, [[(? b)]])))

# A `let` whose pattern is a tuple and whose value is a name bound to a bundle's parts:
# the tuple's patterns and the parts.
?NamedBundleTaken: unbounded fn Env, Pattern, Expr -> ?(([Pattern], [?Bn]))
fn ?NamedBundleTaken env, p, e = match ((p.kind, e.kind)):
    ((PGroup q, ignore)): ?NamedBundleTaken env, q, e
    ((ignore, EGroup x)): ?NamedBundleTaken env, p, x
    ((PTuple ps, EName m)): match (if (Len m.path) == 1: env.names[SNameKey m] else: nil):
        ? (BnParts bs): ? ((ps, bs))
        otherwise: nil
    otherwise: nil

# A named bundle taken apart by a `let`'s tuple pattern (Semantics ch. 4: `let` binds by
# any pattern that cannot fail; Type System ch. 2, "Bundles": nested freely): each name is
# the part at its place. An event part feeds the node its name was prebound to; a dynamic
# part is the getter its name was prebound to; a plain part is moved into its name's
# field; a bundle inside is taken apart by its own tuple pattern, or bound whole to its
# name; a plain part under any other pattern is matched once at the build
# (`BindPatternResult`). `tys`: the parts' types as the checker has them.
BindNamedParts: unbounded fn Wx, Env, Env, [Pattern], [Ty], [?Bn], [?Bn] -> ((Wx, Env, Env))
fn BindNamedParts wx, benv, menv, ps, tys, methods, builds = Fold (Range0 (Len ps)), ((wx, benv, menv)), \|((w, be, me)), i| match ((ps[i], (?PartOf methods, i))):
    ((? p, ? m)): BindNamedPart w, be, me, p, (Or tys[i], TyErr), m, (?PartOf builds, i)
    otherwise: ((w, be, me))

BindNamedPart: unbounded fn Wx, Env, Env, Pattern, Ty, Bn, ?Bn -> ((Wx, Env, Env))
fn BindNamedPart wx, benv, menv, p, ty, m, ?built = match ((p.kind, m)):
    ((PGroup q, ignore)): BindNamedPart wx, benv, menv, q, ty, m, ?built
    ((PIgnore, ignore)): ((wx, benv, menv))
    ((PTuple qs, BnParts ms)):
        let bs = match ?built:
            ? (BnParts xs): xs
            otherwise: ms
        BindNamedParts wx, benv, menv, qs, (BundlePartTys ty), ms, bs
    (((PName n), (BnEv r, ignore))): (((BindRes wx, menv, p, (WrEv r)), benv, menv))
    (((PName n), (BnDyn ex, rds, t))): ResultGetter wx, menv, n, ex, rds, t, benv, menv
    (((PName n), (BnHold f, t))): ResultGetter wx, menv, n, (XMethod (XField XSelf, f), "get", [[XCx]]), [[OwnRead f]], t, benv, menv
    (((PName n), (BnParts ms))):
        let bs = match ?built:
            ? (BnParts xs): xs
            otherwise: ms
        ((wx, (Bind benv, (SNameKey n), (BnParts bs)), (Bind menv, (SNameKey n), (BnParts ms))))
    # a plain name that is late as its bundle is (`LatePartNames`): the getter its
    # marking named reads the part from the node
    (((PName n), (BnLocal part, mode, t))) if HasKey menv.names, "{SNameKey n}#late": match menv.names[SNameKey n]:
        ? (BnLocal (XMethod XSelf, getter, ignore), ignore, ignore): (((update wx:
            &_.getters <= Push &_.getters, (MethDef(name=getter, recv=RecvRef, params=[[]], cx=CxNone, ret=t, body=[[]], tail=(Own (VlPlace part, mode, t)), doc="`{SNameKey n}`, a plain part of a late bundle a `let`'s pattern names: read from the node once the row that gives it is built."))), benv, menv))
        otherwise: (((update wx:
            &_.build <= Push &_.build, (InternalBugDo "the late name `{SNameKey n}` of a `let`'s pattern over a late bundle, which has no getter")), benv, menv))
    ((ignore, (BnLocal ignore, ignore, ignore))): match ?built:
        ? (BnLocal ex, mode, t):
            let v = Own (VlPlace ex, mode, t)
            if IsNamesPattern p: (((BindPlainResult wx, menv, p, v, t), benv, menv)) else: (((BindPatternResult wx, menv, p, v, t, ty), benv, menv))
        otherwise: (((update wx:
            &_.build <= Push &_.build, (InternalBugDo "a plain part of a named bundle with no binding at the build")), benv, menv))
    otherwise: (((update wx:
        &_.build <= Push &_.build, (InternalBugDo "a `let`'s pattern over a named bundle (`{SrcText wx.lx, wx.lx.file, p.span}`) that does not match the part it takes")), benv, menv))

# A widget's dynamic result bound to a name prebound as a getter (`AsResult`): the getter,
# so the lines above that read it read the result. Any other name is unchanged.
ResultGetter: fn Wx, Env, SName, Ex, [Read], OutTy, Env, Env -> ((Wx, Env, Env))
fn ResultGetter wx, menv, n, ex, rds, t, benv2, menv2 = match menv.names[SNameKey n]:
    ? (BnDyn (XMethod XSelf, rs, ignore), [[OwnRead r0]], ignore) if r0 == rs and not (HasText (Keys wx.dynReads), rs):
        let getter = MethDef(name=rs, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=ex, doc="`{SNameKey n}`, a widget's result")
        let wx2 = update wx:
            &_.getters <= Push &_.getters, getter
            &_.dynReads <= Insert &_.dynReads, rs, rds
        ((wx2, benv2, menv2))
    otherwise: ((wx, benv2, menv2))

# A widget's plain result (`@ door` last in its block) bound by the line's pattern: the
# value computed in the build's `let`s and moved into the field the prebinding named
# (`BindPlain`), so the build reads the local and the methods read the field; a tuple
# pattern binds each name to its part, `ignore` drops one. Each `let` is typed: a result
# too deep to inline is `unreachable!()` behind its fault (`TooDeep`). Any other pattern
# is `BindPatternResult`'s.
BindPlainResult: unbounded fn Wx, Env, Pattern, Ex, OutTy -> Wx
fn BindPlainResult wx, menv, p, ex, t = match p.kind:
    PName n: match menv.names[SNameKey n]:
        ? (BnLocal rx, ignore, bt):
            let f = PlaceStem rx
            update wx:
                &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind f), bt), ex)
                &_.fields <= Push &_.fields, ((f, bt, "`{SNameKey n}`, a widget's result"))
                &_.inits <= Push &_.inits, ((f, (XClone (XVar f))))
        otherwise: RefusePlainResult wx, p
    PIgnore: wx
    PGroup q: BindPlainResult wx, menv, q, ex, t
    PTuple ps:
        let ((tmp, wx1)) = FreshName wx, "result"
        let wx2 = update wx1:
            &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind tmp), t), ex)
        let parts = match t:
            OutTuple ts: ts
            otherwise: [[]]
        Fold (Range0 (Len ps)), wx2, \|w, i| match ps[i]:
            ? q: match q.kind:
                PName ignore: BindPlainResult w, menv, q, (XClone (XPart (XVar tmp), i)), (Or parts[i], OutUnit)
                PIgnore: w
                otherwise: RefusePlainResult w, q
            nil: w
    otherwise: RefusePlainResult wx, p

RefusePlainResult: fn Wx, Pattern -> Wx
fn RefusePlainResult wx, p = update wx:
    &_.build <= Push &_.build, (InternalBugDo "a widget's plain result bound by a pattern that left a name without its field or its local")

# A result as the binding a name of it has.
BundleBn: fn Wres -> Bn
fn BundleBn res = match res:
    WrEv r: BnEv r, OutUnit
    WrDyn ex, rds, t: BnDyn ex, rds, t
    WrPlain ex, t: BnLocal ex, Owned, t
    WrLate ignore, t: BnLocal (Refusal "a late plain result in a bundle"), Owned, t
    WrParts parts: BnParts (Each parts, \|q| ? (BundleBn q))
    WrHosted inner, ignore: BundleBn inner
    WrUnit: BnLocal XUnit, Owned, OutUnit

# A binding passed on as a result (`@ r`): a bundle's parts as its parts' results.
BnRes: fn Bn -> Wres
fn BnRes b = match b:
    BnEv r, ignore: WrEv r
    BnDyn ex, rds, t: WrDyn ex, rds, t
    # (a plain part is a place, a field or a local of the build: its value is a copy)
    BnLocal ex, mode, t: if t == OutUnit: WrUnit else: WrPlain (Own (VlPlace ex, mode, t)), t
    BnParts bs: WrParts (Each bs, PartRes)
    otherwise: WrUnit

PartRes: fn ?Bn -> Wres
fn PartRes ?b = match ?b:
    ? b: BnRes b
    nil: WrUnit

# A named bundle's parts as its methods bind them, each plain part as the build binds it.
PlainAtBuild: unbounded fn [?Bn], [?Bn] -> [?Bn]
fn PlainAtBuild methods, builds = Fold methods, [[]], \|acc, ?m| Append acc, [[(?PartAtBuild ?m, (?PartOf builds, (Len acc)))]]

?PartAtBuild: unbounded fn ?Bn, ?Bn -> ?Bn
fn ?PartAtBuild ?m, ?b = match ((?m, ?b)):
    (((? (BnLocal ignore, ignore, ignore)), (? (BnLocal ex, mode, t)))): ? (BnLocal ex, mode, t)
    (((? (BnParts ms)), (? (BnParts bs)))): ? (BnParts (PlainAtBuild ms, bs))
    otherwise: ?m

# The part of a named bundle at a place.
?PartOf: fn [?Bn], Nat -> ?Bn
fn ?PartOf parts, i:
    let ((ignore, ?found)) = Fold parts, ((0, nil)), \|((k, ?f)), ?b| if k == i: ((k + 1, ?b)) else: ((k + 1, ?f))
    ?found

SetResult: fn Wx, Wres -> Wx
fn SetResult wx, res = update wx:
    &_.result <= res

# `@ v`: what the block gives back, by its layer.
ResultOf: unbounded fn Wx, Env, Env, Expr -> ((Wres, Wx))
fn ResultOf wx, benv, menv, x:
    let lx = wx.lx
    let full = TypeAt lx, x.span
    let t = OutTyOf lx, (Peel full)
    let ?bound = match x.kind:
        EName n: if (Len n.path) == 1: menv.names[SNameKey n] else: nil
        otherwise: nil
    match ?bound:
        ? (BnEv r, ignore): ((WrEv r, wx))
        ? (BnDyn ex, rds, bt): (((WrDyn ex, rds, bt), wx))
        # a named bundle: its plain parts as the build spells them (a row's through its
        # `parent` argument, `BuildSpelling`)
        ? (BnParts bs):
            let ?built = match x.kind:
                EName n: benv.names[SNameKey n]
                otherwise: nil
            match ?built:
                ? (BnParts builds): ((BnRes (BnParts (PlainAtBuild bs, builds)), wx))
                otherwise: ((BnRes (BnParts bs), wx))
        otherwise: match x.kind:
            # a bundle written out, `((!clicks, $count))`: each part its own result
            ETuple xs if IsBundle full:
                let ((parts, wx2)) = Fold xs, (([[]], wx)), \|((acc, w)), y|
                    let ((r, w2)) = ResultOf w, benv, menv, y
                    (((Push acc, r), w2))
                ((WrParts parts, wx2))
            otherwise: ResultOfTyped wx, benv, menv, x, full, t

# The bundle a `rebuild`'s generation ends on (Semantics ch. 4, "What a `rebuild` hands
# back": a dynamic of its current generation's result; Type System ch. 2: a bundle is a
# plain aggregate): one value, its events and dynamics whole. Each dynamic it names is
# the live dynamic made for it here (`WholeArgsAt`), each event its port's.
WholeResultOf: unbounded fn Wx, Env, Env, Expr -> ((Wres, Wx))
fn WholeResultOf wx, benv, menv, x:
    let ?named = match (Ungrouped x).kind:
        EName n: if (Len n.path) == 1: menv.names[SNameKey n] else: nil
        otherwise: nil
    match ?named:
        # the bundle a line of the generation named whole (`both <- @Counter _`, `@ both`)
        ? (BnParts bs): WholeNamedOf wx, benv, x, bs
        otherwise: WholeWrittenOf wx, benv, menv, x

WholeWrittenOf: unbounded fn Wx, Env, Env, Expr -> ((Wres, Wx))
fn WholeWrittenOf wx, benv, menv, x:
    let lx = wx.lx
    let full = TypeAt lx, x.span
    let readers = Filter (ExprsIn x), \|y| match y.kind:
        EName ignore: (LayerOf (TypeAt lx, y.span)) == LyDyn
        otherwise: False
    let ((wx1w, be1w, ignore)) = Fold readers, ((wx, benv, menv)), \|((w, be, me)), y| WholeArgsAt w, be, me, y, True, False
    # a bundle a line named whole, inside the one written (`@ ((_, both))`): one value
    # too, bound under `{name}#value` (`NameValue` reads it there)
    let ((wx1, be1)) = Fold (ExprsIn x), ((wx1w, be1w)), \|((w, be)), y| match y.kind:
        EName n: match (((if (Len n.path) == 1: menv.names[SNameKey n] else: nil), (HasKey be.names, "{SNameKey n}#value"))):
            (((? (BnParts bs)), False)):
                let ((res, w2)) = WholeNamedOf w, be, y, bs
                match res:
                    WrPlain ex, t:
                        let ((vf, w3)) = FreshName w2, "{Snake (SNameKey n)}_bundle"
                        let w4 = update w3:
                            &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind vf), t), ex)
                        ((w4, (Bind be, "{SNameKey n}#value", (BnLocal (XVar vf), Owned, t))))
                    otherwise: ((w2, be))
            otherwise: ((w, be))
        otherwise: ((w, be))
    let lxw = update lx:
        &_.whole <= True
    (((WrPlain (Own (ValueOf lxw, be1, x)), (OutTyOf lx, full)), wx1))

# A named bundle as one value (`WholeResultOf`): each part by its binding. An event part
# is the event of a port it fires, made before the node (as a named event's value form
# is, `PreBindName`); a dynamic part a live `Dynamic` over the node's link (`LiveDynamic`);
# a plain part its value at the build; a bundle inside the bundle the tuple of its own
# parts, made the same way (`WholePartsOf`).
WholeNamedOf: unbounded fn Wx, Env, Expr, [?Bn] -> ((Wres, Wx))
fn WholeNamedOf wx, benv, x, parts:
    let lx = wx.lx
    let full = TypeAt lx, x.span
    let builds = match (Ungrouped x).kind:
        EName n: match benv.names[SNameKey n]:
            ? (BnParts bs): PlainAtBuild parts, bs
            otherwise: parts
        otherwise: parts
    let ((values, wx2)) = WholePartsOf wx, (Snake (SrcText lx, lx.file, x.span)), "the bundle `{SrcText lx, lx.file, x.span}`", (BundlePartTys full), builds
    (((WrPlain (XTuple values), (OutTyOf lx, full)), wx2))

# The parts of a bundle, each as a value of the build (`WholeNamedOf`). `stem` names the
# ports and the live dynamics made, `what` says whose parts they are, `tys` are the parts'
# types as the checker has them, `builds` their bindings with each plain part as the build
# spells it (`PlainAtBuild`).
WholePartsOf: unbounded fn Wx, Text, Text, [Ty], [?Bn] -> (([Ex], Wx))
fn WholePartsOf wx, stem, what, tys, builds = Fold builds, (([[]], wx)), \|((acc, w)), ?b|
    let lx = w.lx
    let i = Len acc
    let partTy = Or tys[i], TyErr
    match ?b:
        ? (BnEv r, ignore):
            let et = OutTyOf lx, (Peel (Peel partTy))
            let ((rs, w1)) = FreshName w, "{stem}_part{i}"
            let pf = "{rs}_v_port"
            let pt = OutRc (OutPort et)
            let w2 = update (Connect w1, r, (SkPort "{rs}_v")):
                &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind pf), pt), (XCall (RefRuntime "std::Rc::new"), [[(XCall (RefRuntime "rt::Port::new"), [[]])]]))
                &_.fields <= Push &_.fields, ((pf, pt, "part {i} of {what} as a value: the port it fires"))
                &_.moves <= Push &_.moves, ((pf, (XClone (XVar pf))))
            (((Push acc, (XCall (RefRuntime "prism_rtl::Event::of"), [[(XRef (XVar pf))]])), w2))
        ? (BnDyn ex, rds, t):
            let ((dyn, w2)) = LiveDynamic w, "whole_{stem}_part{i}", ex, rds, t, "part {i} of {what}"
            (((Push acc, dyn), w2))
        ? (BnHold f, t):
            let ((dyn, w2)) = LiveDynamic w, "whole_{stem}_part{i}", (XMethod (XField XSelf, f), "get", [[XCx]]), [[OwnRead f]], t, "part {i} of {what}"
            (((Push acc, dyn), w2))
        ? (BnLocal ex, mode, t): (((Push acc, (Own (VlPlace ex, mode, t))), w))
        # a bundle inside the bundle: the tuple of its own parts
        ? (BnParts inner):
            let ((values, w2)) = WholePartsOf w, "{stem}_part{i}", "part {i} of {what}", (BundlePartTys partTy), inner
            (((Push acc, (XTuple values)), w2))
        otherwise: (((Push acc, (InternalBug "part {i} of {what}, bound as no event, dynamic, value or bundle")), w))

# The bundle a line gave, part by part (`WrParts`), as one value (a `rebuild`'s generation
# that ends on `@Counter _`): each part as `WholePartsOf` makes it. With no late plain
# part inside, the value is the build's; with one, it is read from the node once the row
# that gives the late part is built, every other part kept in a field of the node from
# the build on. Gives the value and whether it is late.
WholeOfResults: unbounded fn Wx, Text, Text, [Ty], [Wres] -> ((Ex, Bool, Wx))
fn WholeOfResults wx, stem, what, tys, parts:
    if not (HasLatePart parts):
        let ((values, wx2)) = WholePartsOf wx, stem, what, tys, (Each parts, \|q| ? (BundleBn q))
        (((XTuple values), False, wx2))
    else:
        let ((values, wx2)) = Fold parts, (([[]], wx)), \|((acc, w)), part|
            let i = Len acc
            let partTy = Or tys[i], TyErr
            match part:
                WrLate read, ignore: (((Push acc, read), w))
                WrParts inner:
                    let ((value, ignore, w2)) = WholeOfResults w, "{stem}_part{i}", "part {i} of {what}", (BundlePartTys partTy), inner
                    if HasLatePart inner: (((Push acc, value), w2)) else: KeptPart acc, w2, value, (OutTyOf w.lx, partTy), "part {i} of {what}"
                otherwise:
                    let ((made, w2)) = WholePartsOf w, "{stem}_part{i}", what, [[partTy]], [[(? (BundleBn part))]]
                    KeptPart acc, w2, (Or made[0], XUnit), (OutTyOf w.lx, partTy), "part {i} of {what}"
        (((XTuple values), True, wx2))

# A value of the build kept in a field of the node, and its read there (`WholeOfResults`).
KeptPart: fn [Ex], Wx, Ex, OutTy, Text -> (([Ex], Wx))
fn KeptPart acc, wx, value, t, what:
    let ((f, w1)) = FreshName wx, "kept_part"
    let w2 = update w1:
        &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind f), t), value)
        &_.fields <= Push &_.fields, ((f, t, "{what}, kept beside a late part"))
        &_.inits <= Push &_.inits, ((f, (XClone (XVar f))))
    (((Push acc, (XClone (XField XSelf, f))), w2))

# Whether a bundle's parts have a late plain part among them, at any depth.
HasLatePart: unbounded fn [Wres] -> Bool
fn HasLatePart parts = Fold parts, False, \|found, part| found or match part:
    WrLate ignore, ignore: True
    WrParts inner: HasLatePart inner
    WrHosted inner, ignore: HasLatePart [[inner]]
    otherwise: False

# A dynamic of the node as a live `Dynamic` value (`WholeArgsAt` makes one for a reader a
# line names): read through the node's link by a getter, its update event a port the
# writes behind it fire, made once at the build and kept in a field. Its value before the
# node is linked is the `{f}_init` of the one hold or dynamic `let` it reads, when that
# has one; a read before the link is unreachable otherwise. Gives the build's local.
LiveDynamic: fn Wx, Text, Ex, [Read], OutTy, Text -> ((Ex, Wx))
fn LiveDynamic wx, stem, ex, reads, t, what:
    let owner = "whole_owner"
    let wx1 = if HasText wx.taken, owner: wx else: update wx:
        &_.taken <= Push &_.taken, owner
        &_.lets <= Push &_.lets, (DoLet (PaBind owner), (XCall (RefRuntime "prism_rtl::Link::<{wx.node}>::new"), [[]]))
        &_.build <= Push &_.build, (DoExpr (XMethod (XVar owner), "link", [[(XRef (XVar "node"))]]))
    let ((name, w1)) = FreshName wx1, stem
    let port = "{name}_port"
    let dyn = "{name}_dyn"
    let ?first = match reads:
        [[OwnRead f]]: if HasText w1.inited, f: ? (XVar "{f}_init") else: nil
        otherwise: nil
    let unlinked = match ?first:
        ? ignore: XClone (XVar "at_build")
        nil: XUnreachable
    let arms = [[XArm(pat=(PaCtor (RefRuntime "std::Some"), [[PaBind "owner"]]), conds=[[]], body=(XMethod (XVar "owner"), name, [[XCx]])), XArm(pat=(PaUnit (RefRuntime "std::None")), conds=[[]], body=unlinked)]]
    let read = XClosure True, [[(PaTyped (PaBind "cx"), (OutRef (OutNamed (RefRuntime "rt::Cx"), [[]])))]], (XMatch (XMethod (XVar "link"), "owner", [[]]), arms, False, t)
    let linked = [[(DoLet (PaBind "link"), (XClone (XVar owner)))]]
    let captured = match ?first:
        ? v: Push linked, (DoLet (PaBind "at_build"), (XClone v))
        nil: linked
    let made = XBlock captured, (XCall (RefRuntime "prism_rtl::Dynamic::of"), [[read, (XRef (XVar port))]])
    let w2 = update w1:
        &_.taken <= Append &_.taken, [[port, dyn]]
        &_.getters <= Push &_.getters, (MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=ex, doc="{what}, read at the read point."))
        &_.lets <= Append &_.lets, [[(DoLet (PaTyped (PaBind port), (OutRc (OutPort OutUnit))), (XCall (RefRuntime "std::Rc::new"), [[(XCall (RefRuntime "rt::Port::new"), [[]])]])), (DoLet (PaTyped (PaBind dyn), (OutDyn t)), made)]]
        &_.fields <= Append &_.fields, [[((port, (OutRc (OutPort OutUnit)), "`{name}` moved: its dynamic's update event")), ((dyn, (OutDyn t), "{what} as a live dynamic"))]]
        &_.moves <= Append &_.moves, [[((port, (XClone (XVar port)))), ((dyn, (XClone (XVar dyn))))]]
        &_.dynAnswers <= Push &_.dynAnswers, ((name, reads))
    (((XClone (XVar dyn)), (OnceField w2, name)))

ResultOfTyped: unbounded fn Wx, Env, Env, Expr, Ty, OutTy -> ((Wres, Wx))
fn ResultOfTyped wx, benv, menv, x, full, t:
    let lx = wx.lx
    match LayerOf full:
        LyEv:
            let ((r, wx2)) = EventRef wx, menv, x
            ((WrEv r, wx2))
        LyDyn:
            let ((ex, reads)) = DynamicExpr wx, menv, x
            (((WrDyn ex, reads, t), wx))
        otherwise:
            if t == OutUnit: ((WrUnit, wx))
            else: (((WrPlain (Own (ValueOf lx, benv, x)), t), wx))

# A hold of dynamics, `$$x <- init then step`: its value is a `Dynamic` (`Peel`), so its
# initial value and its step's values are dynamics taken whole.
IsHeldHold: fn Lx, Pattern -> Bool
fn IsHeldHold lx, p = TimeWithin (BinderTy lx, p.span)

# The element tag a bound line places, when it places one.
?PlacedTag: fn Lx, Expr -> ?TagInfo
fn ?PlacedTag lx, e:
    let name = match e.kind:
        ECall c, ignore, ignore, ignore: TagNameOf lx, c
        EName ignore: TagNameOf lx, e
        EGroup x: TagNameOf lx, x
        otherwise: ""
    match lx.g.tags[name]:
        ? tg: if tg.kind == "Element": ? tg else: nil
        nil: nil

# Whether a bound line places an element whose tag's output is a dynamic.
IsDynamicPlace: fn Lx, Expr -> Bool
fn IsDynamicPlace lx, e = match ?PlacedTag lx, e:
    ? tg: (LayerOf tg.out) == LyDyn
    nil: False

# Whether a bound line places an element whose tag's output is a bundle.
IsBundlePlace: fn Lx, Expr -> Bool
fn IsBundlePlace lx, e = match ?PlacedTag lx, e:
    ? tg: IsBundle (Peel tg.out)
    nil: False

InitKey: fn Expr -> Text
fn InitKey e = "{e.span.start}:{e.span.end}"

# `$x <- init then step`: a `Hold` field; the step event writes it. Its initial value stands
# in the local `{f}_init` first, the hold's value at the build, which a supplier's dynamic
# answer reads while the node is being made (`InitEnv`, round 3 DY); the build environment
# binds it under `{name}#init`.
HoldLine: unbounded fn Wx, Env, Env, Pattern, Expr, Expr -> ((Wx, Env))
fn HoldLine wx, benv, menv, p, init, step:
    let lx = wx.lx
    match ?BindingOf menv, p:
        ? (BnHold f, t):
            let lxi = update lx:
                &_.whole <= IsHeldHold lx, p
            let iv = Own (ValueOf lxi, benv, init)
            let wx1 = AddField wx, f, (OutHold t), "`{PatText p}`", (XCall (RefRuntime "rt::Hold::new"), [[(XClone (XVar "{f}_init")), XCx]])
            let ((r, wx2)) = EventRef wx1, menv, step
            let wx3 = update (Connect wx2, r, (SkHold f)):
                &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind "{f}_init"), t), iv)
                &_.inited <= Push &_.inited, f
            ((wx3, (Bind benv, "{PatText p}#init", (BnLocal (XVar "{f}_init"), Owned, t))))
        # a hold that starts from a late result (`PreBindName`, `AsLateHold`): empty until
        # the generation that gives the result is built, which sets it (`WithLateInits`);
        # its step writes it as any hold's
        ? (BnDyn (XMethod (XMethod (XField XSelf, f), "get", ignore), "expect", ignore), ignore, t):
            let lxi = update lx:
                &_.whole <= IsHeldHold lx, p
            let iv = Own (ValueOf lxi, menv, init)
            let set = DoExpr (XMethod (XField XSelf, f), "set", [[(XCtor (RefRuntime "std::Some"), [[iv]]), XCx]])
            let ((r, wx1)) = EventRef wx, menv, step
            let wx2 = update (Connect wx1, (SomePipe r), (SkHold f)):
                &_.fields <= Push &_.fields, ((f, (OutHold (OutOpt t)), "`{PatText p}`, set when the late result it starts from is built"))
                &_.moves <= Push &_.moves, ((f, (XCall (RefRuntime "rt::Hold::new"), [[XNone, XCx]])))
                &_.lateInits <= Push &_.lateInits, set
            ((wx2, benv))
        otherwise: ((wx, benv))

# An event's firings as the present values of an option.
SomePipe: fn EvRef -> EvRef
fn SomePipe r = EvRef(node=r.node, owner=r.owner, pipe=(\|x, K| r.pipe x, \|y| K (XCtor (RefRuntime "std::Some"), [[y]])))

# The build environment with every name that has a value at the build (`{name}#init`) read
# as that local: what a supplier's dynamic answer evaluates to while the owner's node is
# being made (round 3 DY). Every other name keeps its binding.
InitEnv: fn Env -> Env
fn InitEnv env = Fold (Keys env.names), env, \|en, k| match (((?BeforeSuffix k, "#init"), env.names[k])):
    ((? name, ? b)): Bind en, name, b
    otherwise: en

# Whether every read behind a dynamic has a value at the build: a hold or a dynamic `let`
# with its `{f}_init`, nothing structural, nothing of a parent.
AllInited: fn Wx, [Read] -> Bool
fn AllInited wx, reads = Fold (ReadsClosed wx.dynReads, reads), True, \|ok, r| ok and match r:
    OwnRead f: HasText wx.inited, f
    ParentRead ignore: False

# Whether every dynamic name an expression reads has its value at the build in the build
# environment (`{name}#init`). A name bound to a widget's dynamic result (`$t <- @TextInput
# ..`) has none, though everything behind it may: its value is read through the node, which
# does not exist while it is being built.
NamesInited: unbounded fn Env, Expr -> Bool
fn NamesInited env, e = Fold (ReadNames (ExprsIn e)), True, \|ok, n| ok and (not (HasKey env.names, "{n}#late")) and match env.names[n]:
    ? (BnDyn ignore, ignore, ignore): HasKey env.names, "{n}#init"
    ? (BnHold ignore, ignore): HasKey env.names, "{n}#init"
    otherwise: True

PatText: fn Pattern -> Text
fn PatText p = match p.kind:
    PName n: SNameKey n
    otherwise: "_"

# `let` in a widget block: an event names a node fed by its expression; a dynamic a
# getter, and, when everything it reads has a value at the build, that value in the local
# `{rs}_init` too (`InitEnv`, round 3 DY); a plain value a field computed at the build.
LetLine: unbounded fn Wx, Env, Env, Pattern, Expr -> ((Wx, Env))
fn LetLine wx, benv, menv, p, e:
    let lx = wx.lx
    match ?BindingOf menv, p:
        ? (BnEv er, t):
            let ((r, wx2)) = EventRef wx, menv, e
            let fed = OutTyOf lx, (Peel (Peel (TypeAt lx, e.span)))
            let r2 = match t:
                OutEvent (OutRes ignore): if fed == OutError: ErrPipe r else: r
                OutRes ignore: if fed == OutError: ErrPipe r else: r
                otherwise: r
            (((Connect wx2, r2, (SkNode er.node)), benv))
        # the getter its prebinding named (`PreBindName`)
        ? (BnDyn (XMethod XSelf, rs, ignore), ignore, t):
            let ((ex, reads)) = DynamicExpr wx, menv, e
            # Computed once per write behind it (Graph ch. 4, "Invalidation by stamped marks")
            # when everything it reads is the node's own, whose write paths mark the cache; a
            # read through the parent is marked by no write of this node, and is computed at
            # every read.
            let cached = (Len reads) > 0 and Fold (ReadsAll wx.dynReads, reads), True, \|ok, r| ok and IsOwnRead r
            let tail = if cached: XMethod (XField XSelf, "{rs}_cache"), "get", [[XCx, (XClosure False, [[]], ex)]] else: ex
            let getter = MethDef(name=rs, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=tail, doc="`{PatText p}`")
            let wx1 = if cached: update (AddField wx, "{rs}_cache", (OutNamed (RefRuntime "rt::Cache"), [[t]]), "`{PatText p}`, cached", (XCall (RefRuntime "rt::Cache::new"), [[]])):
                &_.letCaches <= Push &_.letCaches, rs
                &_.taken <= Push &_.taken, "{rs}_cache"
            else: wx
            let wx2 = update wx1:
                &_.getters <= Push &_.getters, getter
                &_.dynReads <= Insert &_.dynReads, rs, reads
            if (AllInited wx2, reads) and (NamesInited benv, e):
                let wx3 = update wx2:
                    &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind "{rs}_init"), t), (Own (ValueOf lx, (InitEnv benv), e)))
                    &_.inited <= Push &_.inited, rs
                ((wx3, (Bind benv, "{PatText p}#init", (BnLocal (XVar "{rs}_init"), Owned, t))))
            else: ((wx2, benv))
        ? (BnLocal rs, ignore, t):
            let ?insts = match p.kind:
                PName n: ?ManyInstances lx, n.span
                otherwise: nil
            # a generalized `let` nothing reads (`let empty = [[]]`, never used) has no
            # instantiation, so no type to be a field of and no reader to miss it: a `let`
            # builds nothing, and the node holds no field for it
            let unread = match p.kind:
                PName n: match lx.gens[PlaceKey lx, n.span]:
                    ? gn: ((Len gn.tys) + (Len gn.cols)) > 0 and (Len (Instantiations lx, gn)) == 0
                    nil: False
                otherwise: False
            # the instantiations to lower it at: none, several, or (`nil`) the one way below
            let ?lowered = if unread: ? [[]] else: ?insts
            match ?lowered:
                ? [[]]: ((wx, benv))
                # a field per instantiation (gap LW), each the value lowered at it
                ? insts: match p.kind:
                    PName n:
                        let nkey = SNameKey n
                        let wxn = Fold (Range0 (Len insts)), wx, \|w, k|
                            let lxk = AtInstance lx, (Or insts[k], (([[]], [[]])))
                            let bkey = if k == 0: nkey else: "{nkey}#inst{k}"
                            match menv.names[bkey]:
                                ? (BnLocal rk, ignore, tk): WidgetLetField w, (PlaceStem rk), tk, (Own (ValueOf lxk, benv, e)), "`{nkey}` at its instantiation {k}"
                                otherwise: update w:
                                    &_.build <= Push &_.build, (InternalBugDo "`{nkey}` at its instantiation {k}, which has no binding")
                        ((wxn, benv))
                    otherwise: ((wx, benv))
                nil:
                    let lxw = match p.kind:
                        PName n: WidgetLetLx lx, n.span
                        otherwise: lx
                    let v = Own (ValueOf lxw, benv, e)
                    (((WidgetLetField wx, (PlaceStem rs), t, v, "`{PatText p}`"), benv))
        # a tuple of plain names (or `ignore`s): the value computed at the build, each name
        # its part, as a widget's plain result binds them
        ? (BnParts parts) if (IsNamesPattern p) and Fold parts, True, \|ok, ?b| ok and IsPlainPart ?b:
            let t = OutTyOf lx, (Peel (TypeAt lx, e.span))
            (((BindPlainResult wx, menv, p, (Own (ValueOf lx, benv, e)), t), benv))
        otherwise: match p.kind:
            PIgnore: ((wx, benv))
            # any other pattern whose names are plain (a record's, a constructor's, a tuple
            # inside a tuple): the value computed at the build and matched once there, each
            # name moved into its field, as a widget's plain result bound by a pattern is
            otherwise: if Fold (BinderNames p), True, \|ok, n| ok and IsPlainPart menv.names[SNameKey n]:
                let t = OutTyOf lx, (Peel (TypeAt lx, e.span))
                (((BindPatternResult wx, menv, p, (Own (ValueOf lx, benv, e)), t, (Peel (TypeAt lx, e.span))), benv))
            # a pattern that binds dynamics or events inside it (`LetPatternDynamics`)
            else: if Fold (BinderNames p), True, \|ok, n| ok and ((IsPlainPart menv.names[SNameKey n]) or (IsGetterPart menv.names[SNameKey n]) or IsEventPart menv.names[SNameKey n]): (((LetPatternDynamics wx, benv, menv, p, e), benv))
            else:
                let wx2 = update wx:
                    &_.build <= Push &_.build, (InternalBugDo "a widget block's `let` of this pattern (`{SrcText lx, lx.file, p.span}`), whose names are bound as no plain value, dynamic or event")
                ((wx2, benv))

# A name prebound as a dynamic `let`'s getter (`PreBindName`).
IsGetterPart: fn ?Bn -> Bool
fn IsGetterPart (? (BnDyn (XMethod XSelf, ignore, ignore), ignore, ignore)) = True
fn IsGetterPart ?other = False

# A name prebound as an event's node (`PreBindName`).
IsEventPart: fn ?Bn -> Bool
fn IsEventPart (? (BnEv ignore, ignore)) = True
fn IsEventPart ?other = False

# A `let` whose pattern binds dynamics inside it (`let Gauge($level=$l, name=nm) = ..`;
# Semantics ch. 4: a `let` names what its pattern binds, and a dynamic named is that
# dynamic). The whole value is a getter of the node, made from what it reads as a value
# that holds dynamics is (`PreBindName`, gap LF); each `$` binder's getter, which its
# prebinding named, matches that value by the pattern and samples the dynamic the binder
# holds, and reads the whole value's getter, so what moves behind the value marks the
# binder's readers. The plain binders are fields, matched once at the build.
LetPatternDynamics: unbounded fn Wx, Env, Env, Pattern, Expr -> Wx
fn LetPatternDynamics wx, benv, menv, p, e = PatternDynamics wx, benv, menv, menv, wx.lx, p, e

# The same for any pattern over a value that holds dynamics or events: a `let`'s, and an
# inlined widget's parameter pattern over its argument (`BindTimePatternParam`). The
# value `e` is read in `benv` and `menv` and the node's context; the pattern is written
# in the context `lxp`, and its names are prebound in `penv` (the `let`'s own block, or
# the widget's).
PatternDynamics: unbounded fn Wx, Env, Env, Env, Lx, Pattern, Expr -> Wx
fn PatternDynamics wx, benv, menv, penv, lxp, p, e:
    let lx = wx.lx
    let ty = Peel (TypeAt lx, e.span)
    let t = OutTyOf lx, ty
    let ((whole, wx1)) = FreshName wx, "let_whole"
    let ((ex, reads)) = DynamicExpr wx1, menv, e
    let wx2 = update wx1:
        &_.getters <= Push &_.getters, (MethDef(name=whole, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=ex, doc="`{SrcText lx, lx.file, e.span}`, the value a `let`'s pattern takes apart, read at the read point."))
        &_.dynReads <= Insert &_.dynReads, whole, reads
    let o = RustPat lxp, p, ty, ByRef, "let_whole_value"
    let wx3 = Fold (BinderNames p), wx2, \|w, n| match ((penv.names[SNameKey n], (Fold o.binds, nil, \|?found, ((k, b))| if k == SNameKey n: ? b else: ?found))):
        (((? (BnDyn (XMethod XSelf, rs, ignore), ignore, bt)), (? (BnLocal held, ignore, ignore)))):
            let arm = XArm(pat=o.pa, conds=o.conds, body=(XMethod held, "sample", [[XCx]]))
            let other = XArm(pat=PaWild, conds=[[]], body=(XUnreachable))
            let tail = XBlock [[(DoLet (PaTyped (PaBind "let_whole_value"), t), (XMethod XSelf, whole, [[XCx]]))]], (Own (ArmsValue (XRef (XVar "let_whole_value")), [[arm, other]], "'bound", bt))
            update w:
                &_.getters <= Push &_.getters, (MethDef(name=rs, recv=RecvRef, params=[[]], cx=CxRef, ret=bt, body=[[]], tail=tail, doc="`{SNameKey n}`, a dynamic a `let`'s pattern binds"))
                &_.dynReads <= Insert &_.dynReads, rs, [[OwnRead whole]]
        (((? (BnDyn ignore, ignore, ignore)), ignore)): update w:
            &_.build <= Push &_.build, (InternalBugDo "the dynamic `{SNameKey n}` of a `let`'s pattern, which the pattern does not bind")
        # an event the pattern binds (`let Knob(name=name, !turned=!t) = knob`): the event
        # the value holds, read out of it by the pattern through a getter once the node is
        # made, and heard by a port node the build subscribes to it, as an event value a
        # function gave whole is (`EventObjectRef`); the port node feeds the name's node
        (((? (BnEv er, ignore)), (? (BnLocal held, ignore, ignore)))):
            let et = (GnOf w, er.node).ty
            let ((heard, w1)) = FreshName w, "heard"
            let ((id, w2)) = AddGn w1, heard, et, GnPort, 0
            let arm = XArm(pat=o.pa, conds=o.conds, body=(XClone held))
            let other = XArm(pat=PaWild, conds=[[]], body=(XUnreachable))
            let tail = XBlock [[(DoLet (PaTyped (PaBind "let_whole_value"), t), (XMethod XSelf, whole, [[XCx]]))]], (Own (ArmsValue (XRef (XVar "let_whole_value")), [[arm, other]], "'bound", (OutEvent et)))
            let getter = MethDef(name="{heard}_event", recv=RecvRef, params=[[]], cx=CxRef, ret=(OutEvent et), body=[[]], tail=tail, doc="`{SNameKey n}`, an event a `let`'s pattern binds, as the value holds it.")
            let port = XClosure False, [[PaBind "ev"]], (XRef (XField (XVar "ev"), "port"))
            let call = XClosure False, [[PaBind "n", PaBind "v", PaBind "cx"]], (XMethod (XVar "n"), heard, [[XClone (XVar "v"), XCx]])
            let sub = DoExpr (XCall (HelperRef "subscribe_row"), [[(XRef (XVar "node")), (XCtor (RefRuntime "std::Some"), [[(XCall (RefRuntime "std::Rc::new"), [[(XMethod (XVar "node"), "{heard}_event", [[XCx]])]])]]), port, call, (XRef (XField (XVar "node"), "{heard}_sub"))]])
            let w3 = update (AddField w2, "{heard}_sub", (OutNamed (RefRuntime "std::Cell"), [[(OutOpt (OutNamed (RefRuntime "rt::Handle"), [[]]))]]), "the subscription to `{SNameKey n}` as the `let`'s value holds it", (XCall (RefRuntime "std::Cell::new"), [[XNone]])):
                &_.getters <= Push &_.getters, getter
                &_.build <= Push &_.build, sub
            Connect w3, (EvRefOf w3, id), (SkNode er.node)
        (((? (BnEv ignore, ignore)), ignore)): update w:
            &_.build <= Push &_.build, (InternalBugDo "the event `{SNameKey n}` of a `let`'s pattern, which the pattern does not bind")
        otherwise: w
    # the plain binders: the value computed at the build and matched once there, each
    # name moved into the field its prebinding named (as `BindPatternResult` does)
    let plain = Fold (BinderNames p), [[]], \|acc, n| match ((penv.names[SNameKey n], (Fold o.binds, nil, \|?found, ((k, b))| if k == SNameKey n: ? b else: ?found))):
        (((? (BnLocal rx, ignore, bt)), (? (BnLocal rs, mode, vt)))): Push acc, (((PlaceStem rx), bt, (Own (VlPlace rs, mode, vt))))
        otherwise: acc
    if (Len plain) == 0: wx3
    else:
        let ((tmp, wx4)) = FreshName wx3, "result"
        let ob = RustPat lxp, p, ty, ByRef, tmp
        let all = OutTuple (Each plain, \|((ignore, bt, ignore))| bt)
        let arm = XArm(pat=ob.pa, conds=ob.conds, body=(XTuple (Each plain, \|((ignore, ignore, v))| v)))
        let other = XArm(pat=PaWild, conds=[[]], body=(XUnreachable))
        let matched = Own (ArmsValue (XRef (XVar tmp)), [[arm, other]], "'bound", all)
        update wx4:
            &_.lets <= Append &_.lets, [[(DoLet (PaTyped (PaBind tmp), t), (Own (ValueOf lx, benv, e))), (DoLet (PaTyped (PaTuple (Each plain, \|((f, ignore, ignore))| PaBind f)), all), matched)]]
            &_.fields <= Append &_.fields, (Each plain, \|((f, bt, ignore))| ((f, bt, "a name of a `let`'s pattern")))
            &_.inits <= Append &_.inits, (Each plain, \|((f, ignore, ignore))| ((f, (XClone (XVar f)))))

# A part of a tuple pattern as its prebinding has it: a plain name, or none (`ignore`).
IsPlainPart: fn ?Bn -> Bool
fn IsPlainPart (? (BnLocal ignore, ignore, ignore)) = True
fn IsPlainPart nil = True
fn IsPlainPart ?other = False

# A widget block's plain `let` as a node field: computed in the build's `let`s, moved in.
WidgetLetField: fn Wx, Text, OutTy, Ex, Text -> Wx
fn WidgetLetField wx, f, t, v, doc = update wx:
    &_.lets <= Push &_.lets, (DoLet (PaBind f), v)
    &_.fields <= Push &_.fields, ((f, t, doc))
    &_.inits <= Push &_.inits, ((f, (XClone (XVar f))))

# An event of `Error`s feeding a `!~T`: each firing is the `~T`'s failure.
ErrPipe: fn EvRef -> EvRef
fn ErrPipe r = EvRef(node=r.node, owner=r.owner, pipe=(\|x, K| r.pipe x, \|y| K (XCtor (RefRuntime "std::Err"), [[y]])))

# An owned value where a `~T` is wanted: a bare `Error` is its failure (the checker's
# pick ER lets an `Error(..)` wait for its type).
OwnAs: fn OutTy, Vl -> Ex
fn OwnAs t, v = match t:
    OutRes ignore: if (ValueTy v) == OutError: XCtor (RefRuntime "std::Err"), [[Own v]] else: Own v
    otherwise: Own v

# `p <- e`: an element or a blueprint, its output or result bound.
BindRes: fn Wx, Env, Pattern, Wres -> Wx
fn BindRes wx2, menv, p, res = match ?BindingOf menv, p:
        ? (BnEv er, ignore): match res:
            WrEv r:
                if er.owner != wx2.node: Crossed wx2, "the bound event of node `{er.owner}` (its graph node {er.node})"
                else: if r.node == er.node: wx2 else: Connect wx2, r, (SkNode er.node)
            otherwise: wx2
        otherwise: wx2

# A line that builds: an element (a place), a widget applied (inlined), or a builder. The
# bound name, when there is one, is where the output goes.
BuildLine: unbounded fn Wx, Env, Env, Expr, ?Bn -> ((Wx, Wres))
fn BuildLine wx, benv, menv, e, ?bound = if IsLateTaker wx.lx, menv, e: DeferredLine wx, menv, e else: BuildLineNow wx, benv, menv, e, ?bound

# Whether a building line of a split block's node reads a late name (`BindLate`,
# `MarkLateLets`) and is no element's (an element's field is live over the name's
# getter, `ElementLine`): a line above the split that takes the late result.
IsLateTaker: unbounded fn Lx, Env, Expr -> Bool
fn IsLateTaker lx, menv, e = match e.kind:
    EGroup ignore: False
    otherwise: match Peel (TypeAt lx, e.span):
        TyElem ignore, ignore: False
        otherwise: ReadsLate menv, e

# A building line of a split block's node that reads a late name (Semantics ch. 4,
# "Binding groups and cycles": any line may use any name the block binds, and the order of
# a group's lines decides positions and nothing else): the line is a generation of one
# arm at its own positions, its row built once after the node as an arm's is
# (`BuildingChoiceLine`), reading the block's names through the node, the late name
# through its getter. The generation is built after every other of its scope
# (`Wx.deferredGens`, `BuildSteps`), so the row that gives the late result is built by
# then. Two lines stay refused: one whose places are counted as built (the rows after it
# were numbered before it was built), and one that gives a plain result of its own (the
# block is split at one line).
DeferredLine: unbounded fn Wx, Env, Expr -> ((Wx, Wres))
fn DeferredLine wx, menv, e:
    let lx = wx.lx
    let ((outTy, layer)) = LineResult lx, e
    let body = Block(stmts=[[Stmt(kind=(SExpr e), span=e.span)]], inline=True, span=e.span)
    let ((wx2, res)) = BuildingChoiceLine wx, menv, (XUnit), [[nil]], (TyCon "unit", [[]]), [[nil]], [[body]], outTy, layer, (LineOutFull lx, e), [[]]
    match wx2.gens[Dec (Len wx2.gens)]:
        ? gd:
            let wx3 = update wx2:
                &_.deferredGens <= Push &_.deferredGens, gd.name
            let wx4 = if not gd.gappy: wx3 else: update wx3:
                &_.build <= Push &_.build, (RefusalDo "`{SrcText lx, lx.file, e.span}`, a line that takes a late result at its build, above the line that gives it, and whose places are counted as they are built (a building `match` or `if` inside it)")
            match res:
                WrLate ignore, ignore: (((update wx4:
                    &_.build <= Push &_.build, (RefusalDo "`{SrcText lx, lx.file, e.span}`, a line that takes a late result at its build, above the line that gives it, and gives a plain result of its own")), WrUnit))
                otherwise: ((wx4, res))
        nil: (((update wx2:
            &_.build <= Push &_.build, (InternalBugDo "a line that takes a late result, lowered to no generation")), WrUnit))

BuildLineNow: unbounded fn Wx, Env, Env, Expr, ?Bn -> ((Wx, Wres))
fn BuildLineNow wx, benv, menv, e, ?bound:
    let lx = wx.lx
    let full = TypeAt lx, e.span
    match e.kind:
        EGroup x: BuildLine wx, benv, menv, x, ?bound
        EWidgetBlock b: InlineBlock wx, benv, menv, b, lx
        EFor ?binders, source, body: ForLine wx, benv, menv, ?binders, source, body, e, ?bound
        ERebuild scrut, body: RebuildLine wx, benv, menv, scrut, body, e, ?bound
        EIf c, thenB, (? elseB): IfGenLine wx, menv, c, thenB, elseB, e
        # a building `if` with no `else` builds its arm or nothing (ruling IE2): the other
        # arm is an empty block, and the block's later places count from what was built
        EIf c, thenB, nil: IfGenLine wx, menv, c, thenB, (Block(stmts=[[]], inline=True, span=e.span)), e
        EMatch s, arms: if HasText wx.earlyChoices, (InitKey e): EarlyChoiceLine wx, benv, menv, s, arms, e else: MatchGenLine wx, menv, s, arms, e
        otherwise: match Peel full:
            TyElem ignore, ignore: ElementLine wx, benv, menv, e, ?bound
            TyAt ignore, ignore: WidgetLine wx, benv, menv, e, ?bound
            otherwise:
                let wx2 = update wx:
                    &_.build <= Push &_.build, (InternalBugDo "a building line that is no element, blueprint or builder")
                ((wx2, WrUnit))
