# `Lower.Node.Elements`, a child module of `Lower.Node`.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit r
use Lower.Node.*
use Lower.Node.Def.*
use Lower.Node.Static.*
use Lower.Node.Dynamics.*
use Lower.Node.Finish.*
use Lower.Node.Keyed.*
use Lower.Node.Switch.*
use Syntax.*
use Syntax.Decls.*
use Syntax.Lexer.*
use Syntax.Lexer.Chars.*
use Syntax.Lexer.Layout.*
use Syntax.Lexer.Words.*
use Syntax.Lexer.Literals.*
use Syntax.Lexer.Templates.*
use Syntax.Lexer.Corpus.*
use Check.Errors.*
use Check.Types.*
use Check.Types.Recording.*
use Check.Types.Unify.*
use Check.Types.Schemes.*
use Check.Types.Colors.*
use Check.Env.*
use Check.Env.Names.*
use Check.Env.Reading.*
use Check.Env.Decls.*
use Check.Env.Traits.*
use Check.Typed.*
use Check.Typed.Print.*
use Lower.*
use Lower.Types.*
use Lower.Expr.*
use Lower.Patterns.*
use Lower.Templates.*
use Lower.Functions.*
use Lower.Jobs.*
use Lower.Program.*
use Lower.Model.*

# ---------------------------------------------------------------------------------------
# Elements (claude/backend.md: each place goes out with `cx.added` in its `Level`; an answer
# calls the input method; a request field's firing is `cx.request`)
# ---------------------------------------------------------------------------------------

ElementLine: unbounded fn Wx, Env, Env, Expr, ?Bn -> ((Wx, Wres))
fn ElementLine wx, benv, menv, e, ?bound:
    let lx = wx.lx
    let ((tagName, args)) = match e.kind:
        ECall c, xs, ignore, ignore: (((TagNameOf lx, c), xs))
        EName n: (((TagNameOf lx, e), [[]]))
        otherwise: (("", [[]]))
    let full = TypeAt lx, e.span
    match lx.g.tags[tagName]:
        nil:
            let wx2 = update wx:
                &_.build <= Push &_.build, (RefusalDo "an element of an unknown tag")
            ((wx2, WrUnit))
        ? tg: ElementPlaced wx, benv, menv, tg, args, [[]], (ElementOut lx, tg, full), ?bound

# A request field of an element fed by an event: each firing asks at the place
# (`SkRequest`), and where the tag's level holds its events (ruling EP; `LevelEvents`) the
# event itself goes into the place's level: a port the event fires, as a bound event's
# value form is (`PreBindName`), and the event of that port, made once so the level holds
# the same event for as long as the place lives. Gives the level's fields three ways with
# this one added.
RequestFieldInto: unbounded fn Wx, TagInfo, Pos, Text, Ty, EvRef, OutTy, [((Text, Ex))], [((Text, Ex))], [((Text, Ex))], [Read] -> (([((Text, Ex))], [((Text, Ex))], [((Text, Ex))], [Read], Wx))
fn RequestFieldInto w2, tg, pos, fname, fty, r, et, lf, cf, mf, rd:
    let lx = w2.lx
    let w3 = Connect w2, r, (SkRequest pos, (RequestField tg, fname))
    if (Len (LevelEvents tg)) == 0: ((lf, cf, mf, rd, w3))
    else:
        let ((stem, w4)) = FreshName w3, "request_{PlaceText pos}_{Snake (FieldSpell tg.home, fname, fty)}"
        let pf = "{stem}_port"
        let ef = "{stem}_event"
        let pt = OutRc (OutPort et)
        let evTy = OutEvent (TagFieldOut lx, fty)
        let made = RecodedWhole lx, fty, (XCall (RefRuntime "prism_rtl::Event::of"), [[XRef (XVar pf)]])
        let w5 = update (Connect w4, r, (SkPort stem)):
            &_.taken <= Append &_.taken, [[pf, ef]]
            &_.lets <= Append &_.lets, [[(DoLet (PaTyped (PaBind pf), pt), (XCall (RefRuntime "std::Rc::new"), [[(XCall (RefRuntime "rt::Port::new"), [[]])]])), (DoLet (PaTyped (PaBind ef), evTy), made)]]
            &_.fields <= Append &_.fields, [[((pf, pt, "place {PlaceText pos}'s `{fname}`: the port it fires")), ((ef, evTy, "place {PlaceText pos}'s `{fname}` as its level holds it"))]]
            &_.moves <= Append &_.moves, [[((pf, (XClone (XVar pf)))), ((ef, (XClone (XVar ef))))]]
        let spelled = FieldSpell tg.home, fname, fty
        let held = XClone (XField XSelf, ef)
        (((Push lf, ((spelled, held))), (Push cf, ((spelled, (XClone (XVar ef))))), (Push mf, ((spelled, held))), rd, w5))

# An event a caller of `ElementPlaced` gives for a request field, by the field's name.
?FedEvent: fn [((Text, EvRef, OutTy))], Text -> ?((EvRef, OutTy))
fn ?FedEvent fed, fname = Fold fed, nil, \|?found, ((n, r, et))| if n == fname: ? ((r, et)) else: ?found

# An element of a known tag at the block's next position, its fields the named arguments:
# the place, its request fields' sinks, its output. `fed` holds the request fields fed
# by an event that is no argument of the source: `@Later` places its `Time.After` with
# its own event in the request field (`LaterLine`).
ElementPlaced: unbounded fn Wx, Env, Env, TagInfo, [Arg], [((Text, EvRef, OutTy))], OutTy, ?Bn -> ((Wx, Wres))
fn ElementPlaced wx, benv, menv, tg, args, fed, out, ?bound:
    let lx = wx.lx
    let pos = wx.pos
    let wx1 = update wx:
        &_.pos <= NextPos &_.pos
    let structPath = RefIn lx, tg.home, (TagStructOf tg)
    # each field three ways: live in the methods, constant at the build, and constant
    # in the methods (a row's `document`, where a row's key is its own field)
    let ((liveFields, constFields, methodConsts, reads, wx2)) = Fold tg.fields, (([[]], [[]], [[]], [[]], wx1)), \|((lf, cf, mf, rd, w)), ((fname, fty))|
        match ?TagArg args, fname:
            nil: match ?FedEvent fed, fname:
                ? ((r, et)): RequestFieldInto w, tg, pos, fname, fty, r, et, lf, cf, mf, rd
                nil: ((lf, cf, mf, rd, w))
            ? arg:
                match LayerOf fty:
                    LyEv:
                        let ((r, w2)) = EventRef w, menv, arg
                        RequestFieldInto w2, tg, pos, fname, fty, r, (OutTyOf lx, (Peel (TypeAt lx, arg.span))), lf, cf, mf, rd
                    otherwise:
                        let ((ex0, rds)) = DynamicExpr w, menv, arg
                        # at the build every name with a value then reads it (`InitEnv`):
                        # a window's title, asked with its first value before the node is
                        let cv = RecodedField lx, fty, (Own (ValueOf lx, (InitEnv benv), arg))
                        let mv = RecodedField lx, fty, (Own (ValueOf lx, menv, arg))
                        # a generic tag's field goes into its level as plain data
                        let ex = RecodedField lx, fty, ex0
                        (((Push lf, (((FieldSpell tg.home, fname, fty), ex))), (Push cf, (((FieldSpell tg.home, fname, fty), cv))), (Push mf, (((FieldSpell tg.home, fname, fty), mv))), (UnionReads rd, rds), w))
    # a field that reads a late name has no value at the build (`BindLate`,
    # `MarkLateLets`): the place is live over the node's getters, read where the
    # place goes out, after the node's rows are built
    let late = Fold args, False, \|f, a| f or ReadsLate menv, a.value
    let live = (Len reads) > 0 or late
    let ((getter, wx3)) = if live: FreshName wx2, (Snake (BareName tg.name)) else: (("", wx2))
    let variant = VariantOf lx, tg
    # the place's level as the program's `Elem`: read by its getter in the methods when
    # a field is live, else the constant as the methods spell it; at the build the constant
    # fields' value
    let level = XCtor variant, [[(XRecord structPath, (if live: liveFields else: methodConsts))]]
    let atBuild = XCtor variant, [[(XRecord structPath, constFields)]]
    let added = if live: XMethod (XVar "node"), getter, [[XCx]] else: atBuild
    let emits = Emits wx3, pos
    # a hosted place is an entry of its host's document (`$(Path ==> $Elem c)`): its
    # `Entry`, made before the node (a first-value query hands it to the host) and
    # taken at the build in its scope's turn (`BuildSteps`) and in the patch pass; a
    # World place whose level holds dynamics watches them (doubt WD)
    let ((entry, wx3e)) = if emits: (("", wx3)) else: FreshName wx3, "entry_{PlaceText pos}"
    let deep = emits and TagHoldsDyn lx, tg
    let ((watch, wx3w)) = if deep: FreshName wx3e, "watch_{PlaceText pos}" else: (("", wx3e))
    let what = "place {PlaceText pos} ({tg.name}) of `{wx.node}`"
    # a constant place's entry takes its one snapshot at once; a live one's waits for
    # its scope's builders (`BuildSteps`)
    let constTake = if live: [[]] else: [[(DoExpr (XMethod (XVar entry), "take", [[atBuild, XCx]]))]]
    let wx3h = if emits: wx3w else: update wx3w:
        &_.lets <= Append (Push &_.lets, (DoLet (PaTyped (PaBind entry), entryTy), (XCall (RefRuntime "prism_rtl::Entry::new"), [[XStr what]]))), constTake
        &_.fields <= Push &_.fields, ((entry, entryTy, "{what}, an entry of its host's document"))
        &_.moves <= Push &_.moves, ((entry, (XClone (XVar entry))))
    let wx3d = if deep: AddFieldLast wx3h, watch, (OutNamed (RefRuntime "prism_rtl::Watch"), [[]]), "the dynamics place {PlaceText pos}'s level holds, watched so a move sends it again (doubt WD)", (XCall (RefRuntime "prism_rtl::Watch::new"), [[]]) else: wx3h
    let sent = if deep: [[(DoLet (PaBind "sent"), added), (DoExpr (XMethod (XCx), "added", [[(PlaceAt wx3, "node", pos), (XMethod (XVar "sent"), "level_pod", [[XCx]])]])), (DoExpr (XMethod (XField (XVar "node"), watch), "renew", [[(XRef (XVar "sent")), (XCast (XClone (XVar "node")), (OutObj (OutNamed (RefRuntime "rt::Node"), [[]]))), XCx]]))]]
        else: [[(DoExpr (XMethod (XCx), "added", [[(PlaceAt wx3, "node", pos), (XMethod added, "level_pod", [[XCx]])]]))]]
    let wx4 = update wx3d:
        &_.places <= Push &_.places, Place(pos=pos, level=level, getter=getter, reads=reads, entry=entry, watch=watch)
        &_.build <= if emits: (if deep: Push &_.build, (DoScope sent) else: Append &_.build, sent) else: &_.build
    # a place that asks its first value once the node stands (`LateFirstPlace`, a `$`
    # output or a bundle's state in a hosted scope whose host answers late) asks with
    # the element its fields have then: one whose field reads a late name (the plain
    # part of a late place above it) is read by its getter, from the node
    let partsBound = match ?bound:
        ? (BnParts ignore): True
        otherwise: False
    let asksLate = (HasNat wx4.lateHosts, pos.scope) and match tg.out:
        TyTuple cs: partsBound and Fold cs, False, \|found, c| found or (LayerOf c) != LyEv
        other: (not partsBound) and (LayerOf other) == LyDyn
    ElementOutput wx4, menv, tg, out, pos, ?bound, (if late and asksLate: added else: atBuild)

# An element's output type at this application: the tag's, instantiated by the checker
# (`Prelude.Unwrap`'s `!a` is `!unit` where its value is `!~unit`). A type variable the
# program leaves open is the answer as it came, a `Pod`.
ElementOut: unbounded fn Lx, TagInfo, Ty -> OutTy
fn ElementOut lx, tg, full:
    let t = match Peel full:
        TyElem ignore, o: OutTyOf lx, (Peel o)
        otherwise: OutTyOf lx, (Peel tg.out)
    ErasedOut t

# The tag an element expression names.
TagNameOf: fn Lx, Expr -> Text
fn TagNameOf lx, c = match c.kind:
    EName n:
        let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
        Or ?qk, (Dotted n.path)
    EGroup x: TagNameOf lx, x
    otherwise: ""

?TagArg: fn [Arg], Text -> ?Expr
fn ?TagArg args, fname = Fold args, nil, \|?found, a| match a.?name:
    ? n: if n.name == fname: ? a.value else: ?found
    nil: ?found

# A request field's name in `cx.request`: set when the tag has several request fields.
RequestField: fn TagInfo, Text -> Text
fn RequestField tg, fname:
    let evs = Filter tg.fields, \|((ignore, t))| (LayerOf t) == LyEv
    if (Len evs) > 1: fname else: ""

# An element's output: an event answered at its place, a dynamic pushed to it, a plain
# value as its first value.
ElementOutput: unbounded fn Wx, Env, TagInfo, OutTy, Pos, ?Bn, Ex -> ((Wx, Wres))
fn ElementOutput wx, menv, tg, out, pos, ?bound, level:
    let lx = wx.lx
    match ?bound:
        ? (BnParts parts): BundleOutput wx, tg, out, pos, parts, level
        otherwise: ElementOutputOf wx, menv, tg, out, pos, ?bound, level

# A bundle's output (`Gui.Window`'s `((WindowId, !WindowInput))`, `((Nat, $Text))`,
# `((!Text, !Nat))`), taken apart by its tuple pattern: any mix of plain, `$` and event
# parts (Type System ch. 2, "Bundles"; claude/backend.md, "Answers").
# - The plain and `$` parts are the place's state, its first value (one part itself,
#   several a tuple): a plain part is read from it once, at the build; a `$` part is a
#   hold made with its part of it (`{f}_init`, the part's value at the build, `PreInit`),
#   written by each push of the state, which a World keys by the element.
# - Each event part is a node the place's answers fire: an answer to one event part is
#   its value, to several a sparse tuple of them, the parts that fired.
# In a hosted scope the state is the enclosing host's, typed: the tag's first-value
# variant of `Answer` when the tag has event parts too, else the tag's own (pick HO).
BundleOutput: unbounded fn Wx, TagInfo, OutTy, Pos, [?Bn], Ex -> ((Wx, Wres))
fn BundleOutput wx, tg, out, pos, parts, level = BundleOutputOf wx, tg, out, pos, parts, level

BundleOutputOf: unbounded fn Wx, TagInfo, OutTy, Pos, [?Bn], Ex -> ((Wx, Wres))
fn BundleOutputOf wx, tg, out, pos, parts, level:
    let layers = match tg.out:
        TyTuple cs: Each cs, \|c| LayerOf c
        otherwise: [[]]
    let tys = match out:
        OutTuple ts: ts
        otherwise: [[]]
    let idx = Range0 (Len layers)
    let stateIx = Filter idx, \|i| (Or layers[i], LyPlain) != LyEv
    let evIx = Filter idx, \|i| (Or layers[i], LyPlain) == LyEv
    let ValueTy = \|i| match Or tys[i], OutUnit:
        OutDyn inner: inner
        OutEvent inner: inner
        other: other
    let ((wx1, events)) = Fold evIx, ((wx, [[]])), \|((w, acc)), i|
        let ((id, w2)) = BundleEvent w, pos, (ValueTy i), (Or parts[i], nil)
        ((w2, (Push acc, ((id, (ValueTy i))))))
    let one = (Len stateIx) == 1
    let stateTy = if one: ValueTy (Or stateIx[0], 0) else: OutTuple (Each stateIx, ValueTy)
    let whole = "bundle_{PlaceText pos}"
    # in a hosted scope whose host answers late, the state is asked once the node stands
    # (`LateFirstPlace`): each `$` part's hold is empty until then, and so is the hold of
    # a plain part the pattern names, a late name (`LatePlaceParts`)
    let late = (Len stateIx) > 0 and HasNat wx.lateHosts, pos.scope
    let wholeLets = [[(FirstValueLet wx1, pos, tg, level, stateTy), (DoLet (PaBind whole), (if Emits wx1, pos: XDecode stateTy, (XRef (XVar "first_{PlaceText pos}")) else: XVar "first_{PlaceText pos}"))]]
    let asksLate = update wx1:
        &_.lateFirsts <= Push &_.lateFirsts, ((pos.scope, wholeLets))
        &_.fallible <= True
    let wx2 = if (Len stateIx) == 0: wx1 else: if late: asksLate else: update wx1:
        &_.lets <= Append &_.lets, wholeLets
        &_.fallible <= True
    let ((wx3, holds)) = Fold (Range0 (Len stateIx)), ((wx2, [[]])), \|((w, acc)), k|
        let i = Or stateIx[k], 0
        let part = if one: XVar whole else: XClone (XPart (XVar whole), k)
        if late and (Or layers[i], LyPlain) == LyDyn:
            let ((f, w1)) = match ?LatePlaceHold (Or parts[i], nil):
                ? hf: ((hf, w))
                nil: FreshName w, "place_{PlaceText pos}"
            (((LateFirstPlace w1, pos, f, (ValueTy i), [[(LateFirstSet f, part)]]), (Push acc, ((k, f, (ValueTy i))))))
        # a late place's plain part: its name's hold, written once (no push reaches it)
        else: if late: (((LatePlainPart w, pos, (Or parts[i], nil), i, (ValueTy i), part), acc))
        else: if (Or layers[i], LyPlain) == LyDyn:
            let ((f, w1)) = match parts[i]:
                ? (? (BnHold hf, ignore)): ((hf, w))
                otherwise: FreshName w, "place_{PlaceText pos}"
            let w2 = update w1:
                &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind "{f}_init"), (ValueTy i)), part)
                &_.fields <= Push &_.fields, ((f, (OutHold (ValueTy i)), "pushed to place {PlaceText pos}, part {i} of its answer"))
                &_.inits <= Push &_.inits, ((f, (XCall (RefRuntime "rt::Hold::new"), [[(XClone (XVar "{f}_init")), XCx]])))
            ((w2, (Push acc, ((k, f, (ValueTy i))))))
        else: match parts[i]:
            ? (? (BnLocal rs, ignore, ignore)):
                let f = PlaceStem rs
                let w2 = update w:
                    &_.lets <= Push &_.lets, (DoLet (PaBind f), part)
                    &_.fields <= Push &_.fields, ((f, (ValueTy i), "place {PlaceText pos}'s answer, part {i}, read from its first value"))
                    &_.inits <= Push &_.inits, ((f, (XClone (XVar f))))
                ((w2, acc))
            otherwise: ((w, acc))
    # a World's pushes are keyed by the element: the place listens for them; a hosted
    # place's come typed from its host
    let stem = match holds[0]:
        ? ((ignore, f, ignore)): f
        nil: ""
    let wx4 = if stem == "" or not (Emits wx3, pos): wx3 else: update wx3:
        &_.lets <= Push &_.lets, (DoLet (PaBind "{stem}_element"), (XMethod level, "to_pod", [[]]))
        &_.fields <= Push &_.fields, (("{stem}_element", OutPod, "place {PlaceText pos}'s element, which pushes are keyed by"))
        &_.moves <= Push &_.moves, (("{stem}_element", (XClone (XVar "{stem}_element"))))
        &_.build <= Push &_.build, (DoExpr (XMethod (XCx), "listen", [[(XClone (XField (XVar "node"), "{stem}_element")), (XRef (XCast (XClone (XVar "node")), (OutObj (OutNamed (RefRuntime "rt::Node"), [[]]))))]]))
    let wx5 = update wx4:
        &_.bundles <= Push &_.bundles, BundlePlace(pos=pos, stem=stem, stateTy=stateTy, stateParts=(Len stateIx), holds=holds, events=events, stateAccessor=(if (Len evIx) == 0: AnswerAccessor tg else: "{AnswerAccessor tg}_first"), eventAccessor=(AnswerAccessor tg), firstVariant=(AnswerFirstVariant tg))
    ((wx5, WrUnit))

# A late place's plain part (`LatePlaceParts`): the hold of the name the pattern gives
# it, empty at the node's making and set from the part of the first value where the
# place asks it (`Wx.lateFirsts`); no push writes it. A part the pattern does not name
# is read by nothing.
LatePlainPart: fn Wx, Pos, ?Bn, Nat, OutTy, Ex -> Wx
fn LatePlainPart wx, pos, ?bound, i, t, part = match ?LatePlainHold ?bound:
    ? f: update wx:
        &_.fields <= Push &_.fields, ((f, (OutHold (OutOpt t)), "place {PlaceText pos}'s answer, part {i}, read from its first value: empty until that is asked, once the node stands"))
        &_.moves <= Push &_.moves, ((f, (XCall (RefRuntime "rt::Hold::new"), [[XNone, XCx]])))
        &_.lateFirsts <= Push &_.lateFirsts, ((pos.scope, [[(LateFirstSet f, part)]]))
    nil: wx

# A bundle's event part: the node the place's answers fire, the bound name's or one of
# the place's own.
BundleEvent: fn Wx, Pos, OutTy, ?Bn -> ((Nat, Wx))
fn BundleEvent wx, pos, t, ?b = match ?b:
    ? (BnEv er, ignore): ((er.node, wx))
    otherwise:
        let ((nm, w)) = FreshName wx, "place_{PlaceText pos}"
        AddGn w, nm, t, GnAnswer, 0

# A place's first value at the build: from the World (`cx.first_value`, by the element as
# it is built, the plain data every World answer is), or in a hosted scope from the
# enclosing host, which builds its supplier row for the place now (the one early
# construction, prism_rtl's `Host::first_value`) and answers typed, by the tag's `Answer`
# accessor. Either way the local `first_{pos}` holds the value, decoded from a `Pod` only
# from the World.
FirstValueLet: unbounded fn Wx, Pos, TagInfo, Ex, OutTy -> Do
fn FirstValueLet wx, pos, tg, level, placed:
    let missing = XCall (RefRuntime "rt::Fault::answer"), [[(XStr "no first value for {tg.name}")]]
    if Emits wx, pos:
        let asked = XMethod (XCx), "first_value", [[(XRef (XMethod level, "to_pod", [[]]))]]
        DoLet (PaBind "first_{PlaceText pos}"), (TryOf (XMethod asked, "ok_or", [[missing]]))
    else:
        let host = HostLocal wx, pos
        let entry = Or (Fold wx.places, nil, \|?e, pl| if pl.pos == pos: ? pl.entry else: ?e), ""
        let asked = TryOf (XMethod (XVar host), "first_value", [[(XRef (PlaceAt wx, "", pos)), (XRef level), (XRef (XVar entry)), XCx]])
        let accessor = if (IsBundleTag tg): "{AnswerAccessor tg}_first" else: AnswerAccessor tg
        let carried = if IsBundleTag tg: Or (?BundleFirstTy wx.lx, tg), OutUnit else: AnswerTy wx.lx, tg
        DoLet (PaBind "first_{PlaceText pos}"), (RecodedAnswer (AnswerOpen wx.lx, tg), carried, placed, (TryOf (XMethod (TryOf (XMethod asked, "ok_or", [[missing]])), accessor, [[]])))

# The host whose document a position's place is an entry of, as the build spells it (a
# local before the node exists): the host of its scope, or for a node's own places in a
# hosted scope the enclosing host, which every hosted node's `build` is given.
HostLocal: fn Wx, Pos -> Text
fn HostLocal wx, pos = if pos.scope == 0: "enclosing" else: Or wx.scopes[Dec pos.scope], ""

# A tag's variant of the program's `Answer` enum, and the accessor that takes the variant's
# value out (`ui_button`), emitted beside `crate::Elem`.
AnswerVariant: fn TagInfo -> Ref
fn AnswerVariant tg = RefChild answerRef, (TagStruct tg.name)

# Whether a tag's output is a bundle with event parts and a state (plain or `$` parts),
# whose state has a variant of its own (`?BundleFirstTy`).
IsBundleTag: fn TagInfo -> Bool
fn IsBundleTag tg = match Peel tg.out:
    TyTuple cs: (Fold cs, False, \|f, c| f or (LayerOf c) == LyEv) and Fold cs, False, \|f, c| f or (LayerOf c) != LyEv
    otherwise: False

# A bundle tag's first-value variant (`AnswerCase.first`).
AnswerFirstVariant: fn TagInfo -> Ref
fn AnswerFirstVariant tg = RefChild answerRef, "{TagStruct tg.name}First"

AnswerAccessor: fn TagInfo -> Text
fn AnswerAccessor tg = Snake (TagStruct tg.name)

# A place whose element answers a dynamic (a tag's `$` output, or a bundle's `$` part): the
# hold `f` its pushes write, made with the place's first value, and its entry among the
# node's pushed places with the `Answer` accessor a host's typed answer is taken by.
DynamicPlace: unbounded fn Wx, TagInfo, OutTy, Pos, Text, Ex, Text -> Wx
fn DynamicPlace wx1, tg, out, pos, f, level, accessor:
    let emits = Emits wx1, pos
    # a World's first value is plain data, decoded; a host's is typed already
    let first = if emits: XDecode out, (XRef (XVar "first_{PlaceText pos}")) else: (XVar "first_{PlaceText pos}")
    # the first value stands in the local `{f}_init`, the place's value at the build,
    # which a supplier's dynamic answer reads while the node is being made (`PreInit`)
    let wx2 = update wx1:
        &_.lets <= Append &_.lets, [[(FirstValueLet wx1, pos, tg, level, out), (DoLet (PaTyped (PaBind "{f}_init"), out), first)]]
        &_.fields <= Push &_.fields, ((f, OutHold out, "pushed to place {PlaceText pos}"))
        &_.inits <= Push &_.inits, ((f, (XCall (RefRuntime "rt::Hold::new"), [[(XClone (XVar "{f}_init")), XCx]])))
        &_.dynPlaces <= Push &_.dynPlaces, ((pos, f, out, accessor))
        &_.fallible <= True
    # a World's pushes are keyed by the element: the place listens for them; a hosted
    # place's come typed from its host
    if emits: update wx2:
        &_.lets <= Push &_.lets, (DoLet (PaBind "{f}_element"), (XMethod level, "to_pod", [[]]))
        &_.fields <= Push &_.fields, (("{f}_element", OutPod, "place {PlaceText pos}'s element, which pushes are keyed by"))
        &_.moves <= Push &_.moves, (("{f}_element", (XClone (XVar "{f}_element"))))
        &_.build <= Push &_.build, (DoExpr (XMethod (XCx), "listen", [[(XClone (XField (XVar "node"), "{f}_element")), (XRef (XCast (XClone (XVar "node")), (OutObj (OutNamed (RefRuntime "rt::Node"), [[]]))))]]))
    else: wx2

# A place with a `$` output in a hosted scope whose host answers with a dynamic that has
# no value while the node is being made (`Wx.lateHosts`; Semantics ch. 9: a dynamic
# output's first value is read in the birth tick; ch. 7, "Structural dynamics": the
# tick's outputs read the value after it). Its hold `f` is empty at the node's making
# (`Hold<Option<T>>`, read as the value it holds, `LatePlaceBn`) and is set where the
# construction step reaches the host's line, the builders above it run (`BuildSteps`):
# `asked`, the first value asked of the host and the hold set from it, is kept by scope
# (`Wx.lateFirsts`). A push writes the present value (`DynPlaceWrite`).
LateFirstPlace: fn Wx, Pos, Text, OutTy, [Do] -> Wx
fn LateFirstPlace wx, pos, f, t, asked = update (LateFirstHold wx, pos, f, t):
    &_.lateFirsts <= Push &_.lateFirsts, ((pos.scope, asked))

# The hold of such a place, empty until its first value is asked.
LateFirstHold: fn Wx, Pos, Text, OutTy -> Wx
fn LateFirstHold wx, pos, f, t = update wx:
    &_.fields <= Push &_.fields, ((f, (OutHold (OutOpt t)), "pushed to place {PlaceText pos}, empty until its first value is asked, once the node stands"))
    &_.moves <= Push &_.moves, ((f, (XCall (RefRuntime "rt::Hold::new"), [[XNone, XCx]])))
    &_.latePlaces <= Push &_.latePlaces, f
    &_.fallible <= True

# The hold set from its first value, in the build once the node stands.
LateFirstSet: fn Text, Ex -> Do
fn LateFirstSet f, first = DoExpr (XMethod (XField (XVar "node"), f), "set", [[(XCtor (RefRuntime "std::Some"), [[first]]), XCx]])

ElementOutputOf: unbounded fn Wx, Env, TagInfo, OutTy, Pos, ?Bn, Ex -> ((Wx, Wres))
fn ElementOutputOf wx, menv, tg, out, pos, ?bound, level:
    let lx = wx.lx
    match LayerOf tg.out:
        LyEv:
            let ((id, wx2)) = match ?bound:
                ? (BnEv er, ignore): ((er.node, wx))
                otherwise:
                    let ((nm, w)) = FreshName wx, "place_{PlaceText pos}"
                    AddGn w, nm, out, GnAnswer, 0
            let wx3 = update wx2:
                &_.answers <= Push &_.answers, ((pos, id, out, (AnswerAccessor tg)))
            ((wx3, (WrEv (EvRefOf wx3, id))))
        # in a hosted scope whose host answers late, the place asks its first value once
        # the node stands (`LateFirstPlace`)
        LyDyn if HasNat wx.lateHosts, pos.scope:
            let ((f, wx1)) = match ?LatePlaceHold ?bound:
                ? hf: ((hf, wx))
                nil: FreshName wx, "place_{PlaceText pos}"
            let asked = [[(FirstValueLet wx1, pos, tg, level, out), (LateFirstSet f, (XVar "first_{PlaceText pos}"))]]
            let wx3 = update (LateFirstPlace wx1, pos, f, out, asked):
                &_.dynPlaces <= Push &_.dynPlaces, ((pos, f, out, (AnswerAccessor tg)))
            ((wx3, (BnRes (LatePlaceBn f, out))))
        LyDyn:
            let ((f, wx1)) = match ?bound:
                ? (BnHold hf, ignore): ((hf, wx))
                otherwise: FreshName wx, "place_{PlaceText pos}"
            let wx3 = DynamicPlace wx1, tg, out, pos, f, level, (AnswerAccessor tg)
            ((wx3, (WrDyn (XMethod (XField XSelf, "{f}"), "get", [[XCx]]), [[OwnRead f]], out)))
        otherwise: match ?bound:
            ? (BnLocal rs, ignore, ignore):
                let f = PlaceStem rs
                let first = if Emits wx, pos: XDecode out, (XRef (XVar "first_{PlaceText pos}")) else: (XVar "first_{PlaceText pos}")
                let wx2 = update wx:
                    &_.lets <= Append &_.lets, [[(FirstValueLet wx, pos, tg, level, out), (DoLet (PaBind f), first)]]
                    &_.fields <= Push &_.fields, ((f, out, "place {PlaceText pos}'s answer, its first value"))
                    &_.inits <= Push &_.inits, ((f, (XClone (XVar f))))
                    &_.fallible <= True
                ((wx2, WrUnit))
            otherwise: ((wx, WrUnit))
