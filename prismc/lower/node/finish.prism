# `Lower.Node.Finish`, a child module of `Lower.Node`.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit r
use Lower.Node.*
use Lower.Node.Def.*
use Lower.Node.Elements.*
use Lower.Node.Static.*
use Lower.Node.Dynamics.*
use Lower.Node.Keyed.*
use Lower.Node.Switch.*
use Syntax.*
use Syntax.Decls.*
use Syntax.Lexer.*
use Syntax.Lexer.Chars.*
use Syntax.Lexer.Layout.*
use Syntax.Lexer.Words.*
use Syntax.Lexer.Literals.*
use Syntax.Lexer.Templates.*
use Syntax.Lexer.Corpus.*
use Check.Errors.*
use Check.Types.*
use Check.Types.Recording.*
use Check.Types.Unify.*
use Check.Types.Schemes.*
use Check.Types.Colors.*
use Check.Env.*
use Check.Env.Names.*
use Check.Env.Reading.*
use Check.Env.Decls.*
use Check.Env.Traits.*
use Check.Typed.*
use Check.Typed.Print.*
use Lower.*
use Lower.Types.*
use Lower.Expr.*
use Lower.Patterns.*
use Lower.Templates.*
use Lower.Functions.*
use Lower.Jobs.*
use Lower.Program.*
use Lower.Model.*

# ---------------------------------------------------------------------------------------
# The node, finished: heights, methods, the `Node` hooks, the build
# ---------------------------------------------------------------------------------------

# Heights (Q-B8; Compiler ch. 3, "The analyses"): a source is at 0, a named event at the
# height of what fires it, a combinator one above its inputs; an "updated" node's inputs
# are the writers of the holds its dynamic reads (its `reads`, closed). The graph is
# acyclic within a tick (the checker's prompt-cycle check), so as many rounds as nodes
# settle it.
Heights: fn [Gn] -> [Gn]
fn Heights gns = Fold gns, gns, \|cur, ignore| Each cur, \|n| HeightStep cur, n

HeightStep: fn [Gn], Gn -> Gn
fn HeightStep gns, n:
    let feeders = Filter gns, \|m| Fold m.outs, False, \|f, o| f or Feeds o.sink, n
    let top = Fold feeders, 0, \|hi, m| Max hi, m.height
    let h = match n.kind:
        GnNamed: top
        kind: if IsComb kind: Max (top + 1), n.floor else: n.height
    update n:
        &_.height <= h

# The kinds decided in the wake, one above what feeds them.
IsComb: fn GnKind -> Bool
fn IsComb k = match k:
    GnMerge: True
    GnUnion: True
    GnBoth: True
    GnExcept: True
    GnMergeAll: True
    GnUpdated: True
    otherwise: False

# Whether a sink feeds a node: by firing it, or, for an "updated" node, by writing a hold
# its dynamic reads (`SkHold`, and `@Machine`'s state).
Feeds: fn Sk, Gn -> Bool
fn Feeds (SkNode m), n = m == n.id
fn Feeds (SkIn m, ignore), n = m == n.id
fn Feeds (SkCycle ignore, ignore, m), n = m == n.id
fn Feeds (SkMachine f, ignore, m), n = m == n.id or Writes f, n
fn Feeds (SkHold f), n = Writes f, n
fn Feeds (SkDistinct f), n = Writes f, n
fn Feeds (SkPerKey f), n = Writes f, n
fn Feeds other, n = False

# Whether a write to hold `f` moves an "updated" node's dynamic.
Writes: fn Text, Gn -> Bool
fn Writes f, n = Moves (OwnRead f), n

# Whether a write behind a read (a hold of this node, or a name of the block read through
# the parent) moves an "updated" node's dynamic.
Moves: fn Read, Gn -> Bool
fn Moves r, n = n.kind == GnUpdated and HasRead n.reads, r

# The holds a place reads, through the getters of dynamic `let`s.
ReadsClosed: fn (Text ==> [Read]), [Read] -> [Read]
fn ReadsClosed dyn, reads = Fold (Range0 4), reads, \|acc, ignore| Fold acc, acc, \|a, r| UnionReads a, (GetterReads dyn, r)

# What a read reaches through the node's getters: a dynamic `let`'s reads; a hold, or a
# read through the parent, nothing more.
GetterReads: fn (Text ==> [Read]), Read -> [Read]
fn GetterReads dyn, (OwnRead n) = Or dyn[n], [[]]
fn GetterReads dyn, (ParentRead ignore) = [[]]

# Whether a closed read set reaches a structural dynamic.
ReachesSnap: fn [Text], [Read] -> Bool
fn ReachesSnap roots, reads = Fold reads, False, \|f, r| f or match r:
    OwnRead n: HasText roots, n
    ParentRead ignore: False

SnapNames: fn Wx -> [Text]
fn SnapNames wx = Each wx.snaps, \|sn| sn.name

SelfCall: fn Text, [Ex] -> Do
fn SelfCall m, args = DoExpr (XMethod (XSelf), m, (Push args, (XCx)))

# A request field's firing: `cx.request` at the place, or its host's `request`.
RequestCode: fn Sinks, Pos, Text, Ex -> [Do]
fn RequestCode sk, pos, field, y:
    let fieldEx = if field == "": XNone else: (XCtor (RefRuntime "std::Some"), [[XStr field]])
    # a hosted place's request goes to its host: out with a forwarded element, else nowhere
    if Emits sk.wx, pos: [[DoExpr (XMethod (XCx), "request", [[(PlaceAt sk.wx, "self", pos), fieldEx, (XMethod y, "to_pod", [[]])]])]]
    # the host's answer first, then kept: `cx` is borrowed once at a time
    # (the host of the block's own scope is a `Host`, whose method is `request`; a row's
    # enclosing host is a `HostOf`, whose method is `request_from`)
    else: [[(DoLet (PaBind "requested"), (XMethod (HostFieldEx sk.wx, pos), (if pos.scope == 0: "request_from" else: "request"), [[(XRef (PlaceAt sk.wx, "self", pos)), fieldEx, (XMethod y, "to_pod", [[]]), XCx]])), (DoExpr (XMethod (XCx), "keep", [[(XVar "requested")]]))]]

# What a firing does at its sink.
SinkCode: fn Sinks, Sk, Ex -> [Do]
fn SinkCode sk, target, y = match target:
    SkNode m: [[(SelfCall (GnOf sk.wx, m).name, [[y]])]]
    SkIn m, i:
        let g = GnOf sk.wx, m
        Append [[DoExpr (XMethod (XField XSelf, "{Or g.inputs[i], ""}"), "set", [[y, XCx]])]], (AskWake sk, g)
    SkHold f: Append [[(DoExpr (XMethod (XField XSelf, "{f}"), "set", [[y, XCx]]))]], (HoldWritten sk, f)
    # the value it holds as the tick opened, against the source's after it: equal, nothing
    # is written and nothing marked
    SkDistinct f:
        let differs = XBin OpNe, (XMethod (XField XSelf, "{f}"), "get", [[XCx]]), (XCtor (RefRuntime "std::Some"), [[XClone y]])
        let write = DoExpr (XMethod (XField XSelf, "{f}"), "set", [[(XCtor (RefRuntime "std::Some"), [[XClone y]]), XCx]])
        [[(DoIf differs, (Append [[write]], (HoldWritten sk, f)), [[]])]]
    # the map after the tick taken apart: the changed inners written and fired by the
    # runtime; the outer's readers marked only when a key came or went
    SkPerKey f: [[(DoIf (XMethod (XField XSelf, "{f}"), "written", [[(XClone y), XCx]]), (HoldWritten sk, f), [[]])]]
    SkRequest pos, field: RequestCode sk, pos, field, y
    SkResult: [[DoExpr (XMethod (XCx), "result", [[(XCtor (RefRuntime "rt::Outcome::Fired"), [[(XMethod y, "to_pod", [[]])]])]])]]
    SkArm f: [[DoExpr (XMethod (XField XSelf, "{f}"), "arm", [[y, (XClone XSelf), XCx]])]]
    SkLater f: [[(DoExpr (XMethod (XField XSelf, f), "queue", [[y]]))]]
    SkMachine f, step, out:
        let stepped = XApply step, [[(XRef (XMethod (XField XSelf, f), "get", [[XCx]])), (XRef y)]]
        Append [[(DoLet (PaTuple [[PaBind "machine_s", PaBind "machine_b"]]), stepped), DoExpr (XMethod (XField XSelf, "{f}"), "set", [[(XVar "machine_s"), XCx]]), (DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "machine_b"]]), (XVar "machine_b"), [[(SelfCall (GnOf sk.wx, out).name, [[(XVar "machine_b")]])]], [[]])]], (MovedMarks sk, f)
    SkPort f: [[DoExpr (XCall (HelperRef "no_fault"), [[(XMethod (XField XSelf, "{f}_port"), "fire", [[y, XCx]])]])]]
    SkUp m:
        let keyed = (Len (Filter sk.wx.fields, \|((f, ignore, ignore))| f == "key")) > 0
        let args = if keyed: [[(XClone (XField XSelf, "key")), y, XCx]] else: [[y, XCx]]
        [[(DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "parent"]]), (XUpgrade (XField XSelf, "parent")), [[DoExpr (XMethod (XVar "parent"), m, args)]], [[]])]]
    SkCycle job, again, res:
        let more = [[DoExpr (XMethod (XField XSelf, "{job}"), "set", [[(XVar "next"), XCx]]), DoExpr (XMethod (XField XSelf, "{again}"), "arm", [[XUnit, (XClone XSelf), XCx]])]]
        let fin = [[(SelfCall (GnOf sk.wx, res).name, [[(XVar "b")]])]]
        [[(DoMatch (XMethod (XMethod (XField XSelf, "{job}"), "get", [[XCx]]), "cycle", [[]]), [[(((PaCtor (RefRuntime "prism_rtl::Turn::More"), [[PaBind "next"]]), more)), (((PaCtor (RefRuntime "prism_rtl::Turn::Finished"), [[PaBind "b"]]), fin))]])]]

# The height twin of a firing's sink (claude/backend.md, "Heights across nodes"): where a
# firing at global height `h` goes, every combinator it reaches is put above `h`, and a
# port it fires straight through is raised to `h`. A combinator that moved tells its own
# twin its new height. A hosted place's request tells its host (`Host::request_above`). A
# sink whose firing lands in a later tick (`@Defer`, `@Later`) or at the World (the root's
# result, a request that goes out) ends the walk.
SinkAbove: fn Sinks, Sk, Ex -> [Do]
fn SinkAbove sk, target, h = match target:
    SkNode m: [[(AboveCall XSelf, (GnOf sk.wx, m).name, h)]]
    SkIn m, ignore: CombinatorAbove sk, (GnOf sk.wx, m), h
    SkHold f: HoldAbove sk, f, h
    SkDistinct f: HoldAbove sk, f, h
    SkPerKey f: HoldAbove sk, f, h
    # a hosted place's request: its host's twin, which raises its rows' request ports
    SkRequest pos, ignore: if Emits sk.wx, pos: [[]] else: [[DoExpr (XMethod (HostFieldEx sk.wx, pos), "request_above", [[h]])]]
    SkResult: [[]]
    SkArm ignore: [[]]
    SkLater ignore: [[]]
    SkMachine f, ignore, out: Push (MovedAbove sk, (OwnRead f), h), (AboveCall XSelf, (GnOf sk.wx, out).name, h)
    SkPort f: [[DoExpr (XMethod (XField XSelf, "{f}_port"), "raise", [[h]])]]
    SkUp m: [[(DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "parent"]]), (XUpgrade (XField XSelf, "parent")), [[(AboveCall (XVar "parent"), m, h)]], [[]])]]
    SkCycle ignore, ignore, res: [[(AboveCall XSelf, (GnOf sk.wx, res).name, h)]]

# A method's height twin called: `m_above(h)`.
AboveCall: fn Ex, Text, Ex -> Do
fn AboveCall receiver, m, h = DoExpr (XMethod receiver, "{m}_above", [[h]])

# A combinator reached by a firing at global height `h`: put above it, and when that
# moved it, what it fires told its new height (`Heights::raise`, which calls the
# combinator's own twin with the new height and knows the walk is under way: a walk that
# comes back to a combinator it is still walking from is a prompt cycle across nodes,
# which the checker refuses, so the runtime panics with "a prismc bug" there and the
# stack does not overflow).
CombinatorAbove: fn Sinks, Gn, Ex -> [Do]
fn CombinatorAbove sk, g, h = [[(DoExpr (XMethod (XField XSelf, "heights"), "raise", [[(XIndex (CombinatorOf sk.combs, g)), h, (XClosure False, [[(PaTyped (PaBind "moved"), OutCount)]], (XMethod XSelf, "{g.name}_above", [[(XVar "moved")]]))]]))]]

# The twin of `HoldWritten`: a hold written at global height `h` puts the `!Updated` nodes
# over it above `h`, and tells the rows that hear the write.
HoldAbove: fn Sinks, Text, Ex -> [Do]
fn HoldAbove sk, f, h = Append (Fold sk.wx.rowMarks, [[]], \|acc, rm| Append acc, (RowAbove sk.wx, rm, (OwnRead f), h)), (MovedAbove sk, (OwnRead f), h)

# The twin of `MovedBy`: the `!Updated` nodes over a read written at global height `h`,
# and the update port of each dynamic over it that the node hands to another node (a
# dynamic answer, a dynamic passed whole, a row's dynamic result), raised to `h`: what
# follows that port elsewhere sits above the write.
MovedAbove: fn Sinks, Read, Ex -> [Do]
fn MovedAbove sk, r, h:
    let combinators = Fold (Filter sk.wx.gns, \|g| Moves r, g), [[]], \|acc, g| Append acc, (CombinatorAbove sk, g, h)
    let answers = Each (Filter sk.wx.dynAnswers, \|((ignore, rds))| HasRead (ReadsClosed sk.wx.dynReads, rds), r), \|((name, ignore))| DoExpr (XMethod (XField XSelf, "{name}_port"), "raise", [[h]])
    Append combinators, answers

# The twin of `RowWritten`: the rows that hear a write of the block at global height `h`
# are told it through the block's port for that name, raised: a `for`'s row, a
# generation and a blueprint value's row each subscribe to it with their twin
# (`GenHears`), so a row built after the write took its height is told it as it
# subscribes (`Port::subscribe_above`), as the rows that live are told at the raise.
RowAbove: fn Wx, RowMarks, Read, Ex -> [Do]
fn RowAbove wx, rm, r, h:
    let hit = Filter (Append rm.wrote, rm.builds), \|m| HasRead (ReadsClosed wx.dynReads, [[OwnRead m]]), r
    Each hit, \|m| DoExpr (XMethod (XField XSelf, "{rm.builder}_wrote_{m}_port"), "raise", [[h]])

# A method's height twin: `{name}_above(h)`, "something at global height `h` fires `name`".
AboveMethod: fn Text, [Do], Text -> MethDef
fn AboveMethod name, body, what = MethDef(name="{name}_above", recv=RecvRc, params=[[(("h", OutCount))]], cx=CxNone, ret=OutUnit, body=body, tail=(XUnit), doc="The height twin of `{name}`: {what} at global height `h`; every combinator that reaches sits above `h`.")

# What a write of hold `f` (or of the pseudo-hold behind a host's document, `host_k_doc`,
# when a node of the hosted child wrote behind it) marks, after the `set` (claude/backend.md,
# "Marks"): the node is dirtied when a place reads it; a hosted node tells its host that a
# place of its may have moved (`document_moved`); the builders and generations over it are
# listed for the build; the rows of its `for`s that read it are dirtied and told; the
# "updated" nodes over it are told and the wake asked. The `set` is the caller's: an answer
# or a push at a place writes the place's hold the same way (`DynPlaceWrite`).
HoldWritten: fn Sinks, Text -> [Do]
fn HoldWritten sk, f:
    let r = OwnRead f
    let readByPlace = HasRead sk.dirty, r
    # a place that reads it is sent again in the patch pass: to the World, or, a hosted
    # place, into its entry of its host's document (`$(Path ==> $Elem c)`)
    let dirty = if readByPlace: [[DoExpr (XMethod (XCx), "dirty", [[(XClone XSelf)]])]] else: [[]]
    let told = [[]]
    let stales = Fold sk.wx.genHolds, [[]], \|acc, ((gname, hs))| if HasRead (ReadsClosed sk.wx.dynReads, hs), r: Push acc, (DoExpr (XMethod (XField XSelf, "{gname}_stale"), "set", [[(XBool True)]])) else: acc
    let rowMarks = Fold sk.wx.rowMarks, [[]], \|acc, rm| Append acc, (RowWritten sk.wx, rm, r)
    let builds = (HasRead sk.builds, r) or (Len stales) > 0
    # the build is listed once: here, or by the marks when a snapshot is marked
    let rebuildIt = if builds and not (ListsBuild sk, r): Append stales, [[DoExpr (XMethod (XCx), "build_later", [[(XClone XSelf)]])]] else: stales
    # a row whose result its block gathers tells the block when a hold behind the result moves
    let gathered = Fold sk.wx.resultMoved, [[]], \|acc, ((m, rds))| if HasRead rds, r: Push acc, (DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "parent"]]), (XUpgrade (XField XSelf, "parent")), [[DoExpr (XMethod (XVar "parent"), m, [[XCx]])]], [[]]) else: acc
    Append (Append (Append (Append (Append dirty, told), rebuildIt), rowMarks), gathered), (MovedMarks sk, f)

# The host whose document a position's place is an entry of, as the methods spell it: the
# host of its scope, or for a node's own places in a hosted scope the enclosing host.
HostFieldEx: fn Wx, Pos -> Ex
fn HostFieldEx wx, pos = XField XSelf, (HostLocal wx, pos)

# A hold written: every "updated" node whose dynamic reads it is told (its `_moved` flag),
# and the wake asked at its height, once per height.
MovedMarks: fn Sinks, Text -> [Do]
fn MovedMarks sk, f = MovedBy sk, (OwnRead f)

# A write behind a read: the "updated" nodes over it told and the wake asked at their
# heights; the snapshots the write lies behind marked, and the build listed to take them.
MovedBy: fn Sinks, Read -> [Do]
fn MovedBy sk, r:
    let moved = Filter sk.wx.gns, \|g| Moves r, g
    let flags = Each moved, \|g| DoExpr (XMethod (XField XSelf, "{g.name}_moved"), "set", [[(XBool True)]])
    let marks = Each (SnapsBehind sk.wx, r), \|sn| DoExpr (XMethod (XField XSelf, "{sn.name}_snap"), "mark", [[XCx]])
    let listed = if ListsBuild sk, r: [[DoExpr (XMethod (XCx), "build_later", [[(XClone XSelf)]])]] else: [[]]
    # a host's dynamic answer over it: its port fired, so its blueprints push next tick
    let answers = Each (Filter sk.wx.dynAnswers, \|((ignore, rds))| HasRead (ReadsClosed sk.wx.dynReads, rds), r), \|((name, ignore))|
        let fire = DoExpr (XCall (HelperRef "no_fault"), [[(XMethod (XField XSelf, "{name}_port"), "fire", [[XUnit, XCx]])]])
        let stamp = DoExpr (XMethod (XField XSelf, "{name}_once"), "set", [[XUnit, XCx]])
        DoIf (XUnary OpNot, (XMethod (XField XSelf, "{name}_once"), "fired", [[XCx]])), [[stamp, fire]], [[]]
    # a `@Flatten` over a `rebuild`'s dynamic that moved: the adoption among the next tick's
    # first firings, which is owed (Semantics ch. 7)
    let adoptions = Each (Filter sk.wx.flattens, \|fl| fl.generation != "" and r == (OwnRead fl.outer)), \|fl| DoScope (Adoption fl)
    Append (Append (Append (Append (Append (Fold moved, flags, \|acc, g| Append acc, (AskWake sk, g)), marks), listed), answers), adoptions), (SourceMarks sk.wx, r)

# A write behind a `for`'s source marks the source's cache (gap SR): every write path, a
# hold's sink, an answer or push at a place, a snapshot's publication, the block's write
# a row hears, reaches here.
SourceMarks: fn Wx, Read -> [Do]
fn SourceMarks wx, r:
    let fors = Fold wx.builders, [[]], \|acc, b| if HasRead (ReadsClosed wx.dynReads, (Or wx.dynReads[b.source], [[]])), r: Push acc, (DoExpr (XMethod (XField XSelf, "{b.source}_cache"), "mark", [[XCx]])) else: acc
    # and every cached `let` the write lies behind, through any depth of `let`s
    Fold wx.letCaches, fors, \|acc, c| if HasRead (ReadsAll wx.dynReads, (Or wx.dynReads[c], [[]])), r: Push acc, (DoExpr (XMethod (XField XSelf, "{c}_cache"), "mark", [[XCx]])) else: acc

# Every read a read set reaches through the node's getters, to the end (a `let` of `let`s
# of any depth): the reads grow until a pass adds none, at most once per getter.
ReadsAll: fn (Text ==> [Read]), [Read] -> [Read]
fn ReadsAll dyn, reads = Fold (Range0 ((Size dyn) + 1)), reads, \|acc, ignore| Fold acc, acc, \|a, r| UnionReads a, (GetterReads dyn, r)

IsOwnRead: fn Read -> Bool
fn IsOwnRead r = match r:
    OwnRead ignore: True
    ParentRead ignore: False

# The snapshots a write behind a read marks: the structure itself (a host's `host_k_moved`
# writes behind `host_k_doc_now` with no hold), or one whose live reads reach it.
SnapsBehind: fn Wx, Read -> [SnapDef]
fn SnapsBehind wx, r = Filter wx.snaps, \|sn| r == (OwnRead sn.live) or HasRead (ReadsClosed wx.dynReads, [[OwnRead sn.live]]), r

# Whether a write behind a read lists the node's build through its marks: a snapshot marked.
ListsBuild: fn Sinks, Read -> Bool
fn ListsBuild sk, r = (Len (SnapsBehind sk.wx, r)) > 0

FiringCode: unbounded fn Sinks, Gn, Ex -> [Do]
fn FiringCode sk, g, x:
    let many = (Len g.outs) > 1 and not (IsCopy g.ty)
    let xv = if many: XClone x else: x
    Fold g.outs, [[]], \|acc, o| Append acc, (o.pipe xv, \|y| SinkCode sk, o.sink, y)

FinishNode: unbounded fn Wx, Text, [((Text, OutTy))], Bool -> NodeDef
fn FinishNode wx0, qk, params, isRow:
    # An "updated" node's reads, closed over the dynamic `let`s now that every line is in;
    # its height is one above the writers of those holds. The `for` rows are finished with
    # the block's heights known (pick RE), the gathers one above their rows'.
    let closedGns = Each wx0.gns, \|g| if g.kind == GnUpdated: WithReads g, (ReadsClosed wx0.dynReads, g.reads) else: g
    let ((rowDefs, gns2)) = FinishPending wx0, (Heights closedGns)
    let isGen = isRow and (Len (Filter wx0.fields, \|((f, ignore, ignore))| f == "key")) == 0
    let wx = update wx0:
        &_.gns <= Heights gns2
        &_.build <= Append &_.build, (UpdatedGaps wx0, closedGns)
        &_.rows <= Fold rowDefs, &_.rows, \|acc, rd| Append (Push acc, rd), rd.children
    let combs = Filter wx.gns, \|g| (IsComb g.kind) or g.kind == GnGather or g.kind == GnMergeList
    let wakes = (Len combs) > 0
    let live = Filter wx.places, \|p| p.getter != ""
    let rootReads = Fold wx.rootDyns, [[]], \|acc, ((ignore, rds, ignore))| UnionReads acc, (ReadsClosed wx.dynReads, rds)
    let dirtyHolds = Fold live, rootReads, \|acc, p| UnionReads acc, (ReadsClosed wx.dynReads, p.reads)
    let buildHolds = ReadsClosed wx.dynReads, wx.buildHolds
    let sinks = Sinks(wx=wx, dirty=dirtyHolds, builds=buildHolds, combs=combs)
    let evMethods = Each (Filter wx.gns, \|g| g.kind != GnNever), \|g| MethDef(name=g.name, recv=RecvRc, params=[[(("v", g.ty))]], cx=CxMut, ret=OutUnit, body=(FiringCode sinks, g, (XVar "v")), tail=(XUnit), doc=(GnDoc g))
    let gatherIns = Append (Each (Filter wx.gns, \|g| g.kind == GnGather), \|g| GatherIn sinks, g), (Each (Filter wx.gns, \|g| g.kind == GnMergeList), \|g| MergeListIn sinks, g)
    # each event method's height twin, written from the same sinks as its firing; a
    # gather's and a `!MergeAll` list's input put the combinator above what fires it
    let evAbove = Each (Filter wx.gns, \|g| g.kind != GnNever), \|g| AboveMethod g.name, (Fold g.outs, [[]], \|acc, o| Append acc, (SinkAbove sinks, o.sink, (XVar "h"))), "`!{g.name}` fires"
    let inAbove = Each (Filter wx.gns, \|g| g.kind == GnGather or g.kind == GnMergeList), \|g| AboveMethod "{g.name}_in", (CombinatorAbove sinks, g, (XVar "h")), "an input of `{g.name}` fires"
    # the end of the build: each combinator tells what it fires its height, so what it
    # feeds in other nodes sits above it
    let announced = Each combs, \|g| AboveCall (XVar "node"), g.name, (XMethod (XField (XVar "node"), "heights"), "of", [[(XIndex (CombinatorOf combs, g))]])
    let placeGetters = Each live, \|p| MethDef(name=p.getter, recv=RecvRef, params=[[]], cx=CxRef, ret=elemTy, body=[[]], tail=p.level, doc="Place {PlaceText p.pos}'s level, read at the read point.")
    # the wake decides each combinator asked whose height has come, lowest first, then asks
    # for a wake for the lowest still asked (`Heights::again`)
    let wakeBody = if wakes: [[(WakeByHeight combs), (DoExpr (XMethod (XField XSelf, "heights"), "again", [[XCx, (XClone XSelf)]]))]] else: [[]]
    let startedBody = Each wx.started, \|st| SelfCall (GnOf wx, st).name, [[XUnit]]
    let deferredBody = Each wx.defers, \|((f, id))| DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "v"]]), (XMethod (XField XSelf, "{f}"), "fired", [[XCx]]), [[(SelfCall (GnOf wx, id).name, [[(XVar "v")]])]], [[]]
    # the patch pass sends the World the places that go to it, and takes the entry of each
    # hosted place in its host's document (`$(Path ==> $Elem c)`)
    let patchBody0 = Fold live, [[]], \|acc, p| Append acc, (if Emits wx, p.pos: PatchPlace wx, p else: [[(EntryTake XSelf, p)]])
    let patchBody = Append patchBody0, (RootDynPatch wx)
    # a generation builds only while it stays current (`GenCurrent`)
    let buildSteps = BuildSteps sinks, False
    let buildBody = if wx.genOf == "" or (Len buildSteps) == 0: buildSteps else: [[(DoIf (XMethod (XSelf), "current", [[]]), buildSteps, [[]])]]
    # (a place that asks its first value late keeps its element in a cell, empty until
    # then: `LateAskedPlace`)
    let PlaceElementIs = \|f| if HasText wx.lateElements, f: XBin OpEq, (XCtor (RefRuntime "std::Some"), [[(XVar "element")]]), (XMethod (XMethod (XField XSelf, "{f}_element"), "borrow", [[]]), "as_ref", [[]]) else: XBin OpEq, (XVar "element"), (XRef (XField XSelf, "{f}_element"))
    let pushBody0 = Each (Filter wx.dynPlaces, \|((pos, ignore, ignore, ignore))| Emits wx, pos), \|((pos, f, t, ignore))| DoIf (PlaceElementIs f), (DynPlaceWrite sinks, f, (XDecode t, (XVar "v"))), [[]]
    # and a bundle's place with `$` parts: the push is its whole state (`BundleStateWrite`)
    let pushBody = Append pushBody0, (Each (Filter wx.bundles, \|bp| bp.stem != "" and Emits wx, bp.pos), \|bp| DoIf (XBin OpEq, (XVar "element"), (XRef (XField XSelf, "{bp.stem}_element"))), (BundleStateWrite sinks, bp, (XDecode bp.stateTy, (XVar "v"))), [[]])
    # the node leaves: each live dynamic of its own holds keeps the hold's value after this
    # tick (`holdsLast`), what it reads once the node is gone
    let leaveBody = Each wx.holdsLast, \|name| DoAssign (XDeref (XMethod (XField XSelf, "{name}_last"), "borrow_mut", [[]])), (XCtor (RefRuntime "std::Some"), [[(XMethod XSelf, name, [[XCx]])]])
    let hooks = Filter [[(("wake", wakeBody)), (("started", startedBody)), (("deferred", deferredBody)), (("build", buildBody)), (("swap", (SwapBody wx))), (("leave", leaveBody)), (("push", pushBody)), (("patch", patchBody))]], \|((ignore, b))| (Len b) > 0
    let startedReg = if (Len wx.started) > 0: [[DoExpr (XMethod (XCx), "on_started", [[(XClone (XVar "node"))]])]] else: [[]]
    # the hosts linked to the node, then the builders and the snapshots (a place over a
    # structural dynamic reads its snapshot at the build), then the places out
    let links = Each wx.hosts, \|h| DoExpr (XMethod (XField (XVar "node"), "{h.name}"), "link", [[(XRef (XVar "node"))]])
    # (a block whose split line's rows are built before its other generations and
    # numbered where their place comes, `LateGiving`: those rows built at once, then
    # every step in the order of the places, those rows numbered at theirs; the block
    # is numbered from then on, `LateRowSelect`)
    let givesUnnumbered = (not wx.lateGens) and (Len (Filter wx.gens, \|gd| HasText wx.lateRowGens, gd.name)) > 0
    let rowsBuilt = Append links, (if givesUnnumbered: Append (Append (BuildSteps (PhaseOf sinks, 1), True), (BuildSteps (PhaseOf sinks, 2), True)), [[(DoExpr (XMethod (XField (XVar "node"), "numbered"), "set", [[(XBool True)]]))]] else: BuildSteps sinks, True)
    let subscribed = Each wx.subs, \|((ev, m, t))| DoExpr (XCall (HelperRef "subscribe_row"), [[(XRef (XVar "node")), (XUpgrade (XField (XVar "node"), "parent")), (XClosure False, [[PaBind "p"]], (XRef (XField (XVar "p"), "{ev}_port"))), (XClosure False, [[PaBind "n", PaBind "v", PaBind "cx"]], (XMethod (XVar "n"), m, [[XClone (XVar "v"), XCx]])), (HeardAbove m), (XRef (XField (XVar "node"), "{m}_sub"))]])
    # the World's answers, by path, to the places that go to it; a hosted place is answered
    # typed by its host, through `host_k_answer` (the places of scope `k`) or `deliver` (a
    # hosted node's own)
    let answers0 = Append (Each (Filter wx.answers, \|((pos, ignore, ignore, ignore))| Emits wx, pos), \|((pos, id, t, ignore))| AnswerArm wx, pos, id, t), (Each (Filter wx.dynPlaces, \|((pos, ignore, ignore, ignore))| (Emits wx, pos) and not (Fold wx.answers, False, \|seen, ((apos, ignore, ignore, ignore))| seen or apos == pos)), \|((pos, f, t, ignore))| DynAnswerArm sinks, pos, f, t)
    # and a bundle's place: its event parts' answer, or with none its state
    let answers = Append answers0, (Each (Filter wx.bundles, \|bp| (Emits wx, bp.pos) and ((Len bp.events) > 0 or bp.stem != "")), \|bp| BundleAnswerArm sinks, bp)
    let forwards = Append (Each (Filter wx.builders, \|b| Emits wx, b.pos), \|b| (((PosPat b.pos, keyTail), (ForwardAnswer b)))), (Fold (Filter wx.gens, \|gd| Emits wx, gd.pos), [[]], \|acc, gd| Append acc, (GenForwards gd))
    let hostMethods = Fold wx.hosts, [[]], \|acc, h| Append acc, [[(TypedDispatch sinks, "{h.name}_answer", h.scope), (HostMoved sinks, h)]]
    let gathered = Filter wx.snaps, \|sn| not (sn.before or (IsGeneration wx, sn.builder))
    let gatheredMoved = Append (Append (Each gathered, \|sn| GatheredMoved sn), (Each wx.snaps, \|sn| SnapPublish sinks, sn)), (FlattenMethods sinks)
    let hostedMethods = match wx.?hostedBy:
        ? ignore: [[(TypedDispatch sinks, "deliver", 0), (DocumentGetter wx)]]
        nil: [[]]
    let movedMethod = match wx.?hostedBy:
        ? m: [[DocumentMoved m]]
        nil: [[]]
    let rowMethods = if isRow: RowMethods wx else: [[]]
    # a row's own builders and `rebuild`s over what the block wrote are listed for the
    # build, as a hold's write lists them (`HoldWritten`), once: a `rebuild` whose source
    # reads the block's hold is marked stale and rebuilt (`sem-ch04-for-replaced-inner`)
    let HeardBuild = \|m|
        let stales = Fold wx.genHolds, [[]], \|acc, ((gname, hs))| if HasRead (ReadsClosed wx.dynReads, hs), (ParentRead m): Push acc, (DoExpr (XMethod (XField XSelf, "{gname}_stale"), "set", [[(XBool True)]])) else: acc
        let builds = (HasRead sinks.builds, (ParentRead m)) or (Len stales) > 0
        if builds and not (ListsBuild sinks, (ParentRead m)): Append stales, [[DoExpr (XMethod (XCx), "build_later", [[(XClone XSelf)]])]] else: stales
    let heard = Each (RowHears wx), \|m| MethDef(name="parent_wrote_{m}", recv=RecvRc, params=[[]], cx=CxMut, ret=OutUnit, body=(Append (Append (MovedBy sinks, (ParentRead m)), (HeardBuild m)), (Fold wx.rowMarks, [[]], \|acc, rm| Append acc, (RowWritten wx, rm, (ParentRead m)))), tail=(XUnit), doc="The block wrote behind its `{m}`, which this row reads through the parent: the `!Updated` nodes over it are told and the wake asked at their heights; the row's own builders over it are listed for the build; the rows of this row's own `for`s that read it are marked.")
    let heardAbove = Each (RowHears wx), \|m| AboveMethod "parent_wrote_{m}", (Append (MovedAbove sinks, (ParentRead m), (XVar "h")), (Fold wx.rowMarks, [[]], \|acc, rm| Append acc, (RowAbove wx, rm, (ParentRead m), (XVar "h")))), "the block writes behind its `{m}`"
    let top = Fold wx.gns, 0, \|hi, g| Max hi, g.height
    let wakesField = if wakes: [[(("heights", (OutNamed (RefRuntime "rt::Heights"), [[]]), "each combinator's global height, and the combinators asked for this tick, lowest first"))]] else: [[]]
    let wakesInit = if wakes: [[(("heights", (XCall (RefRuntime "rt::Heights::new"), [[(XVec (Each combs, \|g| XIndex g.height))]])))]] else: [[]]
    let genFields = Fold wx.gens, [[]], \|acc, gd| Append acc, (Append [[((gd.name, (OutCell (OutOpt (OutObj (OutNamed (RefRuntime "rt::Row"), [[]])))), "the current generation of the `rebuild` at place {PlaceText gd.pos}")), (("{gd.name}_count", (OutNamed (RefRuntime "std::Cell"), [[OutCount]]), "how many generations it has built")), (("{gd.name}_stale", (OutNamed (RefRuntime "std::Cell"), [[OutBool]]), "its source changed since it was built"))]], (if gd.gappy: [[(("{gd.name}_gap", (OutNamed (RefRuntime "std::Cell"), [[OutCount]]), "how many of its positions the chosen row left unbuilt"))]] else: [[]]))
    # an early generation (`GenDef.early`) is the row the build made
    let genInits = Fold wx.gens, [[]], \|acc, gd| Append acc, (Append [[((gd.name, (XCall (RefRuntime "std::RefCell::new"), [[(if gd.early: XCtor (RefRuntime "std::Some"), [[(XVar "{gd.name}_row")]] else: XNone)]]))), (("{gd.name}_count", (XCall (RefRuntime "std::Cell::new"), [[XIndex (if gd.early: 1 else: 0)]]))), (("{gd.name}_stale", (XCall (RefRuntime "std::Cell::new"), [[XBool False]])))]], (if gd.gappy: [[(("{gd.name}_gap", (XCall (RefRuntime "std::Cell::new"), [[(if gd.early: XVar "{gd.name}_gap_now" else: XIndex 0)]])))]] else: [[]]))
    let portFields = Each wx.ports, \|pn| (("{pn}_port", (OutPort (GnTyNamed wx, pn)), "`!{pn}`, which rows subscribe to"))
    let portInits = Each wx.ports, \|pn| (("{pn}_port", (XCall (RefRuntime "rt::Port::new"), [[]])))
    let subFields = Each wx.subs, \|((ev, m, t))| (("{m}_sub", (OutNamed (RefRuntime "std::Cell"), [[(OutOpt (OutNamed (RefRuntime "rt::Handle"), [[]]))]]), "the subscription to the parent's `!{ev}`"))
    let subInits = Each wx.subs, \|((ev, m, t))| (("{m}_sub", (XCall (RefRuntime "std::Cell::new"), [[XNone]])))
    let fallible = wx.fallible or isRow or (Len wx.builders) > 0 or (Len wx.gens) > 0
    # a row that builds its generations before it is numbered (`Wx.lateGens`): the step
    # that numbers each generation's row, left by the row (`NumberedByParent`), and
    # whether the row itself is numbered yet
    let lateRows = Filter wx.gens, \|gd| HasText wx.lateRowGens, gd.name
    let numberFields = Append (Each lateRows, \|gd| (("{gd.name}_number", (OutCell (OutOpt laterTy)), "what numbers the current row of `{gd.name}`, until this row is numbered itself"))), (if wx.lateGens or givesUnnumbered: [[(("numbered", (OutNamed (RefRuntime "std::Cell"), [[OutBool]]), "whether the row is numbered yet"))]] else: [[]])
    let numberInits = Append (Each lateRows, \|gd| (("{gd.name}_number", (XCall (RefRuntime "std::RefCell::new"), [[XNone]])))), (if wx.lateGens or givesUnnumbered: [[(("numbered", (XCall (RefRuntime "std::Cell::new"), [[XBool False]])))]] else: [[]])
    # (the links, the generations built at once and the row's own step left with its
    # block stand outside what waits for the row's number, `LateGenerations`)
    let nowSteps = if wx.lateGens: BuildSteps (PhaseOf sinks, 1), True else: [[]]
    let laterSteps = if wx.lateGens: BuildSteps (PhaseOf sinks, 2), True else: [[]]
    let lateGenerations = Append (Append (Append (Filter wx.build, IsOwnerLink), links), (LateNumbering (Append (Append (Append (Append laterSteps, (Filter wx.build, \|d| not (IsOwnerLink d))), subscribed), announced), startedReg))), nowSteps
    # what the build does once the node is made
    let afterNode = Append (Append (Append (Append (Append (Filter wx.build, IsOwnerLink), rowsBuilt), (Filter wx.build, \|d| not (IsOwnerLink d))), subscribed), announced), startedReg
    NodeDef(name=wx.node, prism=(BareName qk), doc=(DefinitionText wx.lx, qk), params=params, fields=(Append (Append (Append (Append (Append wx.fields, wakesField), genFields), portFields), subFields), numberFields), consts=[[]], lets=wx.lets, inits=(Append wx.inits, (Append (Append (Append (Append wx.moves, wakesInit), genInits), portInits), (Append subInits, numberInits))), build=(Append (if wx.lateGens: lateGenerations else: if wx.baseLate: LateNumbering afterNode else: afterNode), wx.numberedBy), fallible=fallible, methods=(Append (if wx.baseLate: [[(NumberPlaces wx)]] else: [[]]), (Append (Append (Append (Append (Append (Append (Append (Append (Append (Append (Append evMethods, evAbove), gatherIns), inAbove), heardAbove), placeGetters), wx.getters), rowMethods), heard), hostMethods), gatheredMoved), (Append movedMethod, (PlaceMethods wx)))), answers=(Append (Append answers, forwards), (WideForward (Filter wx.gens, \|gd| (IsWideGen gd) and Emits wx, gd.pos))), hooks=hooks, builders=wx.builders, wakes=wakes, children=wx.rows, gens=(Each wx.gens, \|gd| if HasText wx.lateRowGens, gd.name: LateRowSelect gd else: gd), subs=wx.subs, top=top, rowKind=(if isRow: (if isGen: GenerationRow else: ForRow) else: NotARow), hosted=hostedMethods)

IsGeneration: fn Wx, Text -> Bool
fn IsGeneration wx, name = (Len (Filter wx.gens, \|gd| gd.name == name)) > 0

# The height twin of a method a `Follow` calls when a dynamic the node holds as a value
# moved (`{name}_result_moved`, a flatten's `{name}_moved`), whose body is `HoldWritten` of
# the pseudo-hold `held` behind it: the twin is `HoldAbove` of the same, passed to
# `Follow::follow_above` beside the method.
MovedTwin: fn Sinks, Text, Text -> MethDef
fn MovedTwin sk, method, held = AboveMethod method, (HoldAbove sk, held, (XVar "h")), "the dynamic's update event fires"

# The flattens' methods (`FlattenLine`, `EntryFlatten`): each adoption, the current inner
# written as a hold is; and per `rebuild` handing back a dynamic, what its current
# generation's result moving marks: the readers of every `@Flatten` over it, as for a write
# of the inner (a flatten whose inner is another generation reads its value again,
# unchanged).
FlattenMethods: fn Sinks -> [MethDef]
fn FlattenMethods sk:
    let wx = sk.wx
    # a row's entry flattened (`for k, $v <- $(k ==> $v)`, ruling FV): the inner's move; the
    # `for`'s builder telling the row that the dynamic under its kept key was replaced,
    # which queues the adoption for the start of the next tick, owed (rulings VL, TK); and
    # the adoption itself
    let entries = Fold (Filter wx.flattens, \|fl| fl.generation == "" and not fl.held), [[]], \|acc, fl|
        let set = DoExpr (XMethod (XField XSelf, "{fl.name}_inner"), "set", [[(XCtor (RefRuntime "std::Some"), [[(XMethod (XSelf), "entry", [[XCx]])]]), XCx]])
        let followed = DoExpr (XMethod (XField XSelf, "{fl.name}_follow"), "follow_above", [[(XRef (XField (XMethod (XSelf), "entry", [[XCx]]), "updates")), (XRef (XClone XSelf)), (XPath (RefChild (SiteRef wx.lx, wx.node), "{fl.name}_moved")), (XPath (RefChild (SiteRef wx.lx, wx.node), "{fl.name}_moved_above"))]])
        let moved = MethDef(name="{fl.name}_moved", recv=RecvRc, params=[[]], cx=CxMut, ret=OutUnit, body=(HoldWritten sk, "{fl.name}_inner"), tail=(XUnit), doc="`{fl.name}`'s inner moved: what reads it reads it again.")
        let replaced = MethDef(name="{fl.name}_replaced", recv=RecvRc, params=[[]], cx=CxMut, ret=OutUnit, body=(Adoption fl), tail=(XUnit), doc="The `for`'s builder found another dynamic than `{fl.name}`'s inner under this row's key: the adoption is queued for the first firings of the next tick, which is owed (Semantics ch. 4).")
        let adopt = MethDef(name="{fl.name}_adopt", recv=RecvRc, params=[[]], cx=CxMut, ret=OutUnit, body=(Append [[set, followed]], (HoldWritten sk, "{fl.name}_inner")), tail=(XUnit), doc="`{fl.name}` adopts the dynamic under its row's key as the tick before left it, among this tick's first firings: from here on it reads that inner (Semantics ch. 4).")
        Append acc, [[moved, (MovedTwin sk, "{fl.name}_moved", "{fl.name}_inner"), replaced, adopt]]
    let adopts0 = Each (Filter wx.flattens, \|fl| fl.generation != ""), \|fl|
        let set = DoExpr (XMethod (XField XSelf, "{fl.name}_inner"), "set", [[(XCtor (RefRuntime "std::Some"), [[(XMethod (XSelf), fl.outer, [[XCx]])]]), XCx]])
        MethDef(name="{fl.name}_adopt", recv=RecvRc, params=[[]], cx=CxMut, ret=OutUnit, body=(Append [[set]], (HoldWritten sk, "{fl.name}_inner")), tail=(XUnit), doc="`@Flatten` adopts the inner its `rebuild`'s dynamic held after the tick before, among this tick's first firings: from here on it reads that inner (Semantics ch. 7).")
    # any other `$$a` flattened (`HeldFlatten`): the inner's move, the outer's move, which
    # queues the adoption for the next tick's first firings, owed, and the adoption
    let held = Fold (Filter wx.flattens, \|fl| fl.held), [[]], \|acc, fl|
        let innerNow = XMethod (XMethod (XField XSelf, "{fl.name}_inner"), "get", [[XCx]]), "expect", [[(XStr "`@Flatten` adopts its first inner at the build")]]
        let set = DoExpr (XMethod (XField XSelf, "{fl.name}_inner"), "set", [[(XCtor (RefRuntime "std::Some"), [[(XMethod (XField XSelf, fl.outer), "sample", [[XCx]])]]), XCx]])
        let followed = DoExpr (XMethod (XField XSelf, "{fl.name}_follow"), "follow_above", [[(XRef (XField innerNow, "updates")), (XRef (XClone XSelf)), (XPath (RefChild (SiteRef wx.lx, wx.node), "{fl.name}_moved")), (XPath (RefChild (SiteRef wx.lx, wx.node), "{fl.name}_moved_above"))]])
        let moved = MethDef(name="{fl.name}_moved", recv=RecvRc, params=[[]], cx=CxMut, ret=OutUnit, body=(HoldWritten sk, "{fl.name}_inner"), tail=(XUnit), doc="`{fl.name}`'s inner moved: what reads it reads it again.")
        let outerMoved = MethDef(name="{fl.name}_outer_moved", recv=RecvRc, params=[[]], cx=CxMut, ret=OutUnit, body=(Adoption fl), tail=(XUnit), doc="`{fl.name}`'s outer fired: the adoption is queued for the first firings of the next tick, which is owed (the Compiler seed, `@Flatten`).")
        let adopt = MethDef(name="{fl.name}_adopt", recv=RecvRc, params=[[]], cx=CxMut, ret=OutUnit, body=(Append [[set, followed]], (HoldWritten sk, "{fl.name}_inner")), tail=(XUnit), doc="`{fl.name}` adopts the inner its outer held after the tick before, among this tick's first firings, and fires: no dynamics are compared (ruling FV).")
        Append acc, [[moved, (MovedTwin sk, "{fl.name}_moved", "{fl.name}_inner"), outerMoved, adopt]]
    let adopts = Append (Append adopts0, entries), held
    # a `rebuild`'s current generation's result moved: the readers of every `@Flatten` over
    # it in this node, and the update event of the dynamic the block keeps for it, which a
    # reader outside the node follows (a `for` gathering `$$r`s into `$(k ==> $r)`, whose
    # rows' `$v` follow their inners: `sem-ch04-for-replaced-inner`)
    # (a generation's plain result stands while the generation does: nothing to follow)
    let dynGens = Filter wx.gens, \|gd| (Len (Filter wx.snaps, \|sn| sn.builder == gd.name and IsDynTy sn.ty)) > 0
    let moved = Each dynGens, \|gd|
        let marks = Fold (Filter wx.flattens, \|fl| fl.generation == gd.name), [[]], \|acc, fl| Append acc, (HoldWritten sk, "{fl.name}_inner")
        let live = XMethod (XMethod (XField XSelf, "{gd.name}_result_live"), "borrow", [[]]), "as_ref", [[]]
        let port = XField (XVar "d"), "updates"
        let fire = XCall (HelperRef "no_fault"), [[(XMethod port, "fire", [[XUnit, XCx]])]]
        let fired = DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "d"]]), live, [[(DoExpr fire)]], [[]]
        MethDef(name="{gd.name}_result_moved", recv=RecvRc, params=[[]], cx=CxMut, ret=OutUnit, body=(Push marks, fired), tail=(XUnit), doc="The current generation's result moved: what reads a `@Flatten` over it reads it again, and the dynamic kept for it fires its update event for whoever follows it outside this node.")
    # a static clause widget's dynamic result moved (`DynClauseLine`): its readers here
    let clauseMoved = Fold wx.clauseResults, [[]], \|acc, n| Append acc, [[(MethDef(name="{n}_result_moved", recv=RecvRc, params=[[]], cx=CxMut, ret=OutUnit, body=(HoldWritten sk, "{n}_res"), tail=(XUnit), doc="A write behind the clause's dynamic result: what reads it reads it again.")), (MovedTwin sk, "{n}_result_moved", "{n}_res")]]
    Append (Append adopts, moved), clauseMoved

IsDynTy: fn OutTy -> Bool
fn IsDynTy (OutDyn ignore) = True
fn IsDynTy other = False

# A node of the hosted child wrote behind the host's document (a row's own hold): what a
# write of a hold the document reads marks, with no hold set (`HoldWritten` of the getter,
# whose reads are the child's).
HostMoved: fn Sinks, HostDef -> MethDef
fn HostMoved sk, h = MethDef(name="{h.name}_moved", recv=RecvRc, params=[[]], cx=CxMut, ret=OutUnit, body=(HoldWritten sk, "{h.name}_doc_now"), tail=(XUnit), doc="A node of the child hosted at place {PlaceText h.pos} wrote behind its document: the structure is marked as for a write of a hold it reads (pick HO), the snapshot listed to be taken; the program's `$doc` moves when it is published, the tick after (pick ST).")

# The construction step of the node (pick ST): the builders and generations scope by scope,
# a hosted child's before its host's (a host's `for` over `$doc` runs after the child's own
# structure has settled, in the one `build` of the node they are inlined into; siblings keep
# their order), with each structural dynamic's snapshot taken where the structure behind it
# has settled: a host's `$doc` before the host's `for` over it builds its rows, a `for`'s
# gathered dynamic after its builder. In the build (`atBuild`, spelled from `node`) every
# snapshot is taken; in `Node::build` a marked one is taken and compared, and one that moved
# is queued for publication.
BuildSteps: fn Sinks, Bool -> [Do]
fn BuildSteps sk, atBuild:
    let wx = sk.wx
    # a hosted scope whose host answers late (`Wx.lateHosts`) is built at its host's
    # line (`ScopeSteps`)
    Fold (Range0 ((Len wx.scopes) + 1)), [[]], \|acc, i|
        let k = Or ((Len wx.scopes) -? i), 0
        # (what a row that builds its generations before it is numbered does at once is
        # of its own scope, `Wx.genPhase`)
        # (a block whose split line's rows are numbered late, `LateGiving`, builds them
        # at once in every scope)
        if (HasNat wx.lateHosts, k) or (wx.genPhase == 1 and k != 0 and wx.lateGens): acc else: Append acc, (ScopeSteps sk, atBuild, k, ((Len wx.scopes) + 1))

# One scope's part of the construction step: its builders and generations in the order
# of their places, then (at the build) its live hosted places' entries. A host of the
# scope whose supplier answers with a dynamic that has no value while the node is being
# made (`Wx.lateHosts`: it reads a structural dynamic of the owner's) has its child's
# scope built here, where the step reaches the host's line, the builders above the host
# run and their snapshots taken (Semantics ch. 7, "Structural dynamics": a builder in a
# tick's construction step reads the value after it): the child's places ask their first
# values (`Wx.lateFirsts`, at the build), then the child's own steps, then the host's
# rows. `fuel` bounds the hosts inside hosts.
ScopeSteps: fn Sinks, Bool, Nat, Nat -> [Do]
fn ScopeSteps sk, atBuild, k, fuel = match fuel -? 1:
    nil: [[]]
    ? less:
        let wx = sk.wx
        let recv = if atBuild: XVar "node" else: XSelf
        let Take = \|sn| if atBuild: SnapTakeAtBuild sn else: SnapTake sk, sn
        let LateChild = \|b| Fold wx.hosts, [[]], \|a, h| if "{h.name}_rows" == b.name and HasNat wx.lateHosts, h.scope: Append (Append a, (if atBuild: (Fold (Append wx.lateFirsts, wx.lateStarts), [[]], \|firsts, ((scope, dos))| if scope == h.scope: Append firsts, dos else: firsts) else: [[]])), (ScopeSteps sk, atBuild, h.scope, less) else: a
        let Builder = \|b|
            let before = Each (Filter wx.snaps, \|sn| sn.before and sn.builder == b.name), Take
            let after = Each (Filter wx.snaps, \|sn| (not sn.before) and sn.builder == b.name), Take
            # (a host made at no place of its own is placed first, `Wx.unplacedHosts`)
            let placed = if not atBuild: [[]] else: Fold wx.hosts, [[]], \|a, h| if "{h.name}_rows" == b.name and HasText wx.unplacedHosts, h.name: Push a, (DoExpr (XMethod (XField recv, h.name), "place_at", [[(PlaceAt wx, "node", h.pos)]])) else: a
            if wx.genPhase == 1: [[]] else: Append placed, (Append (LateChild b), (Append (Push before, (DoExpr (TryOf (XMethod recv, "{b.name}_build", [[XCx]])))), after))
        # a `rebuild` handing back a dynamic: its snapshot taken after the generation is built
        let Gen = \|gd|
            # (an early generation is built already; one numbered late, `Wx.lateNumbered`,
            # sends its places here, the generations above it built)
            let built = if atBuild and gd.early: (if HasText wx.lateNumbered, gd.name: DoExpr (TryOf (XApply (XVar "{gd.name}_number"), [[XCx]])) else: DoExpr (XUnit)) else: if atBuild: DoExpr (TryOf (XMethod recv, "{gd.name}_build", [[XCx]])) else: DoIf (XMethod (XField XSelf, "{gd.name}_stale"), "replace", [[(XBool False)]]), [[DoExpr (TryOf (XMethod (XSelf), "{gd.name}_build", [[XCx]]))]], [[]]
            # (a row that builds its generations before it is numbered, `Wx.lateGens`:
            # at once the generations whose rows are numbered late, `Wx.lateRowGens`;
            # once it is numbered those rows' numbers, and every other step whole)
            let lateRow = (k == 0 or not wx.lateGens) and HasText wx.lateRowGens, gd.name
            if wx.genPhase == 1 and not lateRow: [[]]
            else: if wx.genPhase == 2 and lateRow: [[(NumberTaken recv, gd.name)]]
            else: Append [[built]], (Each (Filter wx.snaps, \|sn| (not sn.before) and sn.builder == gd.name), Take)
        # at the build, a scope's live hosted places take their entries once its builders and
        # generations have run (the structure they read has settled), before the host whose
        # child they are builds its rows over them
        let entries = if atBuild and wx.genPhase != 1: Each (Filter wx.places, \|pl| pl.pos.scope == k and pl.entry != "" and pl.getter != ""), \|pl| EntryTake recv, pl else: [[]]
        # a scope's builders and generations in the order of their places (ruling TC: places
        # are counted as they are built), so a `for` whose source reads the result of a
        # clause widget above it finds that generation built
        # a step whose build reads a structural dynamic of a builder or a generation
        # written below it (Semantics ch. 7, "Structural dynamics": a builder in a tick's
        # construction step reads the value after it; ch. 4: the order of a group's lines
        # decides positions and nothing else) is built once that one is: a late host whose
        # supplier answers with a `for`'s gathered result, so its child's first values
        # read every row of the build; a `for` or a generation whose source reads a
        # host's document or a gathered result, the host itself moved or not
        # (each step with its name, its place and what it waits for: the builders and
        # generations whose structural dynamics its build reads. A late host's rows read
        # what its answers read; a `for` reads its source; a generation its scrutinee)
        let HostReads = \|b| Fold wx.hosts, [[]], \|acc, h| if "{h.name}_rows" != b.name or not (HasNat wx.lateHosts, h.scope): acc else: Fold wx.dynAnswers, acc, \|acc2, ((name, reads))| if HasPrefix name, "{h.name}_dyn_": UnionReads acc2, reads else: acc2
        let SourceReads = \|name| Or wx.dynReads["{name}_source"], [[]]
        let GenReads = \|name| Fold wx.genHolds, [[]], \|acc, ((held, reads))| if held == name: UnionReads acc, reads else: acc
        let BuildersRead = \|reads| Fold (ReadsClosed wx.dynReads, reads), [[]], \|acc, r| match r:
            OwnRead f: Fold wx.snaps, acc, \|acc2, sn| if sn.name != f and sn.live != f: acc2 else: AddText acc2, sn.builder
            ParentRead ignore: acc
        # (a generation numbered late waits for the generations before it that are built
        # after the node, whose gaps its number counts; behind a deferred one it is
        # deferred too, in the order of the lines)
        let NumberedAfter = \|gd| if atBuild and HasText wx.lateNumbered, gd.name: Each (Filter (GapsBefore wx, gd.pos), \|other| (not other.early) or HasText wx.lateNumbered, other.name), \|other| other.name else: [[]]
        let Deferred = \|gd| (HasText wx.deferredGens, gd.name) or ((HasText wx.lateNumbered, gd.name) and (Len (Filter (GapsBefore wx, gd.pos), \|other| HasText wx.deferredGens, other.name)) > 0)
        # (and where the rows are built before they are numbered, `Wx.genPhase` 1, a line
        # that takes a split line's late result waits for that line's rows, `LateTaking`)
        let GiversOf = \|gd| if wx.genPhase != 1: [[]] else: Fold wx.lateTakings, [[]], \|acc, taking| if taking.taker == gd.name: Append acc, taking.givers else: acc
        let steps0 = Append (Each (Filter wx.builders, \|b| b.pos.scope == k), \|b| ((b.name, b.pos.at, 0, (BuildersRead (UnionReads (HostReads b), (SourceReads b.name))), (Builder b)))), (Each (Filter wx.gens, \|gd| gd.pos.scope == k and not (Deferred gd)), \|gd| ((gd.name, gd.pos.at, 0, (Fold (Append (NumberedAfter gd), (GiversOf gd)), (BuildersRead (GenReads gd.name)), AddText), (Gen gd))))
        # a step that reads the structure of another stands after it: at the other's
        # place, one rank on (so a chain keeps its order: the `for`, the late host that
        # answers with its result, the builder that reads the host's document)
        let Settle = \|steps| Each steps, \|((name, at, rank, waits, dos))|
            let ((at2, rank2)) = Fold steps, ((at, rank)), \|((a, r)), ((other, otherAt, otherRank, ignore, ignore))| if other == name or not (HasText waits, other): ((a, r)) else: if otherAt > a or (otherAt == a and otherRank >= r): ((otherAt, otherRank + 1)) else: ((a, r))
            ((name, at2, rank2, waits, dos))
        let steps = Fold (Range0 (Len steps0)), steps0, \|acc, ignore| Settle acc
        # a line that takes a late result at its build is built once every other
        # generation of the scope is, the one that gives the result among them
        # (`DeferredLine`)
        let deferred = Fold (Filter wx.gens, \|gd| gd.pos.scope == k and Deferred gd), [[]], \|a, gd| Append a, (Gen gd)
        let ordered = Fold (SortNats (Fold steps, [[]], \|seen, ((ignore, at, ignore, ignore, ignore))| if (Len (Filter seen, \|y| y == at)) == 0: Push seen, at else: seen)), [[]], \|a, at| Fold (Range0 ((2 * (Len steps)) + 2)), a, \|a1, rank| Fold steps, a1, \|a2, ((ignore, at2, rank2, ignore, dos))| if at2 == at and rank2 == rank: Append a2, dos else: a2
        Append (Append ordered, deferred), entries

# A hosted live place's entry taken, its level read from `recv` (the node in its build,
# `self` in the patch pass): compared with the one that stood, published the tick after if
# it moved (prism_rtl's `Entry::take`).
EntryTake: fn Ex, Place -> Do
fn EntryTake recv, pl = DoExpr (XMethod (XField recv, pl.entry), "take", [[(XMethod recv, pl.getter, [[XCx]]), XCx]])

# The snapshot taken at the build: the structure as built.
SnapTakeAtBuild: fn SnapDef -> Do
fn SnapTakeAtBuild sn = DoExpr (XMethod (XField (XVar "node"), "{sn.name}_snap"), "take", [[(XMethod (XVar "node"), "{sn.name}_now", [[XCx]]), XCx]])

# The snapshot taken in `Node::build` when a write marked it, compared where the type has
# equality: when it moved (or, without equality, whenever taken), its publication is queued
# for the start of the next tick, which is owed, once per tick.
SnapTake: fn Sinks, SnapDef -> Do
fn SnapTake sk, sn:
    let now = XMethod (XSelf), "{sn.name}_now", [[XCx]]
    let take = DoExpr (XMethod (XField XSelf, "{sn.name}_snap"), (if sn.eq: "take_compared" else: "take"), [[now, XCx]])
    let queue = DoExpr (XMethod (XCx), "answer_later", [[(XLater (XMethod (XVar "node"), "{sn.name}_publish", [[XCx]]))]])
    let queued = DoIf (XMethod (XField XSelf, "{sn.name}_snap"), "queue", [[XCx]]), [[(DoLet (PaBind "node"), (XClone XSelf)), queue]], [[]]
    DoIf (XMethod (XField XSelf, "{sn.name}_snap"), "marked", [[XCx]]), [[take, queued]], [[]]

# A structural dynamic published (pick ST), a first firing of the tick after its snapshot
# moved: the dynamic now answers that snapshot, and everything over it is marked as for a
# write of a hold, so its `!Updated` fires in this tick's wake with the new value while
# every sample in the tick reads the old one (R2/R3).
SnapPublish: fn Sinks, SnapDef -> MethDef
fn SnapPublish sk, sn = MethDef(name="{sn.name}_publish", recv=RecvRc, params=[[]], cx=CxMut, ret=OutUnit, body=[[(DoIf (XMethod (XField XSelf, "{sn.name}_snap"), "published", [[XCx]]), (HoldWritten sk, sn.name), [[]])]], tail=(XUnit), doc="{sn.what}, published: its snapshot of the tick before moved it, written as a hold is (pick ST).")

# A row's hold behind its gathered result moved (pick ST): the block marks the gathered
# dynamic's snapshot and lists its build to take it.
GatheredMoved: fn SnapDef -> MethDef
fn GatheredMoved sn = MethDef(name="{sn.name}_moved", recv=RecvRc, params=[[]], cx=CxMut, ret=OutUnit, body=[[(DoExpr (XMethod (XField XSelf, "{sn.name}_snap"), "mark", [[XCx]])), (DoExpr (XMethod (XCx), "build_later", [[(XClone XSelf)]]))]], tail=(XUnit), doc="A row's result moved: the `for`'s gathered dynamic is marked, and its snapshot taken after the builder (pick ST).")

# A hosted row's own places, for its host's document (`Row::document`): each place's entry
# by its path relative to the row, and under its `for`s and `rebuild`s their rows'.
DocumentGetter: fn Wx -> MethDef
fn DocumentGetter wx:
    let IsOwn = \|p| p.scope == 0
    let body = DocumentBody wx, VecPush, (Filter wx.places, \|pl| IsOwn pl.pos), (Filter wx.builders, \|b| IsOwn b.pos), (Filter wx.gens, \|gd| IsOwn gd.pos)
    MethDef(name="document", recv=RecvRef, params=[[]], cx=CxRef, ret=(OutNamed (RefRuntime "std::Vec"), [[(OutTuple [[OutPath, entryTy]])]]), body=(Append [[(DoLet (PaTyped (PaMut "doc"), (OutNamed (RefRuntime "std::Vec"), [[(OutTuple [[OutPath, entryTy]])]])), (XCall (RefRuntime "std::Vec::new"), [[]]))]], body), tail=(XVar "doc"), doc="The row's own places, entries of its host's document, by their paths relative to the row (pick HO).")

# A hosted row's place may have moved (a hold it reads was written): its parent is told,
# and tells its host in turn.
DocumentMoved: fn Text -> MethDef
fn DocumentMoved m = if m == sharedMoved: MethDef(name="document_moved", recv=RecvRc, params=[[]], cx=CxMut, ret=OutUnit, body=[[(DoExpr (XApply (XField XSelf, "moved"), [[XCx]]))]], tail=(XUnit), doc="A place of this row's may have moved: the node that built the row is told, through what it gave the row.") else: MethDef(name="document_moved", recv=RecvRc, params=[[]], cx=CxMut, ret=OutUnit, body=[[(DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "parent"]]), (XUpgrade (XField XSelf, "parent")), [[DoExpr (XMethod (XVar "parent"), m, [[XCx]])]], [[]])]], tail=(XUnit), doc="A place of this row may have moved: its host's document moved, and the host's readers and rows are marked (pick HO).")

# The entries of a document (`$(Path ==> $Elem c)`): each place's entry, and under each
# `for` and `rebuild` the rows' own documents, keyed under the place's path. `Add` spells
# the collection's insert of `path, e`: into the `doc` host document (`MapInsert`) or onto
# the `doc` vector (`VecPush`).
DocumentBody: fn Wx, (fn Ex, Ex -> Do), [Place], [ForDef], [GenDef] -> [Do]
fn DocumentBody wx, Add, places, builders, gens:
    let statics = Each places, \|pl| Add (XMethod (XCall (RefRuntime "rt::Path::root"), [[]]), "at", [[(PlaceNumber wx, "self", pl.pos)]]), (XClone (XField XSelf, pl.entry))
    # a host's own rows (prism_rtl's) give their forwarded places' entries
    let RowDoc = \|b| if HasPrefix b.rowNode, "prism_rtl::HostRow": XMethod (XVar "row"), "entries", [[XCx]] else: XMethod (XVar "row"), "document", [[XCx]]
    let rows = Each builders, \|b| DoFor (PaTuple [[PaBind "k", PaBind "row"]]), (XMethod (XMethod (XField XSelf, b.name), "borrow", [[]]), "iter", [[]]), [[(DoFor (PaTuple [[PaBind "p", PaBind "e"]]), (RowDoc b), [[(Add (XMethod (XMethod (XMethod (XCall (RefRuntime "rt::Path::root"), [[]]), "at", [[(PlaceNumber wx, "self", b.pos)]]), "child", [[(XCtor (RefRuntime "rt::Segment::Key"), [[(XMethod (XVar "k"), "to_pod", [[]])]])]]), "join", [[XRef (XVar "p")]]), (XVar "e"))]])]]
    # a transparent generation's places stand at the block's own positions (a static
    # widget of several clauses, a building `match`'s arm): their paths are the block's
    let GenPath = \|gd| if gd.transparent: XClone (XVar "p") else: XMethod (XMethod (XMethod (XCall (RefRuntime "rt::Path::root"), [[]]), "at", [[(PlaceNumber wx, "self", gd.pos)]]), "child", [[(XCtor (RefRuntime "rt::Segment::Gen"), [[XVar "g"]])]]), "join", [[XRef (XVar "p")]]
    let generations = Each gens, \|gd| DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "row"]]), (XMethod (XMethod (XField XSelf, gd.name), "borrow", [[]]), "as_ref", [[]]), [[(DoLet (PaBind "g"), (XBin OpSub, (XMethod (XField XSelf, "{gd.name}_count"), "get", [[]]), (XIndex 1))), (DoFor (PaTuple [[PaBind "p", PaBind "e"]]), (XMethod (XVar "row"), "document", [[XCx]]), [[(Add (GenPath gd), (XVar "e"))]])]], [[]]
    Append (Append statics, rows), generations

MapInsert: fn Ex, Ex -> Do
fn MapInsert path, e = DoExpr (XMethod (XVar "doc"), "insert", [[path, e]])

VecPush: fn Ex, Ex -> Do
fn VecPush path, e = DoExpr (XMethod (XVar "doc"), "push", [[XTuple [[path, e]]]])

# A World's answer at a place whose element answers a dynamic (a push, or an answer by
# path): the hold written from the plain data, the node patched.
DynAnswerArm: fn Sinks, Pos, Text, OutTy -> ((Pa, Ex))
fn DynAnswerArm sk, pos, f, t = (((PosPat pos, [[]]), (XBlock (DynPlaceWrite sk, f, (XDecode t, (XVar "v"))), (XUnit))))

# The write of a place's hold from the answer `value`: the hold set, and everything a
# hold's sink marks (the node patched, the builders and rows over it, the "updated" nodes
# over it told at height 0, before any wake, so the wake is only asked).
DynPlaceWrite: fn Sinks, Text, Ex -> [Do]
# (A late place's hold holds the present value, `LateFirstPlace`.)
fn DynPlaceWrite sk, f, value = Append [[DoExpr (XMethod (XField XSelf, "{f}"), "set", [[(if HasText sk.wx.latePlaces, f: XCtor (RefRuntime "std::Some"), [[value]] else: value), XCx]])]], (HoldWritten sk, f)

# What an "updated" node cannot be given: a read of anything that is not a hold a sink of
# this node writes, a dynamic `let` over such, a generation's dynamic result the node keeps
# (`KeptDyn`), or a structural dynamic of the node (its publication writes it as a hold,
# pick ST). A row's or a generation's reads through the
# parent are checked where the block is finished, as the block's own: a name the row hears a write behind must stand over a hold
# of the block, a structural dynamic of the block (published as a hold is written:
# `sem-ch04-row-updated-structural`) or a name the block hears itself. Anything else is a
# name the lowering bound to a reader the node does not have: an internal error rather
# than an event that never fires.
UpdatedGaps: fn Wx, [Gn] -> [Do]
fn UpdatedGaps wx, gns:
    let holds = Fold wx.fields, [[]], \|acc, ((f, t, ignore))| if IsHold t: Push acc, f else: acc
    let derived = Keys wx.dynReads
    let roots = SnapNames wx
    # a generation's dynamic result the block keeps (`KeptDyn`: a clause widget's, a
    # building arm's): its row tells the block of each write behind it
    # (`{name}_result_moved`), which marks the "updated" nodes over it as a hold's sink
    # does; the wake it asks runs at the next height when the row's write came later
    # (`Cx::wake`'s clamp)
    let kept = Each wx.clauseResults, \|n| "{n}_res"
    let own = Fold (Filter gns, \|g| g.kind == GnUpdated), [[]], \|acc, g| Fold g.reads, acc, \|a, r| match r:
        # a row or a generation is told of its block's writes (`parent_wrote_{m}`)
        ParentRead ignore: a
        OwnRead f:
            if (HasText holds, f) or (HasText derived, f) or (HasText roots, f) or (HasText kept, f): a
            else: Push a, (InternalBugDo "`!Updated` of a dynamic that reads `{f}`, which is no hold of this node, no getter over its holds, no structural dynamic and no kept result: a name bound to a reader the node does not have (every dynamic a node binds is one of those; a `rebuild`'s dynamic read above its line was not, `GivesResult`)")
    let hears = Append (Each wx.pending, \|p| UpdatedHears p.wx), (Each (Filter wx.rowMarks, \|rm| rm.kind == GenerationRow or rm.kind == ValueRow), \|rm| rm.wrote)
    Fold hears, own, \|acc, ms| Fold ms, acc, \|a, m|
        let behind = ReadsClosed wx.dynReads, [[OwnRead m]]
        let written = Fold behind, False, \|w, r| w or match r:
            OwnRead h: (HasText holds, h) or HasText kept, h
            ParentRead ignore: True
        # a structural dynamic the block publishes at the start of a tick is written as a
        # hold is (`HoldWritten` of its name), so the row's marks are in the publication
        if (HasText roots, m) or (ReachesSnap roots, behind) or written or (HasText derived, m): a
        else: Push a, (InternalBugDo "`!Updated` of a dynamic in a row that reads its block's `{m}`, which is no hold of the block, no getter over its holds, no structural dynamic and no name the block hears itself: a name bound to a reader the block does not have")

# The block's `for` rows finished with the block's heights (pick RE): each `!Updated` node
# of a row sits at least one above the block's writers of the holds behind what it reads
# through the parent, the floors of the block's own parent names inherited; the block's
# gather of a row's firings sits one above the row's heights.
FinishPending: unbounded fn Wx, [Gn] -> (([NodeDef], [Gn]))
fn FinishPending wx, gns = Fold wx.pending, (([[]], gns)), \|((defs, cur)), p|
    let floors = Fold (RowHears p.wx), {}, \|acc, m| Insert acc, m, (ParentFloor wx, cur, [[ParentRead m]])
    let floored = update p.wx:
        &_.floors <= floors
        &_.gns <= Each &_.gns, \|g| if g.kind == GnUpdated: WithFloor g, (ParentFloor wx, cur, (ReadsClosed p.wx.dynReads, g.reads)) else: g
    let def = FinishNode floored, p.qk, p.params, True
    let next = Each cur, \|g| if HasNat p.gathers, g.id: WithHeight g, (def.top + 1) else: g
    (((Push defs, def), next))

# One above the block's writers of the holds behind what a row reads through the parent,
# and the block's own floor for what it reads through its parent in turn.
ParentFloor: fn Wx, [Gn], [Read] -> Nat
fn ParentFloor wx, gns, reads = Fold reads, 0, \|hi, r| match r:
    ParentRead m: Fold (ReadsClosed wx.dynReads, [[OwnRead m]]), hi, \|h2, hr| match hr:
        OwnRead f: Fold gns, h2, \|h3, g| if WritesHold g, f: Max h3, (g.height + 1) else: h3
        ParentRead up: Max h2, (Or wx.floors[up], 0)
    OwnRead ignore: hi

WritesHold: fn Gn, Text -> Bool
fn WritesHold g, f = Fold g.outs, False, \|acc, o| acc or SinkWritesHold o.sink, f

SinkWritesHold: fn Sk, Text -> Bool
fn SinkWritesHold (SkHold h), f = h == f
fn SinkWritesHold (SkDistinct h), f = h == f
fn SinkWritesHold (SkPerKey h), f = h == f
fn SinkWritesHold (SkMachine h, ignore, ignore), f = h == f
fn SinkWritesHold other, f = False

WithFloor: fn Gn, Nat -> Gn
fn WithFloor g, h = update g:
    &_.floor <= h

WithHeight: fn Gn, Nat -> Gn
fn WithHeight g, h = update g:
    &_.height <= h

# A link to the node filled in (`whole_owner.link(&node)`, a host's `host_k_owner`): the
# first thing done once the node is made, before the builders, whose rows read the node's
# live dynamics and dynamic answers through it.
IsOwnerLink: fn Do -> Bool
fn IsOwnerLink d = match d:
    DoExpr (XMethod (XVar ignore), "link", [[(XRef (XVar "node"))]]): True
    otherwise: False

# The block's names a row must hear a write behind (pick RE): what its `!Updated` nodes
# read through the parent, and what its own rows hear, closed over its dynamic `let`s. The
# block tells the row through `parent_wrote_{m}`.
RowHears: fn Wx -> [Text]
fn RowHears wx:
    let fromUpdated = Fold (Filter wx.gns, \|g| g.kind == GnUpdated), [[]], \|acc, g| UnionReads acc, (ReadsClosed wx.dynReads, g.reads)
    let fromRows = Fold wx.rowMarks, [[]], \|acc, rm| UnionReads acc, (ReadsClosed wx.dynReads, (Append rm.reads, (Each rm.wrote, \|m| OwnRead m)))
    # what the row's own builders read through the parent: their sources, and so the
    # snapshots gathered over them (a row's `for` whose rows have no places of their own)
    let fromBuilds = ReadsClosed wx.dynReads, wx.buildHolds
    # and what the row's `rebuild`s' sources read through the parent
    let fromGens = Fold wx.genHolds, [[]], \|acc, ((ignore, hs))| UnionReads acc, (ReadsClosed wx.dynReads, hs)
    # and what its live dynamics and its hosts' dynamic answers read through the parent:
    # their ports fire at the block's write (`MovedBy`)
    let fromAnswers = Fold wx.dynAnswers, [[]], \|acc, ((ignore, rds))| UnionReads acc, (ReadsClosed wx.dynReads, rds)
    Fold (UnionReads (UnionReads (UnionReads (UnionReads fromUpdated, fromRows), fromBuilds), fromGens), fromAnswers), [[]], \|acc, r| match r:
        ParentRead m: AddText acc, m
        OwnRead ignore: acc

# The block's names a row's own `!Updated` nodes read through the parent, which the block's
# writes behind tell the row of (a structural dynamic's publication as any write).
UpdatedHears: fn Wx -> [Text]
fn UpdatedHears wx = Fold (Filter wx.gns, \|g| g.kind == GnUpdated), [[]], \|acc, g| Fold (ReadsClosed wx.dynReads, g.reads), acc, \|a, r| match r:
    ParentRead m: AddText a, m
    OwnRead ignore: a

# A write behind a read of the block (a hold of it, or a name it reads through its own
# parent): the rows of a `for` whose places read it are dirtied, and the rows that hear it
# are told through `parent_wrote_{m}`; the rows a blueprint value of the block's own
# widget built are dirtied each, and hear as a generation does.
RowWritten: fn Wx, RowMarks, Read -> [Do]
fn RowWritten wx, rm, r:
    let dirty = if HasRead (ReadsClosed wx.dynReads, rm.reads), r: [[DoExpr (XMethod XCx, "dirty", [[XClone (XVar "row")]])]] else: [[]]
    let hit = Filter (Append rm.wrote, rm.builds), \|m| HasRead (ReadsClosed wx.dynReads, [[OwnRead m]]), r
    let told = Each hit, \|m| DoExpr (XMethod (XVar "row"), "parent_wrote_{m}", [[XCx]])
    # the current generation, a `Row` the block names no method of, hears through a port
    # (`GenHears`)
    let fired = Each hit, \|m| DoExpr (XCall (HelperRef "no_fault"), [[(XMethod (XField XSelf, "{rm.builder}_wrote_{m}_port"), "fire", [[XUnit, XCx]])]])
    match rm.kind:
        GenerationRow: if (Len dirty) == 0: fired else: Push fired, (DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "row"]]), (XMethod (XMethod (XField XSelf, rm.builder), "borrow", [[]]), "as_ref", [[]]), dirty, [[]])
        # every row the widget's blueprint built that lives (`prism_rtl::WeakRows`)
        ValueRow: if (Len dirty) == 0: fired else: Push fired, (DoFor (PaBind "row"), (XMethod (XField XSelf, "{rm.builder}_rows"), "live", [[]]), dirty)
        otherwise:
            let body = Append dirty, told
            if (Len body) == 0: [[]] else: [[(DoFor (PaBind "row"), (XMethod (XMethod (XField XSelf, rm.builder), "borrow", [[]]), "values", [[]]), body)]]

# The patch pass for one live place: its level read and sent as changed, deep (`Level`); a
# level that holds dynamics renews its watch of them (doubt WD).
PatchPlace: fn Wx, Place -> [Do]
fn PatchPlace wx, p:
    let pull = DoLet (PaBind p.getter), (XMethod (XSelf), p.getter, [[XCx]])
    let at = PlaceAt wx, "self", p.pos
    let sent = DoExpr (XMethod (XCx), "changed", [[at, (XMethod (XVar p.getter), "level_pod", [[XCx]])]])
    let renew = if p.watch == "": [[]] else: [[DoExpr (XMethod (XField XSelf, p.watch), "renew", [[(XRef (XVar p.getter)), (XCast (XClone XSelf), (OutObj (OutNamed (RefRuntime "rt::Node"), [[]]))), XCx]])]]
    Append [[pull, sent]], renew

# Whether a position's place goes out to the World's document: the node's own, when the
# node is not itself in a hosted scope. Any other place is an entry of a host's document
# (pick HO), spelled by its path relative to the hosted child.
Emits: fn Wx, Pos -> Bool
fn Emits wx, pos = pos.scope == 0 and wx.?hostedBy == nil

# The root's result at the build: computed, kept as the last one told, and told the World.
ResultTold: fn Ex, Nat -> [Do]
fn ResultTold node, k:
    let r = DoLet (PaBind "r"), (XMethod node, (RootResultStem "result_value", k), [[XCx]])
    [[r, (ResultKept node, k), resultTell]]

# The names of the root's dynamic results: the first `result_value` and `result_last`, each
# later part of a bundle its own (`result_value_1`, `result_last_1`).
RootResultStem: fn Text, Nat -> Text
fn RootResultStem stem, k = if k == 0: stem else: "{stem}_{k}"

# The root's result after a tick: told when it differs from the last one told.
ResultMoved: fn Ex, Nat -> [Do]
fn ResultMoved node, k:
    let r = DoLet (PaBind "r"), (XMethod node, (RootResultStem "result_value", k), [[XCx]])
    let last = XMethod (XMethod (XField node, (RootResultStem "result_last", k)), "borrow", [[]]), "as_ref", [[]]
    let differs = XBin OpNe, last, (XCtor (RefRuntime "std::Some"), [[XRef (XVar "r")]])
    [[r, (DoIf differs, [[(ResultKept node, k), resultTell]], [[]])]]

ResultKept: fn Ex, Nat -> Do
fn ResultKept node, k = DoAssign (XDeref (XMethod (XField node, (RootResultStem "result_last", k)), "borrow_mut", [[]])), (XCtor (RefRuntime "std::Some"), [[XClone (XVar "r")]])

let resultTell = DoExpr (XMethod XCx, "result", [[(XCtor (RefRuntime "rt::Outcome::Value"), [[XVar "r"]])]])

# A flatten's adoption queued for the first firings of the next tick.
Adoption: fn FlatDef -> [Do]
fn Adoption fl:
    let adopt = XLater (XMethod (XVar "node"), "{fl.name}_adopt", [[XCx]])
    [[(DoLet (PaBind "node"), (XClone XSelf)), (DoExpr (XMethod XCx, "answer_later", [[adopt]]))]]

# A place's path as read from `recv` (`self`, `node`, or "" in the build, before
# the node exists): the node's own path for a place that goes to the World, or, for a place
# of a host's document, its path relative to the hosted child (`Path::root().at(n)`), under
# which a host's row builds (pick HO).
PlaceAt: fn Wx, Text, Pos -> Ex
fn PlaceAt wx, recv, pos:
    let at = [[(PlaceNumber wx, recv, pos)]]
    if Emits wx, pos: XMethod (if recv == "": XVar "path" else: (if recv == "self": XField XSelf, "path" else: XField (XVar recv), "path")), "at", at
    else: XMethod (XCall (RefRuntime "rt::Path::root"), [[]]), "at", at

# Whether a position has no number in the block's build, before the node exists
# (`PlaceNumber` with no receiver): the block is a row numbered late, whose `base` is
# set after its node, or a gappy generation before the position is built after the
# node or numbered late, so what it leaves unbuilt is not known yet.
PlaceUnknownAtBuild: fn Wx, Pos -> Bool
fn PlaceUnknownAtBuild wx, pos = (pos.scope == 0 and wx.baseLate and IsSomeNat wx.?based) or (Len (Filter (GapsBefore wx, pos), \|gd| (not gd.early) or HasText wx.lateNumbered, gd.name)) > 0

# The gappy generations of a position's scope that end at or before it (`GenDef.gappy`).
GapsBefore: fn Wx, Pos -> [GenDef]
fn GapsBefore wx, pos = Filter wx.gens, \|gd| gd.gappy and gd.pos.scope == pos.scope and gd.pos.at + gd.width <= pos.at

# Whether a generation built early at a position, before the block's node, is numbered
# after it (`Wx.lateNumbered`; ruling TC: places are counted as they are built): a
# generation before it is built after the node (a building `match` over the early row's
# own plain result, written above it), or is numbered late itself, so what it leaves
# unbuilt is known only once the node stands; or the block is itself a row numbered
# late, whose `base` is. The row is built in two steps: its build computes its result
# and makes its node, and `number_places` sends its places (`LateNumbering`).
NumberedLate: fn Wx, Pos -> Bool
fn NumberedLate wx, pos = (wx.baseLate and pos.scope == 0) or (Len (Filter (GapsBefore wx, pos), \|gd| (not gd.early) or HasText wx.lateNumbered, gd.name)) > 0

# What a row numbered after its block's node (`Wx.baseLate`) does in its build once its
# node is made: everything the build of another row does there (the links, the
# construction step, the places sent, the subscriptions) is kept in `number_later`,
# with the build's values it reads, and runs when the block numbers the row
# (`number_places`, from the block's `{name}_number`).
LateNumbering: fn [Do] -> [Do]
fn LateNumbering build:
    let kept = XBlock [[(DoLet (PaBind "node"), (XClone (XVar "node"))), (DoLet (PaTyped (PaBind "number"), laterTy), (XLater (XBlock build, (XUnit))))]], (XVar "number")
    [[(DoAssign (XDeref (XMethod (XField (XVar "node"), "number_later"), "borrow_mut", [[]])), (XCtor (RefRuntime "std::Some"), [[kept]]))]]

# A row numbered late that builds its generations in its build (`Wx.lateGens`,
# `LateGenerations`): its block ends on a late plain result, which the block that built
# the row reads right after the row's build (`result_value`), from a generation the row
# builds after its own node. So the row builds each such generation at once, its rows
# with no `base` and numbered late in turn (`ArmRowOf`, `weakLate`), and what waits for
# the row's number is the rest: each of those rows numbered, in the order of their
# places (`{name}_number`, `NumberTaken`), the builders, the places sent, the
# subscriptions. Every row inside such a row does the same, so each tells its block what
# its generations left unbuilt when it is built.

# The step that numbers the current row of a generation, taken and run.
NumberTaken: fn Ex, Text -> Do
fn NumberTaken recv, name = DoScope [[(DoLet (PaBind "number"), (XMethod (XMethod (XField recv, "{name}_number"), "borrow_mut", [[]]), "take", [[]])), (DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "number"]]), (XVar "number"), [[(DoExpr (TryOf (XApply (XVar "number"), [[XCx]])))]], [[]])]]

# A generation of such a row whose rows are numbered late: built again once the row is
# numbered (its source moved in a later tick), its new row is numbered at once.
LateRowSelect: fn GenDef -> GenDef
fn LateRowSelect gd = update gd:
    &_.select <= XBlock [[(DoLet (PaBind "row"), gd.select), (DoIf (XMethod (XField XSelf, "numbered"), "get", [[]]), [[(NumberTaken XSelf, gd.name)]], [[]])]], (XVar "row")

# The sinks with the part of the construction step to write (`Wx.genPhase`).
PhaseOf: fn Sinks, Nat -> Sinks
fn PhaseOf sk, phase = update sk:
    &_.wx <= WithGenPhase &_.wx, phase

WithGenPhase: fn Wx, Nat -> Wx
fn WithGenPhase wx, phase = update wx:
    &_.genPhase <= phase

# (`prism_rtl::cx::Later`: the crate's root does not export the name)
let laterTy = OutNamed (RefRuntime "prism_rtl::cx::Later"), [[]]

# A row numbered late: `base` set, then what its build kept for now.
NumberPlaces: fn Wx -> MethDef
fn NumberPlaces wx:
    let set = DoExpr (XMethod (XField XSelf, "base"), "set", [[(XVar "base")]])
    let taken = DoLet (PaBind "number"), (XMethod (XMethod (XField XSelf, "number_later"), "borrow_mut", [[]]), "take", [[]])
    let run = DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "number"]]), (XVar "number"), [[(DoExpr (TryOf (XApply (XVar "number"), [[XCx]])))]], [[]]
    # (a row that builds its generations at its build tells them it is numbered now, `LateRowSelect`)
    let told = if wx.lateGens: [[(DoExpr (XMethod (XField XSelf, "numbered"), "set", [[(XBool True)]]))]] else: [[]]
    MethDef(name="number_places", recv=RecvRc, params=[[(("base", OutCount))]], cx=CxMut, ret=(OutNamed (RefRuntime "rt::Done"), [[]]), body=(Append (Append [[set]], told), [[taken, run]]), tail=(XCtor (RefRuntime "std::Ok"), [[XUnit]]), doc="The row's places numbered from `base`, where its first position stands as built, and sent: the row was built before its block's node, below a generation built after it (ruling TC: places are counted as they are built).")

# The node's method that gives a position of scope `k` as built, and the one that gives
# back the position an answer's names (`PlaceMethods`).
PlaceMethod: fn Nat -> Text
fn PlaceMethod scope = if scope == 0: "place" else: "place_{scope}"

SeatMethod: fn Nat -> Text
fn SeatMethod scope = if scope == 0: "seat" else: "seat_{scope}"

# A position's number as built (rulings since the Bible, TC: places are counted as they
# are built). Inside a node a position is where the place stands when every transparent
# generation before it builds its widest row; the number a path takes is that less what
# the generations before it left unbuilt, and for a transparent row's place counted from
# the row's `base`. A node with neither spells the position itself. Before the node
# exists (`recv` empty) the row's `base` is the build's parameter and a gap is known only
# of a generation built early (`{name}_gap_now`). A row numbered after its block's node
# (`Wx.baseLate`) has no `base` before its own node, and a generation numbered late
# (`Wx.lateNumbered`) no gap: a line that is built early below one is numbered late
# itself (`NumberedLate`), and what else spells a place before the node is refused.
PlaceNumber: fn Wx, Text, Pos -> Ex
fn PlaceNumber wx, recv, pos:
    let gaps = GapsBefore wx, pos
    let ?base = if pos.scope == 0: wx.?based else: nil
    if (Len gaps) == 0 and not (IsSomeNat ?base): XIndex pos.at
    else: if recv == "":
        let start = match ?base:
            ? s: if wx.baseLate: Refusal "a place that is read at its row's build (place {PlaceText pos}: a host's, or a hosted place's first value) in an arm or a clause that is built before its block's node and numbered after it" else: XBin OpAdd, (XVar "base"), (XIndex (Or (pos.at -? s), 0))
            nil: XIndex pos.at
        Fold gaps, start, \|acc, gd| if gd.early and not (HasText wx.lateNumbered, gd.name): XBin OpSub, acc, (XVar "{gd.name}_gap_now") else: Refusal "a place that is read at its block's build (place {PlaceText pos}) after a building `match`, `if` or widget of several clauses whose rows differ in width and are built after the block's node"
    else: XMethod (if recv == "self": XSelf else: XVar recv), (PlaceMethod pos.scope), [[XIndex pos.at]]

IsSomeNat: fn ?Nat -> Bool
fn IsSomeNat (? ignore) = True
fn IsSomeNat nil = False

# What a gappy generation's row left unbuilt, as the node reads it.
GapGet: fn GenDef -> Ex
fn GapGet gd = XMethod (XField XSelf, "{gd.name}_gap"), "get", [[]]

# The node's `place` and `seat` of each scope that needs them (`PlaceNumber`), and a
# row's `inner_gap`. `place(v)`: the position `v` as built. `seat(a)`: the position an
# answer's first segment names, its own gaps put back, so that the node's arms match
# positions as the lowering wrote them; an answer reaches a transparent row with its
# block's gaps put back already. `inner_gap()`: what the row's own generations left
# unbuilt, which its block adds to the row's own shortfall.
PlaceMethods: fn Wx -> [MethDef]
fn PlaceMethods wx:
    let gappy = Filter wx.gens, \|gd| gd.gappy
    let scopes = Fold gappy, (if IsSomeNat wx.?based: [[0]] else: [[]]), \|acc, gd| if HasNat acc, gd.pos.scope: acc else: Push acc, gd.pos.scope
    Fold scopes, [[]], \|acc, k|
        let gaps = Filter gappy, \|gd| gd.pos.scope == k
        let start = match (if k == 0: wx.?based else: nil):
            ? s: XBin OpSub, (XBin OpAdd, (if wx.baseLate: XMethod (XField XSelf, "base"), "get", [[]] else: XField XSelf, "base"), (XVar "v")), (XIndex s)
            nil: XVar "v"
        let placed = Fold gaps, start, \|x, gd| XBin OpSub, x, (XIf (XBin OpGe, (XVar "v"), (XIndex (gd.pos.at + gd.width))), (GapGet gd), (XIndex 0))
        let place = MethDef(name=(PlaceMethod k), recv=RecvRef, params=[[(("v", OutCount))]], cx=CxNone, ret=OutCount, body=[[]], tail=placed, doc="The position `v` as built: places are counted as they are built (ruling TC).")
        let steps = Each (Range0 (Len gaps)), \|i|
            let gd = Or gaps[i], dummyGenDef
            let before = XVar (if i == 0: "v" else: "v{i}")
            DoLet (PaBind "v{i + 1}"), (XIf (XBin OpGe, before, (XBin OpSub, (XIndex (gd.pos.at + gd.width)), (GapGet gd))), (XBin OpAdd, before, (GapGet gd)), before)
        let seat = MethDef(name=(SeatMethod k), recv=RecvRef, params=[[(("v", OutCount))]], cx=CxNone, ret=OutCount, body=steps, tail=(XVar "v{Len gaps}"), doc="The position an answer names, this node's gaps put back (ruling TC).")
        let inner = MethDef(name="inner_gap", recv=RecvRef, params=[[]], cx=CxNone, ret=OutCount, body=[[]], tail=(Fold gaps, (XIndex 0), \|x, gd| XBin OpAdd, x, (GapGet gd)), doc="How many positions this row's own generations left unbuilt.")
        Append acc, (Append [[place]], (if (Len gaps) == 0: [[]] else: (if k == 0 and IsSomeNat wx.?based: [[seat, inner]] else: [[seat]])))

let dummyGenDef = GenDef(name="", pos=Pos(scope=0, at=0), at=(XUnit), source=(XUnit), valueTy=OutUnit, select=(XUnit), transparent=False, width=0, moved="", early=False, gappy=False, rebased=False)

# An answer's segments with the first, a position, seated (`PlaceMethods`), when the
# node has gaps in the scope; else the segments as they came.
Seated: fn Wx, Nat, Ex -> (([Do], Ex))
fn Seated wx, scope, segs = if (Len (Filter wx.gens, \|gd| gd.gappy and gd.pos.scope == scope)) == 0: (([[]], segs)) else: (([[(DoLet (PaBind "seated"), (XCall (HelperRef "seated"), [[segs, (XClosure False, [[PaBind "a"]], (XMethod XSelf, (SeatMethod scope), [[XVar "a"]]))]]))]], (XCall (HelperRef "segments_of"), [[XRef (XVar "seated")]])))

# The pattern of an answer at a place, `tail` the rest of its segments.
PosPat: fn Pos, [Pa] -> Pa
fn PosPat pos, tail = PaSlice (Append [[(PaCtor (RefRuntime "rt::Segment::Pos"), [[PaIndex pos.at]])]], tail)

# The segments under a place: a `for` row's key, a generation's number, or any.
let keyTail = [[(PaCtor (RefRuntime "rt::Segment::Key"), [[PaBind "k"]]), PaRest "rest"]]
let genTail = [[(PaCtor (RefRuntime "rt::Segment::Gen"), [[PaBind "g"]]), PaRest "rest"]]

# What the rows of a `for` or `rebuild` at the block's current position tell when a place
# of theirs may have moved: nothing when the rows' places go to the World; the host's
# `host_k_moved` for rows of a hosted child's `for`; and the parent row's `document_moved`
# for rows of a row that is itself hosted (pick HO).
?HostedRows: fn Wx -> ?Text
fn ?HostedRows wx:
    if wx.pos.scope > 0: ? "{Or wx.scopes[Dec wx.pos.scope], ""}_moved"
    else: match wx.?hostedBy:
        ? ignore: ? "document_moved"
        nil: nil

# The root's dynamic result at the patch pass: sent when it moved.
RootDynPatch: fn Wx -> [Do]
fn RootDynPatch wx = Each (Range0 (Len wx.rootDyns)), \|k| DoLine (ResultMoved XSelf, k)

# A World's answer at a place: the input method called with the decoded value.
AnswerArm: fn Wx, Pos, Nat, OutTy -> ((Pa, Ex))
fn AnswerArm wx, pos, id, t:
    let call = XMethod (XSelf), (GnOf wx, id).name, [[(XDecode t, (XVar "v")), XCx]]
    (((PosPat pos, [[]]), call))

# A host's typed answer to a place of its child (pick HO): the input method called with the
# tag's variant of `crate::Answer` taken apart (a variant of another tag is a fault).
TypedAnswerArm: unbounded fn Wx, Pos, Nat, OutTy, Text -> ((Pa, [Do]))
fn TypedAnswerArm wx, pos, id, placed, acc = (((PosPat pos, [[]]), [[(SelfCall (GnOf wx, id).name, [[(AnswerTaken wx.lx, acc, placed, (TryOf (XMethod (XVar "v"), acc, [[]])))]])]]))

# A push to a bundle's place (`BundlePlace`): its whole state, each `$` part's hold written
# with its part of it, as a push writes any place's hold (`DynPlaceWrite`). A plain part
# was read at the build and is not read again.
BundleStateWrite: fn Sinks, BundlePlace, Ex -> [Do]
fn BundleStateWrite sk, bp, value = if bp.stateParts == 1: (Fold bp.holds, [[]], \|acc, ((ignore, f, ignore))| Append acc, (DynPlaceWrite sk, f, value))
    else: Fold bp.holds, [[(DoLet (PaBind "state"), value)]], \|acc, ((k, f, ignore))| Append acc, (DynPlaceWrite sk, f, (XClone (XPart (XVar "state"), k)))

# An answer to a bundle's event parts, `events` the answer as its tag carries it: of one
# event part its value, of several a sparse tuple, each part that is there fired.
BundleEventsFire: fn Wx, BundlePlace, Ex -> [Do]
fn BundleEventsFire wx, bp, events = match bp.events:
    [[]]: [[]]
    [[((id, ignore))]]: [[(SelfCall (GnOf wx, id).name, [[events]])]]
    otherwise: Fold (Range0 (Len bp.events)), [[(DoLet (PaBind "events"), events)]], \|acc, j| match bp.events[j]:
        ? ((id, ignore)): Push acc, (DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "part"]]), (XMethod (XPart (XVar "events"), j), "present", [[]]), [[(SelfCall (GnOf wx, id).name, [[(XClone (XVar "part"))]])]], [[]])
        nil: acc

# What a bundle's event parts' answer is typed as (`AnswerTy`).
BundleEventsTy: fn BundlePlace -> OutTy
fn BundleEventsTy bp = match bp.events:
    [[((ignore, t))]]: t
    otherwise: OutTuple (Each bp.events, \|((ignore, t))| SparsePartTy t)

# A World's answer at a bundle's place, by path: its event parts' answer, or, of a bundle
# with none, its state.
BundleAnswerArm: fn Sinks, BundlePlace -> ((Pa, Ex))
fn BundleAnswerArm sk, bp:
    let dos = if (Len bp.events) == 0: BundleStateWrite sk, bp, (XDecode bp.stateTy, (XVar "v")) else: BundleEventsFire sk.wx, bp, (XDecode (BundleEventsTy bp), (XVar "v"))
    (((PosPat bp.pos, [[]]), (XBlock dos, (XUnit))))

# A host's typed answer to a bundle's place: the tag's state case of `crate::Answer` is a
# push (a supplier's `$` part moving, a forwarded push), written to the `$` parts' holds;
# any other is the event parts' answer. A bundle of state parts alone has its state in
# the tag's own case.
BundleTypedArm: unbounded fn Sinks, BundlePlace -> ((Pa, [Do]))
fn BundleTypedArm sk, bp:
    let lx = sk.wx.lx
    let Taken = \|acc, placed| AnswerTaken lx, acc, placed, (TryOf (XMethod (XVar "v"), acc, [[]]))
    let fired = BundleEventsFire sk.wx, bp, (Taken bp.eventAccessor, (BundleEventsTy bp))
    let pushed = if bp.stem == "": [[]] else: BundleStateWrite sk, bp, (Taken bp.stateAccessor, bp.stateTy)
    let dos = if (Len bp.events) == 0: pushed else: if bp.stem == "": fired else: [[(DoIf (XIsCase (XVar "v"), [[bp.firstVariant]]), pushed, fired)]]
    (((PosPat bp.pos, [[]]), dos))

TypedDynArm: unbounded fn Sinks, Pos, Text, OutTy, Text -> ((Pa, [Do]))
fn TypedDynArm sk, pos, f, placed, acc = (((PosPat pos, [[]]), (DynPlaceWrite sk, f, (AnswerTaken sk.wx.lx, acc, placed, (TryOf (XMethod (XVar "v"), acc, [[]]))))))

# A host's typed answer under a `for`'s or a `rebuild`'s place of its child: to the row its
# key names, or the current generation, which delivers it on (prelude `Row::deliver`).
TypedForwardArm: fn ForDef, Ex -> ((Pa, [Do]))
fn TypedForwardArm b, segs:
    let rowOf = XMethod (XMethod (XMethod (XField XSelf, "{b.name}"), "borrow", [[]]), "get", [[(XRef (XDecode b.keyTy, (XVar "k")))]]), "cloned", [[]]
    (((PosPat b.pos, keyTail), [[(DoLet (PaBind "row"), rowOf), (DoMatch (XVar "row"), [[(((PaCtor (RefRuntime "std::Some"), [[PaBind "row"]]), [[DoExpr (TryOf (XMethod (XVar "row"), "deliver", [[(XVar "rest"), (XVar "v"), XCx]]))]])), ((PaUnit (RefRuntime "std::None"), [[DoReturn (XCtor (RefRuntime "std::Err"), [[(XCall (RefRuntime "rt::Fault::answer"), [[(XFormatStr [[(XText "no row "), (XVar "k"), (XText " under the hosted place "), (XCtor (RefRuntime "rt::Path"), [[(XMethod segs, "to_vec", [[]])]])]])]])]])]]))]])]]))

# A transparent generation answers at each of its positions in the block, its row given the
# whole path (its places' paths are the block's).
TypedGenArms: fn GenDef, Ex -> [((Pa, [Do]))]
fn TypedGenArms gd, segs = if IsWideGen gd: [[]] else: if gd.transparent: Each (Range0 gd.width), \|i| TransparentGenArm gd, segs, i else: [[TypedGenArm gd]]

TransparentGenArm: fn GenDef, Ex, Nat -> ((Pa, [Do]))
fn TransparentGenArm gd, segs, i:
    let current = XClone (XMethod (XField XSelf, "{gd.name}"), "borrow", [[]])
    (((PosPat (Pos(scope=gd.pos.scope, at=gd.pos.at + i)), [[PaRest ""]]), [[(DoLet (PaBind "row"), current), (DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "row"]]), (XVar "row"), [[DoExpr (TryOf (XMethod (XVar "row"), "deliver", [[segs, (XVar "v"), XCx]]))]], [[]])]]))

TypedGenArm: fn GenDef -> ((Pa, [Do]))
fn TypedGenArm gd:
    let current = XClone (XMethod (XField XSelf, "{gd.name}"), "borrow", [[]])
    let isCurrent = XBin OpEq, (XBin OpAdd, (XDeref (XVar "g")), (XIndex 1)), (XMethod (XField XSelf, "{gd.name}_count"), "get", [[]])
    (((PosPat gd.pos, genTail), [[(DoLet (PaBind "row"), current), (DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "row"]]), (XVar "row"), [[(DoIf isCurrent, [[DoExpr (TryOf (XMethod (XVar "row"), "deliver", [[(XVar "rest"), (XVar "v"), XCx]]))]], [[]])]], [[]])]]))

# The typed dispatch from a child place's path into the child's places (pick HO): the owner's
# `host_k_answer` for the places of scope `k`, and a hosted node's `deliver` for its own
# (`Row::deliver`, called by its host's rows). A place with no answer, or no place, is a
# fault of the tick: a host answers only what its child asks.
TypedDispatch: unbounded fn Sinks, Text, Nat -> MethDef
fn TypedDispatch sk, name, scope:
    let wx = sk.wx
    let InScope = \|p| p.scope == scope
    # the owner's `host_k_answer` takes the child place's path; a hosted node's `deliver`, a
    # `Row` hook, the segments under its parent's place
    let ((recv, param, segs0, doc)) = if scope > 0: ((RecvRc, (("place", (OutRef OutPath))), (XMethod (XVar "place"), "segments", [[]]), "The host at place {PlaceText (Or wx.hosts[Dec scope], dummyHost).pos} answers its child's place `place` (pick HO): into the child's input method, a hold the place's element answers, or the row of a `for` or `rebuild` under it."))
        else: ((RecvOwned, (("at", (OutRef (OutSlice (OutNamed (RefRuntime "rt::Segment"), [[]]))))), (XVar "at"), "A host's answer to a place of this row's own, `at` under the row (pick HO): into the input method, a hold, or a row under it."))
    let ((seating, segs)) = Seated wx, scope, segs0
    let answers = Each (Filter wx.answers, \|((pos, ignore, ignore, ignore))| InScope pos), \|((pos, id, placed, acc))| TypedAnswerArm wx, pos, id, placed, acc
    let dyns = Each (Filter wx.dynPlaces, \|((pos, ignore, ignore, ignore))| InScope pos), \|((pos, f, placed, acc))| TypedDynArm sk, pos, f, placed, acc
    # a bundle's place, its state and its event parts in one arm (`BundleTypedArm`)
    let bundles = Each (Filter wx.bundles, \|bp| (InScope bp.pos) and ((Len bp.events) > 0 or bp.stem != "")), \|bp| BundleTypedArm sk, bp
    let rows = Each (Filter wx.builders, \|b| InScope b.pos), \|b| TypedForwardArm b, segs
    let gens = Fold (Filter wx.gens, \|gd| InScope gd.pos), [[]], \|acc, gd| Append acc, (TypedGenArms gd, segs)
    let none = ((PaWild, [[DoReturn (XCtor (RefRuntime "std::Err"), [[(XCall (RefRuntime "rt::Fault::answer"), [[(XFormatStr [[(XText "no hosted place at "), (XCtor (RefRuntime "rt::Path"), [[(XMethod segs, "to_vec", [[]])]]), (XText " to answer")]])]])]])]]))
    # a generation too wide for an arm per position (a widget that calls itself) is
    # found by the answer's first segment, in one last arm (`TypedWideForward`)
    let wide = Filter wx.gens, \|gd| (InScope gd.pos) and IsWideGen gd
    let ((ignore, noneDos)) = none
    let last = if (Len wide) == 0: [[none]] else: TypedWideForward wide, segs, noneDos
    let arms = Append (Append (Append (Append (Append answers, dyns), bundles), rows), gens), last
    MethDef(name=name, recv=recv, params=[[param, (("v", (OutRef answerTy)))]], cx=CxMut, ret=(OutNamed (RefRuntime "rt::Done"), [[]]), body=(Push seating, (DoMatch segs, arms)), tail=(XCtor (RefRuntime "std::Ok"), [[XUnit]]), doc=doc)

let dummyHost = HostDef(pos=pos0, name="", scope=0)

# What the sinks' code needs of the node: the holds whose writes mark a place or a
# builder, and the combinators its wake decides, in the order of `Heights`.
type Sinks = record:
    wx: Wx
    dirty: [Read]
    builds: [Read]
    combs: [Gn]

SortNats: fn [Nat] -> [Nat]
fn SortNats xs = Fold xs, [[]], \|acc, x| Append (Push (Filter acc, \|y| y < x), x), (Filter acc, \|y| not (y < x))

# Asking for a combinator's wake: the node's `Heights` records the combinator and asks the
# wake at its global height (`Node::wake` is not told the height, gap WH of the README).
AskWake: fn Sinks, Gn -> [Do]
fn AskWake sk, g = [[DoExpr (XMethod (XField XSelf, "heights"), "ask", [[(XIndex (CombinatorOf sk.combs, g)), XCx, (XClone XSelf)]])]]

# A row's subscription's height twin (`subscribe_row`): the row's method `m` fires at the
# port's height.
HeardAbove: fn Text -> Ex
fn HeardAbove m = XClosure False, [[PaBind "n", PaBind "h"]], (XMethod (XVar "n"), "{m}_above", [[(XVar "h")]])

# A combinator's place among the node's combinators: its index in the node's `Heights`.
CombinatorOf: fn [Gn], Gn -> Nat
fn CombinatorOf combs, g:
    let ((before, ignore)) = Fold combs, ((0, False)), \|((n, found)), c| if found or c.id == g.id: ((n, True)) else: ((n + 1, False))
    before

# A `!MergeAll` list's input heard (`MergeListEvent`): an event of the list fired, which
# the runtime's `MergeList` stamped; the wake is asked at the node's height.
MergeListIn: fn Sinks, Gn -> MethDef
fn MergeListIn sk, g = MethDef(name="{g.name}_in", recv=RecvRc, params=[[]], cx=CxMut, ret=OutUnit, body=(AskWake sk, g), tail=(XUnit), doc="An event of the `!MergeAll` list fired: the wake decides the tick's one firing.")

# A gather's input: a row's firing, collected by key into the tick's one firing.
GatherIn: fn Sinks, Gn -> MethDef
fn GatherIn sk, g:
    let field = Or g.inputs[0], ""
    let kt = match g.ty:
        OutMap k, ignore: k
        otherwise: OutUnit
    let vt = match g.ty:
        OutMap ignore, v: v
        otherwise: OutUnit
    let current = XMethod (XMethod (XField XSelf, "{field}"), "get", [[XCx]]), "unwrap_or_default", [[]]
    let collect = [[(DoLet (PaMut "all"), current), (DoExpr (XMethod (XVar "all"), "insert", [[(XVar "k"), (XVar "v")]])), (DoExpr (XMethod (XField XSelf, "{field}"), "set", [[(XVar "all"), XCx]]))]]
    let body = Append collect, (AskWake sk, g)
    MethDef(name="{g.name}_in", recv=RecvRc, params=[[(("k", kt)), (("v", vt))]], cx=CxMut, ret=OutUnit, body=body, tail=(XUnit), doc="A row's firing, gathered by its key.")

Decide: fn Gn -> Do
fn Decide g = match g.kind:
    GnGather: DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "v"]]), (XMethod (XField XSelf, "{Or g.inputs[0], ""}"), "take", [[XCx]]), [[(SelfCall g.name, [[(XVar "v")]])]], [[]]
    # the values the list's events fired this tick, in the list's order
    GnMergeList: DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "v"]]), (XMethod (XField XSelf, "{Or g.inputs[0], ""}"), "take", [[XCx]]), [[(SelfCall g.name, [[(XVar "v")]])]], [[]]
    GnMerge: MergeDecide g
    GnUpdated: UpdatedDecide g
    GnMergeAll:
        let pushes = Each g.inputs, \|f| DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "x"]]), (XMethod (XField XSelf, "{f}"), "take", [[XCx]]), [[DoExpr (XMethod (XVar "all"), "push_back", [[(XVar "x")]])]], [[]]
        let start = DoLet (PaTyped (PaMut "all"), g.ty), (XCall (RefRuntime "rt::Array::new"), [[]])
        let fire = DoIf (XUnary OpNot, (XMethod (XVar "all"), "is_empty", [[]])), [[(SelfCall g.name, [[(XVar "all")]])]], [[]]
        DoBlock (Push (Append [[start]], pushes), fire)
    kind: PairDecide g, kind

# An "updated" node decides: the flag taken (once a tick: a hold it reads was written), the
# dynamic read after the tick, the event fired with it. No dedupe (pick UD): the event
# fires whenever the dynamic was recomputed, equal value or not.
UpdatedDecide: fn Gn -> Do
fn UpdatedDecide g = DoIf (XMethod (XField XSelf, "{g.name}_moved"), "replace", [[(XBool False)]]), [[(DoLet (PaBind "after"), (XMethod XCx, "after", [[(XClosure False, [[PaBind "cx"]], (XMethod XSelf, "{g.name}_value", [[XCx]]))]])), (SelfCall g.name, [[(XVar "after")]])]], [[]]

# Both inputs read, then decided: `!Union` joins the maps (the left's keys win), `!Both`
# pairs them, `!Except` fires the left without the right.
PairDecide: fn Gn, GnKind -> Do
fn PairDecide g, kind:
    let getL = XMethod (XField XSelf, "{Or g.inputs[0], ""}"), "take", [[XCx]]
    let getR = XMethod (XField XSelf, "{Or g.inputs[1], ""}"), "take", [[XCx]]
    let both = XTuple [[getL, getR]]
    let Fire = \|x| [[(SelfCall g.name, [[x]])]]
    let sa = PaCtor (RefRuntime "std::Some"), [[PaBind "a"]]
    let sb = PaCtor (RefRuntime "std::Some"), [[PaBind "b"]]
    let some2 = PaTuple [[sa, sb]]
    let left = PaTuple [[sa, (PaUnit (RefRuntime "std::None"))]]
    let right = PaTuple [[(PaUnit (RefRuntime "std::None")), sb]]
    let cases = match kind:
        GnUnion: [[((some2, (Fire (XCall (HelperRef "union"), [[(XRef (XVar "a")), (XRef (XVar "b"))]])))), ((left, (Fire (XVar "a")))), ((right, (Fire (XVar "b")))), ((PaWild, [[]]))]]
        GnBoth: [[((some2, (Fire (XTuple [[(XVar "a"), (XVar "b")]])))), ((PaWild, [[]]))]]
        otherwise: [[((left, (Fire (XVar "a")))), ((PaWild, [[]]))]]
    DoMatch both, cases

# The node's wake: each combinator asked whose height has come decides, the lowest first.
WakeByHeight: fn [Gn] -> Do
fn WakeByHeight combs = DoWhileLet (PaCtor (RefRuntime "std::Some"), [[PaBind "combinator"]]), (XMethod (XField XSelf, "heights"), "next", [[XCx]]), [[(DoMatch (XVar "combinator"), (Push (Each combs, \|g| ((PaIndex (CombinatorOf combs, g), [[(Decide g)]]))), ((PaWild, [[]]))))]]

# An answer under a `for`'s place goes to the row its key names.
ForwardAnswer: fn ForDef -> Ex
fn ForwardAnswer b:
    let rowOf = XMethod (XMethod (XMethod (XField XSelf, "{b.name}"), "borrow", [[]]), "get", [[(XRef (XDecode b.keyTy, (XVar "k")))]]), "cloned", [[]]
    XBlock [[(DoLet (PaBind "row"), rowOf), (DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "row"]]), (XVar "row"), [[DoExpr (TryOf (XMethod (XVar "row"), "answer", [[(XVar "rest"), (XVar "v"), XCx]]))]], [[]])]], (XUnit)

IsHold: fn OutTy -> Bool
fn IsHold (OutHold ignore) = True
# `@PerKey`'s outer: a hold its sink writes (`SkPerKey`)
fn IsHold (OutNamed (RefRuntime "prism_rtl::PerKey"), ignore) = True
fn IsHold other = False

# A row's own methods: its places torn down (the ones that went to the World; a hosted
# row's leave its host's document with the row), its rows' and generations' too.
RowMethods: fn Wx -> [MethDef]
fn RowMethods wx:
    let removes = Fold (Filter wx.places, \|p| Emits wx, p.pos), [[]], \|acc, p| Append acc, (Append [[DoExpr (XMethod (XCx), "removed", [[(PlaceAt wx, "self", p.pos)]])]], (if p.watch == "": [[]] else: [[DoExpr (XMethod (XField XSelf, p.watch), "drop_all", [[]])]]))
    let nested = Append (Each wx.builders, \|b| DoExpr (XMethod (XMethod (XMethod (XField XSelf, b.name), "borrow", [[]]), "values", [[]]), "for_each", [[(XClosure False, [[PaBind "row"]], (XMethod (XVar "row"), "leave_row", [[XCx]]))]])), (Each wx.gens, \|gd| DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "row"]]), (XMethod (XMethod (XField XSelf, gd.name), "borrow", [[]]), "as_ref", [[]]), [[DoExpr (XMethod (XVar "row"), "leave_row", [[XCx]])]], [[]])
    let left = if wx.genOf == "": [[]] else: [[DoExpr (XMethod (XField XSelf, "left"), "set", [[XBool True]])]]
    # (and its subscriptions to the event values it hears undone, `SubscribedValue`)
    let unsubscribed = Each wx.valueSubs, \|name| DoExpr (XCall (HelperRef "unsubscribe_value"), [[(XRef (XField XSelf, "{name}_value_port")), (XRef (XField XSelf, "{name}_sub"))]])
    [[MethDef(name="remove_places", recv=RecvRef, params=[[]], cx=CxMut, ret=OutUnit, body=(Append (Append (Append left, removes), nested), unsubscribed), tail=(XUnit), doc="The row left: its places are torn down, its subscriptions to event values undone.")]]

GnDoc: fn Gn -> Text
fn GnDoc g = match g.kind:
    GnAnswer: "`{g.name}`: an answer at its place."
    GnStarted: "`@started`, the tick after the build."
    GnDeferred: "An `@Defer` firing, the tick after it was armed."
    GnMerge: "The merge `{g.name}`, decided in the wake."
    GnUpdated: "`!Updated`: the dynamic's value after the tick, fired in the wake when a hold it reads was written (or a structural dynamic it reads was published, pick ST)."
    otherwise: "`!{g.name}`."

# The merge decides once, after its inputs: the left first.
MergeDecide: fn Gn -> Do
# Each input taken as it is decided, so a wake the node gets again in the tick (an input
# fired anew through a host's answer) decides only what came since.
fn MergeDecide g:
    let call = [[(SelfCall g.name, [[(XVar "v")]])]]
    let takeL = DoLet (PaBind "left"), (XMethod (XField XSelf, "{Or g.inputs[0], ""}"), "take", [[XCx]])
    let takeR = DoLet (PaBind "right"), (XMethod (XField XSelf, "{Or g.inputs[1], ""}"), "take", [[XCx]])
    let right = DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "v"]]), (XVar "right"), call, [[]]
    DoBlock [[takeL, takeR, (DoIfLet (PaCtor (RefRuntime "std::Some"), [[PaBind "v"]]), (XVar "left"), call, [[right]])]]
