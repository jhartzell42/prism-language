# `Lower.Node.Static`, a child module of `Lower.Node`.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit r
use Lower.Node.*
use Lower.Node.Def.*
use Lower.Node.Elements.*
use Lower.Node.Dynamics.*
use Lower.Node.Finish.*
use Lower.Node.Keyed.*
use Lower.Node.Switch.*
use Syntax.*
use Syntax.Decls.*
use Syntax.Lexer.*
use Syntax.Lexer.Chars.*
use Syntax.Lexer.Layout.*
use Syntax.Lexer.Words.*
use Syntax.Lexer.Literals.*
use Syntax.Lexer.Templates.*
use Syntax.Lexer.Corpus.*
use Check.Errors.*
use Check.Types.*
use Check.Types.Recording.*
use Check.Types.Unify.*
use Check.Types.Schemes.*
use Check.Types.Colors.*
use Check.Env.*
use Check.Env.Names.*
use Check.Env.Reading.*
use Check.Env.Decls.*
use Check.Env.Traits.*
use Check.Typed.*
use Check.Typed.Print.*
use Lower.*
use Lower.Types.*
use Lower.Expr.*
use Lower.Patterns.*
use Lower.Templates.*
use Lower.Functions.*
use Lower.Jobs.*
use Lower.Program.*
use Lower.Model.*

# ---------------------------------------------------------------------------------------
# Widgets applied in a static position: transparent (Semantics ch. 8), so their places
# take numbers in the caller's sequence, and inlined into the caller's node
# ---------------------------------------------------------------------------------------

WidgetLine: unbounded fn Wx, Env, Env, Expr, ?Bn -> ((Wx, Wres))
fn WidgetLine wx, benv, menv, e, ?bound:
    let lx = wx.lx
    let ((callee, args)) = match e.kind:
        ECall c, xs, ignore, ignore: ((c, xs))
        otherwise: ((e, [[]]))
    let qk = match callee.kind:
        EName n:
            let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
            Or ?q, ""
        otherwise: ""
    let ?target = match ?bound:
        ? (BnEv er, ignore): ? er.node
        otherwise: nil
    let ?param = match callee.kind:
        EName n: if (Len n.path) == 1: menv.names[SNameKey n] else: nil
        otherwise: nil
    match ?param:
        ? (BnWidget x, cbenv, cmenv, clx): ApplyWidgetParam wx, x, cbenv, cmenv, clx, (Len args)
        otherwise: WidgetCall wx, benv, menv, e, ?bound, qk, args, ?target

# A widget parameter applied (`@child` as a statement): its argument lowered here, in its
# caller's environments and context, so its places take this node's next positions
# (transparent, Semantics ch. 8). A blueprint parameter applied to arguments is not
# lowered yet.
ApplyWidgetParam: unbounded fn Wx, Expr, Env, Env, Lx, Nat -> ((Wx, Wres))
fn ApplyWidgetParam wx, x, cbenv, cmenv, clx, nargs:
    if nargs > 0:
        let wx2 = update wx:
            &_.build <= Push &_.build, (RefusalDo "a widget parameter applied to arguments")
        ((wx2, WrUnit))
    else: if wx.depth > 32: ((wx, WrUnit))
    else:
        let lx = wx.lx
        let inner = update wx:
            &_.lx <= clx
            &_.depth <= &_.depth + 1
        let ((done, res)) = BuildLine inner, cbenv, cmenv, x, nil
        let back = update done:
            &_.lx <= lx
            &_.depth <= wx.depth
        ((back, res))

# A widget block in a static position, `@widget:` applied: its statements lowered into this
# node in a scope of their own.
InlineBlock: unbounded fn Wx, Env, Env, Block, Lx -> ((Wx, Wres))
fn InlineBlock wx, benv, menv, b, lx:
    let inner = update wx:
        &_.result <= WrUnit
    let done = BlockInto inner, benv, menv, b
    let back = update done:
        &_.result <= wx.result
    ((back, done.result))

WidgetCall: unbounded fn Wx, Env, Env, Expr, ?Bn, Text, [Arg], ?Nat -> ((Wx, Wres))
fn WidgetCall wx, benv, menv, e, ?bound, qk, args, ?target:
    let lx = wx.lx
    match qk:
        "Prelude.@started": StartedLine wx, ?bound
        "Prelude.@Switch": SwitchLine wx, menv, args
        "Prelude.@Flatten": FlattenLine wx, menv, args, ?bound
        "Prelude.@Defer": DeferLine wx, menv, args, e, ?target
        "Prelude.@Distinct": DistinctLine wx, menv, args, e, ?bound
        "Prelude.@Run": RunLine wx, benv, args, e, ?target
        "Prelude.@Machine": MachineLine wx, benv, menv, args, e, ?target
        "Prelude.@HostDocument": HostLine wx, benv, menv, HostEach, args, ?bound
        "Prelude.@HostSome": HostLine wx, benv, menv, HostSome, args, ?bound
        otherwise: match lx.g.vals[qk]:
            ? v: InlineWidget wx, benv, menv, qk, v, args, e
            nil:
                let wx2 = update wx:
                    &_.build <= Push &_.build, (RefusalDo "a widget this back end does not lower yet")
                ((wx2, WrUnit))

# A host (claude/backend.md, "Hosting"; prism_rtl's `host`; pick HO): the child, a named
# widget or a widget parameter's argument, is inlined into this node in a scope of its own,
# `k`, its places counted from 0 and keyed by their path relative to the child; they go to no
# document. The host is a `for p, e <- $doc` in this node: `$doc` is the getter `host_k_doc`
# (every child place's level, a dynamic within the tick whose reads are everything the
# child's places, builders and generations read, so a write behind any of them marks the
# host's readers and rows and fires `!Updated $doc`), its rows are prism_rtl's `HostRow`s
# built by the ordinary builder from the document after the tick (R7, R8), and the way back
# is the typed dispatch `host_k_answer` from a child place's path into the child's input
# method. The node holds the host as prism_rtl's `Host` (the supplier, the rows, the two
# methods), linked to the node once it is made, since a child place's first value asks the
# host before then. The child's result is the line's first part (`WrHosted`), the document
# the second.
# The two host forms (`@HostDocument`, and `@HostSome`, whose `nil` forwards).
type HostForm = choice:
    HostEach
    HostSome
derive ^Eq, ^Show

HostLine: unbounded fn Wx, Env, Env, HostForm, [Arg], ?Bn -> ((Wx, Wres))
fn HostLine wx, benv, menv, form, args, ?bound:
    let lx = wx.lx
    let pos = wx.pos
    let k = (Len wx.scopes) + 1
    let hf = "host_{k}"
    let rowsName = "{hf}_rows"
    let docGetter = "{hf}_doc"
    let wx1 = update wx:
        &_.taken <= Append &_.taken, [[hf, rowsName, docGetter, "{docGetter}_now", "{docGetter}_snap", "{docGetter}_direct", "{docGetter}_publish", "{hf}_answer", "{hf}_moved"]]
    let named = match args[1]:
        ? sup: IsWidgetName sup.value
        nil: False
    match ((args[0], args[1])):
        ((? ignore, ? ignore)) if named:
            let wx2 = update wx1:
                &_.pos <= NextPos &_.pos
                &_.build <= Push &_.build, (RefusalDo "a named widget function as a host's supplier (gap NS): a lambda supplier is lowered, a widget function is not a value")
            ((wx2, (WrHosted WrUnit, (BnLocal XUnit, Owned, OutUnit))))
        ((? child, ? sup)):
            # the supplier's dynamic answers (`@ $d`, round 3 DY): a getter of this node per
            # dynamic, read through the owner's link, and a port each marks
            let ((wxd, dynEnv, dynLets)) = DynamicAnswers wx1, benv, menv, hf, sup.value
            let offered = Own (ValueOf lx, dynEnv, sup.value)
            let supplier0 = match form:
                HostEach: offered
                HostSome: XCall "prism_rtl::forward_on_none", [[offered]]
            let supplier = if (Len dynLets) == 0: supplier0 else: XBlock dynLets, supplier0
            # the scope the host's rows build in: the World's, or the enclosing host's
            let enclosing = if Emits wx, pos: XNone else: XCtor "Some", [[(XCast (XClone (XVar (HostLocal wx, pos))), hostOfTy)]]
            let made = XCall "prism_rtl::Host::new", [[(PlaceAt wx, "", pos), (XClone (XVar rowsName)), supplier, enclosing, (XPath "{wx.node}::{hf}_answer")]]
            let hostTy = OutRc (OutNamed "prism_rtl::Host", [[elemTy, answerTy, (OutNamed wx.node, [[]])]])
            let rowsTy = OutNamed "prism_rtl::Rows", [[elemTy, answerTy]]
            # the document is `$(Path ==> $Elem c)` (Jimmy, 6 November 2026): the owner keeps
            # its outer as one structural dynamic (`HostDoc`: each place's dynamic for the
            # program, each place's entry for the host's own rows), taken when a place came or
            # went; each place's entry is its own structural dynamic (`Entry`)
            let docTy = OutMap OutPath, (OutDyn elemTy)
            let directTy = OutMap OutPath, entryTy
            let what = "the document of the child hosted at place {PlaceText pos}"
            let wx2 = update wxd:
                &_.pos <= NextPos &_.pos
                &_.lets <= Append &_.lets, [[(DoLet (PaTyped (PaBind rowsName), rowsTy), (XCall "Rc::new", [[(XCall "RefCell::new", [[(XCall "Map::new", [[]])]])]])), (DoLet (PaBind hf), made)]]
                &_.fields <= Append &_.fields, [[((hf, hostTy, "the host at place {PlaceText pos}: its supplier, its rows, and the way back into its child (pick HO)")), ((rowsName, rowsTy, "the rows of the host at place {PlaceText pos}: `for p, e <- $doc`, one supplier blueprint per child place")), (("{rowsName}_from", (OutCell directTy), "the places the rows of the host at place {PlaceText pos} were last built from")), (("{docGetter}_snap", (OutSnapshot hostDocTy), "`$doc` of the host at place {PlaceText pos}, its outer, a structural dynamic: its snapshots, the places and the lagged dynamic (pick ST)"))]]
                &_.moves <= Append &_.moves, [[((hf, (XClone (XVar hf)))), ((rowsName, (XClone (XVar rowsName))))]]
                &_.inits <= Append &_.inits, [[(("{docGetter}_snap", (XCall "Snapshot::new", [[XStr what]]))), (("{rowsName}_from", (XCall "RefCell::new", [[(XCall "Map::new", [[]])]])))]]
                &_.hosts <= Push &_.hosts, HostDef(pos=pos, name=hf, scope=k)
                &_.snaps <= Push &_.snaps, SnapDef(name=docGetter, live="{docGetter}_now", ty=hostDocTy, eq=True, builder=rowsName, before=True, what=what)
                &_.getters <= Append &_.getters, [[(MethDef(name=docGetter, recv=RecvRef, params=[[]], cx=CxRef, ret=docTy, body=[[]], tail=(XField (XMethod (XField XSelf, "{docGetter}_snap"), "get", [[XCx]]), "doc"), doc="The document of the child hosted at place {PlaceText pos}, `$doc`, its outer a structural dynamic (pick ST): one tick behind the child's places, the snapshot of the tick before the tick the read point is after; each entry the place's own dynamic.")), (MethDef(name="{docGetter}_direct", recv=RecvRef, params=[[]], cx=CxRef, ret=directTy, body=[[]], tail=(XField (XMethod (XField XSelf, "{docGetter}_snap"), "current", [[XCx]]), "places"), doc="The places of the child hosted at place {PlaceText pos}, not the lagged `$doc`: the snapshot taken in this tick's construction step, the places as the tick opened during propagation. The host's own `for` reads it, so a newborn child place gets its row in the tick it is born (pick ST)."))]]
                &_.scopes <= Push &_.scopes, hf
                &_.builders <= Push &_.builders, ForDef(name=rowsName, pos=pos, at=(PlaceAt wx, "self", pos), keyTy=OutPath, valueTy=entryTy, rowNode="prism_rtl::HostRow::<crate::Elem, crate::Answer>", keyed=True, source="{docGetter}_direct", parent=(XClone (XField XSelf, hf)), passed=[[]], moved=(Or (?HostedRows wx), ""))
                &_.buildHolds <= AddRead &_.buildHolds, (OwnRead "{docGetter}_now")
                &_.fallible <= True
            let inner = update wx2:
                &_.pos <= ScopePos k
                &_.result <= WrUnit
            let ((done, res)) = BuildLine inner, benv, menv, child.value, nil
            # the outer moves only when a place of the child came or went: its builders and
            # generations tell the host so (`host_k_moved`), and no write behind a place's
            # level marks it, since each place's entry is its own
            let childPlaces = Drop done.places, (Len wx2.places)
            let InScope = \|p| p.scope == k
            let getter = HostDocGetter "{docGetter}_now", pos, (Filter childPlaces, \|pl| InScope pl.pos), (Filter (Drop done.builders, (Len wx2.builders)), \|b| InScope b.pos), (Filter (Drop done.gens, (Len wx2.gens)), \|gd| InScope gd.pos)
            let back = update done:
                &_.pos <= wx2.pos
                &_.result <= wx.result
                &_.getters <= Push &_.getters, getter
                &_.dynReads <= Insert &_.dynReads, "{docGetter}_now", [[]]
            let docBn = BnDyn (XMethod (XSelf), docGetter, [[XCx]]), [[OwnRead docGetter]], docTy
            ((back, (WrHosted res, docBn)))
        otherwise:
            let wx2 = update wx1:
                &_.pos <= NextPos &_.pos
                &_.build <= Push &_.build, (RefusalDo "a host without its child or its supplier")
            ((wx2, (WrHosted WrUnit, (BnLocal XUnit, Owned, OutUnit))))

# A widget function's name as a value (`@Supply`), which lowering has no value for.
IsWidgetName: fn Expr -> Bool
fn IsWidgetName e = match e.kind:
    EName n: HasPrefix (SNameKey n), "@"
    EGroup x: IsWidgetName x
    otherwise: False

# A supplier's dynamic answers (`@ $d`, `$d` a hold or a derived dynamic of this node; round
# 3 DY): each `@ x` of the supplier whose `x` is a dynamic that is not a constant gets a
# getter of this node, `host_k_dyn_j`, that reads it at the read point, and a port,
# `host_k_dyn_j_port`, fired by a write behind it (`HoldWritten`), so the blueprint's
# updates push the child's place the next tick. The supplier is made before the node, so it
# reads the getter through the owner's link, `host_k_owner`, linked at the build; while the
# node is being made (an early row's first value) it reads the dynamic's value at the build,
# `InitEnv`. Bound for `PureBlueprint` under `#owner` and `#dyn{span}`; the locals the
# supplier's closure moves in are cloned first (`dynLets`). A dynamic answer reading what has
# no value at the build (a pushed place, a structural dynamic, a later `let`) is refused
# there, loudly.
DynamicAnswers: unbounded fn Wx, Env, Env, Text, Expr -> ((Wx, Env, [Do]))
fn DynamicAnswers wx, benv, menv, hf, sup:
    let lx = wx.lx
    let dyns = Fold (ExprsIn sup), [[]], \|acc, x| match x.kind:
        EFreeSigil "@", y: match ?DynamicAnswer lx, y:
            ? d: Push acc, ((y, d))
            nil: acc
        otherwise: acc
    if (Len dyns) == 0: ((wx, benv, [[]]))
    else:
        let owner = "{hf}_owner"
        let wx1 = update wx:
            &_.taken <= Push &_.taken, owner
            &_.lets <= Push &_.lets, (DoLet (PaBind owner), (XCall "prism_rtl::Link::<{wx.node}>::new", [[]]))
            &_.build <= Push &_.build, (DoExpr (XMethod (XVar owner), "link", [[(XRef (XVar "node"))]]))
        let env0 = Bind benv, "#owner", (BnLocal (XVar owner), Owned, OutUnit)
        let lets0 = [[(DoLet (PaBind owner), (XClone (XVar owner)))]]
        Fold (Range0 (Len dyns)), ((wx1, env0, lets0)), \|((w, en, ls)), j| match dyns[j]:
            ? ((y, d)):
                let name = "{hf}_dyn_{j + 1}"
                let port = "{name}_port"
                let ((ex, reads)) = DynamicExpr w, menv, d
                let t = OutTyOf lx, (Peel (TypeAt lx, d.span))
                if not (AllInited w, reads): ((w, en, ls))
                else:
                    let w2 = update w:
                        &_.taken <= Append &_.taken, [[name, port]]
                        &_.getters <= Push &_.getters, (MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=ex, doc="The host at `{hf}`'s dynamic answer `{SrcText lx, lx.file, y.span}`, read at the read point (round 3 DY)."))
                        &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind port), (OutRc (OutPort OutUnit))), (XCall "Rc::new", [[(XCall "Port::new", [[]])]]))
                        &_.fields <= Push &_.fields, ((port, (OutRc (OutPort OutUnit)), "the dynamic answer `{name}` moved: its blueprints push the child's place next tick"))
                        &_.moves <= Push &_.moves, ((port, (XClone (XVar port))))
                        &_.dynAnswers <= Push &_.dynAnswers, ((name, reads))
                    ((w2, (Bind en, "#dyn{DynKey y}", (BnLocal (XVar name), Owned, t)), (Push ls, (DoLet (PaBind port), (XClone (XVar port))))))
            nil: ((w, en, ls))

# The dynamic a supplier's `@ x` answers with, when `x` is a dynamic that is not a constant:
# `x` itself, or the `d` of `$ d` when `d` is a dynamic already.
?DynamicAnswer: fn Lx, Expr -> ?Expr
fn ?DynamicAnswer lx, x:
    if (LayerOf (TypeAt lx, x.span)) != LyDyn: nil
    else: match x.kind:
        EFreeSigil "$", inner: if (LayerOf (TypeAt lx, inner.span)) == LyDyn: ? inner else: nil
        otherwise: ? x

# The key a supplier's `@ x` is bound under in the supplier's environment.
DynKey: fn Expr -> Text
fn DynKey x = "{x.span.start}:{x.span.end}"

# The hosted child's places as the owner gathers them, `host_k_doc_now` (pick HO): each
# place's entry, keyed by its path relative to the child: the places in the child's scope,
# and under each of its `for`s and `rebuild`s their rows' own. Only the snapshot of the
# outer reads it, in the construction step of a tick in which a place came or went (pick
# ST).
HostDocGetter: fn Text, Pos, [Place], [ForDef], [GenDef] -> MethDef
fn HostDocGetter name, pos, places, builders, gens:
    let start = DoLet (PaTyped (PaMut "doc"), hostDocTy), (XCall "prism_rtl::HostDoc::new", [[]])
    let body = DocumentBody MapInsert, places, builders, gens
    MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=hostDocTy, body=(Append [[start]], body), tail=(XVar "doc"), doc="The places of the child hosted at place {PlaceText pos}: each place's entry by its path relative to the child (pick HO). Read only by the snapshot of `$doc`'s outer (pick ST).")

# A structural dynamic's getter (pick ST): its snapshot at the read point.
SnapGetter: fn Text, OutTy, Text -> MethDef
fn SnapGetter name, t, doc = MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=(XMethod (XField XSelf, "{name}_snap"), "get", [[XCx]]), doc=doc)

# `@started`: takes a number, makes no place, fires in the tick after the build.
StartedLine: fn Wx, ?Bn -> ((Wx, Wres))
fn StartedLine wx, ?bound:
    let wx1 = update wx:
        &_.pos <= NextPos &_.pos
    let ((id, wx2)) = match ?bound:
        ? (BnEv er, ignore): ((er.node, wx1))
        otherwise:
            let ((nm, w)) = FreshName wx1, "started"
            AddGn w, nm, OutUnit, GnStarted, 0
    let wx3 = update wx2:
        &_.started <= Push &_.started, id
    ((wx3, (WrEv (EvRefOf wx3, id))))

# `@Defer !e`: a `Defer` field armed by each firing; the next tick's `deferred` fires it.
DeferLine: unbounded fn Wx, Env, [Arg], Expr, ?Nat -> ((Wx, Wres))
fn DeferLine wx, menv, args, e, ?target:
    let lx = wx.lx
    let t = OutTyOf lx, (OutOf (TypeAt lx, e.span))
    let ((field, wx1)) = FreshName wx, "deferred"
    let ((id, wx2)) = match ?target:
        ? n: ((n, wx1))
        nil: AddGn wx1, "{field}_fired", t, GnDeferred, 0
    let wx3 = AddFieldLast wx2, field, (OutDefer t), "`@Defer`", (XCall "Defer::new", [[]])
    let wx4 = update wx3:
        &_.defers <= Push &_.defers, ((field, id))
    match args[0]:
        ? a:
            let ((r, wx5)) = EventRef wx4, menv, a.value
            (((Connect wx5, r, (SkArm field)), (WrEv (EvRefOf wx5, id))))
        nil: ((wx4, (WrEv (EvRefOf wx4, id))))

# `$y <- @Distinct $x` (Jimmy, 5 November, reversing Appendix B's D-DT): `$x`'s value,
# whose update event fires only when it changed. A hold of an option, `None` until the
# build sets it to `$x`'s value after the tick (as `@Flatten` adopts its first inner;
# a read before that reads `$x`),
# written by `$x`'s `!Updated` only when the value differs from the one it holds
# (`SkDistinct`); its readers read the hold, so they are marked only then.
DistinctLine: unbounded fn Wx, Env, [Arg], Expr, ?Bn -> ((Wx, Wres))
fn DistinctLine wx, menv, args, e, ?bound:
    let lx = wx.lx
    match args[0]:
        nil:
            let wx2 = update wx:
                &_.build <= Push &_.build, (RefusalDo "an `@Distinct` without its dynamic")
            ((wx2, WrUnit))
        ? a:
            # the type of the values: its argument's, one layer peeled
            let t = OutTyOf lx, (Peel (TypeAt lx, a.value.span))
            let ((name, wx1)) = match ?bound:
                ? (BnHold f, ignore): ((f, wx))
                otherwise: FreshName wx, "distinct"
            let kept = "{name}_kept"
            let source = "{name}_source"
            let ((ex, reads)) = DynamicExpr wx1, menv, a.value
            let first = DoExpr (XMethod (XField (XVar "node"), kept), "set", [[(XCtor "Some", [[(XMethod (XVar "node"), source, [[XCx]])]]), XCx]])
            # before the build sets it (a builder of the same node reading it first), its
            # source's value, which is the same
            let sample = XMatch (XMethod (XField XSelf, kept), "get", [[XCx]]), [[XArm(pat=(PaCtor "Some", [[PaBind "v"]]), conds=[[]], body=(XVar "v")), XArm(pat=(PaUnit "None"), conds=[[]], body=(XMethod (XSelf), source, [[XCx]]))]], False, t
            let wx2 = update wx1:
                &_.taken <= Append &_.taken, [[kept, source]]
                &_.fields <= Push &_.fields, ((kept, (OutHold (OutOpt t)), "`@Distinct`'s value: its source's, written only when it changes"))
                &_.moves <= Push &_.moves, ((kept, (XCall "Hold::new", [[XNone, XCx]])))
                &_.build <= Push &_.build, first
                &_.getters <= Append &_.getters, [[(MethDef(name=source, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=ex, doc="`@Distinct`'s source, read at the build.")), (MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=sample, doc="`@Distinct`'s dynamic: the value it holds at the read point."))]]
                &_.dynReads <= Insert (Insert &_.dynReads, name, [[OwnRead kept]]), source, reads
            let ((r, wx3)) = UpdatedEvent wx2, menv, args, t
            (((Connect wx3, r, (SkDistinct kept)), (WrDyn (XMethod (XSelf), name, [[XCx]]), [[OwnRead kept]], t)))

# `@Run F, x` (Semantics Appendix B, over `@started`, `@Defer` and `@Machine`): it takes
# a number for its `@started`; the job is a `Hold`, the merge `!started <| !again` cycles
# it once per tick, a `More` arms the `@Defer`, a `Finished` fires the result.
RunLine: unbounded fn Wx, Env, [Arg], Expr, ?Nat -> ((Wx, Wres))
fn RunLine wx, benv, args, e, ?target:
    let lx = wx.lx
    let t = OutTyOf lx, (OutOf (TypeAt lx, e.span))
    let ((p, wx1)) = FreshName wx, "run"
    let wx2 = update wx1:
        &_.pos <= NextPos &_.pos
        &_.taken <= Append &_.taken, [["{p}_job", "{p}_again", "{p}_started", "{p}_turn"]]
    let start = match args[0]:
        ? a: match a.value.kind:
            EName n:
                let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
                XPath (StartPath lx, (Or ?q, ""))
            otherwise: Refusal "an `@Run` of a function value that is not a name"
        nil: Refusal "an `@Run` without its function"
    let x = match args[1]:
        ? a: Own (ValueOf lx, benv, a.value)
        nil: XUnit
    let wx3 = AddField wx2, "{p}_job", (OutHold (OutJob t)), "`@Run`'s job (`@Machine`'s state)", (XCall "Hold::new", [[(XApply start, [[x]]), XCx]])
    let wx4 = AddFieldLast wx3, "{p}_again", (OutDefer OutUnit), "`@Run`'s `!again`", (XCall "Defer::new", [[]])
    let ((s, wx5)) = AddGn wx4, "{p}_started", OutUnit, GnStarted, 0
    let ((a, wx6)) = AddGn wx5, "{p}_again", OutUnit, GnDeferred, 0
    let ((m, wx7)) = Merge wx6, "{p}_turn", OutUnit, (EvRefOf wx6, s), (EvRefOf wx6, a)
    let ((res, wx8)) = match ?target:
        ? n: ((n, wx7))
        nil: AddGn wx7, "{p}_done", t, GnNamed, 0
    let wx9 = update (Connect wx8, (EvRefOf wx8, m), (SkCycle "{p}_job", "{p}_again", res)):
        &_.started <= Push &_.started, s
        &_.defers <= Push &_.defers, (("{p}_again", a))
    ((wx9, (WrEv (EvRefOf wx9, res))))

# `@Machine step, init, !a` (Semantics Appendix B): the state a hold; each firing of
# `!a` steps it, writes the new state and fires the output when the step gives one. The
# step is a named function; a function value is not lowered yet.
MachineLine: unbounded fn Wx, Env, Env, [Arg], Expr, ?Nat -> ((Wx, Wres))
fn MachineLine wx, benv, menv, args, e, ?target:
    let lx = wx.lx
    let t = OutTyOf lx, (OutOf (TypeAt lx, e.span))
    let ((f, wx1)) = FreshName wx, "machine"
    let step = match args[0]:
        ? a: match a.value.kind:
            EName n:
                let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
                match ?q:
                    ? q: ValuePath lx, q
                    nil: ""
            otherwise: ""
        nil: ""
    match ((step, args[1], args[2])):
        ((sp, ? init, ? ev)) if sp != "":
            let st = OutTyOf lx, (Peel (TypeAt lx, init.value.span))
            let x = Own (ValueOf lx, benv, init.value)
            let wx2 = AddField wx1, "{f}_state", (OutHold st), "`@Machine`'s state", (XCall "Hold::new", [[x, XCx]])
            let ((out, wx3)) = match ?target:
                ? n: ((n, wx2))
                nil: AddGn wx2, "{f}_fired", t, GnNamed, 0
            let ((r, wx4)) = EventRef wx3, menv, ev.value
            (((Connect wx4, r, (SkMachine "{f}_state", sp, out)), (WrEv (EvRefOf wx4, out))))
        otherwise:
            let wx2 = update wx1:
                &_.build <= Push &_.build, (RefusalDo "an `@Machine` whose step is not a named function")
            ((wx2, WrUnit))

# A user widget inlined: its parameters bound to the arguments by layer (an event to the
# caller's event, a dynamic to its reader, a plain value to a field), its block lowered
# into the caller's node with its positions in the caller's sequence.
InlineWidget: unbounded fn Wx, Env, Env, Text, ValInfo, [Arg], Expr -> ((Wx, Wres))
fn InlineWidget wx, benv, menv, qk, v, args, e:
    let lx = wx.lx
    let clauses = ClausesOf lx.g, qk
    let ?w = ?WidgetDeclOf lx.g, qk
    let ((params, ?body)) = match ?w:
        ? wd: (([[]], ? wd.body))
        nil: match clauses:
            [[c]]: match c.body:
                BodyBlock b: ((c.params, ? b))
                BodyExpr x: ((c.params, ? (Block(stmts=[[Stmt(kind=(SExpr x), span=x.span)]], inline=True, span=x.span))))
            otherwise: (([[]], nil))
    match ?body:
        nil:
            if (Len clauses) == 0:
                # A widget with no body, a builtin of the prelude this back end does not
                # lower (`@HostSome`, `@Element`, `@Machine`, ...): refused, and not taken
                # for a widget of several clauses, whose generation would lower the call
                # again, without end.
                let wx2 = update wx:
                    &_.build <= Push &_.build, (RefusalDo "the builtin widget {BareName qk}")
                ((wx2, WrUnit))
            else:
                # A widget of several clauses in a static position: the clause is chosen at
                # the build from the arguments, which are plain, so it is a generation built
                # once (a `rebuild` whose source never changes), each clause a row
                # (`ClauseRow`).
                match args[0]:
                    ? a:
                        let call = Block(stmts=[[Stmt(kind=(SExpr e), span=e.span)]], inline=True, span=e.span)
                        ClauseWidgetLine wx, menv, a.value, call, qk, v, e
                    nil:
                        let wx2 = update wx:
                            &_.build <= Push &_.build, (RefusalDo "a widget of several clauses that takes no arguments")
                        ((wx2, WrUnit))
        ? body:
            if wx.depth > 16: ((wx, WrUnit))
            else:
                let lxc = InModuleAt lx, v.file, v.home, lx.site
                let ptys = match v.scheme.ty:
                    TyFn ignore, ps, ignore: ps
                    otherwise: [[]]
                let ((wx1, be1, me1)) = Fold (Range0 (Len params)), ((wx, emptyEnv, emptyEnv)), \|((w, be, me)), i|
                    let p = Or params[i], dummyPat
                    let nkey = PlainBinder lxc, p
                    let pty = Or ptys[i], TyErr
                    match args[i]:
                        nil: ((w, be, me))
                        ? a: BindParam w, benv, menv, be, me, nkey, pty, a.value
                let inner = update wx1:
                    &_.lx <= lxc
                    &_.depth <= &_.depth + 1
                    &_.result <= WrUnit
                let done = BlockInto inner, be1, me1, body
                let back = update done:
                    &_.lx <= lx
                    &_.depth <= wx.depth
                    &_.result <= wx.result
                ((back, done.result))

?WidgetDeclOf: fn G, Text -> ?WidgetDecl
fn ?WidgetDeclOf g, qk = Fold g.defs, nil, \|?found, d| if d.qk == qk: ?DefWidget d, ?found else: ?found

?DefWidget: fn Def, ?WidgetDecl -> ?WidgetDecl
fn ?DefWidget d, ?other = match d.body:
    DbWidget w: ? w
    otherwise: ?other

# One parameter of an inlined widget, bound in the callee's environments from an argument
# lowered in the caller's.
BindParam: unbounded fn Wx, Env, Env, Env, Env, Text, Ty, Expr -> ((Wx, Env, Env))
fn BindParam wx, cbenv, cmenv, be, me, nkey, pty, arg:
    let lx = wx.lx
    let t = OutTyOf lx, (Peel pty)
    match LayerOf pty:
        LyBlueprint:
            let b = BnWidget arg, cbenv, cmenv, lx
            ((wx, (Bind be, nkey, b), (Bind me, nkey, b)))
        LyEv:
            let ((r, wx2)) = EventRef wx, cmenv, arg
            let b = BnEv r, t
            ((wx2, (Bind be, nkey, b), (Bind me, nkey, b)))
        LyDyn:
            let ((ex, reads)) = DynamicExpr wx, cmenv, arg
            let b = BnDyn ex, reads, t
            ((wx, (Bind be, nkey, b), (Bind me, nkey, b)))
        otherwise:
            let ((rs, wx2)) = FreshName wx, (Snake nkey)
            let v = Own (ValueOf lx, cbenv, arg)
            let wx3 = update wx2:
                &_.lets <= Push &_.lets, (DoLet (PaBind rs), v)
                &_.fields <= Push &_.fields, ((rs, t, "`{nkey}`"))
                &_.inits <= Push &_.inits, ((rs, (XClone (XVar rs))))
            let ((be2, me2)) = BindPlain be, me, nkey, rs, t
            ((wx3, be2, me2))
