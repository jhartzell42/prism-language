# `Lower.Node.Static`, a child module of `Lower.Node`.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit r
use Lower.Node.*
use Lower.Node.Def.*
use Lower.Node.Elements.*
use Lower.Node.Dynamics.*
use Lower.Node.Finish.*
use Lower.Node.Keyed.*
use Lower.Node.Switch.*
use Syntax.*
use Syntax.Decls.*
use Syntax.Lexer.*
use Syntax.Lexer.Chars.*
use Syntax.Lexer.Layout.*
use Syntax.Lexer.Words.*
use Syntax.Lexer.Literals.*
use Syntax.Lexer.Templates.*
use Syntax.Lexer.Corpus.*
use Check.Errors.*
use Check.Types.*
use Check.Types.Recording.*
use Check.Types.Unify.*
use Check.Types.Schemes.*
use Check.Types.Colors.*
use Check.Env.*
use Check.Env.Names.*
use Check.Env.Reading.*
use Check.Env.Decls.*
use Check.Env.Traits.*
use Check.Typed.*
use Check.Typed.Print.*
use Lower.*
use Lower.Types.*
use Lower.Expr.*
use Lower.Patterns.*
use Lower.Templates.*
use Lower.Functions.*
use Lower.Jobs.*
use Lower.Program.*
use Lower.Model.*

# ---------------------------------------------------------------------------------------
# Widgets applied in a static position: transparent (Semantics ch. 8), so their places
# take numbers in the caller's sequence, and inlined into the caller's node
# ---------------------------------------------------------------------------------------

WidgetLine: unbounded fn Wx, Env, Env, Expr, ?Bn -> ((Wx, Wres))
fn WidgetLine wx, benv, menv, e, ?bound:
    let lx = wx.lx
    let ((callee, args)) = match e.kind:
        ECall c, xs, ignore, ignore: ((c, xs))
        otherwise: ((e, [[]]))
    let qk = match callee.kind:
        EName n:
            let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
            Or ?q, ""
        otherwise: ""
    let ?target = match ?bound:
        ? (BnEv er, ignore): ? er.node
        otherwise: nil
    let ?param = match callee.kind:
        EName n: if (Len n.path) == 1: menv.names[SNameKey n] else: nil
        otherwise: nil
    # a blueprint a `let` of the block names (`WithElementLets`): its expression, built
    # here in this line's environments
    let ?named = match callee.kind:
        EName n: if (Len n.path) == 1 and (Len args) == 0: menv.names["{SNameKey n}#blueprint"] else: nil
        otherwise: nil
    match ?named:
        ? (BnWidget x, ignore, ignore, ignore): LetBlueprintLine wx, benv, menv, x, e, ?bound
        otherwise: match ?param:
            ? (BnWidget x, cbenv, cmenv, clx): ApplyWidgetParam wx, benv, menv, x, cbenv, cmenv, clx, e, args, ?bound
            ? (BnLocalWidget b): LocalWidgetLine wx, benv, menv, b, e
            otherwise: WidgetCall wx, benv, menv, e, ?bound, qk, args, ?target

# A widget parameter applied (`@child` as a statement): its argument lowered here, in its
# caller's environments and context, so its places take this node's next positions
# (transparent, Semantics ch. 8). It needs no bound of its own: the argument is the
# caller's text, one frame out, so an application recurses only through a widget's
# recursion, which `InlineWidget` bounds.
# A widget function parameter applied to arguments (`Inner 1`, `Inner: fn Nat -> @unit`
# given `@Row`): the function the argument names, applied here to the line's arguments,
# which are read in this line's environments; a parameter handed on names its own
# argument in turn. A function value that is no name is not lowered yet.
ApplyWidgetParam: unbounded fn Wx, Env, Env, Expr, Env, Env, Lx, Expr, [Arg], ?Bn -> ((Wx, Wres))
fn ApplyWidgetParam wx, benv, menv, x, cbenv, cmenv, clx, e, args, ?bound:
    if (Len args) > 0: match (Ungrouped x).kind:
        EName n: match (if (Len n.path) == 1: cmenv.names[SNameKey n] else: nil):
            ? (BnWidget x2, cbenv2, cmenv2, clx2): ApplyWidgetParam wx, benv, menv, x2, cbenv2, cmenv2, clx2, e, args, ?bound
            otherwise:
                let ((?q, ignore)) = ResolveValue clx.g, clx.home, n
                let ?target = match ?bound:
                    ? (BnEv er, ignore): ? er.node
                    otherwise: nil
                match ?q:
                    ? qk: WidgetCall wx, benv, menv, e, ?bound, qk, args, ?target
                    nil:
                        let wx2 = update wx:
                            &_.build <= Push &_.build, (InternalBugDo "a widget function parameter whose argument names nothing")
                        ((wx2, WrUnit))
        otherwise:
            let wx2 = update wx:
                &_.build <= Push &_.build, (RefusalDo "a widget function parameter applied to arguments whose argument is a function value that is no name")
            ((wx2, WrUnit))
    else:
        let lx = wx.lx
        let inner = update wx:
            &_.lx <= clx
        let ((done, res)) = BuildLine inner, cbenv, cmenv, x, nil
        let back = update done:
            &_.lx <= lx
        ((back, res))

# A blueprint a `let` of the block names, applied (`let @w = @Tile k`, then `@w`): its
# expression built here, in this line's environments, at this node's next positions,
# once per application; its locals take the application's place, as a local widget's do
# (`LocalWidgetLine`).
LetBlueprintLine: unbounded fn Wx, Env, Env, Expr, Expr, ?Bn -> ((Wx, Wres))
fn LetBlueprintLine wx, benv, menv, x, e, ?bound:
    let lx = wx.lx
    let lxi = update lx:
        &_.inlined <= match lx.callIds[PlaceKey lx, e.span]:
            ? id: "{lx.inlined}_{Base32 id}"
            nil: "{lx.inlined}_at{Base32 e.span.start}"
    let inner = update wx:
        &_.lx <= lxi
    let ((done, res)) = BuildLine inner, benv, menv, x, ?bound
    let back = update done:
        &_.lx <= lx
    ((back, res))

# A widget defined in a block (`@line:` and its block) applied: its block lowered here, in
# the environments of the line that applies it (the block's names, as a row of the block
# reads them when the line stands in one), at this node's next positions, once per
# application. Its locals take the application's id as an inlined widget's do, so two
# applications in one build spell them apart.
LocalWidgetLine: unbounded fn Wx, Env, Env, Block, Expr -> ((Wx, Wres))
fn LocalWidgetLine wx, benv, menv, b, e:
    let lx = wx.lx
    let callSpan = match e.kind:
        ECall c, ignore, ignore, ignore: c.span
        otherwise: e.span
    let lxi = update lx:
        &_.inlined <= match lx.callIds[PlaceKey lx, callSpan]:
            ? id: "{lx.inlined}_{Base32 id}"
            # an application the checker gave no id: its place in the source
            nil: "{lx.inlined}_at{Base32 callSpan.start}"
    let inner = update wx:
        &_.lx <= lxi
    let ((done, res)) = InlineBlock inner, benv, menv, b, lxi
    let back = update done:
        &_.lx <= lx
    ((back, res))

# A widget block in a static position, `@widget:` applied: its statements lowered into this
# node in a scope of their own.
InlineBlock: unbounded fn Wx, Env, Env, Block, Lx -> ((Wx, Wres))
fn InlineBlock wx, benv, menv, b, lx:
    let inner = update wx:
        &_.result <= WrUnit
    let done = BlockInto inner, benv, menv, b
    let back = update done:
        &_.result <= wx.result
    ((back, done.result))

WidgetCall: unbounded fn Wx, Env, Env, Expr, ?Bn, Text, [Arg], ?Nat -> ((Wx, Wres))
fn WidgetCall wx, benv, menv, e, ?bound, qk, args, ?target:
    let lx = wx.lx
    match qk:
        "Prelude.@started": StartedLine wx, ?bound
        "Prelude.@Switch": SwitchLine wx, menv, args
        "Prelude.@Flatten": FlattenLine wx, menv, args, ?bound
        "Prelude.@Defer": DeferLine wx, menv, args, e, ?target
        "Prelude.@Later": LaterLine wx, benv, menv, args, e, ?target
        "Prelude.@Distinct": DistinctLine wx, menv, args, e, ?bound
        "Prelude.@PerKey": PerKeyLine wx, menv, args, ?bound
        "Prelude.@Run": RunLine wx, benv, args, e, ?target
        "Prelude.@Machine": MachineLine wx, benv, menv, args, e, ?target
        "Prelude.@HostDocument": HostLine wx, benv, menv, HostEach, args, ?bound
        "Prelude.@HostSome": HostLine wx, benv, menv, HostSome, args, ?bound
        "Prelude.@HostList": HostLine wx, benv, menv, HostList, args, ?bound
        "Prelude.@Element": ElementCallLine wx, benv, menv, args, ?bound
        otherwise: match lx.g.vals[qk]:
            ? v: InlineWidget wx, benv, menv, qk, v, args, e
            nil:
                let wx2 = update wx:
                    &_.build <= Push &_.build, (RefusalDo "a widget this back end does not lower yet")
                ((wx2, WrUnit))

# A host (claude/backend.md, "Hosting"; prism_rtl's `host`; pick HO): the child, a named
# widget or a widget parameter's argument, is inlined into this node in a scope of its own,
# `k`, its places counted from 0 and keyed by their path relative to the child; they go to no
# document. The host is a `for p, e <- $doc` in this node: `$doc` is the getter `host_k_doc`
# (every child place's level, a dynamic within the tick whose reads are everything the
# child's places, builders and generations read, so a write behind any of them marks the
# host's readers and rows and fires `!Updated $doc`), its rows are prism_rtl's `HostRow`s
# built by the ordinary builder from the document after the tick (R7, R8), and the way back
# is the typed dispatch `host_k_answer` from a child place's path into the child's input
# method. The node holds the host as prism_rtl's `Host` (the supplier, the rows, the two
# methods), linked to the node once it is made, since a child place's first value asks the
# host before then. The child's result is the line's first part (`WrHosted`), the document
# the second.
# The host forms: `@HostDocument`; `@HostSome`, whose `nil` forwards; `@HostList`, the Each
# form whose owner also sends answers down by path (prismc's first ruling HL: each firing
# of its event hands each keyed place its answer, decoded by the place's tag, the next
# tick's input, as any computed answer; prism_rtl's `Host::hear`).
type HostForm = choice:
    HostEach
    HostSome
    HostList
derive ^Eq, ^Show

HostLine: unbounded fn Wx, Env, Env, HostForm, [Arg], ?Bn -> ((Wx, Wres))
fn HostLine wx, benv, menv, form, args, ?bound:
    let lx = wx.lx
    let pos = wx.pos
    let k = (Len wx.scopes) + 1
    let hf = "host_{k}"
    let rowsName = "{hf}_rows"
    let docGetter = "{hf}_doc"
    let wx1 = update wx:
        &_.taken <= Append &_.taken, [[hf, rowsName, docGetter, "{docGetter}_now", "{docGetter}_snap", "{docGetter}_direct", "{docGetter}_publish", "{hf}_answer", "{hf}_moved"]]
    let ?supArg = if form == HostList: args[2] else: args[1]
    match ((args[0], ?supArg)):
        ((? child, ? sup)):
            # the supplier's dynamic answers (`@ $d`, round 3 DY): a getter of this node per
            # dynamic, read through the owner's link, and a port each marks
            let ((wxd, dynEnv, dynLets)) = DynamicAnswers wx1, benv, menv, hf, sup.value
            let offered = Own (ValueOf lx, dynEnv, sup.value)
            let supplier0 = match form:
                HostSome: XCall (RefRuntime "prism_rtl::forward_on_none"), [[offered]]
                otherwise: offered
            let heard = match ((form, args[1])):
                ((HostList, ? answers)): [[(DoExpr (XMethod (XVar hf), "hear", [[(Ref (ValueOf lx, dynEnv, answers.value))]]))]]
                otherwise: [[]]
            let supplier = if (Len dynLets) == 0: supplier0 else: XBlock dynLets, supplier0
            # the scope the host's rows build in: the World's, or the enclosing host's
            let enclosing = if Emits wx, pos: XNone else: XCtor (RefRuntime "std::Some"), [[(XCast (XClone (XVar (HostLocal wx, pos))), hostOfTy)]]
            let made = XCall (RefRuntime "prism_rtl::Host::new"), [[(PlaceAt wx, "", pos), (XClone (XVar rowsName)), supplier, enclosing, (XPath (RefChild (SiteRef lx, wx.node), "{hf}_answer"))]]
            let hostTy = OutRc (OutNamed (RefRuntime "prism_rtl::Host"), [[elemTy, answerTy, (OutNamed (SiteRef lx, wx.node), [[]])]])
            let rowsTy = OutNamed (RefRuntime "prism_rtl::Rows"), [[elemTy, answerTy]]
            # the document is `$(Path ==> $Elem c)` (Jimmy, 6 November 2026): the owner keeps
            # its outer as one structural dynamic (`HostDoc`: each place's dynamic for the
            # program, each place's entry for the host's own rows), taken when a place came or
            # went; each place's entry is its own structural dynamic (`Entry`)
            let docTy = OutMap OutPath, (OutDyn elemTy)
            let directTy = OutMap OutPath, entryTy
            let what = "the document of the child hosted at place {PlaceText pos}"
            let wx2 = update wxd:
                &_.pos <= NextPos &_.pos
                &_.lets <= Append (Append &_.lets, [[(DoLet (PaTyped (PaBind rowsName), rowsTy), (XCall (RefRuntime "std::Rc::new"), [[(XCall (RefRuntime "std::RefCell::new"), [[(XCall (RefRuntime "rt::Map::new"), [[]])]])]])), (DoLet (PaBind hf), made)]]), heard
                &_.fields <= Append &_.fields, [[((hf, hostTy, "the host at place {PlaceText pos}: its supplier, its rows, and the way back into its child (pick HO)")), ((rowsName, rowsTy, "the rows of the host at place {PlaceText pos}: `for p, e <- $doc`, one supplier blueprint per child place")), (("{rowsName}_from", (OutCell directTy), "the places the rows of the host at place {PlaceText pos} were last built from")), (("{docGetter}_snap", (OutSnapshot hostDocTy), "`$doc` of the host at place {PlaceText pos}, its outer, a structural dynamic: its snapshots, the places and the lagged dynamic (pick ST)"))]]
                &_.moves <= Append &_.moves, [[((hf, (XClone (XVar hf)))), ((rowsName, (XClone (XVar rowsName))))]]
                &_.inits <= Append &_.inits, [[(("{docGetter}_snap", (XCall (RefRuntime "rt::Snapshot::new"), [[XStr what]]))), (("{rowsName}_from", (XCall (RefRuntime "std::RefCell::new"), [[(XCall (RefRuntime "rt::Map::new"), [[]])]])))]]
                &_.hosts <= Push &_.hosts, HostDef(pos=pos, name=hf, scope=k)
                &_.snaps <= Push &_.snaps, SnapDef(name=docGetter, live="{docGetter}_now", ty=hostDocTy, eq=True, builder=rowsName, before=True, what=what)
                &_.getters <= Append &_.getters, [[(MethDef(name=docGetter, recv=RecvRef, params=[[]], cx=CxRef, ret=docTy, body=[[]], tail=(XField (XMethod (XField XSelf, "{docGetter}_snap"), "get", [[XCx]]), "doc"), doc="The document of the child hosted at place {PlaceText pos}, `$doc`, its outer a structural dynamic (pick ST): one tick behind the child's places, the snapshot of the tick before the tick the read point is after; each entry the place's own dynamic.")), (MethDef(name="{docGetter}_direct", recv=RecvRef, params=[[]], cx=CxRef, ret=directTy, body=[[]], tail=(XField (XMethod (XField XSelf, "{docGetter}_snap"), "current", [[XCx]]), "places"), doc="The places of the child hosted at place {PlaceText pos}, not the lagged `$doc`: the snapshot taken in this tick's construction step, the places as the tick opened during propagation. The host's own `for` reads it, so a newborn child place gets its row in the tick it is born (pick ST)."))]]
                &_.scopes <= Push &_.scopes, hf
                &_.builders <= Push &_.builders, ForDef(name=rowsName, pos=pos, at=(PlaceAt wx, "self", pos), keyTy=OutPath, valueTy=entryTy, rowNode="prism_rtl::HostRow::<crate::Elem, crate::Answer>", keyed=True, source="{docGetter}_direct", parent=(XClone (XField XSelf, hf)), passed=[[]], moved=(Or (?HostedRows wx), ""), replaced=[[]])
                &_.buildHolds <= AddRead &_.buildHolds, (OwnRead "{docGetter}_now")
                &_.fallible <= True
            let inner = update wx2:
                &_.pos <= ScopePos k
                &_.result <= WrUnit
            let ((done, res)) = BuildLine inner, benv, menv, child.value, nil
            # the outer moves only when a place of the child came or went: its builders and
            # generations tell the host so (`host_k_moved`), and no write behind a place's
            # level marks it, since each place's entry is its own
            let childPlaces = Drop done.places, (Len wx2.places)
            let InScope = \|p| p.scope == k
            let getter = HostDocGetter done, "{docGetter}_now", pos, (Filter childPlaces, \|pl| InScope pl.pos), (Filter (Drop done.builders, (Len wx2.builders)), \|b| InScope b.pos), (Filter (Drop done.gens, (Len wx2.gens)), \|gd| InScope gd.pos)
            let back = update done:
                &_.pos <= wx2.pos
                &_.result <= wx.result
                &_.getters <= Push &_.getters, getter
                &_.dynReads <= Insert &_.dynReads, "{docGetter}_now", [[]]
            let docBn = BnDyn (XMethod (XSelf), docGetter, [[XCx]]), [[OwnRead docGetter]], docTy
            ((back, (WrHosted res, docBn)))
        otherwise:
            let wx2 = update wx1:
                &_.pos <= NextPos &_.pos
                &_.build <= Push &_.build, (RefusalDo "a host without its child or its supplier")
            ((wx2, (WrHosted WrUnit, (BnLocal XUnit, Owned, OutUnit))))

# A supplier's dynamic answers (`@ $d`, `$d` a hold or a derived dynamic of this node; round
# 3 DY): each `@ x` of the supplier whose `x` is a dynamic that is not a constant gets a
# getter of this node, `host_k_dyn_j`, that reads it at the read point, and a port,
# `host_k_dyn_j_port`, fired by a write behind it (`HoldWritten`), so the blueprint's
# updates push the child's place the next tick. The supplier is made before the node, so it
# reads the getter through the owner's link, `host_k_owner`, linked at the build; while the
# node is being made (an early row's first value) it reads the dynamic's value at the build,
# `InitEnv`. Bound for `PureBlueprint` under `#owner` and `#dyn{span}`; the locals the
# supplier's closure moves in are cloned first (`dynLets`). The node's own pushed place has
# its first value at the build (`PreInit`); a dynamic answer reading what has none (a
# structural dynamic, a name of the parent) is refused there, loudly.
DynamicAnswers: unbounded fn Wx, Env, Env, Text, Expr -> ((Wx, Env, [Do]))
fn DynamicAnswers wx, benv, menv, hf, sup:
    let lx = wx.lx
    let dyns = Fold (ExprsIn sup), [[]], \|acc, x| match x.kind:
        EFreeSigil "@", y: match ?DynamicAnswer lx, y:
            ? d: Push acc, ((y, d))
            nil: acc
        otherwise: acc
    if (Len dyns) == 0: ((wx, benv, [[]]))
    else:
        let owner = "{hf}_owner"
        let wx1 = update wx:
            &_.taken <= Push &_.taken, owner
            &_.lets <= Push &_.lets, (DoLet (PaBind owner), (XCall (RefRuntime "prism_rtl::Link::<{wx.node}>::new"), [[]]))
            &_.build <= Push &_.build, (DoExpr (XMethod (XVar owner), "link", [[(XRef (XVar "node"))]]))
        # the closure's own copies, named apart from what they copy (pick UN)
        let env0 = Bind benv, "#owner", (BnLocal (XVar "{owner}x"), Owned, OutUnit)
        let lets0 = [[(DoLet (PaBind "{owner}x"), (XClone (XVar owner)))]]
        Fold (Range0 (Len dyns)), ((wx1, env0, lets0)), \|((w, en, ls)), j| match dyns[j]:
            ? ((y, d)):
                let name = "{hf}_dyn_{j + 1}"
                let port = "{name}_port"
                let ((ex, reads)) = DynamicExpr w, menv, d
                let t = OutTyOf lx, (Peel (TypeAt lx, d.span))
                if not (AllInited w, reads): ((w, en, ls))
                else:
                    let w2 = update w:
                        &_.taken <= Append &_.taken, [[name, port]]
                        &_.getters <= Push &_.getters, (MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=ex, doc="The host at `{hf}`'s dynamic answer `{SrcText lx, lx.file, y.span}`, read at the read point (round 3 DY)."))
                        &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind port), (OutRc (OutPort OutUnit))), (XCall (RefRuntime "std::Rc::new"), [[(XCall (RefRuntime "rt::Port::new"), [[]])]]))
                        &_.fields <= Push &_.fields, ((port, (OutRc (OutPort OutUnit)), "the dynamic answer `{name}` moved: its blueprints push the child's place next tick"))
                        &_.moves <= Push &_.moves, ((port, (XClone (XVar port))))
                        &_.dynAnswers <= Push &_.dynAnswers, ((name, reads))
                    let w3 = OnceField w2, name
                    ((w3, (Bind en, "#dyn{DynKey y}", (BnLocal (XVar name), Owned, t)), (Push ls, (DoLet (PaBind "{port}x"), (XClone (XVar port))))))
            nil: ((w, en, ls))

# A dynamic answer's or a live dynamic's port fires once a tick, however many writes lie
# behind it: an update event fires at most once a tick (Semantics ch. 7). `{name}_once`
# stamps the tick it fired in (`MovedBy`).
OnceField: fn Wx, Text -> Wx
fn OnceField wx, name = update wx:
    &_.taken <= Push &_.taken, "{name}_once"
    &_.fields <= Push &_.fields, (("{name}_once", (OutStamped OutUnit), "the tick `{name}`'s port fired in"))
    &_.moves <= Push &_.moves, (("{name}_once", (XCall (RefRuntime "rt::Stamped::new"), [[]])))

# The node's readers a line passes whole to a function that takes them so (Type System ch.
# 4, Application; gap LF), each a live `Dynamic`: read through the node's link by a getter,
# its update event a port the writes behind it fire (as a supplier's dynamic answer's,
# `DynamicAnswers`), made once at the build and kept in a field, so every read of the line
# passes the same dynamic. Bound under `#whole{span}` for `WholeValueOf`; a reader with no
# value at the build has no such dynamic, and the call is refused there.
# `whole` says the line's expression is itself taken whole: a hold of dynamics' initial
# value (`$$cur <- $a then ..`, `HoldLine`).
WholeArgs: unbounded fn Wx, Env, Env, Expr, Bool -> ((Wx, Env, Env))
fn WholeArgs wx, benv, menv, e, whole = WholeArgsAt wx, benv, menv, e, whole, False

# `late` says nothing reads the line's expression before the node is made (a hold's step,
# heard after the build): its live dynamics take no value at the build, so the lines whose
# names it passes need not stand before it in the build. A reader with no value at the
# build (a clause widget's result, a place's dynamic, a name of the parent) is made the
# same way: read through the node's link alone, which is linked before any line's build
# step runs; a read before that is unreachable.
WholeArgsAt: unbounded fn Wx, Env, Env, Expr, Bool, Bool -> ((Wx, Env, Env))
fn WholeArgsAt wx, benv, menv, e, whole, late:
    let lx = wx.lx
    # a call of a function that takes time whole, lifted or not (a lifted one, `$Sel (True
    # on !swap), $a, $b`, takes its sigiled arguments whole, `ArgsFor`), and `@Flatten`'s
    # outer, a dynamic of dynamics it follows whole (`HeldFlatten`), and `@Switch`'s
    # (`HeldSwitch`)
    let calls = Filter (ExprsIn e), \|x| match x.kind:
        ECall c, ignore, ignore, ignore: (IsWholeObject lx, x) or (IsWholeFn lx, (CalleeKey lx, c)) or (CalleeKey lx, c) == "Prelude.@Flatten" or (CalleeKey lx, c) == "Prelude.@Switch"
        otherwise: False
    # and `!Updated $d` inside a lambda of the line (a supplier's `@ !Filter (?Pick p,
    # !Updated $state)`): an event value there, over `$d`'s live dynamic (`?UpdatedValue`)
    let inLambdas = Fold (ExprsIn e), [[]], \|acc, x| match x.kind:
        ELambda ignore, ignore: Append acc, (ExprsIn x)
        otherwise: acc
    let updatedCalls = Filter inLambdas, \|x| match x.kind:
        ECall c, ignore, ignore, ignore: (CalleeKey lx, c) == "Prelude.!Updated"
        otherwise: False
    let roots = Fold (Append calls, updatedCalls), (if whole: [[e]] else: [[]]), \|acc, c| match c.kind:
        ECall ignore, args, ignore, ignore: Fold args, acc, \|acc2, a| Append acc2, (ExprsIn a.value)
        otherwise: acc
    let names0 = Fold roots, [[]], \|acc3, y| match y.kind:
            EName n: if HasKey menv.names, "#whole{DynKey y}": acc3 else: match menv.names[SNameKey n]:
                ? (BnHold ignore, ignore): if (LayerOf (TypeAt lx, y.span)) == LyDyn and not (HasText (Each acc3, \|z| DynKey z), (DynKey y)): Push acc3, y else: acc3
                ? (BnDyn ignore, ignore, ignore): if (LayerOf (TypeAt lx, y.span)) == LyDyn and not (HasText (Each acc3, \|z| DynKey z), (DynKey y)): Push acc3, y else: acc3
                otherwise: acc3
            otherwise: acc3
    # `@Flatten`'s outer written in place (`@Flatten ($Pick $useB, $a, $b)`): the expression
    # itself as a live dynamic of dynamics, after the names it passes whole (`HeldFlatten`)
    let outers = Fold calls, [[]], \|acc, c| match c.kind:
        ECall callee, args, ignore, ignore: if (CalleeKey lx, callee) != "Prelude.@Flatten": acc else: match args[0]:
            ? a: match a.value.kind:
                EName ignore: acc
                otherwise: if (LayerOf (TypeAt lx, a.value.span)) == LyDyn and not (HasKey menv.names, "#whole{DynKey a.value}"): Push acc, a.value else: acc
            nil: acc
        otherwise: acc
    let names = Append names0, outers
    if (Len names) == 0: ((wx, benv, menv))
    else:
        let owner = "whole_owner"
        let wx1 = if HasText wx.taken, owner: wx else: update wx:
            &_.taken <= Push &_.taken, owner
            &_.lets <= Push &_.lets, (DoLet (PaBind owner), (XCall (RefRuntime "prism_rtl::Link::<{wx.node}>::new"), [[]]))
            &_.build <= Push &_.build, (DoExpr (XMethod (XVar owner), "link", [[(XRef (XVar "node"))]]))
        Fold names, ((wx1, benv, menv)), \|((w, be, me)), y|
            let stem = match y.kind:
                EName ignore: "whole_{(Snake (SrcText lx, lx.file, y.span))}"
                otherwise: "whole_outer"
            let ((name, w1)) = FreshName w, stem
            let port = "{name}_port"
            let dyn = "{name}_dyn"
            let ((ex, reads)) = DynamicExpr w1, me, y
            let t = OutTyOf lx, (Peel (TypeAt lx, y.span))
            let valued = (AllInited w1, reads) and (NamesInited be, y) and not late
            let unlinked = if valued: XClone (XVar "at_build") else: XUnreachable
            let arms = [[XArm(pat=(PaCtor (RefRuntime "std::Some"), [[PaBind "owner"]]), conds=[[]], body=(XMethod (XVar "owner"), name, [[XCx]])), XArm(pat=(PaUnit (RefRuntime "std::None")), conds=[[]], body=unlinked)]]
            let read = XClosure True, [[(PaTyped (PaBind "cx"), (OutRef (OutNamed (RefRuntime "rt::Cx"), [[]])))]], (XMatch (XMethod (XVar "link"), "owner", [[]]), arms, False, t)
            let linked = [[(DoLet (PaBind "link"), (XClone (XVar owner)))]]
            let captured = if valued: Push linked, (DoLet (PaBind "at_build"), (Own (ValueOf lx, (InitEnv be), y))) else: linked
            let made = XBlock captured, (XCall (RefRuntime "prism_rtl::Dynamic::of"), [[read, (XRef (XVar port))]])
            let w2 = update w1:
                &_.taken <= Append &_.taken, [[port, dyn]]
                &_.getters <= Push &_.getters, (MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=ex, doc="`{SrcText lx, lx.file, y.span}` passed whole to a function, read at the read point (gap LF)."))
                &_.lets <= Append &_.lets, [[(DoLet (PaTyped (PaBind port), (OutRc (OutPort OutUnit))), (XCall (RefRuntime "std::Rc::new"), [[(XCall (RefRuntime "rt::Port::new"), [[]])]])), (DoLet (PaTyped (PaBind dyn), (OutDyn t)), made)]]
                &_.fields <= Append &_.fields, [[((port, (OutRc (OutPort OutUnit)), "`{name}` moved: its dynamic's update event")), ((dyn, (OutDyn t), "`{SrcText lx, lx.file, y.span}` as the live dynamic a function takes whole"))]]
                &_.moves <= Append &_.moves, [[((port, (XClone (XVar port)))), ((dyn, (XClone (XVar dyn))))]]
                &_.dynAnswers <= Push &_.dynAnswers, ((name, reads))
            let w3 = OnceField w2, name
            let wkey = "#whole{DynKey y}"
            ((w3, (Bind be, wkey, (BnLocal (XVar dyn), Owned, (OutDyn t))), (Bind me, wkey, (BnLocal (XField XSelf, dyn), Owned, (OutDyn t)))))

# The dynamic a supplier's `@ x` answers with, when `x` is a dynamic that is not a constant:
# `x` itself, or the `d` of `$ d` when `d` is a dynamic already.
?DynamicAnswer: fn Lx, Expr -> ?Expr
fn ?DynamicAnswer lx, x:
    if (LayerOf (TypeAt lx, x.span)) != LyDyn: nil
    else: match x.kind:
        EFreeSigil "$", inner: if (LayerOf (TypeAt lx, inner.span)) == LyDyn: ? inner else: nil
        otherwise: ? x

# The key a supplier's `@ x` is bound under in the supplier's environment.
DynKey: fn Expr -> Text
fn DynKey x = "{x.span.start}:{x.span.end}"

# The hosted child's places as the owner gathers them, `host_k_doc_now` (pick HO): each
# place's entry, keyed by its path relative to the child: the places in the child's scope,
# and under each of its `for`s and `rebuild`s their rows' own. Only the snapshot of the
# outer reads it, in the construction step of a tick in which a place came or went (pick
# ST).
HostDocGetter: fn Wx, Text, Pos, [Place], [ForDef], [GenDef] -> MethDef
fn HostDocGetter wx, name, pos, places, builders, gens:
    let start = DoLet (PaTyped (PaMut "doc"), hostDocTy), (XCall (RefRuntime "prism_rtl::HostDoc::new"), [[]])
    let body = DocumentBody wx, MapInsert, places, builders, gens
    MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=hostDocTy, body=(Append [[start]], body), tail=(XVar "doc"), doc="The places of the child hosted at place {PlaceText pos}: each place's entry by its path relative to the child (pick HO). Read only by the snapshot of `$doc`'s outer (pick ST).")

# A structural dynamic's getter (pick ST): its snapshot at the read point.
SnapGetter: fn Text, OutTy, Text -> MethDef
fn SnapGetter name, t, doc = MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=(XMethod (XField XSelf, "{name}_snap"), "get", [[XCx]]), doc=doc)

# `@started`: takes a number, makes no place, fires in the tick after the build.
StartedLine: fn Wx, ?Bn -> ((Wx, Wres))
fn StartedLine wx, ?bound:
    let wx1 = update wx:
        &_.pos <= NextPos &_.pos
    let ((id, wx2)) = match ?bound:
        ? (BnEv er, ignore): ((er.node, wx1))
        otherwise:
            let ((nm, w)) = FreshName wx1, "started"
            AddGn w, nm, OutUnit, GnStarted, 0
    let wx3 = update wx2:
        &_.started <= Push &_.started, id
    ((wx3, (WrEv (EvRefOf wx3, id))))

# `@Defer !e`: a `Defer` field armed by each firing; the next tick's `deferred` fires it.
DeferLine: unbounded fn Wx, Env, [Arg], Expr, ?Nat -> ((Wx, Wres))
fn DeferLine wx, menv, args, e, ?target:
    let lx = wx.lx
    let t = OutTyOf lx, (OutOf (TypeAt lx, e.span))
    let ((field, wx1)) = FreshName wx, "deferred"
    let ((id, wx2)) = match ?target:
        ? n: ((n, wx1))
        nil: AddGn wx1, "{field}_fired", t, GnDeferred, 0
    let wx3 = AddFieldLast wx2, field, (OutDefer t), "`@Defer`", (XCall (RefRuntime "rt::Defer::new"), [[]])
    let wx4 = update wx3:
        &_.defers <= Push &_.defers, ((field, id))
    match args[0]:
        ? a:
            let ((r, wx5)) = EventRef wx4, menv, a.value
            (((Connect wx5, r, (SkArm field)), (WrEv (EvRefOf wx5, id))))
        nil: ((wx4, (WrEv (EvRefOf wx4, id))))

# `@Later !e` (Semantics Appendix B: "each firing answered one tick later, through a
# zero-delay `Time.After`. A World implements time, so this one goes through a World"): a
# `Time.After` at the block's next position, a place of the block as an inlined widget's
# is (ch. 8). Each firing of `!e` queues its value (`prism_rtl::LaterQueue`) and asks the place
# for a wake of no delay and of the empty context; each answer at the place fires the
# oldest value still queued. The wake asked is the record of `Time.After`'s request
# field, built from the prelude's declaration.
LaterLine: unbounded fn Wx, Env, Env, [Arg], Expr, ?Nat -> ((Wx, Wres))
fn LaterLine wx, benv, menv, args, e, ?target:
    let lx = wx.lx
    let t = OutTyOf lx, (OutOf (TypeAt lx, e.span))
    match ((lx.g.tags["Time.After"], args[0])):
        ((? tg, ? a)):
            let ((wakesName, wakeTy)) = Or (Fold tg.fields, nil, \|?found, ((fname, ft))| if (LayerOf ft) == LyEv: ? ((fname, (Peel ft))) else: ?found), (("", TyErr))
            let ((queue, wx1)) = FreshName wx, "later"
            let wx2 = AddFieldLast wx1, queue, (OutNamed (RefRuntime "prism_rtl::LaterQueue"), [[t]]), "`@Later`'s firings not answered yet, oldest first", (XCall (RefRuntime "prism_rtl::LaterQueue::new"), [[]])
            let ((r, wx3)) = EventRef wx2, menv, a.value
            # the value queued first, then the wake asked: the sinks run in page order
            let wx4 = Connect wx3, r, (SkLater queue)
            let wake = WakeOfNoDelay lx, wakeTy
            let asks = EvRef(node=r.node, owner=r.owner, pipe=(\|x, K| r.pipe x, \|ignore| K wake))
            let ((wx5, placed)) = ElementPlaced wx4, benv, menv, tg, [[]], [[((wakesName, asks, (OutTyOf lx, wakeTy)))]], (ElementOut lx, tg, tg.out), nil
            let ((out, wx6)) = match ?target:
                ? n: ((n, wx5))
                nil: AddGn wx5, "{queue}_fired", t, GnNamed, 0
            match placed:
                WrEv answered:
                    let oldest = EvRef(node=answered.node, owner=answered.owner, pipe=(\|x, K| answered.pipe x, \|ignore| Append [[(DoLet (PaBind "{queue}_value"), (XMethod (XField XSelf, queue), "answered", [[]]))]], (K (XVar "{queue}_value"))))
                    (((Connect wx6, oldest, (SkNode out)), (WrEv (EvRefOf wx6, out))))
                otherwise:
                    let wx7 = update wx6:
                        &_.build <= Push &_.build, (InternalBugDo "`Time.After`, placed for an `@Later`, answers no event")
                    ((wx7, WrUnit))
        otherwise:
            let wx2 = update wx:
                &_.build <= Push &_.build, (InternalBugDo "an `@Later` without its event, or a prelude without `Time.After`")
            ((wx2, WrUnit))

# The wake an `@Later` asks its `Time.After` for: the request field's record, each field
# the zero of its type (a duration of nothing, the empty text).
WakeOfNoDelay: unbounded fn Lx, Ty -> Ex
fn WakeOfNoDelay lx, wakeTy = match wakeTy:
    TyCon name, ignore:
        let owner = Or lx.g.types[name], dummyTyInfo
        match owner.body:
            BRecord fs: XRecord (RefIn lx, owner.home, (TypeItemName name)), (Each fs, \|((fname, ft))| (((FieldSpell owner.home, fname, ft), (WakeFieldOfNoDelay (OutTyOf lx, ft)))))
            otherwise: InternalBug "`Time.After`'s wake is not a record"
    otherwise: InternalBug "`Time.After`'s request field is not of a named type"

WakeFieldOfNoDelay: fn OutTy -> Ex
fn WakeFieldOfNoDelay t = match t:
    OutDuration: XDuration "0"
    OutText: XText ""
    otherwise: InternalBug "a field of `Time.After`'s wake that is neither a duration nor a text"

# `$y <- @Distinct $x` (Jimmy, 5 November, reversing Appendix B's D-DT): `$x`'s value,
# whose update event fires only when it changed. A hold of an option, `None` until the
# build sets it to `$x`'s value after the tick (as `@Flatten` adopts its first inner;
# a read before that reads `$x`),
# written by `$x`'s `!Updated` only when the value differs from the one it holds
# (`SkDistinct`); its readers read the hold, so they are marked only then.
DistinctLine: unbounded fn Wx, Env, [Arg], Expr, ?Bn -> ((Wx, Wres))
fn DistinctLine wx, menv, args, e, ?bound:
    let lx = wx.lx
    match args[0]:
        nil:
            let wx2 = update wx:
                &_.build <= Push &_.build, (InternalBugDo "an `@Distinct` without its dynamic")
            ((wx2, WrUnit))
        ? a:
            # the type of the values: its argument's, one layer peeled
            let t = OutTyOf lx, (Peel (TypeAt lx, a.value.span))
            let ((name, wx1)) = match ?bound:
                ? (BnHold f, ignore): ((f, wx))
                # bound as a widget's result (`IsGetterBuiltin`): the getter the name was pre-bound to
                ? (BnDyn (XMethod (XSelf), f, ignore), ignore, ignore): ((f, wx))
                otherwise: FreshName wx, "distinct"
            let kept = "{name}_kept"
            let source = "{name}_source"
            let ((ex, reads)) = DynamicExpr wx1, menv, a.value
            let first = DoExpr (XMethod (XField (XVar "node"), kept), "set", [[(XCtor (RefRuntime "std::Some"), [[(XMethod (XVar "node"), source, [[XCx]])]]), XCx]])
            # before the build sets it (a builder of the same node reading it first), its
            # source's value, which is the same
            let sample = XMatch (XMethod (XField XSelf, kept), "get", [[XCx]]), [[XArm(pat=(PaCtor (RefRuntime "std::Some"), [[PaBind "v"]]), conds=[[]], body=(XVar "v")), XArm(pat=(PaUnit (RefRuntime "std::None")), conds=[[]], body=(XMethod (XSelf), source, [[XCx]]))]], False, t
            let wx2 = update wx1:
                &_.taken <= Append &_.taken, [[kept, source]]
                &_.fields <= Push &_.fields, ((kept, (OutHold (OutOpt t)), "`@Distinct`'s value: its source's, written only when it changes"))
                &_.moves <= Push &_.moves, ((kept, (XCall (RefRuntime "rt::Hold::new"), [[XNone, XCx]])))
                &_.build <= Push &_.build, first
                &_.getters <= Append &_.getters, [[(MethDef(name=source, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=ex, doc="`@Distinct`'s source, read at the build.")), (MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=sample, doc="`@Distinct`'s dynamic: the value it holds at the read point."))]]
                &_.dynReads <= Insert (Insert &_.dynReads, name, [[OwnRead kept]]), source, reads
            let ((r, wx3)) = UpdatedEvent wx2, menv, args, t
            (((Connect wx3, r, (SkDistinct kept)), (WrDyn (XMethod (XSelf), name, [[XCx]]), [[OwnRead kept]], t)))

# `$each <- @PerKey $m` (Semantics Appendix B; round 9 PK, Jimmy's): `$m` taken apart by
# key, `$(k ==> v)` into `$(k ==> $v)`. A `prism_rtl::PerKey`, set up at the build from
# `$m`'s value after the tick (a read before that sets it up first), and written by `$m`'s
# `!Updated` (`SkPerKey`): each kept key whose value changed by `==` has its inner written
# and fired there, and only a key that came or went writes the outer, so its readers (a
# `for` over it and that `for`'s rows) are marked only then. A row's `$v` over it follows
# its inner's update event (`EntryFlatten`), so a value change reaches that key's row
# alone, in the tick of the write.
PerKeyLine: unbounded fn Wx, Env, [Arg], ?Bn -> ((Wx, Wres))
fn PerKeyLine wx, menv, args, ?bound:
    let lx = wx.lx
    match args[0]:
        nil:
            let wx2 = update wx:
                &_.build <= Push &_.build, (InternalBugDo "an `@PerKey` without its dynamic")
            ((wx2, WrUnit))
        ? a:
            # the map's key and value types: its argument's, one layer peeled
            let ((kt, vt)) = match Peel (TypeAt lx, a.value.span):
                TyMap k, v: (((OutTyOf lx, k), (OutTyOf lx, v)))
                otherwise: ((OutUnit, OutUnit))
            let srcTy = OutMap kt, vt
            let t = OutMap kt, (OutDyn vt)
            let ((name, wx1)) = match ?bound:
                ? (BnHold f, ignore): ((f, wx))
                # bound as a widget's result (`IsGetterBuiltin`): the getter the name was pre-bound to
                ? (BnDyn (XMethod (XSelf), f, ignore), ignore, ignore): ((f, wx))
                otherwise: FreshName wx, "per_key"
            let kept = "{name}_kept"
            let source = "{name}_source"
            let ((ex, reads)) = DynamicExpr wx1, menv, a.value
            let first = DoExpr (XMethod (XField (XVar "node"), kept), "start", [[(XMethod (XVar "node"), source, [[XCx]]), XCx]])
            let sample = XMethod (XField XSelf, kept), "outer", [[XCx, (XClosure False, [[]], (XMethod (XSelf), source, [[XCx]]))]]
            let wx2 = update wx1:
                &_.taken <= Append &_.taken, [[kept, source]]
                &_.fields <= Push &_.fields, ((kept, (OutNamed (RefRuntime "prism_rtl::PerKey"), [[kt, vt]]), "`@PerKey`'s outer and each key's inner"))
                &_.moves <= Push &_.moves, ((kept, (XCall (RefRuntime "prism_rtl::PerKey::new"), [[]])))
                &_.build <= Push &_.build, first
                &_.getters <= Append &_.getters, [[(MethDef(name=source, recv=RecvRef, params=[[]], cx=CxRef, ret=srcTy, body=[[]], tail=ex, doc="`@PerKey`'s source, read at the build.")), (MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=sample, doc="`@PerKey`'s outer: each key's inner by key, at the read point."))]]
                &_.dynReads <= Insert (Insert &_.dynReads, name, [[OwnRead kept]]), source, reads
            let ((r, wx3)) = UpdatedEvent wx2, menv, args, srcTy
            (((Connect wx3, r, (SkPerKey kept)), (WrDyn (XMethod (XSelf), name, [[XCx]]), [[OwnRead kept]], t)))

# `@Run F, x` (Semantics Appendix B, over `@started`, `@Defer` and `@Machine`): it takes
# a number for its `@started`; the job is a `Hold`, the merge `!started <| !again` cycles
# it once per tick, a `More` arms the `@Defer`, a `Finished` fires the result.
RunLine: unbounded fn Wx, Env, [Arg], Expr, ?Nat -> ((Wx, Wres))
fn RunLine wx, benv, args, e, ?target:
    let lx = wx.lx
    let t = OutTyOf lx, (OutOf (TypeAt lx, e.span))
    let ((p, wx1)) = FreshName wx, "run"
    let wx2 = update wx1:
        &_.pos <= NextPos &_.pos
        &_.taken <= Append &_.taken, [["{p}_job", "{p}_again", "{p}_started", "{p}_turn"]]
    let start = match args[0]:
        ? a: match a.value.kind:
            # a function the program defines, bounded or not, by its `Start` (`JobRoots`
            # gives each one `@Run` names a job); any other function value (a lambda, a
            # local, a call's result, a constructor, a trait's method, a function of the
            # prelude) as the `Start` it is or is made (`AsJobValue`)
            EName n:
                let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
                let ?local = if (Len n.path) == 1: benv.names[NameKeyAt lx, benv, n, a.value.span] else: nil
                match ((?local, ?q)):
                    ((nil, ? q)) if HasFnDef lx, q: XPath (StartRef lx, q)
                    otherwise: AsJobValue lx, benv, a.value
            otherwise: AsJobValue lx, benv, a.value
        nil: InternalBug "an `@Run` without its function"
    let x = match args[1]:
        ? a: Own (ValueOf lx, benv, a.value)
        nil: XUnit
    let wx3 = AddField wx2, "{p}_job", (OutHold (OutJob t)), "`@Run`'s job (`@Machine`'s state)", (XCall (RefRuntime "rt::Hold::new"), [[(XApply start, [[x]]), XCx]])
    let wx4 = AddFieldLast wx3, "{p}_again", (OutDefer OutUnit), "`@Run`'s `!again`", (XCall (RefRuntime "rt::Defer::new"), [[]])
    let ((s, wx5)) = AddGn wx4, "{p}_started", OutUnit, GnStarted, 0
    let ((a, wx6)) = AddGn wx5, "{p}_again", OutUnit, GnDeferred, 0
    let ((m, wx7)) = Merge wx6, "{p}_turn", OutUnit, (EvRefOf wx6, s), (EvRefOf wx6, a)
    let ((res, wx8)) = match ?target:
        ? n: ((n, wx7))
        nil: AddGn wx7, "{p}_done", t, GnNamed, 0
    let wx9 = update (Connect wx8, (EvRefOf wx8, m), (SkCycle "{p}_job", "{p}_again", res)):
        &_.started <= Push &_.started, s
        &_.defers <= Push &_.defers, (("{p}_again", a))
    ((wx9, (WrEv (EvRefOf wx9, res))))

# Whether a name is a function the program defines by clauses: one with a job when
# `@Run` names it.
HasFnDef: fn Lx, Text -> Bool
fn HasFnDef lx, qk = Fold lx.g.defs, False, \|f, d| f or (d.qk == qk and IsFnDef d)

# `@Machine step, init, !a` (Semantics Appendix B): the state a hold; each firing of
# `!a` steps it, writes the new state and fires the output when the step gives one. The
# step is a named function; a function value is not lowered yet.
MachineLine: unbounded fn Wx, Env, Env, [Arg], Expr, ?Nat -> ((Wx, Wres))
fn MachineLine wx, benv, menv, args, e, ?target:
    let lx = wx.lx
    let t = OutTyOf lx, (OutOf (TypeAt lx, e.span))
    let ((f, wx1)) = FreshName wx, "machine"
    # a named function is called by its path; any other step is a function value made at
    # the build and kept in a field (Appendix B: any function of the step's type)
    let ?named = match args[0]:
        ? a: match a.value.kind:
            EName n:
                let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
                let local = (Len n.path) == 1 and HasKey benv.names, (SNameKey n)
                match ?q:
                    ? q if not local: ? (XPath (ValueRef lx, q))
                    otherwise: nil
            otherwise: nil
        nil: nil
    match ((args[0], args[1], args[2])):
        ((? stepArg, ? init, ? ev)):
            let st = OutTyOf lx, (Peel (TypeAt lx, init.value.span))
            let x = Own (ValueOf lx, benv, init.value)
            let wx0 = AddField wx1, "{f}_state", (OutHold st), "`@Machine`'s state", (XCall (RefRuntime "rt::Hold::new"), [[x, XCx]])
            let ((sp, wx2)) = match ?named:
                ? p: ((p, wx0))
                nil:
                    let ft = OutTyOf lx, (Peel (TypeAt lx, stepArg.value.span))
                    (((XField XSelf, "{f}_step"), (AddField wx0, "{f}_step", ft, "`@Machine`'s step, a function value", (Own (ValueOf lx, benv, stepArg.value)))))
            let ((out, wx3)) = match ?target:
                ? n: ((n, wx2))
                nil: AddGn wx2, "{f}_fired", t, GnNamed, 0
            let ((r, wx4)) = EventRef wx3, menv, ev.value
            (((Connect wx4, r, (SkMachine "{f}_state", sp, out)), (WrEv (EvRefOf wx4, out))))
        otherwise:
            let wx2 = update wx1:
                &_.build <= Push &_.build, (InternalBugDo "an `@Machine` without its step, state or event")
            ((wx2, WrUnit))

# `@Element x` in a block (gap LE; Semantics ch. 4, "Elements": `!click <- @Element
# (Ui.Button(label=$l))` is the element statement, at the same path, since a function
# application adds no segment to a path): a tag applied in place is that element's line.
ElementCallLine: unbounded fn Wx, Env, Env, [Arg], ?Bn -> ((Wx, Wres))
fn ElementCallLine wx, benv, menv, args, ?bound:
    let lx = wx.lx
    match args[0]:
        ? a if IsTagApplication lx, a.value: ElementLine wx, benv, menv, (Ungrouped a.value), ?bound
        # a name a `let` of the block binds to a tag applied (`WithElementLets`): that
        # element's line, here
        ? a if IsSome (?ElementLet menv, a.value): match ?ElementLet menv, a.value:
            ? x: ElementLine wx, benv, menv, x, ?bound
            nil: ((wx, WrUnit))
        otherwise:
            let wx2 = update wx:
                &_.pos <= NextPos &_.pos
                &_.build <= Push &_.build, (RefusalDo "not lowered yet: `@Element` in a block of an element value that is neither a tag applied in place nor a name a `let` of the block binds to one (gap LE)")
            ((wx2, WrUnit))

# The tag application a `let` of the block binds a name to (`WithElementLets`).
?ElementLet: fn Env, Expr -> ?Expr
fn ?ElementLet menv, e = match (Ungrouped e).kind:
    EName n: if (Len n.path) != 1: nil else: match menv.names["{SNameKey n}#element"]:
        ? (BnWidget x, ignore, ignore, ignore): ? x
        otherwise: nil
    otherwise: nil

# An expression out of its parentheses.
Ungrouped: fn Expr -> Expr
fn Ungrouped e = match e.kind:
    EGroup x: Ungrouped x
    otherwise: e

# Whether an expression is an element tag applied, `Ui.Button(..)` or a bare tag.
IsTagApplication: unbounded fn Lx, Expr -> Bool
fn IsTagApplication lx, e = match e.kind:
    EGroup x: IsTagApplication lx, x
    ECall c, ignore, ignore, ignore: HasKey lx.g.tags, (TagNameOf lx, c)
    EName ignore: HasKey lx.g.tags, (TagNameOf lx, e)
    otherwise: False

# A user widget inlined: its parameters bound to the arguments by layer (an event to the
# caller's event, a dynamic to its reader, a plain value to a field), its block lowered
# into the caller's node with its positions in the caller's sequence.
InlineWidget: unbounded fn Wx, Env, Env, Text, ValInfo, [Arg], Expr -> ((Wx, Wres))
fn InlineWidget wx, benv, menv, qk, v, args, e:
    let lx = wx.lx
    let clauses = ClausesOf lx.g, qk
    let ?w = ?WidgetDeclOf lx.g, qk
    let ((params, ?body)) = match ?w:
        ? wd: (([[]], ? wd.body))
        nil: match clauses:
            [[c]]: match c.body:
                BodyBlock b: ((c.params, ? b))
                BodyExpr x: ((c.params, ? (Block(stmts=[[Stmt(kind=(SExpr x), span=x.span)]], inline=True, span=x.span))))
            otherwise: (([[]], nil))
    match ?body:
        nil:
            if (Len clauses) == 0:
                # A widget with no body, a builtin of the prelude this back end does not
                # lower (`@HostSome`, `@Element`, `@Machine`, ...): refused, and not taken
                # for a widget of several clauses, whose generation would lower the call
                # again, without end.
                let wx2 = update wx:
                    &_.build <= Push &_.build, (InternalBugDo "the builtin widget {BareName qk} has no body and no lowering")
                ((wx2, WrUnit))
            else:
                # A widget of several clauses in a static position: the clause is chosen at
                # the build from the arguments, which are plain, so it is a generation built
                # once (a `rebuild` whose source never changes), each clause a row
                # (`ClauseRow`).
                match args[0]:
                    ? a:
                        # a clause that calls its own widget is lowered level by level, as an
                        # inlined widget is, to the same depth (`TooDeep`)
                        # (a widget with plain parameters and no result, which calls itself
                        # as deep as its data: rows shared by every call, `SharedClauseLine`)
                        if (Recursion wx.inlining, qk) > 0 and IsSharable wx, v, e: SharedClauseLine wx, menv, a.value, qk, v, e, args
                        else: if (Recursion wx.inlining, qk) > 16: TooDeep wx, qk, e
                        else:
                            let call = Block(stmts=[[Stmt(kind=(SExpr e), span=e.span)]], inline=True, span=e.span)
                            let inside = update wx:
                                &_.inlining <= Push &_.inlining, qk
                            let ((done, res)) = ClauseWidgetLine inside, benv, menv, a.value, call, qk, v, e, args
                            let outside = update done:
                                &_.inlining <= wx.inlining
                            ((outside, res))
                    nil:
                        let wx2 = update wx:
                            &_.build <= Push &_.build, (RefusalDo "a widget of several clauses that takes no arguments")
                        ((wx2, WrUnit))
        ? body:
            if (Recursion wx.inlining, qk) > 16: TooDeep wx, qk, e
            else:
                let lxc = InModuleAt lx, v.file, v.home, lx.site
                let ptys = match v.scheme.ty:
                    TyFn ignore, ps, ignore: ps
                    otherwise: [[]]
                # a generic widget's type parameters, over which its body was checked: their
                # types at this call, read off its arguments' types
                let ?params = Fold (Range0 (Len params)), (? {}), \|?acc, i| match ((?acc, args[i])):
                    ((? m, ? a)): ?ParamInstance (Or ptys[i], TyErr), (TypeAt lx, a.value.span), m
                    otherwise: ?acc
                let unmatched = Filter (Fold ptys, [[]], \|acc, t| UnionTexts acc, (RigidsIn t)), \|q| not (HasKey (Or ?params, {}), q)
                let lxp = update lx:
                    &_.subst <= Fold (Keys (Or ?params, {})), &_.subst, \|m, q| Insert m, q, (Or (Or ?params, {})[q], TyErr)
                let ((wx1, be1, me1)) = Fold (Range0 (Len params)), ((wx, emptyEnv, emptyEnv)), \|((w, be, me)), i|
                    let p = Or params[i], dummyPat
                    let nkey = PlainBinder lxc, p
                    let pty = SubstTy lxp, (Or ptys[i], TyErr)
                    match args[i]:
                        nil: ((w, be, me))
                        ? a: BindParam w, benv, menv, be, me, nkey, (LocalNameAt lxc, nkey, p.span), pty, a.value
                let callSpan = match e.kind:
                    ECall c, ignore, ignore, ignore: c.span
                    otherwise: e.span
                let lxi = update lxc:
                    &_.inlined <= match lx.callIds[PlaceKey lx, callSpan]:
                        ? id: "{lx.inlined}_{Base32 id}"
                        nil: lx.inlined
                    &_.subst <= Fold (Keys (Or ?params, {})), &_.subst, \|m, q| Insert m, q, (Or (Or ?params, {})[q], TyErr)
                let inner = update wx1:
                    &_.lx <= lxi
                    &_.inlining <= Push &_.inlining, qk
                    &_.result <= WrUnit
                if (Len unmatched) > 0:
                    let wx2 = update wx:
                        &_.build <= Push &_.build, (RefusalDo "the generic widget {BareName qk} at a call whose types its parameters' do not match")
                    ((wx2, WrUnit))
                else:
                    let done = BlockInto inner, be1, me1, body
                    let back = update done:
                        &_.lx <= lx
                        &_.inlining <= wx.inlining
                        &_.result <= wx.result
                    ((back, done.result))

# A widget's type parameters at one of its arguments: its parameter's type matched to the
# argument's (a plain parameter lifted over a dynamic argument, to the value under it),
# keyed by name, as `SubstTy` reads a rigid or quantified variable.
?ParamInstance: unbounded fn Ty, Ty, (Text ==> Ty) -> ?(Text ==> Ty)
fn ?ParamInstance pty, aty, m = match ?ParamMatch (Unrigid pty), aty, m:
    ? found: ? found
    nil: ?ParamMatch (Unrigid pty), (Peel aty), m

# One-way matching of a parameter's type (its variables `TyQ`) against an argument's: the
# checker's `?MatchHead` with a blueprint parameter (`@a` against `@Text`) and a function
# parameter matched through, and a part with no variable matched by being the same type.
?ParamMatch: unbounded fn Ty, Ty, (Text ==> Ty) -> ?(Text ==> Ty)
fn ?ParamMatch pat, t, m = match ((pat, t)):
    ((TyQ v, x)): match m[v]:
        ? y: if y == x: ? m else: nil
        nil: ? (Insert m, v, x)
    (((TyAt i1, ignore), (TyAt i2, ignore))): ?ParamMatch i1, i2, m
    (((TyFn ignore, ps1, r1), (TyFn ignore, ps2, r2))): if (Len ps1) == (Len ps2): ?ParamMatchAll (Push ps1, r1), (Push ps2, r2), m else: nil
    (((TyCon a, xs), (TyCon b, ys))): if a == b and (Len xs) == (Len ys): ?ParamMatchAll xs, ys, m else: nil
    ((TyTuple xs, TyTuple ys)): if (Len xs) == (Len ys): ?ParamMatchAll xs, ys, m else: nil
    ((TyArray x, TyArray y)): ?ParamMatch x, y, m
    (((TyMap k1, v1), (TyMap k2, v2))): ?ParamMatchAll [[k1, v1]], [[k2, v2]], m
    (((TySig s1, i1), (TySig s2, i2))): if s1 == s2: ?ParamMatch i1, i2, m else: nil
    otherwise: if pat == t: ? m else: nil

?ParamMatchAll: unbounded fn [Ty], [Ty], (Text ==> Ty) -> ?(Text ==> Ty)
fn ?ParamMatchAll xs, ys, m = Fold (Range0 (Len xs)), (? m), \|?acc, i| match ?acc:
    ? mm: ?ParamMatch (Or xs[i], TyErr), (Or ys[i], TyErr), mm
    nil: nil

# The type variables a parameter's type names.
RigidsIn: unbounded fn Ty -> [Text]
fn RigidsIn t = match t:
    TyRigid n: [[n]]
    TyQ n: [[n]]
    TyCon ignore, args: Fold args, [[]], \|acc, a| UnionTexts acc, (RigidsIn a)
    TyTuple ts: Fold ts, [[]], \|acc, a| UnionTexts acc, (RigidsIn a)
    TyArray e: RigidsIn e
    TyMap k, v: UnionTexts (RigidsIn k), (RigidsIn v)
    TySig ignore, i: RigidsIn i
    TyAt i, ignore: RigidsIn i
    TyFn ignore, ps, r: Fold ps, (RigidsIn r), \|acc, a| UnionTexts acc, (RigidsIn a)
    otherwise: [[]]

# A scheme's type with its rigid variables as quantified ones, which `?MatchAll` binds.
Unrigid: unbounded fn Ty -> Ty
fn Unrigid t = match t:
    TyRigid n: TyQ n
    TyCon n, args: TyCon n, (Each args, \|a| Unrigid a)
    TyTuple ts: TyTuple (Each ts, \|a| Unrigid a)
    TyArray e: TyArray (Unrigid e)
    TyMap k, v: TyMap (Unrigid k), (Unrigid v)
    TySig s, i: TySig s, (Unrigid i)
    TyAt i, rw: TyAt (Unrigid i), rw
    TyFn c, ps, r: TyFn c, (Each ps, \|a| Unrigid a), (Unrigid r)
    other: other

# How many times the widget `qk` is already being inlined around this call: its recursion,
# which alone is bounded; widgets that call other widgets nest as deep as they are written.
Recursion: fn [Text], Text -> Nat
fn Recursion inlining, qk = Fold inlining, 0, \|n, k| if k == qk: n + 1 else: n

# A widget recursing deeper than the lowering inlines it (sixteen levels): the node at that
# depth faults at its build, so only a tree that deep stops the program, and loudly; the call
# gives a result of its type that is never read (the build faults first).
TooDeep: unbounded fn Wx, Text, Expr -> ((Wx, Wres))
fn TooDeep wx, qk, e:
    let lx = wx.lx
    let what = "`{BareName qk}` recurses deeper than the compiler inlines it (16 levels)"
    let wx1 = update wx:
        &_.build <= Push &_.build, (DoReturn (XCtor (RefRuntime "std::Err"), [[(XCall (RefRuntime "rt::Fault::too_deep"), [[XStr what]])]]))
        &_.fallible <= True
    let t = OutTyOf lx, (OutOf (TypeAt lx, e.span))
    let called = match TypeAt lx, e.span:
        TyAt i, ignore: i
        other: other
    match LayerOf called:
        LyDyn: ((wx1, (WrDyn XUnreachable, [[]], t)))
        LyEv:
            let ((id, wx2)) = AddGn wx1, "too_deep", t, GnNever, 0
            ((wx2, (WrEv (EvRefOf wx2, id))))
        # a plain result is bound in the build's `let`s, before the build's statements: the
        # fault goes there too, ahead of the value it stands for
        otherwise:
            if t == OutUnit: ((wx1, WrUnit))
            else:
                let wx2 = update wx1:
                    &_.lets <= Push &_.lets, (DoReturn (XCtor (RefRuntime "std::Err"), [[(XCall (RefRuntime "rt::Fault::too_deep"), [[XStr what]])]]))
                ((wx2, (WrPlain XUnreachable, t)))

?WidgetDeclOf: fn G, Text -> ?WidgetDecl
fn ?WidgetDeclOf g, qk = Fold g.defs, nil, \|?found, d| if d.qk == qk: ?DefWidget d, ?found else: ?found

?DefWidget: fn Def, ?WidgetDecl -> ?WidgetDecl
fn ?DefWidget d, ?other = match d.body:
    DbWidget w: ? w
    otherwise: ?other

# A function type that gives a blueprint: a widget function's.
IsWidgetFnTy: fn Ty -> Bool
fn IsWidgetFnTy t = match t:
    TyFn ignore, ignore, r: IsWidgetTy r
    otherwise: False

# One parameter of an inlined widget, bound in the callee's environments from an argument
# lowered in the caller's; its fields and getters spelled from `spelled`, its name as a
# local (`LocalNameAt`).
BindParam: unbounded fn Wx, Env, Env, Env, Env, Text, Text, Ty, Expr -> ((Wx, Env, Env))
fn BindParam wx, cbenv, cmenv, be, me, nkey, spelled, pty, arg:
    let lx = wx.lx
    let t = OutTyOf lx, (Peel pty)
    # a widget function (`Inner: fn Nat -> @unit`) is taken as a blueprint is: the
    # argument's text with its caller's environments, applied where the widget applies it
    if IsWidgetFnTy pty:
        let b = BnWidget arg, cbenv, cmenv, lx
        ((wx, (Bind be, nkey, b), (Bind me, nkey, b)))
    else: match LayerOf pty:
        LyBlueprint:
            let b = BnWidget arg, cbenv, cmenv, lx
            ((wx, (Bind be, nkey, b), (Bind me, nkey, b)))
        LyEv:
            let ((r, wx2)) = EventRef wx, cmenv, arg
            let b = BnEv r, t
            # its value form, as a bound event's (`PreBindName`): a port the event fires,
            # made before the node, which a supplier's closure or a function taking the
            # event whole reads (`NameValue`)
            let et = OutTyOf lx, (Peel (Peel pty))
            let ((rs, wx3)) = FreshName wx2, "{spelled}_v"
            let pf = "{rs}_port"
            let pt = OutRc (OutPort et)
            let wx4 = update (Connect wx3, r, (SkPort rs)):
                &_.taken <= Push &_.taken, pf
                &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind pf), pt), (XCall (RefRuntime "std::Rc::new"), [[(XCall (RefRuntime "rt::Port::new"), [[]])]]))
                &_.fields <= Push &_.fields, ((pf, pt, "`{nkey}` as a value: the port it fires"))
                &_.moves <= Push &_.moves, ((pf, (XClone (XVar pf))))
            ((wx4, (Bind (Bind be, nkey, b), "{nkey}#port", (BnLocal (XVar pf), Owned, pt)), (Bind (Bind me, nkey, b), "{nkey}#port", (BnLocal (XField XSelf, pf), Owned, pt))))
        LyDyn:
            # the argument's expression where the widget reads it; for a row of the widget's
            # (a `for` in it), which reads the node through its parent, a getter of it too,
            # under `{name}#row` (`RowEnv`)
            let ((ex, reads)) = DynamicExpr wx, cmenv, arg
            let b = BnDyn ex, reads, t
            # its value at the build, when the argument has one (`InitEnv`, round 3 DY): what an
            # element's first value or a supplier reads while the node is being made
            let ((wx0, be0)) = if (AllInited wx, reads) and (NamesInited cbenv, arg):
                let ((rsi, wxi)) = FreshName wx, "{spelled}_arg"
                let wxj = update wxi:
                    &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind "{rsi}_init"), t), (Own (ValueOf lx, (InitEnv cbenv), arg)))
                    &_.inited <= Push &_.inited, rsi
                ((wxj, (Bind be, "{nkey}#init", (BnLocal (XVar "{rsi}_init"), Owned, t))))
            else: ((wx, be))
            match ex:
                XMethod XSelf, ignore, ignore: ((wx0, (Bind be0, nkey, b), (Bind me, nkey, b)))
                otherwise:
                    let ((rs, wx2)) = FreshName wx0, spelled
                    let getter = MethDef(name=rs, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=ex, doc="`{nkey}`, a widget's parameter, as its rows read it")
                    let wx3 = update wx2:
                        &_.getters <= Push &_.getters, getter
                        &_.dynReads <= Insert &_.dynReads, rs, reads
                    let rb = BnDyn (XMethod (XSelf), rs, [[XCx]]), [[OwnRead rs]], t
                    ((wx3, (Bind (Bind be0, nkey, b), "{nkey}#row", rb), (Bind (Bind me, nkey, b), "{nkey}#row", rb)))
        otherwise:
            let ((rs, wx2)) = FreshName wx, spelled
            let v = Own (ValueOf lx, cbenv, arg)
            let wx3 = update wx2:
                &_.lets <= Push &_.lets, (DoLet (PaBind rs), v)
                &_.fields <= Push &_.fields, ((rs, t, "`{nkey}`"))
                &_.inits <= Push &_.inits, ((rs, (XClone (XVar rs))))
            let ((be2, me2)) = BindPlain be, me, nkey, rs, t
            ((wx3, be2, me2))
