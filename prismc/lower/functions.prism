# ---------------------------------------------------------------------------------------
# Functions (claude/backend.md: a plain function is a Rust `fn` taking references, its
# clauses one `match`; generics are Rust's, monomorphized by rustc, doubt MO)
# ---------------------------------------------------------------------------------------

# A trait bound as Rust's: `^Eq` is `Eq`, `^Ord` `Ord` (a `Float` is both, by its bits:
# `prism_rtl::Float`), `^Show` the printer's, `^Num` the prelude's.
BoundOf: fn Lx, Text -> [Text]
fn BoundOf lx, "Prelude.Eq" = [["std::Eq"]]
fn BoundOf lx, "Prelude.Ord" = [["std::Ord"]]
fn BoundOf lx, "Prelude.Show" = [["rt::Show"]]
fn BoundOf lx, "Prelude.Num" = [["rt::Num"]]
fn BoundOf lx, "Prelude.Pod" = [["rt::ToPod", "rt::FromPod"]]
fn BoundOf lx, cls = match lx.g.traits[cls]:
    ? tr: [[(PathIn lx, tr.home, (TraitName cls))]]
    nil: [[]]

# A scheme's type variables as Rust generics with their bounds. A variable a map is keyed
# by is `Ord` too, whether or not the scheme says `^Ord`: a map's keys are ordered (Semantics
# App. B, "Maps"), and the runtime's `Map` asks it of every key type.
SchemeGenerics: fn Lx, Scheme -> [((Text, [Text]))]
fn SchemeGenerics lx, sc = Each sc.qs, \|q|
    let bs = Fold sc.bounds, [["std::Clone"]], \|acc, ((v, cls))| if v == q: UnionTexts acc, (BoundOf lx, cls) else: acc
    let keyed = if KeysBy sc.ty, q: UnionTexts bs, [["std::Ord"]] else: bs
    ((Camel q, keyed))

# Whether the type variable `q` is a map's key anywhere in a type.
KeysBy: fn Ty, Text -> Bool
fn KeysBy t, q = match t:
    TyMap k, v: (k == TyQ q) or (KeysBy k, q) or (KeysBy v, q)
    TyCon ignore, ts: Fold ts, False, \|found, x| found or KeysBy x, q
    TyFn ignore, ps, r: (Fold ps, False, \|found, x| found or KeysBy x, q) or (KeysBy r, q)
    TyTuple ts: Fold ts, False, \|found, x| found or KeysBy x, q
    TyArray x: KeysBy x, q
    TySig ignore, x: KeysBy x, q
    TyAt x, ignore: KeysBy x, q
    otherwise: False

# The parameters of a function's clauses: a name every clause binds at a position names
# the parameter; any other position is matched, named after its type.
ParamNames: unbounded fn Lx, [FnClause], [OutTy] -> [((Text, Bool))]
fn ParamNames lx, clauses, pts = Each (Range0 (Len pts)), \|i|
    let names = Each clauses, \|c| PlainBinder lx, (Or c.params[i], dummyPat)
    let first = Or names[0], ""
    let same = first != "" and Fold names, True, \|ok, n| ok and n == first
    let span = match (Or (Or clauses[0], dummyClause).params[i], dummyPat).kind:
        PName n: n.span
        otherwise: Range(start=0, end=0)
    if same: (((LocalNameAt lx, first, span), False)) else: (((ParamWord (Or pts[i], OutUnit), i), True))

# The binder a parameter pattern is, when it is one: its name with sigils.
PlainBinder: fn Lx, Pattern -> Text
fn PlainBinder lx, p = match p.kind:
    PName n:
        let ((?qk, why)) = ResolveValue lx.g, lx.home, n
        let isCtor = match ?qk:
            ? qk: (HasKey lx.g.ctors, qk) and ((IsUpperText (Base (SNameKey n))) or IsUnitCtor lx, qk)
            nil: False
        if isCtor: "" else: SNameKey n
    PGroup q: PlainBinder lx, q
    otherwise: ""

# A matched parameter's name: its type's (`term` for a `Term`), else `arg`.
ParamWord: fn OutTy, Nat -> Text
fn ParamWord t, i:
    let base = match t:
        OutNamed n, ignore: Snake (RefLast n)
        OutText: "text"
        OutNat: "n"
        OutInt: "i"
        OutArray ignore: "xs"
        OutMap ignore, ignore: "map"
        OutOpt ignore: "opt"
        otherwise: "arg"
    "{base}{i}"

# A parameter's type as its body sees it: its value, or in a function that takes time whole
# the dynamic or event itself.
PeelUnlessWhole: fn Lx, Ty -> Ty
fn PeelUnlessWhole lx, t = if lx.whole: t else: Peel t

# A function's clauses as one body over its parameters (each a reference, `ref`).
ClausesBody: unbounded fn Lx, Env, [FnClause], [((Text, Bool))], [Ty], (fn Lx, Env, FnBody -> Ex), Text, OutTy -> Ex
fn ClausesBody lx, env, clauses, names, ptys, Body, label, t:
    let env1 = Fold (Range0 (Len names)), env, \|en, i|
        let ((rs, matched)) = Or names[i], (("", True))
        if matched: en
        else: Bind en, (PlainBinder lx, (Or (Or clauses[0], dummyClause).params[i], dummyPat)), (BnLocal (XVar rs), ByRef, (OutTyOf lx, (PeelUnlessWhole lx, (Or ptys[i], TyErr))))
    let scrutIx = Filter (Range0 (Len names)), \|i| match names[i]:
        ? ((ignore, True)): True
        otherwise: False
    if (Len scrutIx) == 0:
        let c = Or clauses[0], dummyClause
        Body lx, env1, c.body
    else:
        let scrut = match scrutIx:
            [[i]]: XVar (Or (Each names, \|((n, ignore))| n)[i], "arg")
            otherwise: XTuple (Each scrutIx, \|i| XVar (Or (Each names, \|((n, ignore))| n)[i], "arg"))
        let arms = Each (Range0 (Len clauses)), \|ci|
            let c = Or clauses[ci], dummyClause
            let pos = Each scrutIx, \|i| RustPat lx, (Or c.params[i], dummyPat), (Or ptys[i], TyErr), ByRef, "{label}{ci}_{i}"
            let pa = match pos:
                [[o]]: o.pa
                otherwise: PaTuple (Each pos, \|o| o.pa)
            let conds = Fold pos, [[]], \|acc, o| Append acc, o.conds
            let binds = Fold pos, [[]], \|acc, o| Append acc, o.binds
            XArm(pat=pa, conds=conds, body=(Body lx, (BindAll env1, binds), c.body))
        Own (ArmsValue scrut, arms, "'{label}", t)

let dummyClause = FnClause(name=(DefOp "", Range(start=0, end=0)), params=[[]], body=(BodyExpr (Expr(kind=EError, span=Range(start=0, end=0)))), span=Range(start=0, end=0))

FnBodyValue: unbounded fn Lx, Env, FnBody -> Ex
fn FnBodyValue lx, env, (BodyExpr x) = Own (ValueOf lx, env, x)
fn FnBodyValue lx, env, (BodyBlock b) = Own (BlockValue lx, env, b)

# A function's parameter types and result in its scheme. A function that gives a blueprint
# is not lifted over its `!` parameters: it takes each as an event value (`?Boxed p, e, !in`
# builds `@ !Filter (?ClickTo p, !in)`).
SignatureTys: fn Scheme -> (([Ty], Ty))
fn SignatureTys sc:
    let ((ptys0, res)) = match sc.ty:
        TyFn ignore, ps, r: ((ps, r))
        other: (([[]], other))
    let ptys = if HasBlueprint res: Each ptys0, \|p| EventParam p else: ptys0
    ((ptys, res))

# The same as the target types them: peeled, or whole for a function that takes its time
# whole (`IsWholeFn`).
SignatureOut: unbounded fn Lx, Text, Scheme -> (([OutTy], OutTy))
fn SignatureOut lx, qk, sc:
    let ((ptys, res)) = SignatureTys sc
    let whole = IsWholeFn lx, qk
    let pts = Each ptys, \|p| OutTyOf lx, (if whole: p else: Peel p)
    let ret = OutTyOf lx, (if whole: res else: Peel res)
    ((pts, ret))

# A function's type parameters, in its scheme's order. A type variable the Rust signature
# erases (a supplier's `o`, under a blueprint and a live element) is no Rust type parameter:
# rustc could not infer it.
FnGenerics: unbounded fn Lx, Text, Scheme -> [((Text, [Text]))]
fn FnGenerics lx, qk, sc:
    let ((pts, ret)) = SignatureOut lx, qk, sc
    let used = Fold (Push pts, ret), [[]], \|acc, t| UnionTexts acc, (TyParamsIn t)
    Filter (SchemeGenerics lx, sc), \|((g, ignore))| HasText used, g

# A plain function: its scheme's types, its clauses as a `match`.
FnDefOf: unbounded fn Lx, Text, [FnClause], Scheme -> FnDef
fn FnDefOf lx, qk, clauses, sc = FnDefIn lx, qk, qk, clauses, sc

# `FnDefOf` for a body that is not the definition of the function's own name: an impl's
# method and a trait's default are lowered under their trait's method's name, and are
# definitions of their own among the program's instantiations (`definition`, their
# `InstanceKey`).
FnDefIn: unbounded fn Lx, Text, Text, [FnClause], Scheme -> FnDef
fn FnDefIn lx, definition, qk, clauses, sc:
    let ((ptys, res)) = SignatureTys sc
    # A plain function is lifted: its `$` and `!` values are read at the caller's read point
    # (gap LE), so its body has their values. One whose parameters or result hold a dynamic
    # or an event below the top takes and gives them whole, `Dynamic`s and `Event`s (Type
    # System ch. 4, Application; gap LF): its body lifts by mapping them.
    let whole = IsWholeFn lx, qk
    let lxb = update lx:
        &_.whole <= whole
        &_.noCx <= True
        &_.inDefinition <= definition
    let ((pts, ret)) = SignatureOut lx, qk, sc
    let names = ParamNames lx, clauses, pts
    let body = ClausesBody lxb, emptyEnv, clauses, names, ptys, FnBodyValue, "c", ret
    let params = Each (Range0 (Len pts)), \|i| (((Or (Each names, \|((n, ignore))| n)[i], "arg"), (OutRef (Or pts[i], OutUnit))))
    let generics = FnGenerics lx, qk, sc
    FnDef(name=(Or lx.rsNames[qk], (Snake (BareName qk))), generics=generics, params=params, ret=ret, body=body, doc=(SignatureText lx, qk), public=True)

# The type parameters a Rust type names.
TyParamsIn: fn OutTy -> [Text]
fn TyParamsIn t = match t:
    OutGen n: [[n]]
    OutNamed ignore, ts: Fold ts, [[]], \|acc, x| UnionTexts acc, (TyParamsIn x)
    OutTuple ts: Fold ts, [[]], \|acc, x| UnionTexts acc, (TyParamsIn x)
    OutFn ts, r: Fold ts, (TyParamsIn r), \|acc, x| UnionTexts acc, (TyParamsIn x)
    OutJobFn a, r: UnionTexts (TyParamsIn a), (TyParamsIn r)
    OutMap k, v: UnionTexts (TyParamsIn k), (TyParamsIn v)
    OutOpt x: TyParamsIn x
    OutRes x: TyParamsIn x
    OutArray x: TyParamsIn x
    OutJob x: TyParamsIn x
    OutEvent x: TyParamsIn x
    OutDyn x: TyParamsIn x
    OutRc x: TyParamsIn x
    OutRef x: TyParamsIn x
    OutHold x: TyParamsIn x
    OutCell x: TyParamsIn x
    OutLive x: TyParamsIn x
    otherwise: [[]]

# A definition's Prism signature, for the doc comment.
SignatureText: fn Lx, Text -> Text
fn SignatureText lx, qk = match lx.g.vals[qk]:
    ? v: match lx.g.srcs[v.file]:
        ? src: Trim (SpanText src, v.span)
        nil: BareName qk
    nil: BareName qk

# A definition's whole Prism source, its signature with it.
DefinitionText: fn Lx, Text -> Text
fn DefinitionText lx, qk:
    let spans = Fold lx.g.defs, [[]], \|acc, d| if d.qk == qk: Push acc, ((d.file, d.span)) else: acc
    let sig = match lx.g.vals[qk]:
        ? v: if v.span.start < (Or (Each spans, \|((ignore, r))| r.start)[0], 0): [[((v.file, v.span))]] else: [[]]
        nil: [[]]
    Join (Each (Append sig, spans), \|((f, r))| SrcText lx, f, r), "\n"

SrcText: fn Lx, Nat, Range -> Text
fn SrcText lx, f, r = match lx.g.srcs[f]:
    ? src: DropTrailingComments (SpanText src, r)
    nil: ""

# A definition's span runs to the next one, so it takes the comments that introduce the
# next (or a test file's header): the quote stops at its last line of code.
DropTrailingComments: fn Text -> Text
fn DropTrailingComments t:
    let lines = SplitOn t, "\n"
    let keep = Fold (Range0 (Len lines)), 0, \|k, i| if IsCodeLine (Or lines[i], ""): i + 1 else: k
    TrimEnd (Join (Take lines, keep), "\n")

IsCodeLine: fn Text -> Bool
fn IsCodeLine l:
    let s = Trim l
    s != "" and (not (HasPrefix s, "#"))

# A top-level `let`: a getter computing its value (pick TL of the README).
LetGetter: unbounded fn Lx, Text, LetDecl -> FnDef
fn LetGetter lx, qk, l:
    let t = OutTyOf lx, (Peel (TypeAt lx, l.value.span))
    let v = ValueOf lx, emptyEnv, l.value
    FnDef(name=(Or lx.rsNames[qk], (Snake (BareName qk))), generics=[[]], params=[[]], ret=t, body=(Own v), doc="let {BareName qk}", public=True)

# ---------------------------------------------------------------------------------------
# Traits and impls (claude/backend.md: a trait is a Rust trait, `derive` impls; a program's
# own `impl ^Show` prints by `p.raw`)
# ---------------------------------------------------------------------------------------

HasOwnShow: fn Lx, Text -> Bool
fn HasOwnShow lx, tn = Fold (Or lx.g.impls["Prelude.Show"], [[]]), False, \|f, im| f or ((not im.derived) and (HeadName im.head) == tn)

HeadName: fn Ty -> Text
fn HeadName (TyCon n, ignore) = n
fn HeadName other = ""

# An impl's head as a word in a function's name: a named type's name; a collection's
# shape with its parts' words, so two impls of one prelude trait at two collections (or at
# one collection of two types) are two functions.
HeadWord: unbounded fn Ty -> Text
fn HeadWord t = match t:
    TyCon "Prelude.NonEmpty", [[c]]: "non_empty_{HeadWord c}"
    TyCon n, ignore: Snake (BareName n)
    TyArray x: "array_of_{HeadWord x}"
    TyMap k, v: "map_of_{HeadWord k}_to_{HeadWord v}"
    TyTuple xs: "tuple_of_{Join (Each xs, \|x| HeadWord x), "_and_"}"
    TyQ q: Snake q
    TyRigid q: Snake q
    otherwise: "value"

# A trait's parameter as `Self` in its methods' types.
SelfIn: unbounded fn Ty, Text -> Ty
fn SelfIn t, param = Instantiated t, [[param]], [[(TyCon "\u{0}Self", [[]])]]

# Whether a trait method's own type parameter is decided by none of its parameters, being
# only in its result (`?Read: fn Text -> ?a`) or under an associated type (`Make: fn Item a
# -> a`):
# a call is decided by the type it gives, never by an argument (`XCallSelf`).
IsResultOnly: fn Lx, Text, Text -> Bool
fn IsResultOnly lx, mq, param = match lx.g.vals[mq]:
    ? v: match v.scheme.ty:
        TyFn ignore, ps, ignore: not (Fold ps, False, \|f, p| f or HasText (DeducibleQs p), param)
        otherwise: True
    nil: False

# The type variables a value of a type decides.
DeducibleQs: fn Ty -> [Text]
fn DeducibleQs t = match t:
    TyQ q: [[q]]
    TyRigid q: [[q]]
    TyCon ignore, xs: Fold xs, [[]], \|acc, x| UnionTexts acc, (DeducibleQs x)
    TyFn ignore, ps, r: Fold ps, (DeducibleQs r), \|acc, x| UnionTexts acc, (DeducibleQs x)
    TyTuple xs: Fold xs, [[]], \|acc, x| UnionTexts acc, (DeducibleQs x)
    TyArray x: DeducibleQs x
    TyMap k, v: UnionTexts (DeducibleQs k), (DeducibleQs v)
    TySig ignore, x: DeducibleQs x
    TyAt x, ignore: DeducibleQs x
    TyElem ignore, x: DeducibleQs x
    # an associated type's argument is not decided by a value of it (`Item a` is `Nat` at
    # every `a` whose impl chooses `Nat`)
    TyAssoc ignore, ignore, ignore: [[]]
    otherwise: [[]]

# The names a trait's methods whose parameter is only in their result take in the target.
ResultOnlyNames: fn Lx, TraitInfo -> [Text]
fn ResultOnlyNames lx, tr = Each (Filter tr.methods, \|mq| IsResultOnly lx, mq, tr.param), \|mq| Or lx.rsNames[mq], (Snake (BareName mq))

TraitDefOf: unbounded fn Lx, TraitInfo -> TraitDef
fn TraitDefOf lx0, tr:
    # a default's body has the trait's parameter as `Self`, as its signature does
    let lx = update (InModule lx0, tr.file, tr.home):
        &_.subst <= Insert &_.subst, tr.param, (TyCon "\u{0}Self", [[]])
    let methods = Each tr.methods, \|mq|
        let v = Or lx.g.vals[mq], (Builtin mq, (Mono TyErr))
        let sc = update v.scheme:
            &_.ty <= SelfIn &_.ty, tr.param
            &_.qs <= Filter &_.qs, \|q| q != tr.param
            &_.bounds <= Filter &_.bounds, \|((q, ignore))| q != tr.param
        let defaultQk = Fold tr.defaults, "", \|f, dq| if (BareName dq) == (BareName mq): dq else: f
        let clauses = if defaultQk == "": [[]] else: DefaultClauses lx.g, defaultQk
        let fd = FnDefIn lx, (if defaultQk == "": mq else: defaultQk), mq, (if (Len clauses) == 0: [[dummyClause]] else: clauses), sc
        update fd:
            &_.public <= (Len clauses) > 0
    TraitDef(name=(TraitName tr.name), resultOnly=(ResultOnlyNames lx, tr), assocs=(Each tr.assocs, \|a| Camel a), methods=methods, defaults=tr.defaults, doc=(TypeDoc lx, (TyInfo(name=tr.name, home=tr.home, params=[[]], body=BOpaque, derives=[[]], file=tr.file, span=tr.span))))

DefaultClauses: fn G, Text -> [FnClause]
fn DefaultClauses g, qk = Fold g.defs, [[]], \|acc, d| if d.qk == qk: DefaultOf d, acc else: acc

DefaultOf: fn Def, [FnClause] -> [FnClause]
fn DefaultOf d, other = match d.body:
    DbDefault cs, ignore: cs
    otherwise: other

# A program's trait as an existential keeps it (`PackedDef`), when every method can be
# asked of a packed value: the trait has no associated type; each method has no type
# parameter of its own, takes the trait's parameter as at least one whole parameter (the
# dictionary is found in a packed argument), and names it nowhere else but as its whole
# result. `nil` for any other trait: an `any` of it is refused where it is packed
# (`AnyValue`).
?PackedDefOf: unbounded fn Lx, TraitInfo -> ?PackedDef
fn ?PackedDefOf lx0, tr:
    let lx = InModule lx0, tr.file, tr.home
    let hiddenTy = TyCon "\u{0}Self", [[]]
    let ?methods = Fold tr.methods, (? [[]]), \|?acc, mq| match ?acc:
        nil: nil
        ? acc:
            let v = Or lx.g.vals[mq], (Builtin mq, (Mono TyErr))
            let ((ps, r)) = match v.scheme.ty:
                TyFn ignore, ps, r: ((ps, r))
                other: (([[]], other))
            let marked = Each ps, \|p| Instantiated p, [[tr.param]], [[hiddenTy]]
            let hidden = Each marked, \|m| m == hiddenTy
            let markedResult = Instantiated r, [[tr.param]], [[hiddenTy]]
            let whole = Fold (Range0 (Len ps)), True, \|ok, i| ok and ((Or hidden[i], False) or (Or marked[i], TyErr) == (Or ps[i], TyErr))
            let ownQs = Filter v.scheme.qs, \|q| q != tr.param
            if (Len ownQs) > 0 or not whole or not (Fold hidden, False, \|f, h| f or h) or not (markedResult == hiddenTy or markedResult == r): nil
            else:
                let sc = update v.scheme:
                    &_.ty <= Instantiated &_.ty, [[tr.param]], [[(TyAny [[tr.name]])]]
                    &_.qs <= ownQs
                    &_.bounds <= Filter &_.bounds, \|((q, ignore))| q != tr.param
                ? (Push acc, PackedMethod(method=(FnDefOf lx, mq, [[dummyClause]], sc), hidden=hidden, hiddenResult=(markedResult == hiddenTy)))
    if (HasPrefix tr.name, "Prelude.") or (Len tr.assocs) > 0: nil
    else: match ?methods:
        ? methods: ? PackedDef(name=(TraitName tr.name), tr=(PathIn lx, tr.home, (TraitName tr.name)), methods=methods)
        nil: nil

# The function that makes a trait's dictionary at a type, given a value of it
# (`PackedDef`; the packing's `with_dictionary` takes it).
PackedDictionaryOf: fn Lx, TraitInfo -> Ref
fn PackedDictionaryOf lx, tr = RefIn lx, tr.home, "{Lower (TraitName tr.name)}_packed_of"

# An impl's methods, each with its trait's scheme at the impl's head.
ImplDefOf: unbounded fn Lx, ImplInfo -> ImplDef
fn ImplDefOf lx, im:
    let tr = Or lx.g.traits[im.cls], dummyTraitInfo
    let head = OutTyOf lx, im.head
    let defs = Filter lx.g.defs, \|d| IsMethodOf d, im
    let methods = Each defs, \|d|
        let mq = Fold tr.methods, "", \|found, q| if (BareName q) == d.name: q else: found
        let v = Or lx.g.vals[mq], (Builtin mq, (Mono TyErr))
        let sc = update v.scheme:
            &_.ty <= Instantiated &_.ty, [[tr.param]], [[im.head]]
            &_.qs <= Filter &_.qs, \|q| q != tr.param
            &_.bounds <= Filter &_.bounds, \|((q, ignore))| q != tr.param
        let fd = FnDefIn lx, (InstanceKey d), mq, (MethodClauses d), sc
        if (HasPrefix im.cls, "Prelude."): Renamed fd, "{Snake d.name}_{HeadWord im.head}" else: fd
    # an impl's `where` clauses bound its type parameters, as a function's do
    let generics = Each im.qs, \|q| ((Camel q, (ImplBounds lx, im, q)))
    ImplDef(cls=im.cls, tr=(PathIn lx, tr.home, (TraitName im.cls)), head=head, generics=generics, assocs=(Each im.assocs, \|((an, at))| (((Camel an), (OutTyOf lx, at)))), resultOnly=(ResultOnlyNames lx, tr), methods=methods, doc="")

ImplBounds: unbounded fn Lx, ImplInfo, Text -> [Text]
fn ImplBounds lx, im, q = Fold im.bounds, [["std::Clone"]], \|acc, ((v, cls))| if v == q: UnionTexts acc, (BoundOf lx, cls) else: acc

Renamed: fn FnDef, Text -> FnDef
fn Renamed fd, n = update fd:
    &_.name <= n

IsMethodOf: fn Def, ImplInfo -> Bool
fn IsMethodOf d, im = match d.body:
    DbMethod ignore, cls, other: cls == im.cls and other.span == im.span and other.file == im.file
    otherwise: False

MethodClauses: fn Def -> [FnClause]
fn MethodClauses d = match d.body:
    DbMethod cs, ignore, ignore: cs
    otherwise: [[]]

