# `Lower.Jobs`, a child module of `Lower`.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit r
use Lower.*
use Lower.Types.*
use Lower.Expr.*
use Lower.Patterns.*
use Lower.Templates.*
use Lower.Functions.*
use Lower.Program.*
use Syntax.*
use Syntax.Decls.*
use Syntax.Lexer.*
use Syntax.Lexer.Chars.*
use Syntax.Lexer.Layout.*
use Syntax.Lexer.Words.*
use Syntax.Lexer.Literals.*
use Syntax.Lexer.Templates.*
use Syntax.Lexer.Corpus.*
use Check.Errors.*
use Check.Types.*
use Check.Types.Recording.*
use Check.Types.Unify.*
use Check.Types.Schemes.*
use Check.Types.Colors.*
use Check.Env.*
use Check.Env.Names.*
use Check.Env.Reading.*
use Check.Env.Decls.*
use Check.Env.Traits.*
use Check.Typed.*
use Check.Typed.Print.*
use Lower.Model.*
use Lower.Node.*
use Lower.Node.Def.*
use Lower.Node.Elements.*
use Lower.Node.Static.*
use Lower.Node.Dynamics.*
use Lower.Node.Finish.*
use Lower.Node.Keyed.*
use Lower.Node.Switch.*

# ---------------------------------------------------------------------------------------
# Unbounded functions as step machines (Semantics ch. 7; D6; claude/backend.md, "Unbounded
# functions and `@Run`")
# ---------------------------------------------------------------------------------------

# A job's body: bounded code to the next cycle point (D6: a cycle point at every call of
# an unbounded function from an unbounded function). A tail call leaves no frame: the job
# is the callee with its arguments (`Turn::More`). Any other call is a frame (`Frame`):
# the callee's job runs, and its result resumes the rest of the body. Any other result
# ends the job (`Turn::Finished`). A call under a lambda or in a branch of a `match` or an
# `if` that is not in tail position still runs direct-style inside the cycle (gap DS).
Tail: unbounded fn Lx, Env, Expr -> Ex
fn Tail lx, env, e = match ?FrameCall lx, env, e, True:
    ? c: Frame lx, env, c, (RestReads lx, e.span, c.span, e.span), \|env2| Tail lx, env2, e
    nil: TailHere lx, env, e

TailHere: unbounded fn Lx, Env, Expr -> Ex
fn TailHere lx, env, e = match e.kind:
    EGroup x: Tail lx, env, x
    EUpdate target, b:
        if HasTopWhile lx, b: UpdTail lx, env, target, b, e.span, \|en, v| XCtor (RefRuntime "prism_rtl::Turn::Finished"), [[v]]
        else: XCtor (RefRuntime "prism_rtl::Turn::Finished"), [[Own (ValueOf lx, env, e)]]
    EMatch s, arms: TailMatch lx, env, s, arms, e.span
    EIf (CondExpr c), thenB, (? elseB): XIf (AsBool (ValueOf lx, env, c)), (TailBlock lx, env, thenB), (TailBlock lx, env, elseB)
    # a call right of `and` or `or` in the tail is the tail's (DS)
    EBinary op, l, r if (op == "and" or op == "or") and AnyJob lx, env, r:
        let shortcut = XCtor (RefRuntime "prism_rtl::Turn::Finished"), [[(XBool (op == "or"))]]
        if op == "and": XIf (AsBool (ValueOf lx, env, l)), (Tail lx, env, r), shortcut
        else: XIf (AsBool (ValueOf lx, env, l)), shortcut, (Tail lx, env, r)
    ECall callee, args, ignore, ignore: match ?TailCallee lx, env, callee:
        ? qk:
            let job = Or lx.rsNames[qk], (Snake (BareName qk))
            let jobName = RefIn lx, (OwnerOf qk), (Camel (BareName qk))
            let ((ptys, ignore)) = SchemeParts lx, qk
            let fields = JobFieldNames lx, qk
            let vals = NamedArgsOwned lx, env, qk, args
            if EntersAtOnce lx, qk, args: XMethod (StartOf lx, qk, callee, vals), "cycle", [[]]
            else: if (IsColorPoly lx, qk) or JobByStart lx, qk: XCtor (RefRuntime "prism_rtl::Turn::More"), [[(StartOf lx, qk, callee, vals)]]
            else: XCtor (RefRuntime "prism_rtl::Turn::More"), [[(XCall (RefRuntime "std::Rc::new"), [[(XRecord jobName, (Each (Range0 (Len vals)), \|i| (((Or fields[i], "arg"), (Or vals[i], (XUnit))))))]])]]
        nil: match ?LocalJobFn lx, env, callee:
            ? f: XMethod (StartCall f, (StartArgs lx, env, f, args)), "cycle", [[]]
            nil: match ?PreludeJobCall lx, env, e:
                ? job: XMethod job, "cycle", [[]]
                nil: XCtor (RefRuntime "prism_rtl::Turn::Finished"), [[Own (ValueOf lx, env, e)]]
    otherwise: XCtor (RefRuntime "prism_rtl::Turn::Finished"), [[Own (ValueOf lx, env, e)]]

TailBlock: unbounded fn Lx, Env, Block -> Ex
fn TailBlock lx, env, b = TailFrom lx, env, b, 0

# A job's block from statement `i` on. A statement whose value needs a call is cut there:
# the frame's continuation is the statement again, the call's place bound to its result.
TailFrom: unbounded fn Lx, Env, Block, Nat -> Ex
fn TailFrom lx, env, b, i = TailFromK lx, env, b, i, \|en, ?x| match ?x:
    ? x: Tail lx, en, x
    nil: XCtor (RefRuntime "prism_rtl::Turn::Finished"), [[XUnit]]

# The same, the block's last expression (`nil` for a block that ends in another statement)
# given to `Last`: `Tail` in a function's tail, a continuation's call in a branch (`TailK`).
TailFromK: unbounded fn Lx, Env, Block, Nat, (unbounded fn Env, ?Expr -> Ex) -> Ex
fn TailFromK lx, env, b, i, Last:
    let s = Or b.stmts[i], dummyStmtL
    if i + 1 >= (Len b.stmts): match s.kind:
        SExpr x: Last env, (? x)
        otherwise:
            let ((dos, env2)) = BlockStmt lx, env, s
            Prepend dos, (Last env2, nil)
    else:
        let ?found = match s.kind:
            SLet ignore, ignore, x: ?FrameCall lx, env, x, False
            SExpr x: ?FrameCall lx, env, x, False
            otherwise: nil
        let ?looping = match s.kind:
            SLet p, ignore, x: match x.kind:
                EUpdate target, ub: if HasTopWhile lx, ub: ? ((p, target, ub, x)) else: nil
                otherwise: nil
            otherwise: nil
        let ?generic = match s.kind:
            SLet p, ignore, x: match p.kind:
                PName n: match lx.gens[PlaceKey lx, n.span]:
                    ? gn: ? ((n, gn, x))
                    nil: nil
                otherwise: nil
            otherwise: nil
        let ?branched = match s.kind:
            SLet p, ignore, x: if BranchJobs lx, env, x: ? (((? p), x)) else: nil
            SExpr x: if BranchJobs lx, env, x: ? ((nil, x)) else: nil
            otherwise: nil
        match ?looping:
            ? ((p, target, ub, x)):
                UpdTail lx, env, target, ub, b.span, \|en, v|
                    let po = RustPat lx, p, (TypeAt lx, x.span), Owned, "l{s.span.start}"
                    let rest = TailFromK lx, (BindAll en, po.binds), b, i + 1, Last
                    Prepend [[(DoLet po.pa, v)]], rest
            nil: match ?generic:
              # a generalized `let`: its value at each instantiation, calls and all
              ? ((n, gn, x)): GenericLetTail lx, env, b, s, n, gn, x, 0, \|env2| TailFromK lx, env2, b, i + 1, Last
              nil: match ?found:
                ? c: Frame lx, env, c, (RestReads lx, s.span, c.span, b.span), \|env2| TailFromK lx, env2, b, i, Last
                nil: match ?branched:
                    ? ((?p, x)): KStmt lx, env, b, i, s, ?p, x, Last
                    nil:
                        let ((dos, env2)) = BlockStmt lx, env, s
                        match TailFromK lx, env2, b, i + 1, Last:
                            XBlock more, last: XBlock (Append dos, more), last
                            last: if (Len dos) == 0: last else: XBlock dos, last

# A generalized local `let` in an unbounded function's body (pick LG, `GenericLet`), from
# its instantiation `k` on: each instantiation's value is lowered at that instantiation,
# so a call it makes is a frame whose result has the type the instantiation gives it (a
# color no use decides is bounded there), and a call in a branch ends its branch in a
# continuation over that instantiation's value (`KValue`). The places the frames of one
# instantiation bound are unbound again before the next lowers the same expression. With
# no use the `let` runs once all the same, its calls frames of their own, unless it is a
# lambda (`LetInstantiations`).
GenericLetTail: unbounded fn Lx, Env, Block, Stmt, SName, GenNote, Expr, Nat, (unbounded fn Env -> Ex) -> Ex
fn GenericLetTail lx, env, b, s, n, gn, x, k, Rest:
    let distinct = LetInstantiations lx, gn, x
    match distinct[k]:
        nil: Rest env
        ? inst:
            let lxk = AtInstance lx, inst
            let last = k + 1 >= (Len distinct)
            let WithBound = \|en, value|
                let ((dos, en2)) = GenericLetBound lx, en, n, gn, x, k, value
                let en3 = if last: en2 else: Fold (ExprsIn x), en2, \|e2, inner| update e2:
                    &_.spans <= Remove &_.spans, (PlaceKey lx, inner.span)
                Prepend dos, (GenericLetTail lx, en3, b, s, n, gn, x, k + 1, Rest)
            match ?FrameCall lxk, env, x, False:
                ? c: Frame lxk, env, c, (RestReads lx, s.span, c.span, b.span), \|env2| GenericLetTail lx, env2, b, s, n, gn, x, k, Rest
                nil:
                    if BranchJobs lxk, env, x:
                        # what follows reads the statement again for the next instantiation
                        let from = if last: Range(start=s.span.end, end=s.span.end) else: s.span
                        KValue lxk, env, from, b, x, "{s.span.start}w{k}", WithBound
                    else: WithBound env, (Own (ValueOf lxk, env, x))

# D6 for a call a statement's value needs from a branch: an arm of a `match`, a branch of
# an `if`, the right of `and` or `or` (DS). What follows the statement is bound once, a
# continuation `k` over its value that each branch ends in, so a call in a branch is a
# frame with the rest of its branch, then `k`, after. The borrowed locals the rest reads
# are cloned into it first, as a frame's are.
KStmt: unbounded fn Lx, Env, Block, Nat, Stmt, ?Pattern, Expr, (unbounded fn Env, ?Expr -> Ex) -> Ex
fn KStmt lx, env, b, i, s, ?p, x, Last:
    let after = Range(start=s.span.end, end=s.span.end)
    KValue lx, env, after, b, x, "{s.span.start}", \|envK, value| match ?p:
        ? p:
            let po = RustPat lx, p, (TypeAt lx, x.span), Owned, "l{s.span.start}"
            Prepend [[(DoLet po.pa, value)]], (TailFromK lx, (BindAll envK, po.binds), b, i + 1, Last)
        nil: TailFromK lx, envK, b, i + 1, Last

# A value with a call in a branch (`KStmt`), given to what follows it: `Body` is bound
# once as a continuation `k` over the value, which each branch ends in. The locals the
# source reads from `from` to the end of the block are cloned into it first, as a
# frame's are.
KValue: unbounded fn Lx, Env, Range, Block, Expr, Text, (unbounded fn Env, Ex -> Ex) -> Ex
fn KValue lx, env, from, b, x, label, Body:
    let rest = RestReads lx, from, from, b.span
    # every local the rest reads, owned or borrowed: the branches run before `k` and read
    # their own, so `k` takes copies
    let caps = Fold (Keys env.names), [[]], \|acc, k| match env.names[k]:
        ? (BnLocal rs, mode, bt): if (not (OnSelf rs)) and Reads rest, k: Push acc, ((k, rs, mode, bt)) else: acc
        otherwise: acc
    let dos = Each caps, \|((ignore, rs, mode, bt))| DoLet (PaBind (OuterName rs)), (Own (VlPlace rs, mode, bt))
    let envK = Fold caps, env, \|en, ((k, rs, ignore, bt))| Bind en, k, (BnLocal (XVar (OuterName rs)), Owned, bt)
    let t = OutTyOf lx, (Peel (TypeAt lx, x.span))
    let v = "v{label}"
    let kName = "k_let{label}"
    let kDo = DoLet (PaBind kName), (XClosure True, [[(PaTyped (PaBind v), t)]], (Body envK, (XVar v)))
    Prepend (Push dos, kDo), (TailK lx, env, x, \|en, val| XApply (XVar kName), [[val]])

# An expression whose value goes to a continuation `K` (`KStmt`): a call it makes whatever
# its value is a frame first; a `match`, an `if` or an `and`/`or` with a call in a branch
# ends each branch in `K`; anything else is its value given to `K`.
TailK: unbounded fn Lx, Env, Expr, (unbounded fn Env, Ex -> Ex) -> Ex
fn TailK lx, env, e, K = match ?FrameCall lx, env, e, False:
    ? c: Frame lx, env, c, (RestReads lx, e.span, c.span, e.span), \|env2| TailK lx, env2, e, K
    nil:
        let BlockK = \|en, bl| TailFromK lx, en, bl, 0, \|en2, ?y| match ?y:
            ? y: TailK lx, en2, y, K
            nil: K en2, XUnit
        match e.kind:
            EGroup y: TailK lx, env, y, K
            EMatch sc, arms if BranchJobs lx, env, e:
                let sty = TypeAt lx, sc.span
                let label = "m{e.span.start}"
                let xarms = Each (Range0 (Len arms)), \|j|
                    let arm = Or arms[j], dummyArm
                    let po = ArmPat lx, arm.?pattern, sty, Owned, "{label}_{j}"
                    let envA = BindAll env, po.binds
                    XArm(pat=po.pa, conds=(Append po.conds, (GuardConds lx, envA, arm.?guard)), body=(BlockK envA, arm.body))
                Own (ArmsValue (Own (ValueOf lx, env, sc)), xarms, "'{label}", OutTurn)
            EIf (CondExpr c), thenB, ?elseB if BranchJobs lx, env, e:
                let elseX = match ?elseB:
                    ? eb: BlockK env, eb
                    nil: K env, XUnit
                XIf (AsBool (ValueOf lx, env, c)), (BlockK env, thenB), elseX
            EBinary op, l, r if (op == "and" or op == "or") and AnyJob lx, env, r:
                let rightX = TailK lx, env, r, K
                if op == "and": XIf (AsBool (ValueOf lx, env, l)), rightX, (K env, (XBool False))
                else: XIf (AsBool (ValueOf lx, env, l)), (K env, (XBool True)), rightX
            otherwise: K env, (Own (ValueOf lx, env, e))

# Whether an expression is a `match`, an `if` or an `and`/`or` with a call of an unbounded
# function in a branch, which a frame does not reach as part of the expression (DS).
BranchJobs: unbounded fn Lx, Env, Expr -> Bool
fn BranchJobs lx, env, e = match e.kind:
    EGroup y: BranchJobs lx, env, y
    EMatch ignore, arms: Fold arms, False, \|f, a| f or BlockJob lx, env, a.body
    EIf (CondExpr ignore), thenB, ?elseB: (BlockJob lx, env, thenB) or match ?elseB:
        ? eb: BlockJob lx, env, eb
        nil: False
    EBinary op, ignore, r: (op == "and" or op == "or") and AnyJob lx, env, r
    otherwise: False

# Whether a block or an expression makes a call of an unbounded function anywhere a job
# reaches (not under a lambda): one a frame reaches, or one in a branch of it.
BlockJob: unbounded fn Lx, Env, Block -> Bool
fn BlockJob lx, env, b = Fold b.stmts, False, \|f, st| f or match st.kind:
    SLet ignore, ignore, x: AnyJob lx, env, x
    SExpr x: AnyJob lx, env, x
    otherwise: False

AnyJob: unbounded fn Lx, Env, Expr -> Bool
fn AnyJob lx, env, e = match ?FrameCall lx, env, e, False:
    ? ignore: True
    nil: BranchJobs lx, env, e

# ---- `while` in an `update` block of a job (D6: every turn of a `while` in an unbounded
# `&` block is a cycle point; a loop whose turns are unbounded inside one cycle could keep
# a tick from ending). The block runs as statements up to a `while` at its top level; the
# loop is a job over the block's state (`this` and its `&` locals), one turn a cycle
# (`loop_job`); what follows the loop is its continuation. A loop under an `if` of the
# block, in an arm of a `match` of it, in a `for` of it, or in another loop's body, is one
# too: the `if` or `match` binds what follows it once, as a continuation each branch or arm
# ends in (`IfJob`, `MatchJob`); a loop whose body holds such a loop takes its turns as
# jobs (`loop_turns`), and so does a `for` whose body holds one, taking the next entry its
# test (`ForJob`, `for_turns_keyed`, `for_turns_indexed`).

# Whether an `update` block has a `while` the shrink check did not clear, at its top level
# or under an `if`, a `match`, a `for` or a `while` of it: a loop job (D6). A loop it cleared turns within the
# cycle, one unit of work.
HasTopWhile: fn Lx, Block -> Bool
fn HasTopWhile lx, b = Fold b.stmts, False, \|f, st| f or (IsCycleWhile lx, st) or (HoldsCycleWhile lx, st)

IsCycleWhile: fn Lx, Stmt -> Bool
fn IsCycleWhile lx, st = match st.kind:
    SWhile ignore, ignore: HasKey lx.unshrunk, (PlaceKey lx, st.span)
    otherwise: False

ElseHasTopWhile: fn Lx, ?Block -> Bool
fn ElseHasTopWhile lx, (? b) = HasTopWhile lx, b
fn ElseHasTopWhile lx, nil = False

# A statement whose blocks hold a cycle-point `while`: an `if`, a `match`, a `for`, or a
# `while` (cleared or not) whose body does.
HoldsCycleWhile: fn Lx, Stmt -> Bool
fn HoldsCycleWhile lx, st = match st.kind:
    SWhile ignore, wb: HasTopWhile lx, wb
    SExpr x: match x.kind:
        EIf ignore, thenB, ?elseB: (HasTopWhile lx, thenB) or (ElseHasTopWhile lx, ?elseB)
        EMatch ignore, arms: Fold arms, False, \|f, a| f or HasTopWhile lx, a.body
        EFor ignore, ignore, fb: HasTopWhile lx, fb
        otherwise: False
    otherwise: False

# An `update` block in a job, its value given to `Cont` (with the environment outside the
# block); `to` is where the source the continuation covers ends.
UpdTail: unbounded fn Lx, Env, Expr, Block, Range, (unbounded fn Env, Ex -> Ex) -> Ex
fn UpdTail lx, env, target, b, to, Cont:
    let t = OutTyOf lx, (Peel (TypeAt lx, target.span))
    let tv = ValueOf lx, env, target
    let env1 = Bind env, "&_", (BnLocal (XVar "this"), Owned, t)
    Prepend [[(DoLet (PaTyped (PaMut "this"), t), (Own tv))]], (UpdTailFrom lx, env, env1, b, 0, to, Cont)

UpdTailFrom: unbounded fn Lx, Env, Env, Block, Nat, Range, (unbounded fn Env, Ex -> Ex) -> Ex
fn UpdTailFrom lx, outer, env, b, i, to, Cont:
    if i >= (Len b.stmts): Cont outer, (XVar "this")
    else:
        let s = Or b.stmts[i], dummyStmtL
        let rest = RestReads lx, (Range(start=s.span.end, end=s.span.end)), (Range(start=s.span.end, end=s.span.end)), to
        let Next = \|o2, e2| UpdTailFrom lx, o2, e2, b, i + 1, to, Cont
        if (IsCycleWhile lx, s) or (HoldsCycleWhile lx, s): StmtJob lx, outer, env, s, rest, Next
        else:
            let ((dos, env2)) = UpdStmt lx, env, s
            Prepend dos, (UpdTailFrom lx, outer, env2, b, i + 1, to, Cont)

# A statement that is or holds a cycle-point `while`, as a job, `Cont` after it.
StmtJob: unbounded fn Lx, Env, Env, Stmt, [Text], (unbounded fn Env, Env -> Ex) -> Ex
fn StmtJob lx, outer, env, s, rest, Cont = match s.kind:
    SWhile c, wb: WhileJob lx, outer, env, c, wb, s.span, rest, Cont
    SExpr x: match x.kind:
        EIf c, thenB, ?elseB: IfJob lx, outer, env, c, thenB, ?elseB, s.span, rest, Cont
        EMatch scrut, arms: MatchJob lx, outer, env, scrut, arms, s.span, rest, Cont
        EFor ?binders, source, body: ForJob lx, outer, env, ?binders, source, body, s.span, rest, Cont
        otherwise: InternalBug "a cycle-point `while` in {KindWords x.kind} (gap LP)"
    otherwise: InternalBug "a cycle-point `while` in this statement (gap LP)"

Prepend: fn [Do], Ex -> Ex
fn Prepend dos, (XBlock more, last) = XBlock (Append dos, more), last
fn Prepend dos, x = if (Len dos) == 0: x else: XBlock dos, x

# One `while` as a loop job: the step closure takes the state a turn (`Ok`) or gives it
# back when the condition fails (`Err`); the continuation takes the state again by the
# same names. Locals the loop or the rest reads are cloned into each closure first.
WhileJob: unbounded fn Lx, Env, Env, Cond, Block, Range, [Text], (unbounded fn Env, Env -> Ex) -> Ex
fn WhileJob lx, outer, env, c, wb, span, restReads, Cont:
    let state = Fold (Keys env.names), [[]], \|acc, k| if (not (HasPrefix k, "&")): acc else: match env.names[k]:
        ? (BnLocal rs, ignore, bt): Push acc, ((k, (PlaceStem rs), bt))
        otherwise: acc
    let names = Each state, \|((ignore, rs, ignore))| rs
    let stTy = OutTuple (Each state, \|((ignore, ignore, bt))| bt)
    let pat = PaTuple (Each names, \|n| PaMut "{n}")
    let pack = XTuple (Each names, \|n| XVar n)
    let envS = Fold state, env, \|en, ((k, rs, bt))| Bind en, k, (BnLocal (XVar rs), Owned, bt)
    let loopReads = ReadsIn lx, span
    # The loop's other locals: borrowed or owned, cloned into the step closure.
    let caps = CapsIn envS, loopReads, names
    let capDos = Each caps, \|((ignore, rs, mode, bt))| DoLet (PaBind (CaptureName rs)), (Own (VlPlace rs, mode, bt))
    let envC = Fold caps, envS, \|en, ((k, rs, ignore, bt))| Bind en, k, (BnLocal (XVar (CaptureName rs)), Owned, bt)
    # A body that holds a cycle-point loop of its own runs as a job a turn (`loop_turns`):
    # it ends in the turn's `Ok`, after the inner loop's continuation; else it runs within
    # the cycle and gives `Ok` or `Err` itself (`loop_job`).
    let jobs = HasTopWhile lx, wb
    let Finish = \|x| if jobs: XCtor (RefRuntime "prism_rtl::Turn::Finished"), [[x]] else: x
    let stepTy = OutNamed (RefRuntime "std::Result"), [[stTy, stTy]]
    let again = Finish (XTyped (XCtor (RefRuntime "std::Ok"), [[pack]]), stepTy)
    let stop = Finish (XTyped (XCtor (RefRuntime "std::Err"), [[pack]]), stepTy)
    let Body = \|en| if jobs: UpdTailFrom lx, en, en, wb, 0, wb.span, \|o2, e2| again else: StmtsThen lx, en, wb, again
    let resTy = if jobs: OutNamed (RefRuntime "prism_rtl::Turn"), [[stepTy]] else: stTy
    let turn = match c:
        CondExpr x: XIf (AsBool (ValueOf lx, envC, x)), (Body envC), stop
        CondBind p, x, ?g:
            let po = RustPat lx, p, (TypeAt lx, x.span), Owned, "w{span.start}"
            let envB = BindAll envC, po.binds
            let conds = Append po.conds, (GuardConds lx, envB, ?g)
            Own (ArmsValue (Own (ValueOf lx, envC, x)), [[XArm(pat=po.pa, conds=conds, body=(Body envB)), XArm(pat=PaWild, conds=[[]], body=stop)]], "'w{span.start}", resTy)
    # The continuation: the state by its names again, and the outer locals the rest reads.
    let outCaps = CapsIn outer, restReads, names
    let outDos = Each outCaps, \|((ignore, rs, mode, bt))| DoLet (PaBind (OuterName rs)), (Own (VlPlace rs, mode, bt))
    let outer2 = Fold outCaps, outer, \|en, ((k, rs, ignore, bt))| Bind en, k, (BnLocal (XVar (OuterName rs)), Owned, bt)
    let env2 = Fold outCaps, envS, \|en, ((k, rs, ignore, bt))| Bind en, k, (BnLocal (XVar (OuterName rs)), Owned, bt)
    let stepFn = Prepend capDos, (XClosure True, [[(PaTyped pat, stTy)]], turn)
    let looping = HelperRef (if jobs: "loop_turns" else: "loop_job")
    let enter = XCall (HelperRef "call_then"), [[(XCall looping, [[pack, stepFn]]), (XClosure True, [[(PaTyped pat, stTy)]], (Cont outer2, env2))]]
    Prepend outDos, enter

# A block's statements in an `update` block, then `last`.
StmtsThen: unbounded fn Lx, Env, Block, Ex -> Ex
fn StmtsThen lx, env, b, last:
    let ((dos, ignore)) = UpdStmts lx, env, b.stmts
    XBlock dos, last

# An `if` of an `update` block in a job whose branches hold a cycle-point `while`: what
# follows it is bound once, a continuation over the block's state (`this` and its `&`
# locals) that each branch ends in (a missing `else` is the continuation at once), so a
# loop in a branch is a loop job with the rest of its branch, then the continuation, after.
IfJob: unbounded fn Lx, Env, Env, Cond, Block, ?Block, Range, [Text], (unbounded fn Env, Env -> Ex) -> Ex
fn IfJob lx, outer, env, c, thenB, ?elseB, span, restReads, Cont:
    let state = Fold (Keys env.names), [[]], \|acc, k| if (not (HasPrefix k, "&")): acc else: match env.names[k]:
        ? (BnLocal rs, ignore, bt): Push acc, ((k, (PlaceStem rs), bt))
        otherwise: acc
    let names = Each state, \|((ignore, rs, ignore))| rs
    let stTy = OutTuple (Each state, \|((ignore, ignore, bt))| bt)
    let pat = PaTuple (Each names, \|n| PaMut "{n}")
    let pack = XTuple (Each names, \|n| XVar n)
    let envS = Fold state, env, \|en, ((k, rs, bt))| Bind en, k, (BnLocal (XVar rs), Owned, bt)
    # the continuation: the state by its names again, and the outer locals the rest reads
    let outCaps = CapsIn outer, restReads, names
    let outDos = Each outCaps, \|((ignore, rs, mode, bt))| DoLet (PaBind (OuterName rs)), (Own (VlPlace rs, mode, bt))
    let outer2 = Fold outCaps, outer, \|en, ((k, rs, ignore, bt))| Bind en, k, (BnLocal (XVar (OuterName rs)), Owned, bt)
    let env2 = Fold outCaps, envS, \|en, ((k, rs, ignore, bt))| Bind en, k, (BnLocal (XVar (OuterName rs)), Owned, bt)
    let kName = "k_if{span.start}"
    let kDo = DoLet (PaBind kName), (XClosure True, [[(PaTyped pat, stTy)]], (Cont outer2, env2))
    let ToK = \|o2, e2| XApply (XVar kName), [[pack]]
    let Branch = \|b| UpdTailFrom lx, env, env, b, 0, b.span, ToK
    let elseX = match ?elseB:
        ? eb: Branch eb
        nil: XApply (XVar kName), [[pack]]
    let choose = match c:
        CondExpr x: XIf (AsBool (ValueOf lx, env, x)), (Branch thenB), elseX
        CondBind p, x, ignore:
            let po = RustPat lx, p, (TypeAt lx, x.span), Owned, "u{x.span.start}"
            let thenX = UpdTailFrom lx, (BindAll env, po.binds), (BindAll env, po.binds), thenB, 0, thenB.span, ToK
            Own (ArmsValue (Own (ValueOf lx, env, x)), [[XArm(pat=po.pa, conds=po.conds, body=thenX), XArm(pat=PaWild, conds=[[]], body=elseX)]], "'u{x.span.start}", OutTurn)
    Prepend (Push outDos, kDo), choose

# A `match` of an `update` block in a job whose arms hold a cycle-point `while`, as `IfJob`
# is for an `if`: what follows it is bound once, a continuation over the block's state that
# each arm ends in, so a loop in an arm is a loop job with the rest of its arm, then the
# continuation, after. The arms take the scrutinee owned, since each may be a job's.
MatchJob: unbounded fn Lx, Env, Env, Expr, [Arm], Range, [Text], (unbounded fn Env, Env -> Ex) -> Ex
fn MatchJob lx, outer, env, scrut, arms, span, restReads, Cont:
    let state = Fold (Keys env.names), [[]], \|acc, k| if (not (HasPrefix k, "&")): acc else: match env.names[k]:
        ? (BnLocal rs, ignore, bt): Push acc, ((k, (PlaceStem rs), bt))
        otherwise: acc
    let names = Each state, \|((ignore, rs, ignore))| rs
    let stTy = OutTuple (Each state, \|((ignore, ignore, bt))| bt)
    let pat = PaTuple (Each names, \|n| PaMut "{n}")
    let pack = XTuple (Each names, \|n| XVar n)
    let envS = Fold state, env, \|en, ((k, rs, bt))| Bind en, k, (BnLocal (XVar rs), Owned, bt)
    let outCaps = CapsIn outer, restReads, names
    let outDos = Each outCaps, \|((ignore, rs, mode, bt))| DoLet (PaBind (OuterName rs)), (Own (VlPlace rs, mode, bt))
    let outer2 = Fold outCaps, outer, \|en, ((k, rs, ignore, bt))| Bind en, k, (BnLocal (XVar (OuterName rs)), Owned, bt)
    let env2 = Fold outCaps, envS, \|en, ((k, rs, ignore, bt))| Bind en, k, (BnLocal (XVar (OuterName rs)), Owned, bt)
    let kName = "k_match{span.start}"
    let kDo = DoLet (PaBind kName), (XClosure True, [[(PaTyped pat, stTy)]], (Cont outer2, env2))
    let ToK = \|o2, e2| XApply (XVar kName), [[pack]]
    let sty = TypeAt lx, scrut.span
    let xarms = Each (Range0 (Len arms)), \|i|
        let arm = Or arms[i], dummyArm
        let po = ArmPat lx, arm.?pattern, sty, Owned, "u{scrut.span.start}_{i}"
        let envA = BindAll env, po.binds
        let guarded = Append po.conds, (GuardConds lx, envA, arm.?guard)
        XArm(pat=po.pa, conds=guarded, body=(UpdTailFrom lx, envA, envA, arm.body, 0, arm.body.span, ToK))
    Prepend (Push outDos, kDo), (Own (ArmsValue (Own (ValueOf lx, env, scrut)), xarms, "'u{scrut.span.start}", OutTurn))

# A `for` of an `update` block in a job whose body holds a cycle-point `while`: a loop over
# its entries, as `WhileJob`'s `loop_turns` is over a condition, taking the next entry its
# test, each turn a job (`for_turns_keyed`, `for_turns_indexed` over an array, its key the
# index, `ix` too). The step takes the block's state and the entry's key and value; the
# continuation takes the state again by the same names.
ForJob: unbounded fn Lx, Env, Env, ?ForBinders, Expr, Block, Range, [Text], (unbounded fn Env, Env -> Ex) -> Ex
fn ForJob lx, outer, env, ?binders, source, body, span, restReads, Cont:
    let state = Fold (Keys env.names), [[]], \|acc, k| if (not (HasPrefix k, "&")): acc else: match env.names[k]:
        ? (BnLocal rs, ignore, bt): Push acc, ((k, (PlaceStem rs), bt))
        otherwise: acc
    let names = Each state, \|((ignore, rs, ignore))| rs
    let stTy = OutTuple (Each state, \|((ignore, ignore, bt))| bt)
    let pat = PaTuple (Each names, \|n| PaMut "{n}")
    let pack = XTuple (Each names, \|n| XVar n)
    let envS = Fold state, env, \|en, ((k, rs, bt))| Bind en, k, (BnLocal (XVar rs), Owned, bt)
    # (a non-empty collection is run over as the collection it is)
    let src = Own (PlainValue (ValueOf lx, env, source))
    let sty = Collection (Peel (TypeAt lx, source.span))
    let ((kt, vt, isArray)) = match sty:
        TyArray v: ((OutNat, (OutTyOf lx, v), True))
        TyMap k, v: (((OutTyOf lx, k), (OutTyOf lx, v), False))
        otherwise: ((OutUnit, OutUnit, True))
    let ((vty, kty)) = match sty:
        TyArray v: ((v, (TyCon "Nat", [[]])))
        TyMap k, v: ((v, k))
        otherwise: ((TyErr, TyErr))
    let keyName = "k{span.start}"
    let valName = "v{span.start}"
    let loopReads = ReadsIn lx, span
    # The body's other locals, cloned into the step closure.
    let caps = CapsIn envS, loopReads, names
    let capDos = Each caps, \|((ignore, rs, mode, bt))| DoLet (PaBind (CaptureName rs)), (Own (VlPlace rs, mode, bt))
    let envC = Fold caps, envS, \|en, ((k, rs, ignore, bt))| Bind en, k, (BnLocal (XVar (CaptureName rs)), Owned, bt)
    let env1 = Bind (Bind envC, "key", (BnLocal (XVar keyName), Owned, kt)), "_", (BnLocal (XVar valName), Owned, vt)
    let envK = if isArray: Bind env1, "ix", (BnLocal (XVar keyName), Owned, kt) else: env1
    # `for &s <- &xs:` (Semantics ch. 5): a job cannot keep a reference into the block's
    # state across a cycle, so the entry is a state of the turn's own (`&s`, which an inner
    # loop's job takes with the rest), written back to its place by its key as the turn
    # ends.
    # The bare form rebinds `&_` to the entry (Semantics ch. 5, "Statements"): over a
    # reference path a state of the turn's own written back as `&s` is, over a plain
    # value the turn's copy. The block's own `&_` stays a state of the turn under
    # `blockKey`, so a job inside the turn takes it with the rest, and the entry is
    # written back through it.
    let bare = IsBareFor ?binders
    let blockKey = "&_#block{span.start}"
    let ?ref = match ?RefBinder ?binders:
        ? n: if IsRefPath source: ? (SNameKey n) else: nil
        nil: if bare and IsRefPath source: ? "&_" else: nil
    let envT = if not bare: envK else: match envK.names["&_"]:
        ? b: Bind envK, blockKey, b
        nil: envK
    let refName = "r{span.start}"
    let ((binds, envB)) = match ((?ref, ?binders)):
        ((? nkey, ignore)): (([[(DoLet (PaTyped (PaMut refName), vt), (XVar valName))]], (Bind envT, nkey, (BnLocal (XVar refName), Owned, vt))))
        ((nil, nil)): (([[(DoLet (PaTyped (PaMut refName), vt), (XClone (XVar valName)))]], (Bind envT, "&_", (BnLocal (XVar refName), Owned, vt))))
        ((nil, ? fb)): match fb.?second:
            nil:
                let po = RustPat lx, fb.first, vty, Owned, "e{span.start}"
                (([[(DoLet po.pa, (XClone (XVar valName)))]], (BindAll envK, po.binds)))
            ? second:
                let pk = RustPat lx, fb.first, kty, Owned, "k{span.start}_"
                let pv = RustPat lx, second, vty, Owned, "e{span.start}"
                ((([[(DoLet pk.pa, (XClone (XVar keyName))), (DoLet pv.pa, (XClone (XVar valName)))]]), (BindAll (BindAll envK, pk.binds), pv.binds)))
    let done = XCtor (RefRuntime "prism_rtl::Turn::Finished"), [[pack]]
    let Ended = \|o2, ignore|
        match ?ref:
            ? nkey:
                # (the path is the block's: its `&_`, not the turn's)
                let o2b = WithBlockTopic o2, blockKey
                let entry = XDeref (XCall (HelperRef (if isArray: "at_mut" else: "at_mut_map")), [[(XRefMut (PlaceOf lx, o2b, source)), (XRef (XVar keyName))]])
                let kept = match o2.names[nkey]:
                    ? (BnLocal rs, ignore, ignore): rs
                    otherwise: InternalBug "a `for &` entry's state lost in its turn"
                XBlock [[(DoAssign entry, kept)]], done
            nil: done
    let turn = Prepend binds, (UpdTailFrom lx, envB, envB, body, 0, body.span, Ended)
    let stepFn = Prepend capDos, (XClosure True, [[(PaTyped pat, stTy), (PaTyped (PaBind keyName), kt), (PaTyped (PaBind valName), vt)]], turn)
    let outCaps = CapsIn outer, restReads, names
    let outDos = Each outCaps, \|((ignore, rs, mode, bt))| DoLet (PaBind (OuterName rs)), (Own (VlPlace rs, mode, bt))
    let outer2 = Fold outCaps, outer, \|en, ((k, rs, ignore, bt))| Bind en, k, (BnLocal (XVar (OuterName rs)), Owned, bt)
    let env2 = Fold outCaps, envS, \|en, ((k, rs, ignore, bt))| Bind en, k, (BnLocal (XVar (OuterName rs)), Owned, bt)
    let looping = HelperRef (if isArray: "for_turns_indexed" else: "for_turns_keyed")
    let enter = XCall (HelperRef "call_then"), [[(XCall looping, [[src, pack, stepFn]]), (XClosure True, [[(PaTyped pat, stTy)]], (Cont outer2, env2))]]
    Prepend outDos, enter

# An environment whose `&_` is the block's own again, kept under `blockKey` through a
# bare `for`'s turn (`ForJob`).
WithBlockTopic: fn Env, Text -> Env
fn WithBlockTopic env, blockKey = match env.names[blockKey]:
    ? b: Bind env, "&_", b
    nil: env

# The name an instantiation's key is of (`Twin#inst1`, pick LG); any other key itself.
InstanceOf: fn Text -> Text
fn InstanceOf k = Or (SplitOn k, "#inst")[0], k

# The locals of `env` that `reads` reads, other than `skip`: each to clone into a closure.
CapsIn: fn Env, [Text], [Text] -> [((Text, Ex, Holding, OutTy))]
fn CapsIn env, reads, skip = Fold (Keys env.names), [[]], \|acc, k| match env.names[k]:
    ? (BnLocal rs, mode, bt):
        if (HasText skip, (PlaceStem rs)) or (OnSelf rs) or not (Reads reads, k): acc
        else: Push acc, ((k, rs, mode, bt))
    otherwise: acc

# The first call (leftmost, innermost) of an unbounded function with a job that an
# expression makes whatever its value: not under a lambda, not in an arm of a `match` or
# a branch of an `if`, not right of `and` or `or`. With `top`, a call the expression is
# itself is a tail call, which leaves no frame. A call whose place is bound is done.
?FrameCall: unbounded fn Lx, Env, Expr, Bool -> ?Expr
fn ?FrameCall lx, env, e, top:
    if HasKey env.spans, (PlaceKey lx, e.span): nil
    else: match e.kind:
        EGroup x: ?FrameCall lx, env, x, top
        ECall c, args, ignore, ignore: match ?FirstFrame lx, env, (Each args, \|a| a.value):
            ? x: ? x
            nil:
                if top: nil
                else: match ?TailCallee lx, env, c:
                    ? ignore: ? e
                    nil: match ?LocalJobFn lx, env, c:
                        ? ignore: ? e
                        nil: match ?PreludeJobCall lx, env, e:
                            ? ignore: ? e
                            nil: nil
        EMatch x, ignore: ?FrameCall lx, env, x, False
        EIf (CondExpr x), ignore, ignore: ?FrameCall lx, env, x, False
        EBinary op, l, r: if op == "and" or op == "or": ?FrameCall lx, env, l, False else: ?FirstFrame lx, env, [[l, r]]
        ETuple es: ?FirstFrame lx, env, es
        EArray es: ?FirstFrame lx, env, es
        EUnary ignore, x: ?FrameCall lx, env, x, False
        EField x, ignore, ignore: ?FrameCall lx, env, x, False
        EIndex x, i: ?FirstFrame lx, env, [[x, i]]
        EMethod x, ignore, args: ?FirstFrame lx, env, (Append [[x]], (Each args, \|a| a.value))
        ECast x, ignore, ignore: ?FrameCall lx, env, x, False
        ELit l: match l.kind:
            LText segs: ?FirstFrame lx, env, (Placeholders segs)
            otherwise: nil
        otherwise: nil

Placeholders: fn [TextSeg] -> [Expr]
fn Placeholders segs = Fold segs, [[]], \|acc, sg| match sg:
    SegPlaceholder x: Push acc, x
    otherwise: acc

?FirstFrame: unbounded fn Lx, Env, [Expr] -> ?Expr
fn ?FirstFrame lx, env, es = Fold es, nil, \|?found, x| match ?found:
    ? f: ? f
    nil: ?FrameCall lx, env, x, False

# A frame (D6): entering `call` is a cycle point. The callee's job runs to its result,
# which resumes `Cont` (in the cycle the callee finishes) with the call's place bound to
# it. The continuation is a closure that owns what it reads: each borrowed local the rest
# of the source names is cloned into it first.
Frame: unbounded fn Lx, Env, Expr, [Text], (unbounded fn Env -> Ex) -> Ex
fn Frame lx, env, call, restReads, Cont = match call.kind:
    ECall c, args, ignore, ignore:
        let ?qk = ?TailCallee lx, env, c
        let qk = Or ?qk, ""
        let base = match ?qk:
            ? q: Or lx.rsNames[q], (Snake (BareName q))
            nil: Snake (CalleeText c)
        let v = "{base}_{call.span.start}"
        let t = OutTyOf lx, (Peel (TypeAt lx, call.span))
        let caps = Fold (Keys env.names), [[]], \|acc, k| match env.names[k]:
            ? (BnLocal rs, mode, bt): if (mode == ByRef or mode == RcRef) and Reads restReads, k: Push acc, ((k, rs, mode, bt)) else: acc
            otherwise: acc
        let dos = Each caps, \|((ignore, rs, mode, bt))| DoLet (PaBind (CaptureName rs)), (Own (VlPlace rs, mode, bt))
        let env2 = Fold caps, env, \|en, ((k, rs, ignore, bt))| Bind en, k, (BnLocal (XVar (CaptureName rs)), Owned, bt)
        let env3 = BindSpan env2, (PlaceKey lx, call.span), (VlOwned (XVar v), t)
        let enter = match lx.lifts[PlaceKey lx, call.span]:
            # lifted over `?` or `~` (Type System ch. 4): the peeled arguments matched first,
            # the job entered with their values when all are present, its result wrapped
            # back; an absent one (the leftmost `Err`) is the call's value at once, and the
            # rest of the source runs on it in this cycle
            ? ln if (Len ln.operands) > 0: LiftedFrame lx, env2, env3, c, ?qk, base, args, call, v, t, ln, ln.operands, Cont
            otherwise:
                let ((job, how)) = FrameJob lx, env2, c, ?qk, base, args, call
                XCall how, [[job, (FrameTaker lx, ?qk, c, call, v, t, (Cont env3))]]
        if (Len dos) == 0: enter else: XBlock dos, enter
    otherwise: Cont env

# The closure a frame's job resumes: it takes the job's result as `name`, of the call's
# type `t`, and runs `rest`. Where the callee's signature gives a function of the callee's
# own color and the call makes the color bounded, the job gives the signature's value (a
# `Start`), made again as the call's first (`Recolored`), as a plain call's is
# (`GlobalCall`, `?SignatureResult`).
FrameTaker: unbounded fn Lx, ?Text, Expr, Expr, Text, OutTy, Ex -> Ex
fn FrameTaker lx, ?qk, c, call, name, t, rest:
    let ?signature = match ?qk:
        ? q: match lx.g.vals[q]:
            ? callee: ?SignatureResult lx, callee, c.span, call.span, t
            nil: nil
        nil: nil
    match ?signature:
        ? signatureTy:
            let job = "{name}_job"
            let walked = Recolored lx, (XVar job), signatureTy, (Peel (SubstTy lx, (TypeAt lx, call.span))), 0
            XClosure True, [[(PaTyped (PaBind job), (OutTyOf lx, signatureTy))]], (Prepend [[(DoLet (PaTyped (PaBind name), t), walked)]], rest)
        nil: XClosure True, [[(PaTyped (PaBind name), t)]], rest

# The job a frame enters, and the helper that enters it.
FrameJob: unbounded fn Lx, Env, Expr, ?Text, Text, [Arg], Expr -> ((Ex, Ref))
fn FrameJob lx, env2, c, ?qk, base, args, call:
    let vals = match ?qk:
        ? q: NamedArgsOwned lx, env2, q, args
        nil: match ?LocalJobFn lx, env2, c:
            ? f: StartArgs lx, env2, f, args
            nil: Each args, \|a| Own (ValueOf lx, env2, a.value)
    match ?qk:
        ? q: (((StartOf lx, q, c, vals), (HelperRef (if EntersAtOnce lx, q, args: "call_value" else: "call_then"))))
        nil: match ?LocalJobFn lx, env2, c:
            ? f: (((StartCall f, vals), (HelperRef "call_value")))
            nil: match ?PreludeJobCall lx, env2, call:
                ? pj: ((pj, (HelperRef "call_value")))
                nil: (((InternalBug "a call this frame cannot enter"), (HelperRef "call_then")))

# A frame's call lifted over `?` or `~`, from its first peeled operand (`LiftOperands`, the
# plain form): each matched in turn, its value bound where the operand stands; with all
# present the job is entered and its result, wrapped, resumes the source; an absent one
# resumes it at once with `nil`, or with the operand's `Err`.
LiftedFrame: unbounded fn Lx, Env, Env, Expr, ?Text, Text, [Arg], Expr, Text, OutTy, LiftNote, [Range], (unbounded fn Env -> Ex) -> Ex
fn LiftedFrame lx, env, env3, c, ?qk, base, args, call, v, t, ln, operands, Cont = match operands:
    [[]]:
        let inner = OutTyOf lx, (InnerTy (TypeAt lx, call.span))
        let lxIn = update lx:
            &_.tys <= Insert &_.tys, (PlaceKey lx, call.span), (InnerTy (TypeAt lx, call.span))
            &_.lifts <= Insert &_.lifts, (PlaceKey lx, call.span), LiftNote(at=ln.at, sigil=ln.sigil, operands=[[]])
        let lxOps = Fold ln.operands, lxIn, \|l, r| update l:
            &_.tys <= Insert &_.tys, (PlaceKey lx, r), (InnerTy (TypeAt lx, r))
        let ((job, how)) = FrameJob lxOps, env, c, ?qk, base, args, call
        let wrapped = XCtor (RefRuntime (if ln.sigil == "~": "std::Ok" else: "std::Some")), [[(XVar "{v}_in")]]
        XCall how, [[job, (FrameTaker lxIn, ?qk, c, call, "{v}_in", inner, (Prepend [[(DoLet (PaTyped (PaBind v), t), wrapped)]], (Cont env3)))]]
    otherwise:
        let r = Or operands[0], call.span
        let sv = ValueOf lx, env, (Or (?OperandAt call, r), dummyExpr)
        let it = OutTyOf lx, (InnerTy (TypeAt lx, r))
        let owned = match sv:
            VlOwned ignore, ignore: True
            otherwise: False
        let mode = if owned: Owned else: ByRef
        let x = "o{r.start}_{r.end}"
        let env2 = BindSpan env, (PlaceKey lx, r), (VlPlace (XVar x), mode, it)
        let present = LiftedFrame lx, env2, env3, c, ?qk, base, args, call, v, t, ln, (Drop operands, 1), Cont
        let absent = if ln.sigil == "~": XCtor (RefRuntime "std::Err"), [[Own (VlPlace (XVar "{x}_e"), mode, OutError)]] else: XTyped (XNone), t
        let failArm = XArm(pat=(if ln.sigil == "~": PaCtor (RefRuntime "std::Err"), [[PaBind "{x}_e"]] else: PaUnit (RefRuntime "std::None")), conds=[[]], body=(XBlock [[(DoLet (PaTyped (PaBind v), t), absent)]], (Cont env3)))
        let arms = [[XArm(pat=(PaCtor (RefRuntime (if ln.sigil == "~": "std::Ok" else: "std::Some")), [[PaBind x]]), conds=[[]], body=present), failArm]]
        XMatch (if owned: Own sv else: Ref sv), arms, False, OutTurn

# A local whose value is an unbounded function: its `Start` (claude/backend.md).
?LocalJobFn: unbounded fn Lx, Env, Expr -> ?Vl
fn ?LocalJobFn lx, env, c = match c.kind:
    EName n:
        if (Len n.path) == 1 and HasKey env.names, (SNameKey n): ?JobValue (NameValue lx, env, n, c.span)
        else: nil
    EGroup x: ?LocalJobFn lx, env, x
    EField ignore, ignore, ignore: ?JobValue (ValueOf lx, env, c)
    otherwise: nil

?JobValue: fn Vl -> ?Vl
fn ?JobValue f = match ValueTy f:
    OutJobFn ignore, ignore: ? f
    otherwise: nil

# A `Start` applied: one argument as itself, several as a tuple.
StartCall: fn Vl, [Ex] -> Ex
fn StartCall f, vals = XApply (Ref f), [[OneOrTuple vals]]

OneOrTuple: fn [Ex] -> Ex
fn OneOrTuple [[one]] = one
fn OneOrTuple vals = XTuple vals

CalleeText: fn Expr -> Text
fn CalleeText c = match c.kind:
    EName n: Dotted n.path
    EGroup x: CalleeText x
    otherwise: "call"

# The locals a frame's continuation reads: from `from` to the end of `to`, the call
# included: a local its arguments name is cloned before the frame, so that no inner
# frame finds it still borrowed.
RestReads: fn Lx, Range, Range, Range -> [Text]
fn RestReads lx, from, call, to = ReadsIn lx, (Range(start=from.start, end=to.end))

# The names of the locals read in a range of the file being lowered, as the checker
# resolved each use (pick UN): a name in a comment or a text is no read.
ReadsIn: fn Lx, Range -> [Text]
fn ReadsIn lx, r = Fold (Or lx.useNames[lx.file], [[]]), [[]], \|acc, ((at, n))| if at >= r.start and at < r.end and not (HasText acc, n): Push acc, n else: acc

# Whether `reads` reads the local `k`, its marks aside.
Reads: fn [Text], Text -> Bool
fn Reads reads, k:
    let base = DropPrefix (InstanceOf k), (MarksOf k)
    Fold reads, False, \|found, n| found or (DropPrefix n, (MarksOf n)) == base

TailBody: unbounded fn Lx, Env, FnBody -> Ex
fn TailBody lx, env, (BodyExpr x) = Tail lx, env, x
fn TailBody lx, env, (BodyBlock b) = TailBlock lx, env, b

TailMatch: unbounded fn Lx, Env, Expr, [Arm], Range -> Ex
fn TailMatch lx, env, s, arms, span:
    let sv = ValueOf lx, env, s
    let sty = TypeAt lx, s.span
    let label = "m{span.start}"
    let byRef = Each (Range0 (Len arms)), \|i| ArmPat lx, (Or arms[i], dummyArm).?pattern, sty, ByRef, "{label}_{i}"
    let chain = Fold byRef, False, \|f, po| f or Fold po.conds, False, \|f2, c| f2 or IsLetCond c
    let owned = match sv:
        VlOwned ignore, ignore: not chain
        otherwise: False
    let pats = if owned: Each (Range0 (Len arms)), \|i| ArmPat lx, (Or arms[i], dummyArm).?pattern, sty, Owned, "{label}_{i}" else: byRef
    let xarms = Each (Range0 (Len arms)), \|i|
        let arm = Or arms[i], dummyArm
        let po = Or pats[i], (PatOut(pa=PaWild, conds=[[]], binds=[[]]))
        let env2 = BindAll env, po.binds
        XArm(pat=po.pa, conds=(Append po.conds, (GuardConds lx, env2, arm.?guard)), body=(TailBlock lx, env2, arm.body))
    let scrut = if owned: Own sv else: Ref sv
    Own (ArmsValue scrut, xarms, "'{label}", (OutTurn))

# The unbounded function a call in tail position enters, when it has a job.
?TailCallee: fn Lx, Env, Expr -> ?Text
fn ?TailCallee lx, env, callee = match callee.kind:
    EName n:
        if (Len n.path) == 1 and HasKey env.names, (SNameKey n): nil
        else:
            let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
            match ?qk:
                ? qk: if (HasText lx.unbs, qk) and not (InPrelude lx, qk): ? qk else: nil
                nil: nil
    otherwise: nil

# Whether an unbounded function's job is made by its `Start` alone, never by its fields:
# one with a type parameter that no parameter's type names (`unbounded fn Nat -> [a]`),
# whose struct has a marker field for it that the `Start` fills (the emitters' job).
JobByStart: unbounded fn Lx, Text -> Bool
fn JobByStart lx, qk = match lx.g.vals[qk]:
    ? v:
        let ((ptys, ignore)) = SchemeParts lx, qk
        let named = Fold ptys, [[]], \|acc, p| UnionTexts acc, (TyParamsIn (OutTyOf lx, (Peel p)))
        Fold (SchemeGenerics lx, v.scheme), False, \|found, ((g, ignore2))| found or not (HasText named, g)
    nil: False

# The call of an unbounded function's `Start` at the callee `callee`. Where the job is
# made by its `Start` alone (`JobByStart`: a type parameter no argument decides), the
# type parameters are written out, as the callee's type there gives them.
StartOf: unbounded fn Lx, Text, Expr, [Ex] -> Ex
fn StartOf lx, qk, callee, vals:
    let start = RefIn lx, (OwnerOf qk), "start_{Or lx.rsNames[qk], (Snake (BareName qk))}"
    match lx.g.vals[qk]:
        ? v if JobByStart lx, qk: match ?ParamMatch (Unrigid v.scheme.ty), (TypeAt lx, callee.span), {}:
            ? found: if Fold v.scheme.qs, True, \|all, q| all and HasKey found, q: XCallAt start, (Each v.scheme.qs, \|q| OutTyOf lx, (Or found[q], TyErr)), vals else: XCall start, vals
            nil: XCall start, vals
        otherwise: XCall start, vals

SchemeParts: fn Lx, Text -> (([Ty], Ty))
fn SchemeParts lx, qk = match lx.g.vals[qk]:
    ? v: match v.scheme.ty:
        TyFn ignore, ps, r: ((ps, r))
        other: (([[]], other))
    nil: (([[]], TyErr))

# A job's fields: its function's parameter names.
JobFieldNames: unbounded fn Lx, Text -> [Text]
fn JobFieldNames lx, qk:
    let clauses = ClausesOf lx.g, qk
    let ((ptys, ignore)) = SchemeParts lx, qk
    let pts = Each ptys, \|p| OutTyOf lx, (Peel p)
    # the parameters' names are their binders', read in the function's own file
    let lxf = update lx:
        &_.file <= Fold lx.g.defs, lx.file, \|f, d| if d.qk == qk: d.file else: f
    Each (ParamNames lxf, clauses, pts), \|((n, ignore))| n

ClausesOf: fn G, Text -> [FnClause]
fn ClausesOf g, qk = Fold g.defs, [[]], \|acc, d| if d.qk == qk: DefClauses d, acc else: acc

DefClauses: fn Def, [FnClause] -> [FnClause]
fn DefClauses d, other = match d.body:
    DbFn cs: cs
    otherwise: other

# The job of an unbounded function: its parameters as fields, its body to the next cycle.
JobDefOf: unbounded fn Lx, Text, [FnClause], Scheme -> JobDef
fn JobDefOf lx, qk, clauses, sc:
    let ((ptys, res)) = match sc.ty:
        TyFn ignore, ps, r: ((ps, r))
        other: (([[]], other))
    let pts = Each ptys, \|p| OutTyOf lx, (Peel p)
    let names = ParamNames lx, clauses, pts
    let lxb = update lx:
        &_.inDefinition <= qk
    let body = JobClauses lxb, clauses, names, ptys, pts
    let base = Or lx.rsNames[qk], (Snake (BareName qk))
    JobDef(name=(Camel (BareName qk)), start="start_{base}", generics=(SchemeGenerics lx, sc), fields=(Each (Range0 (Len pts)), \|i| (((Or (Each names, \|((n, ignore))| n)[i], "arg"), (Or pts[i], OutUnit)))), ret=(OutTyOf lx, (Peel res)), body=body, doc=(SignatureText lx, qk))

# A job's clauses: the parameters are the job's fields, `self.t`.
JobClauses: unbounded fn Lx, [FnClause], [((Text, Bool))], [Ty], [OutTy] -> Ex
fn JobClauses lx, clauses, names, ptys, pts:
    let lets = Each (Range0 (Len names)), \|i|
        let ((rs, ignore)) = Or names[i], (("arg", True))
        DoLet (PaBind rs), (XRef (XField XSelf, rs))
    let inner = ClausesBody lx, emptyEnv, clauses, names, ptys, TailBody, "j", (OutTurn)
    XBlock lets, inner
