# The tree of Prism, as `prismc` builds it: `prism_syntax/src/ast.rs` one to one, node for
# node and field for field, so the two parsers print the same S-expressions (sexp.prism).
# Semantics Appendix A.6 form by form, Templates ch. 2's templates, Conformance Appendix A's
# tests. Every node has a `Range`.
#
# Written by Claude, 31 October 2026, on the claude-self-hosting branch. Subject to change:
# Jimmy rewrites it by hand, and an implementer reading it uses their own discretion.
#
# The spellings that differ from ast.rs, each for a reason prismc/README.md gives (pick AS):
# a sigil stack is the text of its sigils, outermost first (`"@$?"`); an operator, a
# keyword, a bound name and an accumulation are the text of their spelling; a choice's
# constructors carry a prefix of their type (`EName`, `PName`, `TName`), since Prism's
# constructors share one namespace per module; and a `Range` is the prelude's `Span` under a
# name the prelude does not take.
module Ast
emit r

# ---------------------------------------------------------------------------------------
# Positions and diagnostics
# ---------------------------------------------------------------------------------------

# A half-open range `[start, end)` of character offsets into one source text (ast.rs counts
# bytes; lines and columns, which are all a diagnostic shows, come out the same).
type Range = record:
    start: Nat
    end: Nat
derive ^Eq, ^Show

# A lexical error, a parse error, or an out-of-scope feature (prism_syntax/src/diag.rs):
# `stage` is `"lex"`, `"parse"` or `"out"`; `feature` names an out-of-scope feature as
# decisions.md's list spells it.
type Diag = record:
    stage: Text
    span: Range
    message: Text
    feature: ?Text
derive ^Eq, ^Show

# ---------------------------------------------------------------------------------------
# Names
# ---------------------------------------------------------------------------------------

# A name as written: attached sigils, outermost first, then a possibly qualified name.
type SName = record:
    sigils: Text
    path: [Text]
    span: Range
derive ^Eq, ^Show

# A plain lowercase identifier: a field, a named argument, a type variable.
type Ident = record:
    name: Text
    span: Range
derive ^Eq, ^Show

# A trait reference, `^Ord`.
type TraitRef = record:
    path: [Text]
    span: Range
derive ^Eq, ^Show

type QualName = record:
    path: [Text]
    span: Range
derive ^Eq, ^Show

# ---------------------------------------------------------------------------------------
# The file
# ---------------------------------------------------------------------------------------

type Module = record:
    name: ?QualName
    emitRow: ?Row
    mods: [ModLine]
    uses: [Use]
    decls: [Decl]
    template: ?Template
    span: Range
derive ^Eq, ^Show

# `mod name` (a section, `name.prism` beside the main file), `mod Name` (a submodule,
# `name/mod.prism`) or `test mod name` (a test module, `name.prism`): a main file's header
# says what its module is made of (docs/modules-style-pass.md).
type ModLine = record:
    name: Ident
    isTest: Bool
    span: Range
derive ^Eq, ^Show

# `use Birds` or `use Birds.*`.
type Use = record:
    target: QualName
    star: Bool
    span: Range
derive ^Eq, ^Show

# Families joined by `|`.
type Row = record:
    terms: [RowTerm]
    span: Range
derive ^Eq, ^Show

type RowTerm = choice:
    RFamily QualName
    RType Type
    RVar Ident
derive ^Eq, ^Show

# ---------------------------------------------------------------------------------------
# Declarations
# ---------------------------------------------------------------------------------------

type Decl = record:
    kind: DeclKind
    span: Range
derive ^Eq, ^Show

type DeclKind = choice:
    DSignature Signature
    DFn FnClause
    DLet LetDecl
    DWidget WidgetDecl
    DType TypeDecl
    DTag TagDecl
    DDerive [TraitRef]
    DTrait TraitDecl
    DImpl ImplDecl
    DCheck CheckDecl
    DTest TestDecl
    DStmt Stmt
derive ^Eq, ^Show

# The name a signature or a definition is for: a name, or in a trait an operator.
type DefName = choice:
    DefSName SName
    DefOp Text, Range
derive ^Eq, ^Show

type Signature = record:
    name: DefName
    ty: Type
    bounds: [Bound]
    span: Range
derive ^Eq, ^Show

type Bound = record:
    var: Ident
    traits: [TraitRef]
    span: Range
derive ^Eq, ^Show

type FnClause = record:
    name: DefName
    params: [Pattern]
    body: FnBody
    span: Range
derive ^Eq, ^Show

type FnBody = choice:
    BodyExpr Expr
    BodyBlock Block
derive ^Eq, ^Show

type LetDecl = record:
    pattern: Pattern
    ty: ?Type
    value: Expr
    span: Range
derive ^Eq, ^Show

type WidgetDecl = record:
    name: SName
    body: Block
    span: Range
derive ^Eq, ^Show

type TypeDecl = record:
    name: QualName
    params: [Ident]
    body: ?TypeBody
    span: Range
derive ^Eq, ^Show

type TypeBody = choice:
    TbRecord [Field]
    TbChoice [Case]
    TbRow
    TbNewtype Case
    TbUnit Ident
    TbAlias Type
derive ^Eq, ^Show

type Field = record:
    name: Ident
    ty: Type
    span: Range
derive ^Eq, ^Show

type Case = record:
    name: SName
    args: [Type]
    indexed: ?Type
    span: Range
derive ^Eq, ^Show

type TagDecl = record:
    name: QualName
    ofType: Type
    bounds: [Bound]
    fields: [Field]
    span: Range
derive ^Eq, ^Show

type TraitDecl = record:
    name: TraitRef
    params: [Ident]
    bounds: [Bound]
    items: [TraitItem]
    span: Range
derive ^Eq, ^Show

type TraitItem = choice:
    TiSignature Signature
    TiFn FnClause
    TiAssocType Ident, [Ident], ?Type, Range
    TiAssocRow SName, Range
derive ^Eq, ^Show

type ImplDecl = record:
    traitRef: TraitRef
    ty: Type
    bounds: [Bound]
    items: [TraitItem]
    span: Range
derive ^Eq, ^Show

# ---------------------------------------------------------------------------------------
# Tests (Conformance ch. 1 and Appendix A)
# ---------------------------------------------------------------------------------------

type CheckDecl = record:
    name: Ident
    lines: [CheckLine]
    span: Range
derive ^Eq, ^Show

type CheckLine = record:
    expr: Expr
    pattern: ?Pattern
    span: Range
derive ^Eq, ^Show

type TestDecl = record:
    name: Ident
    blueprint: Expr
    seed: ?Nat
    steps: [TestStep]
    span: Range
derive ^Eq, ^Show

type TestStep = record:
    withs: [Entry]
    action: StepAction
    checks: [TestCheck]
    span: Range
derive ^Eq, ^Show

type Entry = record:
    element: Expr
    value: Expr
    span: Range
derive ^Eq, ^Show

type StepAction = choice:
    SaBuild
    SaTick
    SaCompute Bool
    SaPush Entry
    SaDeliver [Delivery]
    SaWithOnly
derive ^Eq, ^Show

type Delivery = record:
    kind: DeliveryKind
    target: Target
    span: Range
derive ^Eq, ^Show

type DeliveryKind = choice:
    DkSend Expr
    DkClick
    DkAnswer
derive ^Eq, ^Show

type Target = choice:
    TgPattern Pattern
    TgPath TestPath
    TgElement TestPath
derive ^Eq, ^Show

type TestPath = record:
    segments: [PathSeg]
    span: Range
derive ^Eq, ^Show

type PathSeg = choice:
    PsNum Nat
    PsGen Nat
    PsKey Expr
derive ^Eq, ^Show

type TestCheck = record:
    kind: TestCheckKind
    span: Range
derive ^Eq, ^Show

type TestCheckKind = choice:
    CkExpect Pattern
    CkExpectNone Pattern
    CkExpectCount Pattern, Nat
    CkExpectTop Pattern
    CkExpectTopNone Pattern
    CkRequested Pattern, Pattern
    CkUnrequested Pattern
    CkReturns Pattern
    CkFired Pattern
    CkQuiet
    CkSettles
    CkAborted
    CkSnapshot Text
derive ^Eq, ^Show

# ---------------------------------------------------------------------------------------
# Types
# ---------------------------------------------------------------------------------------

type Type = record:
    kind: TypeKind
    span: Range
derive ^Eq, ^Show

type TypeKind = choice:
    TName SName, [Type]
    TSigiled Text, Type
    TArray Type, Bool
    TTuple [Type]
    TGroup Type
    TMap Type, Type
    TFn Color, [Type], Type
    TEmit Type, Type
    TRowUnion [Type]
    TFamily QualName
    TAny TraitRef
    TUnit Text
    THole SName
    TAbsent
    TNonEmpty Type
derive ^Eq, ^Show

# A function type's color: no word, `unbounded`, or a color variable.
type Color = choice:
    Bounded
    Unbounded
    ColorVar Ident
derive ^Eq, ^Show

# ---------------------------------------------------------------------------------------
# Patterns
# ---------------------------------------------------------------------------------------

type Pattern = record:
    kind: PatternKind
    span: Range
derive ^Eq, ^Show

type PatternKind = choice:
    PName SName
    PIgnore
    PLit Literal
    PNeg Literal
    PUnit
    PNil
    PCtor SName, [Pattern]
    PRecord SName, [FieldPat], Bool
    PSigil Text, Pattern
    PTuple [Pattern]
    PArray [Pattern]
    PGroup Pattern
    PFamily QualName
derive ^Eq, ^Show

type FieldPat = record:
    name: ?Ident
    pattern: Pattern
    span: Range
derive ^Eq, ^Show

# ---------------------------------------------------------------------------------------
# Literals
# ---------------------------------------------------------------------------------------

type Literal = record:
    marks: Text
    kind: LitKind
    span: Range
derive ^Eq, ^Show

# A character is a one-character `Text` (prismc/README.md, pick CH).
type LitKind = choice:
    LInt Text
    LFloat Text
    LDuration Text, Text
    LChar Text
    LText [TextSeg]
derive ^Eq, ^Show

type TextSeg = choice:
    SegPlain Text
    SegPlaceholder Expr
derive ^Eq, ^Show

# ---------------------------------------------------------------------------------------
# Expressions
# ---------------------------------------------------------------------------------------

type Expr = record:
    kind: ExprKind
    span: Range
derive ^Eq, ^Show

# A binary operator is its spelling (`"<|"`, `"on"`, `"-?"`, `"mod"`); a unary one is
# `"not"`, `"neg"` or `"pos"`; a bound name `"key"`, `"ix"`, `"jx"` or `"kx"`.
type ExprKind = choice:
    EName SName
    ELit Literal
    EUnit Text
    ENil Text
    EBound Text
    ETuple [Expr]
    EArray [Expr]
    EMap [((Expr, Expr))]
    EGroup Expr
    ECall Expr, [Arg], Bool, Bool
    EBinary Text, Expr, Expr
    EUnary Text, Expr
    ESuffixed Text, QualName, Expr, Expr
    EFreeSigil Text, Expr
    EField Expr, Text, Ident
    EIndex Expr, Expr
    ETopicField Ident
    ETopicIndex Expr
    EMethod Expr, SName, [Arg]
    ETypeArgs Expr, [Type]
    ECast Expr, Type, Bool
    ENonEmpty Expr
    EAbsent
    ERest
    ELambda ?[Pattern], LambdaBody
    EIf Cond, Block, ?Block
    EMatch Expr, [Arm]
    ERebuild Expr, Block
    EFor ?ForBinders, Expr, Block
    EGiven Block
    EUpdate Expr, Block
    EWidgetBlock Block
    EMonad Expr, Block
    ETemplate Template
    EAny Expr
    ELens [Ident]
    EError
derive ^Eq, ^Show

type Arg = record:
    name: ?Ident
    value: Expr
    span: Range
derive ^Eq, ^Show

type LambdaBody = choice:
    LbExpr Expr
    LbBlock Block
derive ^Eq, ^Show

type Cond = choice:
    CondExpr Expr
    CondBind Pattern, Expr, ?Expr
derive ^Eq, ^Show

type ForBinders = record:
    first: Pattern
    second: ?Pattern
derive ^Eq, ^Show

type Arm = record:
    pattern: ?Pattern
    guard: ?Expr
    body: Block
    span: Range
derive ^Eq, ^Show

# ---------------------------------------------------------------------------------------
# Blocks and statements
# ---------------------------------------------------------------------------------------

type Block = record:
    stmts: [Stmt]
    inline: Bool
    span: Range
derive ^Eq, ^Show

type Stmt = record:
    kind: StmtKind
    span: Range
derive ^Eq, ^Show

# An accumulation is its operator's spelling, `"+="`, `"-="`, `"*="` or `"/="`.
type StmtKind = choice:
    SEmit Row
    SBind Pattern, Expr, ?Expr
    SIgnore Expr
    SLet Pattern, ?Type, Expr
    SSignature Signature
    SFn FnClause
    SWidget WidgetDecl
    SSet Expr, Expr
    SAccum Expr, Text, Expr
    SRequire Expr
    SForbid Expr
    SWhile Cond, Block
    SReturn Expr
    SExpr Expr
derive ^Eq, ^Show

# ---------------------------------------------------------------------------------------
# Templates (Templates ch. 2)
# ---------------------------------------------------------------------------------------

# `keyword` is `"Output"`, `"InlineText"`, `"Raw"` or `"File"`; `delims` `"single"` or
# `"double"`.
type Template = record:
    keyword: Text
    lang: Text
    delims: Text
    parts: [TemplatePart]
    span: Range
derive ^Eq, ^Show

type TemplatePart = choice:
    TpText Text
    TpPlaceholder Expr, ?Nat
    TpBlock Block
    TpCall SName, [Arg], ?[TemplatePart], Range
derive ^Eq, ^Show
