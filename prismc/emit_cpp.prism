# Emission for C++: the model lowering decided (lower.prism) spelled as a C++20 program over
# `runtime/cpp` (`prism_rtl` in C++, whose README maps every Rust type of the library to its
# C++ form) through the templates (templates/cpp.prism, templates/cpp_prelude.prism):
# `Makefile`, three headers per Prism module in its directory (`src/DIR/decl.hpp`,
# `src/DIR/types.hpp`, `src/DIR/module.hpp`, DIR its path, `check/env` for `Check.Env`) and a
# fourth when it has generic definitions (`src/DIR/generic.hpp`),
# two for `Elem` and `Answer` (`src/elem.decl.hpp`, `src/elem.types.hpp`), the program
# classes (`src/programs.hpp`), `src/main.cpp` and one `src/DIR/mod.cpp` (or several) per
# module (prismc/README.md, pick MH). As in emit.prism, nothing here decides (K9).
#
# The model names the Rust runtime's operations (`Rc::new`, `borrow`, `upgrade`); this
# printer maps each to its C++ spelling through the tables `CallName` and `MethodForm`, and
# looks names up in `Cp`, what the model says about its own items: which paths are
# constructors, the order of a record's fields, which names are a node's members (reached
# through the node's shared pointer, `->`).
#
# The C++ forms (prismc/README.md, "The C++ target"): a record is a struct, a choice a
# handle on a shared `std::variant` of its cases (so a value behind an `Rc` is the value
# itself, and a recursive type needs no box); a node is a class deriving from `Node`, held
# by `prism_rtl::Rc`; a `match`, an if-let chain and a labelled block are GNU statement
# expressions whose value is a `Slot`, except a function's closing `match`, which returns
# from its arms.
#
# Written by Claude, 3 November 2026, on the claude-self-hosting branch. Subject to change:
# Jimmy rewrites it by hand, and an implementer reading it uses their own discretion.
module EmitCpp
emit r
use Lexer.*
use Check.Errors.*
use Lower.*
use CppTemplates.*
use CppPreludeTemplate.*

# ---------------------------------------------------------------------------------------
# What the printer looks up
# ---------------------------------------------------------------------------------------

# A type of the program, by its path (`program::Term`): what kind of C++ type it is
# (`choice`, `record`, `newtype`, `unit`, `tag`, `row`, `job`, `answer`), its fields in
# order (a record's, a tag's, a job's), and its type parameters.
type TyInfo = record:
    kind: Text
    fields: [Text]
    params: [Text]
derive ^Eq, ^Show

# The printer's context: the module being printed, the modules, the program's types by
# path and its constructors (a choice's cases by `Type::Case`), the names of every node's
# members, and the fields of the node or job being printed.
type Cp = record:
    home: Text
    mods: [Text]
    types: (Text ==> TyInfo)
    ctors: (Text ==> Text)
    members: (Text ==> Bool)
    methods: (Text ==> Bool)
    fieldNames: (Text ==> Bool)
    fns: (Text ==> Bool)
    fields: (Text ==> OutTy)
    renames: (Text ==> Text)
    pointers: (Text ==> Bool)

# A name as a C++ identifier: a C++ keyword that is no Rust keyword (lowering escaped
# those) takes a `_` after it, as the prelude's `or_` and `int_` do.
CppId: fn Text -> Text
fn CppId n = if InList cppKeywords, n: "{n}_" else: n

let cppKeywords = [["explicit", "and", "and_eq", "asm", "auto", "bitand", "bitor", "bool", "case", "catch", "char", "char8_t", "char16_t", "char32_t", "class", "compl", "concept", "const_cast", "consteval", "constexpr", "constinit", "co_await", "co_return", "co_yield", "decltype", "default", "delete", "double", "dynamic_cast", "explicit", "export", "extern", "float", "friend", "goto", "inline", "int", "long", "mutable", "namespace", "new", "noexcept", "not", "not_eq", "nullptr", "operator", "or", "or_eq", "private", "protected", "public", "register", "reinterpret_cast", "requires", "short", "signed", "sizeof", "static_assert", "static_cast", "switch", "template", "this", "thread_local", "throw", "try", "typedef", "typeid", "typename", "union", "unsigned", "using", "virtual", "void", "volatile", "wchar_t", "xor", "xor_eq", "errno", "assert", "NULL", "EOF", "stdin", "stdout", "stderr", "major", "minor"]]

# A record's field: an identifier that is not a member every value type has (`show`,
# `to_pod`, `from_pod`, a choice's `cases`).
FieldId: fn Text -> Text
fn FieldId f = if InList [["show", "to_pod", "from_pod", "cases"]], f: "{f}_" else: CppId f

# A path as C++, each segment an identifier.
CppPathId: fn Text -> Text
fn CppPathId p = Join (Each (Split p, "::"), \|s| CppId s), "::"

InList: fn [Text], Text -> Bool
fn InList xs, x = Fold xs, False, \|seen, y| seen or y == x

# A path as the model writes it, made absolute: `crate::` dropped, a path that does not
# start with a module put in the module being printed.
Absolute: fn Cp, Text -> Text
fn Absolute cp, p:
    let q = DropPrefix p, "crate::"
    if Fold cp.mods, False, \|f, m| f or HasPrefix q, "{m}::": q else: "{cp.home}::{q}"

# The type a path names: in the module, the prelude's, or the crate's own (`Elem`).
?TypeOf: fn Cp, Text -> ?TyInfo
fn ?TypeOf cp, p:
    let q = DropPrefix p, "crate::"
    match cp.types[Absolute cp, q]:
        ? t: ? t
        nil: match cp.types["prelude::{q}"]:
            ? t: ? t
            nil: cp.types[q]

# The choice a constructor path is a case of (`Term::Var` of `Term`), as the path writes it.
?CaseOf: fn Cp, Text -> ?Text
fn ?CaseOf cp, p:
    let q = DropPrefix p, "crate::"
    match cp.ctors[Absolute cp, q]:
        ? ignore: ? (ParentPath p)
        nil: match cp.ctors["prelude::{q}"]:
            ? ignore: ? (ParentPath p)
            nil: match cp.ctors[q]:
                ? ignore: ? (ParentPath p)
                nil: nil

# A path without its last segment.
ParentPath: fn Text -> Text
fn ParentPath p:
    let segs = Split p, "::"
    Join (Take segs, (Dec (Len segs))), "::"

LastSegment: fn Text -> Text
fn LastSegment p = Or (?Last (Split p, "::")), p

# The context of a model: every module's types, constructors and node members.
Context: fn Model -> Cp
fn Context model:
    let names = Each model.mods, \|m| m.name
    let tops = Fold names, [[]], \|acc, n|
        let top = Or (Split n, "::")[0], n
        if (InList names, top) or InList acc, top: acc else: Push acc, top
    let mods = Push (Append names, tops), "prelude"
    let base = Cp(home="", mods=mods, types=preludeTypes, ctors=preludeCtors, members=nodeBase, methods={}, fieldNames={}, fns={}, fields={}, renames={}, pointers={})
    let withElem = AddRow (AddAnswer base, model.answer), "", model.elem
    Fold model.mods, withElem, \|cp, m| Fold m.items, cp, \|c, it| AddModelItem c, m.name, it

# The prelude's own types and constructors (templates/cpp_prelude.prism).
let preludeTypes = {"prelude::Ordering": TyInfo(kind="choice", fields=[[]], params=[[]]), "prelude::Span": TyInfo(kind="record", fields=[["file", "line", "column", "binding"]], params=[[]]), "prelude::Exception": TyInfo(kind="record", fields=[["kind", "message", "spans", "path_"]], params=[[]]), "prelude::Duration": TyInfo(kind="newtype", fields=[[]], params=[[]]), "prelude::PreludeUnwrap": TyInfo(kind="tag", fields=[[]], params=[[]]), "prelude::PreludeExceptions": TyInfo(kind="tag", fields=[[]], params=[[]])}

let preludeCtors = {"prelude::Ordering::Less": "choice", "prelude::Ordering::Equal": "choice", "prelude::Ordering::Greater": "choice"}

# What every node has: its path, and the runtime's methods a node is called by.
let nodeBase = {"make": True, "push": True, "wake": True, "started": True, "deferred": True, "build": True, "swap": True, "leave": True, "patch": True, "edges": True, "release": True, "clean_up": True, "path": True, "leave_row": True, "answer": True, "document": True, "deliver": True, "document_moved": True, "me": True, "result_dynamic": True}

AddModelItem: fn Cp, Text, Item -> Cp
fn AddModelItem cp, m, it = match it:
    ItType t: AddType cp, m, t
    ItTag t: AddTy cp, "{m}::{t.name}", TyInfo(kind="tag", fields=(Each t.fields, \|((ignore, f, ignore))| f), params=[[]])
    ItRow r: AddRow cp, m, r
    ItJob j: AddTy cp, "{m}::{j.name}", TyInfo(kind="job", fields=(Each j.fields, \|((f, ignore))| f), params=(Each j.generics, \|((g, ignore))| g))
    ItNode n: AddNode cp, m, n
    ItFn f: update cp:
        &_.fns <= Insert &_.fns, "{m}::{f.name}", True
    otherwise: cp

AddTy: fn Cp, Text, TyInfo -> Cp
fn AddTy cp, path, info = update cp:
    &_.types <= Insert &_.types, path, info

AddCtor: fn Cp, Text, Text -> Cp
fn AddCtor cp, path, kind = update cp:
    &_.ctors <= Insert &_.ctors, path, kind

AddMember: fn Cp, Text -> Cp
fn AddMember cp, name = update cp:
    &_.members <= Insert &_.members, name, True

AddType: fn Cp, Text, TyDef -> Cp
fn AddType cp, m, t:
    let path = "{m}::{t.name}"
    let first = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]]))
    match t.shape:
        ShapeRecord: AddTy cp, path, TyInfo(kind="record", fields=(Each first.fields, \|((f, ignore))| f), params=t.params)
        ShapeNewtype: AddTy cp, path, TyInfo(kind="newtype", fields=[[]], params=t.params)
        ShapeUnit: AddTy cp, path, TyInfo(kind="unit", fields=[[]], params=t.params)
        ShapeChoice: Fold t.cases, (AddTy cp, path, TyInfo(kind="choice", fields=[[]], params=t.params)), \|c, k| AddCtor c, "{path}::{k.name}", "choice"

AddRow: fn Cp, Text, RowDef -> Cp
fn AddRow cp, m, r:
    let path = if m == "": r.name else: "{m}::{r.name}"
    Fold r.cases, (AddTy cp, path, TyInfo(kind="choice", fields=[[]], params=[[]])), \|c, ((v, ignore))| AddCtor c, "{path}::{v}", "choice"

AddAnswer: fn Cp, AnswerDef -> Cp
fn AddAnswer cp, a = Fold a.cases, (AddTy cp, "Answer", TyInfo(kind="choice", fields=[[]], params=[[]])), \|c, k| AddCtor c, "Answer::{k.variant}", "choice"

AddNode: fn Cp, Text, NodeDef -> Cp
fn AddNode cp, m, n:
    let withFields = Fold n.fields, cp, \|c, ((f, ignore, ignore))| update (AddMember c, f):
        &_.fieldNames <= Insert &_.fieldNames, f, True
    let withMethods = Fold (Append n.methods, n.hosted), withFields, \|c, md| update (AddMember c, md.name):
        &_.methods <= Insert &_.methods, md.name, True
    let withBuilders = Fold n.builders, withMethods, \|c, b| AddMember c, "{b.name}_build"
    let withGens = Fold n.gens, withBuilders, \|c, g| AddMember c, "{g.name}_build"
    AddTy withGens, "{m}::{n.name}", TyInfo(kind="node", fields=(Each n.fields, \|((f, ignore, ignore))| f), params=[[]])

InHome: fn Cp, Text -> Cp
fn InHome cp, m = update cp:
    &_.home <= m

WithFields: fn Cp, [((Text, OutTy))] -> Cp
fn WithFields cp, fs = update cp:
    &_.fields <= Fold fs, {}, \|acc, ((f, t))| Insert acc, f, t

# ---------------------------------------------------------------------------------------
# Types
# ---------------------------------------------------------------------------------------

CppType: unbounded fn Cp, OutTy -> Text
fn CppType cp, t = match t:
    OutNat: "Nat"
    OutInt: "Int"
    OutU8: "std::uint8_t"
    OutFloat: "double"
    OutBool: "bool"
    OutChar: "char32_t"
    OutText: "Text"
    OutCursor: "Cursor"
    OutUnit: "Unit"
    OutPath: "Path"
    OutDuration: "Duration"
    OutError: "Error"
    OutNamed "Cell", [[i]]: CppType cp, i
    OutNamed "RefCell", [[i]]: CppType cp, i
    OutNamed "Vec", [[i]]: "std::vector<{CppType cp, i}>"
    OutNamed "Result", [[a, b]]: "Expected<{CppType cp, a}, {CppType cp, b}>"
    OutNamed n, [[]]: OwnTypePath cp, n
    OutNamed n, args: "{OwnTypePath cp, n}<{CppTypes cp, args}>"
    OutOpt i: "std::optional<{CppType cp, i}>"
    OutRes i: "Fallible<{CppType cp, i}>"
    OutTuple ts: "std::tuple<{CppTypes cp, ts}>"
    OutArray e: "Array<{CppType cp, e}>"
    OutMap k, v: "Map<{CppType cp, k}, {CppType cp, v}>"
    OutFn ps, r: "Fn<{CppType cp, r}({ParamTypes cp, ps})>"
    OutRef (OutFn ps, r): "const std::function<{CppType cp, r}({ParamTypes cp, ps})>&"
    OutRef (OutSlice i): "std::span<const {CppType cp, i}>"
    OutRef i: "const {CppType cp, i}&"
    OutJobFn a, b: "prism_rtl::Fn<prism_rtl::JobRef<{CppType cp, b}>({CppType cp, a})>"
    OutJob b: "prism_rtl::JobRef<{CppType cp, b}>"
    OutEvent i: "Event<{CppType cp, i}>"
    OutDyn i: "Dynamic<{CppType cp, i}>"
    OutGen n: n
    OutRc i: if IsValueTy cp, i: CppType cp, i else: "prism_rtl::Rc<{CppType cp, i}>"
    OutPod: "Pod"
    OutShowAny: "prism_rtl::Rc<const DynShow>"
    OutHold i: "Hold<{CppType cp, i}>"
    OutStamped i: "Stamped<{CppType cp, i}>"
    OutSnapshot i: "Snapshot<{CppType cp, i}>"
    OutDefer i: "Defer<{CppType cp, i}>"
    OutWeak n: "prism_rtl::Weak<{TypePath n}>"
    OutCell i: CppType cp, i
    OutWakes: "Wakes"
    OutCount: "std::uint32_t"
    OutObj i: "prism_rtl::Rc<{CppType cp, i}>"
    OutSlice i: "std::span<const {CppType cp, i}>"
    OutPort i: "Port<{CppType cp, i}>"
    OutLive i: "Live<{CppType cp, i}>"
    OutUnknown "the job's turn": "decltype(this->cycle())"
    OutUnknown what: "Unit /* {what} */"
    OutQuantified b: "compile_error!(\"{loweringRefusal}a quantified type variable of `{b}`: no instantiation gives it a type\")"

CppTypes: unbounded fn Cp, [OutTy] -> Text
fn CppTypes cp, ts = Join (Each ts, \|t| CppType cp, t), ", "

# A function's parameters as a `std::function` signature takes them: by reference.
ParamTypes: unbounded fn Cp, [OutTy] -> Text
fn ParamTypes cp, ts = Join (Each ts, \|t| "const {CppType cp, t}&"), ", "

# A program's type by its path; one named as a base class of the emitted ones (`Job`,
# `Node`, `Row`), which a class deriving from it would read as the base, from the crate.
OwnTypePath: fn Cp, Text -> Text
fn OwnTypePath cp, n:
    let shadowed = (not (Contains n, ":")) and InList [["Job", "Node", "Row", "Turn", "Program"]], n
    match ?TypeOf cp, n:
        ? ignore: if shadowed: "crate::{cp.home}::{n}" else: TypePath n
        nil: TypePath n

# A Rust path with its turbofish as a C++ path: `Link::<N>` is `Link<N>`, a `_` argument
# left to deduction.
TypePath: fn Text -> Text
fn TypePath p:
    let noFish = Join (Split p, "::<"), "<"
    let noHoles = Join (Split noFish, ", _>"), ">"
    Join (Split noHoles, "<_>"), ""

# A type whose values are shared by copying (the C++ runtime's `IsValue`): an `Rc` of one
# is the value itself.
IsValueTy: fn Cp, OutTy -> Bool
fn IsValueTy cp, t = match t:
    OutNamed n, ignore: match ?TypeOf cp, n:
        ? info: info.kind != "node" and info.kind != "job"
        nil: False
    OutCell ignore: False
    OutPort ignore: False
    OutHold ignore: False
    OutStamped ignore: False
    OutSnapshot ignore: False
    OutDefer ignore: False
    OutObj ignore: False
    OutWakes: False
    otherwise: True

# ---------------------------------------------------------------------------------------
# Expressions
# ---------------------------------------------------------------------------------------

# Whether an expression must be parenthesized as an operand or a receiver.
CppLoose: fn Ex -> Bool
fn CppLoose x = match x:
    XBlock [[]], inner: CppLoose inner
    XBin ignore, ignore, ignore: True
    XUnary ignore, ignore: True
    XIf ignore, ignore, ignore: True
    XRef y: CppLoose y
    XRefMut y: CppLoose y
    XDeref y: CppLoose y
    XClone y: CppLoose y
    otherwise: False

CppTight: unbounded fn Cp, Ex -> Text
fn CppTight cp, x = if CppLoose x: "({CppExpr cp, x})" else: CppExpr cp, x

CppArgs: unbounded fn Cp, [Ex] -> Text
fn CppArgs cp, xs = Join (Each xs, \|x| CppExpr cp, x), ", "

CppExpr: unbounded fn Cp, Ex -> Text
fn CppExpr cp, x = match x:
    XVar n: VarName cp, n
    XPath p: PathValue cp, p
    XSelf: "prism_rtl::share(this)"
    XCx: "cx"
    XConst n: n
    XUnit: "Unit\{\}"
    XNone: "std::nullopt"
    XBool b: if b: "true" else: "false"
    XNat d: if (Len d) <= 9: "Nat({d}u)" else: "*Nat::from_int({CppExpr cp, (XInt d)})"
    XInt d: if (Len (if (HasPrefix d, "-"): AfterFirst d else: d)) <= 18: "Int({d}ll)" else: "*Int::parse(\"{d}\")"
    XByte d: "std::uint8_t({d})"
    XFloat d: d
    XIndex n: "{n}u"
    XChar c: "U'{CppCharEscape c}'"
    XStr t: CppString t
    XRef y: CppExpr cp, y
    XRefMut y: CppExpr cp, y
    XDeref y: CppExpr cp, y
    XTarget y: CppExpr cp, y
    XClone y: CppExpr cp, y
    XWeak y: "prism_rtl::weaken({CppExpr cp, y})"
    XUpgrade y: "prism_rtl::upgrade({CppExpr cp, y})"
    XBreak l, y: "({CppBreak cp, l, y})"
    XBreakLoop: "(\{ break; \})"
    XLater y: "[=](Cx& cx) -> Done \{ {CppExpr cp, y}; return \{\}; \}"
    XFormatStr parts: CppFormat cp, parts, "prism_rtl::str"
    XIsCase y, [[]]: "false"
    XIsCase y, cs: "({Join (Each cs, \|c| CaseTest cp, c, (CppTight cp, y)), " || "})"
    XRefusal what: "compile_error!(\"{loweringRefusal}{Escape what}\")"
    XUnreachable: "throw prism_rtl::Panic(\"entered unreachable code\")"
    XCall f, args: CppCall cp, f, args
    XApply f, args: "{CppTight cp, f}({CppArgs cp, args})"
    XMethod r, m, args: CppMethod cp, r, m, args
    XBin op, l, r: "{CppTight cp, l} {op} {CppTight cp, r}"
    XUnary op, y: "{op}{CppTight cp, y}"
    XCtor p, args: CppCtor cp, p, args
    XRecord p, fs: CppRecord cp, p, fs
    XTuple xs: "std::tuple\{{CppArgs cp, xs}\}"
    XVec [[]]: "\{\}"
    XVec xs: "std::vector\{{CppArgs cp, xs}\}"
    XText t: "Text::lit({CppString t})"
    XFormat parts: if Fold parts, True, \|f, p| f and IsTextPiece p: "Text::lit({CppString (Concat (Each parts, \|p| TextPiece p))})" else: CppFormat cp, parts, "prism_rtl::cat"
    XMatch s, arms, fallback, t: CppMatch cp, s, arms, t
    XChain label, s, arms, t: CppMatch cp, s, arms, t
    XIf c, t, e: CppIf cp, c, t, e
    XBlock [[]], e: CppExpr cp, e
    XBlock dos, e:
        let ((st, cp2)) = CppStatementsCp cp, dos
        StmtExpr st, (Unvexed (CppExpr cp2, e))
    XLabeled label, dos, e, t: CppLabeled cp, label, dos, e, t
    XClosure mv, ps, body: CppClosure cp, mv, ps, body
    XTry y: "TRY({CppExpr cp, y})"
    XField r, f: CppField cp, r, f
    XPart r, k: "std::get<{k}>({CppExpr cp, r})"
    XDecode t, y: "TRY(prism_rtl::from_pod<{CppType cp, t}>({CppExpr cp, y}))"
    XCast y, t: "static_cast<{CppType cp, t}>({CppExpr cp, y})"
    XTyped y, t:
        let e = CppExpr cp, y
        if e == "\{\}" or e == "std::nullopt": "{CppType cp, t}\{\}"
        else: if (IsCtor y, "Ok") or IsCtor y, "Err": "{CppType cp, t}({e})"
        else: e

# A string literal: a NUL as `\000` (an octal escape takes three digits at most), and the
# literal a `std::string_view` (`""sv`) when it holds one, which a `const char*` would end.
CppString: fn Text -> Text
fn CppString t = if Contains t, "\u{0}": "\"{CppEscape t}\"sv" else: "\"{CppEscape t}\""

CppEscape: fn Text -> Text
fn CppEscape t = MapChars t, \|c| if c == "\u{0}": "\\000" else: CharEscape c

IsTextPiece: fn Ex -> Bool
fn IsTextPiece (XText ignore) = True
fn IsTextPiece other = False

TextPiece: fn Ex -> Text
fn TextPiece (XText t) = t
fn TextPiece other = ""

# `format!(..)` as `str(..)` (a message) or `cat(..)` (a `Text`): the pieces in order.
CppFormat: unbounded fn Cp, [Ex], Text -> Text
fn CppFormat cp, parts, how = "{how}({Join (Each parts, \|p| FormatArg cp, p), ", "})"

FormatArg: unbounded fn Cp, Ex -> Text
fn FormatArg cp, (XText t) = CppString t
fn FormatArg cp, x = CppExpr cp, x

CppCharEscape: fn Text -> Text
fn CppCharEscape "'" = "\\'"
fn CppCharEscape c = CharEscape c

# A path as a value: a unit constructor, or a function.
PathValue: fn Cp, Text -> Text
fn PathValue cp, p = if IsNodeMethod cp, p: "&{TypePath (ParentPath p)}::{NodeMethodName cp, (LastSegment p)}" else: match ?CaseOf cp, p:
    ? ty: "{TypePath ty}({TypePath p}\{\})"
    nil: match ?TypeOf cp, p:
        ? info: if info.kind == "unit": "{TypePath p}\{\}" else: TypePath p
        nil: TypePath p

# A node's method by its path (`Host::host_1_answer`), a member function as a value.
IsNodeMethod: fn Cp, Text -> Bool
fn IsNodeMethod cp, p:
    let named = match cp.methods[LastSegment p]:
        ? ignore: True
        nil: False
    named and IsNodeType cp, (ParentPath p)

IsNodeType: fn Cp, Text -> Bool
fn IsNodeType cp, p = match ?TypeOf cp, p:
    ? info: info.kind == "node"
    nil: False

# A field: a node's member through its pointer, a value's directly; `self`'s through
# `this`; a tuple struct's `0` its `a0`.
CppField: unbounded fn Cp, Ex, Text -> Text
fn CppField cp, XSelf, f = "this->{FieldId f}"
fn CppField cp, r, f:
    let name = if IsDigits f: "a{f}" else: FieldId f
    # by the receiver's type where it is known, else by whether some node has the member
    let through = match ?Pointer cp, r:
        ? b: if b: "->" else: "."
        nil: match cp.members[f]:
            ? ignore: "->"
            nil: "."
    "{CppTight cp, r}{through}{name}"

IsDigits: fn Text -> Bool
fn IsDigits t = t != "" and FoldChars t, True, \|ok, c| ok and Contains "0123456789", c

# A constructor: a choice's case wrapped in its handle, a newtype's or unit type's value, the
# runtime's cases by their C++ names.
CppCtor: unbounded fn Cp, Text, [Ex] -> Text
fn CppCtor cp, p, args = match p:
    "Some": "std::optional({CppArgs cp, args})"
    "Ok": if args == [[XUnit]]: "prism_rtl::ok()" else: CppArgs cp, args
    "Err": "unexpected({CppArgs cp, args})"
    "prism_rtl::Turn::More": "prism_rtl::more({CppArgs cp, args})"
    "prism_rtl::Turn::Finished": "prism_rtl::finished({CppArgs cp, args})"
    "Outcome::Fired": "Outcome::fired({CppArgs cp, args})"
    "Outcome::Value": "Outcome::value({CppArgs cp, args})"
    "Segment::Pos": "Segment::pos({CppArgs cp, args})"
    "Segment::Gen": "Segment::gen({CppArgs cp, args})"
    "Segment::Key": "Segment::key({CppArgs cp, args})"
    otherwise: match ?CaseOf cp, p:
        ? ty: "{TypePath ty}({TypePath p}\{{CppArgs cp, args}\})"
        nil: "{TypePath p}\{{CppArgs cp, args}\}"

# A record: its fields in the order declared (designated initializers); a job's by its
# constructor.
CppRecord: unbounded fn Cp, Text, [((Text, Ex))] -> Text
fn CppRecord cp, p, fs:
    let ordered = match ?TypeOf cp, p:
        ? info: Each info.fields, \|f| Or (Fold fs, nil, \|?found, ((g, v))| if g == f: ? v else: ?found), XUnit
        nil: Each fs, \|((ignore, v))| v
    let names = match ?TypeOf cp, p:
        ? info: info.fields
        nil: Each fs, \|((g, ignore))| g
    let kind = match ?TypeOf cp, p:
        ? info: info.kind
        nil: ""
    if kind == "job": "{TypePath p}({CppArgs cp, ordered})"
    else: "{TypePath p}\{{Join (Each (Range0 (Len names)), \|i| ".{FieldId (Or names[i], "")} = {CppExpr cp, (Or ordered[i], XUnit)}"), ", "}\}"

# A call of a named function: the runtime's constructors by their C++ names (`Hold::new` is
# `Hold(..)`), anything else by its path.
CppCall: unbounded fn Cp, Text, [Ex] -> Text
fn CppCall cp, f, args:
    let a = CppArgs cp, args
    match f:
        "Rc::new": if a == "\{\}": "prism_rtl::make_new()" else: "prism_rtl::rc({a})"
        "is_some": "prism_rtl::is_some({a})"
        "is_none": "prism_rtl::is_none({a})"
        "RefCell::new": a
        "Cell::new": a
        "Hold::new": "\{{a}\}"
        "Snapshot::new": "snapshot({a})"
        "Path::root": "Path::root()"
        "Fault::answer": "Fault::answer({a})"
        "Error::new": "Error({a})"
        "Text::from": "Text({a})"
        "String::new": "std::string()"
        "Array::from": "Array({a})"
        "prism_rtl::Dynamic::of": "dynamic_of({a})"
        "Dynamic::of": "dynamic_of({a})"
        "prism_rtl::Event::of": "event_of({a})"
        "prism_rtl::Host::new": "host_new({a})"
        "prism_rtl::forward_on_none": "prism_rtl::forward_on_none<crate::Elem, crate::Answer>({a})"
        "Event::never": "never_event()"
        otherwise: if IsFresh f: "\{\}" else: "{FreeCallPath cp, f}({a})"

# A function's path where a node's member of the same name would hide it: qualified.
FreeCallPath: fn Cp, Text -> Text
fn FreeCallPath cp, f:
    let p = CallPath f
    let hidden = match cp.members[f]:
        ? ignore: True
        nil: (InList stdNames, p) or InList cp.mods, p
    if Contains p, ":": p
    else: if hidden: QualifiedCall cp, f, p
    else: p

QualifiedCall: fn Cp, Text, Text -> Text
fn QualifiedCall cp, f, p = match cp.fns["{cp.home}::{f}"]:
    ? ignore: "{cp.home}::{p}"
    nil: "prelude::{p}"

# The standard library's functions a call by argument-dependent lookup may find instead of
# the program's or the prelude's of the same name (an argument of a `std` type).
let stdNames = [["apply", "begin", "end", "size", "empty", "data", "get", "swap", "move", "forward", "find", "count", "copy", "fill", "sort", "min", "max", "visit", "invoke", "merge", "remove", "replace", "reverse", "unique", "transform", "accumulate", "distance", "next", "prev", "exchange", "tie", "to_string", "clamp", "partition", "equal", "mismatch", "erase", "search", "rotate"]]

# The runtime's constructors of an empty value, whose type the context gives.
IsFresh: fn Text -> Bool
fn IsFresh f = InList [["Stamped::new", "Cache::new", "Port::new", "Map::new", "Array::new", "Vec::new", "Default::default", "Wakes::default", "Defer::new"]], f

# A function's path: a node's constructor is `make` (`build` is the C++ runtime's virtual
# build-list method), the rest as written.
CallPath: fn Text -> Text
fn CallPath f:
    let last = LastSegment f
    let owner = LastSegment (ParentPath f)
    let isType = (ParentPath f) != "" and Contains "ABCDEFGHIJKLMNOPQRSTUVWXYZ", (Head owner)
    if last == "build" and isType: "{TypePath (ParentPath f)}::make"
    else: if last == "new": TypePath (ParentPath f)
    else: CppPathId (TypePath f)

# A method call through the table of the Rust runtime's methods, a node's member through
# its pointer, anything else as a member.
CppMethod: unbounded fn Cp, Ex, Text, [Ex] -> Text
fn CppMethod cp, r, m, args:
    let recv = if r == XSelf: "this" else: CppTight cp, r
    let a = CppArgs cp, args
    let n = Len args
    let sep = if n == 0: "" else: ", "
    match MethodForm m, n:
        "id": recv
        "deref": match ?Pointer cp, r:
            ? b: if b: "(*{recv})" else: recv
            nil: recv
        "assign": "{recv} = {a}"
        "take": "std::exchange({recv}, \{\})"
        "free": "{FreeName m}({recv}{sep}{a})"
        "arrow":
            let through = match ?Pointer cp, r:
                ? b: if b: "->" else: "."
                nil: "->"
            "{recv}{through}{MemberName m}({a})"
        "exchange": "std::exchange({recv}, {a})"
        otherwise:
            let through = match ?Pointer cp, r:
                ? b: if b: "->" else: "."
                nil: match cp.members[m]:
                    ? ignore: "->"
                    nil: "."
            "{recv}{through}{NodeMethodName cp, m}({a})"

# A node's method: a C++ class cannot have a field and a method of one name, so a method
# named as some node's field takes a `_` after it.
NodeMethodName: fn Cp, Text -> Text
fn NodeMethodName cp, m = match ((cp.methods[m], cp.fieldNames[m])):
    ((? ignore, ? ignore)): "{CppId m}_"
    otherwise: MemberName m

# Whether a receiver is reached through a pointer, where the model says: `self`, a field
# of the node or job being printed by its type.
?Pointer: fn Cp, Ex -> ?Bool
fn ?Pointer cp, r = match r:
    XSelf: ? True
    XCx: ? False
    XVar n: cp.pointers[n]
    XClone y: ?Pointer cp, y
    XRef y: ?Pointer cp, y
    XField XSelf, f: match cp.fields[f]:
        ? t: ? (IsPointerTy cp, t)
        nil: nil
    XField (XVar "node"), f: match cp.fields[f]:
        ? t: ? (IsPointerTy cp, t)
        nil: nil
    otherwise: nil

IsPointerTy: fn Cp, OutTy -> Bool
fn IsPointerTy cp, t = match t:
    OutNamed "prism_rtl::Rows", ignore: True
    OutPort ignore: False
    OutRc i: not (IsValueTy cp, i)
    OutObj ignore: True
    OutJob ignore: True
    OutShowAny: True
    otherwise: False

# How a method of the Rust runtime is spelled: `id` the receiver itself (a `RefCell`'s
# borrow), `assign` (a `Cell`'s `set`), `take` (`Option::take`), `free` a function of the
# C++ runtime taking the receiver first, `arrow` a member through a shared pointer, `dot` a
# member.
MethodForm: fn Text, Nat -> Text
fn MethodForm m, n = match ((m, n)):
    (("borrow", 0)): "deref"
    (("borrow_mut", 0)): "deref"
    (("clone", 0)): "id"
    (("iter", 0)): "id"
    (("collect", 0)): "id"
    (("unwrap_or_default", 0)): "free"
    (("for_each", 1)): "free"
    (("into_iter", 0)): "id"
    (("as_ref", 0)): "id"
    (("get", 0)): "id"
    (("set", 1)): "assign"
    (("take", 0)): "take"
    (("replace", 1)): "exchange"
    (("values", 0)): "free"
    (("keys", 0)): "free"
    (("enumerate", 0)): "free"
    (("fire", 2)): "arrow"
    (("subscribe", 1)): "arrow"
    (("unsubscribe", 1)): "arrow"
    (("cycle", 0)): "arrow"
    (("upgrade", 0)): "free"
    (("expect", 1)): "free"
    (("to_pod", 0)): "free"
    (("cloned", 0)): "free"
    (("ok", 0)): "free"
    (("ok_or", 1)): "free"
    (("map", 1)): "free"
    (("iter_mut", 0)): "free"
    (("to_vec", 0)): "free"
    (("filter_some", 0)): "free"
    otherwise: "dot"

FreeName: fn Text -> Text
fn FreeName m = match m:
    "to_pod": "prism_rtl::to_pod"
    "ok": "prism_rtl::ignore"
    "map": "prism_rtl::fmap"
    "to_vec": "path_of"
    "values": "prelude::values"
    "keys": "prelude::keys"
    "enumerate": "prism_rtl::enumerate"
    "unwrap_or_default": "prism_rtl::unwrap_or_default"
    "for_each": "prism_rtl::for_each"
    otherwise: m

MemberName: fn Text -> Text
fn MemberName m = match m:
    "push_str": "append"
    "len": "size"
    "is_empty": "empty"
    "push": "push_back"
    "contains_key": "contains"
    "build": "make"
    otherwise: CppId m

# The test of a constructor against a value, as a C++ condition.
CaseTest: fn Cp, Text, Text -> Text
fn CaseTest cp, c, v = match c:
    "Some": "prism_rtl::is_some({v})"
    "None": "prism_rtl::is_none({v})"
    "Ok": "prism_rtl::is_ok({v})"
    "Err": "prism_rtl::is_err({v})"
    "prism_rtl::Turn::More": "{v}.if_more()"
    "prism_rtl::Turn::Finished": "{v}.if_finished()"
    otherwise: match ?CaseOf cp, c:
        ? ignore: "prism_rtl::is<{CaseType c}>({v})"
        nil: if IsRuntimeCase c: "prism_rtl::is<{CaseType c}>({v})" else: "true"

# A constructor's case type: a choice's case, or a runtime constructor's pattern tag.
CaseType: fn Text -> Text
fn CaseType c = match c:
    "Segment::Pos": "pat::Pos"
    "Segment::Gen": "pat::Gen"
    "Segment::Key": "pat::Key"
    otherwise: TypePath c

# The payload of a constructor's field `i` in a value.
Payload: fn Cp, Text, Text, Nat -> Text
fn Payload cp, c, v, i = match c:
    "Some": "prism_rtl::some_of({v})"
    "Ok": "*{v}"
    "Err": "{v}.error()"
    "prism_rtl::Turn::More": "{v}.if_more()->next"
    "prism_rtl::Turn::Finished": "{v}.if_finished()->value"
    otherwise: match ?CaseOf cp, c:
        ? ignore: "prism_rtl::as<{CaseType c}>({v}).a{i}"
        nil: if IsRuntimeCase c: "prism_rtl::as<{CaseType c}>({v}).a{i}" else: "{v}.a{i}"

IsRuntimeCase: fn Text -> Bool
fn IsRuntimeCase c = (HasPrefix c, "Segment::")

# `if`: a conditional expression.
CppIf: unbounded fn Cp, Ex, Ex, Ex -> Text
fn CppIf cp, c, t, e:
    let ct = CppExpr cp, c
    let ?err = match ((?ErrOf t, ?ErrOf e)):
        ((? y, ignore)): ? y
        ((nil, ? y)): ? y
        otherwise: nil
    let tt = match ?err:
        ? y: OkBranch cp, t, y
        nil: CppExpr cp, t
    let et = match ?err:
        ? y: OkBranch cp, e, y
        nil: CppExpr cp, e
    let short = not (Contains "{tt}{et}", "\n") and (Len "{ct}{tt}{et}") < 70
    if short: "{ct} ? {tt} : {et}" else: CondExpr ct, tt, et

IsCtor: fn Ex, Text -> Bool
fn IsCtor (XCtor p, ignore), c = p == c
fn IsCtor x, c = False

# The failure a branch gives: `Err(y)`, or a block that ends in one.
?ErrOf: fn Ex -> ?Ex
fn ?ErrOf x = match x:
    XCtor "Err", [[y]]: ? y
    XBlock ignore, tail: ?ErrOf tail
    otherwise: nil

# A branch beside an `Err(y)`: an `Ok(x)` (or a block ending in one) as the `Expected` the
# other branch converts to, of `x`'s type and `y`'s.
OkBranch: unbounded fn Cp, Ex, Ex -> Text
fn OkBranch cp, x, y = match x:
    XCtor "Ok", [[v]]: "Expected<std::decay_t<decltype({CppExpr cp, v})>, std::decay_t<decltype({CppExpr cp, y})>>({CppExpr cp, v})"
    XBlock dos, (XCtor "Ok", [[v]]):
        let ((st, cp2)) = CppStatementsCp cp, dos
        StmtExpr st, "Expected<std::decay_t<decltype({CppExpr cp2, v})>, std::decay_t<decltype({CppExpr cp2, y})>>({CppExpr cp2, v})"
    otherwise: CppExpr cp, x

# A closure: a lambda capturing by value (`move`) or by reference.
CppClosure: unbounded fn Cp, Bool, [Pa], Ex -> Text
fn CppClosure cp0, mv, ps, body:
    let cp = Unbind cp0, (Concat2 (Each ps, \|p| PatNames p))
    let params = Join (Each (Range0 (Len ps)), \|i| ClosureParam cp, (Or ps[i], PaWild), i), ", "
    let binds = Concat (Each (Range0 (Len ps)), \|i| ClosureBinds cp, (Or ps[i], PaWild), i)
    let capture = if mv: "=" else: "&"
    let b = CppExpr cp, body
    let ((ret, value)) = match body:
        XRef ignore: ((" -> decltype(auto)", "({b})"))
        XRefMut ignore: ((" -> decltype(auto)", "({b})"))
        otherwise: (("", b))
    if binds == "" and not (Contains b, "\n"): "[{capture}]({params}){ret} \{ return {value}; \}"
    else: Lambda capture, "{params}){ret}", "{binds}return {value};"

ClosureParam: unbounded fn Cp, Pa, Nat -> Text
fn ClosureParam cp, (PaTyped (PaBind n), t), i = "{ParamType cp, t} {CppId n}"
fn ClosureParam cp, (PaTyped (PaMut n), t), i = "{CppType cp, (Unref t)} {CppId n}"
fn ClosureParam cp, (PaTyped p, t), i = "{ParamType cp, t} _p{i}"
fn ClosureParam cp, (PaBind n), i = "auto&& {CppId n}"
fn ClosureParam cp, (PaMut n), i = "auto {CppId n}"
fn ClosureParam cp, PaWild, i = "const auto&"
fn ClosureParam cp, p, i = "const auto& _p{i}"

ClosureBinds: unbounded fn Cp, Pa, Nat -> Text
fn ClosureBinds cp, (PaTyped (PaBind n), t), i = ""
fn ClosureBinds cp, (PaTyped (PaMut n), t), i = ""
fn ClosureBinds cp, (PaTyped p, t), i = ClosureBinds cp, p, i
fn ClosureBinds cp, (PaBind n), i = ""
fn ClosureBinds cp, (PaMut n), i = ""
fn ClosureBinds cp, PaWild, i = ""
fn ClosureBinds cp, p, i = Concat (Each (PatBinds cp, p, "_p{i}"), \|b| "{b}\n")

Unref: fn OutTy -> OutTy
fn Unref (OutRef t) = t
fn Unref t = t

# A parameter's type: a value by `const&`, a reference as its referent's.
ParamType: unbounded fn Cp, OutTy -> Text
fn ParamType cp, t = match t:
    OutRef ignore: CppType cp, t
    OutSlice ignore: CppType cp, t
    OutUnit: "Unit"
    otherwise: CppType cp, t

# ---------------------------------------------------------------------------------------
# Patterns
# ---------------------------------------------------------------------------------------

# What a pattern tests of the value `v` (C++ conditions, in order) and what it binds (C++
# declarations, after the tests hold).
PatConds: unbounded fn Cp, Pa, Text -> [Text]
fn PatConds cp, p, v = match p:
    PaWild: [[]]
    PaBind ignore: [[]]
    PaMut ignore: [[]]
    PaTyped q, ignore: PatConds cp, q, v
    PaUnit c: [[(CaseTest cp, c, v)]]
    PaCtor c, ps:
        let own = CaseTest cp, c, v
        let inner = Concat2 (Each (Range0 (Len ps)), \|i| PatConds cp, (Or ps[i], PaWild), (Payload cp, c, v, i))
        Filter (Append [[own]], inner), \|t| t != "true"
    PaRecord c, fs, ignore: Concat2 (Each fs, \|((f, q))| PatConds cp, q, "{v}.{FieldId f}")
    PaTuple ps: Concat2 (Each (Range0 (Len ps)), \|i| PatConds cp, (Or ps[i], PaWild), "std::get<{i}>({v})")
    PaChar c: [["{v} == U'{CppCharEscape c}'"]]
    PaBool b: [[if b: v else: "!{v}"]]
    PaIndex n: [["{v} == {n}u"]]
    PaConst n: [["{v} == {n}"]]
    PaSlice ps:
        let rest = Fold ps, False, \|f, q| f or IsRest q
        let fixed = Len (Filter ps, \|q| not (IsRest q))
        let size = if rest: "{v}.size() >= {fixed}" else: "{v}.size() == {fixed}"
        Append [[size]], (Concat2 (Each (Range0 (Len ps)), \|i| PatConds cp, (Or ps[i], PaWild), "{v}[{i}]"))
    PaRest ignore: [[]]

PatBinds: unbounded fn Cp, Pa, Text -> [Text]
fn PatBinds cp, p, v = match p:
    PaWild: [[]]
    PaBind n: [["auto&& {CppId n} = {v};"]]
    PaMut n: [["auto {CppId n} = {v};"]]
    PaTyped (PaBind n), t: [["{CppType cp, (Unref t)} {CppId n} = {v};"]]
    PaTyped q, ignore: PatBinds cp, q, v
    PaUnit ignore: [[]]
    PaCtor c, ps: Concat2 (Each (Range0 (Len ps)), \|i| PatBinds cp, (Or ps[i], PaWild), (Payload cp, c, v, i))
    PaRecord c, fs, ignore: Concat2 (Each fs, \|((f, q))| PatBinds cp, q, "{v}.{FieldId f}")
    PaTuple ps: Concat2 (Each (Range0 (Len ps)), \|i| PatBinds cp, (Or ps[i], PaWild), "std::get<{i}>({v})")
    PaSlice ps: Concat2 (Each (Range0 (Len ps)), \|i| SliceBinds cp, (Or ps[i], PaWild), v, i)
    otherwise: [[]]

SliceBinds: unbounded fn Cp, Pa, Text, Nat -> [Text]
fn SliceBinds cp, (PaRest ""), v, i = [[]]
fn SliceBinds cp, (PaRest n), v, i = [["auto {CppId n} = {v}.subspan({i});"]]
fn SliceBinds cp, p, v, i = PatBinds cp, p, "{v}[{i}]"

IsRest: fn Pa -> Bool
fn IsRest (PaRest ignore) = True
fn IsRest other = False

Concat2: fn [ [Text] ] -> [Text]
fn Concat2 xss = Fold xss, [[]], \|acc, xs| Append acc, xs

Conds: fn [Text] -> Text
fn Conds [[]] = "true"
fn Conds cs = Join cs, " && "

# Whether a pattern binds nothing and tests nothing: an arm that always matches.
IsCatchAll: fn Pa -> Bool
fn IsCatchAll p = match p:
    PaWild: True
    PaBind ignore: True
    PaMut ignore: True
    PaTyped q, ignore: IsCatchAll q
    otherwise: False

# Whether an expression leaves instead of giving a value: a `break`, a `return`, an
# unreachable arm.
Leaves: fn Ex -> Bool
fn Leaves x = match x:
    XBreak ignore, ignore: True
    XBreakLoop: True
    XUnreachable: True
    otherwise: False

# A `match` or an if-let chain: the scrutinee bound once, each arm tested in turn; the arm
# that holds sets the value and leaves. A guard that fails, or a `let` after the pattern
# that does not match, goes on to the next arm (Rust's semantics of both).
CppMatch: unbounded fn Cp, Ex, [XArm], OutTy -> Text
fn CppMatch cp, s, arms, (OutUnknown what) = TernaryMatch cp, s, arms
fn CppMatch cp, s, arms, t:
    let ?bound = match s:
        XVar n: ? (CppId n)
        XRef (XVar n): ? (CppId n)
        otherwise: nil
    let subject = Or ?bound, "_m"
    let bind = match ?bound:
        ? ignore: ""
        nil: "auto&& _m = {CppExpr cp, s};\n"
    let lines = Each arms, \|a| MatchArm cp, subject, a, False
    MatchExpr (CppType cp, t), "{bind}{Join lines, "\n"}\n{MatchTail arms}"

# A `match` or an if-let chain that is a function's value (pick CB of the README): the same
# tests, each arm returning its value (an arm's own `match` returning in turn), with no
# statement expression, `Slot` or jump.
ReturnMatch: unbounded fn Cp, Ex, [XArm], OutTy -> Text
fn ReturnMatch cp, s, arms, (OutUnknown what) = "return {TernaryMatch cp, s, arms};"
fn ReturnMatch cp, s, arms, t:
    let ?bound = match s:
        XVar n: ? (CppId n)
        XRef (XVar n): ? (CppId n)
        otherwise: nil
    let subject = Or ?bound, "_m"
    let bind = match ?bound:
        ? ignore: ""
        nil: "auto&& _m = {CppExpr cp, s};\n"
    let lines = Each arms, \|a| MatchArm cp, subject, a, True
    "{bind}{Join lines, "\n"}\n{MatchTail arms}"

# After a match's arms: nothing when the last arm always holds, else the fault.
MatchTail: fn [XArm] -> Text
fn MatchTail arms:
    let ends = match ?Last arms:
        ? a: (IsCatchAll a.pat) and (Len a.conds) == 0
        nil: False
    if ends: "" else: "prism_rtl::unreachable(\"no arm matched\");\n"

# A `match` whose type the model does not give (a job's turn, gap TT of the README): a
# chain of conditional expressions, whose type C++ works out; a guard's test binds the
# pattern's names once for the test and once for the value.
TernaryMatch: unbounded fn Cp, Ex, [XArm] -> Text
fn TernaryMatch cp, s, arms:
    let ?bound = match s:
        XVar n: ? (VarName cp, n)
        XRef (XVar n): ? (VarName cp, n)
        otherwise: nil
    let subject = Or ?bound, "_m"
    let bind = match ?bound:
        ? ignore: ""
        nil: "auto&& _m = {CppExpr cp, s};\n"
    # an arm that tests nothing ends the chain: the arms after it are never reached
    let reached = Fold arms, (([[]], False)), \|((acc, done)), a| if done: ((acc, done)) else: (((Push acc, a), (Len (PatConds cp, a.pat, subject)) == 0 and (Len a.conds) == 0))
    let ((kept, ends)) = reached
    let parts = Each kept, \|a| TernaryArm cp, subject, a
    let lastText = if ends: "" else: "\n    : throw prism_rtl::Panic(\"no arm matched\")"
    StmtExpr "{bind}", "{Join parts, "\n    : "}{lastText}"

TernaryArm: unbounded fn Cp, Text, XArm -> Text
fn TernaryArm cp0, subject, a:
    let cp = Unbind cp0, (ArmNames a)
    let tests = PatConds cp, a.pat, subject
    let binds = PatBinds cp, a.pat, subject
    let n = Len a.conds
    let lets = Concat2 (Each (Range0 n), \|i| CondBinds cp, (Or a.conds[i], (CcIf XUnit)), (Or (n -? i), 0))
    let value = if (Len binds) + (Len lets) == 0: CppExpr cp, a.body else: StmtExpr (Join (Append binds, lets), "\n"), (CppExpr cp, a.body)
    let guard = if (Len a.conds) == 0: [[]] else: [[(StmtExpr (Join binds, "\n"), (GuardTest cp, a.conds))]]
    let all = Append tests, guard
    if (Len all) == 0: value else: "{Conds all} ? {value}"

CondBinds: unbounded fn Cp, Cc, Nat -> [Text]
fn CondBinds cp, (CcLet p, x), k:
    let ((v, pre)) = CondSubject cp, x, k
    Append pre, (PatBinds cp, p, v)
fn CondBinds cp, (CcIf x), k = [[]]

# The value a condition's `let` matches: a place as it is; any other value in a local
# (`_c2`), so that what the pattern binds by reference into it lives as long as the
# bindings do. `k` counts the conditions left, which tells the locals of one arm apart.
CondSubject: unbounded fn Cp, Ex, Nat -> ((Text, [Text]))
fn CondSubject cp, x, k = if IsPlaceEx x: (((CppTight cp, x), [[]])) else: (("_c{k}", [["auto&& _c{k} = {CppExpr cp, x};"]]))

IsPlaceEx: fn Ex -> Bool
fn IsPlaceEx x = match x:
    XVar ignore: True
    XField y, ignore: IsPlaceEx y
    XPart y, ignore: IsPlaceEx y
    XTarget ignore: True
    XSelf: True
    XRef y: IsPlaceEx y
    XDeref y: IsPlaceEx y
    otherwise: False

# The conditions after a pattern as one test, each `let` binding before the next.
GuardTest: unbounded fn Cp, [Cc] -> Text
fn GuardTest cp, [[]] = "true"
fn GuardTest cp, cs:
    let first = Or cs[0], (CcIf XUnit)
    let rest = GuardTest cp, (Drop cs, 1)
    match first:
        CcIf x: if (Len cs) == 1: CppTight cp, x else: "{CppTight cp, x} && {rest}"
        CcLet p, x:
            let ((v, pre)) = CondSubject cp, x, (Len cs)
            let tests = Conds (PatConds cp, p, v)
            let whole = if (Len cs) == 1: tests else: "{tests} && {StmtExpr (Join (PatBinds cp, p, v), "\n"), rest}"
            if (Len pre) == 0: whole else: StmtExpr (Join pre, "\n"), whole

# One arm: its tests, its bindings, and its value set and the match left, or (`returns`)
# its value returned from the function.
MatchArm: unbounded fn Cp, Text, XArm, Bool -> Text
fn MatchArm cp0, subject, a, returns:
    let cp = Unbind cp0, (ArmNames a)
    let tests = PatConds cp, a.pat, subject
    let binds = PatBinds cp, a.pat, subject
    let body = if returns: CppBody cp, a.body else: if Leaves a.body: "{CppExpr cp, a.body};" else: "_v.set({CppExpr cp, a.body});\ngoto _done;"
    let guarded = if (Len a.conds) == 0: body else: GuardedArm cp, a.conds, body
    let inner = Join (Append binds, [[guarded]]), "\n"
    if (Len tests) == 0: Braced inner else: IfBlock (Conds tests), inner

# The conditions after a pattern, nested so that each `let` binds before the next test.
GuardedArm: unbounded fn Cp, [Cc], Text -> Text
fn GuardedArm cp, [[]], body = body
fn GuardedArm cp, cs, body:
    let first = Or cs[0], (CcIf XUnit)
    let rest = GuardedArm cp, (Drop cs, 1), body
    match first:
        CcIf x: IfBlock (CppExpr cp, x), rest
        CcLet p, x:
            let ((v, pre)) = CondSubject cp, x, (Len cs)
            let inner = IfBlock (Conds (PatConds cp, p, v)), (Join (Append (PatBinds cp, p, v), [[rest]]), "\n")
            if (Len pre) == 0: inner else: Braced (Join (Push pre, inner), "\n")

# A labelled block with its value: a `break` sets the value and jumps to the end.
CppLabeled: unbounded fn Cp, Text, [Do], Ex, OutTy -> Text
fn CppLabeled cp, label, dos, e, t:
    let l = CppLabel label
    let last = if Leaves e: "{CppExpr cp, e};" else: "{l}_v.set({CppExpr cp, e});"
    LabeledExpr l, (CppType cp, t), (Join (Push (Each dos, \|d| CppStatement cp, d), last), "\n")

CppLabel: fn Text -> Text
fn CppLabel l = if (HasPrefix l, "'"): AfterFirst l else: l

CppBreak: unbounded fn Cp, Text, Ex -> Text
fn CppBreak cp, l, y:
    let n = CppLabel l
    "\{ {n}_v.set({CppExpr cp, y}); goto {n}; \}"

# ---------------------------------------------------------------------------------------
# Statements
# ---------------------------------------------------------------------------------------

CppStatements: unbounded fn Cp, [Do] -> Text
fn CppStatements cp, dos:
    let ((st, ignore)) = CppStatementsCp cp, dos
    st

# Statements in order, each in the context the ones before it leave: a `let` that rebinds a
# name from its own old value (Rust's shadowing, `let mut fuel = fuel.clone()`) binds a new
# name, which the statements after it read.
CppStatementsCp: unbounded fn Cp, [Do] -> ((Text, Cp))
fn CppStatementsCp cp, dos:
    let ((lines, last)) = Fold dos, (([[]], cp)), \|((acc, c)), d|
        let c2 = Rebound c, d
        let line = match d:
            DoLet p, x: CppLet c, c2, p, x
            otherwise: CppStatement c2, d
        (((Push acc, line), c2))
    (((Join lines, "\n"), last))

# A block's last expression that C++ would read as a declaration (`Text(out);` declares
# `out`), parenthesized.
Unvexed: fn Text -> Text
fn Unvexed t:
    let head = Or (Split t, "(")[0], ""
    let typeLike = (Contains head, ":") or Contains "ABCDEFGHIJKLMNOPQRSTUVWXYZ", (Head head)
    let vexing = (LastChar t) == ")" and (not (Contains head, " ")) and head != "" and typeLike
    if vexing: "({t})" else: t

# The context after a statement: a `let` of a name its value reads renames it.
Rebound: unbounded fn Cp, Do -> Cp
fn Rebound cp, d = match d:
    DoLetElse p, ignore, ignore: Unbind cp, (PatNames p)
    DoLet (PaTuple ps), ignore: Unbind cp, (PatNames (PaTuple ps))
    DoLet (PaCtor c, ps), ignore: Unbind cp, (PatNames (PaCtor c, ps))
    DoLet (PaRecord c, fs, r), ignore: Unbind cp, (PatNames (PaRecord c, fs, r))
    DoLet p, x: match ?LetName p:
        ? n:
            let pointing = if IsPointerLet cp, p, x: Pointing cp, n else: KnownValue cp, p, n
            if CppMentions (CppExpr cp, x), (VarName cp, n):
                let fresh = "{VarName cp, n}_{Inc (Len (Keys cp.renames))}"
                update pointing:
                    &_.renames <= Insert &_.renames, n, fresh
            else: pointing
        nil: cp
    otherwise: cp

# The names a pattern binds.
PatNames: unbounded fn Pa -> [Text]
fn PatNames p = match p:
    PaBind n: [[n]]
    PaMut n: [[n]]
    PaTyped q, ignore: PatNames q
    PaCtor ignore, ps: Concat2 (Each ps, \|q| PatNames q)
    PaRecord ignore, fs, ignore: Concat2 (Each fs, \|((ignore, q))| PatNames q)
    PaTuple ps: Concat2 (Each ps, \|q| PatNames q)
    PaSlice ps: Concat2 (Each ps, \|q| PatNames q)
    PaRest n: if n == "": [[]] else: [[n]]
    otherwise: [[]]

ArmNames: unbounded fn XArm -> [Text]
fn ArmNames a = Append (PatNames a.pat), (Concat2 (Each a.conds, \|c| CondNames c))

CondNames: unbounded fn Cc -> [Text]
fn CondNames (CcLet q, ignore) = PatNames q
fn CondNames (CcIf ignore) = [[]]

# The context inside a scope that binds `names` anew: an outer rename of one is hidden,
# as is its being a pointer.
Unbind: fn Cp, [Text] -> Cp
fn Unbind cp, names = update cp:
    &_.renames <= Fold names, &_.renames, \|m, n| Remove m, n
    &_.pointers <= Fold names, &_.pointers, \|m, n| Remove m, n

# A local the context knows is a shared pointer: its members are reached by `->`.
Pointing: fn Cp, Text -> Cp
fn Pointing cp, n = update cp:
    &_.pointers <= Insert &_.pointers, n, True

# A local whose type the `let` says and is no pointer: its members are reached by `.`.
KnownValue: fn Cp, Pa, Text -> Cp
fn KnownValue cp, p, n = match p:
    PaTyped ignore, ignore: update cp:
        &_.pointers <= Insert &_.pointers, n, False
    otherwise: cp

# Whether a `let` binds a shared pointer: its type says so, or its value is one.
IsPointerLet: fn Cp, Pa, Ex -> Bool
fn IsPointerLet cp, p, x = match p:
    PaTyped ignore, t: IsPointerTy cp, t
    otherwise: match x:
        XCall "prism_rtl::Host::new", ignore: True
        XCall "Rc::new", [[(XCall "Port::new", ignore)]]: True
        otherwise: match ?Pointer cp, x:
            ? b: b
            nil: False

Inc: fn Nat -> Nat
fn Inc n = n + 1

?LetName: fn Pa -> ?Text
fn ?LetName p = match p:
    PaBind n: ? n
    PaMut n: ? n
    PaTyped q, ignore: ?LetName q
    otherwise: nil

VarName: fn Cp, Text -> Text
fn VarName cp, n = Or cp.renames[n], (CppId n)

# Whether C++ text names an identifier: it stands there with no identifier character
# beside it.
CppMentions: fn Text, Text -> Bool
fn CppMentions t, n:
    let parts = Split t, n
    let k = Len parts
    Fold (Range0 (Dec k)), False, \|f, i| f or ((not (CppEndsIdent (Or parts[i], ""))) and not (CppStartsIdent (Or parts[i + 1], "")))

CppEndsIdent: fn Text -> Bool
fn CppEndsIdent t:
    let c = LastChar t
    (CppIdentChar c) or c == "." or c == ">"

CppStartsIdent: fn Text -> Bool
fn CppStartsIdent t = CppIdentChar (Head t)

CppIdentChar: fn Text -> Bool
fn CppIdentChar c = c != "" and Contains "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", c

CppStatement: unbounded fn Cp, Do -> Text
fn CppStatement cp, d = match d:
    DoLet p, x: CppLet cp, cp, p, x
    DoLetElse p, x, e:
        let v = "_{Or (?FirstBinder p), "m"}"
        "auto&& {v} = {CppExpr cp, x};\nif (!({Conds (PatConds cp, p, v)})) \{ {CppExpr cp, e}; \}\n{Join (PatBinds cp, p, v), "\n"}"
    DoAssign p, x: "{CppExpr cp, p} = {CppExpr cp, x};"
    DoWhile c, body: Block "while ({CppExpr cp, c})", (CppStatements cp, body)
    DoWhileLet p, x, body:
        let v = "_m"
        let head = "auto&& _m = {CppExpr cp, x};\nif (!({Conds (PatConds cp, p, v)})) break;"
        Block "while (true)", (Join (Append (Append [[head]], (PatBinds cp, p, v)), [[(CppStatements cp, body)]]), "\n")
    DoFor p, x, body: CppFor cp, p, x, body
    DoExpr (XBreak l, y): CppBreak cp, l, y
    DoExpr XBreakLoop: "break;"
    DoExpr x: "{CppExpr cp, x};"
    DoIf c, t, e: "{Block "if ({CppExpr cp, c})", (CppStatements cp, t)}{CppElse cp, e}"
    DoIfLet p, x, t, e: CppIfLet cp, p, x, t, e
    DoMatch x, cases: CppDoMatch cp, x, cases
    DoReturn x: "return {CppExpr cp, x};"
    DoBlock body: Braced (CppStatements cp, body)
    DoScope body: "\{ {CppInline cp, body} \}"
    DoLine body: CppInline cp, body
    DoNote t: "// {t}"

CppInline: unbounded fn Cp, [Do] -> Text
fn CppInline cp, dos = Join (Each dos, \|d| CppStatement cp, d), " "

CppElse: unbounded fn Cp, [Do] -> Text
fn CppElse cp, [[]] = ""
fn CppElse cp, [[(DoIf c, t, e)]] = " else {CppStatement cp, (DoIf c, t, e)}"
fn CppElse cp, [[(DoIfLet p, x, t, e)]] = " else {CppStatement cp, (DoIfLet p, x, t, e)}"
fn CppElse cp, body = " else {Block "", (CppStatements cp, body)}"

# `let`: a name binds its value (a reference to a place it borrows); a pattern binds through
# a local of the value.
CppLet: unbounded fn Cp, Cp, Pa, Ex -> Text
fn CppLet cp, named, p, x = match p:
    PaWild: "static_cast<void>({CppExpr cp, x});"
    PaBind n: match x:
        XRef ignore: "const auto& {VarName named, n} = {CppExpr cp, x};"
        otherwise: "auto {VarName named, n} = {CppExpr cp, x};"
    PaMut n: "auto {VarName named, n} = {CppExpr cp, x};"
    PaTyped (PaBind n), t: "{CppType cp, t} {VarName named, n} = {CppExpr cp, x};"
    PaTyped (PaMut n), t: "{CppType cp, t} {VarName named, n} = {CppExpr cp, x};"
    PaTuple ps:
        if Fold ps, True, \|f, q| f and IsName q: "auto [{Join (Each ps, \|q| PatName q), ", "}] = {CppExpr cp, x};"
        else: LetThrough cp, p, x
    otherwise: LetThrough cp, p, x

# A `let` of a pattern: the value in a local named after the pattern's first binder.
LetThrough: unbounded fn Cp, Pa, Ex -> Text
fn LetThrough cp, p, x:
    let t = "_{Or (?FirstBinder p), "t"}"
    "auto&& {t} = {CppExpr cp, x};\n{Join (PatBinds cp, p, t), "\n"}"

# A pattern's first binder, which names the local a `let`-`else` tests.
?FirstBinder: unbounded fn Pa -> ?Text
fn ?FirstBinder p = match p:
    PaBind n: ? n
    PaMut n: ? n
    PaTyped q, ignore: ?FirstBinder q
    PaCtor ignore, ps: Fold ps, nil, \|?f, q| match ?f:
        ? b: ? b
        nil: ?FirstBinder q
    PaTuple ps: Fold ps, nil, \|?f, q| match ?f:
        ? b: ? b
        nil: ?FirstBinder q
    otherwise: nil

IsName: fn Pa -> Bool
fn IsName (PaBind ignore) = True
fn IsName (PaMut ignore) = True
fn IsName other = False

PatName: fn Pa -> Text
fn PatName (PaBind n) = CppId n
fn PatName (PaMut n) = CppId n
fn PatName other = "_"

CppIfLet: unbounded fn Cp, Pa, Ex, [Do], [Do] -> Text
fn CppIfLet cp0, p, x, t, e:
    let cp = Unbind cp0, (PatNames p)
    let v = "_m"
    let head = "if (auto&& _m = {CppExpr cp, x}; {Conds (PatConds cp, p, v)})"
    let body = Join (Append (PatBinds cp, p, v), [[(CppStatements cp, t)]]), "\n"
    "{Block head, body}{CppElse cp, e}"

CppDoMatch: unbounded fn Cp, Ex, [((Pa, [Do]))] -> Text
fn CppDoMatch cp, x, cases:
    let v = "_m"
    let arms = Each cases, \|((p, body))|
        let tests = PatConds cp, p, v
        let inner = Join (Append (PatBinds cp, p, v), [[(CppStatements cp, body)]]), "\n"
        ((tests, inner))
    let blocks = Each (Range0 (Len arms)), \|i|
        let ((tests, inner)) = Or arms[i], (([[]], ""))
        let head = if i == 0: "if ({Conds tests})" else: if (Len tests) == 0: "else" else: "else if ({Conds tests})"
        Block head, inner
    Braced "auto&& _m = {CppExpr cp, x};\n{Join blocks, " "}"

# `for p in xs`: each element bound by the pattern; a map's entries are pairs.
CppFor: unbounded fn Cp, Pa, Ex, [Do] -> Text
fn CppFor cp0, p, x, body = CppForIn (Unbind cp0, (PatNames p)), p, (CppExpr cp0, x), body

CppForIn: unbounded fn Cp, Pa, Text, [Do] -> Text
fn CppForIn cp, p, xs, body = match p:
    PaBind n: Block "for (auto&& {CppId n} : {xs})", (CppStatements cp, body)
    PaMut n: Block "for (auto {CppId n} : {xs})", (CppStatements cp, body)
    PaTuple ps:
        if Fold ps, True, \|f, q| f and IsName q: Block "for (auto&& [{Join (Each ps, \|q| PatName q), ", "}] : {xs})", (CppStatements cp, body)
        else: Block "for (auto&& _e : {xs})", (Join (Append (PatBinds cp, p, "_e"), [[(CppStatements cp, body)]]), "\n")
    otherwise: Block "for (auto&& _e : {xs})", (Join (Append (PatBinds cp, p, "_e"), [[(CppStatements cp, body)]]), "\n")

# A function's body: its statements, then the value returned.
CppBody: unbounded fn Cp, Ex -> Text
fn CppBody cp, (XBlock dos, e):
    let ((st, cp2)) = CppStatementsCp cp, dos
    if (Len dos) == 0: CppBody cp, e else: "{st}\n{CppBody cp2, e}"
fn CppBody cp, (XMatch s, arms, fallback, t) = ReturnMatch cp, s, arms, t
fn CppBody cp, (XChain label, s, arms, t) = ReturnMatch cp, s, arms, t
fn CppBody cp, x = if Leaves x: "{CppExpr cp, x};" else: "return {CppExpr cp, x};"

# ---------------------------------------------------------------------------------------
# Items
# ---------------------------------------------------------------------------------------

CppTemplateHead: fn [Text] -> Text
fn CppTemplateHead [[]] = ""
fn CppTemplateHead ps = "template <{Join (Each ps, \|p| "class {p}"), ", "}>\n"

GenericNamesOf: fn [((Text, [Text]))] -> [Text]
fn GenericNamesOf gs = Each gs, \|((g, ignore))| g

HeadOf: fn Text, [Text] -> Text
fn HeadOf name, [[]] = name
fn HeadOf name, ps = "{name}<{Join ps, ", "}>"

CppParams: unbounded fn Cp, [((Text, OutTy))] -> Text
fn CppParams cp, ps = Join (Each ps, \|((n, t))| "{ParamType cp, t} {CppId n}"), ", "

# A function's signature, with `prefix` before its name (`Type::` for a member).
FnSignature: unbounded fn Cp, FnDef -> Text
fn FnSignature cp, f = "{CppTemplateHead (GenericNamesOf f.generics)}{CppType cp, f.ret} {CppId f.name}({CppParams cp, f.params})"

FnDefinition: unbounded fn Cp, FnDef -> Text
fn FnDefinition cp, f = CppFunction (CppDoc f.doc), (FnSignature cp, f), (CppBody cp, f.body)

# The parts of a module's items: declarations ahead of the definitions, in the order C++
# needs (the headers' sections, `ModuleFiles` below).
type Parts = record:
    forward: [Text]
    handles: [Text]
    values: [ValueDecl]
    cases: [Text]
    protos: [Text]
    classes: [Text]
    # Declarations at the crate's scope, after the module's prototypes: an impl's of
    # another module's trait (`ImplParts`).
    outer: [Text]
    generic: [Text]
    defs: [Text]
derive ^Eq, ^Show

# A value type's declaration, with the types it holds by value: they are declared first.
type ValueDecl = record:
    path: Text
    deps: [Text]
    text: Text
derive ^Eq, ^Show

# The record-like types a type holds by value (a choice is a handle, an array a pointer).
ValueDeps: unbounded fn Cp, OutTy -> [Text]
fn ValueDeps cp, t = match t:
    OutNamed n, args:
        let own = match ?TypeOf cp, n:
            ? info: if info.kind == "record" or info.kind == "newtype" or info.kind == "unit" or info.kind == "tag": [[(Absolute cp, n)]] else: [[]]
            nil: [[]]
        Append own, (Concat2 (Each args, \|a| ValueDeps cp, a))
    OutOpt i: ValueDeps cp, i
    OutRes i: ValueDeps cp, i
    OutRc i: ValueDeps cp, i
    OutCell i: ValueDeps cp, i
    OutTuple ts: Concat2 (Each ts, \|a| ValueDeps cp, a)
    otherwise: [[]]

let noParts = Parts(forward=[[]], handles=[[]], values=[[]], cases=[[]], protos=[[]], classes=[[]], outer=[[]], generic=[[]], defs=[[]])

JoinParts: fn Parts, Parts -> Parts
fn JoinParts a, b = Parts(forward=(Append a.forward, b.forward), handles=(Append a.handles, b.handles), values=(Append a.values, b.values), cases=(Append a.cases, b.cases), protos=(Append a.protos, b.protos), classes=(Append a.classes, b.classes), outer=(Append a.outer, b.outer), generic=(Append a.generic, b.generic), defs=(Append a.defs, b.defs))

ItemParts: unbounded fn Cp, Item -> Parts
fn ItemParts cp, it = match it:
    ItType t: TypeParts cp, t
    ItTag t: TagParts cp, t
    ItRow r: RowParts cp, cp.home, r
    ItFn f: FnParts cp, f
    ItJob j: JobParts cp, j
    ItNode n: NodeParts cp, n
    ItTrait t: TraitParts cp, t
    ItImpl i: ImplParts cp, i
    ItNote t: ProtosDefs [[]], [["// {t}"]]
    ItRefused t: ProtosDefs [[]], [["compile_error!(\"{loweringRefusal}{Escape t}\");"]]

FnParts: unbounded fn Cp, FnDef -> Parts
fn FnParts cp, f:
    if (Len f.generics) > 0: update (GenericOnly [[(FnDefinition cp, f)]]):
        &_.protos <= [["{FnSignature cp, f};"]]
    else: ProtosDefs [["{FnSignature cp, f};"]], [[(FnDefinition cp, f)]]

# A doc comment, `///` per line.
CppDoc: fn Text -> Text
fn CppDoc text = if text == "": "" else: Concat (Each (Split text, "\n"), \|l| if l == "": "///\n" else: "/// {l}\n")

# A doc comment quoting the Prism source, after a lead line.
CppSourceDoc: fn Text, Text -> Text
fn CppSourceDoc lead, source:
    let quoted = Concat (Each (Split source, "\n"), \|l| if l == "": "///\n" else: "/// {l}\n")
    if source == "": CppDoc lead
    else: if lead == "": "/// ```prism\n{quoted}/// ```\n" else: "/// {lead}\n///\n/// ```prism\n{quoted}/// ```\n"

# A type: a record as a struct, a choice as a handle on its cases, a newtype as a struct of
# one field, a unit type as an empty struct; its comparisons, printer and plain data.
TypeParts: unbounded fn Cp, TyDef -> Parts
fn TypeParts cp, t:
    let eq = t.eq
    let ord = t.ord and not t.floaty
    let gens = CppTemplateHead t.params
    let head = HeadOf t.name, t.params
    let doc = CppSourceDoc "`{t.prism}`:", t.doc
    let members = Members (t.show != NotShown), t.pod, head
    let generic = (Len t.params) > 0
    let fwd = "{gens}{if t.shape == ShapeChoice: "class" else: "struct"} {t.name};"
    match t.shape:
        ShapeChoice:
            let names = Each t.cases, \|c| c.name
            # `==` declared in the handle, so a record holding this choice by value, defined
            # before the cases are, finds it when its own defaulted `==` is (clang's rule)
            let friendEq = if eq and not generic: "\nfriend inline bool operator==(const {head}& a, const {head}& b);" else: ""
            let handle = ChoiceHandle doc, gens, t.name, (Join (Each names, \|n| "struct {n};"), "\n"), (Join names, ", "), "{members}{friendEq}"
            let cases = Each t.cases, \|c| CaseStruct cp, gens, head, c, eq, ord
            let cmp = Join (Filter [[(if eq: "{gens}inline bool operator==(const {head}& a, const {head}& b) \{ return a.cases() == b.cases(); \}" else: ""), (if ord: "{gens}inline auto operator<=>(const {head}& a, const {head}& b) \{ return a.cases() <=> b.cases(); \}" else: "")]], \|s| s != ""), "\n"
            let defs = TypeDefs cp, t, head
            Parts(forward=[[fwd]], handles=[[handle]], values=[[]], cases=(Append cases, [[(CasesAccessor gens, head), cmp]]), protos=[[]], classes=[[]], outer=[[]], generic=(if generic: [[defs]] else: [[]]), defs=(if generic: [[]] else: [[defs]]))
        otherwise:
            let first = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]]))
            let fields = match t.shape:
                ShapeRecord: Join (Each first.fields, \|((f, ft))| "{CppType cp, ft} {FieldId f};"), "\n"
                ShapeNewtype: PositionalFields cp, first.fields
                otherwise: ""
            let cmps = Join (Filter [[(if eq: "bool operator==(const {t.name}&) const = default;" else: ""), (if ord: "auto operator<=>(const {t.name}&) const = default;" else: "")]], \|s| s != ""), "\n"
            let decl = ValueStruct doc, gens, t.name, fields, (Join (Filter [[cmps, members]], \|s| s != ""), "\n")
            let defs = TypeDefs cp, t, head
            let deps = Concat2 (Each first.fields, \|((ignore, ft))| ValueDeps cp, ft)
            Parts(forward=[[fwd]], handles=[[]], values=[[ValueDecl(path="{cp.home}::{t.name}", deps=deps, text=decl)]], cases=[[]], protos=[[]], classes=[[]], outer=[[]], generic=(if generic: [[defs]] else: [[]]), defs=(if generic: [[]] else: [[defs]]))

# A choice's cases, once they are complete.
CasesAccessor: fn Text, Text -> Text
fn CasesAccessor gens, head = "{gens}inline const {if gens == "": "" else: "typename "}{head}::Cases& {head}::cases() const \{ return *cases_; \}"

# The members a value type declares for the runtime: its printer and its plain data.
Members: fn Bool, Bool, Text -> Text
fn Members shown, pod, head:
    let s = if shown: [["void show(Printer& p) const;"]] else: [[]]
    let d = if pod: [["Pod to_pod() const;", "static Result<{head}> from_pod(const Pod& whole);"]] else: [[]]
    Join (Append s, d), "\n"

CaseStruct: unbounded fn Cp, Text, Text, CaseDef, Bool, Bool -> Text
fn CaseStruct cp, gens, head, c, eq, ord:
    let fields = PositionalFields cp, c.fields
    let cmps = Join (Filter [[(if eq: "bool operator==(const {c.name}&) const = default;" else: ""), (if ord: "auto operator<=>(const {c.name}&) const = default;" else: "")]], \|s| s != ""), "\n"
    CaseDecl gens, "{head}::{c.name}", (Join (Filter [[fields, cmps]], \|s| s != ""), "\n")

# A type's printer and plain data (docs/backend.md, "Printing").
TypeDefs: unbounded fn Cp, TyDef, Text -> Text
fn TypeDefs cp, t, head:
    let gens = CppTemplateHead t.params
    let show = if t.show == ShownDerived: [[(ShowDef cp, t, head, gens)]] else: [[]]
    let pod = if t.pod: [[(ToPodDef cp, t, head, gens), (FromPodDef cp, t, head, gens)]] else: [[]]
    Join (Append show, pod), "\n"

ShowDef: unbounded fn Cp, TyDef, Text, Text -> Text
fn ShowDef cp, t, head, gens:
    let body = match t.shape:
        ShapeRecord:
            let c = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]]))
            "p.record(\"{t.prism}\", \{{Join (Each c.fields, \|((f, ignore))| "\{\"{PrismField f}\", {FieldId f}\}"), ", "}\});"
        ShapeChoice: Join (Each (Range0 (Len t.cases)), \|i| ShowCase t, i), "\n"
        ShapeNewtype: "p.choice(\"{FirstCase t}\", \{{Join (Each (Range0 (FirstArity t)), \|k| "a{k}"), ", "}\});"
        ShapeUnit: "p.choice(\"{FirstCase t}\", \{\});"
    CppFunction "", "{gens}void {head}::show(Printer& p) const", body

ShowCase: fn TyDef, Nat -> Text
fn ShowCase t, i:
    let c = Or t.cases[i], (CaseDef(name="", prism="", fields=[[]]))
    let head = "{if i == 0: "if" else: "else if"} (auto c = std::get_if<{c.name}>(&cases()))"
    "{head} p.choice(\"{c.prism}\", \{{Join (Each (Range0 (Len c.fields)), \|k| "c->a{k}"), ", "}\});"

# The Prism name of a newtype's or unit type's one case (`click` of `Click`).
FirstCase: fn TyDef -> Text
fn FirstCase t = (Or t.cases[0], (CaseDef(name="", prism=t.prism, fields=[[]]))).prism

FirstArity: fn TyDef -> Nat
fn FirstArity t = Len (Or t.cases[0], (CaseDef(name="", prism="", fields=[[]]))).fields

FieldTypes: fn [((Text, OutTy))] -> [OutTy]
fn FieldTypes fs = Each fs, \|((ignore, t))| t

PositionalFields: unbounded fn Cp, [((Text, OutTy))] -> Text
fn PositionalFields cp, fs:
    let tys = FieldTypes fs
    Join (Each (Range0 (Len tys)), \|i| "{CppType cp, (Or tys[i], OutUnit)} a{i};"), "\n"

ToPodDef: unbounded fn Cp, TyDef, Text, Text -> Text
fn ToPodDef cp, t, head, gens:
    let structure = match t.shape:
        ShapeRecord:
            let c = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]]))
            "Pod::record(\"{t.prism}\", \{{Join (Each c.fields, \|((f, ignore))| "\{\"{PrismField f}\", prism_rtl::to_pod({FieldId f})\}"), ", "}\})"
        ShapeChoice: ChoicePod t
        ShapeNewtype: "Pod::choice(\"{FirstCase t}\", \{{Join (Each (Range0 (FirstArity t)), \|k| "prism_rtl::to_pod(a{k})"), ", "}\})"
        ShapeUnit: "Pod::choice(\"{FirstCase t}\", \{\})"
    let body = if t.show == ShownOwn: "Pod structure = {structure};\nreturn Pod::shown(prism_rtl::show(*this), structure);" else: "return {structure};"
    CppFunction "", "{gens}Pod {head}::to_pod() const", body

ChoicePod: fn TyDef -> Text
fn ChoicePod t:
    let arms = Each (Range0 (Len t.cases)), \|i|
        let c = Or t.cases[i], (CaseDef(name="", prism="", fields=[[]]))
        "std::holds_alternative<{c.name}>(cases()) ? Pod::choice(\"{c.prism}\", \{{Join (Each (Range0 (Len c.fields)), \|k| "prism_rtl::to_pod(std::get<{c.name}>(cases()).a{k})"), ", "}\})"
    "{Join arms, "\n    : "}\n    : Pod()"

FromPodDef: unbounded fn Cp, TyDef, Text, Text -> Text
fn FromPodDef cp, t, head, gens:
    let body = match t.shape:
        ShapeRecord:
            let c = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]]))
            let reads = Join (Each c.fields, \|((f, ft))| ".{FieldId f} = TRY(prism_rtl::from_pod<{CppType cp, ft}>(TRY(prelude::field(whole, \"{PrismField f}\"))))"), ", "
            "return {head}\{{reads}\};"
        otherwise:
            let arms = Each t.cases, \|c|
                let n = Len c.fields
                let tys = FieldTypes c.fields
                let args = Join (Each (Range0 n), \|i| "TRY(prism_rtl::from_pod<{CppType cp, (Or tys[i], OutUnit)}>(c->args[{i}]))"), ", "
                let made = match t.shape:
                    ShapeChoice: "{head}({c.name}\{{args}\})"
                    otherwise: "{head}\{{args}\}"
                "if (c->ctor == \"{c.prism}\" && c->args.size() == {n}) return {made};"
            "const Pod& p = whole.structure();\nif (auto c = p.if_choice()) \{\n{IndentCpp (Join arms, "\n")}\n\}\nreturn mismatch<{head}>(\"a {t.prism}\", p);"
    CppFunction "", "{gens}Result<{head}> {head}::from_pod(const Pod& whole)", body

# A field's Prism spelling: the C++ one without the `_` a keyword took.
PrismField: fn Text -> Text
fn PrismField f = if (LastChar f) == "_": BeforeLast f else: f

IndentCpp: fn Text -> Text
fn IndentCpp t = Join (Each (Split t, "\n"), \|l| if l == "": "" else: "    {l}"), "\n"

# An element tag's `Level`: a struct of its fields, its tag, its plain data.
TagParts: unbounded fn Cp, TagDef -> Parts
fn TagParts cp, t:
    let fields = Join (Each t.fields, \|((ignore, f, ft))| "{CppType cp, ft} {FieldId f};"), "\n"
    let pods = Join (Each t.fields, \|((p, f, ignore))| "\{\"{p}\", prism_rtl::to_pod({FieldId f})\}"), ", "
    let reads = Join (Each t.fields, \|((p, f, ft))| ".{FieldId f} = TRY(prism_rtl::from_pod<{CppType cp, ft}>(TRY(prelude::field(p, \"{p}\"))))"), ", "
    let eq = if t.pod: "bool operator==(const {t.name}&) const = default;" else: ""
    let back = if t.pod: "static Result<{t.name}> from_pod(const Pod& p);" else: ""
    let decl = CppTagStruct (CppSourceDoc "The `Level` of `{t.tagName}`:", t.doc), t.name, fields, t.tagName, (Join (Filter [[eq, back]], \|s| s != ""), "\n")
    let toPod = CppFunction "", "Pod {t.name}::to_pod() const", "return Pod::element(TAG, \{{pods}\});"
    let show = CppFunction "", "void {t.name}::show(Printer& p) const", "prism_rtl::to_pod(*this).structure();\nShow<Pod>::show(prism_rtl::to_pod(*this), p);"
    let fromPod = if t.pod: [[(CppFunction "", "Result<{t.name}> {t.name}::from_pod(const Pod& p)", "if (auto t = p.tag(); t && *t == TAG) return {t.name}\{{reads}\};\nreturn mismatch<{t.name}>(\"a {t.tagName}\", p);")]] else: [[]]
    let deps = Concat2 (Each t.fields, \|((ignore, ignore, ft))| ValueDeps cp, ft)
    Parts(forward=[["struct {t.name};"]], handles=[[]], values=[[ValueDecl(path="{cp.home}::{t.name}", deps=deps, text=decl)]], cases=[[]], protos=[[]], classes=[[]], outer=[[]], generic=[[]], defs=(Append [[toPod, show]], fromPod))

# A row kind's values (pick RV): a choice of the kind's tags, each holding its tag's struct.
RowParts: unbounded fn Cp, Text, RowDef -> Parts
fn RowParts cp, m, r:
    let names = Each r.cases, \|((v, ignore))| v
    let pod = "Pod to_pod() const;\nvoid show(Printer& p) const;{if r.pod: "\nstatic Result<{r.name}> from_pod(const Pod& p);" else: ""}"
    let handle = ChoiceHandle (CppSourceDoc "`{r.prism}`, a row kind's values:", r.doc), "", r.name, (Join (Each names, \|n| "struct {n};"), "\n"), (Join names, ", "), pod
    let cases = Each r.cases, \|((v, st))| CaseDecl "", "{r.name}::{v}", "{RowStruct m, st} a0;{if r.pod: "\nbool operator==(const {v}&) const = default;" else: ""}"
    let eq = if r.pod: [["inline bool operator==(const {r.name}& a, const {r.name}& b) \{ return a.cases() == b.cases(); \}"]] else: [[]]
    let toPod = CppFunction "", "Pod {r.name}::to_pod() const", "return std::visit([](const auto& c) \{ return prism_rtl::to_pod(c.a0); \}, cases());"
    let show = CppFunction "", "void {r.name}::show(Printer& p) const", "Show<Pod>::show(to_pod(), p);"
    let reads = Join (Each r.cases, \|((v, st))| "if (*t == {RowStruct m, st}::TAG) return {r.name}({v}\{TRY(prism_rtl::from_pod<{RowStruct m, st}>(p))\});"), "\n"
    let fromPod = if r.pod: [[(CppFunction "", "Result<{r.name}> {r.name}::from_pod(const Pod& p)", "if (auto t = p.tag()) \{\n{IndentCpp reads}\n\}\nreturn mismatch<{r.name}>(\"a {r.name}\", p);")]] else: [[]]
    Parts(forward=[["class {r.name};"]], handles=[[handle]], values=[[]], cases=(Append (Push cases, (CasesAccessor "", r.name)), eq), protos=[[]], classes=[[]], outer=[[]], generic=[[]], defs=(Append [[toPod, show]], fromPod))

# A row case's struct, by its path from the crate (the case's own name would name the case).
RowStruct: fn Text, Text -> Text
fn RowStruct m, st = if (Contains st, ":") or m == "": TypePath st else: "crate::{m}::{st}"

# `crate::Answer` (pick HO): a choice of a case per element tag with the tag's output; the
# tag an answer is for; an accessor per case; the decode of a World's answer.
AnswerParts: unbounded fn Cp, AnswerDef -> Parts
fn AnswerParts cp, a:
    let names = Each a.cases, \|c| c.variant
    let accessors = Join (Each a.cases, \|c| "Result<{CppType cp, c.ty}> {c.accessor}() const;"), "\n"
    let members = "const char* tag() const;\n{accessors}\nstatic Result<Answer> decode(const Elem& e, const Pod& v);"
    let handle = ChoiceHandle (CppDoc "`Answer c`: an answer to an element, typed by its tag (Semantics ch. 9): what a host's\nsupplier answers a child place with, and what a World's answer to a forwarded element\ndecodes to, carrying the tag's output."), "", "Answer", (Join (Each names, \|n| "struct {n};"), "\n"), (Join names, ", "), members
    let cases = Each a.cases, \|c| CaseDecl "", "Answer::{c.variant}", "{CppType cp, c.ty} a0;"
    let tags = Join (Each a.cases, \|c| "if (std::holds_alternative<{c.variant}>(cases())) return {TypePath c.structPath}::TAG;"), "\n"
    let tagFn = CppFunction "", "const char* Answer::tag() const", "{tags}\nprism_rtl::unreachable();"
    let getters = Each a.cases, \|c| CppFunction (CppDoc "A `{c.tagName}`'s answer."), "Result<{CppType cp, c.ty}> Answer::{c.accessor}() const", "if (auto c = std::get_if<{c.variant}>(&cases())) return c->a0;\nreturn unexpected(Fault::answer(str(\"an answer for \", tag(), \", where {c.tagName}'s was expected\")));"
    let decodes = Join (Each a.cases, \|c| "if (is<Elem::{c.variant}>(e)) return Answer({c.variant}\{TRY(prism_rtl::from_pod<{CppType cp, c.ty}>(v))\});"), "\n"
    let decode = CppFunction (CppDoc "A World's answer to the element `e`, decoded by its tag."), "Result<Answer> Answer::decode(const Elem& e, const Pod& v)", "{decodes}\nprism_rtl::unreachable();"
    Parts(forward=[["class Answer;"]], handles=[[handle]], values=[[]], cases=(Push cases, (CasesAccessor "", "Answer")), protos=[[]], classes=[[]], outer=[[]], generic=[[]], defs=(Append [[tagFn]], (Push getters, decode)))

# A step machine (D6): a job struct, its `cycle`, its `Start`.
JobParts: unbounded fn Cp, JobDef -> Parts
fn JobParts cp, j:
    let gens = CppTemplateHead (GenericNamesOf j.generics)
    let head = HeadOf j.name, (GenericNamesOf j.generics)
    let jcp = WithFields cp, j.fields
    let fields = Join (Each j.fields, \|((n, t))| "{CppType cp, t} {FieldId n};"), "\n"
    let params = Join (Each j.fields, \|((n, t))| "{CppType cp, t} {FieldId n}"), ", "
    let inits = Join (Each j.fields, \|((n, ignore))| "{FieldId n}(std::move({FieldId n}))"), ", "
    let ctor = if (Len j.fields) == 0: "" else: "{j.name}({params}) : {inits} \{\}"
    let ret = CppType cp, j.ret
    let decl = JobStruct (CppDoc j.doc), gens, j.name, ret, fields, ctor
    let cycle = CppFunction "", "{gens}prism_rtl::Turn<{ret}> {head}::cycle() const", (CppBody jcp, j.body)
    let start = CppFunction (CppDoc "`Start {j.name}, x`: what the function value is when passed to `@Run`."), "{gens}prism_rtl::JobRef<{ret}> {j.start}({params})", "return prism_rtl::make_rc<{head}>({Join (Each j.fields, \|((n, ignore))| FieldId n), ", "});"
    let generic = (Len j.generics) > 0
    Parts(forward=[["{gens}struct {j.name};"]], handles=[[]], values=[[]], cases=[[]], protos=[["{gens}prism_rtl::JobRef<{ret}> {j.start}({params});"]], classes=[[decl]], outer=[[]], generic=(if generic: [[cycle, start]] else: [[]]), defs=(if generic: [[]] else: [[cycle, start]]))

# A program's own trait: its methods are functions of a namespace named after it, each impl
# an overload (a default's body a template over `Self`). A method with no default is
# declared a deleted template over `Self`, so that a generic function's call of it names
# something wherever it is defined, and the overloads its file declares before it are the
# ones a call picks (`NAME.generic.hpp`, `ModuleFiles`).
TraitParts: unbounded fn Cp, TraitDef -> Parts
fn TraitParts cp, t:
    let defaults = Filter t.methods, \|f| f.public
    let defs = Each defaults, \|f| FnDefinition cp, (WithGenerics f, [[(("Self", [[]]))]])
    let protos = Each t.methods, \|f| "{FnSignature cp, (WithGenerics f, [[(("Self", [[]]))]])}{if f.public: "" else: " = delete"};"
    let generic = if (Len defaults) == 0: [[]] else: [[(TraitNamespace t.name, (Join defs, "\n"))]]
    update (GenericOnly generic):
        &_.protos <= [[(TraitNamespace t.name, (Join protos, "\n"))]]

# An impl: of a program's trait, overloads in the trait's namespace (of another module's
# trait, in a namespace of the impl's module, `impl_aloud_Loud`, which a using-declaration
# at the crate's scope brings into the trait's: a namespace `aloud` inside the module would
# hide the module `aloud` from its code); of `^Show` a type's printer over a function of
# its own; of `^Eq` its `==`.
ImplParts: unbounded fn Cp, ImplDef -> Parts
fn ImplParts cp, i:
    let head = CppType cp, i.head
    let gens = CppTemplateHead (GenericNamesOf i.generics)
    let fns = Each i.methods, \|f| FnParts cp, (WithGenerics f, i.generics)
    let own = Fold fns, noParts, \|acc, p| JoinParts acc, p
    match i.cls:
        "Prelude.Show":
            let shown = Or (Each i.methods, \|f| f.name)[0], "show"
            JoinParts own, (ProtosDefs [[]], [[(CppFunction "", "{gens}void {head}::show(Printer& p) const", "p.raw({shown}(*this).to_string());")]])
        "Prelude.Eq":
            let eq = Fold i.methods, "", \|acc, f| if (not (HasPrefix f.name, "ne")) and acc == "": f.name else: acc
            JoinParts own, (ProtosDefs [["{gens}bool operator==(const {head}& a, const {head}& b);"]], [[(CppFunction "", "{gens}bool operator==(const {head}& a, const {head}& b)", "return {eq}(a, b);")]])
        otherwise:
            let tr = DropPrefix (TypePath i.tr), "crate::"
            let own = not (Contains tr, "::")
            let ns = if own: tr else: "impl_{Join (Split tr, "::"), "_"}"
            let inTrait = Each i.methods, \|f| TraitNamespace ns, (FnDefinition cp, (WithGenerics f, i.generics))
            let protos = Each i.methods, \|f| TraitNamespace ns, "{FnSignature cp, (WithGenerics f, i.generics)};"
            let outer = if own: [[]] else: [[(TraitNamespace tr, (Join (Each i.methods, \|f| "using ::crate::{cp.home}::{ns}::{CppId f.name};"), "\n"))]]
            update (ProtosDefs protos, inTrait):
                &_.outer <= outer

# A function with type parameters before its own.
WithGenerics: fn FnDef, [((Text, [Text]))] -> FnDef
fn WithGenerics f, gs = update f:
    &_.generics <= Append gs, &_.generics

GenericOnly: fn [Text] -> Parts
fn GenericOnly xs = update noParts:
    &_.generic <= xs

ProtosDefs: fn [Text], [Text] -> Parts
fn ProtosDefs ps, ds = update noParts:
    &_.protos <= ps
    &_.defs <= ds

# ---------------------------------------------------------------------------------------
# Nodes and programs
# ---------------------------------------------------------------------------------------

NodeParts: unbounded fn Cp, NodeDef -> Parts
fn NodeParts cp, n:
    let ncp = WithFields cp, (Each n.fields, \|((f, t, ignore))| ((f, t)))
    let base = if n.rowKind == NotARow and (Len n.hosted) == 0: "Node" else: "Row"
    let fields = Join (Each n.fields, \|((f, t, doc))| "{CppDoc doc}{CppType cp, t} {FieldId f};"), "\n"
    let consts = Join (Each n.consts, \|((c, h, doc))| "{CppDoc "The {doc}."}static constexpr std::uint32_t {c} = {h};"), "\n"
    let ctorParams = Join (Append [["Path path"]], (Each n.fields, \|((f, t, ignore))| "{CppType cp, t} {FieldId f}")), ", "
    let ctorInits = Join (Append [["path(std::move(path))"]], (Each n.fields, \|((f, ignore, ignore))| "{FieldId f}(std::move({FieldId f}))")), ", "
    let params = Concat (Each n.params, \|((p, t))| "{ParamType cp, t} {p}, ")
    let ret = if n.fallible: "Result<prism_rtl::Rc<{n.name}>>" else: "prism_rtl::Rc<{n.name}>"
    let makeDecl = "static {ret} make(Path path, {params}Cx& cx);"
    let methodDecls = Each (Append n.methods, n.hosted), \|m| "{MethodSig ncp, m, ""};"
    let builderDecls = Append (Each n.builders, \|b| "Done {b.name}_build(Cx& cx);"), (Each n.gens, \|g| "Done {g.name}_build(Cx& cx);")
    let hookDecls = Each n.hooks, \|((h, ignore))| "{HookSig h, ""} override;"
    let answerDecl = if (Len n.answers) == 0: [[]] else: [["Done answer(std::span<const Segment> at, const Pod& v, Cx& cx) override;"]]
    let rowDecl = if n.rowKind == NotARow: [[]] else: [["void leave_row(Cx& cx) override;"]]
    let decls = Join (Append (Append (Append (Append (Append [[makeDecl]], methodDecls), builderDecls), hookDecls), answerDecl), rowDecl), "\n"
    let doc = CppSourceDoc "`{n.prism}`: a node of its own (docs/backend.md, \"A widget block\").", n.doc
    let decl = NodeClass doc, n.name, base, fields, consts, "{n.name}({ctorParams}) : {ctorInits} \{\}", decls
    # the constructor's arguments in the order the fields are declared
    let byField = Each n.fields, \|((f, ignore, ignore))| Or (Fold n.inits, nil, \|?found, ((g, v))| if g == f: ? v else: ?found), (XVar f)
    let ((letsText, lcp)) = CppStatementsCp ncp, n.lets
    let args = Join (Append [["path"]], (Each byField, \|v| CppExpr lcp, v)), ", "
    let tail = if n.fallible: "return node;" else: "return node;"
    let make = NodeMake n.name, "{ret} {n.name}::make(Path path, {params}Cx& cx)", letsText, args, (Join (Filter [[(CppStatements (Pointing lcp, "node"), n.build), tail]], \|s| s != ""), "\n")
    let methods = Each (Append n.methods, n.hosted), \|m| MethodDef ncp, n.name, m
    let builders = Append (Each n.builders, \|b| ForBuildCpp ncp, n.name, b), (Each n.gens, \|g| GenBuildCpp ncp, n.name, g)
    let hooks = Each n.hooks, \|((h, body))| CppFunction "", (HookSig h, "{n.name}::"), "{CppStatements ncp, body}\nreturn \{\};"
    let answer = if (Len n.answers) == 0: [[]] else: [[(AnswerDefCpp ncp, n)]]
    let leaving = if n.rowKind == NotARow: [[]] else: [[(RowLeaving ncp, n)]]
    let defs = Append (Append (Append (Append (Append [[make]], methods), builders), hooks), answer), leaving
    let own = Parts(forward=[["class {n.name};"]], handles=[[]], values=[[]], cases=[[]], protos=[[]], classes=[[decl]], outer=[[]], generic=[[]], defs=defs)
    own

MethodSig: unbounded fn Cp, MethDef, Text -> Text
fn MethodSig cp, m, owner:
    let cx = match m.cx:
        CxMut: [["Cx& cx"]]
        CxRef: [["const Cx& cx"]]
        CxNone: [[]]
    let params = Join (Append (Each m.params, \|((p, t))| "{ParamType cp, t} {p}"), cx), ", "
    let constness = if m.recv == RecvRef: " const" else: ""
    "{CppType cp, m.ret} {owner}{NodeMethodName cp, m.name}({params}){constness}"

MethodDef: unbounded fn Cp, Text, MethDef -> Text
fn MethodDef cp, owner, m:
    let ((st, cp2)) = CppStatementsCp cp, m.body
    let body = if m.ret == OutUnit: "{st}\nreturn Unit\{\};" else: if (Len m.body) == 0: CppBody cp, m.tail else: "{st}\n{CppBody cp2, m.tail}"
    CppFunction (CppDoc m.doc), (MethodSig cp, m, "{owner}::"), body

HookSig: fn Text, Text -> Text
fn HookSig "push", owner = "Done {owner}push(const Pod& element, const Pod& v, Cx& cx)"
fn HookSig h, owner = "Done {owner}{h}(Cx& cx)"

AnswerDefCpp: unbounded fn Cp, NodeDef -> Text
fn AnswerDefCpp cp, n:
    let arms = Each n.answers, \|((pat, call))|
        let tests = PatConds cp, pat, "at"
        let binds = PatBinds cp, pat, "at"
        ((tests, (Join (Push binds, "{CppExpr cp, call};"), "\n")))
    let blocks = Each (Range0 (Len arms)), \|i|
        let ((tests, inner)) = Or arms[i], (([[]], ""))
        Block "{if i == 0: "if" else: "else if"} ({Conds tests})", inner
    CppFunction "", "Done {n.name}::answer(std::span<const Segment> at, const Pod& v, Cx& cx)", "{Join blocks, " "} else \{\n    return unexpected(Fault::answer(str(\"no answering place at \", path_of(at))));\n\}\nreturn \{\};"

# A row's leaving (prelude `Row`): a `for` row keeps its entry as the tick opened, its places
# are torn down, its subscriptions let go.
RowLeaving: unbounded fn Cp, NodeDef -> Text
fn RowLeaving cp, n:
    let kept = if n.rowKind == ForRow: [["this->left_entry = entry(cx);"]] else: [[]]
    let unsubscribe = Each n.subs, \|((ev, m, ignore))| "if (auto p = parent.lock(); p && {m}_sub) deref(p->{ev}_port).unsubscribe(*std::exchange({m}_sub, std::nullopt));"
    CppFunction "", "void {n.name}::leave_row(Cx& cx)", (Join (Append (Push kept, "remove_places(cx);"), unsubscribe), "\n")

ForBuildCpp: unbounded fn Cp, Text, ForDef -> Text
fn ForBuildCpp cp, owner, b = ForBuildTemplate owner, b.name, (CppExpr cp, b.at), (CppType cp, b.keyTy), (CppType cp, b.valueTy), (CallPath "{b.rowNode}::build"), b.source, (CppExpr cp, b.parent), (Concat (Each b.passed, \|x| ", {CppExpr cp, x}"))

GenBuildCpp: unbounded fn Cp, Text, GenDef -> Text
fn GenBuildCpp cp, owner, gd:
    let path = if gd.transparent: "this->path" else: "{CppExpr cp, gd.at}.child(Segment::gen(g))"
    GenBuildTemplate owner, gd.name, (CppExpr cp, gd.at), path, (CppExpr cp, gd.source), (CppType cp, gd.valueTy), (CppExpr cp, gd.select)

ProgramCpp: unbounded fn Cp, ProgDef, Bool -> Text
fn ProgramCpp cp, p, fallible:
    let n = Len p.params
    let names = Each p.params, \|((a, ignore))| a
    let plural = if n == 1: "" else: "s"
    let decode = if n == 0: "static_cast<void>(args);" else: Join (Append [["if (args.size() != {n}) return unexpected(Fault::answer(\"@{p.prism} takes {n} argument{plural}\"));"]], (Each (Range0 n), \|i| DecodeArg cp, p.params, i)), "\n"
    let call = "{CallPath "{p.node}::build"}(Path::root(), {Concat (Each names, \|a| "{a}, ")}cx)"
    let root = if fallible: "TRY({call})" else: call
    ProgramClass p.name, p.prism, (TypePath p.node), decode, root

DecodeArg: unbounded fn Cp, [((Text, OutTy))], Nat -> Text
fn DecodeArg cp, ps, i = match ps[i]:
    ? ((a, t)): "auto {a} = TRY(prism_rtl::from_pod<{CppType cp, t}>(args[{i}]));"
    nil: ""

# ---------------------------------------------------------------------------------------
# The program
# ---------------------------------------------------------------------------------------

# A module's parts, in the module's namespace.
ModuleParts: unbounded fn Cp, ModDef -> Parts
fn ModuleParts cp, m:
    let mcp = InHome cp, m.name
    let all = Fold m.items, noParts, \|acc, it| JoinParts acc, (ItemParts mcp, it)
    Parts(forward=(InNs m.name, all.forward), handles=(InNs m.name, all.handles), values=(Each all.values, \|v| InNsValue m.name, v), cases=(InNs m.name, all.cases), protos=(InNs m.name, all.protos), classes=(InNs m.name, all.classes), outer=all.outer, generic=(InNs m.name, all.generic), defs=all.defs)

InNsValue: fn Text, ValueDecl -> ValueDecl
fn InNsValue ns, v = update v:
    &_.text <= "namespace {ns} \{\n\n{&_.text}\n\n\}  // namespace {ns}"

InNs: fn Text, [Text] -> [Text]
fn InNs ns, [[]] = [[]]
fn InNs ns, xs = [["namespace {ns} \{\n\n{Join xs, "\n\n"}\n\n\}  // namespace {ns}"]]

# Whether a node is built fallibly: the program's `TRY`.
NodeFallibleCpp: fn Model, Text -> Bool
fn NodeFallibleCpp model, path = Fold model.mods, False, \|f, m| Fold m.items, f, \|f2, it| match it:
    ItNode n: f2 or ("{m.name}::{n.name}" == path and n.fallible)
    otherwise: f2

# The program's files: path and text.
EmitCpp: unbounded fn Model, Text, [Text] -> [((Text, Text))]
fn EmitCpp model, runtime, scripts:
    let cp = Context model
    let crate = InHome cp, ""
    let elem = RowParts crate, "", model.elem
    let answer = AnswerParts crate, model.answer
    let mods = Each model.mods, \|m| ModuleParts cp, m
    let programs = Join (Each (AllProgramsCpp model), \|p| ProgramCpp crate, p, (NodeFallibleCpp model, p.node)), "\n\n"
    let regs = Concat (Each model.programs, \|p| "\n.program<{p.name}>(\"{p.prism}\")")
    let checks = Concat (Each model.checks, \|c| "\n.check(\"{c.name}\", [] \{ return std::vector<Result<Pod>>\{{Join (Each c.lines, \|l| CppExpr crate, l), ", "}\}; \})")
    let scriptList = Join (Each scripts, \|s| "\"{Escape s}\","), "\n"
    let world = match model.?root:
        ? r: r.world
        nil: "test"
    let canvas = world == "canvas"
    let runRoot = match model.?root:
        ? r: CppRunRoot r.name, (if canvas: CppCanvasRun r.name else: CppNoCanvas r.name)
        nil: CppNoRoot model.name
    let both = JoinParts elem, answer
    let elemDecl = CppElemDecl (Includes "decl", (Append model.elemComplete, model.elemDeclared)), (Join both.forward, "\n\n"), (Join both.handles, "\n\n"), (CppPreludeRows "")
    let elemTypes = CppElemTypes (Join (Filter [[(Includes "types", model.elemComplete), (Includes "decl", model.elemDeclared)]], \|t| t != ""), "\n"), (Join both.cases, "\n\n")
    let pairs = Each (Range0 (Len model.mods)), \|i| (((Or model.mods[i], noMod), (Or mods[i], noParts)))
    let generics = Fold pairs, [[]], \|acc, ((m, p))| if (Len p.generic) > 0: Push acc, m.name else: acc
    let perModule = Each pairs, \|((m, p))| ModuleFiles m, p, generics
    let mainIncludes = Join (Append (Append [["#include \"elem.types.hpp\""]], [[(Includes "", (Each model.mods, \|m| m.name))]]), [[(Includes "generic", generics)]]), "\n"
    let canvasInclude = if canvas: CppCanvasInclude "" else: ""
    let main = CppMain model.name, "#include \"programs.hpp\"\n{canvasInclude}", regs, checks, scriptList, world, runRoot, (Join (Concat2 (Each [[elem, answer]], \|p| p.defs)), "\n\n")
    let groups = Each (Filter model.mods, \|m| (Len m.typesWith) > 1 and (Or m.typesWith[0], "") == m.name), \|m| GroupTypesFile pairs, m.typesWith
    let files = Fold perModule, [[]], \|acc, fs| Append acc, fs
    let sources = Join (Filter (Each files, \|((f, ignore))| f), \|f| Contains f, ".cpp"), " "
    Append [[(("Makefile", (CppMakefile model.name, runtime, sources, (if canvas: CppMakefileCanvas runtime else: "")))), (("src/elem.decl.hpp", elemDecl)), (("src/elem.types.hpp", elemTypes)), (("src/programs.hpp", (CppProgramsHeader model.name, mainIncludes, programs))), (("src/main.cpp", main)), (("src/prelude.hpp", (CppPreludeSource "")))]], (Append groups, files)

let noMod = ModDef(name="", prism="", path="", uses=[[]], complete=[[]], declared=[[]], typesWith=[[]], items=[[]])

# The types header of a group of modules (`ModDef.typesWith`): their value types in order
# across them, and their choices' cases, which each member's own `NAME.types.hpp` includes.
GroupTypesFile: unbounded fn [((ModDef, Parts))], [Text] -> ((Text, Text))
fn GroupTypesFile pairs, group:
    let members = Filter pairs, \|((m, ignore))| Among group, m.name
    let p = Fold members, noParts, \|acc, ((ignore, q))| JoinParts acc, q
    let complete = Fold members, [[]], \|acc, ((m, ignore))| Fold m.complete, acc, \|a, n| if (Among a, n) or (Among group, n): a else: Push a, n
    let declared = Fold members, [[]], \|acc, ((m, ignore))| Fold m.declared, acc, \|a, n| if (Among a, n) or (Among group, n) or (Among complete, n): a else: Push a, n
    let title = "The modules {Join (Each group, \|n| "`{n}`"), ", "}"
    (("src/{GroupName group}.types.hpp", (TypesHeader title, group, declared, complete, p)))

# A group's file name: its modules' paths, `_` for `::`, `-` between them.
GroupName: fn [Text] -> Text
fn GroupName group = Join (Each group, \|n| Join (Split n, "::"), "_"), "-"

# A module's directory under `src/`: its path's segments (`check::env` is `check/env`).
ModDir: fn Text -> Text
fn ModDir m = Join (Split m, "::"), "/"

Among: fn [Text], Text -> Bool
fn Among xs, x = Fold xs, False, \|f, y| f or y == x

# A types header: the value types of these modules (one, or a group) in an order C++
# accepts, each after the types it holds, and their choices' cases, after the headers they
# need: their own declarations, the declarations of the modules they name and the types of
# the modules whose types they hold.
TypesHeader: unbounded fn Text, [Text], [Text], [Text], Parts -> Text
fn TypesHeader title, members, declared, complete, p:
    let includes = Join (Filter [[(Includes "decl", members), "#include \"elem.decl.hpp\"", (Includes "decl", declared), (Includes "types", complete)]], \|t| t != ""), "\n"
    let values = Join (OrderValues p.values, (Fold p.values, {}, \|acc, v| Insert acc, v.path, False), [[]]), "\n\n"
    CppTypesHeader title, includes, values, (Join p.cases, "\n\n")

# `#include` lines for these modules' headers of one layer (`decl`, `types`, `generic`, or
# `` for the whole header, `module.hpp`), each from `src/` in angle brackets: a quoted name
# is looked up beside the including file first, where a submodule of the same name
# (`a/types/` beside the top-level `types/`) would answer.
Includes: fn Text, [Text] -> Text
fn Includes layer, ms = Join (Each ms, \|m| "#include <{ModDir m}/{if layer == "": "module" else: layer}.hpp>"), "\n"

# A module's definitions in files of about `chunkSize` characters each, so that no file
# needs more memory to compile than a small machine has (`lower.cpp` alone would): the
# first is `src/DIR/mod.cpp`, the next `src/DIR/mod_2.cpp`, and so on.
Chunks: fn [Text] -> [ [Text] ]
fn Chunks defs:
    let ((done, current, size)) = Fold defs, (([[]], [[]], 0)), \|((acc, cur, n)), d|
        if n > chunkSize and (Len cur) > 0: (((Push acc, cur), [[d]], (Len d)))
        else: ((acc, (Push cur, d), n + (Len d)))
    if (Len current) == 0 and (Len done) > 0: done else: Push done, current

let chunkSize = 250000

# A module's files: its headers (`CppDeclHeader` says what each layer holds) and its source
# files. A source file includes its own module's `DIR/module.hpp` and those of the modules
# it needs, then the `DIR/generic.hpp` of those that have one (`generics`).
ModuleFiles: unbounded fn ModDef, Parts, [Text] -> [((Text, Text))]
fn ModuleFiles m, p, generics:
    let title = if m.prism == "": "The root module" else: "The module `{m.prism}`"
    let needed = Append m.complete, m.declared
    let decl = CppDeclHeader title, "", (Join p.forward, "\n\n"), (Join p.handles, "\n\n")
    let types = if (Len m.typesWith) > 1: CppTypesInGroup title, (GroupName m.typesWith) else: TypesHeader title, [[m.name]], m.declared, m.complete, p
    let headIncludes = Join (Filter [[("{Includes "types", [[m.name]]}\n#include \"elem.types.hpp\""), (Includes "types", needed)]], \|t| t != ""), "\n"
    let head = CppModHeader title, headIncludes, (Join p.protos, "\n"), (Join p.outer, "\n\n"), (Join p.classes, "\n\n")
    let withMine = Append [[m.name]], needed
    let generic = if (Len p.generic) == 0: [[]] else: [[(("src/{ModDir m.name}/generic.hpp", (CppGenericHeader title, (Includes "", withMine), (Join p.generic, "\n\n"))))]]
    let bodyIncludes = Join (Filter [[(Includes "", withMine), (Includes "generic", (Filter withMine, \|n| Among generics, n))]], \|t| t != ""), "\n"
    let chunks = Chunks p.defs
    let sources = Each (Range0 (Len chunks)), \|k| (((ChunkFile m.name, k), (CppModule title, m.path, m.name, bodyIncludes, (Join (Or chunks[k], [[]]), "\n\n"))))
    let dir = ModDir m.name
    Append (Append [[(("src/{dir}/decl.hpp", decl)), (("src/{dir}/types.hpp", types)), (("src/{dir}/module.hpp", head))]], generic), sources

ChunkFile: fn Text, Nat -> Text
fn ChunkFile m, k = if k == 0: "src/{ModDir m}/mod.cpp" else: "src/{ModDir m}/mod_{k + 1}.cpp"

# Every program, the root's among them, once.
AllProgramsCpp: fn Model -> [ProgDef]
fn AllProgramsCpp model = match model.?root:
    ? r: if Fold model.programs, False, \|f, p| f or p.name == r.name: model.programs else: Push model.programs, r
    nil: model.programs

# The value types in an order C++ accepts: each after the types it holds by value, rounds
# of the ones whose types are all declared. A cycle of records by value (which `Rc` breaks
# in Rust, and a choice's handle here only when a choice is on it) is left as it is, and
# does not compile (gap CY of the README).
OrderValues: unbounded fn [ValueDecl], (Text ==> Bool), [Text] -> [Text]
fn OrderValues left, done, acc:
    let ready = Filter left, \|v| Fold v.deps, True, \|ok, d| ok and (d == v.path or Declared done, d)
    if (Len left) == 0: acc
    else: if (Len ready) == 0: Append acc, (Each left, \|v| v.text)
    else:
        let later = Filter left, \|v| not (Fold v.deps, True, \|ok, d| ok and (d == v.path or Declared done, d))
        let done2 = Fold ready, done, \|m, v| Insert m, v.path, True
        OrderValues later, done2, (Append acc, (Each ready, \|v| v.text))

# Whether a value type is declared: one not among the program's value types counts.
Declared: fn (Text ==> Bool), Text -> Bool
fn Declared done, d = match done[d]:
    ? b: b
    nil: True
