# The lexer: characters to tokens, with layout (Semantics ch. 2; Templates ch. 2, Lexing;
# Conformance Appendix A.1 and A.2). `prism_syntax/src/lexer.rs` is the oracle, rule for
# rule; the two must give the same tokens, and `prismc/front.prism --tokens` prints them in
# the layout corpus's notation so the two can be diffed.
#
# Written by Claude, 31 October 2026, on the claude-self-hosting branch. Subject to change:
# Jimmy rewrites it by hand, and an implementer reading it uses their own discretion.
#
# Q-L1 (b): the lexer is an `&` block with a loop over the text (`LexStream`). Its whole
# state is what Semantics ch. 2's constraint X3 allows: the stack of block columns
# (`layout`), the stack of open brackets (`frames`), and whether the last character was
# whitespace (`lastWs`), plus the bits the books add where they need them (the lambda's
# open bar, the `:` that ended the previous line, the test frame). A placeholder, a template
# and a test path's key open a stream of their own: `Nested` runs `LexStream` again over the
# same text and hands its tokens back as one token's contents, so the recursion is the third
# stack, the template frames.
module Lexer
emit r
use Ast.*

# ---------------------------------------------------------------------------------------
# Tokens (prism_syntax/src/token.rs)
# ---------------------------------------------------------------------------------------

# The case mark of a name's last segment (Semantics ch. 2, "Case is a mark").
type NameCase = choice:
    CaseLower
    CaseUpper
    CaseTopic
    CaseHole
    CaseReserved
derive ^Eq, ^Show

# A name token: attached sigils, then one or more `.`-joined segments.
type NameTok = record:
    sigils: Text
    path: [Text]
    case: NameCase
derive ^Eq, ^Show

# A bracket kind is its opening character, `"("`, `"["` or `"{"`. A keyword, an operator
# and a sigil are their spelling; `sigils` is a run of sigils as written.
type TokKind = choice:
    KName NameTok
    KFamily [Text]
    KTrait [Text]
    KKw Text, Text
    KFree Text
    KLensDot
    KInt Text, Text
    KFloat Text, Text
    KDuration Text, Text, Text
    KChar Text, Text
    KText Text, [TextSegTok]
    KTemplate TemplateTok
    KOp Text, Bool
    KSuffixed Text, [Text]
    KDot Bool
    KDotDot
    KComma
    KColon
    KSemi
    KBackslash
    KLambdaBar Bool
    KBar
    KLtLt
    KGtGt
    KOpen Text, Bool
    KClose Text
    KAbsent
    KNonEmpty
    KPath [PathSegTok]
    KLayOpen
    KLaySep
    KLayClose
    KEof
derive ^Eq, ^Show

type Tok = record:
    kind: TokKind
    span: Range
    touches: Bool
    lineStart: Bool
derive ^Eq, ^Show

type TextSegTok = choice:
    TsPlain Text
    TsPlaceholder [Tok], Range
derive ^Eq, ^Show

# `keyword` is `"Output"`, `"InlineText"`, `"Raw"` or `"File"`; `delims` `"single"` or
# `"double"` (Q-CT1 (a)).
type TemplateTok = record:
    keyword: Text
    lang: Text
    delims: Text
    parts: [TPartTok]
derive ^Eq, ^Show

type TPartTok = choice:
    TptText Text
    TptPlaceholder [Tok], ?Nat, Range
    TptBlock [Tok], Range
    TptCall NameTok, [AttrTok], ?[TPartTok], Range
derive ^Eq, ^Show

type AttrTok = record:
    name: Text
    tokens: [Tok]
    span: Range
derive ^Eq, ^Show

type PathSegTok = choice:
    PstNum Nat
    PstGen Nat
    PstKey [Tok]
derive ^Eq, ^Show

# ---------------------------------------------------------------------------------------
# The lexer's state
# ---------------------------------------------------------------------------------------

# How a stream ends, and whether layout is on inside it: the file, a template's brace block
# (layout on), a placeholder in a text or a template (layout suspended), a path's key.
type Mode = choice:
    MFile
    MBrace Text
    MPlaceholder Text
    MPathKey
derive ^Eq, ^Show

# The text, the cursor and the diagnostics, which every stream shares, and one stream's own
# state, which `Fresh` starts over for a nested stream.
type Lex = record:
    cs: [Text]
    pos: Nat
    diags: [Diag]
    mode: Mode
    tokens: [Tok]
    layout: [Nat]
    frames: [Text]
    lastWs: Bool
    lambdaOpen: Bool
    pendingOpen: Bool
    pendingSpan: Range
    lineFirst: Nat
    markLineStart: Bool
    firstLine: Bool
    testPending: Text
    testDepth: ?Nat
    checkDepth: ?Nat
    pathNext: Bool
derive ^Eq, ^Show

Fresh: fn Lex, Mode -> Lex
fn Fresh l, mode = Lex(cs=l.cs, pos=l.pos, diags=l.diags, mode=mode, tokens=[[]], layout=[[]],
    frames=[[]], lastWs=True, lambdaOpen=False, pendingOpen=False, pendingSpan=Range(start=0, end=0),
    lineFirst=0, markLineStart=False, firstLine=True, testPending="", testDepth=nil,
    checkDepth=nil, pathNext=False)

# What a file lexes to.
type Lexed = record:
    tokens: [Tok]
    diags: [Diag]
derive ^Eq, ^Show

# ---------------------------------------------------------------------------------------
# Small helpers over texts and arrays
# ---------------------------------------------------------------------------------------

Dec: fn Nat -> Nat
fn Dec n = Or (n -? 1), 0

?Last: fn [a] -> ?a
fn ?Last xs = xs[Dec (Len xs)]

Pop: fn [a] -> [a]
fn Pop xs = Take xs, (Dec (Len xs))

Join: fn [Text], Text -> Text
fn Join xs, sep = Drop (Concat (Each xs, \|x| "{sep}{x}")), (Len sep)

Chars: fn Text -> [Text]
fn Chars t = Split t, ""

# Every character of `t` satisfies `P`.
AllChars: fn Text, (fn Text -> Bool) -> Bool
fn AllChars t, P = Fold (Chars t), True, \|ok, c| ok and P c

# `t` without the spaces and carriage returns at its start, its end, or both.
TrimStart: fn Text -> Text
fn TrimStart t = Drop t, (LeadingIn t, " \u{d}")

TrimEnd: fn Text -> Text
fn TrimEnd t = Take t, (Or ((Len t) -? (LeadingIn (Reverse t), " \u{d}")), 0)

Trim: fn Text -> Text
fn Trim t = TrimEnd (TrimStart t)

Reverse: fn Text -> Text
fn Reverse t = Fold (Chars t), "", \|acc, c| "{c}{acc}"

# How many characters at the start of `t` are among `set`.
LeadingIn: fn Text, Text -> Nat
fn LeadingIn t, set = update 0:
    let cs = Chars t
    let &fuel = Len cs
    while ? left <- &fuel -? 1:
        &fuel <= left
        match cs[&_]:
            ? c if Contains set, c: &_ += 1
            otherwise: &fuel <= 0

Contains: fn Text, Text -> Bool
fn Contains set, c = c != "" and (Len (Split set, c)) > 1

# ---------------------------------------------------------------------------------------
# Characters (ASCII only: "Names are ASCII letters, digits and underscores")
# ---------------------------------------------------------------------------------------

IsDigit: fn Text -> Bool
fn IsDigit c = "0" <= c and c <= "9"

IsUpper: fn Text -> Bool
fn IsUpper c = "A" <= c and c <= "Z"

IsLower: fn Text -> Bool
fn IsLower c = "a" <= c and c <= "z"

IsIdentStart: fn Text -> Bool
fn IsIdentStart c = (IsLower c) or (IsUpper c) or c == "_"

IsIdentChar: fn Text -> Bool
fn IsIdentChar c = (IsIdentStart c) or (IsDigit c)

IsHexDigit: fn Text -> Bool
fn IsHexDigit c = (IsDigit c) or ("a" <= c and c <= "f") or ("A" <= c and c <= "F")

# Past ASCII. A non-ASCII letter glued to a name is an error; prismc counts every non-ASCII
# character a letter there (README, pick NA).
IsNonAscii: fn Text -> Bool
fn IsNonAscii c = c > "\u{7f}"

IsSigilChar: fn Text -> Bool
fn IsSigilChar c = Contains "$!@?~&", c

IsSpaceChar: fn Text -> Bool
fn IsSpaceChar c = c == " " or c == "\n" or c == "\u{d}" or c == "\t"

# The two lowercase constructors the prelude reserves (ch. 2, "Case is a mark").
IsReservedCtor: fn Text -> Bool
fn IsReservedCtor w = w == "templatetext" or w == "templateplaceholder"

# The ASCII characters by code point: what `\u{hex}` can name in prismc (README, gap UC),
# and how the S-expression printer names a control character.
let asciiTable = Chars "\u{0}\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\u{9}\u{a}\u{b}\u{c}\u{d}\u{e}\u{f}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1a}\u{1b}\u{1c}\u{1d}\u{1e}\u{1f} !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz\{|\}~\u{7f}"

let hexDigits = Chars "0123456789abcdef"

# The value of a hexadecimal digit.
HexValue: fn Text -> Nat
fn HexValue c = update 0:
    let l = Lower c
    let &fuel = Len hexDigits
    while ? left <- &fuel -? 1:
        &fuel <= left
        match hexDigits[&_]:
            ? d if d != l: &_ += 1
            otherwise: &fuel <= 0

?ParseHex: fn Text -> ?Nat
fn ?ParseHex t:
    require t != "" and (AllChars t, IsHexDigit)
    ? Fold (Chars t), 0, \|n, c| n * 16 + (HexValue c)

# The character at a code point below 0x80.
?AsciiChar: fn Nat -> ?Text
fn ?AsciiChar n = asciiTable[n]

# ---------------------------------------------------------------------------------------
# Reading characters
# ---------------------------------------------------------------------------------------

# The character at the cursor, or `""` at the end.
Peek: fn Lex -> Text
fn Peek l = Or l.cs[l.pos], ""

PeekAt: fn Lex, Nat -> Text
fn PeekAt l, n = Or l.cs[l.pos + n], ""

StartsWith: fn Lex, Text -> Bool
fn StartsWith l, s = (Slice l, l.pos, l.pos + (Len s)) == s

# The text from `a` to `b`.
Slice: fn Lex, Nat, Nat -> Text
fn Slice l, a, b = Concat (Take (Drop l.cs, a), (Or (b -? a), 0))

Bump: fn Lex -> Lex
fn Bump l = update l:
    if &_.pos < (Len &_.cs):
        &_.pos += 1

Forward: fn Lex, Nat -> Lex
fn Forward l, n = update l:
    &_.pos <= Min (&_.pos + n), (Len &_.cs)

NextIsSpace: fn Lex, Nat -> Bool
fn NextIsSpace l, n:
    let c = PeekAt l, n
    c == "" or (IsSpaceChar c)

# Where the current line ends: the next newline, or the end of the text.
LineEnd: unbounded fn Lex -> Nat
fn LineEnd l = update l.pos:
    while (Or l.cs[&_], "\n") != "\n":
        &_ += 1

# The rest of the current line from the cursor, without its newline.
RestOfLine: unbounded fn Lex -> Text
fn RestOfLine l = Slice l, l.pos, (LineEnd l)

LexErr: fn Lex, Nat, Nat, Text -> Lex
fn LexErr l, start, end, message = update l:
    &_.diags <= Push &_.diags, (LexDiag (Range(start=start, end=(Max end, start))), message)

LexDiag: fn Range, Text -> Diag
fn LexDiag span, message = Diag(stage="lex", span=span, message=message, feature=nil)

# ---------------------------------------------------------------------------------------
# Token kinds
# ---------------------------------------------------------------------------------------

# A layout token or the end: such a token never touches the one before it.
IsLayoutOrEof: fn TokKind -> Bool
fn IsLayoutOrEof KLayOpen = True
fn IsLayoutOrEof KLaySep = True
fn IsLayoutOrEof KLayClose = True
fn IsLayoutOrEof KEof = True
fn IsLayoutOrEof ignore = False

IsLayout: fn TokKind -> Bool
fn IsLayout KLayOpen = True
fn IsLayout KLaySep = True
fn IsLayout KLayClose = True
fn IsLayout ignore = False

# Whether a token ends an operand, so that a touching `+`, `-`, `.` or `[` after it is
# binary (the spacing rule).
EndsOperand: fn TokKind -> Bool
fn EndsOperand (KName ignore) = True
fn EndsOperand (KFamily ignore) = True
fn EndsOperand (KInt ignore, ignore) = True
fn EndsOperand (KFloat ignore, ignore) = True
fn EndsOperand (KDuration ignore, ignore, ignore) = True
fn EndsOperand (KChar ignore, ignore) = True
fn EndsOperand (KText ignore, ignore) = True
fn EndsOperand (KTemplate ignore) = True
fn EndsOperand (KClose ignore) = True
fn EndsOperand KGtGt = True
fn EndsOperand KNonEmpty = True
fn EndsOperand KAbsent = True
fn EndsOperand (KKw w, ignore) = IsValueWord w
fn EndsOperand ignore = False

IsValueWord: fn Text -> Bool
fn IsValueWord w = w == "unit" or w == "nil" or (IsBoundWord w)

IsBoundWord: fn Text -> Bool
fn IsBoundWord w = w == "key" or w == "ix" or w == "jx" or w == "kx"

# Keywords, reserved everywhere (Semantics ch. 2, Keywords; Appendix A.2).
let keywordList = [["module", "emit", "use", "type", "record", "choice", "row", "tag", "of",
    "derive", "trait", "impl", "where", "any", "let", "fn", "test", "check", "widget",
    "rebuild", "for", "given", "monad", "update", "while", "match", "if", "else", "otherwise",
    "require", "forbid", "return", "ignore", "then", "on", "not", "and", "or", "mod", "as",
    "output", "inline_text", "raw", "unbounded", "unit", "nil", "key", "ix", "jx", "kx"]]

let keywordSet = Map (Each keywordList, \|w| ((w, True)))

IsKeyword: fn Text -> Bool
fn IsKeyword w = keywordSet[w] != nil

# The symbol operators by longest match (ch. 2, "Operators and punctuation"), in the order
# lexer.rs tries them.
let opTable = [["==>", "<-", "<=", "<|", "->", "-=", "-?", "+=", "+?", "*=", "*?", "/=", "==",
    ">=", "=>", "<", ">", "-", "+", "*", "/", "="]]

# The operators that take a type suffix when an uppercase name touches them.
TakesSuffix: fn Text -> Bool
fn TakesSuffix op = Fold [["<=", "==", "!=", "<", ">", ">=", "+", "-", "*", "/", "+?", "-?", "*?"]], False, \|seen, o| seen or o == op

CloseChar: fn Text -> Text
fn CloseChar "(" = ")"
fn CloseChar "[" = "]"
fn CloseChar ignore = "\}"

OpenOf: fn Text -> Text
fn OpenOf ")" = "("
fn OpenOf "]" = "["
fn OpenOf ignore = "\{"

# ---------------------------------------------------------------------------------------
# Pushing tokens
# ---------------------------------------------------------------------------------------

# The spacing rule's left half: "whitespace, an open bracket, a comma, an operator or the
# start of a line comes before it".
PrefixPosition: fn Lex -> Bool
fn PrefixPosition l = l.lastWs or (NoOperandBefore (?Last l.tokens))

NoOperandBefore: fn ?Tok -> Bool
fn NoOperandBefore nil = True
fn NoOperandBefore (? t) = not (EndsOperand t.kind)

TestWordOf: fn TokKind -> Text
fn TestWordOf (KKw "test", ignore) = "test"
fn TestWordOf (KKw "check", ignore) = "check"
fn TestWordOf ignore = ""

AllLayout: fn [Tok] -> Bool
fn AllLayout ts = Fold ts, True, \|ok, t| ok and (IsLayout t.kind)

PushTok: fn Lex, TokKind, Nat, Nat -> Lex
fn PushTok l, kind, start, end = update l:
    let layout = IsLayoutOrEof kind
    let touches = not &_.lastWs and (Len &_.tokens) > 0 and not layout
    let lineStart = not layout and &_.markLineStart
    if not layout:
        &_.markLineStart <= False
    # The test language's frame: `test` or `check` beginning a top-level statement.
    let word = TestWordOf kind
    if word != "" and &_.mode == MFile and (Len &_.layout) == 1 and (AllLayout (Drop &_.tokens, &_.lineFirst)):
        &_.testPending <= word
    &_.tokens <= Push &_.tokens, Tok(kind=kind, span=Range(start=start, end=end), touches=touches, lineStart=lineStart)
    &_.lastWs <= False

LayoutOn: fn Mode -> Bool
fn LayoutOn MFile = True
fn LayoutOn (MBrace ignore) = True
fn LayoutOn ignore = False

LayoutActive: fn Lex -> Bool
fn LayoutActive l = (LayoutOn l.mode) and (Len l.frames) == 0

FatArrowOn: fn Lex -> Bool
fn FatArrowOn l = l.?testDepth != nil or l.?checkDepth != nil

# ---------------------------------------------------------------------------------------
# Streams
# ---------------------------------------------------------------------------------------

# A whole file: a token stream ending in `Eof`, with the layout tokens in it. A file whose
# first token is a language tag is a template (A.7).
LexFile: unbounded fn Text -> Lexed
fn LexFile src:
    let start = Lex(cs=(Chars src), pos=0, diags=[[]], mode=MFile, tokens=[[]], layout=[[]],
        frames=[[]], lastWs=True, lambdaOpen=False, pendingOpen=False, pendingSpan=Range(start=0, end=0),
        lineFirst=0, markLineStart=False, firstLine=True, testPending="", testDepth=nil,
        checkDepth=nil, pathNext=False)
    let skipped = SkipBlankAndCommentLines start
    let opened = (Peek skipped) == "<" and (TemplateTagAhead skipped) != ""
    let ((head, l)) = if opened: TemplateHead skipped else: (([[]], start))
    let body = LexStream (Fresh l, MFile)
    Lexed(tokens=(Append head, body.tokens), diags=body.diags)

# The template that makes a file a template file, as its first token.
TemplateHead: unbounded fn Lex -> (([Tok], Lex))
fn TemplateHead l0:
    let ((kind, l)) = LexTemplate l0, "File", l0.pos
    let tok = Tok(kind=kind, span=Range(start=l0.pos, end=l.pos), touches=False, lineStart=False)
    (([[tok]], l))

SkipBlankAndCommentLines: unbounded fn Lex -> Lex
fn SkipBlankAndCommentLines l = update l:
    let &going = True
    while &going:
        let line = RestOfLine &_
        let t = TrimStart line
        if (t == "" or (Take t, 1) == "#") and &_.pos + (Len line) < (Len &_.cs):
            &_.pos += (Len line) + 1
        else:
            &going <= False

# A nested stream (a placeholder, a brace block, a path's key) over the same text: its
# tokens, and the shared state where it ended.
Nested: unbounded fn Lex, Mode -> (([Tok], Lex))
fn Nested l, mode:
    let inner = LexStream (Fresh l, mode)
    let back = update l:
        &_.pos <= inner.pos
        &_.diags <= inner.diags
    ((inner.tokens, back))

# One stream to its end, per its mode.
LexStream: unbounded fn Lex -> Lex
fn LexStream l0 = update l0:
    let &atLineStart = LayoutOn &_.mode
    let &done = False
    while not &done:
        let &go = True
        # Layout happens at the start of each physical line, outside brackets.
        if &atLineStart and (LayoutActive &_):
            &atLineStart <= False
            let ((l, verdict)) = BeginLine &_
            &_ <= l
            if verdict == "skip":
                &atLineStart <= True
                &go <= False
            if verdict == "end":
                &done <= True
                &go <= False
        if &go:
            let c = Peek &_
            match c:
                "":
                    &_ <= UnclosedStream &_
                    &done <= True
                "\n":
                    &_.pos += 1
                    &_.lastWs <= True
                    if &_.lambdaOpen:
                        &_ <= LexErr &_, (Dec &_.pos), &_.pos, "a lambda's parameter list closes with `|` on its own line"
                        &_.lambdaOpen <= False
                    if LayoutActive &_:
                        &_ <= EndLine &_
                        &atLineStart <= True
                " ":
                    &_.pos += 1
                    &_.lastWs <= True
                "\u{d}":
                    &_.pos += 1
                    &_.lastWs <= True
                # A.1: a tab in leading whitespace is an error; elsewhere it is whitespace.
                "\t":
                    &_.pos += 1
                    &_.lastWs <= True
                # A comment runs to the end of the line, and is whitespace for every purpose.
                "#":
                    &_.pos <= LineEnd &_
                    &_.lastWs <= True
                otherwise:
                    let ((ends, l)) = StreamEndsHere &_
                    &_ <= l
                    if ends:
                        &done <= True
                    else:
                        &_ <= LexToken &_
    # Rule 10: "End of file closes every block."
    if LayoutOn &_.mode:
        while (Len &_.layout) > 1:
            &_.layout <= Pop &_.layout
            &_ <= PushTok &_, KLayClose, &_.pos, &_.pos
    if &_.mode == MFile:
        &_ <= PushTok &_, KEof, &_.pos, &_.pos

UnclosedStream: fn Lex -> Lex
fn UnclosedStream l = match l.mode:
    MFile: l
    MBrace ignore: LexErr l, l.pos, l.pos, "a brace block never closes: expected its closing delimiter alone on a line"
    MPlaceholder "single": LexErr l, l.pos, l.pos, "a placeholder never closes: expected `\}`"
    MPlaceholder ignore: LexErr l, l.pos, l.pos, "a placeholder never closes: expected `\}\}`"
    MPathKey: LexErr l, l.pos, l.pos, "a path key never closes: expected `]`"

# Whether the character at the cursor ends a nested stream; consumes the closer if so.
StreamEndsHere: fn Lex -> ((Bool, Lex))
fn StreamEndsHere l:
    let c = Peek l
    let closes = match l.mode:
        MPlaceholder "single": c == "\}"
        MPlaceholder "double": StartsWith l, "\}\}"
        MPathKey: c == "]"
        otherwise: False
    let width = if l.mode == MPlaceholder "double": 2 else: 1
    if (Len l.frames) == 0 and closes: ((True, (Forward l, width))) else: ((False, l))

# Rule 2 and rule 3 look at the last token of the line that just ended: a `:` or a closing
# lambda bar opens a layout block.
EndLine: fn Lex -> Lex
fn EndLine l = match ?Last l.tokens:
    ? t if (Len l.tokens) > l.lineFirst and (OpensBlock t.kind):
        update l:
            &_.pendingOpen <= True
            &_.pendingSpan <= t.span
    otherwise: l

OpensBlock: fn TokKind -> Bool
fn OpensBlock KColon = True
fn OpensBlock (KLambdaBar False) = True
fn OpensBlock ignore = False

# ---------------------------------------------------------------------------------------
# Layout (rules 1 to 4 and 10; Conformance A.1 inside a `test` block)
# ---------------------------------------------------------------------------------------

# Measures a line's indentation and emits its layout tokens. The verdict: `"tokens"`, the
# line has tokens; `"skip"`, a blank or comment line; `"end"`, the stream is over.
BeginLine: unbounded fn Lex -> ((Lex, Text))
fn BeginLine l0:
    let lineBegin = l0.pos
    let ((l1, col)) = Indentation l0
    match Peek l1:
        "": ((l1, "end"))
        "\n": ((Bump l1, "skip"))
        # Rule 10: "Blank and comment-only lines never open, close or continue anything."
        "#":
            let l2 = update l1:
                &_.pos <= LineEnd &_
            if (Peek l2) == "\n": ((Bump l2, "skip")) else: ((l2, "end"))
        otherwise:
            if ClosesBraceBlock l1: ((SkipLine l1, "end"))
            else:
                let l2 = IndentedLine l1, col, lineBegin
                ((l2, "tokens"))

# The leading spaces: a tab is an error and counts one column; `\u{d}` counts none.
Indentation: unbounded fn Lex -> ((Lex, Nat))
fn Indentation l0 = update ((l0, 0)):
    let &l = l0
    let &col = 0
    let &going = True
    while &going:
        match Peek &l:
            " ":
                &l <= Bump &l
                &col += 1
            "\t":
                &l <= LexErr (Bump &l), &l.pos, &l.pos + 1, "a tab in leading whitespace is an error: indent with spaces"
                &col += 1
            "\u{d}": &l <= Bump &l
            otherwise: &going <= False
    &_ <= ((&l, &col))

# A brace block ends "at the closing delimiter alone on a line".
ClosesBraceBlock: unbounded fn Lex -> Bool
fn ClosesBraceBlock l = match l.mode:
    MBrace "double": (TrimEnd (RestOfLine l)) == "\}\}"
    MBrace ignore: (TrimEnd (RestOfLine l)) == "\}"
    otherwise: False

SkipLine: unbounded fn Lex -> Lex
fn SkipLine l0:
    let l = update l0:
        &_.pos <= LineEnd &_
    if (Peek l) == "\n": Bump l else: l

# The layout tokens of a line with tokens on it; `col` its indentation, `lineBegin` where
# its leading whitespace began.
IndentedLine: unbounded fn Lex, Nat, Nat -> Lex
fn IndentedLine l0, col, lineBegin:
    let here = l0.pos
    let l = update l0:
        &_.lineFirst <= Len &_.tokens
        &_.lastWs <= True
    if l.firstLine: FirstLine l, col, lineBegin, here else: LayoutLine l, col, lineBegin, here

FirstLine: fn Lex, Nat, Nat, Nat -> Lex
fn FirstLine l0, col, lineBegin, here = update l0:
    &_.firstLine <= False
    if &_.mode == MFile:
        &_.layout <= [[0]]
        if col != 0:
            &_ <= LexErr &_, lineBegin, here, "the first line of a file starts at column 0"
            &_.layout <= [[col]]
    else:
        # "A brace block in a template resumes layout, its first statement fixing its column."
        &_.layout <= Push &_.layout, col

# `d` is set and `depth` is below it.
Below: fn ?Nat, Nat -> Bool
fn Below nil, ignore = False
fn Below (? d), depth = depth < d

LayoutLine: fn Lex, Nat, Nat, Nat -> Lex
fn LayoutLine l0, col, lineBegin, here = update l0:
    let top = Or (?Last &_.layout), 0
    let fat = StartsWith &_, "=>"
    let &opened = False
    let &fuel = Len &_.layout
    if &_.pendingOpen:
        &_.pendingOpen <= False
        if col > top:
            &_.layout <= Push &_.layout, col
            &_ <= PushTok &_, KLayOpen, here, here
            if &_.testPending == "test":
                &_.testDepth <= ? (Len &_.layout)
            if &_.testPending == "check":
                &_.checkDepth <= ? (Len &_.layout)
            &_.testPending <= ""
            &opened <= True
        else:
            &_.diags <= Push &_.diags, (LexDiag &_.pendingSpan, "expected an indented block after `:`")
    if not &opened:
        # Conformance A.1 rule 1: "A more-indented line that begins with `=>` opens the
        # step's checks", with no `:` written.
        if col > top and fat and &_.testDepth == ? (Len &_.layout):
            &_.layout <= Push &_.layout, col
            &_ <= PushTok &_, KLayOpen, here, here
        else:
            if col == top:
                # Rule 4: "A line at the block's column begins a statement, after a `sep`."
                &_ <= PushTok &_, KLaySep, here, here
                if (Len &_.layout) == 1:
                    &_.testPending <= ""
            else:
                if col > top:
                    # "A line indented more continues the statement and emits nothing."
                    &_.markLineStart <= True
                else:
                    # "A line indented less emits `close`, pops, and compares again."
                    while ? left <- &fuel -? 1 if (Len &_.layout) > 1 and col < (Or (?Last &_.layout), 0):
                        &fuel <= left
                        &_.layout <= Pop &_.layout
                        &_ <= PushTok &_, KLayClose, here, here
                        let depth = Len &_.layout
                        if Below &_.testDepth, depth:
                            &_.testDepth <= nil
                        if Below &_.checkDepth, depth:
                            &_.checkDepth <= nil
                    if col != (Or (?Last &_.layout), 0):
                        &_ <= LexErr &_, lineBegin, here, "unindent does not match any open block"
                    &_ <= PushTok &_, KLaySep, here, here
                    if (Len &_.layout) == 1:
                        &_.testPending <= ""

# ---------------------------------------------------------------------------------------
# Tokens
# ---------------------------------------------------------------------------------------

LexToken: unbounded fn Lex -> Lex
fn LexToken l0:
    let start = l0.pos
    let c = Peek l0
    let l = update l0:
        &_.pathNext <= False
    # Conformance A.2: a path after `at`, read by the test lexer.
    if l0.pathNext and ((IsDigit c) or c == "#" or c == "["): LexPathToken l, start
    else: LexTokenAt l, start, c

LexPathToken: unbounded fn Lex, Nat -> Lex
fn LexPathToken l, start:
    let ((segs, l2)) = LexPath l
    PushTok l2, (KPath segs), start, l2.pos

LexTokenAt: unbounded fn Lex, Nat, Text -> Lex
fn LexTokenAt l, start, c = match c:
    "\"":
        let ((text, l2)) = LexText l
        PushTok l2, (KText "", text), start, l2.pos
    "'":
        let ((ch, l2)) = LexChar l
        PushTok l2, (KChar "", ch), start, l2.pos
    ignore if IsDigit c:
        let ((kind, l2)) = LexNumber l, ""
        PushTok l2, kind, start, l2.pos
    ignore if IsIdentStart c: LexWordToken l, "", start
    ignore if Contains "$@?~&^", c: LexSigils l
    "!": if (PeekAt l, 1) == "=": PushOpSuffix (Forward l, 2), "!=", start else: LexSigils l
    ignore if Contains "([\{", c: LexOpen l, c, start
    ignore if Contains ")]\}", c: LexClose l, c, start
    ",": PushTok (Bump l), KComma, start, start + 1
    ":": PushTok (Bump l), KColon, start, start + 1
    ";": PushTok (Bump l), KSemi, start, start + 1
    "\\": LexBackslash l, start
    "|": LexBar l, start
    ".": LexDot l, start
    otherwise: match ?LexOperator l, start:
        ? l2: l2
        nil:
            let l2 = LexErr (Bump l), start, start + 1, "unexpected character `{c}`"
            update l2:
                &_.lastWs <= True

# The spacing rule applies to a single `[`; the pairing rule decides doubles in the parser.
LexOpen: fn Lex, Text, Nat -> Lex
fn LexOpen l, c, start:
    let prefix = c == "[" and (PrefixPosition l) and not (NextIsSpace l, 1)
    let l2 = update (Bump l):
        &_.frames <= Push &_.frames, c
    PushTok l2, (KOpen c, prefix), start, l2.pos

LexClose: fn Lex, Text, Nat -> Lex
fn LexClose l, c, start:
    let kind = OpenOf c
    let l1 = Bump l
    let l2 = match ?Last l1.frames:
        ? k if k == kind: update l1:
            &_.frames <= Pop &_.frames
        ? "<<": LexErr l1, start, l1.pos, "`{c}` inside `<<`: expected `>>`"
        ? k:
            let l3 = LexErr l1, start, l1.pos, "`{c}` closes a `{k}`"
            update l3:
                &_.frames <= Pop &_.frames
        nil: LexErr l1, start, l1.pos, "`{c}` closes nothing"
    PushTok l2, (KClose kind), start, l2.pos

# "A `|` immediately after `\` opens a parameter list."
LexBackslash: fn Lex, Nat -> Lex
fn LexBackslash l, start:
    let l1 = PushTok (Bump l), KBackslash, start, start + 1
    if (Peek l1) == "|":
        let l2 = update (Bump l1):
            &_.lambdaOpen <= True
        PushTok l2, (KLambdaBar True), l1.pos, l1.pos + 1
    else: l1

# "... which closes at the next `|` on the same line"; any other `|` separates the families
# of a row, and the parser reports it elsewhere.
LexBar: fn Lex, Nat -> Lex
fn LexBar l, start:
    let l1 = Bump l
    if l1.lambdaOpen:
        let l2 = update l1:
            &_.lambdaOpen <= False
        PushTok l2, (KLambdaBar False), start, l2.pos
    else: PushTok l1, KBar, start, l1.pos

LexDot: fn Lex, Nat -> Lex
fn LexDot l, start:
    if StartsWith l, "..": PushTok (Forward l, 2), KDotDot, start, start + 2
    else:
        let prefix = (PrefixPosition l) and not (NextIsSpace l, 1)
        let l1 = if prefix and (IsDigit (PeekAt l, 1)): LexErr l, start, start + 1, "a decimal literal has digits on both sides of its point: write `0.5`, not `.5`" else: l
        PushTok (Bump l1), (KDot prefix), start, start + 1

# Suffixed operators (ch. 2): "a symbol operator followed, with no space, by an uppercase
# name is one token".
PushOpSuffix: unbounded fn Lex, Text, Nat -> Lex
fn PushOpSuffix l, op, start:
    if (TakesSuffix op) and (IsUpper (Peek l)):
        let ((path, l2)) = LexQualifiedPath l
        PushTok l2, (KSuffixed op, path), start, l2.pos
    else: PushTok l, (KOp op, False), start, l.pos

# The first operator of the table at the cursor, or `""`.
FirstOp: fn Lex -> Text
fn FirstOp l:
    let fat = FatArrowOn l
    Fold opTable, "", \|found, s| if found == "" and (s != "=>" or fat) and (StartsWith l, s): s else: found

# "A `+` touching a closing double bracket or brace, with whitespace, a comma, a close
# bracket or the end of the line after it, is the non-empty mark."
EndsMark: fn Text -> Bool
fn EndsMark a = a == "" or (Contains " \n\u{d},)]\}", a)

ClosesSquareOrBrace: fn ?Tok -> Bool
fn ClosesSquareOrBrace (? t) = t.kind == (KClose "[") or t.kind == (KClose "\{")
fn ClosesSquareOrBrace nil = False

# Longest match over the operator table, with the two marks a sign makes against a closing
# bracket and the `<<`/`>>` pair.
?LexOperator: unbounded fn Lex, Nat -> ?Lex
fn ?LexOperator l, start:
    let c = Peek l
    let after = PeekAt l, 1
    let nonEmpty = c == "+" and not l.lastWs and (ClosesSquareOrBrace (?Last l.tokens)) and ((EndsMark after) or (after == "?" and (EndsMark (PeekAt l, 2))))
    if c == "-" and (Contains ",)]\}", after): ? (PushTok (Bump l), KAbsent, start, start + 1)
    else: if nonEmpty: ? (NonEmptyMark l, start, after)
    else: if StartsWith l, "<<": ? (OpenTypeArgs l, start)
    else: if (StartsWith l, ">>") and (?Last l.frames) == ? "<<": ? (CloseTypeArgs l, start)
    else: if StartsWith l, ">>": ? (LexErr (PushTok (Forward l, 2), KGtGt, start, start + 2), start, start + 2, "`>>` closes explicit type arguments, and none is open (Prism has no shift operators)")
    else: match FirstOp l:
        "": nil
        op: ? (PushOperator l, op, start)

NonEmptyMark: fn Lex, Nat, Text -> Lex
fn NonEmptyMark l, start, after:
    let l1 = PushTok (Bump l), KNonEmpty, start, start + 1
    # `as [Text]+?`: the non-empty mark, then the checked cast's `?` (doubt PQ).
    if after == "?": PushTok (Bump l1), (KFree "?"), l1.pos, l1.pos + 1 else: l1

# "`<<` touching a name on its left opens explicit type arguments ... Anywhere else, `<<`
# and `>>` are errors."
OpenTypeArgs: fn Lex, Nat -> Lex
fn OpenTypeArgs l, start:
    let touching = not l.lastWs and (IsNameTok (?Last l.tokens))
    let l1 = Forward l, 2
    let l2 = if touching: l1 else: LexErr l1, start, l1.pos, "`<<` opens explicit type arguments and must touch a name on its left (Prism has no shift operators)"
    let l3 = update l2:
        &_.frames <= Push &_.frames, "<<"
    PushTok l3, KLtLt, start, l3.pos

IsNameTok: fn ?Tok -> Bool
fn IsNameTok (? t) = match t.kind:
    KName ignore: True
    otherwise: False
fn IsNameTok nil = False

CloseTypeArgs: fn Lex, Nat -> Lex
fn CloseTypeArgs l, start:
    let l1 = update (Forward l, 2):
        &_.frames <= Pop &_.frames
    PushTok l1, KGtGt, start, l1.pos

PushOperator: unbounded fn Lex, Text, Nat -> Lex
fn PushOperator l, op, start:
    let l1 = Forward l, (Len op)
    # "a token that can be prefix or binary is prefix when whitespace, an open bracket, a
    # comma, an operator or the start of a line comes before it and a non-whitespace
    # character comes after it."
    if (op == "+" or op == "-" or op == "-?") and not (IsUpper (Peek l1)):
        PushTok l1, (KOp op, (PrefixPosition l1) and not (NextIsSpace l1, 0)), start, l1.pos
    else: PushOpSuffix l1, op, start

# ---------------------------------------------------------------------------------------
# Sigils and words
# ---------------------------------------------------------------------------------------

# A run of sigils and what follows it (ch. 2, "The attachment rule"): attached "when the
# character after it is a letter, a digit, `_`, `"`, `.` (for `&` only), or another sigil.
# Otherwise it is free."
LexSigils: unbounded fn Lex -> Lex
fn LexSigils l0:
    let start = l0.pos
    let ((sigils, caret, l)) = ReadSigils l0
    let next = Peek l
    if caret: LexCaret l, start, sigils, next
    else: if (IsIdentStart next) or (IsDigit next) or next == "\"": LexAttached l, start, sigils, next
    else: if sigils == "&" and next == "." and (IsLower (PeekAt l, 1)): PushTok (Bump l), KLensDot, start, l.pos + 1
    else: FreeSigils l, start, sigils

# The sigils at the cursor, and whether a `^` ended them.
ReadSigils: unbounded fn Lex -> ((Text, Bool, Lex))
fn ReadSigils l0 = update (("", False, l0)):
    let &l = l0
    let &sigils = ""
    let &caret = False
    let &going = True
    while &going:
        let c = Peek &l
        if c == "^":
            &l <= Bump &l
            &caret <= True
            &going <= False
        else:
            if (IsSigilChar c) and not (c == "!" and (PeekAt &l, 1) == "="):
                &l <= Bump &l
                &sigils <= "{&sigils}{c}"
            else:
                &going <= False
    &_ <= ((&sigils, &caret, &l))

# `^` is a mark that attaches by the same rule, to a trait name.
LexCaret: unbounded fn Lex, Nat, Text, Text -> Lex
fn LexCaret l, start, sigils, next:
    if (IsUpper next) and sigils == "":
        let ((path, l2)) = LexQualifiedPath l
        PushTok l2, (KTrait path), start, l2.pos
    else:
        let ((ignore, skipped)) = LexQualifiedPath l
        let l2 = if IsIdentStart next: skipped else: l
        LexErr l2, start, (Max l2.pos, l.pos), "`^` marks a trait and attaches to its uppercase name: no trait is a value"

LexAttached: unbounded fn Lex, Nat, Text, Text -> Lex
fn LexAttached l, start, sigils, next:
    if next == "\"":
        let ((text, l2)) = LexText l
        PushTok l2, (KText sigils, text), start, l2.pos
    else: if IsDigit next:
        let ((kind, l2)) = LexNumber l, sigils
        PushTok l2, kind, start, l2.pos
    else: LexWordToken l, sigils, start

# Free. A run of several sigils before a bracket is several free sigils, each the prefix
# over what follows (`@!(Text ==> ?Nat)` in a type).
FreeSigils: fn Lex, Nat, Text -> Lex
fn FreeSigils l0, start, sigils = update l0:
    let spaceAfter = NextIsSpace &_, 0
    let all = Chars sigils
    for s <- all:
        let at = start + ix
        if spaceAfter and ix + 1 == (Len all):
            if s == "!":
                &_ <= LexErr &_, at, at + 1, "`!` is never free: no event fires a constant (write `!e` touching its name)"
            if s == "&":
                &_ <= LexErr &_, at, at + 1, "`&` is never free: no reference exists outside the value an `update` block names"
        &_ <= PushTok &_, (KFree s), at, at + 1

# `Ui.Button`, `Rust.templatetext`: uppercase segments joined by `.` with nothing between,
# the last possibly one of the reserved lowercase constructors.
LexQualifiedPath: unbounded fn Lex -> (([Text], Lex))
fn LexQualifiedPath l0 = update (([[]], l0)):
    let ((first, l1)) = LexIdent l0
    let &path = [[first]]
    let &l = l1
    let &going = True
    while &going:
        let last = Or (?Last &path), ""
        let next = PeekAt &l, 1
        if (Peek &l) != "." or not (IsUpper (Take last, 1)):
            &going <= False
        else:
            if IsUpper next:
                let ((seg, l2)) = LexIdent (Bump &l)
                &path <= Push &path, seg
                &l <= l2
            else:
                &going <= False
                if IsIdentStart next:
                    let ((w, l2)) = LexIdent (Bump &l)
                    if IsReservedCtor w:
                        &path <= Push &path, w
                        &l <= l2
    &_ <= ((&path, &l))

LexIdent: unbounded fn Lex -> ((Text, Lex))
fn LexIdent l0:
    let l = update l0:
        while IsIdentChar (Peek &_):
            &_.pos += 1
    let word = Slice l, l0.pos, l.pos
    ((word, l))

# A word: a keyword, a name, a qualified name, a family pattern `Ui.*`, the topic or a hole;
# with `sigils` already read.
LexWordToken: unbounded fn Lex, Text, Nat -> Lex
fn LexWordToken l0, sigils, start:
    let wStart = l0.pos
    let ((path, l1)) = LexQualifiedPath l0
    let l = if IsNonAscii (Peek l1): SkipNonAscii l1, wStart else: l1
    let first = Or path[0], ""
    # `Ui.*` is one token, "and the only place `*` touches a `.`".
    if (StartsWith l, ".*") and (IsUpper (Take first, 1)):
        let l2 = Forward l, 2
        let l3 = if sigils != "": LexErr l2, start, l2.pos, "a family pattern takes no sigil" else: l2
        PushTok l3, (KFamily path), start, l3.pos
    else: if (Len path) == 1 and (IsKeyword first) and not ((IsBoundWord first) and sigils != ""):
        LexKeyword l, first, sigils, start
    else: LexName l, path, sigils, start, wStart

# A non-ASCII letter glued to a name: "Names are ASCII letters, digits and underscores."
SkipNonAscii: unbounded fn Lex, Nat -> Lex
fn SkipNonAscii l0, wStart:
    let l = update l0:
        while (IsIdentChar (Peek &_)) or (IsNonAscii (Peek &_)):
            &_.pos += 1
    LexErr l, wStart, l.pos, "names are ASCII letters, digits and underscores"

LexKeyword: unbounded fn Lex, Text, Text, Nat -> Lex
fn LexKeyword l, w, sigils, start:
    let l1 = if sigils != "" and not (w == "widget" or w == "unit" or w == "nil"): LexErr l, start, l.pos, "`{w}` is a keyword and takes no sigil" else: l
    let l2 = if w == "widget" and sigils != "@": LexErr l1, start, l1.pos, "`widget` is a block only as `@widget:`" else: l1
    let l3 = PushTok l2, (KKw w, sigils), start, l2.pos
    if w == "output" or w == "inline_text" or w == "raw": MaybeTemplate l3, w else: l3

LexName: unbounded fn Lex, [Text], Text, Nat, Nat -> Lex
fn LexName l, path, sigils, start, wStart:
    let ((case, l1)) = NameCaseOf l, path, wStart
    # Conformance A.2: "A path after `at` or `click element` is read by the test lexer".
    let l2 = if IsPathWord l1, sigils, path: update l1:
        &_.pathNext <= True
    else: l1
    PushTok l2, (KName NameTok(sigils=sigils, path=path, case=case)), start, l2.pos

NameCaseOf: fn Lex, [Text], Nat -> ((NameCase, Lex))
fn NameCaseOf l, path, wStart:
    let last = Or (?Last path), ""
    if last == "_": ((CaseTopic, l))
    else: if (Take last, 1) == "_" and (AllChars (Drop last, 1), IsDigit): ((CaseHole, l))
    else: if (Take last, 1) == "_": ((CaseLower, (LexErr l, wStart, l.pos, "`_` followed by a letter is not a name: `_` alone is the topic, `_1` a hole")))
    else: if IsReservedCtor last: ((CaseReserved, l))
    else: if IsUpper (Take last, 1):
        let underscored = Fold path, False, \|seen, seg| seen or (Contains seg, "_")
        if underscored: ((CaseUpper, (LexErr l, wStart, l.pos, "`{Join path, "."}`: a capital promises UpperCamelCase")))
        else: ((CaseUpper, l))
    else: ((CaseLower, l))

# `at` after a delivery word, `element` after `click`, inside a `test` block.
IsPathWord: fn Lex, Text, [Text] -> Bool
fn IsPathWord l, sigils, path:
    let w = Or path[0], ""
    let words = if w == "at": [["send", "click", "answer"]] else: [["click"]]
    let prev = match ?Last l.tokens:
        ? t: match t.kind:
            KName n if n.sigils == "" and (Len n.path) == 1: Or n.path[0], ""
            otherwise: ""
        nil: ""
    l.?testDepth != nil and sigils == "" and (Len path) == 1 and (w == "at" or w == "element") and (Fold words, False, \|seen, x| seen or x == prev)

# ---------------------------------------------------------------------------------------
# Literals
# ---------------------------------------------------------------------------------------

# Numbers and durations (ch. 2, Literals: Numbers, Durations).
LexNumber: unbounded fn Lex, Text -> ((TokKind, Lex))
fn LexNumber l, sigils:
    if (Peek l) == "0" and (Contains "xob", (PeekAt l, 1)): LexRadix l, sigils
    else: LexDecimal l, sigils

RadixDigit: fn Text, Text -> Bool
fn RadixDigit "x", c = IsHexDigit c
fn RadixDigit "o", c = "0" <= c and c <= "7"
fn RadixDigit ignore, c = c == "0" or c == "1"

LexRadix: unbounded fn Lex, Text -> ((TokKind, Lex))
fn LexRadix l0, sigils:
    let start = l0.pos
    let radix = PeekAt l0, 1
    let l1 = Forward l0, 2
    let l2 = update l1:
        while (RadixDigit radix, (Peek &_)) or (Peek &_) == "_":
            &_.pos += 1
    let l3 = if l2.pos == l1.pos: LexErr l2, start, l2.pos, "a radix prefix needs digits after it" else: l2
    let l4 = CheckNoSuffix l3, start
    let kind = KInt sigils, (Slice l4, start, l4.pos)
    ((kind, l4))

SkipDigits: unbounded fn Lex -> Lex
fn SkipDigits l = update l:
    while (IsDigit (Peek &_)) or (Peek &_) == "_":
        &_.pos += 1

LexDecimal: unbounded fn Lex, Text -> ((TokKind, Lex))
fn LexDecimal l0, sigils:
    let start = l0.pos
    let l1 = SkipDigits l0
    let next = PeekAt l1, 1
    if (Peek l1) == "." and (IsDigit next): NumberTail (SkipDigits (Bump l1)), sigils, start, True
    # `1.` is an error: "A decimal-spelled literal has digits on both sides of its one `.`".
    # A `.` before a name is field access, which the parser refuses on a literal; `1..` is a
    # range.
    else: if (Peek l1) == "." and next != "." and next != "" and not (IsIdentStart next):
        let l2 = Bump l1
        let l3 = LexErr l2, start, l2.pos, "`{Slice l2, start, l2.pos}` is not a number: a decimal literal has digits on both sides of its point"
        let kind = KFloat sigils, (Slice l3, start, (Dec l2.pos))
        ((kind, l3))
    else: NumberTail l1, sigils, start, False

# The duration units and their scale in nanoseconds, in the order lexer.rs tries them.
let durationUnits = [[(("ns", 1)), (("us", 1000)), (("ms", 1000000)), (("min", 60000000000)), (("s", 1000000000)), (("h", 3600000000000))]]

?UnitAt: fn Lex -> ?((Text, Nat))
fn ?UnitAt l = Fold durationUnits, nil, \|?found, u| if ?found == nil and (UnitHere l, u): ? u else: ?found

UnitHere: fn Lex, ((Text, Nat)) -> Bool
fn UnitHere l, ((u, ignore)) = (StartsWith l, u) and not (IsIdentChar (PeekAt l, (Len u)))

# A duration, an exponent, or the number as it stands.
NumberTail: unbounded fn Lex, Text, Nat, Bool -> ((TokKind, Lex))
fn NumberTail l, sigils, start, decimal = match ?UnitAt l:
    ? ((u, scale)):
        # A duration: "a digit string, with at most one point, followed with nothing between
        # by one of `ns`, `us`, `ms`, `s`, `min` and `h`".
        let digits = Slice l, start, l.pos
        let l2 = Forward l, (Len u)
        let l3 = if WholeNanoseconds digits, scale: l2 else: LexErr l2, start, l2.pos, "`{digits}{u}` does not name a whole number of nanoseconds"
        let kind = KDuration sigils, digits, u
        ((kind, l3))
    nil:
        let ((dec, l2)) = Exponent l, decimal
        let l3 = CheckNoSuffix l2, start
        let text = Slice l3, start, l3.pos
        let kind = if dec: KFloat sigils, text else: KInt sigils, text
        ((kind, l3))

Exponent: unbounded fn Lex, Bool -> ((Bool, Lex))
fn Exponent l, decimal:
    let l1 = Bump l
    let l2 = if (Peek l1) == "+" or (Peek l1) == "-": Bump l1 else: l1
    if ((Peek l) == "e" or (Peek l) == "E") and (IsDigit (Peek l2)): ((True, SkipDigits l2))
    else: ((decimal, l))

# Whether `digits[.frac]` times `scale` nanoseconds is whole.
WholeNanoseconds: fn Text, Nat -> Bool
fn WholeNanoseconds text, scale:
    let parts = Split (Concat (Split text, "_")), "."
    match parts[1]:
        nil: True
        ? frac0:
            let frac = TrimZeros frac0
            let k = Len frac
            let f = if frac == "": 0 else: Or (?ParseNat frac), 1
            let tens = Fold (Chars frac), 1, \|p, ignore| p * 10
            k <= 30 and (Or (?Mod (f * scale), tens), 1) == 0

TrimZeros: fn Text -> Text
fn TrimZeros t = Take t, (Or ((Len t) -? (LeadingIn (Reverse t), "0")), 0)

# "A literal has no type suffix; `255U8` is not a token" (round 47 BI; doubt LS).
CheckNoSuffix: unbounded fn Lex, Nat -> Lex
fn CheckNoSuffix l0, start:
    if IsIdentChar (Peek l0):
        let l = update l0:
            while IsIdentChar (Peek &_):
                &_.pos += 1
        LexErr l, start, l.pos, "`{Slice l, start, l.pos}` is not a token: a number literal has no suffix (write a type annotation)"
    else: l0

# One escape after `\` (ch. 2, Text): what it writes, and the lexer after it.
LexEscape: unbounded fn Lex -> ((Text, Lex))
fn LexEscape l0:
    let start = l0.pos
    let l1 = Bump l0
    let c = Peek l1
    let l2 = Bump l1
    match c:
        "\\": (("\\", l2))
        "\"": (("\"", l2))
        "'": (("'", l2))
        "n": (("\n", l2))
        "t": (("\t", l2))
        "\{": (("\{", l2))
        "\}": (("\}", l2))
        "u": UnicodeEscape l2, start
        "": (("", (LexErr l1, start, l1.pos, "a text literal ends inside an escape")))
        otherwise: (("", (LexErr l2, start, l2.pos, "`\\{c}` is not an escape: the escapes are \\\\ \\\" \\n \\t \\\{ \\\} \\u\{hex\}")))

UnicodeEscape: unbounded fn Lex, Nat -> ((Text, Lex))
fn UnicodeEscape l, start:
    if (Peek l) != "\{": (("", (LexErr l, start, l.pos, "`\\u` is written `\\u\{hex\}`")))
    else:
        let hs = l.pos + 1
        let l1 = update (Bump l):
            while IsHexDigit (Peek &_):
                &_.pos += 1
        let hex = Slice l1, hs, l1.pos
        if (Peek l1) != "\}": (("", (LexErr l1, start, l1.pos, "`\\u\{` needs its closing `\}`")))
        else:
            let l2 = Bump l1
            match ?AsciiChar (Or (?ParseHex hex), 1114112):
                ? ch: ((ch, l2))
                nil: (("", (LexErr l2, start, l2.pos, "`\\u\{{hex}\}` is past ASCII, which prismc cannot write yet (prismc/README.md, gap UC)")))

# `"..."` on one line, with placeholders read as token streams.
LexText: unbounded fn Lex -> (([TextSegTok], Lex))
fn LexText l0 = update (([[]], l0)):
    let start = l0.pos
    let &l = Bump l0
    let &segs = [[]]
    let &cur = ""
    let &going = True
    while &going:
        let c = Peek &l
        if c == "" or c == "\n":
            &l <= LexErr &l, start, &l.pos, "a text literal ends on its line: close it with `\"`, or write a multiline text as `raw <markdown>...</markdown>`"
            &going <= False
        else:
            match c:
                "\"":
                    &l <= Bump &l
                    &going <= False
                "\\":
                    let ((s, l2)) = LexEscape &l
                    &cur <= "{&cur}{s}"
                    &l <= l2
                "\{":
                    if &cur != "":
                        &segs <= Push &segs, (TsPlain &cur)
                        &cur <= ""
                    let ps = &l.pos
                    # "A placeholder is read as ordinary tokens, nested literals and brackets
                    # included, until the matching brace, with layout suspended."
                    let ((toks, l2)) = Nested (Bump &l), (MPlaceholder "single")
                    &segs <= Push &segs, (TsPlaceholder toks, Range(start=ps, end=l2.pos))
                    &l <= l2
                "\}":
                    &l <= LexErr (Bump &l), &l.pos, &l.pos + 1, "a `\}` in text is written `\\\}`"
                    &cur <= "{&cur}\}"
                otherwise:
                    &l <= Bump &l
                    &cur <= "{&cur}{c}"
    if &cur != "":
        &segs <= Push &segs, (TsPlain &cur)
    &_ <= ((&segs, &l))

# `'c'`, one code point.
LexChar: unbounded fn Lex -> ((Text, Lex))
fn LexChar l0:
    let start = l0.pos
    let l1 = Bump l0
    let c = Peek l1
    let ((s, l2)) = if c == "\\": LexEscape l1 else: if c == "'" or c == "\n" or c == "": (("", l1)) else: ((c, (Bump l1)))
    let ok = (Peek l2) == "'"
    let l3 = if ok: Bump l2 else: CharTail l2, start
    let l4 = if s == "": LexErr l3, start, l3.pos, "a character literal holds one code point: `'c'`" else: l3
    let ch = if s == "": "\u{0}" else: s
    ((ch, l4))

CharTail: unbounded fn Lex, Nat -> Lex
fn CharTail l0, start:
    let l1 = update l0:
        while (Peek &_) != "'" and (Peek &_) != "\n" and (Peek &_) != "":
            &_.pos += 1
    let l2 = if (Peek l1) == "'": Bump l1 else: l1
    LexErr l2, start, l2.pos, "a character literal holds one code point: `'c'`"

# ---------------------------------------------------------------------------------------
# The test language's path (Conformance A.2): "a segment is a number, `#` and a number, or
# `[` a Prism expression `]`; segments are joined by `/`, with no spaces".
# ---------------------------------------------------------------------------------------

LexPath: unbounded fn Lex -> (([PathSegTok], Lex))
fn LexPath l0 = update (([[]], l0)):
    let &l = l0
    let &segs = [[]]
    let &going = True
    while &going:
        let s = &l.pos
        let c = Peek &l
        if c == "#":
            let digits = update (Bump &l):
                while IsDigit (Peek &_):
                    &_.pos += 1
            let text = Slice digits, s + 1, digits.pos
            &l <= if text == "": LexErr digits, s, digits.pos, "a generation segment is `#` and a number" else: digits
            &segs <= Push &segs, (PstGen (Or (?ParseNat text), 0))
        else:
            if IsDigit c:
                let digits = update &l:
                    while IsDigit (Peek &_):
                        &_.pos += 1
                &segs <= Push &segs, (PstNum (Or (?ParseNat (Slice digits, s, digits.pos)), 0))
                &l <= digits
            else:
                if c == "[":
                    let ((toks, l2)) = Nested (Bump &l), MPathKey
                    &segs <= Push &segs, (PstKey toks)
                    &l <= l2
                else:
                    &l <= LexErr &l, s, s, "expected a path segment: a number, `#` and a number, or `[key]`"
                    &going <= False
        if &going:
            if (Peek &l) == "/":
                &l <= Bump &l
            else:
                &going <= False
    &_ <= ((&segs, &l))


# ---------------------------------------------------------------------------------------
# Templates (Templates ch. 2; Semantics ch. 2, "The template frame")
# ---------------------------------------------------------------------------------------

# After `output`, `inline_text` or `raw`, a language tag begins a template ("The language
# tag is a token form").
MaybeTemplate: unbounded fn Lex, Text -> Lex
fn MaybeTemplate l0, kw:
    let l = update l0:
        while (Peek &_) == " ":
            &_.pos += 1
    if (Peek l) == "<" and (TemplateTagAhead l) != "":
        let keyword = if kw == "output": "Output" else: if kw == "inline_text": "InlineText" else: "Raw"
        let ((kind, l2)) = LexTemplate l, keyword, l.pos
        let l3 = update l2:
            &_.lastWs <= True
        PushTok l3, kind, l.pos, l3.pos
    else: LexErr l0, l0.pos, l0.pos, "`{kw}` is followed by a language tag, `<rust>`"

# `<` touching a lowercase name touching `>`: the name, if one is here, else `""`.
TemplateTagAhead: unbounded fn Lex -> Text
fn TemplateTagAhead l:
    let ((name, ignore)) = LexIdent (Bump l)
    let after = PeekAt l, (Len name) + 1
    if (Peek l) == "<" and name != "" and (IsLower (Take name, 1)) and after == ">": name else: ""

# The template token's kind, and the lexer after its closing tag.
LexTemplate: unbounded fn Lex, Text, Nat -> ((TokKind, Lex))
fn LexTemplate l0, keyword, start:
    let lang = TemplateTagAhead l0
    let l1 = Forward l0, (Len lang) + 2
    let delims = if lang == "markdown" or lang == "html": "single" else: "double"
    # "When the language tag ends its line, the newline after it is not text."
    let endsLine = (Peek l1) == "\n" or (StartsWith l1, "\u{d}\n")
    let skip = if (Peek l1) == "\u{d}": 2 else: 1
    let l2 = if endsLine: Forward l1, skip else: l1
    let ((parts, l3)) = TemplateBody l2, "</{lang}>", delims, keyword == "Raw", not endsLine, start
    let kind = KTemplate TemplateTok(keyword=keyword, lang=lang, delims=delims, parts=parts)
    ((kind, l3))

# One raw line of a template: its items, whether a newline ended it, and whether it was a
# brace block.
type RawLine = record:
    items: [RawItem]
    newline: Bool
    block: Bool
derive ^Eq, ^Show

type RawItem = choice:
    RiText Text
    RiPlaceholder [Tok], Range
    RiBlock [Tok], Range
    RiCall NameTok, [AttrTok], ?[TPartTok], Range
derive ^Eq, ^Show

let emptyLine = RawLine(items=[[]], newline=False, block=False)

# An item onto a line, a character merged into the text run before it.
AddItem: fn RawLine, RawItem -> RawLine
fn AddItem line, item = update line:
    &_.items <= AddRaw &_.items, item

AddRaw: fn [RawItem], RawItem -> [RawItem]
fn AddRaw items, (RiText t) = match ?Last items:
    ? (RiText s): Push (Pop items), (RiText "{s}{t}")
    otherwise: Push items, (RiText t)
fn AddRaw items, item = Push items, item

OnlyWhitespace: fn RawLine -> Bool
fn OnlyWhitespace line = Fold line.items, True, \|ok, it| ok and (IsBlankText it)

IsBlankText: fn RawItem -> Bool
fn IsBlankText (RiText s) = AllChars s, \|c| c == " " or c == "\u{d}"
fn IsBlankText ignore = False

TextLen: fn RawLine -> Nat
fn TextLen line = Fold line.items, 0, \|n, it| n + (TextLenOf it)

TextLenOf: fn RawItem -> Nat
fn TextLenOf (RiText s) = Len s
fn TextLenOf ignore = 0

# The state of reading a template's body.
type TplRead = record:
    l: Lex
    lines: [RawLine]
    cur: RawLine
    closingCol: ?Nat
    closed: Bool
    atLineStart: Bool
    going: Bool
derive ^Eq, ^Show

# What every step of a template's body needs to know.
type TplHow = record:
    close: Text
    delims: Text
    open: Text
    isRaw: Bool
    firstContinues: Bool
derive ^Eq, ^Show

# Reads a template's text up to `close` and applies Templates ch. 2's whitespace rules.
# `firstContinues` is true when the first line of text shares the opening tag's line.
TemplateBody: unbounded fn Lex, Text, Text, Bool, Bool, Nat -> (([TPartTok], Lex))
fn TemplateBody l0, close, delims, isRaw, firstContinues, openStart:
    let open = if delims == "double": "\{\{" else: "\{"
    let how = TplHow(close=close, delims=delims, open=open, isRaw=isRaw, firstContinues=firstContinues)
    let start = TplRead(l=l0, lines=[[]], cur=emptyLine, closingCol=nil, closed=False, atLineStart=(not firstContinues), going=True)
    let r = update start:
        while &_.going:
            &_ <= TemplateStep &_, how
    let l1 = if r.closed: r.l else: LexErr r.l, openStart, r.l.pos, "a template never closes: expected `{close}`"
    FinishTemplateLines l1, (Push r.lines, r.cur), (Or r.?closingCol, 0), firstContinues

TemplateStep: unbounded fn TplRead, TplHow -> TplRead
fn TemplateStep s, how:
    let rest = RestOfLine s.l
    let c = Peek s.l
    # A brace block: the opener alone on its line.
    if s.atLineStart and not how.isRaw and (Trim rest) == how.open: BraceBlockLine s, rest, how
    else: if StartsWith s.l, how.close: CloseTemplate s, how
    else: if c == "":
        update s:
            &_.atLineStart <= False
            &_.going <= False
    else: if c == "\n":
        update s:
            &_.l <= Bump &_.l
            &_.cur.newline <= True
            &_.lines <= Push &_.lines, &_.cur
            &_.cur <= emptyLine
            &_.atLineStart <= True
    else:
        let ((item, l2)) = TemplateItem s.l, how
        update s:
            &_.atLineStart <= False
            &_.l <= l2
            &_.cur <= AddItem &_.cur, item

BraceBlockLine: unbounded fn TplRead, Text, TplHow -> TplRead
fn BraceBlockLine s, rest, how:
    let bs = s.l.pos
    let past = Forward s.l, (Len rest)
    let at = if (Peek past) == "\n": Bump past else: past
    let ((toks, l2)) = Nested at, (MBrace how.delims)
    let line = RawLine(items=[[(RiBlock toks, Range(start=bs, end=l2.pos))]], newline=False, block=True)
    update s:
        &_.lines <= Push &_.lines, line
        &_.l <= l2

# "The frame ends at the first matching closing tag in text." When the closing tag begins
# its line, its column is stripped from every line, and the newline before it is text.
CloseTemplate: fn TplRead, TplHow -> TplRead
fn CloseTemplate s, how = update s:
    &_.atLineStart <= False
    if (OnlyWhitespace &_.cur) and ((Len &_.lines) > 0 or not how.firstContinues):
        &_.closingCol <= ? (TextLen &_.cur)
        &_.cur.items <= [[]]
    &_.l <= Forward &_.l, (Len how.close)
    &_.closed <= True
    &_.going <= False

# One item of a template line: an escaped opener, a placeholder, a call, or a character.
TemplateItem: unbounded fn Lex, TplHow -> ((RawItem, Lex))
fn TemplateItem l, how:
    let live = not how.isRaw
    if live and how.delims == "double" and (StartsWith l, "\\\{\{"): ((RiText "\{\{", (Forward l, 3)))
    else: if live and how.delims == "single" and (StartsWith l, "\\\{"): ((RiText "\{", (Forward l, 2)))
    else: if live and (StartsWith l, how.open):
        let ps = l.pos
        let ((toks, l2)) = Nested (Forward l, (Len how.open)), (MPlaceholder how.delims)
        let item = RiPlaceholder toks, Range(start=ps, end=l2.pos)
        ((item, l2))
    else: if live and (StartsWith l, "<@") and (IsUpper (PeekAt l, 2)): TemplateCall l, how.delims, how.open
    else: ((RiText (Peek l), (Bump l)))

# The state of reading a template call's attributes.
type CallRead = record:
    l: Lex
    attrs: [AttrTok]
    body: ?[TPartTok]
    going: Bool
derive ^Eq, ^Show

# `<@Name attr={{v}} attr="t"/>` or `<@Name ...>body</@Name>` (Templates ch. 2, "`<@` is
# the only call form").
TemplateCall: unbounded fn Lex, Text, Text -> ((RawItem, Lex))
fn TemplateCall l0, delims, open:
    let start = l0.pos
    let ((sigils, ignore, l1)) = ReadSigils (Bump l0)
    let ((path, l2)) = LexQualifiedPath l1
    let name = NameTok(sigils=sigils, path=path, case=CaseUpper)
    let close = "</{sigils}{Join path, "."}>"
    let r = update CallRead(l=l2, attrs=[[]], body=nil, going=True):
        while &_.going:
            &_ <= CallStep &_, start, close, delims, open
    let item = RiCall name, r.attrs, r.?body, Range(start=start, end=r.l.pos)
    ((item, r.l))

CallStep: unbounded fn CallRead, Nat, Text, Text, Text -> CallRead
fn CallStep s0, start, close, delims, open:
    let l = update s0.l:
        while Contains " \n\u{d}", (Peek &_):
            &_.pos += 1
    let s = update s0:
        &_.l <= l
    let at = l.pos
    if StartsWith l, "/>":
        update s:
            &_.l <= Forward l, 2
            &_.going <= False
    else: if (Peek l) == ">":
        let past = Bump l
        let continues = (Peek past) != "\n"
        let from = if continues: past else: Bump past
        let ((parts, l3)) = TemplateBody from, close, delims, False, continues, start
        update s:
            &_.body <= ? parts
            &_.l <= l3
            &_.going <= False
    else: if not (IsIdentStart (Peek l)):
        update s:
            &_.l <= LexErr l, at, at + 1, "expected an attribute `name=value`, `/>` or `>` in a template call"
            &_.going <= False
    else:
        let ((aname, l3)) = LexIdent l
        if (Peek l3) != "=":
            update s:
                &_.l <= LexErr l3, at, l3.pos, "an attribute is `name=value`"
        else:
            let ((tokens, l4)) = AttrValue (Bump l3), delims, open
            update s:
                &_.attrs <= Push &_.attrs, AttrTok(name=aname, tokens=tokens, span=Range(start=at, end=l4.pos))
                &_.l <= l4

AttrValue: unbounded fn Lex, Text, Text -> (([Tok], Lex))
fn AttrValue l, delims, open:
    if StartsWith l, open: Nested (Forward l, (Len open)), (MPlaceholder delims)
    else: if (Peek l) == "\"":
        let ((text, l2)) = LexText l
        let tok = Tok(kind=(KText "", text), span=Range(start=l.pos, end=l2.pos), touches=False, lineStart=False)
        (([[tok]], l2))
    else: (([[]], (LexErr l, l.pos, l.pos, "an attribute's value is a placeholder `{open}...` or a text literal")))

# The whitespace rules of Templates ch. 2 ("Whitespace and escapes"): the closing tag's
# column is stripped from every line, and an under-indented line is an error (Q-CT3); a
# placeholder alone on its line stands for whole lines; `{{` and `}}` alone on their lines
# leave no line.
FinishTemplateLines: fn Lex, [RawLine], Nat, Bool -> (([TPartTok], Lex))
fn FinishTemplateLines l0, lines, strip, firstContinues = update (([[]], l0)):
    let &l = l0
    let &parts = [[]]
    for line <- lines:
        if line.block:
            &parts <= Append &parts, (BlockParts line.items)
        else:
            let first = ix == 0 and firstContinues
            let ((items, l2)) = if not first and strip > 0: StripLine line, strip, &l else: ((line.items, &l))
            &l <= l2
            # A placeholder alone on its line.
            let nonBlank = Fold items, [[]], \|acc, it| if IsBlankOrEmpty it: acc else: Push acc, it
            let alone = not first and line.newline and (Len nonBlank) == 1 and (IsPlaceholderItem (Or nonBlank[0], (RiText "")))
            if alone:
                &parts <= Push &parts, (AlonePlaceholder items)
            else:
                &parts <= Fold items, &parts, PushPart
                if line.newline:
                    &parts <= PushPart &parts, (RiText "\n")
    &_ <= ((&parts, &l))

BlockParts: fn [RawItem] -> [TPartTok]
fn BlockParts items = Fold items, [[]], \|acc, it| match it:
    RiBlock tokens, span: Push acc, (TptBlock tokens, span)
    otherwise: acc

# Strips the closing tag's column from a line's leading spaces.
StripLine: fn RawLine, Nat, Lex -> (([RawItem], Lex))
fn StripLine line, strip, l:
    let blank = OnlyWhitespace line
    let n = match line.items[0]:
        ? (RiText s): LeadingIn s, " "
        otherwise: 0
    let items = match line.items[0]:
        ? (RiText s): Append [[RiText (Drop s, (Min n, strip))]], (Drop line.items, 1)
        otherwise: line.items
    let l2 = if n < strip and not blank: LexErr l, (FirstItemSpan items).start, (FirstItemSpan items).end, "a template line is indented less than its closing tag (Q-CT3)" else: l
    let kept = if items[0] == ? (RiText ""): Drop items, 1 else: items
    ((kept, l2))

IsBlankOrEmpty: fn RawItem -> Bool
fn IsBlankOrEmpty (RiText s) = (Trim s) == ""
fn IsBlankOrEmpty ignore = False

IsPlaceholderItem: fn RawItem -> Bool
fn IsPlaceholderItem (RiPlaceholder ignore, ignore) = True
fn IsPlaceholderItem ignore = False

# The span of a line's first item that is not text, for its error.
FirstItemSpan: fn [RawItem] -> Range
fn FirstItemSpan items = Or (Fold items, nil, \|?found, it| if ?found != nil: ?found else: ?ItemSpan it), Range(start=0, end=0)

?ItemSpan: fn RawItem -> ?Range
fn ?ItemSpan (RiPlaceholder ignore, span) = ? span
fn ?ItemSpan (RiBlock ignore, span) = ? span
fn ?ItemSpan (RiCall ignore, ignore, ignore, span) = ? span
fn ?ItemSpan ignore = nil

# The placeholder of a line it stands alone on, at the column of its line's indentation.
AlonePlaceholder: fn [RawItem] -> TPartTok
fn AlonePlaceholder items:
    let ((ignore, part)) = Fold items, ((0, (TptText ""))), \|((c, p)), it| AloneStep c, p, it
    part

AloneStep: fn Nat, TPartTok, RawItem -> ((Nat, TPartTok))
fn AloneStep c, (TptText ""), (RiText s) = if c == 0: (((LeadingIn s, " "), (TptText ""))) else: ((c, (TptText "")))
fn AloneStep c, (TptText ""), (RiPlaceholder tokens, span) = ((c, (TptPlaceholder tokens, (? c), span)))
fn AloneStep c, p, ignore = ((c, p))

# A raw item as a template part, a text run merged into the run before it.
PushPart: fn [TPartTok], RawItem -> [TPartTok]
fn PushPart parts, (RiText "") = parts
fn PushPart parts, (RiText t) = match ?Last parts:
    ? (TptText s): Push (Pop parts), (TptText "{s}{t}")
    otherwise: Push parts, (TptText t)
fn PushPart parts, (RiPlaceholder tokens, span) = Push parts, (TptPlaceholder tokens, nil, span)
fn PushPart parts, (RiBlock tokens, span) = Push parts, (TptBlock tokens, span)
fn PushPart parts, (RiCall name, attrs, ?body, span) = Push parts, (TptCall name, attrs, ?body, span)

# ---------------------------------------------------------------------------------------
# The layout corpus's notation (prism_syntax/src/corpus.rs): what `front.prism --tokens`
# prints, to diff the two lexers
# ---------------------------------------------------------------------------------------

RenderTokens: fn [Tok] -> Text
fn RenderTokens tokens:
    let ((out, ignore)) = Fold tokens, (("", nil)), \|((acc, ?prev)), t| RenderStep acc, ?prev, t
    "{out}\n"

RenderStep: fn Text, ?Tok, Tok -> ((Text, ?Tok))
fn RenderStep acc, ?prev, t:
    let gap = match ?prev:
        nil: ""
        ? p: if IsLayout t.kind: "\n" else: if (IsBracket p.kind) and (IsBracket t.kind) and t.touches: "·" else: " "
    if t.kind == KEof: ((acc, (? t))) else: (("{acc}{gap}{TokenText t.kind}", (? t)))

IsBracket: fn TokKind -> Bool
fn IsBracket (KOpen ignore, ignore) = True
fn IsBracket (KClose ignore) = True
fn IsBracket ignore = False

RenderInner: fn [Tok] -> Text
fn RenderInner tokens = Join (Split (TrimEnd (TrimNewlines (RenderTokens tokens))), "\n"), " "

TrimNewlines: fn Text -> Text
fn TrimNewlines t = Take t, (Or ((Len t) -? (LeadingIn (Reverse t), "\n \t")), 0)

# One token's text in the corpus notation.
TokenText: fn TokKind -> Text
fn TokenText (KName n) = "{n.sigils}{Join n.path, "."}"
fn TokenText (KFamily p) = "{Join p, "."}.*"
fn TokenText (KTrait p) = "^{Join p, "."}"
fn TokenText (KKw w, s) = "{s}{w}"
fn TokenText (KFree s) = "free{s}"
fn TokenText KLensDot = "&."
fn TokenText (KInt s, t) = "{s}{t}"
fn TokenText (KFloat s, t) = "{s}{t}"
fn TokenText (KDuration s, t, u) = "{s}{t}{u}"
fn TokenText (KChar s, c) = "{s}{DebugChar c}"
fn TokenText (KText s, segs) = "{s}TEXT({Concat (Each segs, SegText)})"
fn TokenText (KTemplate t) = "TEMPLATE<{t.lang}>({Concat (Each t.parts, PartText)})"
fn TokenText (KOp op, True) = "{op}pre"
fn TokenText (KOp op, False) = op
fn TokenText (KSuffixed op, ty) = "{op}{Join ty, "."}"
fn TokenText (KDot True) = ".pre"
fn TokenText (KDot False) = "."
fn TokenText KDotDot = ".."
fn TokenText KComma = ","
fn TokenText KColon = ":"
fn TokenText KSemi = ";"
fn TokenText KBackslash = "\\"
fn TokenText (KLambdaBar ignore) = "|"
fn TokenText KBar = "|"
fn TokenText KLtLt = "<<"
fn TokenText KGtGt = ">>"
fn TokenText (KOpen k, ignore) = k
fn TokenText (KClose k) = CloseChar k
fn TokenText KAbsent = "absent"
fn TokenText KNonEmpty = "nonempty"
fn TokenText (KPath segs) = "PATH({Join (Each segs, PathSegText), "/"})"
fn TokenText KLayOpen = "open"
fn TokenText KLaySep = "sep"
fn TokenText KLayClose = "close"
fn TokenText KEof = "eof"

SegText: fn TextSegTok -> Text
fn SegText (TsPlain p) = EscapeBraces (EscapeDebug p, True, True)
fn SegText (TsPlaceholder toks, ignore) = "\{{RenderInner toks}\}"

EscapeBraces: fn Text -> Text
fn EscapeBraces t = Concat (Each (Chars t), \|c| if c == "\{" or c == "\}": "\\{c}" else: c)

PathSegText: fn PathSegTok -> Text
fn PathSegText (PstNum n) = "{n}"
fn PathSegText (PstGen n) = "#{n}"
fn PathSegText (PstKey toks) = "[{RenderInner toks}]"

PartText: fn TPartTok -> Text
fn PartText (TptText t) = DebugText t
fn PartText (TptPlaceholder toks, ?col, ignore) = "\{\{{RenderInner toks}\}\}{ColText ?col}"
fn PartText (TptBlock toks, ignore) = "BLOCK\{ {RenderInner toks} \}"
fn PartText (TptCall name, attrs, ?body, ignore) = "<{name.sigils}{Join name.path, "."}{Concat (Each attrs, AttrText)}{CallBody name, ?body}"

ColText: fn ?Nat -> Text
fn ColText nil = ""
fn ColText (? c) = "@col{c}"

AttrText: fn AttrTok -> Text
fn AttrText a = " {a.name}=\{{RenderInner a.tokens}\}"

CallBody: fn NameTok, ?[TPartTok] -> Text
fn CallBody ignore, nil = "/>"
fn CallBody name, (? parts) = ">{Concat (Each parts, PartText)}</{name.sigils}{Join name.path, "."}>"

# ---------------------------------------------------------------------------------------
# Rust's `{:?}` and `escape_debug` for texts and characters, which both printers use
# ---------------------------------------------------------------------------------------

# A text as Rust's `{:?}` prints it: in double quotes, a double quote escaped.
DebugText: fn Text -> Text
fn DebugText t = "\"{EscapeDebug t, False, True}\""

# A character as Rust's `{:?}` prints it: in single quotes, a single quote escaped.
DebugChar: fn Text -> Text
fn DebugChar c = "'{EscapeDebug c, True, False}'"

EscapeDebug: fn Text, Bool, Bool -> Text
fn EscapeDebug t, single, double = Concat (Each (Chars t), \|c| EscapeChar c, single, double)

EscapeChar: fn Text, Bool, Bool -> Text
fn EscapeChar c, single, double = match c:
    "\u{0}": "\\0"
    "\t": "\\t"
    "\u{d}": "\\r"
    "\n": "\\n"
    "\\": "\\\\"
    "'" if single: "\\'"
    "\"" if double: "\\\""
    ignore if c < " " or c == "\u{7f}": "\\u\{{HexOf (CodeOf c)}\}"
    otherwise: c

# The code point of an ASCII character.
CodeOf: fn Text -> Nat
fn CodeOf c = update 0:
    let &fuel = Len asciiTable
    while ? left <- &fuel -? 1:
        &fuel <= left
        match asciiTable[&_]:
            ? a if a != c: &_ += 1
            otherwise: &fuel <= 0

HexOf: fn Nat -> Text
fn HexOf n = HexDigits n, n

# `n` in hexadecimal; `fuel`, at least its number of digits, shrinks on every call.
HexDigits: fn Nat, Nat -> Text
fn HexDigits n, fuel = match fuel -? 1:
    ? left if n >= 16: "{HexDigits (Or (?Div n, 16), 0), left}{Or hexDigits[Or (?Mod n, 16), 0], "0"}"
    otherwise: Or hexDigits[n], "0"
