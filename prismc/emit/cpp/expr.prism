# `Emit.Cpp.Expr`, a child module of `Emit.Cpp`.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit r
use Emit.Cpp.*
use Emit.Cpp.Patterns.*
use Emit.Cpp.Stmts.*
use Emit.Cpp.Items.*
use Emit.Cpp.Program.*
use Syntax.Lexer.*
use Syntax.Lexer.Chars.*
use Syntax.Lexer.Layout.*
use Syntax.Lexer.Words.*
use Syntax.Lexer.Literals.*
use Syntax.Lexer.Templates.*
use Syntax.Lexer.Corpus.*
use Check.Errors.*
use Lower.*
use Lower.Types.*
use Lower.Expr.*
use Lower.Patterns.*
use Lower.Templates.*
use Lower.Functions.*
use Lower.Jobs.*
use Lower.Program.*
use Lower.Model.*
use Lower.Node.*
use Lower.Node.Def.*
use Lower.Node.Elements.*
use Lower.Node.Static.*
use Lower.Node.Dynamics.*
use Lower.Node.Finish.*
use Lower.Node.Keyed.*
use Lower.Node.Switch.*
use Emit.Cpp.Templates.*
use Emit.Cpp.Templates.Items.*
use Emit.Cpp.Prelude.*

# ---------------------------------------------------------------------------------------
# Expressions
# ---------------------------------------------------------------------------------------

# Whether an expression must be parenthesized as an operand or a receiver.
CppLoose: fn Ex -> Bool
fn CppLoose x = match x:
    XBlock [[]], inner: CppLoose inner
    XBin ignore, ignore, ignore: True
    XUnary ignore, ignore: True
    XIf ignore, ignore, ignore: True
    XRef y: CppLoose y
    XRefMut y: CppLoose y
    XClone y: CppLoose y
    otherwise: False

CppTight: unbounded fn Cp, Ex -> Text
fn CppTight cp, x = if CppLoose x: "({CppExpr cp, x})" else: Starred (CppExpr cp, x)

# A `*x` as an operand or a receiver, parenthesized (`(*x).f`, where `*x.f` is `*(x.f)`).
Starred: fn Text -> Text
fn Starred t = if HasPrefix t, "*": "({t})" else: t

# A receiver or an operand of `&`, `*`, `.clone()`: a place, which no read moves from.
CppTightPlace: unbounded fn Cp, Ex -> Text
fn CppTightPlace cp, x = if CppLoose x: "({CppPlace cp, x})" else: Starred (CppPlace cp, x)

# An expression as a place: a local by its name, where a value position would move it
# (pick MV); anything else as the expression it is.
CppPlace: unbounded fn Cp, Ex -> Text
fn CppPlace cp, (XVar n) = VarName cp, n
fn CppPlace cp, x = CppExpr cp, x

# A local read as a value: moved when the scope holds it by value (`owned`, pick MV): the
# model writes `XClone` wherever Rust copies, so a bare read is Rust's move, the last read.
CppVar: fn Cp, Text -> Text
fn CppVar cp, n = if Or cp.owned[n], False: "::std::move({VarName cp, n})" else: VarName cp, n

# Arguments evaluated in no fixed order (a call's, a record's initializers after pick NC's
# reordering, `cat`'s): a local moved by one is left a place when another argument reads
# it, since Rust evaluated that read first and C++ may not (pick MV).
CppArgs: unbounded fn Cp, [Ex] -> Text
fn CppArgs cp, xs = Join (CppArgList cp, xs), ", "

CppArgList: unbounded fn Cp, [Ex] -> [Text]
fn CppArgList cp, xs:
    let texts = Each xs, \|x| CppExpr cp, x
    Each (Range0 (Len xs)), \|i| match Or xs[i], XUnit:
        XVar n: if Fold (Range0 (Len xs)), False, \|f, j| f or (j != i and ExReads (Or xs[j], XUnit), n): VarName cp, n else: Or texts[i], ""
        otherwise: Or texts[i], ""

CppExpr: unbounded fn Cp, Ex -> Text
fn CppExpr cp, x = match x:
    XVar n: CppVar cp, n
    XPath p: PathValue cp, p
    XSelf: "::prism_rtl::share(this)"
    XCx: "cx"
    XConst n: n
    XUnit: "crate::prelude::Unit\{\}"
    XNone: "::std::nullopt"
    XBool b: if b: "true" else: "false"
    XNat d: if (Len d) <= 9: "crate::prelude::Nat({d}u)" else: "*crate::prelude::Nat::from_int({CppExpr cp, (XInt d)})"
    XInt d: if (Len (if (HasPrefix d, "-"): AfterFirst d else: d)) <= 18: "crate::prelude::Int({d}ll)" else: "*crate::prelude::Int::parse(\"{d}\")"
    XByte d: "::std::uint8_t({d})"
    XFloat d: "crate::prelude::Float\{{d}\}"
    XIndex n: "{n}u"
    XChar c: "U'{CppCharEscape c}'"
    XStr t: CppString t
    # One literal, one compiled regex: a function-local static of the literal's own lambda,
    # built on its first call (thread-safe since C++11) and alive until exit; each use
    # copies it, which counts a reference.
    XRegex p, f: "([]() -> const crate::prelude::Regex& \{ static const crate::prelude::Regex r = crate::prelude::Regex::lit({CppString p}, {CppString f}); return r; \}())"
    XReplacement p, r, f: "([]() -> const crate::prelude::RegexReplacement& \{ static const crate::prelude::RegexReplacement r = crate::prelude::RegexReplacement::lit({CppString p}, {CppString f}, {CppString r}); return r; \}())"
    # `&x` and `x.clone()` are the value itself (a reference is `const T&`, a copy shares);
    # `*x` is the value behind an `Rc` (a recursive payload), or the place itself when `x`
    # is a reference (Rust's `*` of one), by `x`'s type where the printer knows it, else
    # through `::prism_rtl::deref`, which tells the two apart by overload (pick PT)
    XRef y: CppPlace cp, y
    XRefMut y: CppPlace cp, y
    XDeref y: match ?ExTy cp, y:
        ? (OutRc ignore): "*{CppTightPlace cp, y}"
        ? (OutRef ignore): CppPlace cp, y
        otherwise: "::prism_rtl::deref({CppPlace cp, y})"
    XTarget y: CppPlace cp, y
    XClone y: CppPlace cp, y
    XWeak y: "::prism_rtl::weaken({CppExpr cp, y})"
    XUpgrade y: "::prism_rtl::upgrade({CppExpr cp, y})"
    XBreak l, y: "({CppBreak cp, l, y})"
    XBreakLoop: "(\{ break; \})"
    XLater y: "[=](crate::prelude::Cx& cx) -> crate::prelude::Done \{ {CppExpr (Captured cp), y}; return \{\}; \}"
    XFormatStr parts: CppFormat cp, parts, "::prism_rtl::str"
    XIsCase y, [[]]: "false"
    XIsCase y, cs: "({Join (Each cs, \|c| CaseTest cp, c, (CppTightPlace cp, y)), " || "})"
    XRefusal what: "compile_error!(\"{loweringRefusal}{Escape what}\")"
    XUnreachable: "throw ::prism_rtl::Panic(\"entered unreachable code\")"
    XCall f, args: CppCall cp, f, args
    XCallAt f, tys, args: "{FreeCallPath cp, f}<{CppTypes cp, tys}>({CppArgs cp, args})"
    XCallSelf tr, m, self, args: "{FreeCallPath cp, tr}::{CppId m}_at<{CppType cp, self}>::call({CppArgs cp, args})"
    XApply f, args: "{CppTightPlace cp, f}({CppArgs cp, args})"
    XMethod r, m, args: CppMethod cp, r, m, args
    XBin op, l, r:
        let ((lt, rt)) = match CppArgList cp, [[l, r]]:
            [[a, b]]: ((a, b))
            otherwise: (("", ""))
        "{if CppLoose l: "({lt})" else: lt} {BinOpText op} {if CppLoose r: "({rt})" else: rt}"
    XUnary op, y: "{UnOpText op}{CppTight cp, y}"
    XCtor p, args: CppCtor cp, p, args
    XRecord p, fs: CppRecord cp, p, fs
    XTuple xs: "::std::tuple\{{CppArgs cp, xs}\}"
    XVec [[]]: "\{\}"
    XVec xs: "::std::vector\{{CppArgs cp, xs}\}"
    XText t: "crate::prelude::Text::lit({CppString t})"
    XFormat parts: if Fold parts, True, \|f, p| f and IsTextPiece p: "crate::prelude::Text::lit({CppString (Concat (Each parts, \|p| TextPiece p))})" else: CppFormat cp, parts, "::prism_rtl::cat"
    XMatch s, arms, fallback, t: CppMatch cp, s, arms, t
    XChain label, s, arms, t: CppMatch cp, s, arms, t
    XIf c, t, e: CppIf cp, c, t, e
    XBlock [[]], e: CppExpr cp, e
    XBlock dos, e:
        let ((st, cp2)) = CppStatementsCp cp, dos
        StmtExpr st, (Unvexed (CppExpr (WithMoveCaptures cp2, dos, e), e))
    XLabeled label, dos, e, t: CppLabeled cp, label, dos, e, t
    XClosure mv, ps, body: CppClosure cp, mv, ps, body
    XTry y: "TRY({CppExpr cp, y})"
    XField r, f: CppField cp, r, f
    XFieldOf r, ignore, f: CppFieldOf cp, r, f
    XPart r, k: "::std::get<{k}>({AsValue cp, r})"
    XDecode t, y: "TRY(::prism_rtl::from_pod<{CppType cp, t}>({CppExpr cp, y}))"
    XCast y, t: "static_cast<{CppType cp, t}>({CppExpr cp, y})"
    # a generic choice's case through its type, which may depend on a type parameter
    # (`typename`, allowed before any qualified name)
    XTyped y, t: match y:
        XCtor p, args if IsGenericCase cp, p:
            let tt = CppType cp, t
            "{tt}(typename {tt}::{CaseIdOf p}\{{CppArgs cp, args}\})"
        XPath p if IsGenericCase cp, p:
            let tt = CppType cp, t
            "{tt}(typename {tt}::{CaseIdOf p}\{\})"
        # a generic record at its type: never deduced from its fields
        XRecord p, fs: CppRecordAs cp, p, fs, (CppType cp, t)
        otherwise:
            let e = CppExpr cp, y
            if e == "\{\}" or e == "::std::nullopt": "{CppType cp, t}\{\}"
            else: if (IsCtor y, "Ok") or (IsCtor y, "Err") or IsCtor y, "Some": "{CppType cp, t}({e})"
            else: e

# A string literal: a NUL as `\000` (an octal escape takes three digits at most), and the
# literal a `std::string_view` (`""sv`) when it holds one, which a `const char*` would end.
CppString: fn Text -> Text
fn CppString t = if Contains t, "\u{0}": "\"{CppEscape t}\"sv" else: "\"{CppEscape t}\""

CppEscape: fn Text -> Text
fn CppEscape t = MapChars t, \|c| if c == "\u{0}": "\\000" else: CharEscape c

IsTextPiece: fn Ex -> Bool
fn IsTextPiece (XText ignore) = True
fn IsTextPiece other = False

TextPiece: fn Ex -> Text
fn TextPiece (XText t) = t
fn TextPiece other = ""

# `format!(..)` as `str(..)` (a message) or `cat(..)` (a `Text`): the pieces in order.
CppFormat: unbounded fn Cp, [Ex], Text -> Text
fn CppFormat cp, parts, how = "{how}({Join (CppArgList cp, (Each parts, \|p| FormatArg p)), ", "})"

# A format's literal run as a string literal, which `cat` and `str` take as it is.
FormatArg: fn Ex -> Ex
fn FormatArg (XText t) = XStr t
fn FormatArg x = x

CppCharEscape: fn Text -> Text
fn CppCharEscape "'" = "\\'"
fn CppCharEscape c = CharEscape c

# A path as a value: a unit constructor, or a function.
PathValue: fn Cp, Ref -> Text
fn PathValue cp, p = if IsNodeMethod cp, p: "&{TypePath (RefSpelled (RefParent p))}::{NodeMethodName cp, (RefLast p)}" else: match ?CaseOf cp, p:
    ? ty: "{OwnTypePath cp, ty}({OwnTypePath cp, p}\{\})"
    nil: match ?TypeOf cp, p:
        ? info: if info.kind == "unit": "{OwnTypePath cp, p}\{\}" else: OwnTypePath cp, p
        nil: match p:
            RefRuntime t: TypePath (RuntimePath t)
            otherwise: TypePath (RefSpelled p)

# A node's method by its path (`Host::host_1_answer`), a member function as a value.
IsNodeMethod: fn Cp, Ref -> Bool
fn IsNodeMethod cp, p = match p:
    RefItem ignore, ignore, ignore:
        let named = match cp.methods[RefLast p]:
            ? ignore: True
            nil: False
        named and IsNodeType cp, (RefParent p)
    otherwise: False

IsNodeType: fn Cp, Ref -> Bool
fn IsNodeType cp, p = match ?TypeOf cp, p:
    ? info: info.kind == "node"
    nil: False

# A field: a node's member through its pointer, a value's directly; `self`'s through
# `this`; a tuple struct's `0` its `a0`. A receiver whose type the printer does not know may
# be an `Rc` of a value (Rust reaches a payload's fields through the `Rc` unwritten):
# `deref` gives the value behind one, or the receiver itself. An `XField` names a member
# lowering or the runtime defines (a program's value type's field is an `XFieldOf`): a
# node's, reached through the node's pointer, or a runtime value's (`updates`), which the
# names of the nodes' members (`members`, lowering's own names) tell apart.
CppField: unbounded fn Cp, Ex, Text -> Text
fn CppField cp, XSelf, f = "this->{FieldId f}"
fn CppField cp, r, f:
    let name = if IsDigits f: "a{f}" else: FieldId f
    # by the receiver's type where it is known, else by whether some node has the member
    match ?Pointer cp, r:
        ? b: "{CppTightPlace cp, r}{if b: "->" else: "."}{name}"
        nil: match cp.members[f]:
            ? ignore: "{CppTightPlace cp, r}->{name}"
            nil: "{AsValue cp, r}.{name}"

# A field of a program's value type: on the value, through a pointer where the receiver is
# one.
CppFieldOf: unbounded fn Cp, Ex, Text -> Text
fn CppFieldOf cp, r, f:
    let name = if IsDigits f: "a{f}" else: FieldId f
    match ?Pointer cp, r:
        ? b: "{CppTightPlace cp, r}{if b: "->" else: "."}{name}"
        nil: "{AsValue cp, r}.{name}"

# A receiver as a value: itself where the printer knows it is one, else through `deref`,
# in case it is an `Rc`.
AsValue: unbounded fn Cp, Ex -> Text
fn AsValue cp, r = match ?Pointer cp, r:
    ? False: CppTightPlace cp, r
    otherwise: "::prism_rtl::deref({CppPlace cp, r})"

# The model's type of an expression, where the printer knows it: a local the scope typed
# (`localTypes`), a field of the node or job being printed, and a `*` or `&` of one.
?ExTy: fn Cp, Ex -> ?OutTy
fn ?ExTy cp, x = match x:
    XVar n: cp.localTypes[n]
    XField XSelf, f: cp.fields[f]
    XField (XVar "node"), f: cp.fields[f]
    XRef y: match ?ExTy cp, y:
        ? t: ? (OutRef t)
        nil: nil
    XDeref y: match ?ExTy cp, y:
        ? (OutRef t): ? t
        ? (OutRc t): ? t
        otherwise: nil
    otherwise: nil

IsDigits: fn Text -> Bool
fn IsDigits t = t != "" and FoldChars t, True, \|ok, c| ok and Contains "0123456789", c

# A constructor: a choice's case moved into the choice, a newtype's or unit type's value, the
# runtime's cases by their C++ names.
CppCtor: unbounded fn Cp, Ref, [Ex] -> Text
fn CppCtor cp, r, args = match r:
    RefRuntime t: match Bare t:
        "Some": "::std::optional({CppArgs cp, args})"
        "Ok": if args == [[XUnit]]: "::prism_rtl::ok()" else: CppArgs cp, args
        "Err": "crate::prelude::unexpected({CppArgs cp, args})"
        "prism_rtl::Turn::More": "::prism_rtl::more({CppArgs cp, args})"
        "prism_rtl::Turn::Finished": "::prism_rtl::finished({CppArgs cp, args})"
        "Outcome::Fired": "crate::prelude::Outcome::fired({CppArgs cp, args})"
        "Outcome::Value": "crate::prelude::Outcome::value({CppArgs cp, args})"
        "Segment::Pos": "crate::prelude::Segment::pos({CppArgs cp, args})"
        "Segment::Gen": "crate::prelude::Segment::gen({CppArgs cp, args})"
        "Segment::Key": "crate::prelude::Segment::key({CppArgs cp, args})"
        # a runtime struct (`crate::prelude::Path`) by its fields
        otherwise: "{TypePath (RuntimePath t)}\{{CppArgs cp, args}\}"
    otherwise: match ?CaseOf cp, r:
        ? ty: "{OwnTypePath cp, ty}({OwnTypePath cp, r}\{{CppArgs cp, args}\})"
        nil: match ?TypeOf cp, r:
            ? ignore: "{OwnTypePath cp, r}\{{CppArgs cp, args}\}"
            nil: PrinterRefusal "a constructor of no type it knows ({RefSpelled r})"

# A record: its fields in the order declared (designated initializers); a job's by its
# constructor.
CppRecord: unbounded fn Cp, Ref, [((Text, Ex))] -> Text
fn CppRecord cp, p, fs = CppRecordAs cp, p, fs, (OwnTypePath cp, p)

# A record by its fields, its type spelled `head`.
CppRecordAs: unbounded fn Cp, Ref, [((Text, Ex))], Text -> Text
fn CppRecordAs cp, p, fs, head = match ?TypeOf cp, p:
    ? info:
        let ordered = Each info.fields, \|f| Or (Fold fs, nil, \|?found, ((g, v))| if g == f: ? v else: ?found), XUnit
        let values = CppArgList cp, ordered
        if info.kind == "job": "{TypePath (RefSpelled p)}({Join values, ", "})"
        else: "{head}\{{Join (Each (Range0 (Len info.fields)), \|i| ".{FieldId (Or info.fields[i], "")} = {Or values[i], ""}"), ", "}\}"
    nil: PrinterRefusal "a record of no type it knows ({RefSpelled p})"

# A call of a named function: the runtime's and the prelude code's functions by their C++
# names (`Hold::new` is `Hold(..)`, matched by their spelling: the program has no item
# behind them), anything else by its path.
CppCall: unbounded fn Cp, Ref, [Ex] -> Text
fn CppCall cp, f, args:
    let a = CppArgs cp, args
    let runtimeName = match f:
        RefRuntime t: Bare t
        RefItem "prelude", p, ignore: p
        otherwise: ""
    match runtimeName:
        "Rc::new": if a == "\{\}": "::prism_rtl::make_new()" else: "::prism_rtl::rc({a})"
        "is_some": "::prism_rtl::is_some({a})"
        "is_none": "::prism_rtl::is_none({a})"
        "RefCell::new": a
        "Cell::new": a
        "Hold::new": "\{{a}\}"
        "Snapshot::new": "crate::prelude::snapshot({a})"
        "Path::root": "crate::prelude::Path::root()"
        "Fault::answer": "crate::prelude::Fault::answer({a})"
        "Fault::too_deep": "crate::prelude::Fault::too_deep({a})"
        "Error::new": "crate::prelude::Error({a})"
        "Text::from": "crate::prelude::Text({a})"
        "String::new": "::std::string()"
        "Array::from": "crate::prelude::Array({a})"
        "prism_rtl::Dynamic::of": "::prism_rtl::dynamic_of({a})"
        "Dynamic::of": "::prism_rtl::dynamic_of({a})"
        "prism_rtl::Event::of": "::prism_rtl::event_of({a})"
        "prism_rtl::Host::new": "crate::prelude::host_new({a})"
        "prism_rtl::Entry::new": "crate::prelude::entry_new({a})"
        "prism_rtl::forward_on_none": "::prism_rtl::forward_on_none<crate::Elem, crate::Answer>({a})"
        "Event::never": "::prism_rtl::never_event()"
        otherwise: if IsFresh f: "\{\}" else: "{FreeCallPath cp, f}({a})"

# A function's path where a node's member of the same name would hide it: qualified, a
# program's from its module.
FreeCallPath: fn Cp, Ref -> Text
fn FreeCallPath cp, f:
    let p = CallPath cp, f
    let hidden = match cp.members[RefSpelled f]:
        ? ignore: True
        nil: (InList stdNames, p) or InList cp.mods, p
    if Contains p, ":": p
    else: if hidden: QualifiedCall f, p
    else: p

QualifiedCall: fn Ref, Text -> Text
fn QualifiedCall (RefItem m, ignore, ignore), p = "crate::{m}::{p}"
fn QualifiedCall (RefRuntime ignore), p = p

# The standard library's functions a call by argument-dependent lookup may find instead of
# the program's or the prelude's of the same name (an argument of a `std` type).
let stdNames = [["apply", "begin", "end", "size", "empty", "data", "get", "swap", "move", "forward", "find", "count", "copy", "fill", "sort", "min", "max", "visit", "invoke", "merge", "remove", "replace", "reverse", "unique", "transform", "accumulate", "distance", "next", "prev", "exchange", "tie", "to_string", "clamp", "partition", "equal", "mismatch", "erase", "search", "rotate"]]

# The runtime's constructors of an empty value, whose type the context gives.
IsFresh: fn Ref -> Bool
fn IsFresh (RefRuntime f) = InList [["rt::Stamped::new", "rt::Cache::new", "rt::Port::new", "rt::Map::new", "rt::Array::new", "std::Vec::new", "std::Default::default", "rt::Wakes::default", "rt::Defer::new", "prism_rtl::HostDoc::new", "prism_rtl::Watch::new", "prism_rtl::PerKey::new"]], f
fn IsFresh other = False

# A function's path: a node's constructor is `make` (`build` is the C++ runtime's virtual
# build-list method), a runtime type's `new` its constructor, the rest as written.
CallPath: fn Cp, Ref -> Text
fn CallPath cp, f = match f:
    RefItem ignore, ignore, s: if (RefLast f) == "build" and IsNodeType cp, (RefParent f): "{TypePath (RefSpelled (RefParent f))}::make" else: CppPathId (TypePath s)
    RefRuntime t: if (LastSegment t) == "new": TypePath (RuntimePath (ParentPath t)) else: CppPathId (TypePath (RuntimePath t))

# A method call through the table of the Rust runtime's methods, a node's member through
# its pointer, anything else as a member.
CppMethod: unbounded fn Cp, Ex, Text, [Ex] -> Text
fn CppMethod cp, r, m, args:
    let recv = if r == XSelf: "this" else: CppTightPlace cp, r
    let a = CppArgs cp, args
    let n = Len args
    let sep = if n == 0: "" else: ", "
    match MethodForm m, n:
        "id": recv
        "deref": match ?Pointer cp, r:
            ? b: if b: "(*{recv})" else: recv
            nil: recv
        "assign": "{recv} = {a}"
        "take": "::std::exchange({recv}, \{\})"
        "free": "{FreeName m}({recv}{sep}{a})"
        "arrow":
            let through = match ?Pointer cp, r:
                ? b: if b: "->" else: "."
                nil: "->"
            "{recv}{through}{MemberName m}({a})"
        "exchange": "::std::exchange({recv}, {a})"
        otherwise:
            let through = match ?Pointer cp, r:
                ? b: if b: "->" else: "."
                nil: match cp.members[m]:
                    ? ignore: "->"
                    nil: "."
            "{recv}{through}{NodeMethodName cp, m}({a})"

# A node's method: a C++ class cannot have a field and a method of one name, so a method
# named as some node's field takes a `_` after it.
NodeMethodName: fn Cp, Text -> Text
fn NodeMethodName cp, m = match ((cp.methods[m], cp.fieldNames[m])):
    ((? ignore, ? ignore)): "{CppId m}_"
    otherwise: MemberName m

# Whether a receiver is reached through a pointer, where the model says: `self`, a field
# of the node or job being printed by its type; a place's path (a node's `path`, the
# `path` a node is made at), the root path and a path
# made from one by the runtime's `at`, `child` and `join`, which are values (a node's
# member of one of those names says nothing about a path).
?Pointer: fn Cp, Ex -> ?Bool
fn ?Pointer cp, r = match r:
    XSelf: ? True
    XCx: ? False
    XVar "path": ? False
    XField ignore, "path": ? False
    XCall (RefRuntime "rt::Path::root"), ignore: ? False
    XMethod y, m, ignore if m == "at" or m == "child" or m == "join": match ?Pointer cp, y:
        ? False: ? False
        otherwise: nil
    XVar n: cp.pointers[n]
    XClone y: ?Pointer cp, y
    XRef y: ?Pointer cp, y
    XDeref y: match ?ExTy cp, r:
        ? t: ? (IsPointerTy cp, (Unref t))
        nil: nil
    XField XSelf, f: match cp.fields[f]:
        ? t: ? (IsPointerTy cp, t)
        nil: nil
    XField (XVar "node"), f: match cp.fields[f]:
        ? t: ? (IsPointerTy cp, t)
        nil: nil
    otherwise: nil

# Whether a type's members are reached by `->`: a shared pointer's, an `Rc` of a value's
# among them (pick PT).
IsPointerTy: fn Cp, OutTy -> Bool
fn IsPointerTy cp, t = match t:
    OutNamed (RefRuntime "prism_rtl::Rows"), ignore: True
    OutPort ignore: False
    OutRc ignore: True
    OutObj ignore: True
    OutJob ignore: True
    OutShowAny: True
    otherwise: False

# How a method of the Rust runtime is spelled: `id` the receiver itself (a `RefCell`'s
# borrow), `assign` (a `Cell`'s `set`), `take` (`Option::take`), `free` a function of the
# C++ runtime taking the receiver first, `arrow` a member through a shared pointer, `dot` a
# member.
MethodForm: fn Text, Nat -> Text
fn MethodForm m, n = match ((m, n)):
    (("borrow", 0)): "deref"
    (("borrow_mut", 0)): "deref"
    (("clone", 0)): "id"
    (("iter", 0)): "id"
    (("collect", 0)): "id"
    (("unwrap_or_default", 0)): "free"
    (("for_each", 1)): "free"
    (("into_iter", 0)): "id"
    (("as_ref", 0)): "id"
    (("get", 0)): "id"
    (("set", 1)): "assign"
    (("take", 0)): "take"
    (("replace", 1)): "exchange"
    (("values", 0)): "free"
    (("keys", 0)): "free"
    (("enumerate", 0)): "free"
    (("fire", 2)): "arrow"
    (("subscribe", 1)): "arrow"
    (("unsubscribe", 1)): "arrow"
    (("cycle", 0)): "arrow"
    (("upgrade", 0)): "free"
    (("expect", 1)): "free"
    (("to_pod", 0)): "free"
    (("cloned", 0)): "free"
    (("ok", 0)): "free"
    (("ok_or", 1)): "free"
    (("map", 1)): "free"
    (("iter_mut", 0)): "free"
    (("to_vec", 0)): "free"
    (("filter_some", 0)): "free"
    otherwise: "dot"

FreeName: fn Text -> Text
fn FreeName m = match m:
    "to_pod": "::prism_rtl::to_pod"
    "ok": "::prism_rtl::ignore"
    "map": "::prism_rtl::fmap"
    "ok_or": "::prism_rtl::ok_or"
    "to_vec": "::prism_rtl::path_of"
    "values": "crate::prelude::values"
    "keys": "crate::prelude::keys"
    "enumerate": "::prism_rtl::enumerate"
    "unwrap_or_default": "::prism_rtl::unwrap_or_default"
    "for_each": "::prism_rtl::for_each"
    otherwise: "crate::prelude::{m}"

MemberName: fn Text -> Text
fn MemberName m = match m:
    "push_str": "append"
    "len": "size"
    "is_empty": "empty"
    "push": "push_back"
    "contains_key": "contains"
    "build": "make"
    otherwise: CppId m

# The test of a constructor against a value, as a C++ condition: the runtime's by their
# spelling, a choice's case by its type, a newtype's or unit type's (its one case) always.
CaseTest: fn Cp, Ref, Text -> Text
fn CaseTest cp, c, v = match c:
    RefRuntime t: match Bare t:
        "Some": "::prism_rtl::is_some({v})"
        "None": "::prism_rtl::is_none({v})"
        "Ok": "::prism_rtl::is_ok({v})"
        "Err": "::prism_rtl::is_err({v})"
        "prism_rtl::Turn::More": "{v}.if_more()"
        "prism_rtl::Turn::Finished": "{v}.if_finished()"
        otherwise: "::prism_rtl::is<{CaseType t}>({v})"
    otherwise: match ?CaseOf cp, c:
        ? ignore: "::prism_rtl::is<{CaseTypeOf cp, c, v}>({v})"
        nil: match ?TypeOf cp, c:
            ? ignore: "true"
            nil: PrinterRefusal "a pattern of no type it knows ({RefSpelled c})"

# A runtime constructor's pattern tag.
CaseType: fn Text -> Text
fn CaseType c = match Bare c:
    "Segment::Pos": "crate::prelude::pat::Pos"
    "Segment::Gen": "crate::prelude::pat::Gen"
    "Segment::Key": "crate::prelude::pat::Key"
    otherwise: PrinterRefusal "a pattern of the runtime's {c}, which it has no case of"

# A choice's case as tested against the value `v`: a generic choice's case by the value's
# own type, whose arguments the path does not write (`Tree::Leaf` of a `Tree<A>`).
CaseTypeOf: fn Cp, Ref, Text -> Text
fn CaseTypeOf cp, c, v = if IsGenericCase cp, c: "typename ::std::remove_cvref_t<decltype({v})>::{CaseIdOf c}" else: OwnTypePath cp, c

# Whether a constructor is a case of a choice with type parameters.
IsGenericCase: fn Cp, Ref -> Bool
fn IsGenericCase cp, p = match ?CaseOf cp, p:
    ? ty: match ?TypeOf cp, ty:
        ? info: (Len info.params) > 0
        nil: False
    nil: False

# The payload of a constructor's field `i` in a value.
Payload: fn Cp, Ref, Text, Nat -> Text
fn Payload cp, c, v, i = match c:
    RefRuntime t: match Bare t:
        "Some": "::prism_rtl::some_of({v})"
        "Ok": "*{v}"
        "Err": "{v}.error()"
        "prism_rtl::Turn::More": "{v}.if_more()->next"
        "prism_rtl::Turn::Finished": "{v}.if_finished()->value"
        otherwise: "::prism_rtl::as<{CaseType t}>({v}).a{i}"
    otherwise: match ?CaseOf cp, c:
        ? ignore: "::prism_rtl::as<{CaseTypeOf cp, c, v}>({v}).a{i}"
        nil: "{v}.a{i}"

# `if`: a conditional expression.
CppIf: unbounded fn Cp, Ex, Ex, Ex -> Text
fn CppIf cp, c, t, e:
    let ct = CppExpr cp, c
    let ?err = match ((?ErrOf t, ?ErrOf e)):
        ((? y, ignore)): ? y
        ((nil, ? y)): ? y
        otherwise: nil
    let tt = match ?err:
        ? y: OkBranch cp, t, y
        nil: CppExpr cp, t
    let et = match ?err:
        ? y: OkBranch cp, e, y
        nil: CppExpr cp, e
    let short = not (Contains "{tt}{et}", "\n") and (Len "{ct}{tt}{et}") < 70
    if short: "{ct} ? {tt} : {et}" else: CondExpr ct, tt, et

# The context for a block's value: the block's `let`s that only the bodies of move closures
# in the value read are the closures' to move (`CppClosure`); a `let` any other part of the
# value reads stays, since C++ fixes no order between a call's arguments.
WithMoveCaptures: unbounded fn Cp, [Do], Ex -> Cp
fn WithMoveCaptures cp, dos, e:
    # each name once: a `let` that rebinds a name a `let` before it bound (`let name =
    # name.clone()`) is the one the tail reads, under its rename (pick RN)
    let lets = Fold dos, [[]], \|acc, d| match d:
        DoLet p, ignore: match ?LetName p:
            ? n: if InList acc, n: acc else: Push acc, n
            nil: acc
        otherwise: acc
    if (Len lets) == 0: update cp:
        &_.moveCaptures <= [[]]
    else:
        let ((reads, hasMove)) = ReadsOf e, False, (([[]], False))
        update cp:
            &_.moveCaptures <= if hasMove: Filter lets, \|n| not (InList reads, n) else: [[]]

# The locals an expression reads, with (`into`) or without those read inside the bodies
# of its move closures, and whether it holds a move closure.
ReadsOf: unbounded fn Ex, Bool, (([Text], Bool)) -> (([Text], Bool))
fn ReadsOf x, into, acc:
    let ((reads, hasMove)) = acc
    match x:
        XVar n: (((Push reads, n), hasMove))
        XClosure True, ps, body: if into: ReadsOf body, into, ((reads, True)) else: ((reads, True))
        XClosure False, ps, body: ReadsOf body, into, acc
        XRef y: ReadsOf y, into, acc
        XRefMut y: ReadsOf y, into, acc
        XDeref y: ReadsOf y, into, acc
        XTarget y: ReadsOf y, into, acc
        XClone y: ReadsOf y, into, acc
        XWeak y: ReadsOf y, into, acc
        XUpgrade y: ReadsOf y, into, acc
        XBreak ignore, y: ReadsOf y, into, acc
        XLater y: ReadsOf y, into, acc
        XFormatStr xs: ReadsEach xs, into, acc
        XIsCase y, ignore: ReadsOf y, into, acc
        XCall ignore, xs: ReadsEach xs, into, acc
        XCallAt ignore, ignore, xs: ReadsEach xs, into, acc
        XCallSelf ignore, ignore, ignore, xs: ReadsEach xs, into, acc
        XApply f, xs: ReadsEach (Append [[f]], xs), into, acc
        XMethod r, ignore, xs: ReadsEach (Append [[r]], xs), into, acc
        XBin ignore, l, r: ReadsEach [[l, r]], into, acc
        XUnary ignore, y: ReadsOf y, into, acc
        XCtor ignore, xs: ReadsEach xs, into, acc
        XRecord ignore, fs: ReadsEach (Each fs, \|((ignore, v))| v), into, acc
        XTuple xs: ReadsEach xs, into, acc
        XVec xs: ReadsEach xs, into, acc
        XFormat xs: ReadsEach xs, into, acc
        XMatch s, arms, ignore, ignore: ReadsArms arms, into, (ReadsOf s, into, acc)
        XChain ignore, s, arms, ignore: ReadsArms arms, into, (ReadsOf s, into, acc)
        XIf c, t, e: ReadsEach [[c, t, e]], into, acc
        XBlock dos, e: ReadsOf e, into, (ReadsDos dos, into, acc)
        XLabeled ignore, dos, e, ignore: ReadsOf e, into, (ReadsDos dos, into, acc)
        XTry y: ReadsOf y, into, acc
        XField r, ignore: ReadsOf r, into, acc
        XFieldOf r, ignore, ignore: ReadsOf r, into, acc
        XPart r, ignore: ReadsOf r, into, acc
        XDecode ignore, y: ReadsOf y, into, acc
        XCast y, ignore: ReadsOf y, into, acc
        XTyped y, ignore: ReadsOf y, into, acc
        otherwise: acc

ReadsEach: unbounded fn [Ex], Bool, (([Text], Bool)) -> (([Text], Bool))
fn ReadsEach xs, into, acc = Fold xs, acc, \|a, x| ReadsOf x, into, a

ReadsArms: unbounded fn [XArm], Bool, (([Text], Bool)) -> (([Text], Bool))
fn ReadsArms arms, into, acc = Fold arms, acc, \|a, arm| ReadsOf arm.body, into, (Fold arm.conds, a, \|a2, c| ReadsCond c, into, a2)

ReadsCond: unbounded fn Cc, Bool, (([Text], Bool)) -> (([Text], Bool))
fn ReadsCond (CcLet ignore, x), into, acc = ReadsOf x, into, acc
fn ReadsCond (CcIf x), into, acc = ReadsOf x, into, acc

ReadsDos: unbounded fn [Do], Bool, (([Text], Bool)) -> (([Text], Bool))
fn ReadsDos dos, into, acc = Fold dos, acc, \|a, d| match d:
    DoLet ignore, x: ReadsOf x, into, a
    DoLetElse ignore, x, e: ReadsEach [[x, e]], into, a
    DoAssign p, x: ReadsEach [[p, x]], into, a
    DoWhile c, body: ReadsDos body, into, (ReadsOf c, into, a)
    DoWhileLet ignore, x, body: ReadsDos body, into, (ReadsOf x, into, a)
    DoFor ignore, x, body: ReadsDos body, into, (ReadsOf x, into, a)
    DoExpr x: ReadsOf x, into, a
    DoIf c, t, e: ReadsDos e, into, (ReadsDos t, into, (ReadsOf c, into, a))
    DoIfLet ignore, x, t, e: ReadsDos e, into, (ReadsDos t, into, (ReadsOf x, into, a))
    DoMatch x, cases: Fold cases, (ReadsOf x, into, a), \|a2, ((ignore, body))| ReadsDos body, into, a2
    DoReturn x: ReadsOf x, into, a
    DoBlock body: ReadsDos body, into, a
    DoScope body: ReadsDos body, into, a
    DoLine body: ReadsDos body, into, a
    DoNote ignore: a

IsCtor: fn Ex, Text -> Bool
fn IsCtor (XCtor (RefRuntime p), ignore), c = (Bare p) == c
fn IsCtor x, c = False

# The failure a branch gives: `Err(y)`, or a block that ends in one.
?ErrOf: fn Ex -> ?Ex
fn ?ErrOf x = match x:
    XCtor (RefRuntime "std::Err"), [[y]]: ? y
    XBlock ignore, tail: ?ErrOf tail
    otherwise: nil

# A branch beside an `Err(y)`: an `Ok(x)` (or a block ending in one) as the `Expected` the
# other branch converts to, of `x`'s type and `y`'s.
OkBranch: unbounded fn Cp, Ex, Ex -> Text
fn OkBranch cp, x, y = match x:
    XCtor (RefRuntime "std::Ok"), [[v]]: "crate::prelude::Expected<::std::decay_t<decltype({CppExpr cp, v})>, ::std::decay_t<decltype({CppExpr cp, y})>>({CppExpr cp, v})"
    XBlock dos, (XCtor (RefRuntime "std::Ok"), [[v]]):
        let ((st, cp2)) = CppStatementsCp cp, dos
        StmtExpr st, "crate::prelude::Expected<::std::decay_t<decltype({CppExpr cp2, v})>, ::std::decay_t<decltype({CppExpr cp2, y})>>({CppExpr cp2, v})"
    otherwise: CppExpr cp, x

# A closure: a lambda capturing by value (`move`) or by reference. A move closure takes
# the `let`s before it that only its body reads by moving init-captures (`[=, g_1 =
# std::move(g_1)]`, pick MV), as Rust's `move` moves them in; the rest of its captures are
# copies. Inside, the captures are constants and move nothing (`Captured`); a by-value
# parameter (`PaMut`) is the body's own.
CppClosure: unbounded fn Cp, Bool, [Pa], Ex -> Text
fn CppClosure cp0, mv, ps, body:
    let names = Concat2 (Each ps, \|p| PatNames p)
    let cp = Fold ps, (Unbind (Captured cp0), names), \|c, p| match p:
        PaMut n: Owning c, n
        PaTyped (PaMut n), ignore: Owning c, n
        otherwise: c
    let params = Join (Each (Range0 (Len ps)), \|i| ClosureParam cp, (Or ps[i], PaWild), i), ", "
    let binds = Concat (Each (Range0 (Len ps)), \|i| ClosureBinds cp, (Or ps[i], PaWild), i)
    let b = CppExpr cp, body
    let moved = if mv: Filter cp0.moveCaptures, \|n| (Or cp0.owned[n], False) and (not (InList names, n)) and ExReads body, n else: [[]]
    let capture = Join (Append [[(if mv: "=" else: "&")]], (Each moved, \|n| "{VarName cp0, n} = ::std::move({VarName cp0, n})")), ", "
    let ((ret, value)) = match body:
        XRef ignore: ((" -> decltype(auto)", "({b})"))
        XRefMut ignore: ((" -> decltype(auto)", "({b})"))
        otherwise: (("", b))
    if binds == "" and not (Contains b, "\n"): "[{capture}]({params}){ret} \{ return {value}; \}"
    else: Lambda capture, "{params}){ret}", "{binds}return {value};"

ClosureParam: unbounded fn Cp, Pa, Nat -> Text
fn ClosureParam cp, (PaTyped (PaBind n), t), i = "{ParamType cp, t} {CppId n}"
fn ClosureParam cp, (PaTyped (PaMut n), t), i = "{CppType cp, (Unref t)} {CppId n}"
fn ClosureParam cp, (PaTyped p, t), i = "{ParamType cp, t} _p{i}"
fn ClosureParam cp, (PaBind n), i = "auto&& {CppId n}"
fn ClosureParam cp, (PaMut n), i = "auto {CppId n}"
fn ClosureParam cp, PaWild, i = "const auto&"
fn ClosureParam cp, p, i = "const auto& _p{i}"

ClosureBinds: unbounded fn Cp, Pa, Nat -> Text
fn ClosureBinds cp, (PaTyped (PaBind n), t), i = ""
fn ClosureBinds cp, (PaTyped (PaMut n), t), i = ""
fn ClosureBinds cp, (PaTyped p, t), i = ClosureBinds cp, p, i
fn ClosureBinds cp, (PaBind n), i = ""
fn ClosureBinds cp, (PaMut n), i = ""
fn ClosureBinds cp, PaWild, i = ""
fn ClosureBinds cp, p, i = Concat (Each (PatBinds cp, p, "_p{i}"), \|b| "{b}\n")

Unref: fn OutTy -> OutTy
fn Unref (OutRef t) = t
fn Unref t = t

# A parameter's type: a value by `const&`, a reference as its referent's.
ParamType: unbounded fn Cp, OutTy -> Text
fn ParamType cp, t = match t:
    OutRef ignore: CppType cp, t
    OutSlice ignore: CppType cp, t
    OutUnit: "crate::prelude::Unit"
    otherwise: CppType cp, t
