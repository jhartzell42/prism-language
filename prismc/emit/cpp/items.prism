# `Emit.Cpp.Items`, a child module of `Emit.Cpp`.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit r
use Emit.Cpp.*
use Emit.Cpp.Expr.*
use Emit.Cpp.Patterns.*
use Emit.Cpp.Stmts.*
use Emit.Cpp.Program.*
use Syntax.Lexer.*
use Syntax.Lexer.Chars.*
use Syntax.Lexer.Layout.*
use Syntax.Lexer.Words.*
use Syntax.Lexer.Literals.*
use Syntax.Lexer.Templates.*
use Syntax.Lexer.Corpus.*
use Check.Errors.*
use Lower.*
use Lower.Types.*
use Lower.Expr.*
use Lower.Patterns.*
use Lower.Templates.*
use Lower.Functions.*
use Lower.Jobs.*
use Lower.Program.*
use Lower.Model.*
use Lower.Node.*
use Lower.Node.Def.*
use Lower.Node.Elements.*
use Lower.Node.Static.*
use Lower.Node.Dynamics.*
use Lower.Node.Finish.*
use Lower.Node.Keyed.*
use Lower.Node.Switch.*
use Emit.Cpp.Templates.*
use Emit.Cpp.Templates.Items.*
use Emit.Cpp.Prelude.*

# ---------------------------------------------------------------------------------------
# Items
# ---------------------------------------------------------------------------------------

CppTemplateHead: fn [Text] -> Text
fn CppTemplateHead [[]] = ""
fn CppTemplateHead ps = "template <{Join (Each ps, \|p| "class {p}"), ", "}>\n"

GenericNamesOf: fn [((Text, [Text]))] -> [Text]
fn GenericNamesOf gs = Each gs, \|((g, ignore))| g

HeadOf: fn Text, [Text] -> Text
fn HeadOf name, [[]] = name
fn HeadOf name, ps = "{name}<{Join ps, ", "}>"

CppParams: unbounded fn Cp, [((Text, OutTy))] -> Text
fn CppParams cp, ps = Join (Each ps, \|((n, t))| "{ParamType cp, t} {CppId n}"), ", "

# A function's signature, with `prefix` before its name (`Type::` for a member).
FnSignature: unbounded fn Cp, FnDef -> Text
fn FnSignature cp, f = "{CppTemplateHead (GenericNamesOf f.generics)}{CppType cp, f.ret} {CppId f.name}({CppParams cp, f.params})"

FnDefinition: unbounded fn Cp, FnDef -> Text
fn FnDefinition cp, f = CppFunction (CppDoc f.doc), (FnSignature cp, f), (CppBody (WithParams cp, f.params), f.body)

# The context inside a function: each parameter known as a pointer or a value by its type,
# so its members are reached by `->` or `.` without `val` (`AsValue`).
WithParams: fn Cp, [((Text, OutTy))] -> Cp
fn WithParams cp, ps = Fold ps, cp, \|c, ((n, t))| update c:
    &_.pointers <= Insert &_.pointers, n, (IsPointerTy c, (Unref t))
    &_.localTypes <= Insert &_.localTypes, n, t

# The parts of a module's items: declarations ahead of the definitions, in the order C++
# needs (the headers' sections, `ModuleFiles` below): the forward declarations, the value
# types (records, newtypes, unit types, tags and choices with their cases, each after the
# types it holds by value), the prototypes, the classes, the generic and the plain
# definitions.
type Parts = record:
    forward: [Text]
    values: [ValueDecl]
    protos: [Text]
    classes: [Text]
    # Declarations at the crate's scope, after the module's prototypes: an impl's of
    # another module's trait (`ImplParts`).
    outer: [Text]
    generic: [Text]
    defs: [Text]
derive ^Eq, ^Show

# A value type's definition, with the types it holds by value: they are defined first.
type ValueDecl = record:
    path: Text
    deps: [Text]
    text: Text
derive ^Eq, ^Show

# The value types a type holds by value, which must be complete before it: a record, a
# newtype, a unit type, a tag or a choice, directly, in an optional, a result, a cell or a
# tuple, or as a type argument. What is behind a pointer needs only its declaration: an
# `Rc` (a `Val`, pick CH), an array, a map, a function.
ValueDeps: unbounded fn Cp, OutTy -> [Text]
fn ValueDeps cp, t = match t:
    OutNamed n, args:
        let own = match ?TypeOf cp, n:
            ? info: if info.kind == "record" or info.kind == "newtype" or info.kind == "unit" or info.kind == "tag" or info.kind == "choice": [[(DepPath cp, n)]] else: [[]]
            nil: [[]]
        Append own, (Concat2 (Each args, \|a| ValueDeps cp, a))
    OutOpt i: ValueDeps cp, i
    OutRes i: ValueDeps cp, i
    OutCell i: ValueDeps cp, i
    OutTuple ts: Concat2 (Each ts, \|a| ValueDeps cp, a)
    otherwise: [[]]

# A value type's path as `ValueDecl.path` writes it: in its module, or the crate's own
# (`Elem`, `Answer`).
DepPath: fn Cp, Ref -> Text
fn DepPath cp, n = Or (?RefKey n), (RefSpelled n)

# Whether a field's type names a type that may be incomplete where the struct is defined,
# and whose comparison a defaulted one would instantiate at once (clang defines a defaulted
# comparison where it is declared): a `Val` (an `Rc` of a value) of anything, since the value
# may be the type being defined; or a program type (a choice, a record) behind an array, a
# map, a function, a dynamic or an event, where nothing orders it before this struct
# (`ValueDeps` orders only what is held by value), and a standard template over it
# (`Array<std::tuple<Text, T>>`) needs it complete. A struct holding one declares its
# comparisons and defines them in the module's definitions, where every type is complete.
Behind: unbounded fn Cp, OutTy -> Bool
fn Behind cp, t = match t:
    OutRc ignore: True
    OutOpt i: Behind cp, i
    OutRes i: Behind cp, i
    OutCell i: Behind cp, i
    OutTuple ts: Fold ts, False, \|f, x| f or Behind cp, x
    OutArray i: NamesProgramType cp, i
    OutMap k, v: (NamesProgramType cp, k) or NamesProgramType cp, v
    OutFn ps, r: Fold ps, (NamesProgramType cp, r), \|f, x| f or NamesProgramType cp, x
    OutDyn i: NamesProgramType cp, i
    OutEvent i: NamesProgramType cp, i
    OutNamed ignore, args: Fold args, False, \|f, x| f or Behind cp, x
    otherwise: False

# Whether a type names one of the program's value types anywhere.
NamesProgramType: unbounded fn Cp, OutTy -> Bool
fn NamesProgramType cp, t = match t:
    OutNamed n, args:
        let own = match ?TypeOf cp, n:
            ? info: info.kind != "node" and info.kind != "job"
            nil: False
        own or Fold args, False, \|f, x| f or NamesProgramType cp, x
    OutOpt i: NamesProgramType cp, i
    OutRes i: NamesProgramType cp, i
    OutRc i: NamesProgramType cp, i
    OutCell i: NamesProgramType cp, i
    OutArray i: NamesProgramType cp, i
    OutMap k, v: (NamesProgramType cp, k) or NamesProgramType cp, v
    OutTuple ts: Fold ts, False, \|f, x| f or NamesProgramType cp, x
    OutFn ps, r: Fold ps, (NamesProgramType cp, r), \|f, x| f or NamesProgramType cp, x
    OutDyn i: NamesProgramType cp, i
    OutEvent i: NamesProgramType cp, i
    otherwise: False

let noParts = Parts(forward=[[]], values=[[]], protos=[[]], classes=[[]], outer=[[]], generic=[[]], defs=[[]])

JoinParts: fn Parts, Parts -> Parts
fn JoinParts a, b = Parts(forward=(Append a.forward, b.forward), values=(Append a.values, b.values), protos=(Append a.protos, b.protos), classes=(Append a.classes, b.classes), outer=(Append a.outer, b.outer), generic=(Append a.generic, b.generic), defs=(Append a.defs, b.defs))

ItemParts: unbounded fn Cp, Item -> Parts
fn ItemParts cp, it = match it:
    ItType t: TypeParts cp, t
    ItTag t: TagParts cp, t
    ItRow r: RowParts cp, cp.home, r
    ItFn f: FnParts cp, f
    ItJob j: JobParts cp, j
    ItNode n: NodeParts cp, n
    ItTrait t: TraitParts cp, t
    ItImpl i: ImplParts cp, i
    ItNote t: ProtosDefs [[]], [["// {t}"]]
    ItRefused t: ProtosDefs [[]], [["compile_error!(\"{loweringRefusal}{Escape t}\");"]]

FnParts: unbounded fn Cp, FnDef -> Parts
fn FnParts cp, f:
    if (Len f.generics) > 0: update (GenericOnly [[(FnDefinition cp, f)]]):
        &_.protos <= [["{FnSignature cp, f};"]]
    else: ProtosDefs [["{FnSignature cp, f};"]], [[(FnDefinition cp, f)]]

# A doc comment, `///` per line.
CppDoc: fn Text -> Text
fn CppDoc text = if text == "": "" else: Concat (Each (SplitOn text, "\n"), \|l| if l == "": "///\n" else: "/// {l}\n")

# A doc comment quoting the Prism source, after a lead line.
CppSourceDoc: fn Text, Text -> Text
fn CppSourceDoc lead, source:
    let quoted = Concat (Each (SplitOn source, "\n"), \|l| if l == "": "///\n" else: "/// {l}\n")
    if source == "": CppDoc lead
    else: if lead == "": "/// ```prism\n{quoted}/// ```\n" else: "/// {lead}\n///\n/// ```prism\n{quoted}/// ```\n"

# A type: a record as a struct, a choice as a class holding the variant of its cases (nested
# structs, complete before it), a newtype as a struct of one field, a unit type as an empty
# struct; its comparisons, printer and plain data. Each is a value type defined after the
# types it holds by value (`ValueDecl`).
TypeParts: unbounded fn Cp, TyDef -> Parts
fn TypeParts cp, t0:
    let t = CppCases t0
    let eq = t.eq
    let ord = t.ord
    let gens = CppTemplateHead t.params
    let head = HeadOf t.name, t.params
    let doc = CppSourceDoc "`{t.prism}`:", t.doc
    let members = Members (t.show != NotShown), t.pod, head
    let generic = (Len t.params) > 0
    let fwd = "{gens}{if t.shape == ShapeChoice: "class" else: "struct"} {t.name};"
    let deps = Concat2 (Each t.cases, \|c| Concat2 (Each c.fields, \|((ignore, ft))| ValueDeps cp, ft))
    let ((text, cmpDefs)) = match t.shape:
        ShapeChoice:
            let names = Each t.cases, \|c| c.name
            let cases = Join (Each t.cases, \|c| CaseStruct cp, c, eq, ord), "\n"
            let cls = ChoiceClass doc, gens, t.name, cases, (Join names, ", "), members
            # the choice's comparisons over the variant, after its cases; the cases' own, where
            # declared (`Behind`), among the module's definitions
            let cmp = Join (Filter [[(if eq: "{gens}inline bool operator==(const {head}& a, const {head}& b) \{ return a.cases() == b.cases(); \}" else: ""), (if ord: "{gens}inline ::std::strong_ordering operator<=>(const {head}& a, const {head}& b) \{ return a.cases() <=> b.cases(); \}" else: "")]], \|s| s != ""), "\n"
            let caseDefs = Filter (Each t.cases, \|c| CaseCmpDefs cp, gens, head, c, eq, ord), \|s| s != ""
            (((Join (Filter [[cls, cmp]], \|s| s != ""), "\n"), caseDefs))
        otherwise:
            let first = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]], labels=[[]]))
            let fields = match t.shape:
                ShapeRecord: Join (Each first.fields, \|((f, ft))| "{CppType cp, ft} {FieldId f};"), "\n"
                ShapeNewtype: PositionalFields cp, first.fields
                otherwise: ""
            let names = match t.shape:
                ShapeRecord: Each first.fields, \|((f, ignore))| FieldId f
                ShapeNewtype: Each (Range0 (Len first.fields)), \|i| "a{i}"
                otherwise: [[]]
            let behind = Fold first.fields, False, \|f, ((ignore, ft))| f or Behind cp, ft
            let ((cmps, cmpDefs)) = Comparisons gens, head, t.name, names, eq, ord, behind
            let decl = ValueStruct doc, gens, t.name, fields, (Join (Filter [[cmps, members]], \|s| s != ""), "\n")
            ((decl, (if cmpDefs == "": [[]] else: [[cmpDefs]])))
    let defs = Append cmpDefs, [[(TypeDefs cp, t, head)]]
    Parts(forward=[[fwd]], values=[[ValueDecl(path=(DeclPath cp, t.name), deps=deps, text=text)]], protos=[[]], classes=[[]], outer=[[]], generic=(if generic: defs else: [[]]), defs=(if generic: [[]] else: defs))

# A value type's path in `ValueDecl`: in its module, or the crate's own.
DeclPath: fn Cp, Text -> Text
fn DeclPath cp, name = if cp.home == "": name else: "{cp.home}::{name}"

# A struct's comparisons: defaulted, in the struct, unless a field's type may be incomplete
# there (`Behind`), when they are declared in the struct and defined among the module's
# definitions: `==` over the fields in order, `<=>` lexicographic and total.
Comparisons: fn Text, Text, Text, [Text], Bool, Bool, Bool -> ((Text, Text))
fn Comparisons gens, owner, self, names, eq, ord, behind:
    if not behind: (((Join (Filter [[(if eq: "bool operator==(const {self}&) const = default;" else: ""), (if ord: "auto operator<=>(const {self}&) const = default;" else: "")]], \|s| s != ""), "\n"), ""))
    else:
        let decls = Join (Filter [[(if eq: "bool operator==(const {self}&) const;" else: ""), (if ord: "::std::strong_ordering operator<=>(const {self}&) const;" else: "")]], \|s| s != ""), "\n"
        let eqBody = if (Len names) == 0: "true" else: Join (Each names, \|n| "{n} == o.{n}"), " && "
        let ordBody = if (Len names) == 0: "::std::strong_ordering::equal" else: "::std::tie({Join names, ", "}) <=> ::std::tie({Join (Each names, \|n| "o.{n}"), ", "})"
        let defs = Join (Filter [[(if eq: "{gens}bool {owner}::operator==(const {self}& o) const \{ return {eqBody}; \}" else: ""), (if ord: "{gens}::std::strong_ordering {owner}::operator<=>(const {self}& o) const \{ return {ordBody}; \}" else: "")]], \|s| s != ""), "\n"
        ((decls, defs))

# The members a value type declares for the runtime: its printer and its plain data.
Members: fn Bool, Bool, Text -> Text
fn Members shown, pod, head:
    let s = if shown: [["void show(crate::prelude::Printer& p) const;"]] else: [[]]
    let d = if pod: [["crate::prelude::Pod to_pod() const;", "static crate::prelude::Result<{head}> from_pod(const crate::prelude::Pod& whole);"]] else: [[]]
    Join (Append s, d), "\n"

# A case's struct, nested in its choice.
CaseStruct: unbounded fn Cp, CaseDef, Bool, Bool -> Text
fn CaseStruct cp, c, eq, ord:
    let fields = PositionalFields cp, c.fields
    let ((cmps, ignore)) = Comparisons "", "", c.name, (CaseNames c), eq, ord, (CaseBehind cp, c)
    CaseDecl c.name, (Join (Filter [[fields, cmps]], \|s| s != ""), "\n")

# A case's comparisons defined among the module's definitions, when a field is `Behind`.
CaseCmpDefs: unbounded fn Cp, Text, Text, CaseDef, Bool, Bool -> Text
fn CaseCmpDefs cp, gens, head, c, eq, ord:
    let ((ignore, defs)) = Comparisons gens, "{head}::{c.name}", c.name, (CaseNames c), eq, ord, (CaseBehind cp, c)
    defs

CaseNames: fn CaseDef -> [Text]
fn CaseNames c = Each (Range0 (Len c.fields)), \|i| "a{i}"

CaseBehind: unbounded fn Cp, CaseDef -> Bool
fn CaseBehind cp, c = Fold c.fields, False, \|f, ((ignore, ft))| f or Behind cp, ft

# A type's printer and plain data (claude/backend.md, "Printing").
TypeDefs: unbounded fn Cp, TyDef, Text -> Text
fn TypeDefs cp, t, head:
    let gens = CppTemplateHead t.params
    let show = if t.show == ShownDerived: [[(ShowDef cp, t, head, gens)]] else: [[]]
    let pod = if t.pod: [[(ToPodDef cp, t, head, gens), (FromPodDef cp, t, head, gens)]] else: [[]]
    Join (Append show, pod), "\n"

ShowDef: unbounded fn Cp, TyDef, Text, Text -> Text
fn ShowDef cp, t, head, gens:
    let body = match t.shape:
        ShapeRecord:
            let c = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]], labels=[[]]))
            "p.record(\"{t.prism}\", \{{Join (Each c.fields, \|((f, ignore))| "\{\"{PrismFieldOf c, f}\", {FieldId f}\}"), ", "}\});"
        ShapeChoice: Join (Each (Range0 (Len t.cases)), \|i| ShowCase t, i), "\n"
        ShapeNewtype: "p.choice(\"{FirstCase t}\", \{{Join (Each (Range0 (FirstArity t)), \|k| "a{k}"), ", "}\});"
        ShapeUnit: "p.choice(\"{FirstCase t}\", \{\});"
    CppFunction "", "{gens}void {head}::show(crate::prelude::Printer& p) const", body

ShowCase: fn TyDef, Nat -> Text
fn ShowCase t, i:
    let c = Or t.cases[i], (CaseDef(name="", prism="", fields=[[]], labels=[[]]))
    let head = "{if i == 0: "if" else: "else if"} (auto c = ::std::get_if<{c.name}>(&cases()))"
    "{head} p.choice(\"{c.prism}\", \{{Join (Each (Range0 (Len c.fields)), \|k| "c->a{k}"), ", "}\});"

# The Prism name of a newtype's or unit type's one case (`click` of `Click`).
FirstCase: fn TyDef -> Text
fn FirstCase t = (Or t.cases[0], (CaseDef(name="", prism=t.prism, fields=[[]], labels=[[]]))).prism

FirstArity: fn TyDef -> Nat
fn FirstArity t = Len (Or t.cases[0], (CaseDef(name="", prism="", fields=[[]], labels=[[]]))).fields

FieldTypes: fn [((Text, OutTy))] -> [OutTy]
fn FieldTypes fs = Each fs, \|((ignore, t))| t

PositionalFields: unbounded fn Cp, [((Text, OutTy))] -> Text
fn PositionalFields cp, fs:
    let tys = FieldTypes fs
    Join (Each (Range0 (Len tys)), \|i| "{CppType cp, (Or tys[i], OutUnit)} a{i};"), "\n"

ToPodDef: unbounded fn Cp, TyDef, Text, Text -> Text
fn ToPodDef cp, t, head, gens:
    let structure = match t.shape:
        ShapeRecord:
            let c = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]], labels=[[]]))
            "crate::prelude::Pod::record(\"{t.prism}\", \{{Join (Each c.fields, \|((f, ignore))| "\{\"{PrismFieldOf c, f}\", ::prism_rtl::to_pod({FieldId f})\}"), ", "}\})"
        ShapeChoice: ChoicePod t
        ShapeNewtype: "crate::prelude::Pod::choice(\"{FirstCase t}\", \{{Join (Each (Range0 (FirstArity t)), \|k| "::prism_rtl::to_pod(a{k})"), ", "}\})"
        ShapeUnit: "crate::prelude::Pod::choice(\"{FirstCase t}\", \{\})"
    let body = if t.show == ShownOwn: "crate::prelude::Pod structure = {structure};\nreturn crate::prelude::Pod::shown(::prism_rtl::show(*this), structure);" else: "return {structure};"
    CppFunction "", "{gens}crate::prelude::Pod {head}::to_pod() const", body

ChoicePod: fn TyDef -> Text
fn ChoicePod t:
    let arms = Each (Range0 (Len t.cases)), \|i|
        let c = Or t.cases[i], (CaseDef(name="", prism="", fields=[[]], labels=[[]]))
        "::std::holds_alternative<{c.name}>(cases()) ? crate::prelude::Pod::choice(\"{c.prism}\", \{{Join (Each (Range0 (Len c.fields)), \|k| "::prism_rtl::to_pod(::std::get<{c.name}>(cases()).a{k})"), ", "}\})"
    "{Join arms, "\n    : "}\n    : crate::prelude::Pod()"

FromPodDef: unbounded fn Cp, TyDef, Text, Text -> Text
fn FromPodDef cp, t, head, gens:
    let body = match t.shape:
        ShapeRecord:
            let c = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]], labels=[[]]))
            let reads = Join (Each c.fields, \|((f, ft))| ".{FieldId f} = TRY(::prism_rtl::from_pod<{CppType cp, ft}>(TRY(crate::prelude::field(whole, \"{PrismFieldOf c, f}\"))))"), ", "
            "return {head}\{{reads}\};"
        otherwise:
            let arms = Each t.cases, \|c|
                let n = Len c.fields
                let tys = FieldTypes c.fields
                let args = Join (Each (Range0 n), \|i| "TRY(::prism_rtl::from_pod<{CppType cp, (Or tys[i], OutUnit)}>(c->args[{i}]))"), ", "
                let made = match t.shape:
                    ShapeChoice: "{head}({c.name}\{{args}\})"
                    otherwise: "{head}\{{args}\}"
                "if (c->ctor == \"{c.prism}\" && c->args.size() == {n}) return {made};"
            "const crate::prelude::Pod& p = whole.structure();\nif (auto c = p.if_choice()) \{\n{IndentCpp (Join arms, "\n")}\n\}\nreturn crate::prelude::mismatch<{head}>(\"a {t.prism}\", p);"
    CppFunction "", "{gens}crate::prelude::Result<{head}> {head}::from_pod(const crate::prelude::Pod& whole)", body

# A field's Prism spelling: the C++ one without the `_` a keyword took.
PrismField: fn Text -> Text
fn PrismField f = if (LastChar f) == "_": BeforeLast f else: f

# A record's field as the program spells it (`CaseDef.labels`), by its Rust name.
PrismFieldOf: fn CaseDef, Text -> Text
fn PrismFieldOf c, f = Fold (Range0 (Len c.fields)), (PrismField f), \|found, i| match ((c.fields[i], c.labels[i])):
    ((? ((g, ignore)), ? label)): if g == f: label else: found
    otherwise: found

IndentCpp: fn Text -> Text
fn IndentCpp t = Join (Each (SplitOn t, "\n"), \|l| if l == "": "" else: "    {l}"), "\n"

# An element tag's `Level`: a struct of its fields, its tag, its plain data.
TagParts: unbounded fn Cp, TagDef -> Parts
fn TagParts cp, t:
    let fields = Join (Each t.fields, \|((ignore, f, ft))| "{CppType cp, ft} {FieldId f};"), "\n"
    let pods = Join (Each t.fields, \|((p, f, ignore))| "\{\"{p}\", ::prism_rtl::to_pod({FieldId f})\}"), ", "
    let reads = Join (Each t.fields, \|((p, f, ft))| ".{FieldId f} = TRY(::prism_rtl::from_pod<{CppType cp, ft}>(TRY(crate::prelude::field(p, \"{p}\"))))"), ", "
    let eq = if t.eq: "bool operator==(const {t.name}&) const = default;" else: ""
    let back = if t.pod: "static crate::prelude::Result<{t.name}> from_pod(const crate::prelude::Pod& p);" else: ""
    # a level that holds dynamics as a World reads it, deep (doubt WD)
    let deep = Fold t.fields, False, \|d, ((ignore, ignore, ft))| d or HoldsDyn ft
    let levelDecl = if deep: "/// The level as a World reads it: each dynamic it holds sampled at the read point.\ncrate::prelude::Pod level_pod(const crate::prelude::Cx& cx) const;\n/// The update events of the dynamics it holds, and of theirs.\nvoid level_ports(const crate::prelude::Cx& cx, ::std::vector<::prism_rtl::Rc<::prism_rtl::Port<crate::prelude::Unit>>>& out) const;" else: ""
    let decl = CppTagStruct (CppSourceDoc "The `Level` of `{t.tagName}`:", t.doc), t.name, fields, t.tagName, (Join (Filter [[eq, back, levelDecl]], \|s| s != ""), "\n")
    let deepPods = Join (Each t.fields, \|((p, f, ft))| CppDeepField p, f, ft), ", "
    let deepPorts = Join (Filter (Each t.fields, \|((ignore, f, ft))| CppDeepPorts f, ft), \|s| s != ""), "\n"
    let levelDefs = if deep: [[(CppFunction "", "crate::prelude::Pod {t.name}::level_pod(const crate::prelude::Cx& cx) const", "static_cast<void>(cx);\nreturn crate::prelude::Pod::element(TAG, \{{deepPods}\});"), (CppFunction "", "void {t.name}::level_ports(const crate::prelude::Cx& cx, ::std::vector<::prism_rtl::Rc<::prism_rtl::Port<crate::prelude::Unit>>>& out) const", "static_cast<void>(cx);\nstatic_cast<void>(out);{if deepPorts == "": "" else: "\n{deepPorts}"}")]] else: [[]]
    let toPod = CppFunction "", "crate::prelude::Pod {t.name}::to_pod() const", "return crate::prelude::Pod::element(TAG, \{{pods}\});"
    let show = CppFunction "", "void {t.name}::show(crate::prelude::Printer& p) const", "::prism_rtl::to_pod(*this).structure();\ncrate::prelude::Show<crate::prelude::Pod>::show(::prism_rtl::to_pod(*this), p);"
    let fromPod = if t.pod: [[(CppFunction "", "crate::prelude::Result<{t.name}> {t.name}::from_pod(const crate::prelude::Pod& p)", "if (auto t = p.tag(); t && *t == TAG) return {t.name}\{{reads}\};\nreturn crate::prelude::mismatch<{t.name}>(\"a {t.tagName}\", p);")]] else: [[]]
    let deps = Concat2 (Each t.fields, \|((ignore, ignore, ft))| ValueDeps cp, ft)
    Parts(forward=[["struct {t.name};"]], values=[[ValueDecl(path=(DeclPath cp, t.name), deps=deps, text=decl)]], protos=[[]], classes=[[]], outer=[[]], generic=[[]], defs=(Append (Append [[toPod, show]], fromPod), levelDefs))

# A level field as a World reads it (doubt WD): plain data as it is; a map of dynamics or a
# dynamic sampled deep. Any other shape holding a dynamic stops the build, loudly.
CppDeepField: unbounded fn Text, Text, OutTy -> Text
fn CppDeepField p, f, ft = "\{\"{p}\", {CppDeepPod f, ft}\}"

CppDeepPod: unbounded fn Text, OutTy -> Text
fn CppDeepPod f, ft = match ft:
    OutMap ignore, (OutDyn (OutNamed (RefItem "", "Elem", ignore), ignore)): "::prism_rtl::dynamics_pod({FieldId f}, cx)"
    OutDyn (OutNamed (RefItem "", "Elem", ignore), ignore): "::prism_rtl::level_pod({FieldId f}.sample(cx), cx)"
    other: if HoldsDyn other: "[] \{ static_assert(false, \"prismc: a tag field holding a dynamic other than `$Elem` or a map of them is not read deep (claude/incremental-host-document.md, doubt WD)\"); return crate::prelude::Pod(); \}()" else: "::prism_rtl::to_pod({FieldId f})"

CppDeepPorts: unbounded fn Text, OutTy -> Text
fn CppDeepPorts f, ft = match ft:
    OutMap ignore, (OutDyn (OutNamed (RefItem "", "Elem", ignore), ignore)): "::prism_rtl::dynamics_ports({FieldId f}, cx, out);"
    OutDyn (OutNamed (RefItem "", "Elem", ignore), ignore): "out.push_back({FieldId f}.updates);\n::prism_rtl::level_ports({FieldId f}.sample(cx), cx, out);"
    otherwise: ""

# A row kind's values (pick RV): a choice of the kind's tags, each holding its tag's struct.
RowParts: unbounded fn Cp, Text, RowDef -> Parts
fn RowParts cp, m, r:
    let names = Each r.cases, \|((v, ignore))| v
    let levels = if r.level: "\ncrate::prelude::Pod level_pod(const crate::prelude::Cx& cx) const;\nvoid level_ports(const crate::prelude::Cx& cx, ::std::vector<::prism_rtl::Rc<::prism_rtl::Port<crate::prelude::Unit>>>& out) const;" else: ""
    let pod = "crate::prelude::Pod to_pod() const;\nvoid show(crate::prelude::Printer& p) const;{if r.pod: "\nstatic crate::prelude::Result<{r.name}> from_pod(const crate::prelude::Pod& p);" else: ""}{levels}"
    let cases = Join (Each r.cases, \|((v, st))| CaseDecl v, "{RowStruct m, st} a0;{if r.eq: "\nbool operator==(const {v}&) const = default;" else: ""}"), "\n"
    let cls = ChoiceClass (CppSourceDoc "`{r.prism}`, a row kind's values:", r.doc), "", r.name, cases, (Join names, ", "), pod
    let eq = if r.eq: "\ninline bool operator==(const {r.name}& a, const {r.name}& b) \{ return a.cases() == b.cases(); \}" else: ""
    # `crate::Elem`'s levels as a World reads them (doubt WD): a tag that holds dynamics
    # deep, any other as its plain data
    let levelDefs = if r.level: [[(CppFunction "", "crate::prelude::Pod {r.name}::level_pod(const crate::prelude::Cx& cx) const", "return ::std::visit([&](const auto& c) \{ return ::prism_rtl::level_pod(c.a0, cx); \}, cases());"), (CppFunction "", "void {r.name}::level_ports(const crate::prelude::Cx& cx, ::std::vector<::prism_rtl::Rc<::prism_rtl::Port<crate::prelude::Unit>>>& out) const", "::std::visit([&](const auto& c) \{ ::prism_rtl::level_ports(c.a0, cx, out); \}, cases());")]] else: [[]]
    let toPod = CppFunction "", "crate::prelude::Pod {r.name}::to_pod() const", "return ::std::visit([](const auto& c) \{ return ::prism_rtl::to_pod(c.a0); \}, cases());"
    let show = CppFunction "", "void {r.name}::show(crate::prelude::Printer& p) const", "crate::prelude::Show<crate::prelude::Pod>::show(to_pod(), p);"
    let reads = Join (Each r.cases, \|((v, st))| "if (*t == {RowStruct m, st}::TAG) return {r.name}({v}\{TRY(::prism_rtl::from_pod<{RowStruct m, st}>(p))\});"), "\n"
    let fromPod = if r.pod: [[(CppFunction "", "crate::prelude::Result<{r.name}> {r.name}::from_pod(const crate::prelude::Pod& p)", "if (auto t = p.tag()) \{\n{IndentCpp reads}\n\}\nreturn crate::prelude::mismatch<{r.name}>(\"a {r.name}\", p);")]] else: [[]]
    let deps = Concat2 (Each r.cases, \|((ignore, st))| ValueDeps cp, (OutNamed st, [[]]))
    Parts(forward=[["class {r.name};"]], values=[[ValueDecl(path=(DeclPath cp, r.name), deps=deps, text="{cls}{eq}")]], protos=[[]], classes=[[]], outer=[[]], generic=[[]], defs=(Append (Append [[toPod, show]], fromPod), levelDefs))

# A row case's struct, by its path from the crate (the case's own name would name the case).
RowStruct: fn Text, Ref -> Text
fn RowStruct m, st = match st:
    RefItem sm, p, s: if m == "": TypePath s else: "crate::{sm}::{p}"
    RefRuntime t: TypePath t

# `crate::Answer` (pick HO): a choice of a case per element tag with the tag's output; the
# tag an answer is for; an accessor per case; the decode of a World's answer.
AnswerParts: unbounded fn Cp, AnswerDef -> Parts
fn AnswerParts cp, a:
    let names = Each a.cases, \|c| c.variant
    let accessors = Join (Each a.cases, \|c| "crate::prelude::Result<{CppType cp, c.ty}> {c.accessor}() const;"), "\n"
    let members = "const char* tag() const;\n{accessors}\nstatic crate::prelude::Result<Answer> decode(const Elem& e, const crate::prelude::Pod& v);"
    let cases = Join (Each a.cases, \|c| CaseDecl c.variant, "{CppType cp, c.ty} a0;"), "\n"
    let cls = ChoiceClass (CppDoc "`Answer c`: an answer to an element, typed by its tag (Semantics ch. 9): what a host's\nsupplier answers a child place with, and what a World's answer to a forwarded element\ndecodes to, carrying the tag's output."), "", "Answer", cases, (Join names, ", "), members
    let tags = Join (Each a.cases, \|c| "if (::std::holds_alternative<{c.variant}>(cases())) return {TypePath (RefSpelled c.structPath)}::TAG;"), "\n"
    let tagFn = CppFunction "", "const char* Answer::tag() const", "{tags}\n::prism_rtl::unreachable();"
    let getters = Each a.cases, \|c| CppFunction (CppDoc "A `{c.tagName}`'s answer."), "crate::prelude::Result<{CppType cp, c.ty}> Answer::{c.accessor}() const", "if (auto c = ::std::get_if<{c.variant}>(&cases())) return c->a0;\nreturn crate::prelude::unexpected(crate::prelude::Fault::answer(crate::prelude::str(\"an answer for \", tag(), \", where {c.tagName}'s was expected\")));"
    let decodes = Join (Each a.cases, \|c| "if (is<Elem::{c.variant}>(e)) return Answer({c.variant}\{TRY(::prism_rtl::from_pod<{CppType cp, c.ty}>(v))\});"), "\n"
    let decode = CppFunction (CppDoc "A World's answer to the element `e`, decoded by its tag."), "crate::prelude::Result<Answer> Answer::decode(const Elem& e, const crate::prelude::Pod& v)", "{decodes}\n::prism_rtl::unreachable();"
    Parts(forward=[["class Answer;"]], values=[[ValueDecl(path="Answer", deps=[[]], text=cls)]], protos=[[]], classes=[[]], outer=[[]], generic=[[]], defs=(Append [[tagFn]], (Push getters, decode)))

# A step machine (D6): a job struct, its `cycle`, its `Start`.
JobParts: unbounded fn Cp, JobDef -> Parts
fn JobParts cp, j:
    let gens = CppTemplateHead (GenericNamesOf j.generics)
    let head = HeadOf j.name, (GenericNamesOf j.generics)
    let jcp = WithFields cp, j.fields
    let fields = Join (Each j.fields, \|((n, t))| "{CppType cp, t} {FieldId n};"), "\n"
    let params = Join (Each j.fields, \|((n, t))| "{CppType cp, t} {FieldId n}"), ", "
    let inits = Join (Each j.fields, \|((n, ignore))| "{FieldId n}(::std::move({FieldId n}))"), ", "
    let ctor = if (Len j.fields) == 0: "" else: "{j.name}({params}) : {inits} \{\}"
    let ret = CppType cp, j.ret
    let decl = JobStruct (CppDoc j.doc), gens, j.name, ret, fields, ctor
    let cycle = CppFunction "", "{gens}::prism_rtl::Turn<{ret}> {head}::cycle() const", (CppBody jcp, j.body)
    let start = CppFunction (CppDoc "`Start {j.name}, x`: what the function value is when passed to `@Run`."), "{gens}::prism_rtl::JobRef<{ret}> {j.start}({params})", "return ::prism_rtl::make_rc<{head}>({Join (Each j.fields, \|((n, ignore))| FieldId n), ", "});"
    let generic = (Len j.generics) > 0
    Parts(forward=[["{gens}struct {j.name};"]], values=[[]], protos=[["{gens}::prism_rtl::JobRef<{ret}> {j.start}({params});"]], classes=[[decl]], outer=[[]], generic=(if generic: [[cycle, start]] else: [[]]), defs=(if generic: [[]] else: [[cycle, start]]))

# A program's own trait: its methods are functions of a namespace named after it, each impl
# an overload (a default's body a template over `Self`). A method with no default is
# declared a deleted template over `Self`, so that a generic function's call of it names
# something wherever it is defined, and the overloads its file declares before it are the
# ones a call picks (`NAME.generic.hpp`, `ModuleFiles`).
#
# Each associated type is a class template of the namespace over `Self`, declared with the
# module's forward declarations and never defined: an impl's choice is a specialization at
# its head, `typename Box_t::Item<A>::type` reads it (`CppType`'s `OutAssoc`).
TraitParts: unbounded fn Cp, TraitDef -> Parts
fn TraitParts cp, t:
    let defaults = Filter t.methods, \|f| f.public
    let defs = Each defaults, \|f| FnDefinition cp, (WithGenerics f, [[(("Self", [[]]))]])
    let protos = Each t.methods, \|f| "{FnSignature cp, (WithGenerics f, [[(("Self", [[]]))]])}{if f.public: "" else: " = delete"};"
    let generic = if (Len defaults) == 0: [[]] else: [[(TraitNamespace t.name, (Join defs, "\n"))]]
    let assocs = Each t.assocs, \|n| "template <class Self>\nstruct {n};"
    update (GenericOnly generic):
        &_.protos <= [[(TraitNamespace t.name, (Join protos, "\n"))]]
        &_.forward <= if (Len assocs) == 0: [[]] else: [[(TraitNamespace t.name, (Join assocs, "\n"))]]

# An impl: of a program's trait, overloads in the trait's namespace (of another module's
# trait, in a namespace of the impl's module, `impl_aloud_Loud`, which a using-declaration
# at the crate's scope brings into the trait's: a namespace `aloud` inside the module would
# hide the module `aloud` from its code); of `^Show` a type's printer over a function of
# its own; of `^Eq` its `==`.
ImplParts: unbounded fn Cp, ImplDef -> Parts
fn ImplParts cp, i:
    let head = CppType cp, i.head
    let gens = CppTemplateHead (GenericNamesOf i.generics)
    let fns = Each i.methods, \|f| FnParts cp, (WithGenerics f, i.generics)
    let own = Fold fns, noParts, \|acc, p| JoinParts acc, p
    match i.cls:
        "Prelude.Show":
            let shown = Or (Each i.methods, \|f| f.name)[0], "show"
            JoinParts own, (ProtosDefs [[]], [[(CppFunction "", "{gens}void {head}::show(crate::prelude::Printer& p) const", "p.raw({shown}(*this).to_string());")]])
        "Prelude.Eq":
            let eq = Fold i.methods, "", \|acc, f| if (not (HasPrefix f.name, "ne")) and acc == "": f.name else: acc
            JoinParts own, (ProtosDefs [["{gens}bool operator==(const {head}& a, const {head}& b);"]], [[(CppFunction "", "{gens}bool operator==(const {head}& a, const {head}& b)", "return {eq}(a, b);")]])
        otherwise:
            let tr = DropPrefix (TypePath i.tr), "crate::"
            let own = not (Contains tr, "::")
            let ns = if own: tr else: "impl_{Join (SplitOn tr, "::"), "_"}"
            let inTrait = Each i.methods, \|f| TraitNamespace ns, (FnDefinition cp, (WithGenerics f, i.generics))
            let protos = Each i.methods, \|f| TraitNamespace ns, "{FnSignature cp, (WithGenerics f, i.generics)};"
            # each associated type it chooses, a specialization in the trait's own namespace
            # (a class template is specialized where it is declared, so another module's
            # trait's at the crate's scope)
            let spec = if gens == "": "template <>\n" else: gens
            let chosen = Each i.assocs, \|((n, at))| "{spec}struct {n}<{head}> \{ using type = {CppType cp, at}; \};"
            let specs = if (Len chosen) == 0: [[]] else: [[(TraitNamespace tr, (Join chosen, "\n"))]]
            let outer = if own: [[]] else: [[(TraitNamespace tr, (Join (Each i.methods, \|f| "using ::crate::{cp.home}::{ns}::{CppId f.name};"), "\n"))]]
            update (ProtosDefs (if own: Append specs, protos else: protos), inTrait):
                &_.outer <= if own: outer else: Append specs, outer

# A function with type parameters before its own.
WithGenerics: fn FnDef, [((Text, [Text]))] -> FnDef
fn WithGenerics f, gs = update f:
    &_.generics <= Append gs, &_.generics

GenericOnly: fn [Text] -> Parts
fn GenericOnly xs = update noParts:
    &_.generic <= xs

ProtosDefs: fn [Text], [Text] -> Parts
fn ProtosDefs ps, ds = update noParts:
    &_.protos <= ps
    &_.defs <= ds
