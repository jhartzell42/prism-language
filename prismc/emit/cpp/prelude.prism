# The prelude of every program compiled to C++ (Semantics Appendix B; prelude/prelude.prism):
# its builtins and the functions it writes in Prism, as C++ over `prism_rtl`, emitted as
# `src/prelude.hpp` word for word: the C++ form of prismc/emit/rust/prelude.prism, function for
# function, under the same names (a C++ keyword with `_` after it: `or_`, `int_`). Every
# function takes its arguments by `const&` and gives back a value, as emitted functions do;
# a closure parameter is any callable. `CppPreludeRows` is the part that names the
# program's `Elem` and `Answer`: the `Row` of a `for` or a `rebuild`, in `elem.decl.hpp` after
# them.
#
# Written by Claude, 3 November 2026, on the claude-self-hosting branch. Subject to change:
# Jimmy rewrites it by hand, and an implementer reading it uses their own discretion.
emit r

CppPreludeSource: fn Text -> Text
fn CppPreludeSource unused = inline_text <cpp>
// The prelude (Semantics Appendix B), emitted by prismc beside every program compiled to
// C++: the builtins and the prelude's own functions over `prism_rtl`.
#pragma once

#include <algorithm>
#include <cmath>
#include <cstdio>
#include <fstream>
#include <iostream>
#include <pthread.h>
#include <set>
#include <sstream>

#include "prism_rtl/lang.hpp"
#include "prism_world_cli/cli.hpp"

namespace crate {

using namespace std::literals;

namespace prelude {

// The runtime's functions, reached from the prelude too: the emitted code calls every helper
// by its path from here (`crate::prelude::index`), never bare (prismc/lower/mod.prism,
// `Helper`).
using namespace prism_rtl;

// ---- Types ------------------------------------------------------------------------------

/// `type Ordering = choice: Less | Equal | Greater; derive ^Eq, ^Ord, ^Show`.
class Ordering {
public:
    using prism_value = void;
    struct Less {
        auto operator<=>(const Less&) const = default;
    };
    struct Equal {
        auto operator<=>(const Equal&) const = default;
    };
    struct Greater {
        auto operator<=>(const Greater&) const = default;
    };
    using Cases = std::variant<Less, Equal, Greater>;
    template <class C>
        requires ::prism_rtl::one_of<C, Less, Equal, Greater>
    Ordering(C c) : cases_(std::move(c)) {}
    const Cases& cases() const { return cases_; }
    const char* name() const {
        return std::holds_alternative<Less>(cases()) ? "Less" : std::holds_alternative<Equal>(cases()) ? "Equal" : "Greater";
    }
    void show(Printer& p) const { p.choice(name(), {}); }
    Pod to_pod() const { return Pod::name(name()); }
    friend bool operator==(const Ordering& a, const Ordering& b) { return a.cases() == b.cases(); }
    friend std::strong_ordering operator<=>(const Ordering& a, const Ordering& b) { return a.cases() <=> b.cases(); }

private:
    Cases cases_;
};

/// A derived `FromPod`'s field.
inline Result<Pod> field(const Pod& p, const char* name) {
    if (auto f = p.field(name)) return *f;
    return unexpected(Fault::answer(str("no field ", name, " in ", p)));
}

/// `type Turn b = choice: More | Done b` (the prelude's; `::prism_rtl::Turn` is the job's),
/// as a program's own choice is emitted: a case struct each, positional fields `a0`.
template <class B>
class PreludeTurn {
public:
    using prism_value = void;
    struct More {
        bool operator==(const More&) const = default;
    };
    struct Done {
        B a0;
        bool operator==(const Done&) const = default;
    };
    using Cases = std::variant<More, Done>;
    template <class C>
        requires ::prism_rtl::one_of<C, More, Done>
    PreludeTurn(C c) : cases_(std::move(c)) {}
    const Cases& cases() const { return cases_; }
    void show(Printer& p) const {
        if (auto c = ::std::get_if<More>(&cases())) p.choice("More", {});
        else if (auto c = ::std::get_if<Done>(&cases())) p.choice("Done", {c->a0});
    }
    Pod to_pod() const {
        return ::std::holds_alternative<More>(cases()) ? Pod::choice("More", {})
            : Pod::choice("Done", {::prism_rtl::to_pod(::std::get<Done>(cases()).a0)});
    }
    static Result<PreludeTurn<B>> from_pod(const Pod& whole) {
        const Pod& p = whole.structure();
        if (auto c = p.if_choice()) {
            if (c->ctor == "More" && c->args.size() == 0) return PreludeTurn<B>(More{});
            if (c->ctor == "Done" && c->args.size() == 1) return PreludeTurn<B>(Done{TRY(::prism_rtl::from_pod<B>(c->args[0]))});
        }
        return mismatch<PreludeTurn<B>>("a Turn", p);
    }
    friend bool operator==(const PreludeTurn& a, const PreludeTurn& b) { return a.cases() == b.cases(); }

private:
    Cases cases_;
};

/// `type Span = record: file, line, column, binding`.
struct Span {
    using prism_value = void;
    Text file_p;
    Nat line_p;
    Nat column_p;
    Text binding_p;
    const Span* operator->() const { return this; }
    auto operator<=>(const Span&) const = default;
    Pod to_pod() const {
        return Pod::record("Span", { {"file", ::prism_rtl::to_pod(file_p)}, {"line", ::prism_rtl::to_pod(line_p)}, {"column", ::prism_rtl::to_pod(column_p)}, {"binding", ::prism_rtl::to_pod(binding_p)} });
    }
    static Result<Span> from_pod(const Pod& p) {
        return Span{.file_p = TRY(::prism_rtl::from_pod<Text>(TRY(field(p, "file")))), .line_p = TRY(::prism_rtl::from_pod<Nat>(TRY(field(p, "line")))), .column_p = TRY(::prism_rtl::from_pod<Nat>(TRY(field(p, "column")))), .binding_p = TRY(::prism_rtl::from_pod<Text>(TRY(field(p, "binding"))))};
    }
};

/// `type Exception = record: kind, message, spans, path`.
struct Exception {
    using prism_value = void;
    Text kind_p;
    Text message_p;
    Array<Span> spans_p;
    std::optional<Path> path_o;
    const Exception* operator->() const { return this; }
    bool operator==(const Exception&) const = default;
    Pod to_pod() const {
        return Pod::record("Exception", { {"kind", ::prism_rtl::to_pod(kind_p)}, {"message", ::prism_rtl::to_pod(message_p)}, {"spans", ::prism_rtl::to_pod(spans_p)}, {"path", ::prism_rtl::to_pod(path_o)} });
    }
    static Result<Exception> from_pod(const Pod& p) {
        return Exception{.kind_p = TRY(::prism_rtl::from_pod<Text>(TRY(field(p, "kind")))), .message_p = TRY(::prism_rtl::from_pod<Text>(TRY(field(p, "message")))), .spans_p = TRY(::prism_rtl::from_pod<Array<Span>>(TRY(field(p, "spans")))), .path_o = TRY(::prism_rtl::from_pod<std::optional<Path>>(TRY(field(p, "path"))))};
    }
};

/// `tag Prelude.Unwrap of Element !a: value: !~a`.
struct PreludeUnwrap {
    using prism_value = void;
    static constexpr const char* TAG = "Prelude.Unwrap";
    bool operator==(const PreludeUnwrap&) const = default;
    Pod to_pod() const { return Pod::element(TAG, {}); }
    void show(Printer& p) const { Show<Pod>::show(to_pod(), p); }
    static Result<PreludeUnwrap> from_pod(const Pod& p) {
        if (auto t = p.tag(); t && *t == TAG) return PreludeUnwrap{};
        return mismatch<PreludeUnwrap>("a Prelude.Unwrap", p);
    }
};

/// `tag Prelude.Exceptions of Element !Exception`.
struct PreludeExceptions {
    using prism_value = void;
    static constexpr const char* TAG = "Prelude.Exceptions";
    bool operator==(const PreludeExceptions&) const = default;
    Pod to_pod() const { return Pod::element(TAG, {}); }
    void show(Printer& p) const { Show<Pod>::show(to_pod(), p); }
    static Result<PreludeExceptions> from_pod(const Pod& p) {
        if (auto t = p.tag(); t && *t == TAG) return PreludeExceptions{};
        return mismatch<PreludeExceptions>("a Prelude.Exceptions", p);
    }
};

/// `Duration`: nanoseconds (D14 keeps its arithmetic out).
struct Duration {
    using prism_value = void;
    Nanos a0;
    auto operator<=>(const Duration&) const = default;
    void show(Printer& p) const { p.duration(a0); }
    Pod to_pod() const { return Pod::duration(a0); }
    static Result<Duration> from_pod(const Pod& whole) {
        if (auto ns = whole.structure().if_duration()) return Duration{*ns};
        return mismatch<Duration>("a Duration", whole.structure());
    }
};

// ---- Numbers ----------------------------------------------------------------------------

/// `^Num` (Type System ch. 3) over a type variable: the operators by name.
namespace Num {
inline Nat add(const Nat& a, const Nat& b) { return a + b; }
inline Nat sub(const Nat& a, const Nat& b) { return a.checked_sub(b).value_or(Nat(0u)); }
inline Nat mul(const Nat& a, const Nat& b) { return a * b; }
inline std::optional<Nat> div_opt(const Nat& a, const Nat& b) { return a.div(b); }
inline std::optional<Nat> sub_opt(const Nat& a, const Nat& b) { return a.checked_sub(b); }
inline Int add(const Int& a, const Int& b) { return a + b; }
inline Int sub(const Int& a, const Int& b) { return a - b; }
inline Int mul(const Int& a, const Int& b) { return a * b; }
inline std::optional<Int> div_opt(const Int& a, const Int& b) { return a.div(b); }
inline Float add(Float a, Float b) { return a + b; }
inline Float sub(Float a, Float b) { return a - b; }
inline Float mul(Float a, Float b) { return a * b; }
inline std::optional<Float> div_opt(Float a, Float b) { return a / b; }
inline std::uint8_t add(std::uint8_t a, std::uint8_t b) { return std::uint8_t(a + b); }
inline std::uint8_t sub(std::uint8_t a, std::uint8_t b) { return std::uint8_t(a - b); }
inline std::uint8_t mul(std::uint8_t a, std::uint8_t b) { return std::uint8_t(a * b); }
inline std::optional<std::uint8_t> div_opt(std::uint8_t a, std::uint8_t b) {
    if (b == 0) return std::nullopt;
    return std::uint8_t(a / b);
}
inline std::optional<std::uint8_t> add_opt(std::uint8_t a, std::uint8_t b) {
    if (a + b > 255) return std::nullopt;
    return std::uint8_t(a + b);
}
inline std::optional<std::uint8_t> sub_opt(std::uint8_t a, std::uint8_t b) {
    if (b > a) return std::nullopt;
    return std::uint8_t(a - b);
}
inline std::optional<std::uint8_t> mul_opt(std::uint8_t a, std::uint8_t b) {
    if (a * b > 255) return std::nullopt;
    return std::uint8_t(a * b);
}
template <class A>
std::optional<A> add_opt(const A& a, const A& b) { return add(a, b); }
template <class A>
std::optional<A> sub_opt(const A& a, const A& b) { return sub(a, b); }
template <class A>
std::optional<A> mul_opt(const A& a, const A& b) { return mul(a, b); }
template <class A>
A zero();
template <> inline Nat zero<Nat>() { return Nat(0u); }
template <> inline Int zero<Int>() { return Int(0); }
template <> inline Float zero<Float>() { return Float{0.0}; }
template <> inline std::uint8_t zero<std::uint8_t>() { return 0; }
}  // namespace Num

/// A `Nat` as an index; one too large for memory indexes nothing.
inline std::size_t ix(const Nat& n) {
    auto i = n.as_int().to_i64();
    return i ? std::size_t(*i) : std::size_t(-1);
}

inline Nat nat_of(std::size_t n) { return Nat::from_int(Int(std::int64_t(n))).value_or(Nat(0u)); }

/// `Int: fn Nat -> Int`.
inline Int int_(const Nat& n) { return n.as_int(); }

/// `?Nat: fn Int -> ?Nat`.
inline std::optional<Nat> nat(const Int& i) { return Nat::from_int(i); }

/// `?U8: fn Int -> ?U8`.
inline std::optional<std::uint8_t> u8_(const Int& i) {
    auto n = i.to_i64();
    if (!n || *n < 0 || *n > 255) return std::nullopt;
    return std::uint8_t(*n);
}

template <class A>
std::optional<A> div(const A& a, const A& b) { return Num::div_opt(a, b); }

inline std::optional<Int> mod_(const Int& a, const Int& b) {
    if (b == Int(0)) return std::nullopt;
    return a.modulo(b);
}
inline std::optional<Nat> mod_(const Nat& a, const Nat& b) {
    if (b == Nat(0u)) return std::nullopt;
    return a.modulo(b);
}
inline std::optional<std::uint8_t> mod_(std::uint8_t a, std::uint8_t b) {
    if (b == 0) return std::nullopt;
    return std::uint8_t(a % b);
}

inline Float float_(const Int& i) {
    auto n = i.to_i64();
    return Float{n ? double(*n) : std::stod(i.to_string())};
}
inline Float to_float(const Int& i) { return float_(i); }
inline Float cos(Float x) { return Float{std::cos(x.v)}; }
inline Float sin(Float x) { return Float{std::sin(x.v)}; }

template <class A>
A abs(const A& a) { return a < Num::zero<A>() ? Num::sub(Num::zero<A>(), a) : a; }

template <class A>
A sum(const Array<A>& xs) {
    A acc = Num::zero<A>();
    for (const A& x : xs) acc = Num::add(acc, x);
    return acc;
}

template <class A>
A max(const A& a, const A& b) { return a < b ? b : a; }
template <class A>
A min(const A& a, const A& b) { return b < a ? b : a; }

/// `Compare` of `^Ord`.
template <class A>
Ordering compare(const A& a, const A& b) {
    if (a < b) return Ordering::Less{};
    if (b < a) return Ordering::Greater{};
    return Ordering::Equal{};
}

// ---- Optionals --------------------------------------------------------------------------

/// `Or: fn ?a, a -> a`.
template <class A, class D>
A or_(const std::optional<A>& o, const D& d) { return o ? *o : A(d); }

// ---- Arrays -----------------------------------------------------------------------------

template <class A>
Nat len(const Array<A>& xs) { return nat_of(xs.size()); }
inline Nat len_text(const Text& t) { return nat_of(t.len()); }
template <class K, class V>
Nat len_map(const Map<K, V>& m) { return nat_of(m.size()); }

/// `[a]+` and `(K ==> V)+` (Type System ch. 2, "Collections"): a collection with at least
/// one entry, a type of its own beside its collection's, so an impl for `[a]+` and one for
/// `[a]` are impls for two types and a generic function has an instantiation at each. It
/// is read as the collection it is (its base class, `plain_collection`), and compares,
/// prints and travels as plain data as that collection does. Only a non-empty literal
/// (`non_empty_of`) and the checked conversion (`non_empty`, `non_empty_map`) make one.
template <class C>
struct NonEmpty : C {
    using prism_value = void;
    NonEmpty() = default;
    explicit NonEmpty(C collection) : C(::std::move(collection)) {}
    bool operator==(const NonEmpty& other) const { return static_cast<const C&>(*this) == static_cast<const C&>(other); }
    auto operator<=>(const NonEmpty& other) const { return static_cast<const C&>(*this) <=> static_cast<const C&>(other); }
    void show(Printer& p) const { Show<C>::show(static_cast<const C&>(*this), p); }
    Pod to_pod() const { return ToPod<C>::to_pod(static_cast<const C&>(*this)); }
    // Only a World hands a program data, and an empty collection is not a non-empty one's.
    static Result<NonEmpty> from_pod(const Pod& whole) {
        auto collection = prism_rtl::from_pod<C>(whole);
        if (!collection) return unexpected(collection.error());
        if (collection.value().size() == 0) return mismatch<NonEmpty>("a non-empty collection", whole);
        return NonEmpty(::std::move(collection).value());
    }
};

// `[[x, y]]+`, `{k: v}+`: a non-empty literal's collection, which the checker saw an entry in.
template <class C>
NonEmpty<C> non_empty_of(C collection) { return NonEmpty<C>(::std::move(collection)); }

// A non-empty collection where its collection is wanted (the one implicit conversion).
template <class C>
const C& plain_collection(const NonEmpty<C>& xs) { return xs; }

// `xs as [a]+?`: the non-empty collection when the collection has an element (Type System
// ch. 2, "Collections").
template <class A>
::std::optional<NonEmpty<Array<A>>> non_empty(const Array<A>& xs) { if (xs.size() > 0) return NonEmpty<Array<A>>(xs); return ::std::nullopt; }
template <class K, class V>
::std::optional<NonEmpty<Map<K, V>>> non_empty_map(const Map<K, V>& m) { if (m.size() > 0) return NonEmpty<Map<K, V>>(m); return ::std::nullopt; }

template <class A>
Array<A> append(const Array<A>& a, const Array<A>& b) { return a.concat(b); }
template <class A>
Array<A> push(const Array<A>& xs, const A& x) { return xs.pushed(x); }

template <class A, class B, class F>
B fold(const Array<A>& xs, const B& init, const F& f) {
    B acc = init;
    for (const A& x : xs) acc = f(acc, x);
    return acc;
}
template <class K, class V, class B, class F>
B fold_map(const Map<K, V>& m, const B& init, const F& f) {
    B acc = init;
    for (const auto& [k, v] : m) acc = f(acc, k, v);
    return acc;
}
template <class A, class F>
auto each(const Array<A>& xs, const F& f) {
    using B = std::decay_t<std::invoke_result_t<const F&, const A&>>;
    std::vector<B> out;
    out.reserve(xs.size());
    for (const A& x : xs) out.push_back(f(x));
    return Array<B>(std::move(out));
}
template <class A, class F>
Array<A> filter(const Array<A>& xs, const F& keep) {
    std::vector<A> out;
    for (const A& x : xs)
        if (keep(x)) out.push_back(x);
    return Array<A>(std::move(out));
}
inline Text concat(const Array<Text>& xs) {
    std::size_t n = 0;
    for (const Text& t : xs) n += t.len();
    std::string s;
    s.reserve(n);
    for (const Text& t : xs) s += t.view();
    return Text::of_utf8(std::move(s));
}

/// `xs[i]`.
template <class A>
std::optional<A> index(const Array<A>& xs, const Nat& i) {
    if (auto x = xs.get(ix(i))) return *x;
    return std::nullopt;
}

/// `&xs[i]` in an `&` block.
template <class A>
A& at_mut(Array<A>& xs, const Nat& i) { return xs.mut_at(ix(i)); }
template <class K, class V>
V& at_mut_map(Map<K, V>& m, const K& k) {
    V* v = m.mut_get(k);
    if (!v) panic("an `&` path to a key the map does not hold");
    return *v;
}

/// `&xs[i] <= v` in an `&` block: an array has no entry to remove.
template <class A>
void set_index(Array<A>& xs, const Nat& i, std::optional<A> v) {
    if (!v) panic(str("`&xs[", i, "] <= nil`: an array's entry cannot be removed"));
    xs.set(ix(i), std::move(*v));
}
/// The part a named lens names at an array's index (Semantics ch. 5): the entry in place,
/// or none past the array's end.
template <class A>
A* part_mut(Array<A>& xs, const Nat& i) {
    if (!xs.get(ix(i))) return nullptr;
    return &xs.mut_at(ix(i));
}
/// `&Lens r <= v` where the lens ends at an array's index: `? x` writes the entry, as
/// `set_index` does; an array has no entry to remove, and none to write past its end.
template <class A>
void set_part(A* part, std::optional<A> v) {
    if (!v) panic("a lens to an array's index set to `nil`: an array's entry cannot be removed");
    if (!part) panic("a lens to an index the array does not hold");
    *part = std::move(*v);
}
/// `&m[k] <= v` in an `&` block: `? x` writes the key, `nil` removes it.
template <class K, class V>
void set_key(Map<K, V>& m, const K& k, std::optional<V> v) {
    if (v) m.insert(k, std::move(*v));
    else m.remove(k);
}

template <class A>
Array<A> take(const Array<A>& xs, const Nat& n) { return xs.take(std::min(ix(n), xs.size())); }
template <class A>
Array<A> drop(const Array<A>& xs, const Nat& n) { return xs.drop_front(std::min(ix(n), xs.size())); }

// ---- Maps -------------------------------------------------------------------------------

template <class K, class V>
Map<K, V> map_of(std::vector<std::tuple<K, V>> entries) {
    Map<K, V> m;
    for (auto& [k, v] : entries) m.insert(std::move(k), std::move(v));
    return m;
}
template <class K, class V>
Map<K, V> insert(const Map<K, V>& m, const K& k, const V& v) { return m.inserted(k, v); }
template <class K, class V>
Map<K, V> remove(const Map<K, V>& m, const K& k) { return m.removed(k); }
/// `?Get`, and `m[k]`.
template <class K, class V>
std::optional<V> get(const Map<K, V>& m, const K& k) {
    if (auto v = m.get(k)) return *v;
    return std::nullopt;
}
/// `?First`.
template <class K, class V>
std::optional<std::tuple<K, V>> first(const Map<K, V>& m) {
    if (m.empty()) return std::nullopt;
    auto it = m.begin();
    return std::tuple<K, V>(it->first, it->second);
}
template <class K, class V>
Array<K> keys(const Map<K, V>& m) {
    std::vector<K> out;
    for (const auto& [k, v] : m) out.push_back(k);
    return Array<K>(std::move(out));
}
template <class K, class V>
Array<V> values(const Map<K, V>& m) {
    std::vector<V> out;
    for (const auto& [k, v] : m) out.push_back(v);
    return Array<V>(std::move(out));
}
template <class K, class V>
Nat size(const Map<K, V>& m) { return nat_of(m.size()); }
/// A host's rows (`::prism_rtl::Rows`, shared), as `Map::values` reads them.
template <class K, class V>
Array<V> values(const ::prism_rtl::Rc<Map<K, V>>& m) { return values(*m); }
template <class K, class V>
Map<K, V> map(const Array<std::tuple<K, V>>& entries) {
    Map<K, V> m;
    for (const auto& [k, v] : entries) m.insert(k, v);
    return m;
}
/// `Union a, b`: `a`'s entries over `b`'s.
template <class K, class V>
Map<K, V> union_(const Map<K, V>& a, const Map<K, V>& b) {
    return a.united(b);
}
template <class K, class V, class F>
auto each_map(const Map<K, V>& m, const F& f) {
    using B = std::decay_t<std::invoke_result_t<const F&, const K&, const V&>>;
    std::vector<B> out;
    for (const auto& [k, v] : m) out.push_back(f(k, v));
    return Array<B>(std::move(out));
}
template <class K, class V, class F>
Map<K, V> filter_map(const Map<K, V>& m, const F& keep) {
    Map<K, V> out;
    for (const auto& [k, v] : m)
        if (keep(k, v)) out.insert(k, v);
    return out;
}

// ---- Text -------------------------------------------------------------------------------

/// `Text: fn Char -> Text`: the character as a one-character text, its UTF-8.
inline Text text(char32_t c) {
    std::string s;
    ::prism_rtl::utf8_push(s, c);
    return Text::of_utf8(std::move(s));
}

/// `?CharOf: fn Nat -> ?Char`: the character of a code point, none past `10FFFF` or for a
/// surrogate.
inline std::optional<char32_t> char_of(const Nat& n) {
    auto v = n.as_int().to_i64();
    if (!v || *v > 0x10FFFF || (*v >= 0xD800 && *v <= 0xDFFF)) return std::nullopt;
    return char32_t(*v);
}
/// `Upper`, `Lower`: Unicode's default full case mapping, as Rust's `str::to_uppercase`
/// and `to_lowercase` (runtime/cpp/README.md, "Upper and Lower").
inline Text upper(const Text& t) { return text_upper(t); }
inline Text lower(const Text& t) { return text_lower(t); }

/// `SplitOn t, sep`: the pieces between the separators (not in Appendix B, whose `Split`
/// is a regular expression's). An empty separator cuts at every character boundary.
inline Array<Text> split_on(const Text& t, const Text& sep) {
    // An empty separator is `Split` of the empty pattern (Appendix B): it matches at every
    // character boundary, so an empty text at each end and each character between.
    if (sep.is_empty()) return Regex::lit("", "").split(t);
    return Array<Text>(t.split(sep.view()));
}

/// `Front: fn Text -> Cursor`.
inline Cursor front(const Text& t) { return Cursor::front(t); }
/// `Back: fn Text -> Cursor`.
inline Cursor back(const Text& t) { return Cursor::back(t); }
/// `?Step: fn Cursor -> ?((Char, Cursor))`.
inline std::optional<std::tuple<char32_t, Cursor>> step(const Cursor& c) {
    auto s = c.step();
    if (!s) return std::nullopt;
    return std::tuple<char32_t, Cursor>(s->first, std::move(s->second));
}
/// `?StepBack: fn Cursor -> ?((Char, Cursor))`.
inline std::optional<std::tuple<char32_t, Cursor>> step_back(const Cursor& c) {
    auto s = c.step_back();
    if (!s) return std::nullopt;
    return std::tuple<char32_t, Cursor>(s->first, std::move(s->second));
}
/// `Before: fn Cursor -> Text`.
inline Text before(const Cursor& c) { return c.before(); }
/// `After: fn Cursor -> Text`.
inline Text after(const Cursor& c) { return c.after(); }
/// `At: fn Cursor -> Nat`.
inline Nat at(const Cursor& c) { return nat_of(c.at()); }
/// `?CursorAt: fn Text, Nat -> ?Cursor`.
inline std::optional<Cursor> cursor_at(const Text& t, const Nat& n) { return Cursor::at_byte(t, ix(n)); }

// ---- Regular expressions (Appendix B; claude/regex-dialect.md) --------------------------
// A literal is built where it stands (`Regex::lit`, a function-local static per literal);
// these are the prelude's functions over prism_rtl's regex.hpp, each the runtime's search.
// `Group` and `Match` are the runtime's records, seen through the prelude's `using namespace prism_rtl`.

/// `?Regex: fn Text -> ?Regex`: the text as a pattern with no flags, none outside the
/// dialect; linear in the text.
inline std::optional<Regex> regex(const Text& t) { return Regex::parse(t); }
/// `?Match: fn Regex, Cursor -> ?Match`: the match that starts at the cursor, seeing the
/// whole text before it.
inline std::optional<Match> match_(const Regex& r, const Cursor& c) { return r.match_at(c); }
/// `?Find: fn Regex, Text -> ?Match`: the leftmost-first match.
inline std::optional<Match> find(const Regex& r, const Text& t) { return r.find(t); }
/// `Matches: fn Regex, Text -> [Match]`: every match, by the iteration rule.
inline Array<Match> matches(const Regex& r, const Text& t) { return r.matches(t); }
/// `Replace: fn RegexReplacement, Text -> Text`: every match replaced.
inline Text replace(const RegexReplacement& r, const Text& t) { return r.replace(t); }
/// `Split: fn Regex, Text -> [Text]`: the `k + 1` views between the `k` matches.
inline Array<Text> split(const Regex& r, const Text& t) { return r.split(t); }

/// An answer's segments with the first, a position, put through `seat`: a node whose
/// places are counted as they are built matches the positions it was lowered with
/// (claude/backend.md, "Positions").
template <class Seat>
std::vector<::prism_rtl::Segment> seated(std::span<const ::prism_rtl::Segment> at, Seat seat) {
    std::vector<::prism_rtl::Segment> out(at.begin(), at.end());
    if (!out.empty() && out.front().kind() == ::prism_rtl::Segment::Kind::Pos) out.front() = ::prism_rtl::Segment::pos(seat(out.front().number()));
    return out;
}

/// Seated segments as a node's arms match them.
inline std::span<const ::prism_rtl::Segment> segments_of(const std::vector<::prism_rtl::Segment>& seated) { return seated; }

/// Whether an answer's first segment is a position among `width` from `from` on: the
/// positions of a generation too wide for an arm each (a widget that calls itself;
/// claude/backend.md, "Positions").
inline bool within_positions(std::span<const ::prism_rtl::Segment> at, ::std::uint32_t from, ::std::uint32_t width) {
    return !at.empty() && at.front().kind() == ::prism_rtl::Segment::Kind::Pos && at.front().number() >= from && at.front().number() - from < width;
}

/// An answer's segments with the first, a position, counted from `from`: as a row
/// numbered from 0 matches it.
inline std::vector<::prism_rtl::Segment> rebased(std::span<const ::prism_rtl::Segment> at, ::std::uint32_t from) {
    std::vector<::prism_rtl::Segment> out(at.begin(), at.end());
    if (!out.empty() && out.front().kind() == ::prism_rtl::Segment::Kind::Pos) out.front() = ::prism_rtl::Segment::pos(out.front().number() - from);
    return out;
}

/// `?ParseNat`.
inline std::optional<Nat> parse_nat_opt(const Text& t) {
    std::string_view s = t.view();
    if (s.empty() || !std::all_of(s.begin(), s.end(), [](char c) { return c >= '0' && c <= '9'; })) return std::nullopt;
    return Nat::from_int(*Int::parse(s));
}

/// `~ParseNat`.
inline Fallible<Nat> parse_nat_try(const Text& t) {
    if (auto n = parse_nat_opt(t)) return *n;
    return unexpected(Error("Prelude.NotANumber", Text(str("not a number: ", t))));
}

/// `Buffer.Numbered n`: `0` to `n - 1`, linear.
inline Array<Nat> numbered(const Nat& n) {
    std::vector<Nat> out;
    for (std::size_t i = 0; i < ix(n); ++i) out.push_back(nat_of(i));
    return Array<Nat>(std::move(out));
}

/// `Freeze`: a `Buffer` is an array already.
template <class A>
A freeze(const A& a) { return a; }

/// A code template's placeholder (Templates ch. 2): alone on its line, its text's lines
/// indented to its column, a final newline dropped, an empty text no line; sharing a line,
/// the text as it is.
inline void place(std::string& out, const Text& text, std::optional<std::size_t> column) {
    std::string_view t = text.view();
    if (!column) {
        out += t;
        return;
    }
    if (!t.empty() && t.back() == '\n') t.remove_suffix(1);
    if (t.empty()) return;
    std::size_t from = 0;
    while (true) {
        std::size_t at = t.find('\n', from);
        std::string_view l = t.substr(from, at == std::string_view::npos ? std::string_view::npos : at - from);
        if (!l.empty()) out.append(*column, ' ');
        out += l;
        out += '\n';
        if (at == std::string_view::npos) break;
        from = at + 1;
    }
}

/// An array as the map from each index to its entry, for a `for` over an array.
template <class A>
Map<Nat, A> indexed(const Array<A>& xs) {
    Map<Nat, A> m;
    std::size_t i = 0;
    for (const A& x : xs) m.insert(nat_of(i++), x);
    return m;
}

/// The heights a node with combinators at several heights asked for this tick: its wake
/// runs the lowest one asked (`Node::wake` is not told its height, prismc/README.md WH).
class Wakes {
public:
    void ask(std::uint32_t h) { asked_.insert(h); }
    std::uint32_t next() {
        if (asked_.empty()) return std::uint32_t(-1);
        std::uint32_t h = *asked_.begin();
        asked_.erase(asked_.begin());
        return h;
    }
    /// After a wake ran one height: a wake for the lowest height still asked (two heights
    /// asked from one running height land on one wake of the node, which runs the lower).
    void again(Cx& cx, NodeRef node) {
        if (!asked_.empty()) cx.wake(*asked_.begin(), std::move(node));
    }

private:
    std::set<std::uint32_t> asked_;
};

// ---- Jobs -------------------------------------------------------------------------------

/// A frame of a job's stack (D6; claude/backend.md, "Unbounded functions and `@Run`"): the
/// caller of `callee`, a call of an unbounded function that was not in tail position,
/// waiting for its result. A continuation runs once.
template <class A, class B>
struct Frame : Job<B> {
    JobRef<A> callee;
    std::function<Turn<B>(A)> then;
    Frame(JobRef<A> callee, std::function<Turn<B>(A)> then) : callee(std::move(callee)), then(std::move(then)) {}
    Turn<B> cycle() const override {
        Turn<A> t = callee->cycle();
        if (auto m = t.if_more()) return Turn<B>::more(::prism_rtl::make_rc<Frame<A, B>>(m->next, then));
        return then(std::move(std::get<typename Turn<A>::Finished>(t.v).value));
    }
};

/// A call that is not in tail position: a cycle point, with `then` the continuation.
template <class A, class F>
auto call_then(JobRef<A> callee, F then) {
    using T = std::invoke_result_t<F, A>;
    using B = typename T::Value;
    return Turn<B>::more(::prism_rtl::make_rc<Frame<A, B>>(std::move(callee), std::move(then)));
}

/// A call through an unbounded function value that is not in tail position: the value's
/// job runs its first cycle now.
template <class A, class F>
auto call_value(JobRef<A> callee, F then) {
    using T = std::invoke_result_t<F, A>;
    using B = typename T::Value;
    return Frame<A, B>(std::move(callee), std::move(then)).cycle();
}

/// A named unbounded function's job as its value gives it: entering it is a cycle point.
template <class B>
struct Entered : Job<B> {
    JobRef<B> job;
    explicit Entered(JobRef<B> job) : job(std::move(job)) {}
    Turn<B> cycle() const override { return Turn<B>::more(job); }
};
template <class B>
JobRef<B> entered(JobRef<B> job) { return ::prism_rtl::make_rc<Entered<B>>(std::move(job)); }

/// A `while` in an `update` block of an unbounded function as a job (D6): each turn is a
/// cycle; `step` answers the next state, or a failure when the condition fails.
template <class S>
struct Looping : Job<S> {
    S state;
    ::prism_rtl::Rc<const std::function<Expected<S, S>(S)>> step;
    Looping(S state, ::prism_rtl::Rc<const std::function<Expected<S, S>(S)>> step) : state(std::move(state)), step(std::move(step)) {}
    Turn<S> cycle() const override {
        Expected<S, S> r = (*step)(state);
        if (r) return Turn<S>::more(::prism_rtl::make_rc<Looping<S>>(std::move(r).value(), step));
        return Turn<S>::finished(r.error());
    }
};
template <class S, class F>
JobRef<S> loop_job(S state, F step) {
    return ::prism_rtl::make_rc<Looping<S>>(std::move(state), ::prism_rtl::make_rc<const std::function<Expected<S, S>(S)>>(std::move(step)));
}

/// A `while` whose body holds a cycle-point loop of its own (D6): a turn is a job.
template <class S>
struct LoopingTurns : Job<S> {
    S state;
    ::prism_rtl::Rc<const std::function<Turn<Expected<S, S>>(S)>> step;
    LoopingTurns(S state, ::prism_rtl::Rc<const std::function<Turn<Expected<S, S>>(S)>> step) : state(std::move(state)), step(std::move(step)) {}
    Turn<S> cycle() const override {
        auto st = step;
        std::function<Turn<S>(Expected<S, S>)> again = [st](Expected<S, S> r) -> Turn<S> {
            if (r) return Turn<S>::more(::prism_rtl::make_rc<LoopingTurns<S>>(std::move(r).value(), st));
            return Turn<S>::finished(r.error());
        };
        Turn<Expected<S, S>> t = (*step)(state);
        if (auto m = t.if_more()) return Turn<S>::more(::prism_rtl::make_rc<Frame<Expected<S, S>, S>>(m->next, again));
        return again(t.if_finished()->value);
    }
};
template <class S, class F>
JobRef<S> loop_turns(S state, F step) {
    return ::prism_rtl::make_rc<LoopingTurns<S>>(std::move(state), ::prism_rtl::make_rc<const std::function<Turn<Expected<S, S>>(S)>>(std::move(step)));
}


/// The job of a lambda of unbounded type: its body, run as a job body from its first
/// cycle (prismc/README.md, pick JB).
template <class B>
struct Once : Job<B> {
    std::function<Turn<B>()> body;
    explicit Once(std::function<Turn<B>()> body) : body(std::move(body)) {}
    Turn<B> cycle() const override { return body(); }
};
template <class F>
auto once_job(F body) {
    using B = typename std::invoke_result_t<F>::Value;
    return JobRef<B>(::prism_rtl::make_rc<Once<B>>(std::move(body)));
}

/// A job's result, mapped: `g` runs in the cycle the job finishes.
template <class B, class G>
auto map_job(JobRef<B> job, G g) {
    using C = std::decay_t<std::invoke_result_t<G, B>>;
    return JobRef<C>(::prism_rtl::make_rc<Frame<B, C>>(std::move(job), [g](B b) { return Turn<C>::finished(g(std::move(b))); }));
}

/// A `for` of an `update` block whose body holds a cycle-point loop (D6, gap LP): a loop
/// over its entries as `loop_turns` is over its condition, taking the next entry its
/// test; `step` takes the block's state and an entry's parts, a turn a job.
template <class S, class E, class F>
JobRef<S> for_turns(std::vector<E> entries, S state, F step) {
    using P = std::pair<S, std::size_t>;
    auto all = ::prism_rtl::make_rc<const std::vector<E>>(std::move(entries));
    auto st = ::prism_rtl::make_rc<const F>(std::move(step));
    JobRef<P> job = loop_turns(P(std::move(state), 0), [all, st](P p) -> Turn<Expected<P, P>> {
        std::size_t i = p.second;
        if (i >= all->size()) return Turn<Expected<P, P>>::finished(Expected<P, P>(unexpected(std::move(p))));
        Turn<S> t = std::apply([&](const auto&... parts) { return (*st)(std::move(p.first), parts...); }, (*all)[i]);
        if (auto m = t.if_more()) return call_then(m->next, [i](S s2) { return Turn<Expected<P, P>>::finished(Expected<P, P>(P(std::move(s2), i + 1))); });
        return Turn<Expected<P, P>>::finished(Expected<P, P>(P(std::move(t.if_finished()->value), i + 1)));
    });
    return map_job(job, [](P p) { return std::move(p.first); });
}

/// `for` over a map in a job (`for_turns`): the key and the entry, in key order.
template <class K, class V, class S, class F>
JobRef<S> for_turns_keyed(Map<K, V> m, S state, F step) {
    std::vector<std::pair<K, V>> entries;
    for (auto&& [k, v] : m) entries.emplace_back(k, v);
    return for_turns(std::move(entries), std::move(state), std::move(step));
}

/// `for` over an array in a job (`for_turns`): the index and the entry.
template <class V, class S, class F>
JobRef<S> for_turns_indexed(Array<V> xs, S state, F step) {
    std::vector<std::pair<Nat, V>> entries;
    for (auto&& [i, v] : ::prism_rtl::enumerate(xs)) entries.emplace_back(nat_of(i), v);
    return for_turns(std::move(entries), std::move(state), std::move(step));
}

// ---- The higher-order functions as jobs (D8) ---------------------------------------------

template <class A, class B, class F>
Turn<B> fold_from(Array<A> xs, std::size_t i, B acc, F f) {
    auto x = xs.get(i);
    if (!x) return Turn<B>::finished(std::move(acc));
    A item = *x;
    return call_value(f(std::tuple<B, A>(std::move(acc), std::move(item))), [xs, i, f](B b) { return fold_from(xs, i + 1, std::move(b), f); });
}
template <class A, class B, class F>
JobRef<B> fold_job(Array<A> xs, B init, F f) {
    return once_job([xs, init, f]() { return fold_from(xs, 0, init, f); });
}
template <class K, class V>
Array<std::tuple<K, V>> pairs_of(const Map<K, V>& m) {
    std::vector<std::tuple<K, V>> out;
    for (const auto& [k, v] : m) out.emplace_back(k, v);
    return Array<std::tuple<K, V>>(std::move(out));
}
template <class K, class V, class B, class F>
JobRef<B> fold_map_job(Map<K, V> m, B init, F f) {
    return fold_job(pairs_of(m), std::move(init), [f](std::tuple<B, std::tuple<K, V>> p) {
        auto& [acc, kv] = p;
        return f(std::tuple<B, K, V>(acc, std::get<0>(kv), std::get<1>(kv)));
    });
}
template <class A, class F>
auto each_job(Array<A> xs, F f) {
    using B = typename std::invoke_result_t<F, A>::element_type::Value;
    return fold_job(std::move(xs), Array<B>(), [f](std::tuple<Array<B>, A> p) {
        auto acc = std::get<0>(p);
        return map_job(f(std::get<1>(p)), [acc](B b) { return acc.pushed(std::move(b)); });
    });
}
template <class K, class V, class F>
auto each_map_job(Map<K, V> m, F f) {
    return each_job(pairs_of(m), std::move(f));
}
template <class A, class F>
JobRef<Array<A>> filter_job(Array<A> xs, F keep) {
    return fold_job(std::move(xs), Array<A>(), [keep](std::tuple<Array<A>, A> p) {
        auto acc = std::get<0>(p);
        auto x = std::get<1>(p);
        return map_job(keep(x), [acc, x](bool k) { return k ? acc.pushed(x) : acc; });
    });
}
template <class K, class V, class F>
JobRef<Map<K, V>> filter_map_job(Map<K, V> m, F keep) {
    return fold_job(pairs_of(m), Map<K, V>(), [keep](std::tuple<Map<K, V>, std::tuple<K, V>> p) {
        auto acc = std::get<0>(p);
        auto kv = std::get<1>(p);
        return map_job(keep(kv), [acc, kv](bool k) { return k ? acc.inserted(std::get<0>(kv), std::get<1>(kv)) : acc; });
    });
}

/// A local function that calls itself: `step` is the function as one closure that takes
/// itself first (what its body calls for its own name) and its arguments as one value.
template <class A, class R, class F>
R recursive(const F& step, A first) {
    ::std::function<R(A)> again = [&](A next) -> R { return step(again, std::move(next)); };
    return again(std::move(first));
}

/// A job run to its result inside the cycle: a call of an unbounded function value from
/// direct-style code (gap DS of prismc/README.md).
template <class B>
B run_to_end(JobRef<B> job) {
    while (true) {
        Turn<B> t = job->cycle();
        if (auto m = t.if_more()) job = m->next;
        else return std::move(std::get<typename Turn<B>::Finished>(t.v).value);
    }
}

// ---- Running ----------------------------------------------------------------------------

/// `--world NAME` as the first argument: the World, and the arguments without the option.
inline std::pair<std::string, std::vector<std::string>> world_option(const std::vector<std::string>& args, const std::string& fallback) {
    if (args.size() > 1 && args[0] == "--world") return {args[1], std::vector<std::string>(args.begin() + 2, args.end())};
    if (!args.empty() && args[0].rfind("--world=", 0) == 0) return {args[0].substr(8), std::vector<std::string>(args.begin() + 1, args.end())};
    return {fallback, args};
}

inline std::optional<std::string> read_file(const std::string& path) {
    std::ifstream f(path, std::ios::binary);
    if (!f) return std::nullopt;
    std::stringstream s;
    s << f.rdbuf();
    return s.str();
}

/// `test`: each script under the Test World. With `--print` the transcripts go to standard
/// output as they are; otherwise each is compared byte for byte with the `.expected` beside
/// it (`tests.expected` for the test module `tests.prism`), and `ok` or the
/// difference is printed.
inline int run_scripts(const TestWorld& world, const std::vector<std::string>& given, const std::vector<std::string>& compiled) {
    bool print = std::find(given.begin(), given.end(), "--print") != given.end();
    std::vector<std::string> paths;
    for (const auto& a : given)
        if (a != "--print") paths.push_back(a);
    if (paths.empty()) paths = compiled;
    int code = 0;
    for (const auto& path : paths) {
        auto script = read_file(path);
        if (!script) {
            std::fprintf(stderr, "%s: cannot read the script\n", path.c_str());
            code = 2;
            continue;
        }
        // a test module's transcript is beside it, its `.prism` dropped
        std::string stem = path.size() > 6 && path.substr(path.size() - 6) == ".prism" ? path.substr(0, path.size() - 6) : path;
        auto expected = print ? std::nullopt : read_file(stem + ".expected");
        if (!expected) {
            Report report = world.run(*script);
            std::fwrite(report.transcript.data(), 1, report.transcript.size(), stdout);
            for (const auto& f : report.failures) std::fprintf(stderr, "%s: %s\n", path.c_str(), f.c_str());
            code = std::max(code, int(report.exit_code));
            continue;
        }
        auto verdict = world.verify(*script, *expected);
        if (verdict) std::printf("ok %s\n", path.c_str());
        else {
            std::printf("FAILED %s: %s\n", path.c_str(), verdict.error().c_str());
            code = 1;
        }
    }
    std::fflush(stdout);
    return code;
}

/// Run on a thread with a large stack (4 GB, committed as it is used): unbounded code runs
/// direct-style within a cycle (doubt DS of prismc/README.md), and a C++ frame of the
/// emitted code is larger than Rust's, whose runner takes 1 GB.
inline int on_big_stack(std::function<int()> f) {
    struct Job {
        std::function<int()> f;
        int code = 1;
    } job{std::move(f)};
    pthread_attr_t attr;
    pthread_attr_init(&attr);
    pthread_attr_setstacksize(&attr, std::size_t(4) << 30);
    pthread_t t;
    auto run = [](void* p) -> void* {
        auto* j = static_cast<Job*>(p);
        j->code = j->f();
        return nullptr;
    };
    if (pthread_create(&t, &attr, run, &job) != 0) {
        std::fprintf(stderr, "prism: no thread with a 4 GB stack: running on the main thread's\n");
        return job.f();
    }
    pthread_join(t, nullptr);
    pthread_attr_destroy(&attr);
    return job.code;
}

/// A port's firing from an event method, which returns nothing to pass a fault on through
/// (prismc/README.md, PF). No fault reaches here today: a port's subscribers (a row's
/// event method, a host's blueprint) return success, and every fault a firing can raise goes
/// by `Cx::fail_later` or the tick's own result. A fault that ever does is a bug, so it
/// stops the program naming it rather than being lost.
inline void no_fault(const Done& d) {
    if (!d) panic("a fault reached a port's firing, which has no way to pass it on (PF): " + d.error().to_string());
}

/// A value as a dynamic, where a function takes the dynamic whole (gap LF): `$ v`, or a
/// reader's value at the read point.
template <class T>
Dynamic<T> dyn_constant(T v) { return Dynamic<T>::constant(std::move(v)); }

/// `!MergeAll` of a list as an event value (a merge made where `!MergeAll` is lifted over a
/// dynamic list, Type System ch. 4): prism_rtl's own node decides each tick's firing.
template <class T>
Event<Array<T>> merge_all(const Array<Event<T>>& events) { return ::prism_rtl::merge_all(events); }

/// `!Union a, b` as an event value (in a plain function's body): `!MergeAll` of the two,
/// the maps that fired joined as `Union` joins.
template <class K, class V>
Event<Map<K, V>> union_ev(const Event<Map<K, V>>& a, const Event<Map<K, V>>& b) {
    return ::prism_rtl::merge_all(Array<Event<Map<K, V>>>{a, b}).map([](const Array<Map<K, V>>& fired) {
        Map<K, V> all;
        for (const auto& one : fired) all = union_(all, one);
        return all;
    });
}

/// `!MergeWith f, events` as an event value: `!MergeAll` of the list, the values that
/// fired folded by `f` in the list's order.
template <class F, class T>
Event<T> merge_with(F f, const Array<Event<T>>& events) {
    return ::prism_rtl::merge_all(events).map([f](const Array<T>& fired) {
        auto it = fired.begin();
        T all = *it;
        for (++it; it != fired.end(); ++it) all = f(all, *it);
        return all;
    });
}

/// A value given for a generic tag's field or answer, as the tag's own types hold it: the
/// same plain data at the type with each of the tag's variables a `Pod` (and back). The
/// two types differ only there, so the decoding cannot fail.
template <class U, class T>
U recode(const T& v) {
    auto decoded = ::prism_rtl::from_pod<U>(::prism_rtl::to_pod(v));
    if (!decoded) panic("a prismc bug: a generic tag's value did not recode");
    return std::move(*decoded);
}

/// A fault kind as a value (`Fs.NotFound` named, an `Error`'s `kind` read): its name, the
/// choice with no arguments it crosses to a World as.
inline Pod fault_kind(const std::string& name) { return Pod::name(name); }

/// `e.kind`.
inline Pod kind_of(const Error& e) { return Pod::name(e.kind_p); }

/// `Error(kind=k, message=m)` with `k` a value.
inline Error error_of(const Pod& kind, Text message) {
    const Pod::Choice* c = kind.structure().if_choice();
    if (!c) panic("an `Error` of a kind that is no fault kind");
    return Error(c->ctor, std::move(message));
}

/// `!Updated $d` as an event value (in a supplier's answer, or in a function that takes
/// the dynamic whole): it fires `d`'s value after the tick, in the tick `d`'s update event
/// fires (Semantics ch. 7, R3).
template <class T>
Event<T> updated(const Dynamic<T>& d) {
    auto port = ::prism_rtl::make_rc<Port<T>>();
    d.updates->subscribe([port, d](const Unit&, Cx& cx) -> Done {
        return port->fire(cx.after([&](const Cx& at) { return d.sample(at); }), cx);
    });
    return Event<T>{nullptr, port};
}

/// The root under the CLI World (`worlds/cli/cpp`).
template <class P>
int run_cli(const std::vector<std::string>& args) { return ::prism_world_cli::run<P>(args); }

}  // namespace prelude

}  // namespace crate
</cpp>

# The prelude's part that names the program's `Elem` and `Answer`: a row, and a row
# subscribing to its block's port.
CppPreludeRows: fn Text -> Text
fn CppPreludeRows unused = inline_text <cpp>
/// A row of a `for` or a generation of a `rebuild`: a node its builder tears down. A row
/// of a hosted child's (prismc/README.md, pick HO) is an entry of its host's document: its
/// own places' entries, by their paths relative to the row, and a host's typed answer to
/// one of them.
class Row : public Node {
public:
    virtual void leave_row(Cx& cx) = 0;
    virtual std::vector<std::tuple<Path, ::prism_rtl::Rc<::prism_rtl::Entry<Elem>>>> document(const Cx& cx) const {
        static_cast<void>(cx);
        return {};
    }
    virtual Done deliver(std::span<const Segment> at, const Answer& v, Cx& cx) {
        static_cast<void>(v);
        static_cast<void>(cx);
        return unexpected(Fault::answer(str("no hosted place at ", path_of(at), " to answer: the row is not hosted")));
    }
};

/// A widget's row as its blueprint built it (prism_rtl's `widget_blueprint`): the row as a
/// node, its leaving, how many places it built, the widget's plain result, and, for a
/// row built in a hosted scope, its places' entries and a host's typed answer to one.
template <class N, class R>
::prism_rtl::BuiltWidget<Elem, Answer, R> built_widget(std::uint32_t built, R result, ::prism_rtl::Rc<N> row) {
    return ::prism_rtl::BuiltWidget<Elem, Answer, R>{
        row,
        [row](Cx& cx) { row->leave_row(cx); },
        built,
        std::move(result),
        [row](const Cx& cx) { return row->document(cx); },
        [row](std::span<const Segment> at, const Answer& v, Cx& cx) -> Done { return row->deliver(at, v, cx); }};
}

/// A blueprint value a block applied: what it built, as the block's generation at the
/// line. A World's answer under it goes to the blueprint's node, the position counted
/// from the blueprint's first. In a hosted scope its places are entries of the host's
/// document: a widget's row's own, or the one place of an element forwarded or placed,
/// at the base the blueprint was built from, whose answer from the host goes to the
/// blueprint's sink.
class AppliedBlueprint : public Row {
public:
    AppliedBlueprint(::prism_rtl::Supplied<Elem, Answer> supplied, std::uint32_t base, ::prism_rtl::Sink<Answer> sink)
        : supplied_(std::move(supplied)), base_(base), sink_(std::move(sink)) {}
    Done answer(std::span<const Segment> at, const Pod& v, Cx& cx) override {
        return supplied_.node->answer(at, v, cx);
    }
    void leave_row(Cx& cx) override {
        if (supplied_.leave) supplied_.leave(cx);
        else cx.keep(supplied_.node->leave(cx));
    }
    std::vector<std::tuple<Path, ::prism_rtl::Rc<::prism_rtl::Entry<Elem>>>> document(const Cx& cx) const override {
        if (supplied_.document) return supplied_.document(cx);
        std::vector<std::tuple<Path, ::prism_rtl::Rc<::prism_rtl::Entry<Elem>>>> out;
        if (supplied_.entry) out.emplace_back(Path::root().at(base_), supplied_.entry);
        return out;
    }
    Done deliver(std::span<const Segment> at, const Answer& v, Cx& cx) override {
        if (supplied_.deliver) return supplied_.deliver(at, v, cx);
        if (at.size() == 1 && at[0].is_pos(0) && supplied_.entry) return sink_(v, cx);
        return unexpected(Fault::answer(str("no hosted place at ", path_of(at), " under a blueprint value applied")));
    }

private:
    ::prism_rtl::Supplied<Elem, Answer> supplied_;
    std::uint32_t base_;
    ::prism_rtl::Sink<Answer> sink_;
};

/// The scope a blueprint value is applied in: the World's, or the host's whose document
/// the applying block's places are entries of.
inline ::prism_rtl::Scope<Elem, Answer> applied_scope(std::optional<::prism_rtl::Rc<::prism_rtl::HostOf<Elem, Answer>>> hosted) {
    return hosted ? ::prism_rtl::Scope<Elem, Answer>::in(*hosted) : ::prism_rtl::Scope<Elem, Answer>::world();
}

/// A blueprint value applied by a line that hears it (`!go <- @Element e`): built at the
/// block's path, its places numbered from `base`, in the block's scope (`hosted` the host
/// of a block in a hosted scope), with `hear` the blueprint's sink, called with each
/// answer to the place the blueprint answers, in the tick the answer comes. Gives the
/// generation and how many places it built.
template <class Hear>
Result<std::tuple<::prism_rtl::Rc<Row>, std::uint32_t>> apply_blueprint_heard(const ::prism_rtl::Blueprint<Elem, Answer>& blueprint, Path path, std::uint32_t base, std::optional<::prism_rtl::Rc<::prism_rtl::HostOf<Elem, Answer>>> hosted, Hear hear, Cx& cx) {
    ::prism_rtl::Sink<Answer> sink = [hear = std::move(hear)](const Answer& answer, Cx& cx) -> Done { return hear(answer, cx); };
    auto supplied = TRY(blueprint(std::move(path), sink, applied_scope(std::move(hosted)), base, cx));
    std::uint32_t built = supplied.built;
    return std::tuple<::prism_rtl::Rc<Row>, std::uint32_t>{::prism_rtl::make_rc<AppliedBlueprint>(std::move(supplied), base, sink), built};
}

/// A blueprint value applied by a line that binds its plain result (`n <- @t`): as
/// `apply_blueprint`, with the first answer of the place the blueprint answers, which a
/// blueprint that gives a plain value has at its build.
inline Result<std::tuple<::prism_rtl::Rc<Row>, std::uint32_t, Answer>> apply_blueprint_answered(const ::prism_rtl::Blueprint<Elem, Answer>& blueprint, Path path, std::uint32_t base, std::optional<::prism_rtl::Rc<::prism_rtl::HostOf<Elem, Answer>>> hosted, Cx& cx) {
    ::prism_rtl::Sink<Answer> sink = [](const Answer&, Cx&) -> Done { return {}; };
    auto supplied = TRY(blueprint(std::move(path), sink, applied_scope(std::move(hosted)), base, cx));
    std::uint32_t built = supplied.built;
    if (!supplied.first) return unexpected(Fault::answer("a blueprint value that gives a plain value answered nothing at its build"));
    Answer first = *supplied.first;
    return std::tuple<::prism_rtl::Rc<Row>, std::uint32_t, Answer>{::prism_rtl::make_rc<AppliedBlueprint>(std::move(supplied), base, sink), built, std::move(first)};
}

/// A blueprint value applied by a line that binds a dynamic (`$d <- @$t`): as
/// `apply_blueprint`, with the dynamic the blueprint gives: its value at the build the
/// first answer of the place the blueprint answers, and each later answer a new value,
/// in the tick the answer comes. `take` reads an answer at the line's type.
template <class Take>
auto apply_blueprint_dynamic(const ::prism_rtl::Blueprint<Elem, Answer>& blueprint, Path path, std::uint32_t base, std::optional<::prism_rtl::Rc<::prism_rtl::HostOf<Elem, Answer>>> hosted, Take take, Cx& cx) {
    using T = typename std::invoke_result_t<Take, const Answer&>::value_type;
    using Made = std::tuple<::prism_rtl::Rc<Row>, std::uint32_t, ::prism_rtl::Dynamic<T>>;
    auto cell = ::prism_rtl::make_rc<std::optional<::prism_rtl::Hold<T>>>();
    auto updates = ::prism_rtl::make_rc<::prism_rtl::Port<Unit>>();
    ::prism_rtl::Sink<Answer> sink = [cell, updates, take](const Answer& answer, Cx& cx) -> Done {
        auto v = TRY(take(answer));
        if (!*cell) return unexpected(Fault::answer("a blueprint value that gives a dynamic was answered before its build ended"));
        (*cell)->set(std::move(v), cx);
        return updates->fire(Unit{}, cx);
    };
    auto run = [&]() -> Result<Made> {
        auto supplied = TRY(blueprint(std::move(path), sink, applied_scope(std::move(hosted)), base, cx));
        std::uint32_t built = supplied.built;
        // a widget's dynamic result, held whole: the line's dynamic is the widget's own
        if (supplied.first) if (auto live = supplied.first->template held_as<::prism_rtl::Dynamic<T>>()) return Made{::prism_rtl::make_rc<AppliedBlueprint>(std::move(supplied), base, sink), built, *live};
        if (!supplied.first) return unexpected(Fault::answer("a blueprint value that gives a dynamic answered nothing at its build"));
        auto first = TRY(take(*supplied.first));
        cell->emplace(std::move(first), cx);
        auto read = [cell](const Cx& cx) { return (*cell)->get(cx); };
        return Made{::prism_rtl::make_rc<AppliedBlueprint>(std::move(supplied), base, sink), built, ::prism_rtl::Dynamic<T>{nullptr, read, updates}};
    };
    return run();
}

/// An answer made outside a tag's arm (a widget's plain result as a blueprint value
/// gives it), read at the type of the line that binds it.
template <class T, class A>
Result<T> answer_plain(const A& answer) {
    return answer.template plain<T>();
}

/// An answer made outside a tag's arm that is no plain data: a widget's result as a
/// blueprint value gives it when it is a function, a dynamic, or a bundle with its events
/// and dynamics whole. Held as it is, and read back at the type of the line that binds it.
template <class T>
Answer answer_held(T v) {
    return Answer(Answer::Held_a{std::any(std::move(v))});
}

/// A blueprint whose held answers are made again (`answer_held`): one that holds the
/// output whole, a `W`, through `whole`; one that holds one firing's or one move's value,
/// a `P`, through `part`. Any other answer holds no such value and is itself.
/// (`W` and `P` are the two closures' parameter types.)
template <class Closure, class Result, class Held>
Held held_parameter_of(Result (Closure::*)(const Held&) const);

template <class Whole, class Part>
::prism_rtl::Blueprint<Elem, Answer> held_answers_mapped(::prism_rtl::Blueprint<Elem, Answer> blueprint, Whole whole, Part part) {
    using W = decltype(held_parameter_of(&Whole::operator()));
    using P = decltype(held_parameter_of(&Part::operator()));
    return ::prism_rtl::answers_mapped<Elem, Answer>(std::move(blueprint), [whole, part](const Answer& answer) -> Answer {
        if (auto held = answer.template held_as<W>()) return answer_held(whole(*held));
        if (auto held = answer.template held_as<P>()) return answer_held(part(*held));
        return answer;
    });
}

/// An answer held whole (`answer_held`), read at the type of the line that binds it.
template <class T, class A>
Result<T> held_answer(const A& answer) {
    return answer.template held<T>();
}

/// A blueprint value applied by a line that binds a bundle (`((step, !go)) <- @t`): as
/// `apply_blueprint`, with the bundle as one value `W`, its events and dynamics whole.
/// A widget's blueprint answers with that value held whole (`answer_held`), once, at its
/// build. Any other blueprint answers as a bundle's tag does: `state` reads an answer
/// that is the state (`first` for the answer at the build), `event` one that is the event
/// parts', and `whole` makes the bundle of the state as a dynamic and of the event the
/// later answers fire.
template <class W, class S, class V, class State, class Heard, class Whole>
Result<std::tuple<::prism_rtl::Rc<Row>, std::uint32_t, W>> apply_blueprint_whole(const ::prism_rtl::Blueprint<Elem, Answer>& blueprint, Path path, std::uint32_t base, std::optional<::prism_rtl::Rc<::prism_rtl::HostOf<Elem, Answer>>> hosted, State state, Heard event, Whole whole, Cx& cx) {
    using Made = std::tuple<::prism_rtl::Rc<Row>, std::uint32_t, W>;
    auto cell = ::prism_rtl::make_rc<std::optional<::prism_rtl::Hold<S>>>();
    auto updates = ::prism_rtl::make_rc<::prism_rtl::Port<Unit>>();
    auto events = ::prism_rtl::make_rc<::prism_rtl::Port<V>>();
    ::prism_rtl::Sink<Answer> sink = [cell, updates, events, state, event](const Answer& answer, Cx& cx) -> Done {
        std::optional<S> s = TRY(state(answer, false));
        if (s) {
            if (!*cell) return unexpected(Fault::answer("a blueprint value that gives a bundle was answered before its build ended"));
            (*cell)->set(std::move(*s), cx);
            return updates->fire(Unit{}, cx);
        }
        return events->fire(TRY(event(answer)), cx);
    };
    auto supplied = TRY(blueprint(std::move(path), sink, applied_scope(std::move(hosted)), base, cx));
    std::uint32_t built = supplied.built;
    if (supplied.first) {
        if (auto live = supplied.first->template held_as<W>()) return Made{::prism_rtl::make_rc<AppliedBlueprint>(std::move(supplied), base, sink), built, *live};
        std::optional<S> s = TRY(state(*supplied.first, true));
        if (!s) return unexpected(Fault::answer(str("a blueprint value that gives a bundle answered for ", supplied.first->tag(), " at its build, which is no state of the bundle")));
        cell->emplace(std::move(*s), cx);
        auto read = [cell](const Cx& cx) { return (*cell)->get(cx); };
        W made = TRY(whole(std::optional<::prism_rtl::Dynamic<S>>(::prism_rtl::Dynamic<S>{nullptr, read, updates}), ::prism_rtl::Event<V>::of(events), cx));
        return Made{::prism_rtl::make_rc<AppliedBlueprint>(std::move(supplied), base, sink), built, std::move(made)};
    }
    W made = TRY(whole(std::optional<::prism_rtl::Dynamic<S>>(), ::prism_rtl::Event<V>::of(events), cx));
    return Made{::prism_rtl::make_rc<AppliedBlueprint>(std::move(supplied), base, sink), built, std::move(made)};
}

/// A `$` part of a bundle a blueprint value gives (`apply_blueprint_whole`): the state's
/// part as a dynamic.
template <class S, class Part>
auto state_part(const ::prism_rtl::Dynamic<S>& state, Part part) {
    return state.map(part);
}

/// One of several event parts of a bundle a blueprint value gives
/// (`apply_blueprint_whole`): the firings of the sparse tuple that hold the part.
template <class V, class Part>
auto event_part(const ::prism_rtl::Event<V>& events, Part part) {
    return ::prism_rtl::filter_some(events.map([part](const V& v) { return part(v).part; }));
}

/// An event part of a bundle a blueprint value gives, heard by the block that applied
/// it: each firing is `hear`'s, in its tick. The subscription lives as long as the port.
template <class T, class Hear>
void hear_part(const ::prism_rtl::Event<T>& event, Hear hear) {
    deref(event.port).subscribe([hear](const T& v, Cx& cx) -> Done { return hear(v, cx); });
}

/// A blueprint value applied by a block at one of its lines (Semantics ch. 8: "a blueprint
/// builds nothing until a block applies it", at the applying block's next positions): as
/// `apply_blueprint_heard`, hearing nothing. A blueprint that answers (`@ x`, an event's,
/// a dynamic's) builds no place here, and what it answers is the line's result, which a
/// line of unit drops.
inline Result<std::tuple<::prism_rtl::Rc<Row>, std::uint32_t>> apply_blueprint(const ::prism_rtl::Blueprint<Elem, Answer>& blueprint, Path path, std::uint32_t base, std::optional<::prism_rtl::Rc<::prism_rtl::HostOf<Elem, Answer>>> hosted, Cx& cx) {
    return apply_blueprint_heard(blueprint, std::move(path), base, std::move(hosted), [](const Answer&, Cx&) -> Done { return {}; }, cx);
}
}

/// A row subscribing to its block's port for one event: the row heard weakly, the handle
/// kept for its leaving (claude/backend.md: `Port::subscribe`).
template <class N, class P, class Port, class Call>
void subscribe_row(const ::prism_rtl::Rc<N>& node, std::optional<::prism_rtl::Rc<P>> parent, Port port, Call call, std::optional<Handle>& slot) {
    if (!parent) return;
    ::prism_rtl::Weak<N> me = node;
    using T = typename std::remove_cvref_t<decltype(deref(port(*parent)))>::Value;
    Handle h = deref(port(*parent)).subscribe([me, call](const T& v, Cx& cx) -> Done {
        if (auto n = me.lock()) call(n, v, cx);
        return {};
    });
    slot = h;
}
</cpp>
