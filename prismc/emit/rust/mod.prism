# Emission: the model lowering decided (lower.prism) spelled as a Rust crate through the
# templates (templates/rust.prism, templates/prelude.prism): `Cargo.toml`, `src/main.rs`,
# `src/prelude.rs` and one `src/NAME.rs` per Prism module. Each function here spells one
# construct of the core form; nothing here decides (K9). An expression's text is
# relative to the column it starts at, so a template's placeholder alone on its line
# indents a piece of several lines as a person would.
#
# Written by Claude, 1 November 2026, on the claude-self-hosting branch. Subject to change:
# Jimmy rewrites it by hand, and an implementer reading it uses their own discretion.
emit r
mod items
mod Templates
mod Prelude
use Syntax.Lexer.*
use Check.Errors.*
use Lower.*
use Lower.Model.*
use Lower.Node.*
use Emit.Rust.Templates.*
use Emit.Rust.Prelude.*

# ---------------------------------------------------------------------------------------
# Types
# ---------------------------------------------------------------------------------------

Type: unbounded fn OutTy -> Text
fn Type t = match t:
    OutNat: "Nat"
    OutInt: "Int"
    OutU8: "u8"
    OutFloat: "f64"
    OutBool: "bool"
    OutChar: "char"
    OutText: "Text"
    OutCursor: "Cursor"
    OutUnit: "()"
    OutPath: "Path"
    OutDuration: "Duration"
    OutError: "Error"
    OutNamed n, [[]]: n
    OutNamed n, args: "{n}<{Types args}>"
    OutOpt i: "Option<{Type i}>"
    OutRes i: "Result<{Type i}, Error>"
    OutTuple [[one]]: "({Type one},)"
    OutTuple ts: "({Types ts})"
    OutArray e: "Array<{Type e}>"
    OutMap k, v: "Map<{Type k}, {Type v}>"
    OutFn ps, r: "Rc<dyn Fn({RefTypes ps}) -> {Type r}>"
    OutRef (OutFn ps, r): "&dyn Fn({RefTypes ps}) -> {Type r}"
    OutRef i: "&{Type i}"
    OutJobFn a, b: "Rc<dyn Fn({Type a}) -> Rc<dyn prism_rtl::Job<{Type b}>>>"
    OutJob b: "Rc<dyn prism_rtl::Job<{Type b}>>"
    OutEvent i: "Event<{Type i}>"
    OutDyn i: "Dynamic<{Type i}>"
    OutGen n: n
    OutRc i: "Rc<{Type i}>"
    OutPod: "Pod"
    OutShowAny: "Rc<dyn Show>"
    OutHold i: "Hold<{Type i}>"
    OutStamped i: "Stamped<{Type i}>"
    OutSnapshot i: "Snapshot<{Type i}>"
    OutDefer i: "Defer<{Type i}>"
    OutWeak n: "Weak<{n}>"
    OutCell i: "RefCell<{Type i}>"
    OutWakes: "Wakes"
    OutCount: "u32"
    OutObj i: "Rc<dyn {Type i}>"
    OutSlice i: "[{Type i}]"
    OutPort i: "Port<{Type i}>"
    OutLive i: "Live<{Type i}>"
    OutUnknown what: "() /* {what} */"
    OutQuantified b: "compile_error!(\"{loweringRefusal}a quantified type variable of `{b}`: no instantiation gives it a type\")"

Types: unbounded fn [OutTy] -> Text
fn Types ts = Join (Each ts, \|t| Type t), ", "

RefTypes: unbounded fn [OutTy] -> Text
fn RefTypes ts = Join (Each ts, \|t| "&{Type t}"), ", "

# ---------------------------------------------------------------------------------------
# Expressions
# ---------------------------------------------------------------------------------------

# Whether an expression must be parenthesized as an operand or a receiver.
IsLoose: fn Ex -> Bool
fn IsLoose x = match x:
    XBlock [[]], inner: IsLoose inner
    XTyped inner, ignore: IsLoose inner
    XBin ignore, ignore, ignore: True
    XUnary ignore, ignore: True
    XClosure ignore, ignore, ignore: True
    XIf ignore, ignore, ignore: True
    XMatch ignore, ignore, ignore, ignore: True
    XChain ignore, ignore, ignore, ignore: True
    XCast ignore, ignore: True
    XRef ignore: True
    XRefMut ignore: True
    XDeref ignore: True
    otherwise: False

Tight: unbounded fn Ex -> Text
fn Tight x = if IsLoose x: "({Expression x})" else: Expression x

Operand: unbounded fn Ex -> Text
fn Operand x = match x:
    XBlock [[]], inner: Operand inner
    XTyped inner, ignore: Operand inner
    XBin ignore, ignore, ignore: "({Expression x})"
    XClosure ignore, ignore, ignore: "({Expression x})"
    XIf ignore, ignore, ignore: "({Expression x})"
    XCast ignore, ignore: "({Expression x})"
    otherwise: Expression x

Args: unbounded fn [Ex] -> Text
fn Args xs = Join (Each xs, \|x| Expression x), ", "

Expression: unbounded fn Ex -> Text
fn Expression x = match x:
    XVar n: n
    XPath p: p
    XSelf: "self"
    XCx: "cx"
    XConst n: "Self::{n}"
    XUnit: "()"
    XNone: "None"
    XBool b: if b: "true" else: "false"
    XNat d: if (Len d) <= 9: "Nat::from({d}u32)" else: if (Len d) <= 18: "Nat::from_int(Int::from({d}i64)).unwrap()" else: "Nat::from_int(Int::parse(\"{d}\").unwrap()).unwrap()"
    XInt d: if (Len (if (HasPrefix d, "-"): AfterFirst d else: d)) <= 18: "Int::from({d})" else: "Int::parse(\"{d}\").unwrap()"
    XByte d: "{d}u8"
    XFloat d: d
    XIndex n: "{n}"
    XChar c: "'{CharEscape c}'"
    XStr t: "\"{Escape t}\""
    XRef y: "&{Operand y}"
    XRefMut y: "&mut {Operand y}"
    XDeref y: "*{Operand y}"
    XTarget y: "(*{Expression y})"
    XClone y: "{Tight y}.clone()"
    XWeak y: "Rc::downgrade({Expression y})"
    XUpgrade y: "{Tight y}.upgrade()"
    XBreak l, y: "break {Label l} {Expression y}"
    XBreakLoop: "break"
    XLater y: "Box::new(move |cx| \{ {Expression y}; Ok(()) \})"
    XFormatStr parts: FormatStr parts
    XIsCase y, [[]]: "false"
    XIsCase y, cs: "matches!({Expression y}, {Join (Each cs, \|c| "{c}(..)"), " | "})"
    XRefusal what: "compile_error!(\"{loweringRefusal}{Escape what}\")"
    XUnreachable: "unreachable!()"
    XCall f, args: "{f}({Args args})"
    XApply f, args: "{Tight f}({Args args})"
    XMethod r, m, args: "{Tight r}.{m}({Args args})"
    XBin op, l, r: "{Operand l} {op} {Operand r}"
    XUnary op, y: "{op}{Operand y}"
    XCtor p, args: "{p}({Args args})"
    XRecord p, fs: "{p} \{ {Join (Each fs, \|((f, v))| FieldInit f, v), ", "} \}"
    XTuple [[one]]: "({Expression one},)"
    XTuple xs: "({Args xs})"
    XVec xs: "vec![{Args xs}]"
    XText t: "Text::lit(\"{Escape t}\")"
    XFormat parts: Format parts
    XMatch s, arms, fallback, ignore: Match (Expression s), (Arms arms, fallback)
    XChain label, s, arms, ignore: Chain (Label label), s, arms
    XIf c, t, e: IfExpression c, t, e
    XBlock [[]], e: Expression e
    XBlock dos, e: Block (Statements dos), (Expression e)
    XLabeled label, dos, e, ignore: Labeled (Label label), (Statements dos), (Expression e)
    XClosure mv, ps, body: "{if mv: "move " else: ""}|{Join (Each ps, \|p| Pattern p), ", "}| {Expression body}"
    XTry y: "{Tight y}?"
    XField r, f: "{Tight r}.{f}"
    XPart r, k: "{Tight r}.{k}"
    XDecode t, y: "{DecodeHead t}::from_pod({Expression y})?"
    XCast y, t: "{Tight y} as {Type t}"
    XTyped y, ignore: Expression y

FieldInit: unbounded fn Text, Ex -> Text
fn FieldInit f, (XVar v) = if v == f: f else: "{f}: {v}"
fn FieldInit f, v = "{f}: {Expression v}"

DecodeHead: unbounded fn OutTy -> Text
fn DecodeHead t = match t:
    OutNamed n, [[]]: n
    OutNat: "Nat"
    OutInt: "Int"
    OutText: "Text"
    otherwise: "<{Type t}>"

Label: fn Text -> Text
fn Label l = if (HasPrefix l, "'"): l else: "'{l}"

# `Text::from(format!(..))`: the literal runs with their braces doubled, a `{}` per value;
# with no value, the literal itself (`Text::lit`).
Format: unbounded fn [Ex] -> Text
fn Format parts:
    let lit = Concat (Each parts, \|p| FormatPiece p)
    let vals = Filter parts, \|p| not (IsText p)
    if (Len vals) == 0: "Text::lit(\"{Escape (Concat (Each parts, \|p| PlainPiece p))}\")"
    else: "Text::from(format!(\"{lit}\", {Args vals}))"

PlainPiece: fn Ex -> Text
fn PlainPiece (XText t) = t
fn PlainPiece other = ""

# `format!(..)`, a message's text (a fault's), not a `Text`: a local is named in the
# literal, any other value placed by position.
FormatStr: unbounded fn [Ex] -> Text
fn FormatStr parts:
    let lit = Concat (Each parts, \|p| StrPiece p)
    let vals = Filter parts, \|p| not (IsText p) and not (IsVar p)
    if (Len vals) == 0: "\"{lit}\"" else: "format!(\"{lit}\", {Args vals})"

IsVar: fn Ex -> Bool
fn IsVar (XVar ignore) = True
fn IsVar other = False

StrPiece: fn Ex -> Text
fn StrPiece (XVar n) = "\{{n}\}"
fn StrPiece other = FormatPiece other

IsText: fn Ex -> Bool
fn IsText (XText ignore) = True
fn IsText other = False

FormatPiece: fn Ex -> Text
fn FormatPiece (XText t) = FormatEscape (Escape t)
fn FormatPiece other = "\{\}"

FormatEscape: fn Text -> Text
fn FormatEscape t = MapChars t, \|c| FormatEscapeChar c

FormatEscapeChar: fn Text -> Text
fn FormatEscapeChar "\{" = "\{\{"
fn FormatEscapeChar "\}" = "\}\}"
fn FormatEscapeChar c = c

# `if c { a } else { b }` on one line when both sides are short.
IfExpression: unbounded fn Ex, Ex, Ex -> Text
fn IfExpression c, t, e:
    let ct = Expression c
    let tt = Expression t
    let et = Expression e
    let short = not (Contains "{tt}{et}", "\n") and (Len "{ct}{tt}{et}") < 70
    if short: "if {ct} \{ {tt} \} else \{ {et} \}" else: If ct, tt, et

# A `match`'s arms, guards joined; the fallback arm when a guard leaves the match open.
Arms: unbounded fn [XArm], Bool -> Text
fn Arms arms, fallback:
    let lines = Each arms, \|a| Arm a
    let all = if fallback: Push lines, "_ => unreachable!(\"no arm matched\")," else: lines
    Join all, "\n"

Arm: unbounded fn XArm -> Text
fn Arm a:
    let guard = if (Len a.conds) == 0: "" else: " if {Join (Each a.conds, \|c| Condition c), " && "}"
    let body = Expression a.body
    "{Pattern a.pat}{guard} => {body},"

Condition: unbounded fn Cc -> Text
fn Condition (CcIf x) = Operand x
fn Condition (CcLet p, x) = "let {Pattern p} = {Expression x}"

# An if-let chain over arms in a labelled block: each arm breaks with its value; a last arm
# that matches anything ends the block.
Chain: unbounded fn Text, Ex, [XArm] -> Text
fn Chain label, s, arms:
    let inPlace = match s:
        XRef y: IsBound y
        otherwise: IsBound s
    let ((bind, scrut)) = if inPlace: (([[]], Expression s)) else: (([["let scrutinee = {Expression s};"]], "scrutinee"))
    let n = Len arms
    let lines = Each (Range0 n), \|i|
        let a = Or arms[i], (XArm(pat=PaWild, conds=[[]], body=XUnit))
        let catchAll = (a.pat == PaWild) and (Len a.conds) == 0
        if catchAll: Expression a.body
        else:
            let head = Join (Append [["let {Pattern a.pat} = {scrut}"]], (Each a.conds, \|c| Condition c)), " && "
            ChainArm head, label, (Continued (Expression a.body), "    ")
    let ends = match ?Last arms:
        ? a: (a.pat == PaWild) and (Len a.conds) == 0
        nil: False
    let tail = if ends: [[]] else: [["unreachable!(\"no clause matched\")"]]
    "{label}: \{\n{Indent (Join (Append (Append bind, lines), tail), "\n")}\n\}"

# A place a name is bound to (a local, a field of the node, of the block through a row's
# parent, the element a `for &s` loop updates): a chain matches it where it stands.
IsBound: fn Ex -> Bool
fn IsBound x = match x:
    XVar ignore: True
    XField XSelf, ignore: True
    XField (XMethod (XUpgrade ignore), ignore, ignore), ignore: True
    XTarget ignore: True
    XPart (XVar ignore), ignore: True
    otherwise: False

# A text placed after other text on an indented line: its later lines take the indent.
Continued: fn Text, Text -> Text
fn Continued t, pad:
    let ls = Split t, "\n"
    Join (Each (Range0 (Len ls)), \|i| if i == 0 or (Or ls[i], "") == "": Or ls[i], "" else: "{pad}{Or ls[i], ""}"), "\n"

# A function's body: a block's statements and value without its braces.
BodyLines: unbounded fn Ex -> Text
fn BodyLines (XBlock dos, e) = if (Len dos) == 0: BodyLines e else: "{Statements dos}\n{BodyLines e}"
fn BodyLines x = Expression x

# Every line of a text four spaces in.
Indent: fn Text -> Text
fn Indent t = Join (Each (Split t, "\n"), \|l| if l == "": "" else: "    {l}"), "\n"

# ---------------------------------------------------------------------------------------
# Patterns and statements
# ---------------------------------------------------------------------------------------

Pattern: unbounded fn Pa -> Text
fn Pattern p = match p:
    PaWild: "_"
    PaBind n: n
    PaMut n: "mut {n}"
    PaCtor c, ps: "{c}({Join (Each ps, \|q| Pattern q), ", "})"
    PaUnit c: c
    PaRecord c, fs, rest:
        let parts = Each fs, \|((f, q))| match q:
            PaBind n: if n == f: f else: "{f}: {n}"
            otherwise: "{f}: {Pattern q}"
        let all = if rest: Push parts, ".." else: parts
        "{c} \{ {Join all, ", "} \}"
    PaTuple [[one]]: "({Pattern one},)"
    PaTuple ps: "({Join (Each ps, \|q| Pattern q), ", "})"
    PaChar c: "'{CharEscape c}'"
    PaBool b: if b: "true" else: "false"
    PaIndex n: "{n}"
    PaConst n: "Self::{n}"
    PaSlice ps: "[{Join (Each ps, \|q| Pattern q), ", "}]"
    PaRest "": ".."
    PaRest n: "{n} @ .."
    PaTyped q, t: "{Pattern q}: {Type t}"

Statements: unbounded fn [Do] -> Text
fn Statements dos = Join (Each dos, \|d| Statement d), "\n"

Statement: unbounded fn Do -> Text
fn Statement d = match d:
    DoLet p, x: "let {Pattern p} = {Expression x};"
    DoLetElse p, x, e: "let {Pattern p} = {Expression x} else \{ {Expression e} \};"
    DoAssign p, x: "{Expression p} = {Expression x};"
    DoWhile c, body: IfStmt "while {Expression c}", (Statements body)
    DoWhileLet p, x, body: IfStmt "while let {Pattern p} = {Expression x}", (Statements body)
    DoFor p, x, body: IfStmt "for {Pattern p} in {Expression x}", (Statements body)
    DoExpr x: "{Expression x};"
    DoIf c, t, e: "{IfStmt "if {Expression c}", (Statements t)}{ElseBranch e}"
    DoIfLet p, x, t, e: "{IfStmt "if let {Pattern p} = {Expression x}", (Statements t)}{ElseBranch e}"
    DoMatch x, cases: Match (Expression x), (Join (Each cases, \|((p, body))| ArmBlock (Pattern p), (Statements body)), "\n")
    DoReturn x: "return {Expression x};"
    DoBlock body: Scope (Statements body)
    DoScope body: "\{ {InlineStatements body} \};"
    DoLine body: "{InlineStatements body};"
    DoNote t: "// {t}"

# Statements on one line (`DoScope`, `DoLine`).
InlineStatements: unbounded fn [Do] -> Text
fn InlineStatements dos = Join (Each dos, \|d| InlineStatement d), " "

InlineStatement: unbounded fn Do -> Text
fn InlineStatement (DoIf c, t, [[]]) = "if {Expression c} \{ {InlineStatements t} \}"
fn InlineStatement d = Statement d

# An `else`, `else if` for a lone `if` inside.
ElseBranch: unbounded fn [Do] -> Text
fn ElseBranch [[]] = ""
fn ElseBranch [[(DoIf c, t, e)]] = " else {Statement (DoIf c, t, e)}"
fn ElseBranch [[(DoIfLet p, x, t, e)]] = " else {Statement (DoIfLet p, x, t, e)}"
fn ElseBranch body = Else (Statements body)
