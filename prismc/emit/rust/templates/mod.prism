# The Rust template set (Templates ch. 2, code templates; Compiler ch. 4, "Templates, and
# two template sets"): every item of the emitted Rust as a function-form template with
# doubled braces. A placeholder alone on its line stands for whole lines indented to its
# column, so a nested piece comes out indented as written. The templates decide nothing
# (K9): lowering decided, emit.prism spelled each part and chose the template.
#
# Written by Claude, 1 November 2026, on the claude-self-hosting branch. Subject to change:
# Jimmy rewrites it by hand, and an implementer reading it uses their own discretion.
emit r
mod Items
use Emit.Rust.Templates.Items.*

# ---------------------------------------------------------------------------------------
# Comments
# ---------------------------------------------------------------------------------------

# A doc comment: each line of `text` after `///`.
Doc: fn Text -> Text
fn Doc text = if text == "": "" else: Concat (Each (SplitOn text, "\n"), \|l| if l == "": "///\n" else: "/// {l}\n")

# A doc comment that quotes Prism source.
SourceDoc: fn Text, Text -> Text
fn SourceDoc lead, source = if lead == "": SourceOnly source else: SourceLed lead, source

SourceOnly: fn Text -> Text
fn SourceOnly source = inline_text <rust>
/// ```prism
<@Quoted text={{source}}/>
/// ```
</rust>

SourceLed: fn Text, Text -> Text
fn SourceLed lead, source = inline_text <rust>
/// {{lead}}
///
/// ```prism
<@Quoted text={{source}}/>
/// ```
</rust>

Quoted: fn Text -> Text
fn Quoted text = Joined (Each (SplitOn text, "\n"), \|l| if l == "": "///" else: "/// {l}"), "\n"

Joined: fn [Text], Text -> Text
fn Joined xs, sep = match xs[0]:
    ? first: Concat (Fold (Drop xs, 1), [[first]], \|acc, x| Push (Push acc, sep), x)
    nil: ""

# ---------------------------------------------------------------------------------------
# Files
# ---------------------------------------------------------------------------------------

# One Prism module's Rust module.
Module: fn Text, Text, Text, Text -> Text
fn Module prism, path, uses, items = inline_text <rust>
//! {{prism}}, from `{{path}}`, emitted by prismc: one Rust type per Prism type, a node
//! per root widget (claude/backend.md). Edit the Prism source, not this file. The runtime
//! side is reached from the crate, `crate::prelude` (and through it `::prism_rtl`), the
//! standard library from `::std`, and nothing is imported by name: a program's own type
//! (`Row`, `Option`) hides none of theirs. The traits are in scope unnamed, for their methods.

use crate::prelude::traits::*;
{{uses}}

{{items}}
</rust>

# `Cargo.toml`: the library and the two Worlds, by path; the canvas World behind a feature,
# on by default for a program whose root emits `Gui`.
Cargo: fn Text, Text, Text -> Text
fn Cargo name, runtime, defaults = inline_text <rust>
# Emitted by prismc. Edit the Prism sources, not this file.
[package]
name = "{{name}}"
version = "0.1.0"
edition = "2024"

[workspace]

[[bin]]
name = "{{name}}"
path = "src/main.rs"

[dependencies]
prism_rtl = { path = "{{runtime}}/runtime/rust" }
prism_world_cli = { path = "{{runtime}}/worlds/cli/rust" }
prism_world_canvas_rtl = { path = "{{runtime}}/worlds/canvas/rust", optional = true }

[features]
default = [{{defaults}}]
canvas = ["prism_world_canvas_rtl"]
</rust>

# `main.rs`: the modules, the programs, the Test World's registrations, and `main`, which
# picks the World (claude/backend.md: `Gui.*` at the root is the canvas, else the CLI;
# `--world` overrides; `test` runs the scripts under the Test World).
Main: fn Text, Text, Text, Text, Text, Text, Text -> Text
fn Main name, mods, programs, registrations, scripts, runRoot, world = inline_text <rust>
//! The program `{{name}}`, emitted by prismc from Prism (claude/backend.md): a crate over
//! `prism_rtl`, run under the CLI World, the canvas World or the Test World. Edit the
//! Prism sources, not these files.
#![allow(dead_code, unused_variables, unused_imports, unused_mut, unused_parens, unused_braces)]
#![allow(unreachable_patterns, unreachable_code, unused_labels, non_snake_case, non_camel_case_types)]
#![allow(clippy::all)]
// A recursive widget's rows nest a node type per level, sixteen levels (gap ID): deeper than
// rustc's default limit of 128 for checking what a type's drop reaches.
#![recursion_limit = "512"]

{{mods}}

use ::std::rc::Rc;

use ::prism_rtl::*;

use crate::prelude::*;

{{programs}}

/// The Test World with every root a test names, and the compiled `check` blocks.
fn test_world() -> crate::prelude::TestWorld {
    crate::prelude::TestWorld::new()
        {{registrations}}
}

/// The test scripts compiled with the program: `test` runs these when given none.
const SCRIPTS: &[&str] = &[
    {{scripts}}
];

/// The World the root's row asks for: `canvas`, `cli`, or `none` (a row with `Ui` and no
/// `Gui`, which no World answers).
const WORLD: &str = "{{world}}";

fn main() {
    let args: ::std::vec::Vec<::std::string::String> = ::std::env::args().skip(1).collect();
    let (world, rest) = prelude::world_option(&args, WORLD);
    let code = if args.first().map(::std::string::String::as_str) == ::std::option::Option::Some("test") || world == "test" {
        let scripts: ::std::vec::Vec<::std::string::String> = rest.into_iter().filter(|a| a != "test").collect();
        prelude::on_big_stack(move || prelude::run_scripts(&test_world(), &scripts, SCRIPTS))
    } else {
        run_root(&world, rest)
    };
    ::std::process::exit(code as i32);
}

/// The root under the World `world`.
fn run_root(world: &str, args: ::std::vec::Vec<::std::string::String>) -> u8 {
    {{runRoot}}
}
</rust>

# A `main` with no root: only the tests run.
NoRoot: fn Text -> Text
fn NoRoot name = inline_text <rust>
let _ = (world, args);
eprintln!("{{name}}: the program has no `@main`; `{{name}} test` runs its tests");
2
</rust>

# A root under the World its row asks for, or the one `--world` names.
RunRoot: fn Text -> Text
fn RunRoot program = inline_text <rust>
match world {
    "canvas" => prelude::run_canvas::<{{program}}>(),
    "cli" => prelude::on_big_stack(move || ::prism_world_cli::run::<{{program}}>(args)),
    "none" => {
        eprintln!("the root's row has Ui.* without Gui.*: no World answers Ui elements alone; emit Gui.* for the canvas World, or pass --world");
        2
    }
    other => {
        eprintln!("no World {other} (cli, canvas, test)");
        2
    }
}
</rust>
