# The program around a root node, as every World drives it.
Program: fn Text, Text, Text, Text, Text -> Text
fn Program name, prism, node, decode, call = inline_text <rust>
/// The program of `@{{prism}}`: the root node and the runtime.
pub struct {{name}} {
    rt: crate::prelude::Runtime,
    root: ::std::rc::Rc<{{node}}>,
}

impl crate::prelude::Program for {{name}} {
    fn build(args: &[crate::prelude::Pod], ready: &dyn crate::prelude::ReadyState) -> ::std::result::Result<(Self, crate::prelude::TickOut), crate::prelude::Fault> {
        {{decode}}
        let mut rt = crate::prelude::Runtime::new();
        let mut cx = rt.build(ready);
        let root = {{call}};
        let out = rt.close(cx)?;
        ::std::result::Result::Ok(({{name}} { rt, root }, out))
    }
    fn tick(&mut self, input: &crate::prelude::TickIn, ready: &dyn crate::prelude::ReadyState) -> ::std::result::Result<crate::prelude::TickOut, crate::prelude::Fault> {
        let root: ::std::rc::Rc<dyn crate::prelude::Node> = self.root.clone();
        self.rt.tick(&root, input, ready)
    }
    fn compact(&mut self) {
        self.rt.compact();
    }
}
</rust>

