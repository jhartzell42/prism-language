let structure = {
    {{structure}}
};
crate::prelude::Pod::Shown(crate::prelude::show(self).as_str().into(), ::std::boxed::Box::new(structure))
</rust>

# A derived `FromPod`: the structure matched case by case.
FromPodBody: fn Text, Text -> Text
