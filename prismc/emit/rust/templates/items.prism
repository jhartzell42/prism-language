# A type with its own `^Show` crosses as its text and its structure (claude/backend.md,
# "Printing"): a key prints `0/[e2]/0` and still matches structurally.
ShownPod: fn Text -> Text
fn ShownPod structure = inline_text <rust>
let structure = {
    {{structure}}
};
Pod::Shown(show(self).as_str().into(), Box::new(structure))
</rust>

# A derived `FromPod`: the structure matched case by case.
FromPodBody: fn Text, Text -> Text
fn FromPodBody arms, want = inline_text <rust>
match p.structure() {
    {{arms}}
    other => mismatch("{{want}}", other),
}
</rust>

# A tag's struct: an element tag's `Level`, or a plain row value's fields.
Tag: fn Text, Text, Text, Text, Text, Text -> Text
fn Tag doc, derives, name, fields, tagName, pods = inline_text <rust>
{{doc}}
#[derive({{derives}})]
pub struct {{name}} {
    {{fields}}
}

impl {{name}} {
    /// The tag's qualified name, as its `Pod` carries it.
    pub const TAG: &'static str = "{{tagName}}";
}

impl ToPod for {{name}} {
    fn to_pod(&self) -> Pod {
        Pod::element("{{tagName}}", vec![{{pods}}])
    }
}

impl Show for {{name}} {
    fn show(&self, p: &mut Printer) {
        self.to_pod().show(p);
    }
}
</rust>

# A level that holds dynamics as a World reads it (doubt WD): plain data with each dynamic
# sampled at the read point, deep, and the update events of the dynamics it holds.
TagLevel: fn Text, Text, Text, Text -> Text
fn TagLevel name, tagName, pods, ports = inline_text <rust>
impl {{name}} {
    /// The level as a World reads it: each dynamic it holds sampled at the read point.
    pub fn level_pod(&self, cx: &Cx) -> Pod {
        Pod::element("{{tagName}}", vec![{{pods}}])
    }
    /// The update events of the dynamics it holds, and of theirs.
    pub fn level_ports(&self, cx: &Cx, out: &mut Vec<Rc<Port<()>>>) {
        let _ = (cx, &out);{{ports}}
    }
}
</rust>

# `crate::Elem`'s levels as a World reads them (doubt WD): a tag that holds dynamics deep,
# any other as its plain data.
RowLevel: fn Text, Text, Text -> Text
fn RowLevel name, pods, ports = inline_text <rust>
impl prism_rtl::Level for {{name}} {
    fn level_pod(&self, cx: &Cx) -> Pod {
        let _ = cx;
        match self {
            {{pods}}_ => self.to_pod(),
        }
    }
    fn level_ports(&self, cx: &Cx, out: &mut Vec<Rc<Port<()>>>) {
        let _ = (cx, &out);
        match self {
            {{ports}}_ => {}
        }
    }
}
</rust>

# A tag's struct read back from its `Pod`.
TagFromPod: fn Text, Text, Text -> Text
fn TagFromPod name, tagName, reads = inline_text <rust>
impl FromPod for {{name}} {
    fn from_pod(p: &Pod) -> Result<Self, Fault> {
        match p.tag() {
            Some("{{tagName}}") => Ok({{name}} { {{reads}} }),
            _ => prism_rtl::pod::mismatch("a {{tagName}}", p),
        }
    }
}
</rust>

