# An unbounded function's step machine (D6): the job stopped at a cycle point, its
# `cycle`, and its `Start`.
Job: fn Text, Text, Text, Text, Text, Text, Text, Text, Text -> Text
fn Job doc, head, generics, bounded, fields, ret, body, start, startBody = inline_text <rust>
/// The step machine of `{{head}}`, stopped at a cycle point: the call about to be
/// entered. A tail call leaves no frame; any other call waits in a `Frame` around the
/// callee's job, so the job's stack is its frames.
///
{{doc}}
pub struct {{head}}{{generics}} {
    {{fields}}
}

impl{{bounded}} ::prism_rtl::Job<{{ret}}> for {{head}}{{generics}} {
    fn cycle(&self) -> ::prism_rtl::Turn<{{ret}}> {
        {{body}}
    }
}

/// `Start {{head}}, x`: what the function value is when passed to `@Run`.
{{start}} {
    {{startBody}}
}
</rust>

