# A record as a struct.
Struct: fn Text, Text, Text, Text -> Text
fn Struct doc, derives, head, fields = inline_text <rust>
{{doc}}
#[derive({{derives}})]
pub struct {{head}} {
    {{fields}}
}
</rust>

