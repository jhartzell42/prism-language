    {{arms}}
    other => ::prism_rtl::pod::mismatch("{{want}}", other),
}
</rust>

# A tag's struct: an element tag's `Level`, or a plain row value's fields.
Tag: fn Text, Text, Text, Text, Text, Text -> Text
fn Tag doc, derives, name, fields, tagName, pods = inline_text <rust>
{{doc}}
#[derive({{derives}})]
pub struct {{name}} {
    {{fields}}
}

impl {{name}} {
    /// The tag's qualified name, as its `Pod` carries it.
    pub const TAG: &'static str = "{{tagName}}";
}

impl crate::prelude::ToPod for {{name}} {
    fn to_pod(&self) -> crate::prelude::Pod {
        crate::prelude::Pod::element("{{tagName}}", vec![{{pods}}])
    }
}

impl crate::prelude::Show for {{name}} {
    fn show(&self, p: &mut crate::prelude::Printer) {
        self.to_pod().show(p);
    }
}
</rust>

# A level that holds dynamics as a World reads it (doubt WD): plain data with each dynamic
# sampled at the read point, deep, and the update events of the dynamics it holds.
TagLevel: fn Text, Text, Text, Text -> Text
fn TagLevel name, tagName, pods, ports = inline_text <rust>
impl {{name}} {
    /// The level as a World reads it: each dynamic it holds sampled at the read point.
    pub fn level_pod(&self, cx: &crate::prelude::Cx) -> crate::prelude::Pod {
        crate::prelude::Pod::element("{{tagName}}", vec![{{pods}}])
    }
    /// The update events of the dynamics it holds, and of theirs.
    pub fn level_ports(&self, cx: &crate::prelude::Cx, out: &mut ::std::vec::Vec<::std::rc::Rc<crate::prelude::Port<()>>>) {
        let _ = (cx, &out);{{ports}}
    }
}
</rust>

# `crate::Elem`'s levels as a World reads them (doubt WD): a tag that holds dynamics deep,
# any other as its plain data.
RowLevel: fn Text, Text, Text -> Text
fn RowLevel name, pods, ports = inline_text <rust>
impl ::prism_rtl::Level for {{name}} {
    fn level_pod(&self, cx: &crate::prelude::Cx) -> crate::prelude::Pod {
        let _ = cx;
        match self {
            {{pods}}_ => self.to_pod(),
        }
    }
    fn level_ports(&self, cx: &crate::prelude::Cx, out: &mut ::std::vec::Vec<::std::rc::Rc<crate::prelude::Port<()>>>) {
        let _ = (cx, &out);
        match self {
            {{ports}}_ => {}
        }
    }
}
</rust>

# A tag's struct read back from its `Pod`.
TagFromPod: fn Text, Text, Text -> Text
