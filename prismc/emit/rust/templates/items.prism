# A `for`'s builder (claude/backend.md, "Dynamic structure"), run at the build and in the
# build list after a tick that changed its source, once. A kept row reads its entry through
# the block's `{{source}}` getter at its own read point: the builder writes nothing to it. A
# host's rows are built the same way over its child's document, with the host as their
# parent (pick HO). A source that is the very map the rows were last built from (one node,
# `same`) has the same keys, so the builder does nothing (no program can tell: Semantics
# ch. 11, sharing is invisible). Over a map of dynamics (`for k, $v <- $(k ==> $v)`, ruling
# FV) the same walk compares each kept key's dynamic with the one the row was built from
# (a dynamic equals only itself) and tells a row whose dynamic was replaced ({{replaced}}:
# the row's `{name}_replaced`, which adopts it next tick); the row is kept, never rebuilt.
ForBuild: fn Text, Text, Text, Text, Text, Text, Text, Text, Text, Text, Text -> Text
fn ForBuild name, at, keyTy, valueTy, rowNode, source, parent, passed, moved, from, replaced = inline_text <rust>
/// The rows of the `for` at `{{at}}`: rows whose key left are torn down, new keys are
/// built under it at `[k]` from the values after the tick; kept rows keep reading their
/// entry out of the source. Nothing to do when the source is the map last built from.
fn {{name}}_build(self: &::std::rc::Rc<Self>, cx: &mut crate::prelude::Cx) -> crate::prelude::Done {
    let items: crate::prelude::Map<{{keyTy}}, {{valueTy}}> = self.{{source}}(cx);
    if self.{{name}}_from.borrow().same(&items) {
        return ::std::result::Result::Ok(());
    }
    {{from}}
    let old = self.{{name}}.borrow().clone();
    // the kept rows stay where they are: only the keys that left or came are touched
    let mut next = old.clone();
    for (k, row) in old.iter() {
        if !items.contains_key(k) {
            row.leave_row(cx);
            cx.leave_later(row.clone());
            next.remove(k);
        }{{replaced}}
    }
    for (k, v) in items.iter() {
        if !old.contains_key(k) {
            let row = {{rowNode}}::build({{at}}.child(crate::prelude::Segment::Key(k.to_pod())), k.clone(), v.clone(), {{parent}}{{passed}}, cx)?;
            next.insert(k.clone(), row);
        }
    }
    *self.{{name}}.borrow_mut() = next;
    // What the block reads of its rows (a `for` that gives a dynamic) moved.
    cx.dirty(self.clone());{{moved}}
    ::std::result::Result::Ok(())
}
</rust>

# A `rebuild`'s builder: one generation at a time, at `{{pos}}/#g` (a widget of several
# clauses in a static position: at its caller's path).
GenBuild: fn Text, Text, Text, Text, Text, Text, Text -> Text
fn GenBuild name, at, path, source, valueTy, select, moved = inline_text <rust>
/// The `rebuild` at `{{at}}`: the old generation torn down (it ran to the end of the
/// tick), the next built at `{{path}}` from the source after the tick.
fn {{name}}_build(self: &::std::rc::Rc<Self>, cx: &mut crate::prelude::Cx) -> crate::prelude::Done {
    if let ::std::option::Option::Some(old) = self.{{name}}.borrow_mut().take() {
        old.leave_row(cx);
        cx.leave_later(old);
    }
    let g = self.{{name}}_count.get();
    self.{{name}}_count.set(g + 1);
    let path = {{path}};
    let value: {{valueTy}} = {{source}};
    let row: ::std::rc::Rc<dyn crate::prelude::Row> = {{select}};
    *self.{{name}}.borrow_mut() = ::std::option::Option::Some(row);{{moved}}
    ::std::result::Result::Ok(())
}
</rust>

# A row's leaving: a `for` row keeps its entry's last value first (R8), its places are torn
# down, its subscriptions let go. A hosted row's `Row` methods follow (pick HO): its typed
# `deliver`, its `document`, its `document_moved`.
RowImpl: fn Text, Text, Text -> Text
fn RowImpl name, leaving, hosted = inline_text <rust>
impl crate::prelude::Row for {{name}} {
    fn leave_row(&self, cx: &mut crate::prelude::Cx) {
        {{leaving}}
    }
    {{hosted}}
}
</rust>

# `crate::Answer` (pick HO): an answer to an element, typed by its tag; a World's answer to
# a forwarded element decodes into it by the element's tag.
AnswerType: fn Text, Text, Text, Text, Text, Text, Text -> Text
fn AnswerType cases, tags, accessors, decodes, firsts, helds, untagged = inline_text <rust>
/// `Answer c`: an answer to an element, typed by its tag (Semantics ch. 9): what a host's
/// supplier answers a child place with, and what a World's answer to a forwarded element
/// decodes to, carrying the tag's output.
#[derive(Clone)]
pub enum Answer {
    {{cases}}
}

impl Answer {
    /// The tag the answer is for.
    pub fn tag(&self) -> &'static str {
        match self {
            {{tags}}
        }
    }
    {{accessors}}
    /// The answer as one made outside a tag's arm, where it is plain data: what a place
    /// of another tag reads at its own type (an element of the host's own making given
    /// under a tag's arm, `@Element (Prelude.Unwrap(..))`). Any other answer is itself.
    pub fn untagged(&self) -> Answer {
        match self {
            {{untagged}}
            other => other.clone(),
        }
    }
    /// An answer made outside a tag's arm, read at the type of the line that binds it (a
    /// blueprint value's plain result).
    pub fn plain<T: crate::prelude::FromPod>(&self) -> ::std::result::Result<T, crate::prelude::Fault> {
        match self {
            Answer::Untagged_a(p) => crate::prelude::FromPod::from_pod(p),
            other => ::std::result::Result::Err(crate::prelude::Fault::answer(format!("an answer for {}, where a blueprint value's plain result was expected", other.tag()))),
        }
    }
    /// An answer made outside a tag's arm that is no plain data (a function, a dynamic, a
    /// bundle with its events and dynamics whole), when it is one and holds a `T`.
    pub fn held_as<T: Clone + 'static>(&self) -> ::std::option::Option<T> {
        match self {
            Answer::Held_a(v) => v.downcast_ref::<T>().cloned(),
            _ => ::std::option::Option::None,
        }
    }
    /// The same, read at the type of the line that binds it: any other answer is a fault.
    pub fn held<T: Clone + 'static>(&self) -> ::std::result::Result<T, crate::prelude::Fault> {
        self.held_as::<T>().ok_or_else(|| crate::prelude::Fault::answer(format!("an answer for {}, where a blueprint value's result that is no plain data was expected", self.tag())))
    }
}

impl ::prism_rtl::AnswerOf<Elem> for Answer {
    /// A World's answer to the element `e`, decoded by its tag.
    fn decode(e: &Elem, v: &crate::prelude::Pod) -> ::std::result::Result<Answer, crate::prelude::Fault> {
        match e {
            {{decodes}}
        }
    }
    /// A World's first value for the element `e`: a bundle's plain parts, any other tag's
    /// answer.
    fn decode_first(e: &Elem, v: &crate::prelude::Pod) -> ::std::result::Result<Answer, crate::prelude::Fault> {
        match e {
            {{firsts}}
        }
    }
    /// An answer held whole (a bundle with a part that is no plain data, made outside a
    /// tag's arm) as the parts the tag of `e` takes.
    fn held_parts(e: &Elem, answer: &Answer) -> ::std::option::Option<::prism_rtl::PartsAnswer<Answer>> {
        match e {
            {{helds}}
        }
    }
}
</rust>

# One accessor of `Answer`: the tag's value, or a fault naming the tag the answer was for.
# `outside` is the arm for an answer made outside a tag's arm (the emitter's `OutsideArm`).
AnswerGetter: fn Text, Text, Text, Text, Text -> Text
fn AnswerGetter accessor, variant, tagName, ty, outside = inline_text <rust>
/// A `{{tagName}}`'s answer.
pub fn {{accessor}}(&self) -> ::std::result::Result<{{ty}}, crate::prelude::Fault> {
    match self {
        Answer::{{variant}}(v) => ::std::result::Result::Ok(v.clone()),
        {{outside}}
        other => ::std::result::Result::Err(crate::prelude::Fault::answer(format!("an answer for {}, where {{tagName}}'s was expected", other.tag()))),
    }
}
</rust>

Answer: fn Text, Text -> Text
fn Answer seating, arms = inline_text <rust>
fn answer(self: ::std::rc::Rc<Self>, at: &[crate::prelude::Segment], v: &crate::prelude::Pod, cx: &mut crate::prelude::Cx) -> crate::prelude::Done {
    {{seating}}
    match at {
        {{arms}}
        _ => return ::std::result::Result::Err(crate::prelude::Fault::answer(format!("no answering place at {}", crate::prelude::Path(at.to_vec())))),
    }
    ::std::result::Result::Ok(())
}
</rust>

