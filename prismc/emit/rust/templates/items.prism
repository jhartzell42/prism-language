impl crate::prelude::FromPod for {{name}} {
    fn from_pod(p: &crate::prelude::Pod) -> ::std::result::Result<Self, crate::prelude::Fault> {
        match p.tag() {
            ::std::option::Option::Some("{{tagName}}") => ::std::result::Result::Ok({{name}} { {{reads}} }),
            _ => ::prism_rtl::pod::mismatch("a {{tagName}}", p),
        }
    }
}
</rust>

