}
</rust>

RowFromPod: fn Text, Text -> Text
fn RowFromPod name, reads = inline_text <rust>
impl FromPod for {{name}} {
    fn from_pod(p: &Pod) -> Result<Self, Fault> {
        match p.tag() {
            {{reads}}
            _ => prism_rtl::pod::mismatch("a {{name}}", p),
