# Blocks (Semantics ch. 4 and 5; Type System ch. 5): widget blocks as binding groups,
# holds, binds (a build, an emit, or a `rebuild` or `for` handing back its result), the
# keyed `for` and `rebuild` with what each hands back, hosting through the prelude's
# signatures, `given:` bodies with guards (a failed guard under `~` is `Prelude.Unmet`,
# D11), and `&` blocks with their references, locals, loops, borrow and escape rules.
#
# Written by Claude, 31 October 2026, on the claude-self-hosting branch. Subject to change:
# Jimmy rewrites it by hand, and an implementer reading it uses their own discretion.
emit r
mod Structure
mod Borrows
use Syntax.*
use Syntax.Decls.*
use Syntax.Lexer.*
use Syntax.Lexer.Chars.*
use Syntax.Lexer.Layout.*
use Syntax.Lexer.Words.*
use Syntax.Lexer.Literals.*
use Syntax.Lexer.Templates.*
use Syntax.Lexer.Corpus.*
use Check.Errors.*
use Check.Types.*
use Check.Types.Recording.*
use Check.Types.Unify.*
use Check.Types.Schemes.*
use Check.Types.Colors.*
use Check.Env.*
use Check.Env.Names.*
use Check.Env.Reading.*
use Check.Env.Decls.*
use Check.Env.Traits.*
use Check.Expr.*
use Check.Expr.Operators.*
use Check.Expr.Calls.*
use Check.Expr.Patterns.*
use Check.Expr.Lifting.*
use Check.Expr.Lets.*
use Check.*
use Check.Passes.*
use Check.Passes.Cycles.*
use Check.Passes.Borrows.*
use Check.Shrink.*
use Check.Shrink.Types.*
use Check.Shrink.Calls.*
use Check.Shrink.Locals.*
use Check.Shrink.Relations.*
use Check.Shrink.Walk.*
use Check.Shrink.Summaries.*
use Check.Blocks.Structure.*
use Check.Blocks.Borrows.*

# Statements of a group in the order they are checked (pick BG): holds first, since a
# hold's initial value is where a block most often says what its names are; then `let`s
# and local functions; then the rest in their dependency order among themselves (a line
# after the lines binding a name it reads, ties and cycles in the page's order), so a `for`
# above the bind of the map it runs over is checked with the map's type (Semantics ch. 4:
# one binding group).
GroupOrder: unbounded fn [Stmt] -> [Nat]
fn GroupOrder stmts:
    let all = Range0 (Len stmts)
    let holds = Filter all, \|i| IsHold (Or stmts[i], dummyStmt2)
    let lets = Filter all, \|i| IsLetLike (Or stmts[i], dummyStmt2)
    let rest = Filter all, \|i| not (IsHold (Or stmts[i], dummyStmt2)) and not (IsLetLike (Or stmts[i], dummyStmt2))
    let ordered = Fold (DepOrder (Each rest, \|i| Or stmts[i], dummyStmt2)), [[]], \|acc, comp| Append acc, (Each comp, \|j| Or rest[j], 0)
    Append (Append holds, lets), ordered

# A widget block's statements in the order they are checked: its strongly connected
# components in dependency order (`DepOrder`, the order the typed program records), so a
# `let` used above its line is checked first and its uses see its generalized type
# (Semantics ch. 4: one binding group); within a component, BG's order (holds, then `let`s
# and local functions, then the rest). An expression block keeps BG's order: a name bound
# again there is a new binding from its line on, so its lines are not reordered.
WidgetGroupOrder: unbounded fn [Stmt] -> [Nat]
fn WidgetGroupOrder stmts = Fold (DepOrder stmts), [[]], \|acc, comp|
    let holds = Filter comp, \|i| IsHold (Or stmts[i], dummyStmt2)
    let lets = Filter comp, \|i| IsLetLike (Or stmts[i], dummyStmt2)
    let rest = Filter comp, \|i| not (IsHold (Or stmts[i], dummyStmt2)) and not (IsLetLike (Or stmts[i], dummyStmt2))
    Append acc, (Append (Append holds, lets), rest)

# The dependency order of a binding group (ch. 5, blocks by binding group), for the typed
# output: its statements in strongly connected components of the graph from each
# statement to the statements defining a name it reads, each component after the ones it
# depends on, ties in page order. Reads are every name a statement mentions (an
# over-approximation where a lambda's parameter shadows a name of the block).
DepOrder: unbounded fn [Stmt] -> [ [Nat] ]
fn DepOrder stmts:
    let n = Len stmts
    let defs = Each stmts, \|s| GroupDefs s
    let uses = Each stmts, \|s| NamesInStmt s
    let deps = Each (Range0 n), \|i| Filter (Range0 n), \|j| Fold (Or defs[j], [[]]), False, \|seen, d| seen or HasText (Or uses[i], [[]]), d
    let reach = Each (Range0 n), \|i| ReachIdx deps, (Or deps[i], [[]]), [[]]
    let comps = Each (Range0 n), \|i| Filter (Range0 n), \|j| j == i or ((HasNat (Or reach[i], [[]]), j) and (HasNat (Or reach[j], [[]]), i))
    EmitGroups comps, deps, [[]], [[]]

GroupDefs: unbounded fn Stmt -> [Text]
fn GroupDefs s = match s.kind:
    SBind p, ignore, ignore: PatternNames p
    SLet p, ignore, ignore: PatternNames p
    SFn f: [[DefNameText f.name]]
    SWidget w: [[SNameKey w.name]]
    otherwise: [[]]

ReachIdx: unbounded fn [ [Nat] ], [Nat], [Nat] -> [Nat]
fn ReachIdx deps, frontier, seen = match frontier[0]:
    nil: seen
    ? x:
        if HasNat seen, x: ReachIdx deps, (Drop frontier, 1), seen
        else: ReachIdx deps, (Append (Drop frontier, 1), (Or deps[x], [[]])), (Push seen, x)

EmitGroups: unbounded fn [ [Nat] ], [ [Nat] ], [Nat], [ [Nat] ] -> [ [Nat] ]
fn EmitGroups comps, deps, done, acc:
    let ready = Filter (Range0 (Len comps)), \|i| not (HasNat done, i) and Fold (Or deps[i], [[]]), True, \|ok, d| ok and ((HasNat done, d) or HasNat (Or comps[i], [[]]), d)
    match ready[0]:
        nil: acc
        ? i:
            let c = Or comps[i], [[i]]
            EmitGroups comps, deps, (Append done, c), (Push acc, c)

IsHold: fn Stmt -> Bool
fn IsHold s = match s.kind:
    SBind ignore, ignore, (? ignore): True
    otherwise: False

IsLetLike: fn Stmt -> Bool
fn IsLetLike s = match s.kind:
    SLet ignore, ignore, ignore: True
    SFn ignore: True
    SSignature ignore: True
    otherwise: False

# ---------------------------------------------------------------------------------------
# Widget blocks
# ---------------------------------------------------------------------------------------

# A widget block (Semantics ch. 4): `emit` first when it differs, every name bound before
# any line is read (one binding group), each line checked, the last line the result.
# Gives the type of what the block returns (the blueprint's inside).
InferWidgetBlock: unbounded fn Env, St, Block -> ((Ty, St))
fn InferWidgetBlock env, st, b = InferWidgetBlockAt env, st, b, nil

# A widget block whose result is wanted at `expected` (a named widget function's body,
# `@o`): a last line that is a `match` is checked against it, so its tag arms assume the
# element's output (Type System ch. 5, "Refinement at tag matches"), as the same `match`
# written as the body's expression is.
InferWidgetBlockAt: unbounded fn Env, St, Block, ?Ty -> ((Ty, St))
fn InferWidgetBlockAt env, st, b, ?expected:
    let ((env1, st1)) = BlockRow env, (BlockBoundOnce env, st, b.stmts), b.stmts
    let ((env2, st2)) = Fold b.stmts, ((env1, st1)), \|((en, s)), stmt| PreBindStmt en, s, stmt
    let n = Len b.stmts
    let ((env3, st3, ?res)) = Fold (WidgetGroupOrder b.stmts), ((env2, st2, nil)), \|((en, s, ?r)), i|
        let stmt = Or b.stmts[i], dummyStmt2
        let ((en2, s2, ?r2)) = match ((?expected, stmt.kind)):
            ((? want, SExpr e)) if i + 1 == n and IsMatchExpr e: ((en, (Check en, s, e, (TyAt want, en.scope)), (? want)))
            otherwise: WidgetStmt en, s, stmt, (LocalClauses b.stmts, i), i + 1 == n
        match ?r2:
            ? t: ((en2, s2, ? t))
            nil: ((en2, s2, ?r))
    let st4 = BlockPromptCycles env3, st3, b
    let st5 = if st4.recording: NoteGroup st4, b.span, "widget", (DepOrder b.stmts) else: st4
    (((Or ?res, tUnit), st5))

IsMatchExpr: fn Expr -> Bool
fn IsMatchExpr e = match e.kind:
    EMatch ignore, ignore: True
    otherwise: False

let dummyStmt2 = Stmt(kind=(SExpr (Expr(kind=EError, span=Range(start=0, end=0)))), span=Range(start=0, end=0))

# A block's own `emit`, first among its statements (`emit-element` when it is not first).
BlockRow: unbounded fn Env, St, [Stmt] -> ((Env, St))
fn BlockRow env, st, stmts = Fold (Range0 (Len stmts)), ((env, st)), \|((en, s)), i| match stmts[i]:
    ? stmt: match stmt.kind:
        SEmit rowDecl:
            if i > 0: ((en, (ErrFix s, "emit-element", stmt.span, "`emit` comes first in its block", "move this line to the top of the block")))
            else:
                let ((rw, s2)) = ConvRow (EnvCx en), s, (RowAsType rowDecl)
                let en2 = update en:
                    &_.scope <= ResolveScopeRow en, rw
                ((en2, s2))
        otherwise: ((en, s))
    nil: ((en, s))

# A row written on an `emit` line, as the type the row reader takes.
RowAsType: fn Row -> Type
fn RowAsType rowDecl = Type(kind=(TRowUnion (Each rowDecl.terms, RowTermType)), span=rowDecl.span)

RowTermType: fn RowTerm -> Type
fn RowTermType (RFamily q) = Type(kind=(TFamily q), span=q.span)
fn RowTermType (RVar v) = Type(kind=(TName (SName(sigils="", path=[[v.name]], span=v.span)), [[]]), span=v.span)
fn RowTermType (RType t) = t

# A block's row naming the module's variable reads the variable as the body sees it.
ResolveScopeRow: fn Env, Rw -> Rw
fn ResolveScopeRow env, rw = match rw.tail:
    TlQ v: Rw(fams=rw.fams, minus=rw.minus, tail=env.scope.tail)
    otherwise: rw

# Every name a statement binds gets its marked type before any line is read.
PreBindStmt: unbounded fn Env, St, Stmt -> ((Env, St))
fn PreBindStmt env, st, s = match s.kind:
    SBind p, ignore, ignore: PreBindPattern env, st, p
    SLet ignore, ignore, ignore: PreBind env, st, s
    SFn ignore: PreBind env, st, s
    SSignature ignore: PreBind env, st, s
    SWidget w:
        let ((v, st2)) = FreshVar st, False, ""
        BindLocalId (WithLocal env, (SNameKey w.name), (Mono (TyAt v, env.scope))), st2, (SNameKey w.name), w.name.span
    otherwise: ((env, st))

PreBindPattern: unbounded fn Env, St, Pattern -> ((Env, St))
fn PreBindPattern env, st, p = Fold (PatternBinders p), ((env, st)), \|((en, s)), ((name, at))|
    let ((v, s1)) = FreshVar s, True, name
    let s2 = AtBinder s1, v, at
    let ((rw, s3)) = FreshRow s2, [[]]
    let t = WithMarks (TypeMarks (MarksOf name)), v, rw
    let en2 = update (WithLocal en, name, (Mono t)):
        &_.pending <= AddText &_.pending, name
    BindLocalId en2, s3, name, at

# One statement of a widget block; the last gives the block's result.
WidgetStmt: unbounded fn Env, St, Stmt, [FnClause], Bool -> ((Env, St, ?Ty))
fn WidgetStmt env, st, s, clauses, last = match s.kind:
    SEmit ignore: ((env, st, if last: ? tUnit else: nil))
    SBind p, e, nil:
        let st2 = BindStmt env, st, p, e, s.span
        ((env, st2, if last: ? tUnit else: nil))
    SBind p, init, (? step):
        let st2 = HoldStmt env, st, p, init, step, s.span
        ((env, st2, if last: ? tUnit else: nil))
    SIgnore e:
        let st2 = IgnoreStmt env, st, e, s.span
        ((env, st2, if last: ? tUnit else: nil))
    SLet p, ?ty, e:
        let ((env2, st2)) = CheckLet env, st, p, ?ty, e, s.span
        ((env2, st2, if last: ? tUnit else: nil))
    SFn f:
        let ((env2, st2)) = CheckLocalFn env, st, clauses, s.span
        ((env2, st2, if last: ? tUnit else: nil))
    SSignature ignore: ((env, st, if last: ? tUnit else: nil))
    SWidget w:
        let ((t, st2)) = InferWidgetBlock env, st, w.body
        let st3 = match env.locals[SNameKey w.name]:
            ? sc: Unify st2, sc.ty, (TyAt t, env.scope), w.span
            nil: st2
        ((env, st3, if last: ? tUnit else: nil))
    SExpr e:
        let ((t, st2)) = BareLine env, st, e, last
        if last: ((env, st2, ? t))
        else: ((env, st2, nil))
    otherwise: ((env, (Err st, "mismatch", s.span, "this statement belongs in a `given:` or `update` block"), if last: ? tUnit else: nil))

# `<-` (Semantics ch. 8): a blueprint `@T` builds and binds its result; an element of the
# scope's row emits and binds its output; a `rebuild` or `for` binds what it hands back. A
# `$` or `!` of elements, or a `$@a`, is `bind-dynamic`. The row goes in an obligation.
BindStmt: unbounded fn Env, St, Pattern, Expr, Range -> St
fn BindStmt env, st, p, e, span:
    let ((t, st1)) = Infer env, st, e
    let ((out, st2)) = if IsBuilder e: ((t, st1)) else: BindOutput env, st1, t, e.span
    let ((ignore, st3)) = BindPattern env, st2, p, out, False
    st3

IsBuilder: fn Expr -> Bool
fn IsBuilder e = match e.kind:
    ERebuild ignore, ignore: True
    EFor ignore, ignore, ignore: True
    EGroup x: IsBuilder x
    otherwise: False

# What binding a value gives: a blueprint's result or an element's output.
BindOutput: unbounded fn Env, St, Ty, Range -> ((Ty, St))
fn BindOutput env, st, t, span = match Walk st, t:
    TyAt inner, rw: ((inner, (AddIncl st, rw, env.scope, span, "child")))
    TyElem rw, o: ((o, (AddIncl st, rw, env.scope, span, "element")))
    TySig s, inner:
        match Walk st, inner:
            TyAt ignore, ignore: ((TyErr, (ErrFix st, "bind-dynamic", span, "binding a `{ShowTy st, t}`; say what happens to the old widgets with `rebuild`", "write `rebuild` over the dynamic, with the blueprint inside")))
            TyElem ignore, ignore: match ?LiftedElement st, span:
                ? lift: ((TyErr, (RefuseLifted st, lift)))
                nil: ((TyErr, (ErrFix st, "bind-dynamic", span, "binding a `{ShowTy st, t}`, a {if s == "$": "dynamic" else: "event"} of elements; say what happens to the old element with `rebuild`", "write `rebuild` over the dynamic field's value, with the element inside")))
            otherwise: ((TyErr, (Err st, "mismatch", span, "`<-` binds a blueprint or an element; this is `{ShowTy st, t}`")))
    TyFlex ignore:
        let ((v, st2)) = FreshVar st, False, ""
        ((v, (Unify st2, t, (TyAt v, env.scope), span)))
    TyErr: ((TyErr, st))
    other: ((TyErr, (Err st, "mismatch", span, "`<-` binds a blueprint or an element; this is `{ShowTy st, other}`")))

# The identity field a statement's element was lifted at: a dynamic or an event given to an
# element's plain field inside `span` (Type System ch. 2-05: the construction lifts, and the
# statement that would build it refuses, at the field).
?LiftedElement: fn St, Range -> ?ElemLift
fn ?LiftedElement st, span = Fold st.elemLifts, nil, \|?found, l| match ?found:
    ? x: ? x
    nil: if l.file == st.file and l.arg.start >= span.start and l.arg.end <= span.end: ? l else: nil

# The refusal at the field: a dynamic there means a new element per value (`rebuild`), an
# event a value per firing (a hold).
RefuseLifted: fn St, ElemLift -> St
fn RefuseLifted st, l:
    if l.layer == "$": ErrFix st, "identity-dynamic", l.arg, "a dynamic in the identity field `{l.field}`", "for a new element per value, write `rebuild {l.src}:` with `{l.owner}({l.field}=_, ...)` inside"
    else: ErrFix st, "identity-dynamic", l.arg, "an event in the identity field `{l.field}`", "hold it first, `$x <- ... then {l.src}`, and give the field the `$x`"

AddIncl: fn St, Rw, Rw, Range, Text -> St
fn AddIncl st, sub, sup, span, what = update st:
    &_.incls <= Push &_.incls, Incl(sub=sub, sup=sup, file=&_.file, span=span, what=what, forward=False)

# A hold, `$x <- init then step` (Semantics ch. 4): the name is a `$T`, its initial value a
# `T`, its step an `!T`.
HoldStmt: unbounded fn Env, St, Pattern, Expr, Expr, Range -> St
fn HoldStmt env, st, p, init, step, span:
    let ((v, st1)) = FreshVar st, False, ""
    let held = TySig "$", v
    let ((ignore, st2)) = BindPattern env, st1, p, held, False
    let st3 = Check env, st2, init, v
    let ((stepTy, st4)) = Infer env, st3, step
    if (HeadSigil st4, stepTy) == "!" or stepTy == TyErr: Unify st4, (TySig "!", v), stepTy, step.span
    else: ErrFix st4, "mismatch", step.span, "a hold's step is an event; this is `{ShowTy st4, stepTy}`", "fire it with an event: `... on !e`"

# `ignore <- e` drops a build's or an element's result on purpose.
IgnoreStmt: unbounded fn Env, St, Expr, Range -> St
fn IgnoreStmt env, st, e, span:
    let ((t, st1)) = Infer env, st, e
    match Walk st1, t:
        TyAt ignore, ignore:
            let ((ignore, st2)) = BindOutput env, st1, t, e.span
            st2
        TyElem ignore, ignore:
            let ((ignore, st2)) = BindOutput env, st1, t, e.span
            st2
        TySig ignore, inner: match Walk st1, inner:
            TyAt ignore, ignore:
                let ((ignore, st2)) = BindOutput env, st1, t, e.span
                st2
            TyElem ignore, ignore:
                let ((ignore, st2)) = BindOutput env, st1, t, e.span
                st2
            otherwise: st1
        otherwise: st1

# A bare line: an element emits, a blueprint builds, a building `match` or `if` picks its
# arm once, `@ v` ends the block on `v`. Before the last line its result is `unit` or the
# line is `discarded`.
BareLine: unbounded fn Env, St, Expr, Bool -> ((Ty, St))
fn BareLine env, st, e, last:
    let ((t, st2)) = BareLineKind env, st, e, last
    let shown = match e.kind:
        EFreeSigil "@", ignore: TyAt t, env.scope
        EMatch ignore, ignore: TyAt t, env.scope
        EIf ignore, ignore, ignore: TyAt t, env.scope
        otherwise: t
    match e.kind:
        EFreeSigil "@", ignore: ((t, (NoteTy st2, e.span, shown)))
        EMatch ignore, ignore: ((t, (NoteTy st2, e.span, shown)))
        EIf ignore, ignore, ignore: ((t, (NoteTy st2, e.span, shown)))
        EGroup ignore: ((t, (NoteAsLast st2, e.span)))
        otherwise: ((t, st2))

# A group's type is its inside's, the note just made.
NoteAsLast: fn St, Range -> St
fn NoteAsLast st, span = match ?Last st.typed.exprs:
    ? n: NoteTy st, span, n.ty
    nil: st

BareLineKind: unbounded fn Env, St, Expr, Bool -> ((Ty, St))
fn BareLineKind env, st, e, last = match e.kind:
    EMatch scrut, arms: BuildingMatch env, st, scrut, arms, e.span, last
    EIf c, thenB, ?elseB: BuildingIf env, st, c, thenB, ?elseB, e.span, last
    EFreeSigil "@", x:
        let ((t, st2)) = Infer env, st, x
        if last: ((t, st2)) else: ((t, (Discarded st2, t, e.span)))
    EGroup x: BareLine env, st, x, last
    otherwise:
        let ((t, st1)) = Infer env, st, e
        let ((res, st2)) = match Walk st1, t:
            TyAt ignore, ignore: BindOutput env, st1, t, e.span
            TyElem ignore, ignore: BindOutput env, st1, t, e.span
            TySig ignore, inner if IsElemType st1, inner: BindOutput env, st1, t, e.span
            TyErr: ((tUnit, st1))
            other:
                if IsBuilder e: ((other, st1))
                else: if (Walk st1, other) == tUnit: ((tUnit, st1))
                else: ((other, (ErrFix st1, "mismatch", e.span, "a bare line emits an element or builds a blueprint; this is `{ShowTy st1, other}`", "end the block on a value with `@ {SrcText env, e.span}`")))
        if last: ((res, st2)) else: ((res, (Discarded st2, res, e.span)))

IsElemType: unbounded fn St, Ty -> Bool
fn IsElemType st, t = match Walk st, t:
    TyElem ignore, ignore: True
    otherwise: False

# `unit` before the last line (`discarded`, Semantics ch. 8).
Discarded: unbounded fn St, Ty, Range -> St
fn Discarded st, t, span = match Walk st, t:
    TyCon "unit", [[]]: st
    TyErr: st
    TyFlex ignore: Unify st, tUnit, t, span
    other: ErrFix st, "discarded", span, "this line's result is `{ShowTy st, other}`; drop it with `ignore <-`", "write `ignore <-` in front of it, or bind it"

# A `match` on a statement's place in a widget block builds its arm once, at build time:
# its scrutinee is plain (`building-match`), its arms widget blocks.
BuildingMatch: unbounded fn Env, St, Expr, [Arm], Range, Bool -> ((Ty, St))
fn BuildingMatch env, st, scrut, arms, span, last:
    let ((stTy, st1)) = Infer env, st, scrut
    let sh = HeadSigil st1, stTy
    let st2 = if IsTimeSigil sh: ErrFix st1, "building-match", scrut.span, "a blueprint in a match over a {if sh == "$": "dynamic" else: "event"}; use `rebuild`", "write `rebuild {SrcText env, scrut.span}:` with `match _:` inside" else: st1
    let plainScrut = if IsTimeSigil sh: InnerOf st2, stTy else: stTy
    let ((res, st3)) = FreshVar st2, False, ""
    let st4 = Fold arms, st3, \|s, arm|
        let ((env2, s1)) = match arm.?pattern:
            ? p: BindPattern env, s, p, plainScrut, True
            nil: ((env, s))
        let s2 = match arm.?guard:
            ? gd: CheckCond env2, s1, gd
            nil: s1
        let ((bt, s3)) = ArmWidgetBlock env2, s2, arm.body
        Unify s3, res, bt, arm.body.span
    let st5 = MatchCoverage env, st4, plainScrut, arms, span
    if last: ((res, st5)) else: ((res, (Discarded st5, res, span)))

BuildingIf: unbounded fn Env, St, Cond, Block, ?Block, Range, Bool -> ((Ty, St))
fn BuildingIf env, st, c, thenB, ?elseB, span, last:
    let ((env2, st1)) = match c:
        CondExpr e:
            let ((ct, s1)) = Infer env, st, e
            let sh = HeadSigil s1, ct
            let s2 = if IsTimeSigil sh: ErrFix s1, "building-match", e.span, "a blueprint in a match over a dynamic; use `rebuild`", "write `rebuild` over the condition, with `if _:` inside" else: s1
            ((env, (Unify s2, tBool, (if IsTimeSigil sh: InnerOf s2, ct else: ct), e.span)))
        CondBind p, e, ?gd:
            let ((et, s1)) = Infer env, st, e
            let ((en, s2)) = BindPattern env, s1, p, et, True
            match ?gd:
                ? g: ((en, (CheckCond en, s2, g)))
                nil: ((en, s2))
    let ((t1, st2)) = ArmWidgetBlock env2, st1, thenB
    match ?elseB:
        ? b:
            let ((t2, st3)) = ArmWidgetBlock env, st2, b
            let st4 = Unify st3, t1, t2, b.span
            if last: ((t1, st4)) else: ((t1, (Discarded st4, t1, span)))
        nil:
            let st3 = Unify st2, tUnit, t1, thenB.span
            ((tUnit, st3))

# An arm of a building `match`: a widget block, or a single line read as a bare line.
ArmWidgetBlock: unbounded fn Env, St, Block -> ((Ty, St))
fn ArmWidgetBlock env, st, b = InferWidgetBlock env, st, b
