# `Check.Blocks.Borrows`, a child module of `Check.Blocks`.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit r
use Check.Blocks.*
use Check.Blocks.Structure.*
use Syntax.*
use Syntax.Decls.*
use Syntax.Lexer.*
use Syntax.Lexer.Chars.*
use Syntax.Lexer.Layout.*
use Syntax.Lexer.Words.*
use Syntax.Lexer.Literals.*
use Syntax.Lexer.Templates.*
use Syntax.Lexer.Corpus.*
use Check.Errors.*
use Check.Types.*
use Check.Types.Recording.*
use Check.Types.Unify.*
use Check.Types.Schemes.*
use Check.Types.Colors.*
use Check.Env.*
use Check.Env.Names.*
use Check.Env.Reading.*
use Check.Env.Decls.*
use Check.Env.Traits.*
use Check.Expr.*
use Check.Expr.Operators.*
use Check.Expr.Calls.*
use Check.Expr.Patterns.*
use Check.Expr.Lifting.*
use Check.Expr.Lets.*
use Check.*
use Check.Passes.*
use Check.Passes.Cycles.*
use Check.Passes.Borrows.*
use Check.Shrink.*
use Check.Shrink.Types.*
use Check.Shrink.Calls.*
use Check.Shrink.Locals.*
use Check.Shrink.Relations.*
use Check.Shrink.Walk.*
use Check.Shrink.Summaries.*

# ---------------------------------------------------------------------------------------
# `&` blocks (Semantics ch. 5)
# ---------------------------------------------------------------------------------------

# `update v:` is a pure function of `v`: `&_` is the value being updated, the statements are
# steps, the block's value is the updated copy. A reference is typed as the part it names.
InferUpdate: unbounded fn Env, St, Expr, Block, Range -> ((Ty, St))
fn InferUpdate env, st, target, body, span:
    let ((t, st1)) = Infer env, st, target
    let sh = HeadSigil st1, t
    let st2 = if (IsTimeSigil sh) or sh == "@": ErrFix st1, "time-in-update", target.span, "`update` over a `{ShowTy st1, t}`", "update the plain value, and lift the function that does it" else: st1
    let env2 = update (WithTopic env, "&_", t):
        &_.inUpdate <= True
    let ((ignore, st3)) = UpdateStmts env2, st2, body.stmts
    let st4 = AndBlockChecks env2, st3, body, t
    ((t, st4))

# A put at a key of a non-empty map (Type System ch. 2, Collections): `nil` there removes
# the key (Jimmy's ruling on map entries) and could leave the map empty, so the value is
# one written `? v`, which only adds or replaces. An array has no entry to remove (`nil` at
# its index is a fault of the run), so a `[a]+` keeps its promise.
KeepsNonEmpty: unbounded fn Env, St, Expr, Expr -> St
fn KeepsNonEmpty env, st, target, value = match target.kind:
    EGroup x: KeepsNonEmpty env, st, x, value
    EHold x: KeepsNonEmpty env, st, x, value
    EIndex collection, ignore:
        # the collection's type, read in a state that is dropped: its notes and errors are
        # the target's already
        let ((ct, read)) = Infer env, st, collection
        match ?NonEmptyMap read, ct:
            ? ignore:
                let shown = ShowTy read, ct
                let plain = "update the plain map (`as` drops the promise) and check the result with `as {shown}?`"
                match SetValue value:
                    SetsPresent: st
                    SetsAbsent: ErrFix st, "mismatch", value.span, "putting `nil` at a key removes it, and a `{shown}` is non-empty", plain
                    SetsEither: ErrFix st, "mismatch", value.span, "this may be `nil`, which put at a key removes it, and a `{shown}` is non-empty", "write `? v` to put a value, or {plain}"
            nil: st
    otherwise: st

# The map a non-empty map's type holds; none for any other type.
?NonEmptyMap: unbounded fn St, Ty -> ?Ty
fn ?NonEmptyMap st, t = match ?NonEmptyColl st, t:
    ? c: match Walk st, c:
        TyMap ignore, ignore: ? c
        otherwise: nil
    nil: nil

# What a set's value is as written: `? v`, `nil`, or a value that may be either.
type SetWritten = choice:
    SetsPresent
    SetsAbsent
    SetsEither

SetValue: fn Expr -> SetWritten
fn SetValue value = match value.kind:
    EGroup x: SetValue x
    EHold x: SetValue x
    EFreeSigil "?", ignore: SetsPresent
    ENil ignore: SetsAbsent
    otherwise: SetsEither

UpdateStmts: unbounded fn Env, St, [Stmt] -> ((Env, St))
fn UpdateStmts env, st, stmts = Fold stmts, ((env, st)), \|((en, s)), stmt| UpdateStmt en, s, stmt

UpdateStmt: unbounded fn Env, St, Stmt -> ((Env, St))
fn UpdateStmt env, st, s = match s.kind:
    SSet target, value:
        let ((pt, st1)) = InferPlace env, st, target
        let st2 = RefTarget env, st1, target
        match ?EntryParts st2, pt:
            ? ignore: ((env, (SetEntry env, (Checked env, st2, value), target, value)))
            nil: ((env, (KeepsNonEmpty env, (Check env, st2, value, pt), target, value)))
    SPut target, value:
        let ((pt, st1)) = InferPlace env, st, target
        let st2 = RefTarget env, st1, target
        match ?EntryParts st2, pt:
            ? ((ignore, v)): ((env, (KeepsNonEmpty env, (Check env, st2, value, (TySig "?", v)), target, value)))
            nil:
                let st3 = Checked env, st2, value
                if (Walk st3, pt) == TyErr: ((env, st3))
                else: ((env, (ErrFix st3, "put-location", target.span, "`<:` puts a map entry, and `{SrcText env, target.span}` is a location", "write `{SrcText env, target.span} <= {SrcText env, value.span}`")))
    SAccum target, op, value:
        let ((tt, st1)) = Infer env, st, target
        let st2 = RefTarget env, st1, target
        let st3 = Check env, st2, value, tt
        let st4 = AddWant st3, "Prelude.Num", tt, s.span
        let st5 = if op == "-=": AddWant st4, "Prelude.Sub", tt, s.span else: st4
        ((env, st5))
    SLet p, ?ty, e:
        let ((t, st1)) = Infer env, st, e
        let st2 = match ?ty:
            ? ty:
                let ((at, s2)) = ConvType (EnvCx env), st1, ty
                Unify s2, at, t, e.span
            nil: st1
        let ((env2, st3)) = BindPattern (Unpending env), st2, p, t, False
        ((env2, st3))
    SWhile c, body: ((env, (UpdateWhile env, st, c, body)))
    SExpr e: match e.kind:
        EIf c, thenB, ?elseB: ((env, (UpdateIf env, st, c, thenB, ?elseB)))
        EMatch scrut, arms: ((env, (UpdateMatch env, st, scrut, arms, e.span)))
        EFor ?binders, source, body: ((env, (UpdateFor env, st, ?binders, source, body, e.span)))
        # a line `x <= e` is a set, never a comparison (Semantics ch. 5, "Statements": "A
        # comparison is never a statement"): one the parser did not read as a set has no
        # reference path on its left
        EBinary "<=", left, ignore: ((env, (SetWithoutReference env, st, left)))
        otherwise:
            let ((t, st1)) = Infer env, st, e
            ((env, (Discarded st1, t, e.span)))
    SFn f:
        let ((env1, st1)) = PreBind env, st, s
        CheckLocalFn env1, st1, [[f]], s.span
    SSignature ignore: PreBind env, st, s
    otherwise: ((env, (Err st, "mismatch", s.span, "this statement belongs in a widget or `given:` block")))

# `set-entry`: `<=` sets a location, and a map's entry is put with `<:`.
SetEntry: fn Env, St, Expr, Expr -> St
fn SetEntry env, st, target, value = ErrFix st, "set-entry", target.span, "`<=` sets a location, and `{SrcText env, target.span}` is a map entry", "write `{SrcText env, target.span} <: {SrcText env, value.span}`"

# A value read for its own errors where the statement is refused.
Checked: unbounded fn Env, St, Expr -> St
fn Checked env, st, e:
    let ((ignore, st2)) = Infer env, st, e
    st2

# The left side of a set is a reference: `&_`, a local, a lens path from either.
RefTarget: unbounded fn Env, St, Expr -> St
fn RefTarget env, st, e = if IsRef e: st else: ErrFix st, "mismatch", e.span, "the left of `<=` is a reference: `&_`, a local `&x`, or a path from one", "write `&_.{SrcText env, e.span}`, or make a local with `let &x = ...`"

# The left of a line `x <= e` that is no reference path: a path from a reference whose
# field step shows the field's stack (a reference path writes its steps bare, `&_.note`
# for a `?note` field), or no reference at all.
SetWithoutReference: unbounded fn Env, St, Expr -> St
fn SetWithoutReference env, st, left = match ?BarePath env, left:
    ? bare: ErrFix st, "mismatch", left.span, "a reference path writes its field steps bare; `{SrcText env, left.span}` shows a field's stack", "write `{bare}`"
    nil: ErrFix st, "mismatch", left.span, "the left of `<=` is a reference: `&_`, a local `&x`, or a path from one", "set a part of `&_`, or make a local with `let &x = ...`"

# A path from a reference with its field steps written bare; none when it starts at no
# reference.
?BarePath: unbounded fn Env, Expr -> ?Text
fn ?BarePath env, e = match e.kind:
    EName n: if HasPrefix n.sigils, "&": ? (SrcText env, e.span) else: nil
    EField r, ignore, field: match ?BarePath env, r:
        ? root: ? "{root}.{field.name}"
        nil: nil
    EIndex r, index: match ?BarePath env, r:
        ? root: ? "{root}[{SrcText env, index.span}]"
        nil: nil
    EGroup x: ?BarePath env, x
    EHold x: ?BarePath env, x
    otherwise: match ?LensApplied e:
        ? ((ignore, argument)): match ?BarePath env, argument:
            ? ignore: ? (SrcText env, e.span)
            nil: nil
        nil: nil

IsRef: unbounded fn Expr -> Bool
fn IsRef e = match e.kind:
    EName n: (HasPrefix n.sigils, "&")
    EField r, ignore, ignore: IsRef r
    EIndex r, ignore: IsRef r
    EGroup x: IsRef x
    EHold x: IsRef x
    # a named lens applied to a reference is one ("applying it gives back a reference")
    otherwise: match ?LensApplied e:
        ? ((ignore, argument)): IsRef argument
        nil: False

# ---------------------------------------------------------------------------------------
# Map entries (Jimmy's ruling on map entries, 11 and 12 November)
# ---------------------------------------------------------------------------------------

# On a map, `&m[k]` is an `Entry K V`: no location, so `<=` does not set it and it has no
# fields and no index. `<:` puts it from a `?V` (`? v` puts the value, `nil` removes the
# key), and a read gives the `?V` that `m[k]` gives. A named lens may take or give back an
# entry, as any function may.

# A reference as the place it names (a set's or a put's target, a lens's body or
# argument): an index path into a map is the key's entry, a lens applied is what its
# signature gives back; anything else is the part it names, as `Infer` types it. The
# entry's index path is noted at its read, `?V`.
InferPlace: unbounded fn Env, St, Expr -> ((Ty, St))
fn InferPlace env, st, e = match e.kind:
    EGroup x: InferPlace env, st, x
    EHold x: InferPlace env, st, x
    EIndex r, k:
        let ((ct, st1)) = if IsRef r: Infer env, st, r else: ((TyErr, st))
        match ?MapParts st1, ct:
            ? ((kt, vt)):
                let st2 = Check env, st1, k, kt
                (((EntryOf kt, vt), (NoteTy st2, e.span, (TySig "?", vt))))
            nil: Infer env, st, e
    otherwise: match ?LensApplied e:
        ? ignore:
            let ((t, st1)) = InferKind env, st, e
            ((t, (NoteTy st1, e.span, (EntryRead st1, t))))
        nil: Infer env, st, e

# The key's and the value's types of a map, a non-empty one or a `Table`.
?MapParts: unbounded fn St, Ty -> ?((Ty, Ty))
fn ?MapParts st, t = match Walk st, (Or (?NonEmptyColl st, t), t):
    TyMap k, v: ? ((k, v))
    TyCon "Table", [[k, v]]: ? ((k, v))
    otherwise: nil

EntryOf: fn Ty, Ty -> Ty
fn EntryOf k, v = TyCon "Prelude.Entry", [[k, v]]

# The key's and the value's types of an entry; none for any other type.
?EntryParts: unbounded fn St, Ty -> ?((Ty, Ty))
fn ?EntryParts st, t = match Walk st, t:
    TyCon "Prelude.Entry", [[k, v]]: ? ((k, v))
    otherwise: nil

IsEntry: unbounded fn St, Ty -> Bool
fn IsEntry st, t = match ?EntryParts st, t:
    ? ignore: True
    nil: False

# An entry read: the value's `?V`; any other type as it is.
EntryRead: unbounded fn St, Ty -> Ty
fn EntryRead st, t = match ?EntryParts st, t:
    ? ((ignore, v)): TySig "?", v
    nil: t

# The state after a reference path that names an entry is read, where it names one: the
# receiver of a field or an index step, which an entry does not have.
?EntryIn: unbounded fn Env, St, Expr -> ?St
fn ?EntryIn env, st, e:
    if (IsRef e) and MayNameEntry e:
        let ((t, st1)) = InferPlace env, st, e
        if IsEntry st1, t: ? st1 else: nil
    else: nil

# An index step or a lens applied, the steps that may end at an entry.
MayNameEntry: fn Expr -> Bool
fn MayNameEntry e = match e.kind:
    EGroup x: MayNameEntry x
    EHold x: MayNameEntry x
    EIndex ignore, ignore: True
    otherwise: match ?LensApplied e:
        ? ignore: True
        nil: False

# The fix of a field or an index step through an entry.
let entryChange = "read the value at the key, change it, and put it back with `<:`"

# ---------------------------------------------------------------------------------------
# Named lenses (Semantics ch. 5, "References and lens paths"; Type System ch. 3, "Lenses")
# ---------------------------------------------------------------------------------------

# A named lens's definition, `fn &Acc &vm = &vm.regs.acc`: its one clause's parameter is
# a reference, and its body a reference from that parameter, a lens path or a lens applied
# to one ("A lens's result is alive while its argument is"; "Nothing else makes a
# reference"). The body is read as an `update` block's statement is: the parameter is the
# part it names, and so is the body. A lens whose signature was refused has no type, and
# its body is not read.
CheckLens: unbounded fn Env, St, Text, [FnClause], Scheme, Range -> St
fn CheckLens env, st, name, clauses, sc, span = match sc.ty:
    TyErr: st
    otherwise:
        let env2 = update env:
            &_.inUpdate <= True
        let st1 = CheckClauses env2, st, name, clauses, sc, span
        let st2 = match clauses[0]:
            ? c: LensClause env, st1, c
            nil: st1
        Fold (Drop clauses, 1), st2, \|s, c| ErrFix s, "lens-body", c.span, "a lens has one clause: its body is one path", "delete this clause"

LensClause: unbounded fn Env, St, FnClause -> St
fn LensClause env, st, c = match c.params[0]:
    ? p: match ?LensParameter p:
        nil: ErrFix st, "lens-body", p.span, "a lens's parameter is a reference, written with `&`", "write `&{SrcText env, p.span}`, and the body as a path from it"
        ? n:
            let root = SNameKey n
            let wrong = "a lens's body is a reference from its parameter: a path from `{root}`, or a lens applied to one"
            match c.body:
                BodyExpr e:
                    if (IsRef e) and (Take (RefPath e), 1) == [[root]]: st
                    else: ErrFix st, "lens-body", e.span, wrong, "write a path, `{root}.field`"
                BodyBlock b: ErrFix st, "lens-body", b.span, wrong, "write a path, `{root}.field`"
    nil: st

# A lens's parameter as written, `&vm`.
?LensParameter: fn Pattern -> ?SName
fn ?LensParameter p = match p.kind:
    PName n: if (HasPrefix n.sigils, "&") and not (IsLensName n): ? n else: nil
    PGroup q: ?LensParameter q
    otherwise: nil

# `lens-argument`: a named lens is applied to a reference, and no reference exists outside
# an `update` block or a lens's body.
LensArgument: unbounded fn Env, St, Expr -> St
fn LensArgument env, st, e = match ?LensApplied e:
    ? ((n, argument)):
        if IsRef argument: st
        else: ErrFix st, "lens-argument", e.span, "the lens `{SNameKey n}` is applied to a reference, and `{SrcText env, argument.span}` is a plain value", "apply it in an `update` block, to `&_`, a local `&x`, or a path from one"
    nil: st

UpdateIf: unbounded fn Env, St, Cond, Block, ?Block -> St
fn UpdateIf env, st, c, thenB, ?elseB:
    let ((env2, st1)) = match c:
        CondExpr e: ((env, (CheckCond env, st, e)))
        CondBind p, e, ?gd:
            let ((et, s1)) = Infer env, st, e
            let ((en, s2)) = BindPattern (Unpending env), s1, p, et, True
            match ?gd:
                ? g: ((en, (CheckCond en, s2, g)))
                nil: ((en, s2))
    let ((ignore, st2)) = UpdateStmts env2, st1, thenB.stmts
    match ?elseB:
        ? b:
            let ((ignore, st3)) = UpdateStmts env, st2, b.stmts
            st3
        nil: st2

UpdateMatch: unbounded fn Env, St, Expr, [Arm], Range -> St
fn UpdateMatch env, st, scrut, arms, span:
    let ((t, st1)) = Infer env, st, scrut
    let st2 = Fold arms, st1, \|s, arm|
        let ((env2, s1)) = match arm.?pattern:
            ? p: BindPattern (Unpending env), s, p, t, True
            nil: ((env, s))
        let s2 = match arm.?guard:
            ? gd: CheckCond env2, s1, gd
            nil: s1
        let ((ignore, s3)) = UpdateStmts env2, s2, arm.body.stmts
        s3
    MatchCoverage env, st2, t, arms, span

# `while c:` and `while pattern <- e:` (doubt WB: a pattern's names are bound for the turn).
UpdateWhile: unbounded fn Env, St, Cond, Block -> St
fn UpdateWhile env, st, c, body:
    let ((env2, st1)) = match c:
        CondExpr e: ((env, (CheckCond env, st, e)))
        CondBind p, e, ?gd:
            let ((et, s1)) = Infer env, st, e
            let ((en, s2)) = BindPattern (Unpending env), s1, p, et, True
            match ?gd:
                ? g: ((en, (CheckCond en, s2, g)))
                nil: ((en, s2))
    let ((ignore, st2)) = UpdateStmts env2, st1, body.stmts
    st2

# `for &s <- &_.xs:` yields a reference per element; `for x <- xs:` values; the bare form
# rebinds `&_` to the element. With one binder or none, `key` is the entry's key, as in a
# widget's `for` (Semantics ch. 4; Jimmy's ruling KY): a map's key, an array's index.
UpdateFor: unbounded fn Env, St, ?ForBinders, Expr, Block, Range -> St
fn UpdateFor env, st, ?binders, source, body, span:
    let ((t, st1)) = Infer env, st, source
    let ((k, v, st2)) = CollParts st1, t, source.span
    let env1 = LoopIndices env
    let ((env2, st3)) = match ?binders:
        nil: (((WithTopic (WithTopic env1, "&_", v), "key", k), st2))
        ? bs: match bs.?second:
            ? second:
                let ((e1, s1)) = BindPattern (Unpending env1), st2, bs.first, k, False
                let ((e2, s2)) = BindPattern e1, (ForBinderMatches env, s1, bs.first, k), second, v, False
                ((e2, (ForBinderMatches env, s2, second, v)))
            nil:
                let ((e2, s2)) = BindPattern (Unpending (WithTopic env1, "key", k)), st2, bs.first, v, False
                ((e2, (ForBinderMatches env, s2, bs.first, v)))
    let ((ignore, st4)) = UpdateStmts env2, st3, body.stmts
    st4
