# The checker's types (Type System ch. 5, "The three layers of a type"): the plain layer
# (constructors, records, tuples, maps, arrays, functions, variables, associated types),
# the functor stack (sigils over a plain layer, outermost first; `@` names a row), and
# the color of a function type. Substitutions, unification with rows (families as the
# unit, one tail variable, lacks sets), instantiation and generalization.
#
# Written by Claude, 31 October 2026, on the claude-self-hosting branch. Subject to change:
# Jimmy rewrites it by hand, and an implementer reading it uses their own discretion.
emit r
mod Recording
mod Unify
mod Schemes
mod Colors
use Syntax.*
use Syntax.Decls.*
use Syntax.Lexer.*
use Syntax.Lexer.Chars.*
use Syntax.Lexer.Layout.*
use Syntax.Lexer.Words.*
use Syntax.Lexer.Literals.*
use Syntax.Lexer.Templates.*
use Syntax.Lexer.Corpus.*
use Check.Errors.*
use Check.Typed.*
use Check.Typed.Print.*
use Check.Types.Recording.*
use Check.Types.Unify.*
use Check.Types.Schemes.*
use Check.Types.Colors.*

# ---------------------------------------------------------------------------------------
# Colors, rows, types
# ---------------------------------------------------------------------------------------

# A function type's color (ch. 5, "The color"): bounded, unbounded, a color variable
# rigid in a body (`CRigid`), quantified in a scheme (`CQ`), or flexible (`CFlex`: a
# lambda's, a call's, a function value's whose type is not known yet), bound by
# unification and by the joins below.
type Col = choice:
    CBound
    CUnbound
    CRigid Text
    CQ Text
    CFlex Nat
derive ^Eq, ^Show

# A join the color owes (ch. 5, The color, doubt CJ): `lo` at most `hi`, from the place
# that made it. `kind` says which rule: `body` (a body applied something of color `lo`,
# `name` the body, `why` the callee), `lambda` (the same for a lambda's body), `arg` (a
# closure argument under its parameter's color, `name` the callee), `lifted` (a lifted
# application, `name` the callee, `why` what it is lifted over).
type CLeq = record:
    lo: Col
    hi: Col
    file: Nat
    span: Range
    kind: Text
    name: Text
    why: Text
derive ^Eq, ^Show

# A row's tail: closed, a flexible variable, a rigid one, or one quantified in a scheme.
type Tail = choice:
    TlClosed
    TlFlex Nat
    TlRigid Text
    TlQ Text
    # an associated row at its type, `Lower d` (Type System ch. 3): the trait, the row's
    # name, the type; the impl's row once the type is known
    TlAssoc Text, Text, Ty
    # a whole row standing for a row variable in a substitution only (a type's row
    # argument, ruling RR): `SubstRowQ` merges it into the row it stands in
    TlRow Rw
    # several variables in one row, each decided apart (Jimmy, 13 November, ruling RT:
    # `@HostDocument ... emit lower | rest`); never empty nor of one part (`UnionTail`)
    TlUnion [Tail]
derive ^Eq, ^Show

# A row: a set of families (sorted), the tags an arm above has taken (the remainder
# inside a match; source never spells one), and at most one tail.
type Rw = record:
    fams: [Text]
    minus: [Text]
    tail: Tail
    # a family's indices where the row names it applied (`Seat.* Chess Player`; Jimmy's
    # ruling AF); `TyEvery` at an index is every case of its kind (`Seat.* Chess _`)
    idx: (Text ==> [Ty])
derive ^Eq, ^Show

type Ty = choice:
    TyFlex Nat
    TyRigid Text
    TyQ Text
    TyCon Text, [Ty]
    TyFn Col, [Ty], Ty
    TyTuple [Ty]
    TyArray Ty
    TyMap Ty, Ty
    TySig Text, Ty
    TyAt Ty, Rw
    TyElem Rw, Ty
    TyElemAny Rw
    # an associated type applied: the trait that declares it (its key), its name, its
    # argument, and its further arguments, its indices (`Request d r`; Type System ch. 6)
    TyAssoc Text, Text, Ty, [Ty]
    # a role constructor in type position, an associated type's index (`Request d
    # Player`; Type System ch. 6): the constructor's key
    TyRole Text
    TyAny [Text]
    # `any r: t where r: ^C` (Type System ch. 3; Jimmy's ruling FA): its variables, by
    # canonical names (`ExistsVar`), the type over them, and their bounds
    TyExists [Text], Ty, [((Text, Text))]
    # `forall o. fn Path, Element c o -> @o` inside a type (Jimmy's ruling FA, a type alias's
    # body): its variables (as `TyQ`s in the body), each use a fresh instance
    TyForall [Text], Ty
    # `_` at a family's index in a row: every case of the index's kind
    TyEvery
    TyErr
derive ^Eq, ^Show

# What the checker knows of a flexible variable: whether it is plain-headed (it stands
# for no type with a sigil on top, ch. 5), its level for generalization, and the binder
# whose marks made it, for `mark-stack`.
type VInfo = record:
    plain: Bool
    level: Nat
    name: Text
derive ^Eq, ^Show

# A wanted constraint, `^Trait ty`, from the place that made it.
type Want = record:
    cls: Text
    ty: Ty
    file: Nat
    span: Range
    level: Nat
derive ^Eq, ^Show

# A type scheme: quantified type variables (free-headed, or plain-headed when a local
# `let` generalized a plain-headed variable), row variables, color variables and the
# joins `lo ≤ hi` between them (a signature's own color above its function parameters',
# round 3 CD), bounds.
type Scheme = record:
    qs: [Text]
    plainQs: [Text]
    rqs: [Text]
    cqs: [Text]
    cjoins: [((Text, Text))]
    bounds: [((Text, Text))]
    # The associated-type equations a closed local `let` quantified over, as constraints
    # each use meets at its own types (`Item a = Text`; GHC's MonoLocalBinds, ruling SH).
    eqs: [Waiting]
    ty: Ty
derive ^Eq, ^Show

# A row obligation `R1 ≤ R2` (ch. 5, "Inclusion is not unification"), discharged after a
# definition's unifications: `what` says whose row is checked, for the message.
type Incl = record:
    sub: Rw
    sup: Rw
    file: Nat
    span: Range
    what: Text
    forward: Bool
derive ^Eq, ^Show

# The inference state, threaded through every judgment.
type St = record:
    next: Nat
    tys: (Nat ==> Ty)
    infos: (Nat ==> VInfo)
    rows: (Nat ==> Rw)
    lacks: (Nat ==> [Text])
    wants: [Want]
    incls: [Incl]
    diags: [CDiag]
    level: Nat
    file: Nat
    color: Col
    colorWhy: Text
    colorFlex: [((Col, Text, Range))]
    cols: (Nat ==> Col)
    cleqs: [CLeq]
    colQ: (Nat ==> Text)
    colUp: (Text ==> Text)
    deferred: [Waiting]
    binderAt: (Nat ==> Range)
    rowNames: (Nat ==> Text)
    layerQs: [((Ty, Range, Text))]
    fieldQs: [FieldQ]
    recording: Bool
    typed: TProgram
    choices: (Text ==> [Text])
    sizeTys: (Text ==> Ty)
    # Every block's `fn` with no signature line, by its file and where its first clause
    # starts (`FILE.START`, as the shrink check keys a local): one that calls itself is
    # `no-signature` (Jimmy's ruling LS; `UnsignedOnCycle`).
    unsignedFns: [Text]
    # The next local binder's id in the definition being checked, and the id each binder
    # (by file and place) was given, so a binder bound twice (ahead, then at its line)
    # keeps one id (pick UN).
    localNext: Nat
    localIds: (Text ==> Nat)
    # The bounds of every existential unpacked at a parameter, by its rigid type (`e'N`,
    # Type System ch. 5): givens for the rest of the program.
    anyGivens: [((Text, Text))]
    # a trait's bounds on types of its parameter, given in its default bodies
    # (`State d: ^SerializableValue`)
    headGivens: [((Ty, Text))]
    # Every impl's associated types, for normalizing (Type System ch. 5, Traits): the
    # associated type's trait and name, the impl's head and its variables, and the type it chooses.
    assocImpls: [AssocImpl]
    assocRowImpls: [AssocRowImpl]
    # The result variables of the matches and `if`s with a `[a]+` arm beside an `[a]` arm:
    # such a construct's value is the `[a]` (`UnifyArm`, `ArmResult`).
    plainArms: [Nat]
    # The places an `Error` value meets a type that may be a `~T` (a clause's result, an
    # arm against the match's, a field, an element): at the program's end those where it
    # is one are the typed output's `faults` (`FaultNotes`).
    faultQs: [Waiting]
    # The places a non-empty collection's value meets a type that may be its plain
    # collection's (an argument, an arm against the match's, an entry): at the program's end
    # those where it is one are the typed output's `plains` (`PlainNotes`).
    plainQs: [Waiting]
    # Element constructions lifted at an identity field, each refused by the statement that
    # would build it (`LiftedElement`).
    elemLifts: [ElemLift]
    # An `Error` value at a place nothing has decided yet (an array's element, a tuple's
    # part, a generic parameter, an arm) has a variable of its own (`FaultVar`), which the
    # places it meets later decide: a `~T`, so the value is its failure, or `Error`. The
    # definition's end makes `Error` of one nothing decided (`DefaultDef`), the program's
    # end refuses one decided as anything else (`FaultsSettled`); monomorphic till then
    # (`KeepWaitingBut`). Each waits as `t = Error` at its value's place.
    faultVars: [Waiting]
    # Every local binder's id and every use's, in the order checked (`IsClosed`).
    binderIds: [Nat]
    useIds: [Nat]
    # Each use of a trait's method, by its file and place (`UseKey`), with the method's
    # key: a want made there is the method's own, and not a function's bound, when it is
    # asked of a packed value (Jimmy's ruling EX; `AskOfPacked`).
    methodUses: (Text ==> Text)
    # Each `any e` whose existential was not known where it stood (a constructor's field,
    # an argument, an array's element): its bounds are wanted at `e`'s type once the
    # variable it gave is an existential (Type System ch. 5, "Existentials are
    # dictionaries"; `ResolvePacks`).
    packs: [Pack]
    # The definition being checked, by its own key (`OwnKey`), and every use by name of a
    # definition with type parameters, kept whether or not the typed program is
    # recorded, for the growth check (`GrowthCheck`; ruling PG).
    definition: Text
    genericUses: [GenericUse]
    # Every name a pattern binds in the definition being checked, asked at its end whether
    # its case says what it holds (`CaseQuestions`).
    caseQs: [CaseQ]
derive ^Eq, ^Show

# A name a pattern binds: the name as written, its sigils, the name under them, the marks
# its type shows, the type it was bound to and where it stands.
type CaseQ = record:
    name: Text
    sigils: Text
    bare: Text
    marks: Text
    ty: Ty
    span: Range
    file: Nat
derive ^Eq, ^Show

# One use by name of a definition with type parameters: the definition the use
# stands in, the one it names, where, and the type the use gives each of the named
# definition's type parameters (over the type parameters of the one it stands in).
type GenericUse = record:
    user: Text
    target: Text
    file: Nat
    span: Range
    types: [((Text, Ty))]
derive ^Eq, ^Show

# An impl's associated row, `row Lower = Ui.*` (Type System ch. 3).
type AssocRowImpl = record:
    cls: Text
    name: Text
    head: Ty
    chosen: Rw
derive ^Eq, ^Show

type AssocImpl = record:
    cls: Text
    name: Text
    head: Ty
    qs: [Text]
    # an equation's indices, one per further parameter of the associated type (Type
    # System ch. 6): none for an associated type with no further parameters
    indices: [AssocIndex]
    value: Ty
derive ^Eq, ^Show

# One index of an equation (`type Request Librarian = ...`, `type Query r = ...`): a role
# constructor, by its key, or a variable, which stands for every role.
type AssocIndex = choice:
    IndexRole Text
    IndexVar Text
derive ^Eq, ^Show

# A dynamic (`$`) or event (`!`) given at an element's identity field `field`, at `arg` in
# `file`, written `src`, of the tag `owner`.
type ElemLift = record:
    field: Text
    owner: Text
    arg: Range
    file: Nat
    layer: Text
    src: Text
derive ^Eq, ^Show

# An equation that waits for an associated type's argument (`Item t3` against `Text`),
# with the file it was met in: retried there once the variable is bound.
type Waiting = record:
    expected: Ty
    found: Ty
    span: Range
    file: Nat
derive ^Eq, ^Show

# An `any e` waiting for the existential it meets: the variable it gave, `e`'s type, and
# where it stands.
type Pack = record:
    result: Ty
    inner: Ty
    file: Nat
    span: Range
derive ^Eq, ^Show

# A place's key in `methodUses`.
UseKey: fn Nat, Range -> Text
fn UseKey file, span = "{file}:{span.start}:{span.end}"

NewSt: fn Nat -> St
fn NewSt file = St(next=0, tys={{}}, infos={{}}, rows={{}}, lacks={{}}, wants=[[]], incls=[[]], diags=[[]], level=0, file=file, color=CBound, colorWhy="", colorFlex=[[]], cols={{}}, cleqs=[[]], colQ={{}}, colUp={{}}, deferred=[[]], binderAt={{}}, rowNames={{}}, layerQs=[[]], fieldQs=[[]], recording=False, typed=emptyTyped, choices={{}}, sizeTys={{}}, unsignedFns=[[]], localNext=0, localIds={{}}, anyGivens=[[]], headGivens=[[]], assocImpls=[[]], assocRowImpls=[[]], plainArms=[[]], faultQs=[[]], plainQs=[[]], elemLifts=[[]], faultVars=[[]], binderIds=[[]], useIds=[[]], methodUses={{}}, packs=[[]], definition="", genericUses=[[]], caseQs=[[]])

Closed: fn [Text] -> Rw
fn Closed fs = Rw(fams=(SortTexts fs), minus=[[]], tail=TlClosed, idx={{}})

let emptyRow = Rw(fams=[[]], minus=[[]], tail=TlClosed, idx={{}})

# The primitive types by name.
let tInt = TyCon "Int", [[]]
let tNat = TyCon "Nat", [[]]
let tText = TyCon "Text", [[]]
let tBool = TyCon "Bool", [[]]
let tUnit = TyCon "unit", [[]]

# The trait whose `Quotient` the checker reads `/` with (Type System ch. 3; doubt QD): the
# prelude's `^Num` declares no associated type, so the checker owns this one.
let quotientTrait = "Prelude.Num"
let tChar = TyCon "Char", [[]]
let tFloat = TyCon "Float", [[]]

# ---------------------------------------------------------------------------------------
# Small helpers over lists of texts and numbers
# ---------------------------------------------------------------------------------------

HasText: fn [Text], Text -> Bool
fn HasText xs, x = Fold xs, False, \|seen, y| seen or y == x

HasNat: fn [Nat], Nat -> Bool
fn HasNat xs, x = Fold xs, False, \|seen, y| seen or y == x

AddText: fn [Text], Text -> [Text]
fn AddText xs, x = if HasText xs, x: xs else: Push xs, x

UnionTexts: fn [Text], [Text] -> [Text]
fn UnionTexts xs, ys = Fold ys, xs, \|acc, y| AddText acc, y

MinusTexts: fn [Text], [Text] -> [Text]
fn MinusTexts xs, ys = Filter xs, \|x| not (HasText ys, x)

InterTexts: fn [Text], [Text] -> [Text]
fn InterTexts xs, ys = Filter xs, \|x| HasText ys, x

AddNat: fn [Nat], Nat -> [Nat]
fn AddNat xs, x = if HasNat xs, x: xs else: Push xs, x

SortTexts: fn [Text] -> [Text]
fn SortTexts xs = Fold xs, [[]], \|acc, x| if HasText acc, x: acc else: Append (Push (Filter acc, \|y| y < x), x), (Filter acc, \|y| not (y < x))

# The last segment of a qualified name: `Chess.Sq` prints as `Sq`.
BareName: fn Text -> Text
fn BareName q = Or (?Last (SplitOn q, ".")), q

# ---------------------------------------------------------------------------------------
# Fresh variables and the substitution
# ---------------------------------------------------------------------------------------

# A fresh flexible variable, plain-headed or free-headed, at the current level.
FreshVar: fn St, Bool, Text -> ((Ty, St))
fn FreshVar st, plain, name:
    let n = st.next
    let st2 = update st:
        &_.next += 1
        &_.infos <= Insert &_.infos, n, VInfo(plain=plain, level=&_.level, name=name)
    ((TyFlex n, st2))

# A fresh color variable at the current level.
FreshCol: fn St -> ((Col, St))
fn FreshCol st:
    let n = st.next
    let st2 = update st:
        &_.next += 1
        &_.infos <= Insert &_.infos, n, VInfo(plain=False, level=&_.level, name="")
    ((CFlex n, st2))

# ---------------------------------------------------------------------------------------
# Stacks
# ---------------------------------------------------------------------------------------

# The sigil stack of a type, outermost first: `$?Text` has `$?`.
StackOf: unbounded fn St, Ty -> Text
fn StackOf st, t = match Walk st, t:
    TySig s, i: "{s}{StackOf st, i}"
    TyAt i, ignore: "@{StackOf st, i}"
    otherwise: ""

# The outermost sigil, or "" for a plain head (a variable's head is "" too).
HeadSigil: unbounded fn St, Ty -> Text
fn HeadSigil st, t = match Walk st, t:
    TySig s, ignore: s
    TyAt ignore, ignore: "@"
    otherwise: ""

IsFlexVar: unbounded fn St, Ty -> Bool
fn IsFlexVar st, t = match Walk st, t:
    TyFlex ignore: True
    otherwise: False

# A free-headed variable: one that may still turn out to have a sigil on top.
IsFreeHeaded: unbounded fn St, Ty -> Bool
fn IsFreeHeaded st, t = match Walk st, t:
    TyFlex n: not (InfoOf st, n).plain
    otherwise: False

# A non-empty array or map, `[a]+` and `(K ==> V)+` (Type System ch. 2, "Collections"): the
# collection's type under a constructor no program can name.
NonEmptyOf: fn Ty -> Ty
fn NonEmptyOf c = TyCon "Prelude.NonEmpty", [[c]]

# `Output c`, an answer to an element of any tag of row `c` (Semantics ch. 9): the row is
# held as the row of an `Elem c`, so two answers unify as their rows do.
OutputType: fn Rw -> Ty
fn OutputType rw = TyCon "Output", [[TyElemAny rw]]

# What an answer to an element carries, from the tag's output: the output's value, its time
# layers off; of a bundle (a tuple with an event part, `Gui.Window`'s `((WindowId,
# !WindowInput))`) the event part's, which is what a World answers with.
CarriedOutput: fn Ty -> Ty
fn CarriedOutput out = match WithoutTime out:
    TyTuple parts: Fold parts, (TyTuple parts), \|found, part| match part:
        TySig "!", inner: WithoutTime inner
        otherwise: found
    value: value

WithoutTime: fn Ty -> Ty
fn WithoutTime t = match t:
    TySig "$", inner: WithoutTime inner
    TySig "!", inner: WithoutTime inner
    otherwise: t

# An array or a map with no promise of an entry.
IsPlainCollection: unbounded fn St, Ty -> Bool
fn IsPlainCollection st, t = match Walk st, t:
    TyArray ignore: True
    TyMap ignore, ignore: True
    otherwise: False

# The collection a non-empty type promises, or nothing.
?NonEmptyColl: unbounded fn St, Ty -> ?Ty
fn ?NonEmptyColl st, t = match Walk st, t:
    TyCon "Prelude.NonEmpty", [[c]]: ? c
    otherwise: nil

# A type with a stack written on top: marks `"$?"` over `t` is `$?t`; an `@` among the
# marks takes `rw` as its row.
WithMarks: fn Text, Ty, Rw -> Ty
fn WithMarks marks, t, rw = Fold (Reverse2 (FoldChars marks, [[]], \|acc, c| Push acc, c)), t, \|acc, m| if m == "@": TyAt acc, rw else: TySig m, acc

Reverse2: fn [Text] -> [Text]
fn Reverse2 xs = Fold xs, [[]], \|acc, x| Append [[x]], acc

# ---------------------------------------------------------------------------------------
# Printing
# ---------------------------------------------------------------------------------------

ShowTy: unbounded fn St, Ty -> Text
fn ShowTy st, t = ShowTyIn st, (Zonk st, t), False

# `nested` puts a function or a qualified application in parentheses.
ShowTyIn: unbounded fn St, Ty, Bool -> Text
fn ShowTyIn st, t, nested = match t:
    TyFlex n: "t{n}"
    TyRigid n: ShownRigid n
    TyEvery: "_"
    TyQ n: ShownVar n
    TyCon n, [[]]: BareName n
    TyCon "Prelude.NonEmpty", [[c]]: "{ShowTyIn st, c, True}+"
    TyCon "Output", [[TyElemAny rw]]: if nested: "(Output {ShowRowIn st, rw, True})" else: "Output {ShowRowIn st, rw, True}"
    TyCon n, args:
        let inner = "{BareName n}{Concat (Each args, \|a| " {ShowTyIn st, a, True}")}"
        if nested: "({inner})" else: inner
    TyFn c, ps, res:
        let inner = "{ShowCol c}fn {Join (Each ps, \|p| ShowTyIn st, p, False), ", "} -> {ShowTyIn st, res, False}"
        if nested: "({inner})" else: inner
    TyTuple ts: "(({Join (Each ts, \|a| ShowTyIn st, a, False), ", "}))"
    TyArray e:
        let inner = ShowTyIn st, e, False
        if (HasPrefix inner, "["): "[ {inner} ]" else: "[{inner}]"
    TyMap k, v:
        let inner = "{ShowTyIn st, k, True} ==> {ShowTyIn st, v, True}"
        if nested: "({inner})" else: inner
    TySig s, i: "{s}{ShowTyIn st, i, True}"
    TyAt i, rw: "@{ShowTyIn st, i, True}"
    TyElem rw, o:
        let inner = "Element {ShowRowIn st, rw, True} {ShowTyIn st, o, True}"
        if nested: "({inner})" else: inner
    TyElemAny rw: if nested: "(Elem {ShowRowIn st, rw, True})" else: "Elem {ShowRowIn st, rw, True}"
    TyAssoc ignore, n, a, indices:
        let inner = "{n} {Join (Each (Append [[a]], indices), \|i| ShowTyIn st, i, True), " "}"
        if nested: "({inner})" else: inner
    TyRole r: BareName r
    TyAny ts: "any {Join (Each ts, \|x| "^{BareName x}"), " "}"
    TyForall vs, b:
        let inner = "forall {Join vs, " "}. {ShowTyIn st, b, False}"
        if nested: "({inner})" else: inner
    TyExists vs, b, bs:
        let inner = "any {Join (Each vs, \|v| ShownVar v), " "}: {ShowTyIn st, b, False}{if (Len bs) == 0: "" else: " where {Join (Each bs, \|((v, tr))| "{ShownVar v}: ^{BareName tr}"), ", "}"}"
        if nested: "({inner})" else: inner
    TyErr: "?"

# A canonical existential variable as a message shows it, `x0`.
ShownVar: fn Text -> Text
fn ShownVar v = if HasPrefix v, "\u{0}": Or (SplitOn v, "\u{0}")[2], v else: v

# A rigid variable as written: one an arm learned (`ρ#40.1`) shows as `ρ`.
ShownRigid: fn Text -> Text
fn ShownRigid v = Or (SplitOn v, "#")[0], v

ShowCol: fn Col -> Text
fn ShowCol CBound = ""
fn ShowCol CUnbound = "unbounded "
fn ShowCol (CRigid n) = "{n} "
fn ShowCol (CQ n) = "{n} "
fn ShowCol (CFlex ignore) = ""

ShowRow: unbounded fn St, Rw -> Text
fn ShowRow st, rw = ShowRowIn st, rw, False

ShowRowIn: unbounded fn St, Rw, Bool -> Text
fn ShowRowIn st, rw, nested:
    let fams = Each rw.fams, \|f| match rw.idx[f]:
        ? xs: "{f}.*{Concat (Each xs, \|x| " {ShowTyIn st, (Zonk st, x), True}")}"
        nil: "{f}.*"
    let tail = match rw.tail:
        TlClosed: [[]]
        TlFlex n: [["r{n}"]]
        TlRigid n: [[n]]
        TlQ n: [[n]]
        TlAssoc ignore, n, h: [["{n} {ShowTyIn st, (Zonk st, h), True}"]]
        TlRow whole: [[(ShowRowIn st, whole, False)]]
        TlUnion ps: Each ps, \|p| TailShown st, p
    let parts = Append tail, fams
    let minus = if (Len rw.minus) == 0: "" else: " − \{{Join rw.minus, ", "}\}"
    let inner = if (Len parts) == 0: "unit" else: Join parts, " | "
    if nested and ((Len parts) > 1 or minus != ""): "({inner}{minus})" else: "{inner}{minus}"

# One tail as a row shows it.
TailShown: unbounded fn St, Tail -> Text
fn TailShown st, tl = match tl:
    TlClosed: ""
    TlFlex n: "r{n}"
    TlRigid n: n
    TlQ n: n
    TlAssoc ignore, n, h: "{n} {ShowTyIn st, (Zonk st, h), True}"
    TlRow whole: ShowRowIn st, whole, False
    TlUnion ps: Join (Each ps, \|p| TailShown st, p), " | "

# Several tails as one: nested unions flattened, closed ones dropped, each once; none is
# closed and one is itself (ruling RT).
UnionTail: fn [Tail] -> Tail
fn UnionTail ps:
    let flat = Fold ps, [[]], \|acc, p| match p:
        TlUnion qs: Fold qs, acc, \|a2, q| if q == TlClosed or HasTail a2, q: a2 else: Push a2, q
        TlClosed: acc
        other: if HasTail acc, other: acc else: Push acc, other
    match Len flat:
        0: TlClosed
        1: Or flat[0], TlClosed
        otherwise: TlUnion flat

HasTail: fn [Tail], Tail -> Bool
fn HasTail ts, t = Fold ts, False, \|seen, x| seen or x == t
