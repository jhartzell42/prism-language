# `Check.Types.Colors`, a child module of `Check.Types`.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit r
use Check.Types.*
use Check.Types.Recording.*
use Check.Types.Unify.*
use Check.Types.Schemes.*
use Syntax.*
use Syntax.Lexer.*
use Check.Errors.*
use Check.Typed.*
use Check.Typed.Print.*

# ---------------------------------------------------------------------------------------
# Colors
# ---------------------------------------------------------------------------------------

# The join: bounded below a color variable below unbounded (ch. 5, The color).
JoinCol: fn Col, Col -> Col
fn JoinCol CBound, c = c
fn JoinCol c, CBound = c
fn JoinCol CUnbound, ignore = CUnbound
fn JoinCol ignore, CUnbound = CUnbound
fn JoinCol a, b = if a == b: a else: CUnbound

# Whether `a` is at most `b`.
ColLeq: fn Col, Col -> Bool
fn ColLeq a, b = (JoinCol a, b) == b

ColWord: fn Col -> Text
fn ColWord CBound = "bounded"
fn ColWord CUnbound = "unbounded"
fn ColWord (CRigid n) = "`{n}`-colored"
fn ColWord (CQ n) = "`{n}`-colored"
fn ColWord (CFlex ignore) = "bounded"

# Record that the body being checked applied something of color `c` at `span`, for the
# message: a known color joins the body's, a flexible one waits in `colorFlex` until the
# body ends (InferLambda, CheckClauses).
UseColor: unbounded fn St, Col, Text, Range -> St
fn UseColor st, c0, why, span = match WalkCol st, c0:
    CFlex n: update st:
        &_.colorFlex <= Push &_.colorFlex, ((CFlex n, why, span))
    c: JoinKnown st, c, why

JoinKnown: fn St, Col, Text -> St
fn JoinKnown st, c0, why:
    let c = UpCol st, c0
    update st:
        if not (ColLeq c, &_.color):
            &_.colorWhy <= why
        &_.color <= JoinCol &_.color, c

# In a body, a function parameter's own rigid color stands for the signature's color above
# it (round 3 CD): calling the parameter costs the body that one.
UpCol: fn St, Col -> Col
fn UpCol st, (CRigid n) = match st.colUp[n]:
    ? up: CRigid up
    nil: CRigid n
fn UpCol st, c = c

# A color followed through the variables bound so far.
WalkCol: unbounded fn St, Col -> Col
fn WalkCol st, (CFlex n) = match st.cols[n]:
    ? c: WalkCol st, c
    nil: CFlex n
fn WalkCol st, c = c

IsRigidCol: fn Col -> Bool
fn IsRigidCol (CRigid ignore) = True
fn IsRigidCol ignore = False

# A flexible color variable above the current level: a local `let`'s own.
IsOwnCol: fn St, Col -> Bool
fn IsOwnCol s, (CFlex n) = (InfoOf s, n).level > s.level
fn IsOwnCol s, ignore = False

IsFlexCol: fn Col -> Bool
fn IsFlexCol (CFlex ignore) = True
fn IsFlexCol ignore = False

# A color as the end of a definition sees it: a variable nothing bound is bounded.
SettledCol: unbounded fn St, Col -> Col
fn SettledCol st, c = match WalkCol st, c:
    CFlex ignore: CBound
    other: other

# Two colors of one function type unify (bounded and unbounded do not); a quantified one
# left in a type nothing instantiated agrees with anything.
UnifyCol: unbounded fn St, Col, Col -> ((Text, St))
fn UnifyCol st, a0, b0:
    let a = WalkCol st, a0
    let b = WalkCol st, b0
    if a == b: (("", st))
    else: match ((a, b)):
        ((CFlex x, other)): (("", (BindCol st, x, other)))
        ((other, CFlex y)): (("", (BindCol st, y, other)))
        ((CQ ignore, ignore)): (("", st))
        ((ignore, CQ ignore)): (("", st))
        otherwise: (("mismatch", st))

BindCol: fn St, Nat, Col -> St
fn BindCol st, n, c:
    let st2 = match c:
        CFlex m: LowerOne st, m, (InfoOf st, n).level
        otherwise: st
    update st2:
        &_.cols <= Insert &_.cols, n, c

# The flexible color variables of a type.
FreeColVars: unbounded fn St, Ty -> [Nat]
fn FreeColVars st, t = FreeColsInto st, [[]], t

FreeColsInto: unbounded fn St, [Nat], Ty -> [Nat]
fn FreeColsInto st, acc, t = match Walk st, t:
    TyCon ignore, args: Fold args, acc, \|a, x| FreeColsInto st, a, x
    TyFn c, ps, res:
        let acc2 = match WalkCol st, c:
            CFlex n: AddNat acc, n
            otherwise: acc
        FreeColsInto st, (Fold ps, acc2, \|a, x| FreeColsInto st, a, x), res
    TyTuple ts: Fold ts, acc, \|a, x| FreeColsInto st, a, x
    TyArray e: FreeColsInto st, acc, e
    TyMap k, v: FreeColsInto st, (FreeColsInto st, acc, k), v
    TySig ignore, i: FreeColsInto st, acc, i
    TyAt i, ignore: FreeColsInto st, acc, i
    TyElem ignore, o: FreeColsInto st, acc, o
    TyAssoc ignore, a: FreeColsInto st, acc, a
    otherwise: acc

# A join owed: `lo` at most `hi`. One that already holds (`lo` bounded, `hi` unbounded,
# the two the same) is not kept.
AddLeq: unbounded fn St, Col, Col, Range, Text, Text, Text -> St
fn AddLeq st, lo0, hi0, span, kind, name, why:
    let lo = WalkCol st, lo0
    let hi = WalkCol st, hi0
    if lo == CBound or hi == CUnbound or lo == hi: st
    else: update st:
        &_.cleqs <= Push &_.cleqs, CLeq(lo=lo, hi=hi, file=&_.file, span=span, kind=kind, name=name, why=why)

# The joins' least solution, as far as it is forced: a variable above an unbounded color is
# unbounded; with `rigid`, a variable above a rigid one is that one (only at a definition's
# end, when nothing more can join it).
Propagate: unbounded fn St, Bool -> St
fn Propagate st, rigid:
    let ((st2, changed)) = Fold st.cleqs, ((st, False)), \|((s, ch)), c|
        let lo = WalkCol s, c.lo
        match WalkCol s, c.hi:
            CFlex h:
                let forced = lo == CUnbound or (rigid and (IsRigidCol lo))
                if forced: (((BindCol s, h, lo), True)) else: ((s, ch))
            otherwise: ((s, ch))
    if changed: Propagate st2, rigid else: st2

# Before a local `let` generalizes (D8): the forced joins in; a variable of the `let`
# joined with one outside it stays outside (not quantified); two of the `let`'s own joined
# become one variable (one color variable, as a signature has); one of its own under a
# bounded or rigid color is that color.
GeneralizeCols: unbounded fn St -> St
fn GeneralizeCols st0:
    let st1 = LowerJoined (Propagate st0, False)
    let st2 = Fold st1.cleqs, st1, \|s, c|
        let lo = WalkCol s, c.lo
        let hi = WalkCol s, c.hi
        match ((lo, hi)):
            ((CFlex x, CFlex y)): if x != y and (IsOwnCol s, lo) and (IsOwnCol s, hi): BindCol s, x, hi else: s
            otherwise: s
    Fold st2.cleqs, st2, \|s, c|
        let lo = WalkCol s, c.lo
        let hi = WalkCol s, c.hi
        match ((lo, hi)):
            ((CFlex ignore, CFlex ignore)): s
            ((CFlex ignore, CUnbound)): s
            ((CFlex x, other)): if IsOwnCol s, lo: BindCol s, x, other else: s
            ((CRigid r, CFlex y)): if IsOwnCol s, hi: BindCol s, y, lo else: s
            otherwise: s

# A join between a variable above the current level and one below it lowers the first.
LowerJoined: unbounded fn St -> St
fn LowerJoined st:
    let ((st2, changed)) = Fold st.cleqs, ((st, False)), \|((s, ch)), c|
        match (((WalkCol s, c.lo), (WalkCol s, c.hi))):
            ((CFlex x, CFlex y)):
                let lx = (InfoOf s, x).level
                let ly = (InfoOf s, y).level
                if lx > s.level and ly <= s.level and lx > ly: (((LowerOne s, x, ly), True))
                else: if ly > s.level and lx <= s.level and ly > lx: (((LowerOne s, y, lx), True))
                else: ((s, ch))
            otherwise: ((s, ch))
    if changed: LowerJoined st2 else: st2

# The end of a definition: the joins solved, each one checked, the variables nothing bound
# bounded; a broken one is `calls-unbounded` (`lifted-unbounded` for a lift).
CheckColors: unbounded fn St -> St
fn CheckColors st0:
    let st = Propagate (Propagate st0, False), True
    let st2 = Fold st.cleqs, st, \|s, c|
        let lo = SettledCol s, c.lo
        let hi = SettledCol s, c.hi
        if (ColLeq lo, hi) or (ColLeq (UpCol s, lo), (UpCol s, hi)): s
        else: AddDiag s, (LeqDiag c, lo, hi)
    update st2:
        &_.cleqs <= [[]]
        &_.colorFlex <= [[]]
        &_.colUp <= {}

LeqDiag: fn CLeq, Col, Col -> CDiag
fn LeqDiag c, lo, hi:
    if c.kind == "lifted": DiagFix "lifted-unbounded", c.file, c.span, "{ColWord lo} `{c.name}` lifted over `{c.why}`; use `@Run`", "run it through `!done <- @Run {c.name}, ...`"
    else: if c.kind == "arg": DiagFix "calls-unbounded", c.file, c.span, "{ColWord hi} `{c.name}` takes a {ColWord hi} closure; this one is {ColWord lo}", "mark the parameter `unbounded fn`, or run the work through `@Run`"
    else: if c.kind == "lambda": DiagFix "calls-unbounded", c.file, c.span, "this {ColWord hi} lambda calls {ColWord lo} `{c.why}`", "mark the function type it meets `unbounded fn`, or run the call through `@Run`"
    else: DiagFix "calls-unbounded", c.file, c.span, "{ColWord hi} `{c.name}` calls {ColWord lo} `{c.why}`", "mark `{c.name}` `unbounded fn`, or run the call through `@Run`"

# A body's waiting colors at its end, under its color `col`: those known by now join the
# body's color, the rest are joins owed to `col`.
SettleBody: unbounded fn St, Col, Text -> St
fn SettleBody st0, col, name:
    let st = Propagate st0, False
    let waiting = st.colorFlex
    let cleared = update st:
        &_.colorFlex <= [[]]
    Fold waiting, cleared, \|s, ((c, why, span))| match WalkCol s, c:
        CFlex n: AddLeq s, (CFlex n), col, span, (if name == "": "lambda" else: "body"), name, why
        known: JoinKnown s, known, why
