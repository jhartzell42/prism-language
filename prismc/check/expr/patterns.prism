# ---------------------------------------------------------------------------------------
# Patterns
# ---------------------------------------------------------------------------------------

# Bind a pattern against a type: names show their marks (each a type at once, ch. 5); a
# refutable pattern stands only where the block has somewhere to go (`refutable`).
BindPattern: unbounded fn Env, St, Pattern, Ty, Bool -> ((Env, St))
fn BindPattern env, st, p, t, refutable = match p.kind:
    PName n:
        let bare = Or n.path[0], ""
        let isCtor = (IsUpperText bare) and (Len n.sigils) == 0 and (IsCtorName env, n)
        if isCtor or (Len n.path) > 1: BindCtor env, st, p, n, [[]], t
        else: BindName env, st, n, t
    PIgnore: ((env, st))
    PLit l:
        let ((lt, st2)) = InferLit env, st, l, False, p.span
        ((env, (Unify st2, t, lt, p.span)))
    PNeg l:
        let ((lt, st2)) = InferLit env, st, l, True, p.span
        ((env, (Unify st2, t, lt, p.span)))
    PUnit: ((env, (Unify st, t, tUnit, p.span)))
    PNil:
        let ((v, st2)) = FreshVar st, False, ""
        ((env, (Unify st2, t, (TySig "?", v), p.span)))
    PCtor n, args: BindCtor env, st, p, n, args, t
    PRecord n, fields, rest: BindRecord env, st, p, n, fields, rest, t
    PSigil s, inner:
        if s == "?" or s == "~":
            let ((v, st2)) = FreshVar st, False, ""
            let st3 = Unify st2, t, (TySig s, v), p.span
            BindPattern env, st3, inner, v, refutable
        else:
            let ((v, st2)) = FreshVar st, False, ""
            let st3 = Unify st2, t, (WithMarks s, v, env.scope), p.span
            BindPattern env, st3, inner, v, refutable
    PTuple ps:
        let ((vs, st2)) = Fold ps, (([[]], st)), \|((acc, s)), ignore|
            let ((v, s2)) = FreshVar s, False, ""
            (((Push acc, v), s2))
        let st3 = Unify st2, t, (TyTuple vs), p.span
        Fold (Range0 (Len ps)), ((env, st3)), \|((en, s)), i| BindPattern en, s, (Or ps[i], Pattern(kind=PIgnore, span=p.span)), (Or vs[i], TyErr), refutable
    PArray ps:
        let ((v, st2)) = FreshVar st, False, ""
        # a non-empty array is matched as the array it is, and has no length zero (Type
        # System ch. 2, "Exhaustiveness, with rows")
        let st3 = match ?NonEmptyColl st2, t:
            ? c:
                let s = Unify st2, c, (TyArray v), p.span
                if (Len ps) == 0: ErrFix s, "unreachable", p.span, "a non-empty array has no length zero", "remove the arm" else: s
            nil: Unify st2, t, (TyArray v), p.span
        Fold ps, ((env, st3)), \|((en, s)), q| BindPattern en, s, q, v, refutable
    PGroup q: BindPattern env, st, q, t, refutable
    # `any p` opens an existential (Type System ch. 3; Jimmy's ruling FA): each hidden type
    # a fresh rigid type in the arm, equal only to itself
    PAny q: match Walk st, t:
        TyExists vs, b, ignore:
            let opened = Each vs, \|v| TyRigid "{ShownVar v}#any{st.next}"
            let st2 = update st:
                &_.next += 1
            BindPattern env, st2, q, (SubstQ (ParamInst vs, opened), b), refutable
        TyErr: BindPattern env, st, q, TyErr, refutable
        other: ((env, (Err st, "mismatch", p.span, "`any` opens an existential; this is `{ShowTy st, other}`")))
    PFamily q: BindFamily env, st, (Dotted q.path), t, p.span
    PTypeArgs n, tys: BindFixed env, st, n, tys, t, p.span

# `Fixed<<Raiser>>` (Jimmy's ruling VO): the one value of `Fixed Raiser`. Matched where
# the type is `Fixed r` for the definition's own `r`, it tells the clause or arm `r` is
# `Raiser` (`env.refine`, applied to what the clause binds and gives).
BindFixed: unbounded fn Env, St, SName, [Type], Ty, Range -> ((Env, St))
fn BindFixed env, st, n, tys, t, span:
    if (Dotted n.path) != "Fixed" or (Len tys) != 1: ((env, (Err st, "mismatch", span, "a pattern with `<<..>>` is `Fixed<<Case>>`")))
    else:
        let ((x, st2)) = ConvIndex (EnvCx env), st, (Or tys[0], dummyType)
        match x:
            TyRole k: match Walk st2, t:
                TyCon "Prelude.Fixed", [[at]]: match Walk st2, at:
                    TyRigid v:
                        let narrowed = update env:
                            &_.refine <= Insert &_.refine, v, x
                        ((narrowed, st2))
                    other: ((env, (Unify st2, other, x, span)))
                TyFlex ignore: ((env, (Unify st2, t, (TyCon "Prelude.Fixed", [[x]]), span)))
                TyErr: ((env, st2))
                other: ((env, (Err st2, "mismatch", span, "`Fixed<<{BareName k}>>` matches a `Fixed r`; this is `{ShowTy st2, other}`")))
            TyErr: ((env, st2))
            # `Fixed<<r>>`, `r` a variable of the definition (Claude's call under ruling OP,
            # 13 November): the arm runs where the matched `Fixed s` is the same variant as
            # `r`'s, and in it `s` is `r`
            TyQ w: FixedAgainstVariable env, st2, w, t, span
            TyRigid w: FixedAgainstVariable env, st2, w, t, span
            other: ((env, (Err st2, "kind", span, "`Fixed` takes a variant of a payload-free choice; `{ShowTy st2, other}` is a type")))

FixedAgainstVariable: unbounded fn Env, St, Text, Ty, Range -> ((Env, St))
fn FixedAgainstVariable env, st, w, t, span = match Walk st, t:
    TyCon "Prelude.Fixed", [[at]]: match Walk st, at:
        TyRigid v:
            if v == w: ((env, st))
            else:
                let narrowed = update env:
                    &_.refine <= Insert &_.refine, v, (TyRigid w)
                ((narrowed, st))
        other: ((env, (Unify st, other, (TyRigid w), span)))
    TyFlex ignore: ((env, (Unify st, t, (TyCon "Prelude.Fixed", [[(TyRigid w)]]), span)))
    TyErr: ((env, st))
    other: ((env, (Err st, "mismatch", span, "`Fixed<<{w}>>` matches a `Fixed s`; this is `{ShowTy st, other}`")))

# The equalities a clause's or arm's `Fixed<<..>>` patterns taught (`BindFixed`), on the
# types its names were bound at and on the type it gives.
Refined: unbounded fn Env, Ty -> Ty
fn Refined env, t = Fold (Keys env.refine), t, \|acc, v| SubstRigid v, (Or env.refine[v], TyErr), acc

RefinedEnv: unbounded fn Env -> Env
fn RefinedEnv env = if (Len (Keys env.refine)) == 0: env else: update env:
    &_.locals <= Map (Each (Keys &_.locals), \|k| ((k, (RefinedScheme env, (Or &_.locals[k], (Mono TyErr))))))

RefinedScheme: unbounded fn Env, Scheme -> Scheme
fn RefinedScheme env, sc = update sc:
    &_.ty <= Refined env, &_.ty

# `collision`: the patterns of one parameter list, or one pattern, bind a name once. A
# constructor a pattern names binds nothing.
BoundTwice: unbounded fn Env, St, [Pattern] -> St
fn BoundTwice env, st, patterns:
    let binders = Fold patterns, [[]], \|acc, p| Append acc, (BindersOf env, p)
    let ((ignore, checked)) = Fold binders, (([[]], st)), \|((seen, s)), ((name, at))|
        if HasText seen, name: ((seen, (Err s, "collision", at, "`{name}` is bound twice here"))) else: (((Push seen, name), s))
    checked

# The binders of a pattern with where each stands (`PatternBinders`), less the names that
# are constructors where the pattern stands.
BindersOf: unbounded fn Env, Pattern -> [((Text, Range))]
fn BindersOf env, p = match p.kind:
    PName n: if (Len n.path) > 1 or ((Len n.sigils) == 0 and (IsUpperText (Or n.path[0], "")) and (IsCtorName env, n)): [[]] else: [[((SNameKey n, n.span))]]
    PCtor ignore, ps: Fold ps, [[]], \|acc, q| Append acc, (BindersOf env, q)
    PRecord ignore, fs, ignore: Fold fs, [[]], \|acc, f| Append acc, (BindersOf env, f.pattern)
    PSigil ignore, q: BindersOf env, q
    PTuple ps: Fold ps, [[]], \|acc, q| Append acc, (BindersOf env, q)
    PArray ps: Fold ps, [[]], \|acc, q| Append acc, (BindersOf env, q)
    PGroup q: BindersOf env, q
    PAny q: BindersOf env, q
    otherwise: [[]]

# `collision`: a written name is bound once per block (Semantics ch. 4, "Binding groups and
# cycles"), by its `let`s and binds; `_` and `$_` are rebound freely.
BlockBoundOnce: unbounded fn Env, St, [Stmt] -> St
fn BlockBoundOnce env, st, stmts:
    let binders = Fold stmts, [[]], \|acc, s| match s.kind:
        SBind p, ignore, ignore: Append acc, (BindersOf env, p)
        SLet p, ignore, ignore: Append acc, (BindersOf env, p)
        otherwise: acc
    let ((ignore, checked)) = Fold binders, (([[]], st)), \|((seen, s)), ((name, at))|
        if name == "_" or name == "$_": ((seen, s))
        else: if HasText seen, name: ((seen, (ErrFix s, "collision", at, "`{name}` is bound twice in this block", "a written name is bound once per block: give the second another name"))) else: (((Push seen, name), s))
    checked

# A `let`'s bare capitalised name that resolves to a constructor: as in every other
# pattern (`BindPattern`), it is the constructor, and the `let` binds no name by it.
LetNamesConstructor: fn Env, Pattern -> Bool
fn LetNamesConstructor env, p = match p.kind:
    PName n: (Len n.path) == 1 and (Len n.sigils) == 0 and (IsUpperText (Or n.path[0], "")) and IsCtorName env, n
    otherwise: False

IsCtorName: fn Env, SName -> Bool
fn IsCtorName env, n:
    let ((?qk, ignore)) = ResolveValue env.g, env.home, n
    match ?qk:
        ? qk: HasKey env.g.ctors, qk
        nil: False

# A binder: its marks make its type at once, over a plain-headed variable named for it;
# a type whose stack disagrees with the marks is `mark-stack`.
BindName: unbounded fn Env, St, SName, Ty -> ((Env, St))
fn BindName env, st, n, t:
    let name = SNameKey n
    if HasText env.pending, name:
        match env.locals[name]:
            ? sc:
                let ((ok, st1)) = TryUnify st, sc.ty, t, n.span
                let marksAgree = (StackOf st, t) == (TypeMarks n.sigils) or (IsFlexVar st, t)
                let stA = if ok: st1 else: if marksAgree: Unify st, sc.ty, t, n.span else: ErrFix st, "mark-stack", n.span, "`{name}` has type `{ShowTy st, t}`, whose stack is `{StackOf st, t}`; the name shows `{TypeMarks n.sigils}`", "rename to `{RefMark n.sigils}{StackOf st, t}{DropPrefix name, n.sigils}`"
                BindLocalId env, (NoteBinder (AskCase stA, n, (TypeMarks n.sigils), t), n.span, name, t), name, n.span
            nil: BindFresh env, st, n, t
    else: BindFresh env, st, n, t

BindFresh: unbounded fn Env, St, SName, Ty -> ((Env, St))
fn BindFresh env, st, n, t = BindFreshMarked env, st, n, (TypeMarks n.sigils), t

# A binder whose type's stack must be `marks`: the name's own marks, or a level binder's
# with the field's `$` taken off (`BindLevel`).
BindFreshMarked: unbounded fn Env, St, SName, Text, Ty -> ((Env, St))
fn BindFreshMarked env, st, n, marks, t:
    let name = SNameKey n
    let ((v, st2)) = FreshVar st, True, name
    let ((rw, st3)) = FreshRow st2, [[]]
    let marked = WithMarks marks, v, rw
    let ((ok, st4)) = TryUnify st3, t, marked, n.span
    let st5 = if ok: st4
        else:
            let stack = StackOf st3, t
            ErrFix st3, "mark-stack", n.span, "`{name}` has type `{ShowTy st3, t}`, whose stack is `{stack}`; the name shows `{marks}`", "rename to `{RefMark n.sigils}{stack}{DropPrefix name, n.sigils}`"
    BindLocalId (WithLocal env, name, (Mono t)), (NoteBinder (AskCase st5, n, marks, t), n.span, name, t), name, n.span

# A name a pattern binds, asked at its definition's end whether its case says what it
# holds (`CaseQuestions`): `marks` are the marks its type shows.
AskCase: fn St, SName, Text, Ty -> St
fn AskCase st, n, marks, t = update st:
    &_.caseQs <= Push &_.caseQs, CaseQ(name=(SNameKey n), sigils=n.sigils, bare=(Or n.path[0], ""), marks=marks, ty=t, span=n.span, file=&_.file)

# `case-mark`: the end of a definition asks every name a pattern bound whether its case
# says what it holds (Language ch. 10 and ch. 1's case mark; Type System ch. 1): an
# uppercase name holds a function, a lowercase one, or one that begins with `_`, a value.
# The type under the marks the name shows decides. A type still a variable, an error's or
# an associated type's says nothing yet; the topic `_` and a `&` name are not asked. A
# block checked twice (its borrows) asks a binder twice, and it is answered once.
CaseQuestions: unbounded fn St -> St
fn CaseQuestions st:
    let qs = st.caseQs
    let cleared = update st:
        &_.caseQs <= [[]]
    let ((ignore, answered)) = Fold qs, (([[]], cleared)), \|((seen, s)), q|
        let place = "{q.file}.{q.span.start}"
        if (HasText seen, place) or q.bare == "_" or q.bare == "" or (HasPrefix q.sigils, "&"): ((seen, s))
        else: (((Push seen, place), (AnswerCase s, q)))
    answered

AnswerCase: unbounded fn St, CaseQ -> St
fn AnswerCase st, q:
    let held = UnderMarks st, q.ty, q.marks
    let upper = IsUpperText q.bare
    match ?HoldsFunction held:
        ? True if not upper: AddDiag st, (DiagFix "case-mark", q.file, q.span, "`{q.name}` holds a function: a lowercase name is a value now", "rename to `{q.sigils}{Upper (Head q.bare)}{AfterFirst q.bare}`")
        ? False if upper: AddDiag st, (DiagFix "case-mark", q.file, q.span, "`{q.name}` holds a `{ShowTy st, held}`, not a function: an uppercase name is a function, a constructor, a type or a trait", "rename to `{q.sigils}{Lower (Head q.bare)}{AfterFirst q.bare}`")
        otherwise: st

# A type under the marks a name shows, each mark taken off while the type has it on top.
UnderMarks: unbounded fn St, Ty, Text -> Ty
fn UnderMarks st, t, marks = if marks == "": Walk st, t else: match Walk st, t:
    TySig s, inner if s == (Head marks): UnderMarks st, inner, (AfterFirst marks)
    TyAt inner, ignore if (Head marks) == "@": UnderMarks st, inner, (AfterFirst marks)
    other: other

# Whether a walked type is a function's; nil when it does not say yet.
?HoldsFunction: fn Ty -> ?Bool
fn ?HoldsFunction t = match t:
    TyFn ignore, ignore, ignore: ? True
    TyFlex ignore: nil
    TyErr: nil
    TyAssoc ignore, ignore, ignore, ignore: nil
    otherwise: ? False

# A field of an element seen through a document (`Elem r`, a snapshot) binds its level
# (doubt WL): a `$` field's value in that tick, plain. The binder may show the field's
# declared `$`, as the tag declares it (`Ui.Label(text=$t)`, Pitch ch. 5's `held=$n`),
# and the level drops it: `$t` is a `Text` there. A blueprint's element (`Element r o`:
# an element expression, a supplier's `e`) binds each field with its stack.
BindField: unbounded fn Env, St, Pattern, Ty, Bool -> ((Env, St))
fn BindField env, st, p, ft, snapshot = match Walk st, ft:
    TySig s, level if snapshot and s == "$": BindLevel env, st, p, level
    otherwise: BindPattern env, st, p, ft, True

# `live-field-pattern`: a blueprint's element has its `$` and `!` fields as nodes, which a
# pattern binds; a pattern that can fail there would test a value the field has only in a
# tick (Semantics ch. 8; Jimmy's ruling LP: a pattern cannot test a dynamic's value). A
# document's element has levels, which a pattern may test.
LiveFieldTested: unbounded fn Env, St, Text, Pattern, Ty -> St
fn LiveFieldTested env, st, fname, p, ft:
    let stack = StackOf st, ft
    let binder = "{stack}{Head fname}"
    ErrFix st, "live-field-pattern", p.span, "an element's `{stack}{fname}` binds its {if (HasPrefix stack, "$"): "dynamic" else: "event"}; `{SrcText env, p.span}` would test a value the field has only in a tick", "bind it, `{stack}{fname}={binder}`, and read `{binder}` where a tick reads it"

# Whether a field's pattern tests a live field: a `$` or `!` field of a blueprint's
# element, under a pattern that can fail.
TestsLiveField: unbounded fn Env, St, Pattern, Ty, Bool -> Bool
fn TestsLiveField env, st, p, ft, snapshot = match Walk st, ft:
    TySig s, ignore: (s == "$" or s == "!") and not snapshot and TestsValue env, p
    otherwise: False

# Whether a pattern can fail on the value it meets: a literal, `nil`, a constructor's or a
# tag's pattern (a constructor's bare name too, with or without the field's marks before
# it: `$True` names `True`, and binds nothing), an array's, `? p` and `~ p`, a family, and a
# tuple or a group with such a part.
TestsValue: unbounded fn Env, Pattern -> Bool
fn TestsValue env, p = match p.kind:
    PName n: NamesConstructor env, n
    PLit ignore: True
    PNeg ignore: True
    PNil: True
    PCtor ignore, ignore: True
    PRecord ignore, ignore, ignore: True
    PArray ignore: True
    PFamily ignore: True
    PSigil s, q: (Contains s, "?") or (Contains s, "~") or TestsValue env, q
    PTuple parts: Fold parts, False, \|seen, q| seen or TestsValue env, q
    PGroup q: TestsValue env, q
    PAny q: TestsValue env, q
    PTypeArgs ignore, ignore2: True
    otherwise: False

# Whether a name in a pattern is a constructor's, its marks set aside: a qualified name,
# or a capitalised one that resolves to a constructor.
NamesConstructor: fn Env, SName -> Bool
fn NamesConstructor env, n = (Len n.path) > 1 or ((IsUpperText (Or n.path[0], "")) and IsCtorName env, (Unmarked n))

# A name with its marks set aside: `True` of `$True`.
Unmarked: fn SName -> SName
fn Unmarked n = SName(sigils="", path=n.path, span=n.span)

BindLevel: unbounded fn Env, St, Pattern, Ty -> ((Env, St))
fn BindLevel env, st, p, level = match p.kind:
    PName n:
        # a constructor written with the field's mark, `$lit=$True`, tests the level as
        # the bare `True` does, and binds nothing
        if (HasPrefix n.sigils, "$") and (Len n.path) == 1 and NamesConstructor env, n: BindPattern env, st, Pattern(kind=(PName (Unmarked n)), span=p.span), level, True
        else: if (HasPrefix n.sigils, "$") and (Len n.path) == 1: BindFreshMarked env, st, n, (AfterFirst n.sigils), level
        else: BindPattern env, st, p, level, True
    PGroup q: BindLevel env, st, q, level
    PAny q: BindLevel env, st, q, level
    otherwise: BindPattern env, st, p, level, True

BindCtor: unbounded fn Env, St, Pattern, SName, [Pattern], Ty -> ((Env, St))
fn BindCtor env, st0, p, n, args, t:
    let ((?qk, why)) = ResolveValue env.g, env.home, n
    # two bare candidates are an error at the use (Semantics ch. 6), and a pattern is one
    let st = CollisionAt env, st0, why, (SNameKey n), n.span
    match ?qk:
        nil: ((env, (Err st, "unknown-name", n.span, "no constructor `{SNameKey n}`")))
        ? qk:
            if why == "tag": BindTagPattern env, st, p, qk, [[]], True, t
            else: match env.g.ctors[qk]:
                nil: ((env, (Err st, "unknown-name", n.span, "`{SNameKey n}` is not a constructor")))
                ? c:
                    let ((self, st1, inst)) = InstantiateWith st, (Scheme(eqs=[[]], qs=c.params, plainQs=[[]], rqs=[[]], cqs=[[]], cjoins=[[]], bounds=[[]], ty=c.ty)), p.span, [[]]
                    let st2 = if IsFailurePattern st1, t, self: st1 else: Unify st1, t, self, p.span
                    if (Len args) != (Len c.args) and not ((Len args) == 1 and (Len c.args) > 1):
                        ((env, (Err st2, "mismatch", p.span, "`{BareName c.name}` takes {CountWord (Len c.args)} argument{if (Len c.args) == 1: "" else: "s"}; this pattern gives {CountWord (Len args)}")))
                    else: Fold (Range0 (Len args)), ((env, st2)), \|((en, s)), i| BindPattern en, s, (Or args[i], Pattern(kind=PIgnore, span=p.span)), (SubstQ inst, (Or c.args[i], TyErr)), True

# A record pattern: a record's fields by name or position, `..` for the rest; a tag
# pattern refines the element's output in its arm (see `InferMatch`).
BindRecord: unbounded fn Env, St, Pattern, SName, [FieldPat], Bool, Ty -> ((Env, St))
fn BindRecord env, st0, p, n, fields, rest, t:
    let ((?qk, why)) = ResolveValue env.g, env.home, n
    let st = CollisionAt env, st0, why, (SNameKey n), n.span
    match ?qk:
        nil: ((env, (Err st, "unknown-name", n.span, "no record or tag `{SNameKey n}`")))
        ? qk:
            if why == "tag": BindTagPattern env, st, p, qk, fields, rest, t
            else: match env.g.ctors[qk]:
                nil: ((env, (Err st, "unknown-name", n.span, "`{SNameKey n}` is not a record")))
                ? c:
                    let ((self, st1, inst)) = InstantiateWith st, (Scheme(eqs=[[]], qs=c.params, plainQs=[[]], rqs=[[]], cqs=[[]], cjoins=[[]], bounds=[[]], ty=c.ty)), p.span, [[]]
                    let st2 = if IsFailurePattern st1, t, self: st1 else: Unify st1, t, self, p.span
                    Fold (Range0 (Len fields)), ((env, st2)), \|((en, s)), i|
                        let fp = Or fields[i], FieldPat(marks="", ?name=nil, pattern=Pattern(kind=PIgnore, span=p.span), span=p.span)
                        let fname = FieldPatName fp, c.fields, i
                        # `collision`: a pattern names a field once, as a construction does
                        let before = Fold (Range0 i), False, \|seen, k| seen or (FieldPatName (Or fields[k], fp), c.fields, k) == fname
                        # (its pattern still binds, so the names it writes are known below)
                        let s0 = if before: Err s, "collision", fp.span, "`{fname}` is matched twice" else: s
                        match ?IndexOf c.fields, fname:
                            ? j: BindPattern en, (PatMarks s0, (BareName c.owner), fname, (Or c.args[j], TyErr), fp), fp.pattern, (SubstQ inst, (Or c.args[j], TyErr)), True
                            nil: ((en, (Err s0, "mismatch", fp.span, "`{BareName c.owner}` has no field `{fname}`")))

# A field pattern's sigils, when it writes any, are its field's (`$label=ignore`); a plain
# name matches a sigiled field too, as a World pattern reads levels (`Ui.Button(label="OK")`).
PatMarks: unbounded fn St, Text, Text, Ty, FieldPat -> St
fn PatMarks st, owner, field, declared, fp = if fp.marks == "": st else: ArgMarks st, owner, field, declared, fp.marks, fp.span

# A field pattern's field: its name, or a bare name that is a field (punning), or its
# position.
FieldPatName: fn FieldPat, [Text], Nat -> Text
fn FieldPatName fp, fields, i = match fp.?name:
    ? id: id.name
    nil: match fp.pattern.kind:
        PName n: if HasText fields, (SNameKey n): SNameKey n else: Or fields[i], ""
        otherwise: Or fields[i], ""

# A tag arm `Net.Http(url, ..)` needs `Net` among the row's families, not its tail
# (`row-not-here`), and binds the fields: with their stacks on a blueprint's element, as
# levels on a document's (`BindField`).
BindTagPattern: unbounded fn Env, St, Pattern, Text, [FieldPat], Bool, Ty -> ((Env, St))
fn BindTagPattern env, st, p, name, fields, rest, t = match env.g.tags[name]:
    nil: ((env, (Err st, "unknown-name", p.span, "no tag `{name}`")))
    ? tg:
        let st1 = if tg.kind == "Element": TagInRow env, st, tg, t, p.span else: Unify st, t, (TyCon tg.kind, [[]]), p.span
        let snapshot = IsSnapshot st1, t
        let ((ignore, st2a, inst)) = InstantiateWith st1, (Scheme(eqs=[[]], qs=tg.qs, plainQs=[[]], rqs=tg.rqs, cqs=[[]], cjoins=[[]], bounds=[[]], ty=tg.out)), p.span, [[]]
        # the family's indices are the row's, `_` a type the arm learns (ruling AF)
        let st2 = Fold (PatternIndices st2a, tg, t, p.span), st2a, \|s, ((q, x))| Unify s, (Or inst.tys[q], TyErr), x, p.span
        let names = Each tg.fields, \|((f, ignore))| f
        Fold (Range0 (Len fields)), ((env, st2)), \|((en, s)), i|
            let fp = Or fields[i], FieldPat(marks="", ?name=nil, pattern=Pattern(kind=PIgnore, span=p.span), span=p.span)
            let fname = FieldPatName fp, names, i
            # `collision`: a tag pattern names a field once, as a record's does (its
            # pattern still binds, so the names it writes are known below)
            let before = Fold (Range0 i), False, \|seen, k| seen or (FieldPatName (Or fields[k], fp), names, k) == fname
            let s0 = if before: Err s, "collision", fp.span, "`{fname}` is matched twice" else: s
            match ?FieldOfTag tg, fname:
                ? ft:
                    let marked = PatMarks s0, name, fname, ft, fp
                    if TestsLiveField env, marked, fp.pattern, ft, snapshot:
                        # refused; its names are bound all the same, against anything, so
                        # the arm below reads them and nothing more is reported
                        let ((anything, s1)) = FreshVar (LiveFieldTested env, marked, fname, fp.pattern, ft), False, ""
                        BindPattern en, s1, fp.pattern, anything, True
                    else: BindField en, marked, fp.pattern, (SubstQ inst, ft), snapshot
                nil: ((en, (Err s0, "mismatch", fp.span, "`{name}` has no field `{fname}`")))

# An element seen through a document: `Elem r`, the document's value type (Type System
# ch. 2), as against a blueprint's `Element r o` (doubt WL).
IsSnapshot: unbounded fn St, Ty -> Bool
fn IsSnapshot st, t = match Walk st, t:
    TyElemAny ignore: True
    otherwise: False

# The indices a tag pattern learns from its scrutinee's row (Part III ch. 6, "Families
# indexed by document and role"): each index the row applies the tag's family to, and for
# `_`, every case, a fresh type of the arm's own, `ρ`.
PatternIndices: unbounded fn St, TagInfo, Ty, Range -> [((Text, Ty))]
fn PatternIndices st, tg, t, span = match Walk st, t:
    TyElem rw, ignore: IndicesIn st, tg, rw, span
    TyElemAny rw: IndicesIn st, tg, rw, span
    otherwise: [[]]

IndicesIn: unbounded fn St, TagInfo, Rw, Range -> [((Text, Ty))]
fn IndicesIn st, tg, rw, span = match (WalkRow st, rw).idx[tg.familyName]:
    ? xs: Each (Range0 (Len tg.famParams)), \|i| (((Or tg.famParams[i], ""), (LearnedIndex (Or xs[i], TyErr), span, i)))
    nil: [[]]

LearnedIndex: fn Ty, Range, Nat -> Ty
fn LearnedIndex TyEvery, span, i = TyRigid "ρ#{span.start}.{i}"
fn LearnedIndex x, ignore, ignore2 = x

# A tag's output where an arm matches it: the family's indices the row gives
# (`$?(Answer Count ρ)` for `Seat.Query` under `Seat.* Count _`).
FamilyOut: unbounded fn St, TagInfo, Ty, Pattern -> Ty
fn FamilyOut st, tg, t, p = SubstQ Inst(tys=(Fold (PatternIndices st, tg, t, (TagPatternSpan p)), {{}}, \|m, ((q, x))| Insert m, q, x), rows={{}}, cols={{}}), tg.out

# The span of the tag pattern itself, under its parentheses.
TagPatternSpan: fn Pattern -> Range
fn TagPatternSpan p = match p.kind:
    PGroup q: TagPatternSpan q
    otherwise: p.span

TagInRow: unbounded fn Env, St, TagInfo, Ty, Range -> St
fn TagInRow env, st, tg, t, span = match Walk st, t:
    TyElem rw, ignore:
        let w = WalkRow st, rw
        if HasText w.fams, tg.familyName: st
        else: ErrFix st, "row-not-here", span, "`{tg.name}` is not in this row, `{ShowRow st, w}`", "add `{tg.familyName}.*` to the row, or answer the tag elsewhere"
    TyElemAny rw:
        let w = WalkRow st, rw
        if HasText w.fams, tg.familyName: st
        else: ErrFix st, "row-not-here", span, "`{tg.name}` is not in this row, `{ShowRow st, w}`", "add `{tg.familyName}.*` to the row, or answer the tag elsewhere"
    TyFlex ignore:
        let ((rw, st2)) = FreshRow st, [[tg.familyName]]
        let ((o, st3)) = FreshVar st2, False, ""
        Unify st3, t, (TyElem (Rw(fams=[[tg.familyName]], minus=[[]], tail=rw.tail, idx={{}})), o), span
    TyErr: st
    other: Err st, "mismatch", span, "a tag pattern matches an element; this is `{ShowTy st, other}`"

BindFamily: unbounded fn Env, St, Text, Ty, Range -> ((Env, St))
fn BindFamily env, st, fam, t, span = match Walk st, t:
    TyElem rw, ignore:
        let w = WalkRow st, rw
        if HasText w.fams, fam: ((env, st))
        else: ((env, (ErrFix st, "row-not-here", span, "`{fam}.*` is not in this row, `{ShowRow st, w}`", "add `{fam}.*` to the row")))
    otherwise: ((env, st))
