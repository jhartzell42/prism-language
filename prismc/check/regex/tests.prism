# The test module of `Check.Regex`: the shared corpus, tests/regex/corpus.txt, as
# checks. Generated by gen-tests.py beside it, which says why; do not edit by hand.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit r
use Check.Regex.*

# A pattern, its flags and a replacement as the corpus writes the result: `accepted`,
# or the diagnostic `part@at message`.
Refused: unbounded fn Text, Text, ?Text -> Text
fn Refused pattern, flags, ?replacement = match ?RegexRefusal pattern, flags, ?replacement:
    nil: "accepted"
    ? d: "{d.part}@{d.at} {d.message}"

