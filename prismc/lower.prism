# Lowering: the checked program to the core form emission spells as Rust (Compiler ch. 3,
# "The translation, construct by construct"; docs/backend.md, the contract). The input is
# the tree as parsed, the checker's environment (CheckEnv's `G`: every module, type,
# constructor, tag, trait and impl, every definition with its clauses) and its typed
# tables (typed.prism's `TProgram`: the type of every expression, the lifting decision at
# every application, the impl solved at every method). The output, a `Model`, decides
# everything: one Rust type per Prism type, names, which value is borrowed and which is
# cloned, the node of every widget with its fields, methods, heights and places, the
# step machine of every unbounded function. Emission (emit.prism) and the templates
# (templates/*.prism) only spell it (K9).
#
# The core form is a small imperative language (Compiler ch. 4, "The class model"):
# expressions (`Ex`), statements (`Do`), patterns (`Pa`) and Rust types (`RsTy`), with
# items (`Item`) for types, tags, functions, jobs and nodes. Every constructor here has a
# prefix of its type, since constructors share one namespace with the modules this one
# uses (Rs, X, Do, Pa, Cc, It, Bn, Vl, Sk).
#
# Written by Claude, 1 November 2026, on the claude-self-hosting branch. Subject to change:
# Jimmy rewrites it by hand, and an implementer reading it uses their own discretion.
module Lower
emit r
use Ast.*
use Lexer.*
use CheckErrors.*
use CheckTypes.*
use CheckEnv.*
use Typed.*

# ---------------------------------------------------------------------------------------
# The core form
# ---------------------------------------------------------------------------------------

# A Rust type (docs/backend.md, "Types").
type RsTy = choice:
    RsNat
    RsInt
    RsU8
    RsFloat
    RsBool
    RsChar
    RsText
    RsUnit
    RsPath
    RsDuration
    RsError
    RsNamed Text, [RsTy]
    RsOpt RsTy
    RsRes RsTy
    RsTuple [RsTy]
    RsArray RsTy
    RsMap RsTy, RsTy
    RsFn [RsTy], RsTy
    RsJobFn RsTy, RsTy
    RsJob RsTy
    RsEvent RsTy
    RsDyn RsTy
    RsGen Text
    RsRc RsTy
    RsRef RsTy
    RsPod
    RsShowAny
    RsHold RsTy
    RsStamped RsTy
    # A structural dynamic's snapshot (pick ST).
    RsSnapshot RsTy
    RsDefer RsTy
    RsWeak Text
    RsCell RsTy
    RsWakes
    RsPort RsTy
    # A live element (`Element r o`, pick RV): its level at the build and its level over time.
    RsLive RsTy
    RsUnknown Text
derive ^Eq, ^Show

# An expression. Every one is a Rust expression; `XRaw` is a name, a path or a literal
# already spelled.
type Ex = choice:
    XRaw Text
    XCall Text, [Ex]
    XApply Ex, [Ex]
    XMethod Ex, Text, [Ex]
    XBin Text, Ex, Ex
    XUnary Text, Ex
    XCtor Text, [Ex]
    XRecord Text, [((Text, Ex))]
    XTuple [Ex]
    XVec [Ex]
    XText Text
    XFormat [Ex]
    XMatch Ex, [XArm], Bool
    XChain Text, Ex, [XArm]
    XIf Ex, Ex, Ex
    XBlock [Do], Ex
    XLabeled Text, [Do], Ex
    XClosure Bool, [Pa], Ex
    XTry Ex
    XField Ex, Text
    XDecode RsTy, Ex
    XCast Ex, RsTy
derive ^Eq, ^Show

# One arm of a `match` or of an if-let chain: the pattern, the conditions after it (a
# guard, or a `let` through a reference counted payload), the value.
type XArm = record:
    pat: Pa
    conds: [Cc]
    body: Ex
derive ^Eq, ^Show

type Cc = choice:
    CcIf Ex
    CcLet Pa, Ex
derive ^Eq, ^Show

# A Rust pattern.
type Pa = choice:
    PaWild
    PaBind Text
    PaCtor Text, [Pa]
    PaUnit Text
    PaRecord Text, [((Text, Pa))], Bool
    PaTuple [Pa]
    PaLit Text
    PaTyped Pa, RsTy
derive ^Eq, ^Show

# A statement of a method body.
type Do = choice:
    DoLet Pa, Ex
    DoLetElse Pa, Ex, Ex
    DoAssign Ex, Ex
    DoWhile Ex, [Do]
    DoWhileLet Pa, Ex, [Do]
    DoFor Pa, Ex, [Do]
    DoExpr Ex
    DoIf Ex, [Do], [Do]
    DoIfLet Pa, Ex, [Do], [Do]
    DoMatch Ex, [((Pa, [Do]))]
    DoReturn Ex
    DoNote Text
derive ^Eq, ^Show

# A Rust type declaration: a record (one case named as the type, named fields), a choice
# (cases with positional fields), a newtype or a unit type.
type TyDef = record:
    name: Text
    prism: Text
    params: [Text]
    shape: TyShape
    cases: [CaseDef]
    eq: Bool
    ord: Bool
    floaty: Bool
    show: Shown
    pod: Bool
    doc: Text
derive ^Eq, ^Show

type TyShape = choice:
    ShapeRecord
    ShapeChoice
    ShapeNewtype
    ShapeUnit
derive ^Eq, ^Show

# Where a type's `Show` comes from: the program's own `impl ^Show` (it then crosses as
# `Pod::Shown`), a `derive ^Show`, or nowhere.
type Shown = choice:
    ShownOwn
    ShownDerived
    NotShown
derive ^Eq, ^Show

type CaseDef = record:
    name: Text
    prism: Text
    fields: [((Text, RsTy))]
derive ^Eq, ^Show

# An element tag: the `Level` struct (its plain and dynamic fields, as values after the
# tick) and the tag's qualified name.
type TagDef = record:
    name: Text
    tagName: Text
    fields: [((Text, Text, RsTy))]
    doc: Text
    # Every field is plain data (`Podable`): the struct is `Clone` and `PartialEq` and
    # reads back from a `Pod`, so a value holding it (a `[Draw]` in a record) can be data.
    pod: Bool
derive ^Eq, ^Show

# A row kind's values as plain data (pick RV): one Rust enum whose variants are the tags
# of the kind across the program, each holding its tag's struct. A `type Draw = row` is
# `Draw` in its module; `Elem r`, a document's element, is `crate::Elem` over every
# `Element` tag.
type RowDef = record:
    name: Text
    prism: Text
    cases: [((Text, Text))]
    pod: Bool
    doc: Text
derive ^Eq, ^Show

# A plain function, a top-level `let` (a getter with no parameters), or a check line.
type FnDef = record:
    name: Text
    generics: [((Text, [Text]))]
    params: [((Text, RsTy))]
    ret: RsTy
    body: Ex
    doc: Text
    public: Bool
derive ^Eq, ^Show

# A step machine (D6): one per unbounded function that `@Run` is given or that a job
# calls. A tail call is the callee's job (`Normalize`); any other call is a `Frame`
# around it, the caller's continuation waiting for the result (`Total`).
type JobDef = record:
    name: Text
    start: Text
    generics: [((Text, [Text]))]
    fields: [((Text, RsTy))]
    ret: RsTy
    body: Ex
    doc: Text
derive ^Eq, ^Show

# A method of a node.
type MethDef = record:
    name: Text
    recv: Recv
    params: [((Text, RsTy))]
    cx: CxArg
    ret: RsTy
    body: [Do]
    tail: Ex
    doc: Text
derive ^Eq, ^Show

# A method's receiver: `self: &Rc<Self>` (it may hand the node to the runtime), `&self`, or
# `self: Rc<Self>` (a `Node` or `Row` hook's).
type Recv = choice:
    RecvRc
    RecvRef
    RecvOwned
derive ^Eq, ^Show

# The read point a method takes: `cx: &mut Cx` or `cx: &Cx`.
type CxArg = choice:
    CxMut
    CxRef
derive ^Eq, ^Show

# A node: one widget block's storage and methods (docs/backend.md, "A widget block").
type NodeDef = record:
    name: Text
    prism: Text
    doc: Text
    params: [((Text, RsTy))]
    fields: [((Text, RsTy, Text))]
    consts: [((Text, Nat, Text))]
    lets: [Do]
    inits: [((Text, Ex))]
    build: [Do]
    fallible: Bool
    methods: [MethDef]
    answers: [((Text, Ex))]
    hooks: [((Text, [Do]))]
    builders: [ForDef]
    wakes: Bool
    children: [NodeDef]
    gens: [GenDef]
    subs: [((Text, Text, RsTy))]
    # The node's greatest height: a `for` row's, which its block's gather sits above.
    top: Nat
    rowKind: RowKind
    # A hosted row's `Row` methods (pick HO): `deliver`, `document`, `document_moved`.
    hosted: [MethDef]
derive ^Eq, ^Show

# What a node is a row of: a `for` (it has a `key`), a `rebuild`'s generation, or nothing
# (a root widget's node).
type RowKind = choice:
    ForRow
    GenerationRow
    NotARow
derive ^Eq, ^Show

# A place's position in a node (pick HO): `scope` 0 is the node's own places, `k` from 1 the
# places of the child of host `scopes[k - 1]` of the node, which count from 0 and are keyed
# by their path relative to the child in the host's document. A position is spelled by
# `PlaceAt` and matched by `PosPat`; `PlaceText` is its text in a name or a doc comment.
type Pos = record:
    scope: Nat
    at: Nat
derive ^Eq, ^Show

let pos0 = Pos(scope=0, at=0)

# The next position in the same scope.
NextPos: fn Pos -> Pos
fn NextPos p = update p:
    &_.at <= &_.at + 1

# The first position of host `k`'s child (`k` from 1).
ScopePos: fn Nat -> Pos
fn ScopePos k = Pos(scope=k, at=0)

# A position as text, in a name (`place_1`, `place_h1_2`) or a doc comment: the node's own
# by its number, a hosted child's by its scope and number, `h{k}_{at}`.
PlaceText: fn Pos -> Text
fn PlaceText p = if p.scope == 0: "{p.at}" else: "h{p.scope}_{p.at}"

# A `rebuild` (docs/backend.md, "Dynamic structure"): one generation at `path/n/#g`,
# torn down and built anew from the source after a tick that changed it; the clause of a
# widget of several clauses chosen by matching its arguments.
type GenDef = record:
    name: Text
    pos: Pos
    # The place's path, as Rust spells it from `self` (`PlaceAt`).
    at: Text
    source: Ex
    valueTy: RsTy
    select: Ex
derive ^Eq, ^Show

# A port a row subscribes to: the parent's event `name`, fired to every live row.
type PortDef = record:
    name: Text
    ty: RsTy

# A `for` builder (docs/backend.md, "Dynamic structure"): a map of rows, each a node of
# its own at `path/n/[k]`, rebuilt from the source after the tick.
type ForDef = record:
    name: Text
    pos: Pos
    # The place's path, as Rust spells it from `self` (`PlaceAt`).
    at: Text
    keyTy: RsTy
    valueTy: RsTy
    rowNode: Text
    keyed: Bool
    # The block's getter the builder and the rows' entries read the source from.
    source: Text
    # What a row's `build` takes as its parent: the block, weakly (`Rc::downgrade(self)`),
    # or for a host's rows the host (pick HO).
    parent: Text
    # The block's plain values the rows read, as the block passes them to a row's `build`.
    passed: [Ex]
derive ^Eq, ^Show

# The program of a root widget, as a World drives it.
type ProgDef = record:
    name: Text
    prism: Text
    node: Text
    params: [((Text, RsTy))]
    fallible: Bool
    world: Text
derive ^Eq, ^Show

# A compiled `check` block: each line's value as plain data.
type CheckDef = record:
    name: Text
    lines: [Ex]
derive ^Eq, ^Show

# A program's own trait: each method an associated function over `Self`, a default's body.
type TraitDef = record:
    name: Text
    methods: [FnDef]
    defaults: [Text]
    doc: Text
derive ^Eq, ^Show

# An `impl`: of a program's trait, its methods; of `^Show`, `^Eq` or `^Ord`, the Rust
# trait the emitted code's operators and printer read, over a function of its own.
type ImplDef = record:
    cls: Text
    tr: Text
    head: RsTy
    generics: [((Text, [Text]))]
    methods: [FnDef]
    doc: Text
derive ^Eq, ^Show

type Item = choice:
    ItTrait TraitDef
    ItImpl ImplDef
    ItType TyDef
    ItTag TagDef
    ItRow RowDef
    ItFn FnDef
    ItJob JobDef
    ItNode NodeDef
    ItNote Text
    # What lowering cannot lower, as a `compile_error!` item (`Refusal`).
    ItRefused Text
derive ^Eq, ^Show

# One Prism module as one Rust module.
type ModDef = record:
    name: Text
    prism: Text
    path: Text
    uses: [Text]
    items: [Item]
derive ^Eq, ^Show

type Model = record:
    name: Text
    mods: [ModDef]
    programs: [ProgDef]
    root: ?ProgDef
    checks: [CheckDef]
    # `crate::Elem`, emitted in `main.rs`
    elem: RowDef
    # `crate::Answer`, beside it
    answer: AnswerDef
    scripts: [Text]
    notes: [Text]
derive ^Eq, ^Show

# `crate::Answer` (pick HO): an answer to an element, typed by its tag, what a host's
# supplier answers a child place with and what a World's answer to a forwarded element
# decodes to. A variant per element tag of the program, carrying the tag's output type.
type AnswerDef = record:
    cases: [AnswerCase]
derive ^Eq, ^Show

type AnswerCase = record:
    # The variant, the tag's struct name (`UiButton`); the accessor that takes its value
    # out (`ui_button`); the tag's struct path (`ui::UiButton`) and qualified name.
    variant: Text
    accessor: Text
    structPath: Text
    tagName: Text
    ty: RsTy
derive ^Eq, ^Show

# ---------------------------------------------------------------------------------------
# The context: the environment, the typed tables by place, the module being lowered
# ---------------------------------------------------------------------------------------

type Lx = record:
    g: G
    tys: (Text ==> Ty)
    apps: (Text ==> AppNote)
    binders: (Text ==> Ty)
    impls: (Text ==> [ImplNote])
    file: Nat
    home: Text
    site: Text
    rsMods: (Text ==> Text)
    rsNames: (Text ==> Text)
    layouts: (Text ==> [Bool])
    unbs: [Text]
    notes: [Text]
    # Every module-level Rust name a local could hide, as `Module.name`; the prelude's
    # under `Prelude`, which every module imports.
    globals: (Text ==> Bool)
    # Lowering inside a node, which has a read point (`cx`): a host's supplier.
    inNode: Bool
    # The `while` loops of unbounded functions the shrink check did not clear, by place:
    # each turn of one is a cycle point (D6).
    unshrunk: (Text ==> Bool)
derive ^Eq, ^Show

# A key into the typed tables: the file and the range.
PlaceKey: fn Lx, Range -> Text
fn PlaceKey lx, r = "{lx.file}:{r.start}:{r.end}"

TypeAt: fn Lx, Range -> Ty
fn TypeAt lx, r = Or lx.tys[PlaceKey lx, r], TyErr

?AppAt: fn Lx, Range -> ?AppNote
fn ?AppAt lx, r = lx.apps[PlaceKey lx, r]

BinderTy: fn Lx, Range -> Ty
fn BinderTy lx, r = Or lx.binders[PlaceKey lx, r], (TypeAt lx, r)

# The tables of the typed program by place.
TypedTables: fn TProgram -> (((Text ==> Ty), (Text ==> AppNote), (Text ==> Ty), (Text ==> [ImplNote])))
fn TypedTables tp:
    let tys = Fold tp.exprs, {}, \|m, n| Insert m, (AtKey n.at), n.ty
    let apps = Fold tp.apps, {}, \|m, n| Insert m, (AtKey n.at), n
    let bs = Fold tp.binders, {}, \|m, n| Insert m, (AtKey n.at), n.ty
    let ims = Fold tp.impls, {}, \|m, n| Insert m, (AtKey n.at), (Push (Or m[AtKey n.at], [[]]), n)
    ((tys, apps, bs, ims))

# ---------------------------------------------------------------------------------------
# Names (Compiler ch. 4: a block's class is named after its function, a binding after its
# variable; pick NM of the README: Rust's conventions)
# ---------------------------------------------------------------------------------------

let rustKeywords = [["as", "async", "await", "box", "break", "const", "continue", "crate", "do", "dyn", "else", "enum", "extern", "false", "final", "fn", "for", "gen", "if", "impl", "in", "let", "loop", "macro", "match", "mod", "move", "mut", "override", "priv", "pub", "ref", "return", "self", "static", "struct", "super", "trait", "true", "try", "type", "typeof", "unsafe", "unsized", "use", "virtual", "where", "while", "yield", "u8", "u16", "u32", "u64", "i8", "i16", "i32", "i64", "f32", "f64", "bool", "char", "str", "usize", "isize", "cx", "node", "path", "v", "p"]]

# A Prism name without its sigils.
Base: fn Text -> Text
fn Base name = Drop name, (Len (MarksOf name))

# `rootModule` and `ParseNat` as `root_module` and `parse_nat`; a Rust keyword, or a name
# the emitted code uses for itself, takes a `_`.
Snake: fn Text -> Text
fn Snake name:
    let ((out, ignore)) = Fold (Chars (Base name)), (("", "")), \|((acc, prev)), c|
        let sep = if (IsUpper c) and ((IsLower prev) or (IsDigit prev)): "_" else: ""
        ((("{acc}{sep}{LowerChar c}"), c))
    let plain = if out == "": "x" else: out
    if HasText rustKeywords, plain: "{plain}_" else: plain

LowerChar: fn Text -> Text
fn LowerChar c = if IsUpper c: Lower c else: c

# A type or constructor name as Rust writes one: the first letter upper.
Camel: fn Text -> Text
fn Camel name:
    let b = Base name
    let first = Take b, 1
    let fixed = if IsLower first: "{Upper first}{Drop b, 1}" else: b
    if fixed == "Self": "Self_" else: fixed

# A Prism module's Rust module.
RustModName: fn Text -> Text
fn RustModName m = if m == "": "program" else: Snake (Join (Split m, "."), "_")

# The Rust path of a module's item `name` as written in module `here`.
PathIn: fn Lx, Text, Text -> Text
fn PathIn lx, owner, name:
    if owner == lx.site: name
    else: if owner == "Prelude": name
    else: "{Or lx.rsMods[owner], (RustModName owner)}::{name}"

# The Rust name of a top-level value of a module: its snake case, with a suffix by its
# sigil when another value of the module has the same base (`?ParseNat` and `~ParseNat`).
ValueNames: fn G -> (Text ==> Text)
fn ValueNames g:
    let lets = Fold g.defs, [[]], \|acc, d| match d.body:
        DbLet ignore: AddText acc, d.qk
        otherwise: acc
    let keys = UnionTexts (Keys g.vals), lets
    let bases = Fold keys, {}, \|m, k| Insert m, (BaseKey k), (Push (Or m[BaseKey k], [[]]), k)
    Fold keys, {}, \|m, k| Insert m, k, (ValueName k, (Len (Or bases[BaseKey k], [[]])))

GlobalNames: fn G -> (Text ==> Bool)
fn GlobalNames g:
    let names = ValueNames g
    Fold (Keys names), {}, \|m, k| Insert m, "{OwnerOf k}.{Or names[k], ""}", True

# A local's Rust name (pick NM): a `?x` is `x_opt`, a `~x` is `x_try` and a `K` is
# `k_fn`, so that it never hides a plain `x` or `k` of the same scope; a local whose name a function of the module
# or the prelude has takes a `_` (`kind_` beside the function `kind`).
LocalName: fn Lx, Text -> Text
fn LocalName lx, nkey:
    let marks = MarksOf nkey
    let base = Snake nkey
    let bare = Drop nkey, (Len marks)
    let s0 = if HasText (Chars marks), "?": "{base}_opt" else: if HasText (Chars marks), "~": "{base}_try" else: base
    # A capitalised local is a function value (`K`, `Pipe`); Rust's case would make it
    # the plain `k` beside it.
    let s1 = if IsUpperText (Take bare, 1): "{s0}_fn" else: s0
    if (HasKey lx.globals, "{lx.site}.{s1}") or HasKey lx.globals, "Prelude.{s1}": "{s1}_" else: s1

BaseKey: fn Text -> Text
fn BaseKey k:
    let parts = Split k, "."
    let last = Or (?Last parts), k
    "{Join (Take parts, (Dec (Len parts))), "."}.{Snake last}"

ValueName: fn Text, Nat -> Text
fn ValueName k, count:
    let last = BareName k
    let marks = MarksOf last
    let base = Snake last
    if count > 1 and marks != "": "{Drop base, 0}_{SigilWord (Take marks, 1)}"
    else: if count > 1 and not (IsUpperText (Take last, 1)): "{base}_value"
    else: base

SigilWord: fn Text -> Text
fn SigilWord "?" = "opt"
fn SigilWord "~" = "try"
fn SigilWord "!" = "ev"
fn SigilWord "$" = "dyn"
fn SigilWord "@" = "widget"
fn SigilWord "&" = "ref"
fn SigilWord other = "x"

# A top-level value's Rust path from the current module.
ValuePath: fn Lx, Text -> Text
fn ValuePath lx, qk:
    let owner = match lx.g.vals[qk]:
        ? v: v.home
        nil: OwnerOf qk
    PathIn lx, owner, (Or lx.rsNames[qk], (Snake (BareName qk)))

# The module a qualified key belongs to: everything before its last segment.
OwnerOf: fn Text -> Text
fn OwnerOf qk:
    let parts = Split qk, "."
    Join (Take parts, (Dec (Len parts))), "."

# A tag's Rust struct: its family and name run together (`Ui.Button` is `UiButton`).
TagStruct: fn Text -> Text
fn TagStruct tn = Concat (Each (Split tn, "."), \|p| Camel p)

# ---------------------------------------------------------------------------------------
# Types (docs/backend.md, "Types")
# ---------------------------------------------------------------------------------------

# A checker type as a Rust type. The time layers outside are the caller's to peel: a `$a`
# or `!a` that is a value is `Dynamic` or `Event`.
RustTy: unbounded fn Lx, Ty -> RsTy
fn RustTy lx, t = match t:
    TyCon "Nat", [[]]: RsNat
    TyCon "Int", [[]]: RsInt
    TyCon "U8", [[]]: RsU8
    TyCon "Float", [[]]: RsFloat
    TyCon "Bool", [[]]: RsBool
    TyCon "Char", [[]]: RsChar
    TyCon "Text", [[]]: RsText
    TyCon "unit", [[]]: RsUnit
    TyCon "Path", [[]]: RsPath
    TyCon "Duration", [[]]: RsDuration
    TyCon "Prelude.Error", [[]]: RsError
    TyCon "\u{0}Self", [[]]: RsNamed "Self", [[]]
    TyCon "Buffer", [[a]]: RsArray (RustTy lx, a)
    TyCon "Table", [[k, v]]: RsArray (RsTuple [[(RustTy lx, k), (RustTy lx, v)]])
    TyCon "\u{0}Event", [[a]]: RsEvent (RustTy lx, a)
    TyCon n, args: NamedTy lx, n, (Each args, \|a| RustTy lx, a)
    TyFn c, ps, res:
        # A function value of any color but bounded is a `Start` (D8: a color variable may
        # be unbounded), so one representation serves both instantiations.
        if c == CBound: RsFn (Each ps, \|p| RustTy lx, p), (RustTy lx, res)
        else: RsJobFn (RustTyOfParams lx, (Each ps, \|p| JobParam p)), (RustTy lx, res)
    TyTuple [[]]: RsUnit
    TyTuple ts: RsTuple (Each ts, \|a| RustTy lx, a)
    TyArray e: RsArray (RustTy lx, e)
    TyMap k, v: RsMap (RustTy lx, k), (RustTy lx, v)
    TySig "?", i: RsOpt (RustTy lx, i)
    TySig "~", i: RsRes (RustTy lx, i)
    TySig "!", i: RsEvent (RustTy lx, i)
    TySig "$", i: RsDyn (RustTy lx, i)
    TySig "&", i: RustTy lx, i
    TySig ignore, i: RustTy lx, i
    TyQ n: RsGen (Camel n)
    TyRigid n: RsGen (Camel n)
    TyFlex ignore: RsUnit
    TyAny ignore: RsShowAny
    TyElem ignore, ignore: RsLive (RsNamed "crate::Elem", [[]])
    TyElemAny ignore: RsNamed "crate::Elem", [[]]
    TyAt i, ignore: blueprintTy
    TyAssoc ignore, ignore: RsUnknown "an associated type"
    TyErr: RsUnknown "a type the checker did not find"

# A blueprint as a value, `@o` (a supplier's answer): prism_rtl's, over the program's
# element and answer enums (pick HO).
let blueprintTy = RsNamed "prism_rtl::Blueprint<crate::Elem, crate::Answer>", [[]]

# The program's element and answer enums, `crate::Elem` and `crate::Answer`, and a host as
# its rows reach it.
let elemTy = RsNamed "crate::Elem", [[]]
let answerTy = RsNamed "crate::Answer", [[]]
let hostOfTy = RsNamed "Rc<dyn prism_rtl::HostOf<crate::Elem, crate::Answer>>", [[]]

# Whether a type gives a blueprint (`@o`, `?@o`).
HasBlueprint: fn Ty -> Bool
fn HasBlueprint t = match t:
    TyAt ignore, ignore: True
    TySig ignore, i: HasBlueprint i
    otherwise: False

# An event parameter taken as an event value: a type `Peel` leaves and `RustTy` spells
# `Event<A>`.
EventParam: fn Ty -> Ty
fn EventParam t = match t:
    TySig "!", i: TyCon "\u{0}Event", [[(Peel i)]]
    otherwise: t

# A `Start`'s function parameter is a `Start` whatever its color: a caller may pass an
# unbounded one where the callee's own type says bounded (a parameter's color is
# contravariant), and a `Start` serves both.
JobParam: fn Ty -> Ty
fn JobParam (TyFn ignore, ps, r) = TyFn CUnbound, ps, r
fn JobParam t = t

# An unbounded function's parameter as a job function's: one parameter is itself, several
# a tuple.
RustTyOfParams: unbounded fn Lx, [Ty] -> RsTy
fn RustTyOfParams lx, ps = match ps:
    [[p]]: RustTy lx, p
    otherwise: RsTuple (Each ps, \|p| RustTy lx, p)

# A declared type: an alias is its target; a prelude type is the prelude module's.
NamedTy: unbounded fn Lx, Text, [RsTy] -> RsTy
fn NamedTy lx, n, args = match lx.g.types[n]:
    ? ti: match ti.body:
        BAlias a: RustTy lx, a
        # A fault kind is its name (`Error`'s `kind`); any other row kind is its enum.
        BRowKind: if n == "Prelude.Fault": RsPod else: RsNamed (PathIn lx, ti.home, (Camel (BareName n))), [[]]
        otherwise: RsNamed (PathIn lx, ti.home, (Camel (BareName n))), args
    nil: if HasKey lx.g.families, n: RsPod else: RsNamed (Camel (BareName n)), args

# A type with its time layers peeled: what a value of it holds at one moment.
Peel: fn Ty -> Ty
fn Peel t = match t:
    TySig "$", i: Peel i
    TySig "!", i: Peel i
    TySig "&", i: Peel i
    otherwise: t

# What a blueprint gives, its layers peeled: `@!Term` holds a `Term` at a firing.
OutOf: fn Ty -> Ty
fn OutOf t = match t:
    TyAt i, ignore: Peel i
    otherwise: Peel t

# The outermost time layer of a type: a dynamic (`$`), an event (`!`), a blueprint (`@`)
# or none, a plain value.
type Layer = choice:
    LyPlain
    LyDyn
    LyEv
    LyBlueprint
derive ^Eq, ^Show

LayerOf: fn Ty -> Layer
fn LayerOf t = match t:
    TySig "$", ignore: LyDyn
    TySig "!", ignore: LyEv
    TySig "&", i: LayerOf i
    TyAt ignore, ignore: LyBlueprint
    otherwise: LyPlain

# Whether a constructor's fields hold their type's own values by value (directly, in an
# optional or a tuple), so they go behind an `Rc` (docs/backend.md: recursive payloads
# behind `Rc`). Arrays and maps are behind a pointer already.
Layouts: unbounded fn G -> (Text ==> [Bool])
fn Layouts g = Fold (Values g.ctors), {}, \|m, c| Insert m, c.name, (Each c.args, \|a| Reaches g, a, c.owner, [[]])

Reaches: unbounded fn G, Ty, Text, [Text] -> Bool
fn Reaches g, t, target, seen = match t:
    TyCon n, args:
        if n == target: True
        else: if HasText seen, n: False
        else: if Fold args, False, \|f, a| f or Reaches g, a, target, seen: True
        else: match g.types[n]:
            ? ti: match ti.body:
                BRecord fs: Fold fs, False, \|f, ((ignore, ft))| f or Reaches g, ft, target, (Push seen, n)
                BChoice cs: Fold cs, False, \|f, ((ignore, ats))| f or Fold ats, False, \|f2, at| f2 or Reaches g, at, target, (Push seen, n)
                BAlias a: Reaches g, a, target, (Push seen, n)
                otherwise: False
            nil: False
    TySig "?", i: Reaches g, i, target, seen
    TySig "~", i: Reaches g, i, target, seen
    TyTuple ts: Fold ts, False, \|f, a| f or Reaches g, a, target, seen
    otherwise: False

# Whether constructor `ctor`'s field `i` is behind an `Rc`.
RcField: fn Lx, Text, Nat -> Bool
fn RcField lx, ctor, i = Or (Or lx.layouts[ctor], [[]])[i], False

# Whether a type holds a `Float` anywhere, which keeps it out of `Eq` and `Ord`.
Floaty: unbounded fn G, Ty, [Text] -> Bool
fn Floaty g, t, seen = match t:
    TyCon "Float", [[]]: True
    TyCon n, args:
        if Fold args, False, \|f, a| f or Floaty g, a, seen: True
        else: if HasText seen, n: False
        else: match g.types[n]:
            ? ti: match ti.body:
                BRecord fs: Fold fs, False, \|f, ((ignore, ft))| f or Floaty g, ft, (Push seen, n)
                BChoice cs: Fold cs, False, \|f, ((ignore, ats))| f or Fold ats, False, \|f2, at| f2 or Floaty g, at, (Push seen, n)
                otherwise: False
            nil: False
    TySig ignore, i: Floaty g, i, seen
    TyTuple ts: Fold ts, False, \|f, a| f or Floaty g, a, seen
    TyArray e: Floaty g, e, seen
    TyMap k, v: (Floaty g, k, seen) or Floaty g, v, seen
    otherwise: False

# Whether a Rust type can cross to a World (`ToPod`, `FromPod`).
Podable: unbounded fn RsTy -> Bool
fn Podable t = match t:
    RsFn ignore, ignore: False
    RsJobFn ignore, ignore: False
    RsJob ignore: False
    RsEvent ignore: False
    RsDyn ignore: False
    RsShowAny: False
    RsLive ignore: False
    RsUnknown ignore: False
    RsGen ignore: True
    RsNamed ignore, args: Fold args, True, \|ok, a| ok and Podable a
    RsOpt i: Podable i
    RsRes i: Podable i
    RsRc i: Podable i
    RsTuple ts: Fold ts, True, \|ok, a| ok and Podable a
    RsArray e: Podable e
    RsMap k, v: (Podable k) and Podable v
    otherwise: True

# ---------------------------------------------------------------------------------------
# Values: what a Prism name stands for, and how a value is borrowed or owned (Compiler
# ch. 4, "The ownership layer": a function takes references and returns a value)
# ---------------------------------------------------------------------------------------

# How a Rust place holds its value (pick OW of the README): `ByRef` a `&T`, `Owned` a `T`
# (a local, a field), `RcRef` a `&Rc<T>` (a payload behind an `Rc`, matched through a
# reference), `RcOwned` an `Rc<T>`.
type Holding = choice:
    ByRef
    Owned
    RcRef
    RcOwned
derive ^Eq, ^Show

# A name where it is read. `BnLocal` is a Rust place and how it holds its value. In a
# widget block a hold reads at the read point, a derived dynamic is a reader, and an event
# is a node of the block's graph.
type Bn = choice:
    BnLocal Text, Holding, RsTy
    BnHold Text, RsTy
    BnDyn Ex, [Read], RsTy
    BnEv EvRef, RsTy
    # A tuple pattern's parts, each its name's binding (`((id, !incoming)) <- Gui.Window(..)`),
    # where a bundle's output goes.
    BnParts [?Bn]
    # A widget parameter's argument (`@child`, given `@widget: ..` or `@$board`): the
    # blueprint expression with the caller's environments and context, a closure lowered
    # where the parameter is applied (pick WB).
    BnWidget Expr, Env, Env, Lx
    # A local function of a block (`fn Paired k, v = ((k, v))`): its clause, inlined
    # where it is called.
    BnLocalFn FnClause

type Env = record:
    names: (Text ==> Bn)
    spans: (Text ==> Vl)

let emptyEnv = Env(names={}, spans={})

BindSpan: fn Env, Text, Vl -> Env
fn BindSpan env, nkey, v = update env:
    &_.spans <= Insert &_.spans, nkey, v

Bind: fn Env, Text, Bn -> Env
fn Bind env, name, b = update env:
    &_.names <= Insert &_.names, name, b

# A lowered value: a place with how it holds its value, or an owned temporary.
type Vl = choice:
    VlPlace Ex, Holding, RsTy
    VlOwned Ex, RsTy

ValueTy: fn Vl -> RsTy
fn ValueTy (VlPlace ignore, ignore, t) = t
fn ValueTy (VlOwned ignore, t) = t

LocalPlace: fn Text, Holding, RsTy -> Vl
fn LocalPlace rs, mode, t = VlPlace (XRaw rs), mode, t

# The value, owned: a place is cloned (values are cheap to clone, docs/backend.md).
Own: fn Vl -> Ex
fn Own (VlPlace x, RcRef, ignore) = XMethod (XUnary "*", (XUnary "*", x)), "clone", [[]]
fn Own (VlPlace x, RcOwned, ignore) = XMethod (XUnary "*", x), "clone", [[]]
fn Own (VlPlace x, mode, t) = if IsCopy t: Copy (VlPlace x, mode, t) else: XMethod x, "clone", [[]]
fn Own (VlOwned e, ignore) = e

# The value, borrowed: what a parameter takes.
Ref: fn Vl -> Ex
fn Ref (VlPlace x, ByRef, ignore) = x
fn Ref (VlPlace x, RcRef, ignore) = XUnary "&", (XUnary "*", (XUnary "*", x))
fn Ref (VlPlace x, RcOwned, ignore) = XUnary "&", (XUnary "*", x)
fn Ref (VlPlace x, ignore, ignore) = XUnary "&", x
fn Ref (VlOwned e, ignore) = XUnary "&", e

# A copy type's value: `bool`, `f64`, `u8`, `char`, `()`.
Copy: fn Vl -> Ex
fn Copy (VlPlace x, ByRef, ignore) = XUnary "*", x
fn Copy (VlPlace x, RcRef, ignore) = XUnary "*", (XUnary "*", (XUnary "*", x))
fn Copy (VlPlace x, ignore, ignore) = x
fn Copy (VlOwned e, ignore) = e

IsCopy: fn RsTy -> Bool
fn IsCopy t = t == RsBool or t == RsFloat or t == RsU8 or t == RsChar or t == RsUnit

# A value used as a condition or an operand of `and`.
AsBool: fn Vl -> Ex
fn AsBool v = Copy v

# ---------------------------------------------------------------------------------------
# Literals
# ---------------------------------------------------------------------------------------

# A Rust string literal's inside.
Escape: fn Text -> Text
fn Escape t = Concat (Each (Chars t), \|c| CharEscape c)

CharEscape: fn Text -> Text
fn CharEscape "\\" = "\\\\"
fn CharEscape "\"" = "\\\""
fn CharEscape "\n" = "\\n"
fn CharEscape "\t" = "\\t"
fn CharEscape "\u{d}" = "\\r"
fn CharEscape "\u{0}" = "\\0"
fn CharEscape c = c

# A number literal of a numeric type.
Number: fn RsTy, Text, Bool -> Ex
fn Number t, digits, neg:
    let clean = Concat (Filter (Chars digits), \|c| c != "_")
    let signed = if neg: "-{clean}" else: clean
    match t:
        RsNat: if (Len clean) <= 9: XCall "Nat::from", [[XRaw "{clean}u32"]] else: XRaw "Nat::from_int(Int::from({clean}i64)).unwrap()"
        RsInt: XCall "Int::from", [[XRaw (if (Len clean) <= 18: "{signed}" else: "{signed}i64")]]
        RsU8: XRaw "{clean}u8"
        RsFloat: XRaw (if Contains clean, ".": signed else: "{signed}.0")
        otherwise: XCall "Int::from", [[XRaw signed]]

LiteralValue: unbounded fn Lx, Env, Literal, Range, Bool -> Vl
fn LiteralValue lx, env, l, span, neg:
    let t = RustTy lx, (Peel (TypeAt lx, span))
    match l.kind:
        LInt d: VlOwned (Number t, d, neg), t
        LFloat d: VlOwned (XRaw (if neg: "-{d}" else: d)), RsFloat
        LChar c: VlOwned (XRaw "'{CharEscape c}'"), RsChar
        LDuration d, u: VlOwned (Refusal "a Duration literal"), RsDuration
        LText segs: TextValue lx, env, segs

# A text, interpolated: `Text::from(format!(..))`, a `Text` placed as it is and any other
# value through `^Show` (Type System ch. 4).
TextValue: unbounded fn Lx, Env, [TextSeg] -> Vl
fn TextValue lx, env, segs:
    let plain = Fold segs, True, \|ok, s| ok and IsPlainSeg s
    if plain: VlOwned (XText (Concat (Each segs, \|s| PlainText s))), RsText
    else: VlOwned (XFormat (Each segs, \|s| SegEx lx, env, s)), RsText

IsPlainSeg: fn TextSeg -> Bool
fn IsPlainSeg (SegPlain ignore) = True
fn IsPlainSeg (SegPlaceholder ignore) = False

PlainText: fn TextSeg -> Text
fn PlainText (SegPlain t) = t
fn PlainText (SegPlaceholder ignore) = ""

SegEx: unbounded fn Lx, Env, TextSeg -> Ex
fn SegEx lx, env, (SegPlain t) = XText t
fn SegEx lx, env, (SegPlaceholder e):
    let v = ValueOf lx, env, e
    ShownPart v

# A placeholder's text: a `Text` or a number as it displays, anything else as it shows.
ShownPart: fn Vl -> Ex
fn ShownPart v = match ValueTy v:
    RsText: Ref v
    RsNat: Ref v
    RsInt: Ref v
    RsU8: Ref v
    otherwise: XCall "show", [[Ref v]]

# ---------------------------------------------------------------------------------------
# Plain expressions (docs/backend.md, "Functions and lifting": a plain function takes
# references, its clauses one `match`)
# ---------------------------------------------------------------------------------------

# What lowering cannot lower fails loudly: a `compile_error!` naming the construct, which
# `CompileProgram` finds in the emitted files and reports as a refusal, the crate still
# written for reading.
Refusal: fn Text -> Ex
fn Refusal what = XCall "compile_error!", [[XRaw "\"{loweringRefusal}{Escape what}\""]]

let loweringRefusal = "prismc does not lower "

RefusalDo: fn Text -> Do
fn RefusalDo what = DoExpr (Refusal what)

ValueOf: unbounded fn Lx, Env, Expr -> Vl
fn ValueOf lx, env, e = match env.spans[PlaceKey lx, e.span]:
    ? v: v
    nil: UnboundValueOf lx, env, e

# An event's value inside the expression that maps it is bound by the event's place in
# the source (`Env.spans`), so the map is the plain expression over that value.
UnboundValueOf: unbounded fn Lx, Env, Expr -> Vl
fn UnboundValueOf lx, env, e:
    if IsEventValue lx, env, e: EventValueOf lx, env, e
    else: ValueByKind lx, env, e

# An expression of an event type outside the pipe that maps it (no event of it is bound
# by its place): an event value, `prism_rtl::Event`, built by the library's combinators
# (a function with a `!` parameter, a supplier's `@ !Filter (?ClickTo p, !in)`).
IsEventValue: unbounded fn Lx, Env, Expr -> Bool
fn IsEventValue lx, env, e = match e.kind:
    EName ignore: False
    EGroup ignore: False
    otherwise: ((LayerOf (TypeAt lx, e.span)) == LyEv) and (not (Fold (Operands e), False, \|bound, c| bound or HasKey env.spans, (PlaceKey lx, c.span))) and HasEventSource lx, env, e

# Whether an event expression stands over an event value: a local of an event type (a
# parameter taken as one), or a node's event that has its value port. A lifted function's
# body (`fn !Bump $n, !go = $n + 1 on !go`) has neither: its events are its firing.
HasEventSource: unbounded fn Lx, Env, Expr -> Bool
fn HasEventSource lx, env, e = Fold (Operands e), False, \|found, c| found or IsEventSource lx, env, c

IsEventSource: unbounded fn Lx, Env, Expr -> Bool
fn IsEventSource lx, env, c:
    if (LayerOf (TypeAt lx, c.span)) != LyEv: False
    else: match c.kind:
        EName n: match env.names[SNameKey n]:
            ? (BnLocal ignore, ignore, (RsEvent ignore)): True
            ? (BnEv ignore, ignore): HasKey env.names, "{SNameKey n}#port"
            otherwise: False
        EGroup x: IsEventSource lx, env, x
        otherwise: HasEventSource lx, env, c

EventValueOf: unbounded fn Lx, Env, Expr -> Vl
fn EventValueOf lx, env, e:
    let t = RustTy lx, (Peel (TypeAt lx, e.span))
    let et = RsEvent t
    let ?filtered = match e.kind:
        ECall c, args, ignore, ignore: if (CalleeKey lx, c) == "Prelude.!Filter": args[0] else: nil
        otherwise: nil
    match ?filtered:
        ? a: VlOwned (XMethod (Own (ValueOf lx, env, a.value)), "filter_some", [[]]), et
        nil:
            let evs = Filter (Operands e), \|x| (LayerOf (TypeAt lx, x.span)) == LyEv
            match evs:
                [[one]]:
                    let src = Own (ValueOf lx, env, one)
                    let it = RustTy lx, (Peel (TypeAt lx, one.span))
                    let caps = Filter (ReadNames (ExprsIn e)), \|n| match env.names[n]:
                        ? (BnLocal ignore, ignore, ignore): True
                        otherwise: False
                    let ((dos, env1)) = Fold caps, (([[]], env)), \|((acc, en)), n| match env.names[n]:
                        ? (BnLocal rs, mode, ct):
                            let local = "{if (Take rs, 5) == "self.": Drop rs, 5 else: rs}_c"
                            (((Push acc, (DoLet (PaBind local), (Own (LocalPlace rs, mode, ct)))), (Bind en, n, (BnLocal local, Owned, ct))))
                        otherwise: ((acc, en))
                    let env2 = BindSpan env1, (PlaceKey lx, one.span), (VlPlace (XRaw "y_ev"), ByRef, it)
                    let body = Own (ValueByKind lx, env2, e)
                    let mapped = XMethod src, "map", [[(XClosure True, [[(PaTyped (PaBind "y_ev"), (RsRef it))]], body)]]
                    VlOwned (XBlock (Push dos, (DoLet (PaBind "src_ev"), src)), (XMethod (XRaw "src_ev"), "map", [[(XClosure True, [[(PaTyped (PaBind "y_ev"), (RsRef it))]], body)]])), et
                otherwise: VlOwned (Refusal "an event value of several events"), et

ValueByKind: unbounded fn Lx, Env, Expr -> Vl
fn ValueByKind lx, env, e:
    let t = RustTy lx, (Peel (TypeAt lx, e.span))
    match e.kind:
        EName n: NameValue lx, env, n, e.span
        ELit l: LiteralValue lx, env, l, e.span, False
        EUnit ignore: VlOwned (XRaw "()"), RsUnit
        EBound b: match env.names[b]:
            ? (BnLocal rs, mode, bt): LocalPlace rs, mode, bt
            otherwise: VlOwned (Refusal "`{b}` outside a `for`"), t
        ENil ignore: VlOwned (XRaw "None"), t
        ETuple es: VlOwned (XTuple (Each es, \|x| Own (ValueOf lx, env, x))), t
        EArray [[]]: VlOwned (XRaw "Array::new()"), t
        EArray es: VlOwned (XCall "Array::from", [[XVec (Each es, \|x| Own (ValueOf lx, env, x))]]), t
        EMap [[]]: VlOwned (XRaw "Map::new()"), t
        EMap kvs: VlOwned (XCall "map_of", [[XVec (Each kvs, \|((k, v))| XTuple [[Own (ValueOf lx, env, k), Own (ValueOf lx, env, v)]])]]), t
        EGroup x: ValueOf lx, env, x
        ECall c, args, ignore, ignore: Application lx, env, c, args, e.span
        EMethod r, m, args: Application lx, env, (Expr(kind=(EName m), span=m.span)), (Append [[Arg(name=nil, value=r, span=r.span)]], args), e.span
        EBinary op, l, r: BinaryValue lx, env, op, l, r, e.span
        EUnary "not", x: VlOwned (XUnary "!", (AsBool (ValueOf lx, env, x))), RsBool
        EUnary "neg", x: match x.kind:
            ELit l: LiteralValue lx, env, l, x.span, True
            otherwise:
                let v = ValueOf lx, env, x
                if IsCopy t: VlOwned (XUnary "-", (Copy v)), t else: VlOwned (XUnary "-", (Ref v)), t
        EUnary ignore, x: ValueOf lx, env, x
        EFreeSigil "?", x: VlOwned (XCtor "Some", [[Own (ValueOf lx, env, x)]]), t
        EFreeSigil "~", x: VlOwned (XCtor "Ok", [[Own (ValueOf lx, env, x)]]), t
        EFreeSigil "@", x: PureBlueprint lx, env, x, t
        EFreeSigil ignore, x: ValueOf lx, env, x
        EField r, ignore, name: FieldValue lx, env, r, name.name
        EIndex r, i: IndexValue lx, env, r, i, t
        ELambda ?ps, body: LambdaValue lx, env, e, (Or ?ps, [[]]), body
        EIf c, thenB, ?elseB: IfValue lx, env, c, thenB, ?elseB, t
        EMatch s, arms: MatchValue lx, env, s, arms, t, e.span
        ETemplate tp: TemplateValue lx, env, tp
        ECast x, ignore, ignore: ValueOf lx, env, x
        ETypeArgs x, ignore: ValueOf lx, env, x
        EGiven b: GivenValue lx, env, b, t, e.span
        EUpdate target, b: UpdateValue lx, env, target, b, t, e.span
        EAny x: VlOwned (XCall "Rc::new", [[Own (ValueOf lx, env, x)]]), RsShowAny
        otherwise: VlOwned (Refusal "{KindWords e.kind} as a value"), t

# `@ x` as a value (a supplier's arm; pick HO): a blueprint with no places whose output is
# `x`, typed as the tag's variant of `crate::Answer`, so the arm must stand under a tag
# pattern on the live element (`Ui.Button(..): @ !tap`), which binds the tag (`#tag`). A
# plain value, or a constant dynamic (`@ $ (~ Contents(..))`), is the place's first value
# once; an event's firings are answers, each a tick late; `never` answers nothing. A dynamic
# that is not a constant (`@ $hold`) is not lowered yet: its updates would be delayed
# answers through prism_rtl's `dynamic_blueprint`, over a `Dynamic` of the hold.
PureBlueprint: unbounded fn Lx, Env, Expr, RsTy -> Vl
fn PureBlueprint lx, env, x, t:
    let isNever = match x.kind:
        EName n:
            let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
            ?qk == ? "Prelude.never"
        otherwise: False
    if isNever: VlOwned (XCall "prism_rtl::never_blueprint::<crate::Elem, crate::Answer>", [[]]), t
    else: match env.names["#tag"]:
        nil: VlOwned (Refusal "`@ {SrcText lx, lx.file, x.span}` as a supplier's answer outside a tag arm: which tag's output it answers cannot be known"), t
        ? (BnLocal variant, ignore, ignore): match LayerOf (TypeAt lx, x.span):
            LyEv:
                let wrapped = XMethod (Own (ValueOf lx, env, x)), "map", [[(XClosure False, [[PaBind "v"]], (XCtor variant, [[XRaw "v.clone()"]]))]]
                VlOwned (XCall "prism_rtl::event_blueprint::<crate::Elem, _>", [[wrapped]]), t
            LyDyn: match ?DynamicAnswer lx, x:
                nil: match x.kind:
                    EFreeSigil "$", inner: PlainBlueprint lx, env, inner, variant, t
                    otherwise: VlOwned (Refusal "`@ {SrcText lx, lx.file, x.span}`, a supplier's dynamic answer of no known form"), t
                ? d: DynamicBlueprint lx, env, x, d, variant, t
            otherwise: PlainBlueprint lx, env, x, variant, t
        otherwise: VlOwned (Refusal "a supplier's answer under a tag the arm does not name"), t

PlainBlueprint: unbounded fn Lx, Env, Expr, Text, RsTy -> Vl
fn PlainBlueprint lx, env, x, variant, t = VlOwned (XCall "prism_rtl::plain_blueprint::<crate::Elem, _>", [[(XCtor variant, [[Own (ValueOf lx, env, x)]])]]), t

# `@ $d` with `$d` a dynamic of the host that is not a constant (round 3 DY): prism_rtl's
# `dynamic_blueprint` over a `Dynamic` of the tag's `Answer` whose read is the owner's getter
# for `d` through the owner's link, and, while the owner's node is being made, `d`'s value at
# the build (`InitEnv`); its update port is the getter's, fired by the writes behind `d`
# (`DynamicAnswers`). The first value is read at the row's build, each later update is a push
# delivered the next tick.
DynamicBlueprint: unbounded fn Lx, Env, Expr, Expr, Text, RsTy -> Vl
fn DynamicBlueprint lx, env, x, d, variant, t = match ((env.names["#dyn{DynKey x}"], env.names["#owner"])):
    ((? (BnLocal getter, ignore, dt), ? (BnLocal owner, ignore, ignore))):
        let atBuild = Own (ValueOf lx, (InitEnv env), d)
        let arms = [[XArm(pat=(PaCtor "Some", [[PaBind "owner"]]), conds=[[]], body=(XCtor variant, [[(XMethod (XRaw "owner"), getter, [[XRaw "cx"]])]])), XArm(pat=(PaUnit "None"), conds=[[]], body=(XCtor variant, [[XRaw "at_build.clone()"]]))]]
        let read = XClosure True, [[(PaTyped (PaBind "cx"), (RsRef (RsNamed "Cx", [[]])))]], (XMatch (XMethod (XRaw "link"), "owner", [[]]), arms, False)
        let dynamic = XBlock [[(DoLet (PaBind "link"), (XRaw "{owner}.clone()")), (DoLet (PaBind "at_build"), atBuild)]], (XCall "prism_rtl::Dynamic::of", [[read, XRaw "&{getter}_port"]])
        VlOwned (XCall "prism_rtl::dynamic_blueprint::<crate::Elem, _>", [[dynamic]]), t
    otherwise: VlOwned (Refusal "`@ {SrcText lx, lx.file, x.span}`, a supplier's dynamic answer that reads what has no value at the owner's build (a pushed place, a structural dynamic, or a `let` after the host's line)"), t

# `@Element e` as a value: the forwarding blueprint, the child's element re-emitted in the
# host's scope.
ElementBlueprint: unbounded fn Lx, Env, [Arg], RsTy -> Vl
fn ElementBlueprint lx, env, args, t = match args[0]:
    ? a: VlOwned (XCall "prism_rtl::element_blueprint::<crate::Elem, crate::Answer>", [[Ref (ValueOf lx, env, a.value)]]), t
    nil: VlOwned (Refusal "`@Element` without its element"), t

# The construct an expression is, in words, for a refusal (`Refusal`).
KindWords: fn ExprKind -> Text
fn KindWords k = match k:
    ESuffixed op, ignore, ignore, ignore: "a suffixed `{op}`"
    EFreeSigil sg, ignore: "a free `{sg}`"
    ETopicField ignore: "a topic field (`&_.f` outside an `update`)"
    ETopicIndex ignore: "a topic index"
    ENonEmpty ignore: "a non-empty literal"
    EAbsent: "an absent value"
    ERest: "a `..` rest"
    ELambda ignore, ignore: "a lambda"
    ERebuild ignore, ignore: "a `rebuild` outside a widget block"
    EFor ignore, ignore, ignore: "a `for` outside a widget block"
    EWidgetBlock ignore: "a widget block"
    EMonad ignore, ignore: "a monadic block"
    ELens ignore: "a lens"
    EError: "an expression the parser could not read"
    otherwise: "an expression"

# A name: a local, or a global value, constructor or `let`.
NameValue: unbounded fn Lx, Env, SName, Range -> Vl
fn NameValue lx, env, n, span:
    let nkey = SNameKey n
    let t = RustTy lx, (Peel (TypeAt lx, span))
    let ?local = if (Len n.path) == 1: env.names[nkey] else: nil
    match ?local:
        ? (BnLocal rs, mode, lt): LocalPlace rs, mode, lt
        ? (BnHold f, ht): VlOwned (XMethod (XRaw "self.{f}"), "get", [[XRaw "cx"]]), ht
        ? (BnDyn x, ignore, dt): VlOwned x, dt
        ? (BnEv ignore, et): match env.names["{nkey}#port"]:
            ? (BnLocal pf, ignore, ignore): VlOwned (XCall "prism_rtl::Event::of", [[XRaw "&{pf}"]]), (RsEvent (RustTy lx, (Peel (Peel (TypeAt lx, span)))))
            otherwise: VlOwned (Refusal "an event read as a value"), et
        ? (BnParts ignore): VlOwned (Refusal "a tuple pattern's binding as a value"), t
        ? (BnWidget ignore, ignore, ignore, ignore): VlOwned (Refusal "a widget parameter read as a plain value"), t
        ? (BnLocalFn ignore): VlOwned (Refusal "a local function as a value"), t
        nil:
            let ((?qk, why)) = ResolveValue lx.g, lx.home, n
            match ?qk:
                ? "True": VlOwned (XRaw "true"), RsBool
                ? "False": VlOwned (XRaw "false"), RsBool
                ? "Prelude.never": VlOwned (XRaw "Event::never()"), t
                ? qk: match lx.g.tags[qk]:
                    ? tg if tg.kind != "Prelude.Fault" and why == "tag": TagValue lx, env, tg, [[]]
                    otherwise: GlobalValue lx, qk, span, t
                nil: VlOwned (Refusal "the name {nkey}, which nothing declares"), t

# A global named, not called: a constructor with no fields, a top-level `let` (its
# getter), a fault kind, or a function as a value.
GlobalValue: unbounded fn Lx, Text, Range, RsTy -> Vl
fn GlobalValue lx, qk, span, t = match lx.g.ctors[qk]:
    ? c:
        let arity = if (Len c.fields) > 0: Len c.fields else: Len c.args
        match t:
            RsFn pts, ignore: if arity > 0: CtorFn lx, c, pts, span, t, False else: CtorApp lx, emptyEnv, c, [[]], span
            RsJobFn a, ignore:
                let pts = match a:
                    RsTuple ts: if arity == 1: [[a]] else: ts
                    otherwise: [[a]]
                if arity > 0: CtorFn lx, c, pts, span, t, True else: CtorApp lx, emptyEnv, c, [[]], span
            otherwise: CtorApp lx, emptyEnv, c, [[]], span
    nil: match lx.g.tags[qk]:
        ? tg: VlOwned (XRaw "\"{tg.name}\""), t
        nil: if Fold lx.g.defs, False, \|f, d| f or (d.qk == qk and IsLetDef d): VlOwned (XCall (ValuePath lx, qk), [[]]), t
        else: match lx.g.vals[qk]:
            ? v:
                let isLet = Fold lx.g.defs, False, \|f, d| f or (d.qk == qk and IsLetDef d)
                if isLet: VlOwned (XCall (ValuePath lx, qk), [[]]), t
                else: match t:
                    RsJobFn a, ignore:
                        let ((ps, ignore2)) = SchemeParts lx, qk
                        let names = Each (Range0 (Len ps)), \|i| "a{i}"
                        let pa = if (Len ps) == 1: PaTyped (PaBind "a0"), a else: PaTyped (PaTuple (Each names, \|nm| PaBind nm)), a
                        let f = XClosure False, [[pa]], (XCall "entered", [[(XCall (StartPath lx, qk), (Each names, \|nm| XRaw nm))]])
                        VlOwned (XCast (XCall "Rc::new", [[f]]), t), t
                    otherwise: VlOwned (XCall "Rc::new", [[XRaw (ValuePath lx, qk)]]), t
            nil: VlOwned (Refusal "the global {qk}"), t

IsLetDef: fn Def -> Bool
fn IsLetDef d = match d.body:
    DbLet ignore: True
    otherwise: False

# The `Start` of an unbounded function: what its value is when passed to `@Run`.
StartPath: fn Lx, Text -> Text
fn StartPath lx, qk:
    let owner = match lx.g.vals[qk]:
        ? v: v.home
        nil: OwnerOf qk
    PathIn lx, owner, "start_{Or lx.rsNames[qk], (Snake (BareName qk))}"

# `f a, b`.
Application: unbounded fn Lx, Env, Expr, [Arg], Range -> Vl
fn Application lx, env, callee, args, span:
    let t = RustTy lx, (Peel (TypeAt lx, span))
    match callee.kind:
        EName n:
            let nkey = SNameKey n
            let ?local = if (Len n.path) == 1: env.names[nkey] else: nil
            match ?local:
                ? (BnLocalFn c): InlineLocalFn lx, env, c, args, t
                ? b:
                    let f = NameValue lx, env, n, callee.span
                    match ValueTy f:
                        RsJobFn ignore, ignore:
                            VlOwned (XCall "run_to_end", [[(StartCall f, (StartArgs lx, env, f, args))]]), t
                        otherwise: VlOwned (XApply (Ref f), (Each args, \|a| Argument lx, env, a.value)), t
                nil:
                    let ((?qk, why)) = ResolveValue lx.g, lx.home, n
                    match ?qk:
                        # A tag and a record may share a key (`Fs.Contents`); the name
                        # resolved to the tag only when written with its family.
                        ? qk: match lx.g.tags[qk]:
                            ? tg if why == "tag": TagValue lx, env, tg, args
                            otherwise: if qk == "Prelude.@Element": ElementBlueprint lx, env, args, t
                            else: GlobalCall lx, env, qk, args, span, t
                        nil: VlOwned (Refusal "a call of {nkey}, which nothing declares"), t
        EGroup x: Application lx, env, x, args, span
        otherwise:
            let f = ValueOf lx, env, callee
            match ValueTy f:
                RsJobFn ignore, ignore: VlOwned (XCall "run_to_end", [[(StartCall f, (StartArgs lx, env, f, args))]]), t
                otherwise: VlOwned (XApply (Ref f), (Each args, \|a| Argument lx, env, a.value)), t

# A local function called: its body inlined, each parameter a local bound to its
# argument (the caller's environment, which the function's block shares). A clause whose
# parameters are not names is not lowered yet.
InlineLocalFn: unbounded fn Lx, Env, FnClause, [Arg], RsTy -> Vl
fn InlineLocalFn lx, env, c, args, t:
    let names = Each c.params, \|p| PlainBinder lx, p
    if Fold names, False, \|bad, nm| bad or nm == "": VlOwned (Refusal "a local function whose parameters are not names"), t
    else:
        let ((dos, env2)) = Fold (Range0 (Len names)), (([[]], env)), \|((acc, en)), i|
            let nm = Or names[i], ""
            let rs = "{LocalName lx, nm}_{c.span.start}"
            let v = match args[i]:
                ? a: ValueOf lx, env, a.value
                nil: VlOwned (XRaw "()"), RsUnit
            let bt = ValueTy v
            (((Push acc, (DoLet (PaBind rs), (Own v))), (Bind en, nm, (BnLocal rs, Owned, bt))))
        VlOwned (XBlock dos, (FnBodyValue lx, env2, c.body)), t

# An argument as a parameter takes it: borrowed, a lambda as a borrowed closure.
Argument: unbounded fn Lx, Env, Expr -> Ex
fn Argument lx, env, e = match env.spans[PlaceKey lx, e.span]:
    ? v: Ref v
    nil: ArgumentByKind lx, env, e

ArgumentByKind: unbounded fn Lx, Env, Expr -> Ex
fn ArgumentByKind lx, env, e = match e.kind:
    ELambda ?ps, body: XUnary "&", (LambdaArg lx, env, (Or ?ps, [[]]), body, (LambdaParamTys lx, e, (Len (Or ?ps, [[]]))))
    EGroup x: Argument lx, env, x
    EName n:
        let t = TypeAt lx, e.span
        match Peel t:
            TyFn CBound, ignore, ignore:
                let ?local = if (Len n.path) == 1: env.names[SNameKey n] else: nil
                match ?local:
                    ? ignore: ClosureRef (ValueOf lx, env, e)
                    nil:
                        let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
                        match ?qk:
                            ? qk: if HasKey lx.g.ctors, qk: ClosureRef (ValueOf lx, env, e) else: XUnary "&", (XRaw (ValuePath lx, qk))
                            nil: Ref (ValueOf lx, env, e)
            otherwise: Ref (ValueOf lx, env, e)
    otherwise: Ref (ValueOf lx, env, e)

# A bounded function value where a `&dyn Fn` is taken: a parameter that is one already
# passes on; a closure held in an `Rc` is borrowed through it (`&*f`).
ClosureRef: fn Vl -> Ex
fn ClosureRef (VlPlace x, ByRef, t) = x
fn ClosureRef (VlPlace x, ignore, t) = XUnary "&", (XUnary "*", x)
fn ClosureRef (VlOwned x, t) = XUnary "&", (XUnary "*", x)

# A tag applied as a value (pick RV): a plain row kind's value is its enum's variant
# around the tag's struct (`Draw::DrawRect(DrawRect { .. })`). An element as a value is
# live, and only a host makes one (gap LE).
TagValue: unbounded fn Lx, Env, TagInfo, [Arg] -> Vl
fn TagValue lx, env, tg, args:
    let ((variant, structPath)) = TagPaths lx, tg
    let t = RsNamed (KindPath lx, tg.kind), [[]]
    match tg.kind:
        "Element": VlOwned (Refusal "an element as a plain value ({tg.name}): a live element comes from its host"), t
        "Prelude.Fault": VlOwned (Refusal "a fault kind applied ({tg.name})"), t
        otherwise:
            let named = Fold args, False, \|f, a| f or IsNamedArg a
            let fields = Each (Range0 (Len tg.fields)), \|i|
                let ((fname, ignore)) = Or tg.fields[i], (("", TyErr))
                let ?arg = if named: ?TagArg args, fname else: match args[i]:
                    ? a: ? a.value
                    nil: nil
                let v = match ?arg:
                    ? x: Own (ValueOf lx, env, x)
                    nil: XRaw "Default::default()"
                ((Snake fname, v))
            VlOwned (XCtor variant, [[(XRecord structPath, fields)]]), t

# A call of a global: a constructor, a trait method, a prelude function, a program's own.
GlobalCall: unbounded fn Lx, Env, Text, [Arg], Range, RsTy -> Vl
fn GlobalCall lx, env, qk, args, span, t:
    match lx.g.ctors[qk]:
        ? c: CtorApp lx, env, c, args, span
        nil: match lx.g.vals[qk]:
            ? v:
                if v.sort == "method": MethodCall lx, env, v, args, span, t
                else: if v.home == "Prelude": PreludeCall lx, env, qk, args, span, t
                else: VlOwned (XCall (ValuePath lx, qk), (ArgsFor lx, env, v, args)), t
            nil: VlOwned (Refusal "a call of {qk}"), t

# A function's arguments, borrowed; a bare `Error(..)` where the parameter is a `~T` is
# that `~T`'s failure (the checker's pick ER lets it wait for its type).
ArgsFor: unbounded fn Lx, Env, ValInfo, [Arg] -> [Ex]
fn ArgsFor lx, env, v, args:
    let ps = match v.scheme.ty:
        TyFn ignore, xs, ignore: xs
        otherwise: [[]]
    Each (Range0 (Len args)), \|i|
        let a = Or args[i], (Arg(name=nil, value=dummyExpr, span=Range(start=0, end=0)))
        let isTry = match Peel (Or ps[i], TyErr):
            TySig "~", ignore: True
            otherwise: False
        let isError = match Peel (TypeAt lx, a.value.span):
            TyCon "Prelude.Error", ignore: True
            otherwise: False
        let toUnbounded = match Peel (Or ps[i], TyErr):
            TyFn CBound, ignore, ignore: False
            TyFn ignore, ignore, ignore: True
            otherwise: False
        if isTry and isError: XUnary "&", (XCtor "Err", [[Own (ValueOf lx, env, a.value)]])
        else: if toUnbounded: XUnary "&", (AsJobValue lx, env, a.value)
        else: Argument lx, env, a.value

let dummyExpr = Expr(kind=EError, span=Range(start=0, end=0))

# A constructor applied (docs/backend.md: a record is a struct, a choice an enum with
# recursive payloads behind `Rc`, a newtype a tuple struct, a unit type a unit struct).
CtorApp: unbounded fn Lx, Env, CtorInfo, [Arg], Range -> Vl
fn CtorApp lx, env, c, args, span:
    let t = RustTy lx, (Peel (TypeAt lx, span))
    let owner = Or lx.g.types[c.owner], dummyTyInfo
    let tyPath = PathIn lx, owner.home, (Camel (BareName c.owner))
    let vals = CtorArgs lx, env, c, args
    match c.owner:
        "Bool": VlOwned (XRaw (if c.name == "True": "true" else: "false")), RsBool
        "Prelude.Error":
            let kind = Or vals[0], (XRaw "\"\"")
            let msg = Or vals[1], (XText "")
            let made = XCall "Error::new", [[kind, msg]]
            match t:
                RsRes ignore: VlOwned (XCtor "Err", [[made]]), t
                otherwise: VlOwned made, RsError
        otherwise: match owner.body:
            BRecord fs:
                if (Len c.fields) == 0: VlOwned (XRaw tyPath), t
                else: VlOwned (XRecord tyPath, (Each (Range0 (Len c.fields)), \|i| (((Snake (Or c.fields[i], "")), (Or vals[i], (XRaw "Default::default()")))))), t
            BChoice cases:
                let isUnitType = (Len cases) == 1 and (Len c.args) == 0 and IsLowerText (BareName c.name)
                let path = if isUnitType: tyPath else: "{tyPath}::{Camel (BareName c.name)}"
                if (Len c.args) == 0: VlOwned (XRaw path), t
                else: VlOwned (XCtor path, vals), t
            otherwise: VlOwned (Refusal "a constructor of {c.owner}"), t

# A constructor used as a function value (`OnePattern p, CkExpect`): a closure building
# it from its arguments, which a bounded value takes by reference and a `Start` owns.
CtorFn: unbounded fn Lx, CtorInfo, [RsTy], Range, RsTy, Bool -> Vl
fn CtorFn lx, c, pts, span, t, job:
    let names = Each (Range0 (Len pts)), \|i| "a{i}"
    # Each argument stands at a place no source has, bound to its parameter.
    let fakes = Each (Range0 (Len pts)), \|i| Arg(name=nil, value=(Expr(kind=EAbsent, span=Range(start=(4000000000 + i), end=(4000000000 + i)))), span=Range(start=0, end=0))
    let env = Fold (Range0 (Len pts)), emptyEnv, \|en, i| BindSpan en, (PlaceKey lx, (Range(start=(4000000000 + i), end=(4000000000 + i)))), (VlPlace (XRaw (Or names[i], "a")), (if job: Owned else: ByRef), (Or pts[i], RsUnit))
    let made = Own (CtorApp lx, env, c, fakes, span)
    if job:
        let a = match t:
            RsJobFn x, ignore: x
            otherwise: RsUnit
        let pa = if (Len pts) == 1: PaTyped (PaBind "a0"), a else: PaTyped (PaTuple (Each names, \|nm| PaBind nm)), a
        VlOwned (XCast (XCall "Rc::new", [[(XClosure True, [[pa]], (XCall "once_job", [[(XClosure True, [[]], (XCtor "prism_rtl::Turn::Finished", [[made]]))]]))]]), t), t
    else:
        let pas = Each (Range0 (Len pts)), \|i| PaTyped (PaBind (Or names[i], "a")), (RsRef (Or pts[i], RsUnit))
        VlOwned (XCall "Rc::new", [[(XClosure False, pas, made)]]), t

IsNamedArg: fn Arg -> Bool
fn IsNamedArg a = match a.?name:
    ? ignore: True
    nil: False

# A constructor's arguments, by position or by field name, owned, an `Rc` where the
# field is recursive.
CtorArgs: unbounded fn Lx, Env, CtorInfo, [Arg] -> [Ex]
fn CtorArgs lx, env, c, args:
    let named = Fold args, False, \|f, a| f or IsNamedArg a
    let ordered = if named: Each c.fields, \|f| Fold args, nil, \|?found, a| match a.?name:
        ? n: if n.name == f: ? a.value else: ?found
        nil: ?found
    else: Each args, \|a| ? a.value
    Each (Range0 (Len ordered)), \|i| match ordered[i]:
        ? (? x):
            let v = Own (ValueOf lx, env, x)
            if c.owner == "Prelude.Error" and i == 0: v
            else: if RcField lx, c.name, i: XCall "Rc::new", [[v]] else: v
        otherwise: XRaw "Default::default()"

# A trait method applied: the operator a builtin, derived or written impl answers (an
# `impl ^Eq` is emitted as Rust's `PartialEq`, so `==` reaches it), or the method of a
# program's own trait.
MethodCall: unbounded fn Lx, Env, ValInfo, [Arg], Range, RsTy -> Vl
fn MethodCall lx, env, v, args, span, t:
    let cls = Or (Each v.scheme.bounds, \|((ignore, c))| c)[0], ""
    let m = BareName v.qk
    let vals = Each args, \|a| ValueOf lx, env, a.value
    if (Take cls, 8) == "Prelude.": PreludeMethod lx, cls, m, vals, span, t
    else:
        let tr = Or lx.g.traits[cls], dummyTraitInfo
        let path = PathIn lx, tr.home, "{Camel (BareName cls)}::{Snake m}"
        VlOwned (XCall path, (Each args, \|a| Argument lx, env, a.value)), t

let dummyTraitInfo = TraitInfo(name="", home="", param="a", supers=[[]], methods=[[]], defaults=[[]], assocs=[[]], file=0, span=Range(start=0, end=0))

PreludeMethod: unbounded fn Lx, Text, Text, [Vl], Range, RsTy -> Vl
fn PreludeMethod lx, cls, m, vals, span, t:
    let a = Or vals[0], (VlOwned (XRaw "()"), RsUnit)
    let b = Or vals[1], (VlOwned (XRaw "()"), RsUnit)
    match m:
        "Show": VlOwned (XCall "show_text", [[Ref a]]), RsText
        "Compare": VlOwned (XCall "compare", [[Ref a, Ref b]]), t
        "Children": VlOwned (XCall "children", [[Ref a]]), t
        otherwise: OpValue lx, m, a, b, span, t

# A binary operator.
BinaryValue: unbounded fn Lx, Env, Text, Expr, Expr, Range -> Vl
fn BinaryValue lx, env, op, l, r, span:
    let t = RustTy lx, (Peel (TypeAt lx, span))
    match op:
        "and": VlOwned (XBin "&&", (AsBool (ValueOf lx, env, l)), (AsBool (ValueOf lx, env, r))), RsBool
        "or": VlOwned (XBin "||", (AsBool (ValueOf lx, env, l)), (AsBool (ValueOf lx, env, r))), RsBool
        # In a function lifted over an event (`fn !Bump $n, !go = $n + 1 on !go`), the
        # function runs at the event's firing, so `x on !e` is `x` read there.
        "on": ValueOf lx, env, l
        otherwise: OpValue lx, op, (ValueOf lx, env, l), (ValueOf lx, env, r), span, t

# An operator over two values of the left one's type (Type System ch. 3: `^Eq`, `^Ord`,
# `^Num` on the built-in numbers; `/` gives `?a` on the integers, doubt QD).
OpValue: fn Lx, Text, Vl, Vl, Range, RsTy -> Vl
fn OpValue lx, op, a, b, span, t:
    let at = ValueTy a
    let generic = match at:
        RsGen ignore: True
        otherwise: False
    if HasText [["==", "!=", "<", "<=", ">", ">="]], op: VlOwned (XBin op, (Ref a), (Ref b)), RsBool
    else: if op == "mod": VlOwned (XMethod (Ref a), "modulo", [[Ref b]]), t
    else: if generic: VlOwned (XCall "Num::{NumMethod op}", [[Ref a, Ref b]]), t
    else: if op == "/":
        if at == RsFloat: VlOwned (XBin "/", (Copy a), (Copy b)), t
        else: VlOwned (XMethod (Ref a), "div", [[Ref b]]), t
    else: if op == "-?":
        if at == RsNat: VlOwned (XMethod (Ref a), "checked_sub", [[Ref b]]), t
        else: VlOwned (XCtor "Some", [[(XBin "-", (Ref a), (Ref b))]]), t
    else: if op == "+?": VlOwned (XCtor "Some", [[(XBin "+", (Ref a), (Ref b))]]), t
    else: if op == "*?": VlOwned (XCtor "Some", [[(XBin "*", (Ref a), (Ref b))]]), t
    else: if IsCopy at: VlOwned (XBin op, (Copy a), (Copy b)), t
    else: VlOwned (XBin op, (Ref a), (Ref b)), t

NumMethod: fn Text -> Text
fn NumMethod "+" = "add"
fn NumMethod "-" = "sub"
fn NumMethod "*" = "mul"
fn NumMethod "/" = "div_opt"
fn NumMethod "+?" = "add_opt"
fn NumMethod "-?" = "sub_opt"
fn NumMethod "*?" = "mul_opt"
fn NumMethod other = "add"

# A prelude function (prelude.prism; its Rust is templates/prelude.prism): borrowed
# arguments, the variant for a text or a map where one name serves several (doubt LZ).
PreludeCall: unbounded fn Lx, Env, Text, [Arg], Range, RsTy -> Vl
fn PreludeCall lx, env, qk, args, span, t:
    let name = Or lx.rsNames[qk], (Snake (BareName qk))
    let first = match args[0]:
        ? a: RustTy lx, (Peel (TypeAt lx, a.value.span))
        nil: RsUnit
    let variant = PreludeVariant name, first
    match ?PreludeJob lx, env, variant, args:
        ? job: VlOwned (XCall "run_to_end", [[job]]), t
        nil: VlOwned (XCall variant, (Each args, \|a| Argument lx, env, a.value)), t

# D8 in the back end: `Fold`, `Each` and `Filter` given a closure that is not bounded are
# the prelude's job versions (`fold_job`), the closure a `Start`: each call it makes is a
# call of an unbounded function, a cycle point inside a job (D6). Direct-style code runs
# the job to its result; a job makes it a frame or a tail call. The arguments owned.
?PreludeJob: unbounded fn Lx, Env, Text, [Arg] -> ?Ex
fn ?PreludeJob lx, env, variant, args:
    if HasText [["fold", "fold_map", "each", "each_map", "filter", "filter_map"]], variant:
        let last = Or args[Dec (Len args)], (Arg(name=nil, value=dummyExpr, span=Range(start=0, end=0)))
        match RustTy lx, (Peel (TypeAt lx, last.value.span)):
            RsJobFn ignore, ignore:
                let front = Each (Take args, (Dec (Len args))), \|a| Own (ValueOf lx, env, a.value)
                ? (XCall "{variant}_job", (Push front, (AsJobValue lx, env, last.value)))
            otherwise: nil
    else: nil

# A call of a prelude function that is a job here (`?PreludeJob`).
?PreludeJobCall: unbounded fn Lx, Env, Expr -> ?Ex
fn ?PreludeJobCall lx, env, e = match e.kind:
    ECall c, args, ignore, ignore: match c.kind:
        EName n:
            if (Len n.path) == 1 and HasKey env.names, (SNameKey n): nil
            else:
                let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
                match ?qk:
                    ? qk: match lx.g.vals[qk]:
                        ? v:
                            if v.home == "Prelude":
                                let name = Or lx.rsNames[qk], (Snake (BareName qk))
                                let first = match args[0]:
                                    ? a: RustTy lx, (Peel (TypeAt lx, a.value.span))
                                    nil: RsUnit
                                ?PreludeJob lx, env, (PreludeVariant name, first), args
                            else: nil
                        nil: nil
                    nil: nil
        otherwise: nil
    otherwise: nil

# A value where a `Start` is wanted (an unbounded or color-polymorphic parameter): a
# lambda is a job lambda, a `Start` is itself, and a bounded function value is wrapped
# in a job that answers in its first cycle.
AsJobValue: unbounded fn Lx, Env, Expr -> Ex
fn AsJobValue lx, env, e = match e.kind:
    EGroup x: AsJobValue lx, env, x
    otherwise:
        let target = match Peel (TypeAt lx, e.span):
            TyFn ignore, ps, r: RsJobFn (RustTyOfParams lx, ps), (RustTy lx, r)
            other: RustTy lx, other
        let a = match target:
            RsJobFn x, ignore: x
            otherwise: RsUnit
        match e.kind:
            ELambda ?ps, body: Own (JobLambda lx, env, (Or ?ps, [[]]), body, target, a, (EntersLambda lx, e))
            otherwise:
                let v = ValueOf lx, env, e
                match ValueTy v:
                    RsFn pts, ignore: WrapAsJob (Own v), pts, target, a
                    otherwise: Own v

# A bounded function value as a `Start`: its job answers in its first cycle.
WrapAsJob: fn Ex, [RsTy], RsTy, RsTy -> Ex
fn WrapAsJob f, pts, target, a:
    let names = Each (Range0 (Len pts)), \|i| "a{i}"
    let pa = if (Len pts) == 1: PaTyped (PaBind "a0"), a else: PaTyped (PaTuple (Each names, \|nm| PaBind nm)), a
    let call = XApply (XRaw "f"), (Each names, \|nm| XUnary "&", (XRaw nm))
    let body = XBlock [[(DoLet (PaBind "f"), (XMethod (XRaw "f"), "clone", [[]]))]], (XCall "once_job", [[(XClosure True, [[]], (XCtor "prism_rtl::Turn::Finished", [[call]]))]])
    XBlock [[(DoLet (PaBind "f"), f)]], (XCast (XCall "Rc::new", [[(XClosure True, [[pa]], body)]]), target)

# A named function's arguments, owned, as its job's fields take them: a function
# parameter that is not bounded takes a `Start`.
NamedArgsOwned: unbounded fn Lx, Env, Text, [Arg] -> [Ex]
fn NamedArgsOwned lx, env, qk, args:
    let ((ps, ignore)) = SchemeParts lx, qk
    Each (Range0 (Len args)), \|i|
        let a = Or args[i], (Arg(name=nil, value=dummyExpr, span=Range(start=0, end=0)))
        match Peel (Or ps[i], TyErr):
            TyFn CBound, ignore, ignore: Own (ValueOf lx, env, a.value)
            TyFn ignore, ignore, ignore: AsJobValue lx, env, a.value
            otherwise: Own (ValueOf lx, env, a.value)

# A `Start` value's arguments, owned: one whose parameter type is a `Start` is made one.
StartArgs: unbounded fn Lx, Env, Vl, [Arg] -> [Ex]
fn StartArgs lx, env, f, args:
    let pts = match ValueTy f:
        RsJobFn (RsTuple ts), ignore: if (Len args) == 1: [[RsTuple ts]] else: ts
        RsJobFn a, ignore: [[a]]
        otherwise: [[]]
    Each (Range0 (Len args)), \|i|
        let a = Or args[i], (Arg(name=nil, value=dummyExpr, span=Range(start=0, end=0)))
        match Or pts[i], RsUnit:
            RsJobFn ignore, ignore: AsJobValue lx, env, a.value
            otherwise: Own (ValueOf lx, env, a.value)

PreludeVariant: fn Text, RsTy -> Text
fn PreludeVariant name, first = match first:
    RsText: if HasText [["len", "take", "drop"]], name: "{name}_text" else: name
    RsMap ignore, ignore: if HasText [["len", "fold", "each", "filter"]], name: "{name}_map" else: name
    otherwise: name

# `r.field`: a place when `r` is one (Type System ch. 1, "Sigils on fields": `r.?f` reads
# the same field).
FieldValue: unbounded fn Lx, Env, Expr, Text -> Vl
fn FieldValue lx, env, r, name:
    let rv = ValueOf lx, env, r
    let rty = Peel (TypeAt lx, r.span)
    let ((ft, rc)) = FieldInfo lx, rty, name
    let f = Snake name
    let mode = if rc: RcOwned else: Owned
    match rv:
        VlPlace x, ignore, ignore: VlPlace (XField x, f), mode, ft
        VlOwned x, ignore: VlPlace (XField x, f), mode, ft

# A record field's Rust type and whether it is behind an `Rc`.
FieldInfo: unbounded fn Lx, Ty, Text -> ((RsTy, Bool))
fn FieldInfo lx, rty, name = match rty:
    TyCon n, args: match lx.g.ctors[n]:
        ? c:
            let ?fix = Fold (Range0 (Len c.fields)), nil, \|?found, i| if (Or c.fields[i], "") == name: ? i else: ?found
            match ?fix:
                ? i:
                    let ft = Or c.args[i], TyErr
                    let inst = Instantiated ft, c.params, args
                    (((RustTy lx, inst), (RcField lx, c.name, i)))
                nil: (((RsUnknown "a field {name}"), False))
        nil: (((RsUnknown "a field {name}"), False))
    otherwise: (((RsUnknown "a field {name} of a non-record"), False))

# A field's declared type with the record's parameters replaced by its arguments.
Instantiated: unbounded fn Ty, [Text], [Ty] -> Ty
fn Instantiated t, params, args = match t:
    TyQ q:
        let ?hit = Fold (Range0 (Len params)), nil, \|?found, i| if (Or params[i], "") == q: args[i] else: ?found
        Or ?hit, t
    TyCon n, xs: TyCon n, (Each xs, \|x| Instantiated x, params, args)
    TyFn c, ps, res: TyFn c, (Each ps, \|x| Instantiated x, params, args), (Instantiated res, params, args)
    TyTuple ts: TyTuple (Each ts, \|x| Instantiated x, params, args)
    TyArray e: TyArray (Instantiated e, params, args)
    TyMap k, v: TyMap (Instantiated k, params, args), (Instantiated v, params, args)
    TySig s, i: TySig s, (Instantiated i, params, args)
    otherwise: t

# `xs[i]`: an optional, of an array, a map or a text.
IndexValue: unbounded fn Lx, Env, Expr, Expr, RsTy -> Vl
fn IndexValue lx, env, r, i, t:
    let rt = RustTy lx, (Peel (TypeAt lx, r.span))
    let f = match rt:
        RsMap ignore, ignore: "get"
        RsText: "index_text"
        otherwise: "index"
    VlOwned (XCall f, [[(Argument lx, env, r), (Argument lx, env, i)]]), (RsOpt t)

# The names an expression or block reads, for a closure's captures.
ReadNames: unbounded fn [Expr] -> [Text]
fn ReadNames es = Fold es, [[]], \|acc, x| match x.kind:
    EName n: if (Len n.path) == 1: AddText acc, (SNameKey n) else: acc
    otherwise: acc

LambdaExprs: unbounded fn LambdaBody -> [Expr]
fn LambdaExprs (LbExpr x) = ExprsIn x
fn LambdaExprs (LbBlock b) = BlockExprs b

# A lambda as a value: `Rc::new(move |..| ..)`, its captures cloned in first
# (docs/backend.md, "`fn a -> b` as a value").
LambdaValue: unbounded fn Lx, Env, Expr, [Pattern], LambdaBody -> Vl
fn LambdaValue lx, env, e, ps, body:
    let ft = RustTy lx, (Peel (TypeAt lx, e.span))
    match ft:
        RsJobFn a, ignore: JobLambda lx, env, ps, body, ft, a, (EntersLambda lx, e)
        otherwise: PlainLambda lx, env, ps, body, ft

PlainLambda: unbounded fn Lx, Env, [Pattern], LambdaBody, RsTy -> Vl
fn PlainLambda lx, env, ps, body, ft:
    let pts = match ft:
        RsFn xs, ignore: xs
        otherwise: [[]]
    let read = ReadNames (LambdaExprs body)
    let caps0 = Filter read, \|n| match env.names[n]:
        ? (BnLocal ignore, ignore, ignore): True
        otherwise: False
    # An event the body reads as a value is its port, captured too; a hold or dynamic `let`
    # the body reads has its value at the build captured, for a supplier's dynamic answer
    # (round 3 DY).
    let caps = Append (Append caps0, (Filter (Each read, \|n| "{n}#port"), \|n| HasKey env.names, n)), (Filter (Each read, \|n| "{n}#init"), \|n| HasKey env.names, n)
    let ((dos, env1)) = Fold caps, (([[]], env)), \|((acc, en)), n| match env.names[n]:
        ? (BnLocal rs, mode, ct):
            let local = if (Take rs, 5) == "self.": Drop rs, 5 else: rs
            let d = DoLet (PaBind local), (Own (LocalPlace rs, mode, ct))
            (((Push acc, d), (Bind en, n, (BnLocal local, Owned, ct))))
        otherwise: ((acc, en))
    let ((pas, env2)) = ClosureParams lx, env1, ps, pts, True
    let v = LambdaBodyValue lx, env2, body
    VlOwned (XBlock dos, (XCall "Rc::new", [[(XClosure True, pas, (Own v))]])), ft

# A lambda's parameter types, written on the closure so that rustc need not infer them
# from its use (`fold(&xs, &None, &(|found: &Option<T>, x: &A| ..))`); none when one is
# not known.
LambdaParamTys: unbounded fn Lx, Expr, Nat -> [RsTy]
fn LambdaParamTys lx, e, n:
    let ts = match RustTy lx, (Peel (TypeAt lx, e.span)):
        RsFn xs, ignore: xs
        RsJobFn a, ignore: match a:
            RsTuple xs: if n == 1: [[a]] else: xs
            otherwise: [[a]]
        otherwise: [[]]
    if (Len ts) == n and Fold ts, True, \|ok, t| ok and IsKnownTy t: ts else: [[]]

IsKnownTy: unbounded fn RsTy -> Bool
fn IsKnownTy t = match t:
    RsUnknown ignore: False
    RsOpt x: IsKnownTy x
    RsRes x: IsKnownTy x
    RsArray x: IsKnownTy x
    RsRc x: IsKnownTy x
    RsMap k, v: (IsKnownTy k) and IsKnownTy v
    RsTuple xs: Fold xs, True, \|ok, x| ok and IsKnownTy x
    RsNamed ignore, xs: Fold xs, True, \|ok, x| ok and IsKnownTy x
    RsFn xs, r: (Fold xs, True, \|ok, x| ok and IsKnownTy x) and IsKnownTy r
    RsJobFn a, b: (IsKnownTy a) and IsKnownTy b
    otherwise: True

# A lambda of unbounded type as a value: a `Start` like a named unbounded function's
# (docs/backend.md), `Rc<dyn Fn(A) -> Rc<dyn Job<B>>>`, whose job is the lambda's body
# lowered as a job body (`once_job`): a call in it is a tail call or a frame, as in any
# job. The arguments come as one value, a tuple when there are several; each borrowed
# local the body reads is cloned in, and cloned again per call, since the body's job
# owns what it reads. A lambda whose own type is not bounded is `entered`: a call of it is
# a cycle point however it is reached (D6); a bounded lambda given where a `Start` is
# wanted answers in its first cycle.
JobLambda: unbounded fn Lx, Env, [Pattern], LambdaBody, RsTy, RsTy, Bool -> Vl
fn JobLambda lx, env, ps, body, ft, a, enter:
    let caps = Filter (ReadNames (LambdaExprs body)), \|n| match env.names[n]:
        ? (BnLocal ignore, ignore, ignore): True
        otherwise: False
    let ((dos, env1)) = Fold caps, (([[]], env)), \|((acc, en)), n| match env.names[n]:
        ? (BnLocal rs, mode, ct):
            let d = DoLet (PaBind rs), (Own (LocalPlace rs, mode, ct))
            (((Push acc, d), (Bind en, n, (BnLocal rs, Owned, ct))))
        otherwise: ((acc, en))
    let again = Fold caps, [[]], \|acc, n| match env1.names[n]:
        ? (BnLocal rs, ignore, ct): Push acc, (DoLet (PaBind rs), (Own (LocalPlace rs, Owned, ct)))
        otherwise: acc
    let pts = match a:
        RsTuple ts: if (Len ps) == 1: [[a]] else: ts
        otherwise: [[a]]
    # The body sees what it captured and its parameters, nothing borrowed from outside.
    let env1b = OnlyCaptured env1, caps
    # Each parameter arrives owned as `p{i}` and is taken apart in the body by its
    # pattern (`\|((en, s)), stmt|`), as any `let` would.
    let pos = Each (Range0 (Len ps)), \|i|
        let p = Or ps[i], dummyPat
        RustPat lx, p, (BinderTyOfPattern lx, p), Owned, "p{i}_"
    let unpack = Fold (Range0 (Len pos)), [[]], \|acc, i| match pos[i]:
        ? po: Append (Push acc, (DoLet po.pa, (XRaw "p{i}"))), (Each po.conds, \|c| CondAsLet c)
        nil: acc
    # A name parameter's type is the `Start`'s (a function parameter is a `Start` there).
    let pos2 = Each (Range0 (Len pos)), \|i| match pos[i]:
        ? po: match (Or ps[i], dummyPat).kind:
            PName ignore: update po:
                &_.binds <= Each &_.binds, \|((n, b))| match b:
                    BnLocal rs, mode, bt: ((n, (BnLocal rs, mode, (Or pts[i], bt))))
                    otherwise: ((n, b))
            otherwise: po
        nil: PatOut(pa=PaWild, conds=[[]], binds=[[]])
    let env2 = Fold pos2, env1b, \|en, po| BindAll en, po.binds
    let names = Each (Range0 (Len ps)), \|i| "p{i}"
    let pa = if (Len ps) == 1: PaTyped (PaBind "p0"), a else: PaTyped (PaTuple (Each names, \|nm| PaBind nm)), a
    let tail0 = match body:
        LbExpr x: Tail lx, env2, x
        LbBlock bl: TailBlock lx, env2, bl
    let tail = if (Len unpack) == 0: tail0 else: XBlock unpack, tail0
    let job0 = XCall "once_job", [[(XClosure True, [[]], tail)]]
    let job = if enter or CallsUnbounded lx, env2, body: XCall "entered", [[job0]] else: job0
    let call = if (Len again) == 0: job else: XBlock again, job
    VlOwned (XBlock dos, (XCast (XCall "Rc::new", [[(XClosure True, [[pa]], call)]]), ft)), ft

# Whether a lambda's own checked type is not bounded (unbounded, or a color variable):
# entering it is a cycle point (D6).
EntersLambda: fn Lx, Expr -> Bool
fn EntersLambda lx, e = match Peel (TypeAt lx, e.span):
    TyFn CBound, ignore, ignore: False
    TyFn ignore, ignore, ignore: True
    otherwise: False

# Whether a lambda's body calls an unbounded function (a callee whose checked type is
# unbounded, or a local that is a `Start`): such a lambda is unbounded whatever color the
# checker left on the lambda itself, which it fixes before a parameter's type is known
# (`\|ignore| K v` with `K` a `Start`).
CallsUnbounded: unbounded fn Lx, Env, LambdaBody -> Bool
fn CallsUnbounded lx, env, body = Fold (LambdaExprs body), False, \|seen, x| seen or IsUnboundedCall lx, env, x

IsUnboundedCall: fn Lx, Env, Expr -> Bool
fn IsUnboundedCall lx, env, x = match x.kind:
    ECall c, ignore, ignore, ignore: (IsUnboundedTy (TypeAt lx, c.span)) or IsStartLocal env, c
    otherwise: False

IsUnboundedTy: fn Ty -> Bool
fn IsUnboundedTy t = match Peel t:
    TyFn CUnbound, ignore, ignore: True
    otherwise: False

IsStartLocal: fn Env, Expr -> Bool
fn IsStartLocal env, c = match c.kind:
    EName n: if (Len n.path) == 1: IsStartBinding env.names[SNameKey n] else: False
    EGroup y: IsStartLocal env, y
    otherwise: False

IsStartBinding: fn ?Bn -> Bool
fn IsStartBinding ?b = match ?b:
    ? (BnLocal ignore, ignore, (RsJobFn ignore, ignore)): True
    otherwise: False

# An environment of only the locals a closure captured (its other borrowed locals cannot
# live in it); holds, dynamics and events stay.
OnlyCaptured: fn Env, [Text] -> Env
fn OnlyCaptured env, caps = update env:
    &_.names <= Fold (Keys env.names), {}, \|m, k| match env.names[k]:
        ? (BnLocal rs, mode, t): if (HasText caps, k) or mode == Owned: Insert m, k, (BnLocal rs, mode, t) else: m
        ? b: Insert m, k, b
        nil: m

# A condition a closure parameter's pattern leaves (a payload behind an `Rc`), as a
# `let` in the body: a parameter's pattern is irrefutable, so it holds.
CondAsLet: fn Cc -> Do
fn CondAsLet (CcLet pa, x) = DoLet pa, x
fn CondAsLet (CcIf x) = DoExpr (XRaw "()")

# A lambda passed to a parameter: a borrowed closure, its types from the parameter.
LambdaArg: unbounded fn Lx, Env, [Pattern], LambdaBody, [RsTy] -> Ex
fn LambdaArg lx, env, ps, body, pts:
    let ((pas, env2)) = ClosureParams lx, env, ps, pts, (Len pts) > 0
    let v = LambdaBodyValue lx, env2, body
    XClosure False, pas, (Own v)

LambdaBodyValue: unbounded fn Lx, Env, LambdaBody -> Vl
fn LambdaBodyValue lx, env, (LbExpr x) = ValueOf lx, env, x
fn LambdaBodyValue lx, env, (LbBlock b) = BlockValue lx, env, b

# Closure parameters: irrefutable patterns, each a reference; typed when the closure is
# a value.
ClosureParams: unbounded fn Lx, Env, [Pattern], [RsTy], Bool -> (([Pa], Env))
fn ClosureParams lx, env, ps, pts, typed = Fold (Range0 (Len ps)), (([[]], env)), \|((acc, en)), i| match ps[i]:
    ? p:
        let po = RustPat lx, p, (BinderTyOfPattern lx, p), ByRef, "a{p.span.start}"
        let en2 = BindAll en, po.binds
        let pa = if typed: PaTyped po.pa, (RsRef (Or pts[i], (RsUnknown "a parameter"))) else: po.pa
        (((Push acc, pa), en2))
    nil: ((acc, en))

BindAll: fn Env, [((Text, Bn))] -> Env
fn BindAll env, bs = Fold bs, env, \|en, ((n, b))| Bind en, n, b

# A pattern's type, as the checker recorded it for its binder or the pattern.
BinderTyOfPattern: fn Lx, Pattern -> Ty
fn BinderTyOfPattern lx, p = match p.kind:
    PName n: BinderTy lx, n.span
    otherwise: TypeAt lx, p.span

# `if c: a else: b`, and `if p <- e: ..` as a `match`.
IfValue: unbounded fn Lx, Env, Cond, Block, ?Block, RsTy -> Vl
fn IfValue lx, env, c, thenB, ?elseB, t:
    let elseV = match ?elseB:
        ? b: OwnAs t, (BlockValue lx, env, b)
        nil: XRaw "()"
    match c:
        CondExpr x: VlOwned (XIf (AsBool (ValueOf lx, env, x)), (OwnAs t, (BlockValue lx, env, thenB)), elseV), t
        CondBind p, x, ?g:
            let sv = ValueOf lx, env, x
            let po = RustPat lx, p, (TypeAt lx, x.span), ByRef, "c{x.span.start}"
            let env2 = BindAll env, po.binds
            let guard = match ?g:
                ? ge: [[CcIf (AsBool (ValueOf lx, env2, ge))]]
                nil: [[]]
            let arm = XArm(pat=po.pa, conds=(Append po.conds, guard), body=(OwnAs t, (BlockValue lx, env2, thenB)))
            let other = XArm(pat=PaWild, conds=[[]], body=elseV)
            ArmsValue (Ref sv), [[arm, other]], "c{x.span.start}", t

# A `match` or an if-let chain over arms: `match` when every condition is a guard, the
# chain when one goes through an `Rc` (a Rust pattern cannot).
ArmsValue: fn Ex, [XArm], Text, RsTy -> Vl
fn ArmsValue scrut, arms, label, t:
    let chain = Fold arms, False, \|f, a| f or Fold a.conds, False, \|f2, c| f2 or IsLetCond c
    let guarded = Fold arms, False, \|f, a| f or (Len a.conds) > 0
    if chain: VlOwned (XChain label, scrut, arms), t
    else: VlOwned (XMatch scrut, arms, guarded), t

IsLetCond: fn Cc -> Bool
fn IsLetCond (CcLet ignore, ignore) = True
fn IsLetCond (CcIf ignore) = False

# `match s: arms` (a plain `match`; widget blocks lower theirs in the block's node).
MatchValue: unbounded fn Lx, Env, Expr, [Arm], RsTy, Range -> Vl
fn MatchValue lx, env, s, arms, t, span:
    let sv = ValueOf lx, env, s
    let sty = TypeAt lx, s.span
    let label = "m{span.start}"
    let byRef = Each (Range0 (Len arms)), \|i| ArmPat lx, (Or arms[i], dummyArm).?pattern, sty, ByRef, "{label}_{i}"
    let chain = Fold byRef, False, \|f, po| f or Fold po.conds, False, \|f2, c| f2 or IsLetCond c
    let owned = match sv:
        VlOwned ignore, ignore: not chain
        otherwise: False
    let pats = if owned: Each (Range0 (Len arms)), \|i| ArmPat lx, (Or arms[i], dummyArm).?pattern, sty, Owned, "{label}_{i}" else: byRef
    let xarms = Each (Range0 (Len arms)), \|i|
        let arm = Or arms[i], dummyArm
        let po = Or pats[i], (PatOut(pa=PaWild, conds=[[]], binds=[[]]))
        let env2 = BindAll env, po.binds
        let guard = match arm.?guard:
            ? ge: [[CcIf (AsBool (ValueOf lx, env2, ge))]]
            nil: [[]]
        XArm(pat=po.pa, conds=(Append po.conds, guard), body=(Own (BlockValue lx, env2, arm.body)))
    let scrut = if owned: Own sv else: Ref sv
    ArmsValue scrut, xarms, label, t

let dummyArm = Arm(pattern=nil, guard=nil, body=Block(stmts=[[]], inline=True, span=Range(start=0, end=0)), span=Range(start=0, end=0))

ArmPat: unbounded fn Lx, ?Pattern, Ty, Holding, Text -> PatOut
fn ArmPat lx, (? p), ty, mode, fresh = RustPat lx, p, ty, mode, fresh
fn ArmPat lx, nil, ty, mode, fresh = PatOut(pa=PaWild, conds=[[]], binds=[[]])

# A block of `let`s and a last expression, in page order (gap DG of the README: the
# group's dependency order is the checker's to give).
BlockValue: unbounded fn Lx, Env, Block -> Vl
fn BlockValue lx, env, b = if IsGivenBlock b.stmts: GivenValue lx, env, b, (BlockTy lx, b), b.span else: PlainBlockValue lx, env, b

# A block of binds and guards is a `given:` (Semantics ch. 4), whether or not the word is
# written: a function's body may be one.
IsGivenBlock: fn [Stmt] -> Bool
fn IsGivenBlock stmts = Fold stmts, False, \|f, s| f or IsGuardish s

IsGuardish: fn Stmt -> Bool
fn IsGuardish s = match s.kind:
    SBind ignore, ignore, nil: True
    SRequire ignore: True
    SForbid ignore: True
    otherwise: False

BlockTy: unbounded fn Lx, Block -> RsTy
fn BlockTy lx, b = match (Or b.stmts[Dec (Len b.stmts)], dummyStmtL).kind:
    SExpr x: RustTy lx, (Peel (TypeAt lx, x.span))
    otherwise: RsUnit

PlainBlockValue: unbounded fn Lx, Env, Block -> Vl
fn PlainBlockValue lx, env, b:
    let n = Len b.stmts
    let ((dos, env2, ?last)) = Fold (Range0 n), (([[]], env, nil)), \|((acc, en, ?lv)), i|
        let s = Or b.stmts[i], dummyStmtL
        if i + 1 == n: match s.kind:
            SExpr x: ((acc, en, ? (ValueOf lx, en, x)))
            otherwise:
                let ((more, en2)) = BlockStmt lx, en, s
                (((Append acc, more), en2, nil))
        else:
            let ((more, en2)) = BlockStmt lx, en, s
            (((Append acc, more), en2, ?lv))
    let last = Or ?last, (VlOwned (XRaw "()"), RsUnit)
    if (Len dos) == 0: last
    else: VlOwned (XBlock dos, (Own last)), (ValueTy last)

let dummyStmtL = Stmt(kind=(SExpr (Expr(kind=EError, span=Range(start=0, end=0)))), span=Range(start=0, end=0))

# One statement of an expression block.
BlockStmt: unbounded fn Lx, Env, Stmt -> (([Do], Env))
fn BlockStmt lx, env, s = match s.kind:
    SLet p, ignore, x:
        let v = ValueOf lx, env, x
        let po = RustPat lx, p, (TypeAt lx, x.span), Owned, "l{s.span.start}"
        (([[(DoLet po.pa, (Own v))]], (BindAll env, po.binds)))
    SExpr x: (([[DoExpr (Own (ValueOf lx, env, x))]], env))
    SSignature ignore: (([[]], env))
    SFn f: (([[RefusalDo "a local function {DefNameText f.name}: not lowered yet"]], env))
    otherwise: (([[RefusalDo "a statement this back end does not lower yet"]], env))

# ---------------------------------------------------------------------------------------
# Patterns: a Rust pattern, the conditions after it, and the names it binds
# ---------------------------------------------------------------------------------------

type PatOut = record:
    pa: Pa
    conds: [Cc]
    binds: [((Text, Bn))]

PatOnly: fn Pa -> PatOut
fn PatOnly pa = PatOut(pa=pa, conds=[[]], binds=[[]])

# A pattern against a scrutinee of checker type `ty`, matched by reference (`ref`: its
# binders are references) or by value (`own`). `fresh` names the binders a condition
# needs.
RustPat: unbounded fn Lx, Pattern, Ty, Holding, Text -> PatOut
fn RustPat lx, p, ty, mode, fresh = match p.kind:
    PName n:
        let nkey = SNameKey n
        let ((?qk, why)) = ResolveValue lx.g, lx.home, n
        let isCtor = match ?qk:
            ? qk: (HasKey lx.g.ctors, qk) and ((IsUpperText (Base nkey)) or (Len n.path) > 1 or IsUnitCtor lx, qk)
            nil: False
        let ?tagged = match ?qk:
            ? qk: lx.g.tags[qk]
            nil: nil
        if isCtor: CtorPat lx, n, [[]], ty, mode, fresh
        else: if why == "tag" and ?tagged != nil: TagPat lx, (Or ?tagged, dummyTagInfo), [[]], True, ty, mode, fresh
        else:
            let rs = LocalName lx, nkey
            let bt = RustTy lx, (Peel (BinderTy lx, n.span))
            PatOut(pa=(PaBind rs), conds=[[]], binds=[[((nkey, (BnLocal rs, mode, bt)))]])
    PIgnore: PatOnly PaWild
    PUnit: PatOnly PaWild
    PNil: PatOnly (PaUnit "None")
    PLit l: LitPat lx, l, ty, mode, fresh, False
    PNeg l: LitPat lx, l, ty, mode, fresh, True
    PSigil "?", q: WrapPat lx, "Some", q, (InnerTy ty), mode, fresh
    PSigil "~", q: WrapPat lx, "Ok", q, (InnerTy ty), mode, fresh
    PSigil ignore, q: RustPat lx, q, ty, mode, fresh
    PGroup q: RustPat lx, q, ty, mode, fresh
    PCtor n, ps: CtorPat lx, n, ps, ty, mode, fresh
    PRecord n, fps, rest: RecordPat lx, n, fps, rest, ty, mode, fresh
    PTuple ps:
        let ts = match Peel ty:
            TyTuple xs: xs
            otherwise: [[]]
        let subs = Each (Range0 (Len ps)), \|i| RustPat lx, (Or ps[i], dummyPat), (Or ts[i], TyErr), mode, "{fresh}_{i}"
        PatOut(pa=(PaTuple (Each subs, \|o| o.pa)), conds=(Fold subs, [[]], \|acc, o| Append acc, o.conds), binds=(Fold subs, [[]], \|acc, o| Append acc, o.binds))
    PArray ps: ArrayPat lx, ps, ty, mode, fresh
    PFamily q: FamilyPat lx, q, ty, fresh

let dummyPat = Pattern(kind=PIgnore, span=Range(start=0, end=0))

InnerTy: fn Ty -> Ty
fn InnerTy t = match Peel t:
    TySig "?", i: i
    TySig "~", i: i
    otherwise: TyErr

# Whether a constructor is a unit type's value (`click`), which a lowercase name may name.
IsUnitCtor: fn Lx, Text -> Bool
fn IsUnitCtor lx, qk = match lx.g.ctors[qk]:
    ? c: match (Or lx.g.types[c.owner], dummyTyInfo).body:
        BChoice [[((ignore, [[]]))]]: IsLowerText (BareName qk)
        otherwise: False
    nil: False

WrapPat: unbounded fn Lx, Text, Pattern, Ty, Holding, Text -> PatOut
fn WrapPat lx, ctor, q, inner, mode, fresh:
    let o = RustPat lx, q, inner, mode, fresh
    update o:
        &_.pa <= PaCtor ctor, [[&_.pa]]

# A literal: a fresh binder and an equality after it (a number or a text is no Rust
# literal pattern).
LitPat: unbounded fn Lx, Literal, Ty, Holding, Text, Bool -> PatOut
fn LitPat lx, l, ty, mode, fresh, neg:
    let t = RustTy lx, (Peel ty)
    match l.kind:
        LChar c: PatOnly (PaLit "'{CharEscape c}'")
        otherwise:
            # A number is of the scrutinee's type (a `0` against a `Nat` is a `Nat`), not
            # the type the checker defaulted the literal to.
            let lit = match l.kind:
                LInt d: if t == RsNat or t == RsInt or t == RsU8 or t == RsFloat: VlOwned (Number t, d, neg), t else: LiteralValue lx, emptyEnv, l, l.span, neg
                otherwise: LiteralValue lx, emptyEnv, l, l.span, neg
            let lv = VlOwned (Own lit), t
            let b = LocalPlace fresh, mode, t
            PatOut(pa=(PaBind fresh), conds=[[CcIf (XBin "==", (Ref b), (Ref lv))]], binds=[[]])

# `Ctor p, q`: a choice's case, a newtype, a unit type's value, `True`, a record by
# position. A payload behind an `Rc` matches through a `let` after the pattern.
CtorPat: unbounded fn Lx, SName, [Pattern], Ty, Holding, Text -> PatOut
fn CtorPat lx, n, ps, ty, mode, fresh:
    let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
    match ?qk:
        ? "True": PatOnly (PaLit "true")
        ? "False": PatOnly (PaLit "false")
        ? qk: match lx.g.ctors[qk]:
            ? c:
                let owner = Or lx.g.types[c.owner], dummyTyInfo
                let tyPath = PathIn lx, owner.home, (Camel (BareName c.owner))
                let args = match Peel ty:
                    TyCon ignore, xs: xs
                    otherwise: [[]]
                let subs = Each (Range0 (Len ps)), \|i| SubPat lx, c, i, (Or ps[i], dummyPat), (Instantiated (Or c.args[i], TyErr), c.params, args), mode, "{fresh}_{i}"
                let conds = Fold subs, [[]], \|acc, o| Append acc, o.conds
                let binds = Fold subs, [[]], \|acc, o| Append acc, o.binds
                let pas = Each subs, \|o| o.pa
                match owner.body:
                    BRecord fs: PatOut(pa=(PaRecord tyPath, (Each (Range0 (Len pas)), \|i| (((Snake (Or c.fields[i], "")), (Or pas[i], PaWild)))), ((Len pas) < (Len c.fields))), conds=conds, binds=binds)
                    otherwise:
                        let isUnitType = (Len c.args) == 0 and IsUnitCtor lx, qk
                        let path = if isUnitType: tyPath else: "{tyPath}::{Camel (BareName c.name)}"
                        if (Len c.args) == 0: PatOut(pa=(PaUnit path), conds=[[]], binds=[[]])
                        else: PatOut(pa=(PaCtor path, pas), conds=conds, binds=binds)
            nil: PatOut(pa=PaWild, conds=[[CcIf (Refusal "a pattern of {qk}")]], binds=[[]])
        nil: PatOut(pa=PaWild, conds=[[CcIf (Refusal "a pattern of an unknown constructor")]], binds=[[]])

# A constructor's field `i` in a pattern: through an `Rc`, a binder holds the `Rc` and a
# nested pattern matches behind it in a `let`.
SubPat: unbounded fn Lx, CtorInfo, Nat, Pattern, Ty, Holding, Text -> PatOut
fn SubPat lx, c, i, p, ty, mode, fresh:
    if not (RcField lx, c.name, i): RustPat lx, p, ty, mode, fresh
    else:
        let rcMode = if mode == Owned: RcOwned else: RcRef
        match p.kind:
            PIgnore: PatOnly PaWild
            PName n:
                let o = RustPat lx, p, ty, rcMode, fresh
                match o.pa:
                    PaBind ignore: o
                    otherwise: BehindRc lx, p, ty, rcMode, fresh
            otherwise: BehindRc lx, p, ty, rcMode, fresh

BehindRc: unbounded fn Lx, Pattern, Ty, Holding, Text -> PatOut
fn BehindRc lx, p, ty, rcMode, fresh:
    let inner = RustPat lx, p, ty, ByRef, "{fresh}_r"
    let place = Ref (LocalPlace fresh, rcMode, (RsUnknown "a payload"))
    PatOut(pa=(PaBind fresh), conds=(Append [[(CcLet inner.pa, place)]], inner.conds), binds=inner.binds)

# `Rec(f=p, ..)` (a record) or `Error(kind=K, ..)` (the prelude's error, matched in `~T`
# as `Err`).
RecordPat: unbounded fn Lx, SName, [FieldPat], Bool, Ty, Holding, Text -> PatOut
fn RecordPat lx, n, fps, rest, ty, mode, fresh:
    let ((?qk, why)) = ResolveValue lx.g, lx.home, n
    let qk = Or ?qk, ""
    if qk == "Prelude.Error": ErrorPat lx, fps, ty, mode, fresh
    else: if why == "tag" and HasKey lx.g.tags, qk: TagPat lx, (Or lx.g.tags[qk], dummyTagInfo), fps, rest, ty, mode, fresh
    else: match lx.g.ctors[qk]:
        ? c:
            let owner = Or lx.g.types[c.owner], dummyTyInfo
            let tyPath = PathIn lx, owner.home, (Camel (BareName c.owner))
            let args = match Peel ty:
                TyCon ignore, xs: xs
                otherwise: [[]]
            let subs = Each (Range0 (Len fps)), \|i|
                let fp = Or fps[i], dummyFieldPat
                let fname = match fp.?name:
                    ? id: id.name
                    nil: Or c.fields[i], ""
                let fix = Fold (Range0 (Len c.fields)), i, \|found, j| if (Or c.fields[j], "") == fname: j else: found
                ((Snake fname, (SubPat lx, c, fix, fp.pattern, (Instantiated (Or c.args[fix], TyErr), c.params, args), mode, "{fresh}_{i}")))
            let conds = Fold subs, [[]], \|acc, ((ignore, o))| Append acc, o.conds
            let binds = Fold subs, [[]], \|acc, ((ignore, o))| Append acc, o.binds
            PatOut(pa=(PaRecord tyPath, (Each subs, \|((f, o))| ((f, o.pa))), (rest or (Len subs) < (Len c.fields))), conds=conds, binds=binds)
        nil: match lx.g.tags[qk]:
            ? tg: TagPat lx, tg, fps, rest, ty, mode, fresh
            nil: PatOut(pa=PaWild, conds=[[CcIf (Refusal "a pattern of {qk}")]], binds=[[]])

let dummyFieldPat = FieldPat(name=nil, pattern=dummyPat, span=Range(start=0, end=0))

let dummyTagInfo = TagInfo(name="", family="", kind="", out=TyErr, qs=[[]], rqs=[[]], bounds=[[]], fields=[[]], home="", file=0, span=Range(start=0, end=0))

# Whether a scrutinee is a live element (`Element r o`), whose patterns bind each field
# with its stack, against a document's element or another row's value, plain data.
IsLive: fn Ty -> Bool
fn IsLive t = match Peel t:
    TyElem ignore, ignore: True
    otherwise: False

# A tag's field a pattern names: by name, punned, or by position.
TagFieldName: fn FieldPat, [Text], Nat -> Text
fn TagFieldName fp, names, i = match fp.?name:
    ? id: id.name
    nil: match fp.pattern.kind:
        PName n: if HasText names, (SNameKey n): SNameKey n else: Or names[i], ""
        otherwise: Or names[i], ""

# `Ui.Label(text=$t)`, `Draw.Rect(rect=r, ..)` (pick RV): the enum's variant around the
# tag's struct. On a plain row value or a document's element (`Elem r`, a snapshot, the
# checker's WL) every field is plain, a `$` field its value in that tick. On a live
# element the tag and plain fields match its level at the build, and a `$` field binds
# its dynamic, the element's level over time projected to the field.
TagPat: unbounded fn Lx, TagInfo, [FieldPat], Bool, Ty, Holding, Text -> PatOut
fn TagPat lx, tg, fps, rest, ty, mode, fresh:
    let ((variant, structPath)) = TagPaths lx, tg
    let live = IsLive ty
    let names = Each tg.fields, \|((f, ignore))| f
    let subMode = if live: ByRef else: mode
    let parts = Each (Range0 (Len fps)), \|i|
        let fp = Or fps[i], dummyFieldPat
        let fname = TagFieldName fp, names, i
        let ft = Fold tg.fields, TyErr, \|found, ((f, t))| if f == fname: t else: found
        match LayerOf ft:
            LyEv: ((nil, (PatOut(pa=PaWild, conds=[[CcIf (Refusal "an event field in an element pattern ({tg.name}.{fname})")]], binds=[[]]))))
            LyDyn if live: ((nil, (LiveFieldPat lx, fp.pattern, variant, fname, ft, fresh)))
            otherwise:
                let o = RustPat lx, fp.pattern, (Peel ft), subMode, "{fresh}_{i}"
                ((? (Snake fname), o))
    let fieldPas = Fold parts, [[]], \|acc, ((?f, o))| match ?f:
        ? f: Push acc, ((f, o.pa))
        nil: acc
    let conds = Fold parts, [[]], \|acc, ((ignore, o))| Append acc, o.conds
    let binds = Fold parts, [[]], \|acc, ((ignore, o))| Append acc, o.binds
    let level = PaCtor variant, [[(PaRecord structPath, fieldPas, True)]]
    # the arm names the tag: a `@ x` in it answers with the tag's variant of `crate::Answer`
    let tagged = Push binds, (("#tag", (BnLocal (AnswerVariant tg), Owned, RsUnit)))
    if live: PatOut(pa=(PaBind fresh), conds=(Append [[(CcLet level, (XRaw "&{fresh}.identity"))]], conds), binds=tagged)
    else: PatOut(pa=level, conds=conds, binds=binds)

# A live element's `$` field: a binder takes the field's dynamic, the element's level
# projected (`Dynamic::map`). A plain function is lifted, its `$` values read at the
# caller's read point, which it has no `cx` to read at, so there the binder is refused
# (gap LE); a host's supplier, lowered in its node, binds the dynamic.
LiveFieldPat: unbounded fn Lx, Pattern, Text, Text, Ty, Text -> PatOut
fn LiveFieldPat lx, p, variant, fname, ft, fresh = match p.kind:
    PIgnore: PatOnly PaWild
    PName n:
        let rs = if lx.inNode: LiveProjection fresh, variant, fname else: "compile_error!(\"{loweringRefusal}a live element's `$` field ({fname}) in a plain function, which has no read point (gap LE)\")"
        PatOut(pa=PaWild, conds=[[]], binds=[[((SNameKey n, (BnLocal rs, Owned, (RsDyn (RustTy lx, (Peel ft))))))]])
    PGroup q: LiveFieldPat lx, q, variant, fname, ft, fresh
    otherwise: PatOut(pa=PaWild, conds=[[CcIf (Refusal "a pattern inside a live element's `$` field ({fname})")]], binds=[[]])

LiveProjection: fn Text, Text, Text -> Text
fn LiveProjection fresh, variant, fname = "{fresh}.level.map(move |l| match l \{ {variant}(x) => x.{Snake fname}.clone(), _ => unreachable!() \})"

# `Ui.*`: the scrutinee is one of the family's tags.
FamilyPat: unbounded fn Lx, QualName, Ty, Text -> PatOut
fn FamilyPat lx, q, ty, fresh:
    let fam = Dotted (Filter q.path, \|x| x != "*")
    let kind = match Peel ty:
        TyElem ignore, ignore: "Element"
        TyElemAny ignore: "Element"
        TyCon k, ignore: k
        otherwise: ""
    let tags = Filter (KindTags lx, kind, (Keys lx.rsMods)), \|tg| tg.family == fam
    let alts = Join (Each tags, \|tg| "{VariantOf lx, tg}(..)"), " | "
    let place = if IsLive ty: "{fresh}.identity" else: fresh
    let probe = if alts == "": "false" else: "matches!({place}, {alts})"
    PatOut(pa=(PaBind fresh), conds=[[CcIf (XRaw probe)]], binds=[[]])

# `Error(kind=Fs.NotFound, message=m)`: `Err(e)` and the kind compared after it.
ErrorPat: unbounded fn Lx, [FieldPat], Ty, Holding, Text -> PatOut
fn ErrorPat lx, fps, ty, mode, fresh:
    let e = LocalPlace fresh, mode, RsError
    let parts = Each fps, \|fp|
        let fname = match fp.?name:
            ? id: id.name
            nil: ""
        match fname:
            "kind": match fp.pattern.kind:
                PName k:
                    let ((?kq, ignore)) = ResolveValue lx.g, lx.home, k
                    match ?kq:
                        ? kq: if HasKey lx.g.tags, kq: ((([[CcIf (XBin "==", (XRaw "&*{fresh}.kind"), (XRaw "\"{kq}\""))]]), [[]])) else: (([[]], [[((SNameKey k, (BnLocal "{fresh}.kind", Owned, RsText)))]]))
                        nil: (([[]], [[((SNameKey k, (BnLocal "{fresh}.kind", Owned, RsText)))]]))
                otherwise: (([[]], [[]]))
            "message": match fp.pattern.kind:
                PName m: (([[]], [[((SNameKey m, (BnLocal "{fresh}.message", Owned, RsText)))]]))
                otherwise: (([[]], [[]]))
            otherwise: (([[]], [[]]))
    let wrapped = match Peel ty:
        TySig "~", ignore: PaCtor "Err", [[PaBind fresh]]
        otherwise: PaBind fresh
    PatOut(pa=wrapped, conds=(Fold parts, [[]], \|acc, ((cs, ignore))| Append acc, cs), binds=(Fold parts, [[]], \|acc, ((ignore, bs))| Append acc, bs))

# `[[a, b]]`: the length, then each element by index.
ArrayPat: unbounded fn Lx, [Pattern], Ty, Holding, Text -> PatOut
fn ArrayPat lx, ps, ty, mode, fresh:
    let et = match Peel ty:
        TyArray x: x
        otherwise: TyErr
    let arr = LocalPlace fresh, mode, (RustTy lx, (Peel ty))
    let lenCond = CcIf (XBin "==", (XMethod (Ref arr), "len", [[]]), (XRaw "{Len ps}"))
    let subs = Each (Range0 (Len ps)), \|i| ((i, (RustPat lx, (Or ps[i], dummyPat), et, Owned, "{fresh}_{i}")))
    let conds = Fold subs, [[lenCond]], \|acc, ((i, o))| Append (Push acc, (CcLet (PaCtor "Some", [[o.pa]]), (XCall "index", [[Ref arr, XRaw "&Nat::from({i}u32)"]]))), o.conds
    let binds = Fold subs, [[]], \|acc, ((ignore, o))| Append acc, o.binds
    PatOut(pa=(PaBind fresh), conds=conds, binds=binds)

# ---------------------------------------------------------------------------------------
# Templates, `given:` and `update` blocks
# ---------------------------------------------------------------------------------------

# A code template in a plain function (Templates ch. 2, the function form): its text
# built run by run; a placeholder alone on its line indents its text's lines to its
# column (`place`, the prelude's).
TemplateValue: unbounded fn Lx, Env, Template -> Vl
fn TemplateValue lx, env, tp:
    let start = [[(DoLet (PaBind "mut out"), (XRaw "String::new()"))]]
    let dos = Fold tp.parts, start, \|acc, part| Append acc, (TemplatePartDos lx, env, part)
    VlOwned (XBlock dos, (XCall "Text::from", [[XRaw "out"]])), RsText

TemplatePartDos: unbounded fn Lx, Env, TemplatePart -> [Do]
fn TemplatePartDos lx, env, part = match part:
    TpText t: [[DoExpr (XMethod (XRaw "out"), "push_str", [[XRaw "\"{Escape t}\""]])]]
    TpPlaceholder x, ?col:
        let v = ValueOf lx, env, x
        let column = match ?col:
            ? c: XRaw "Some({c})"
            nil: XRaw "None"
        [[DoExpr (XCall "place", [[XRaw "&mut out", ShownText v, column]])]]
    TpBlock b:
        let v = BlockValue lx, env, b
        if (ValueTy v) == RsUnit: [[DoExpr (Own v)]]
        else: [[DoExpr (XCall "place", [[XRaw "&mut out", ShownText v, XRaw "None"]])]]
    TpCall n, args, ?parts, ignore:
        let plain = SName(sigils=(Drop n.sigils, 1), path=n.path, span=n.span)
        let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
        let ((?qk2, ignore)) = ResolveValue lx.g, lx.home, plain
        let callee = match ?qk:
            ? q: ValuePath lx, q
            nil: match ?qk2:
                ? q: ValuePath lx, q
                nil: Snake (SNameKey n)
        let body = match ?parts:
            ? ps:
                let inner = Fold ps, [[(DoLet (PaBind "mut out"), (XRaw "String::new()"))]], \|acc, p| Append acc, (TemplatePartDos lx, env, p)
                [[(XUnary "&", (XBlock inner, (XCall "Text::from", [[XRaw "out"]])))]]
            nil: [[]]
        let passed = match ?qk:
            ? q: TemplateArgs lx, env, q, args, body
            nil: match ?qk2:
                ? q: TemplateArgs lx, env, q, args, body
                nil: Append (Each args, \|a| Argument lx, env, a.value), body
        let call = XCall callee, passed
        [[DoExpr (XCall "place", [[XRaw "&mut out", (XUnary "&", call), XRaw "None"]])]]

# A template call's arguments in place order (pick TK, as the checker reads them): the
# body, when there is one, fills the last place; each attribute fills the one place any
# clause names it at, its pattern seen through parentheses and without its marks (`$text`,
# `?x` name `text`, `x`); the written order is never used.
TemplateArgs: unbounded fn Lx, Env, Text, [Arg], [Ex] -> [Ex]
fn TemplateArgs lx, env, qk, args, body:
    let clauses = ClausesOf lx.g, qk
    let arity = Len (Or clauses[0], dummyClause).params
    Each (Range0 arity), \|j|
        if (Len body) > 0 and j + 1 == arity: Or body[0], (XRaw "()")
        else: match ?AttrAt clauses, j, args:
            ? a: Argument lx, env, a.value
            nil: Refusal "a template call that fills no argument at place {j}"

?AttrAt: fn [FnClause], Nat, [Arg] -> ?Arg
fn ?AttrAt clauses, j, args:
    let names = Fold clauses, [[]], \|acc, c| match c.params[j]:
        ? p: match ?PlaceName p:
            ? n: AddText acc, n
            nil: acc
        nil: acc
    Fold args, nil, \|?found, a| match a.?name:
        ? n: if HasText names, n.name: ? a else: ?found
        nil: ?found

# The name a parameter's pattern gives its place: a name, through parentheses, less its
# marks; any other pattern names nothing.
?PlaceName: fn Pattern -> ?Text
fn ?PlaceName p = match p.kind:
    PName n: ? (Dotted n.path)
    PGroup q: ?PlaceName q
    otherwise: nil


# A value as a template or interpolation places it: a text as it is, any other value as
# it shows.
ShownText: fn Vl -> Ex
fn ShownText v = match ValueTy v:
    RsText: Ref v
    otherwise: XUnary "&", (XCall "show_text", [[Ref v]])

# `given:` (Semantics ch. 4): `let`s, binds that fail on `nil` (or on an `Error`), the
# guards, and the answer last; a failed guard under `~` is `Prelude.Unmet` with the
# guard's source text (D11).
GivenValue: unbounded fn Lx, Env, Block, RsTy, Range -> Vl
fn GivenValue lx, env, b, t, span:
    let label = "'g{span.start}"
    let isTry = match t:
        RsRes ignore: True
        otherwise: False
    let n = Len b.stmts
    let ((dos, env2, ?last)) = Fold (Range0 n), (([[]], env, nil)), \|((acc, en, ?lv)), i|
        let s = Or b.stmts[i], dummyStmtL
        let fail = if isTry: "Err(Error::new(\"Prelude.Unmet\", \"{Escape (SourceText lx, s.span)}\"))" else: "None"
        match s.kind:
            SBind p, x, nil:
                let v = ValueOf lx, en, x
                let po = RustPat lx, p, (InnerTy (TypeAt lx, x.span)), Owned, "g{s.span.start}"
                (((Push acc, (GivenBind isTry, po.pa, (Own v), label)), (BindAll en, po.binds), ?lv))
            SRequire c: (((Push acc, (DoIf (XUnary "!", (AsBool (ValueOf lx, en, c))), [[DoExpr (XRaw "break {label} {fail}")]], [[]])), en, ?lv))
            SForbid c: (((Push acc, (DoIf (AsBool (ValueOf lx, en, c)), [[DoExpr (XRaw "break {label} {fail}")]], [[]])), en, ?lv))
            SExpr x:
                if i + 1 == n: ((acc, en, ? (ValueOf lx, en, x)))
                else: (((Push acc, (DoExpr (Own (ValueOf lx, en, x)))), en, ?lv))
            otherwise:
                let ((more, en2)) = BlockStmt lx, en, s
                (((Append acc, more), en2, ?lv))
    let last = Or ?last, (VlOwned (XRaw "None"), t)
    VlOwned (XLabeled label, dos, (Own last)), t

# A bind in `given:`: `let Some(p) = e else { break 'g None; }`, or under `~` the error
# passed on.
GivenBind: fn Bool, Pa, Ex, Text -> Do
fn GivenBind isTry, pa, x, label:
    if isTry: DoLet pa, (XMatch x, [[XArm(pat=(PaCtor "Ok", [[PaBind "v"]]), conds=[[]], body=(XRaw "v")), XArm(pat=(PaCtor "Err", [[PaBind "e"]]), conds=[[]], body=(XRaw "break {label} Err(e)"))]], False)
    else: DoLetElse (PaCtor "Some", [[pa]]), x, (XRaw "break {label} None")

# The source a range covers, in the file being lowered.
SourceText: fn Lx, Range -> Text
fn SourceText lx, r = match lx.g.srcs[lx.file]:
    ? src: SpanText src, r
    nil: ""

# `update x: ...` (Semantics ch. 5, `&` blocks): native mutation of a fresh copy, which
# `Rc::make_mut` and the persistent collections update in place when it is unique
# (Compiler ch. 3, "Unique values"). `&_` is `this`; a `let &i` is a `mut` local.
UpdateValue: unbounded fn Lx, Env, Expr, Block, RsTy, Range -> Vl
fn UpdateValue lx, env, target, b, t, span:
    let tv = ValueOf lx, env, target
    let env1 = Bind env, "&_", (BnLocal "this", Owned, t)
    let ((dos, ignore)) = UpdStmts lx, env1, b.stmts
    VlOwned (XBlock (Append [[(DoLet (PaBind "mut this"), (Own tv))]], dos), (XRaw "this")), t

UpdStmts: unbounded fn Lx, Env, [Stmt] -> (([Do], Env))
fn UpdStmts lx, env, stmts = Fold stmts, (([[]], env)), \|((acc, en)), s|
    let ((more, en2)) = UpdStmt lx, en, s
    (((Append acc, more), en2))

UpdStmt: unbounded fn Lx, Env, Stmt -> (([Do], Env))
fn UpdStmt lx, env, s = match s.kind:
    SSet target, value:
        let v = Own (ValueOf lx, env, value)
        (([[(Assign lx, env, target, v)]], env))
    SAccum target, op, value:
        let cur = PlaceOf lx, env, target
        let tt = RustTy lx, (Peel (TypeAt lx, target.span))
        let rv = ValueOf lx, env, value
        let bin = Take op, 1
        let next = OpValue lx, bin, (VlPlace cur, Owned, tt), rv, s.span, tt
        (([[(Assign lx, env, target, (Own next))]], env))
    SLet p, ignore, x:
        let v = Own (ValueOf lx, env, x)
        match p.kind:
            PName n:
                if (Take n.sigils, 1) == "&":
                    let rs = LocalName lx, (SNameKey n)
                    let bt = RustTy lx, (Peel (BinderTy lx, n.span))
                    let pa = if IsKnownTy bt: PaTyped (PaBind "mut {rs}"), bt else: PaBind "mut {rs}"
                    (([[(DoLet pa, v)]], (Bind env, (SNameKey n), (BnLocal rs, Owned, bt))))
                else: BlockStmt lx, env, s
            otherwise: BlockStmt lx, env, s
    SWhile c, body:
        let ((inner, ignore)) = UpdStmts lx, env, body.stmts
        match c:
            CondExpr x: (([[(DoWhile (AsBool (ValueOf lx, env, x)), inner)]], env))
            CondBind p, x, ?g:
                let po = RustPat lx, p, (TypeAt lx, x.span), Owned, "w{s.span.start}"
                let envB = BindAll env, po.binds
                let ((inner2, ignore)) = UpdStmts lx, envB, body.stmts
                # The pattern's conditions and the guard (`while ? left <- &fuel -? 1 if c:`)
                # end the loop as a failed match does: a `break` when they do not hold.
                let conds = Append po.conds, (GuardConds lx, envB, ?g)
                let tests = Fold conds, [[]], \|acc, c| match c:
                    CcIf t: Push acc, t
                    otherwise: acc
                let lets = Fold conds, False, \|f, c| f or IsLetCond c
                let stop = if (Len tests) == 0: [[]] else: [[(DoIf (XUnary "!", (AllOf tests)), [[DoExpr (XRaw "break")]], [[]])]]
                let body2 = if lets: [[RefusalDo "a `while` whose pattern matches through an `Rc`"]] else: Append stop, inner2
                (([[(DoWhileLet po.pa, (Own (ValueOf lx, env, x)), body2)]], env))
    SExpr x: match x.kind:
        EIf c, thenB, ?elseB: (([[(UpdIf lx, env, c, thenB, ?elseB)]], env))
        EMatch scrut, arms: (([[(UpdMatch lx, env, scrut, arms)]], env))
        EFor ?binders, source, body: (([[(UpdFor lx, env, ?binders, source, body, x.span)]], env))
        otherwise: (([[DoExpr (Own (ValueOf lx, env, x))]], env))
    otherwise: BlockStmt lx, env, s

# `for` as a statement of an `update` block (Semantics ch. 4, keyed iteration in plain
# code): a Rust `for` over the source's entries, owned and in key order. Over an array the
# key is the index, which `ix` also names; one binder is the entry, two the key and the
# entry, none bind `key` and `_`.
UpdFor: unbounded fn Lx, Env, ?ForBinders, Expr, Block, Range -> Do
fn UpdFor lx, env, ?binders, source, body, span:
    let src = Own (ValueOf lx, env, source)
    let sty = Peel (TypeAt lx, source.span)
    let ((kt, vt, isArray)) = match sty:
        TyArray v: ((RsNat, (RustTy lx, v), True))
        TyMap k, v: (((RustTy lx, k), (RustTy lx, v), False))
        otherwise: ((RsUnit, RsUnit, True))
    let ((vty, kty)) = match sty:
        TyArray v: ((v, (TyCon "Nat", [[]])))
        TyMap k, v: ((v, k))
        otherwise: ((TyErr, TyErr))
    let keyName = "k{span.start}"
    let valName = "v{span.start}"
    let env1 = Bind (Bind env, "key", (BnLocal keyName, Owned, kt)), "_", (BnLocal valName, Owned, vt)
    let env2 = if isArray: Bind env1, "ix", (BnLocal keyName, Owned, kt) else: env1
    let ((binds, env3)) = match ?binders:
        nil: (([[]], env2))
        ? fb: match fb.?second:
            nil:
                let po = RustPat lx, fb.first, vty, Owned, "e{span.start}"
                (([[(DoLet po.pa, (XMethod (XRaw valName), "clone", [[]]))]], (BindAll env2, po.binds)))
            ? second:
                let pk = RustPat lx, fb.first, kty, Owned, "k{span.start}_"
                let pv = RustPat lx, second, vty, Owned, "e{span.start}"
                ((([[(DoLet pk.pa, (XMethod (XRaw keyName), "clone", [[]])), (DoLet pv.pa, (XMethod (XRaw valName), "clone", [[]]))]]), (BindAll (BindAll env2, pk.binds), pv.binds)))
    let ((dos, ignore)) = UpdStmts lx, env3, body.stmts
    if isArray:
        let head = DoLet (PaBind keyName), (XCall "nat_of", [[XRaw "i{span.start}"]])
        DoFor (PaTuple [[(PaBind "i{span.start}"), (PaBind valName)]]), (XMethod (XMethod src, "into_iter", [[]]), "enumerate", [[]]), (Append (Push [[]], head), (Append binds, dos))
    else: DoFor (PaTuple [[(PaBind keyName), (PaBind valName)]]), (XMethod src, "into_iter", [[]]), (Append binds, dos)

UpdIf: unbounded fn Lx, Env, Cond, Block, ?Block -> Do
fn UpdIf lx, env, c, thenB, ?elseB:
    let ((elseDos, ignore)) = match ?elseB:
        ? b: UpdStmts lx, env, b.stmts
        nil: (([[]], env))
    match c:
        CondExpr x:
            let ((thenDos, ignore)) = UpdStmts lx, env, thenB.stmts
            DoIf (AsBool (ValueOf lx, env, x)), thenDos, elseDos
        CondBind p, x, ignore:
            let po = RustPat lx, p, (TypeAt lx, x.span), Owned, "u{x.span.start}"
            let ((thenDos, ignore)) = UpdStmts lx, (BindAll env, po.binds), thenB.stmts
            DoIfLet po.pa, (Own (ValueOf lx, env, x)), thenDos, elseDos

UpdMatch: unbounded fn Lx, Env, Expr, [Arm] -> Do
fn UpdMatch lx, env, scrut, arms:
    let sv = ValueOf lx, env, scrut
    let sty = TypeAt lx, scrut.span
    let arms3 = Each (Range0 (Len arms)), \|i|
        let arm = Or arms[i], dummyArm
        let po = ArmPat lx, arm.?pattern, sty, ByRef, "u{scrut.span.start}_{i}"
        let ((dos, ignore)) = UpdStmts lx, (BindAll env, po.binds), arm.body.stmts
        let guarded = Append po.conds, (GuardConds lx, (BindAll env, po.binds), arm.?guard)
        XArm(pat=po.pa, conds=guarded, body=(XBlock dos, (XRaw "()")))
    # Arms with conditions (a guard, a literal, a payload behind an `Rc`) are the
    # value-`match`'s arms, a `match` with guards or an if-let chain; others a plain one.
    if Fold arms3, False, \|f, a| f or (Len a.conds) > 0: DoExpr (Own (ArmsValue (Ref sv), arms3, "'u{scrut.span.start}", RsUnit))
    else: DoMatch (Ref sv), (Each arms3, \|a| ((a.pat, (ArmDos a.body))))

# Conditions joined by `&&`.
AllOf: fn [Ex] -> Ex
fn AllOf [[one]] = one
fn AllOf xs = Fold (Drop xs, 1), (Or xs[0], (XRaw "true")), \|acc, x| XBin "&&", acc, x

ArmDos: fn Ex -> [Do]
fn ArmDos (XBlock dos, ignore) = dos
fn ArmDos x = [[DoExpr x]]

GuardConds: unbounded fn Lx, Env, ?Expr -> [Cc]
fn GuardConds lx, env, (? ge) = [[CcIf (AsBool (ValueOf lx, env, ge))]]
fn GuardConds lx, env, nil = [[]]

# The place a reference path names: `&_.f.g`, `&i`, `&_[k].f`.
PlaceOf: unbounded fn Lx, Env, Expr -> Ex
fn PlaceOf lx, env, e = match e.kind:
    EName n: match env.names[SNameKey n]:
        ? (BnLocal rs, ignore, ignore): XRaw rs
        otherwise: XRaw (Snake (SNameKey n))
    EField r, ignore, name: XField (PlaceOf lx, env, r), (Snake name.name)
    EIndex r, k:
        let rt = RustTy lx, (Peel (TypeAt lx, r.span))
        let f = match rt:
            RsMap ignore, ignore: "at_mut_map"
            otherwise: "at_mut"
        XUnary "*", (XCall f, [[(XUnary "&mut ", (PlaceOf lx, env, r)), (Argument lx, env, k)]])
    EGroup x: PlaceOf lx, env, x
    otherwise: Refusal "a reference path this back end does not lower"

# `&p <= v`; on a map's key, an insertion.
Assign: unbounded fn Lx, Env, Expr, Ex -> Do
fn Assign lx, env, target, v = match target.kind:
    EIndex r, k:
        let rt = RustTy lx, (Peel (TypeAt lx, r.span))
        match rt:
            RsMap ignore, ignore: DoExpr (XMethod (PlaceOf lx, env, r), "insert", [[Own (ValueOf lx, env, k), v]])
            otherwise: DoAssign (PlaceOf lx, env, target), v
    EGroup x: Assign lx, env, x, v
    otherwise: DoAssign (PlaceOf lx, env, target), v

# ---------------------------------------------------------------------------------------
# Functions (docs/backend.md: a plain function is a Rust `fn` taking references, its
# clauses one `match`; generics are Rust's, monomorphized by rustc, doubt MO)
# ---------------------------------------------------------------------------------------

# A trait bound as Rust's: `^Eq` is `PartialEq`, `^Ord` `PartialOrd` (a `Float` has no
# total order in Rust), `^Show` the printer's, `^Num` the prelude's.
BoundOf: fn Lx, Text -> [Text]
fn BoundOf lx, "Prelude.Eq" = [["PartialEq"]]
fn BoundOf lx, "Prelude.Ord" = [["PartialOrd"]]
fn BoundOf lx, "Prelude.Show" = [["Show"]]
fn BoundOf lx, "Prelude.Num" = [["Num"]]
fn BoundOf lx, "Prelude.Pod" = [["ToPod", "FromPod"]]
fn BoundOf lx, cls = match lx.g.traits[cls]:
    ? tr: [[(PathIn lx, tr.home, (Camel (BareName cls)))]]
    nil: [[]]

# A scheme's type variables as Rust generics with their bounds.
SchemeGenerics: fn Lx, Scheme -> [((Text, [Text]))]
fn SchemeGenerics lx, sc = Each sc.qs, \|q|
    let bs = Fold sc.bounds, [["Clone"]], \|acc, ((v, cls))| if v == q: UnionTexts acc, (BoundOf lx, cls) else: acc
    ((Camel q, bs))

# The parameters of a function's clauses: a name every clause binds at a position names
# the parameter; any other position is matched, named after its type.
ParamNames: fn Lx, [FnClause], [RsTy] -> [((Text, Bool))]
fn ParamNames lx, clauses, pts = Each (Range0 (Len pts)), \|i|
    let names = Each clauses, \|c| PlainBinder lx, (Or c.params[i], dummyPat)
    let first = Or names[0], ""
    let same = first != "" and Fold names, True, \|ok, n| ok and n == first
    if same: (((LocalName lx, first), False)) else: (((ParamWord (Or pts[i], RsUnit), i), True))

# The binder a parameter pattern is, when it is one: its name with sigils.
PlainBinder: fn Lx, Pattern -> Text
fn PlainBinder lx, p = match p.kind:
    PName n:
        let ((?qk, why)) = ResolveValue lx.g, lx.home, n
        let isCtor = match ?qk:
            ? qk: (HasKey lx.g.ctors, qk) and ((IsUpperText (Base (SNameKey n))) or IsUnitCtor lx, qk)
            nil: False
        if isCtor: "" else: SNameKey n
    PGroup q: PlainBinder lx, q
    otherwise: ""

# A matched parameter's name: its type's (`term` for a `Term`), else `arg`.
ParamWord: fn RsTy, Nat -> Text
fn ParamWord t, i:
    let base = match t:
        RsNamed n, ignore: Snake (Or (?Last (Split n, "::")), "arg")
        RsText: "text"
        RsNat: "n"
        RsInt: "i"
        RsArray ignore: "xs"
        RsMap ignore, ignore: "map"
        RsOpt ignore: "opt"
        otherwise: "arg"
    "{base}{i}"

# A function's clauses as one body over its parameters (each a reference, `ref`).
ClausesBody: unbounded fn Lx, Env, [FnClause], [((Text, Bool))], [Ty], (fn Lx, Env, FnBody -> Ex), Text -> Ex
fn ClausesBody lx, env, clauses, names, ptys, Body, label:
    let env1 = Fold (Range0 (Len names)), env, \|en, i|
        let ((rs, matched)) = Or names[i], (("", True))
        if matched: en
        else: Bind en, (PlainBinder lx, (Or (Or clauses[0], dummyClause).params[i], dummyPat)), (BnLocal rs, ByRef, (RustTy lx, (Peel (Or ptys[i], TyErr))))
    let scrutIx = Filter (Range0 (Len names)), \|i| match names[i]:
        ? ((ignore, True)): True
        otherwise: False
    if (Len scrutIx) == 0:
        let c = Or clauses[0], dummyClause
        Body lx, env1, c.body
    else:
        let scrut = match scrutIx:
            [[i]]: XRaw (Or (Each names, \|((n, ignore))| n)[i], "arg")
            otherwise: XTuple (Each scrutIx, \|i| XRaw (Or (Each names, \|((n, ignore))| n)[i], "arg"))
        let arms = Each (Range0 (Len clauses)), \|ci|
            let c = Or clauses[ci], dummyClause
            let pos = Each scrutIx, \|i| RustPat lx, (Or c.params[i], dummyPat), (Or ptys[i], TyErr), ByRef, "{label}{ci}_{i}"
            let pa = match pos:
                [[o]]: o.pa
                otherwise: PaTuple (Each pos, \|o| o.pa)
            let conds = Fold pos, [[]], \|acc, o| Append acc, o.conds
            let binds = Fold pos, [[]], \|acc, o| Append acc, o.binds
            XArm(pat=pa, conds=conds, body=(Body lx, (BindAll env1, binds), c.body))
        Own (ArmsValue scrut, arms, "'{label}", RsUnit)

let dummyClause = FnClause(name=(DefOp "", Range(start=0, end=0)), params=[[]], body=(BodyExpr (Expr(kind=EError, span=Range(start=0, end=0)))), span=Range(start=0, end=0))

FnBodyValue: unbounded fn Lx, Env, FnBody -> Ex
fn FnBodyValue lx, env, (BodyExpr x) = Own (ValueOf lx, env, x)
fn FnBodyValue lx, env, (BodyBlock b) = Own (BlockValue lx, env, b)

# A plain function: its scheme's types, its clauses as a `match`.
FnDefOf: unbounded fn Lx, Text, [FnClause], Scheme -> FnDef
fn FnDefOf lx, qk, clauses, sc:
    let ((ptys0, res)) = match sc.ty:
        TyFn ignore, ps, r: ((ps, r))
        other: (([[]], other))
    # A function that gives a blueprint is not lifted over its `!` parameters: it takes
    # each as an event value (`?Boxed p, e, !in` builds `@ !Filter (?ClickTo p, !in)`).
    let ptys = if HasBlueprint res: Each ptys0, \|p| EventParam p else: ptys0
    let pts = Each ptys, \|p| RustTy lx, (Peel p)
    let names = ParamNames lx, clauses, pts
    let body = ClausesBody lx, emptyEnv, clauses, names, ptys, FnBodyValue, "c"
    let params = Each (Range0 (Len pts)), \|i| (((Or (Each names, \|((n, ignore))| n)[i], "arg"), (RsRef (Or pts[i], RsUnit))))
    let ret = RustTy lx, (Peel res)
    # A type variable the Rust signature erases (a supplier's `o`, under a blueprint and a
    # live element) is no Rust type parameter: rustc could not infer it.
    let used = Fold (Push pts, ret), [[]], \|acc, t| UnionTexts acc, (TyParamsIn t)
    let generics = Filter (SchemeGenerics lx, sc), \|((g, ignore))| HasText used, g
    FnDef(name=(Or lx.rsNames[qk], (Snake (BareName qk))), generics=generics, params=params, ret=ret, body=body, doc=(SignatureText lx, qk), public=True)

# The type parameters a Rust type names.
TyParamsIn: fn RsTy -> [Text]
fn TyParamsIn t = match t:
    RsGen n: [[n]]
    RsNamed ignore, ts: Fold ts, [[]], \|acc, x| UnionTexts acc, (TyParamsIn x)
    RsTuple ts: Fold ts, [[]], \|acc, x| UnionTexts acc, (TyParamsIn x)
    RsFn ts, r: Fold ts, (TyParamsIn r), \|acc, x| UnionTexts acc, (TyParamsIn x)
    RsJobFn a, r: UnionTexts (TyParamsIn a), (TyParamsIn r)
    RsMap k, v: UnionTexts (TyParamsIn k), (TyParamsIn v)
    RsOpt x: TyParamsIn x
    RsRes x: TyParamsIn x
    RsArray x: TyParamsIn x
    RsJob x: TyParamsIn x
    RsEvent x: TyParamsIn x
    RsDyn x: TyParamsIn x
    RsRc x: TyParamsIn x
    RsRef x: TyParamsIn x
    RsHold x: TyParamsIn x
    RsCell x: TyParamsIn x
    RsLive x: TyParamsIn x
    otherwise: [[]]

# A definition's Prism signature, for the doc comment.
SignatureText: fn Lx, Text -> Text
fn SignatureText lx, qk = match lx.g.vals[qk]:
    ? v: match lx.g.srcs[v.file]:
        ? src: Trim (SpanText src, v.span)
        nil: BareName qk
    nil: BareName qk

# A definition's whole Prism source, its signature with it.
DefinitionText: fn Lx, Text -> Text
fn DefinitionText lx, qk:
    let spans = Fold lx.g.defs, [[]], \|acc, d| if d.qk == qk: Push acc, ((d.file, d.span)) else: acc
    let sig = match lx.g.vals[qk]:
        ? v: if v.span.start < (Or (Each spans, \|((ignore, r))| r.start)[0], 0): [[((v.file, v.span))]] else: [[]]
        nil: [[]]
    Join (Each (Append sig, spans), \|((f, r))| SrcText lx, f, r), "\n"

SrcText: fn Lx, Nat, Range -> Text
fn SrcText lx, f, r = match lx.g.srcs[f]:
    ? src: DropTrailingComments (SpanText src, r)
    nil: ""

# A definition's span runs to the next one, so it takes the comments that introduce the
# next (or a test file's header): the quote stops at its last line of code.
DropTrailingComments: fn Text -> Text
fn DropTrailingComments t:
    let lines = Split t, "\n"
    let keep = Fold (Range0 (Len lines)), 0, \|k, i| if IsCodeLine (Or lines[i], ""): i + 1 else: k
    TrimEnd (Join (Take lines, keep), "\n")

IsCodeLine: fn Text -> Bool
fn IsCodeLine l:
    let s = Trim l
    s != "" and (Take s, 1) != "#"

# A top-level `let`: a getter computing its value (pick TL of the README).
LetGetter: unbounded fn Lx, Text, LetDecl -> FnDef
fn LetGetter lx, qk, l:
    let t = RustTy lx, (Peel (TypeAt lx, l.value.span))
    let v = ValueOf lx, emptyEnv, l.value
    FnDef(name=(Or lx.rsNames[qk], (Snake (BareName qk))), generics=[[]], params=[[]], ret=t, body=(Own v), doc="let {BareName qk}", public=True)

# ---------------------------------------------------------------------------------------
# Unbounded functions as step machines (Semantics ch. 7; D6; docs/backend.md, "Unbounded
# functions and `@Run`")
# ---------------------------------------------------------------------------------------

# A job's body: bounded code to the next cycle point (D6: a cycle point at every call of
# an unbounded function from an unbounded function). A tail call leaves no frame: the job
# is the callee with its arguments (`Turn::More`). Any other call is a frame (`Frame`):
# the callee's job runs, and its result resumes the rest of the body. Any other result
# ends the job (`Turn::Finished`). A call under a lambda or in a branch of a `match` or an
# `if` that is not in tail position still runs direct-style inside the cycle (gap DS).
Tail: unbounded fn Lx, Env, Expr -> Ex
fn Tail lx, env, e = match ?FrameCall lx, env, e, True:
    ? c: Frame lx, env, c, (RestText lx, e.span, c.span, e.span), \|env2| Tail lx, env2, e
    nil: TailHere lx, env, e

TailHere: unbounded fn Lx, Env, Expr -> Ex
fn TailHere lx, env, e = match e.kind:
    EGroup x: Tail lx, env, x
    EUpdate target, b:
        if HasTopWhile lx, b: UpdTail lx, env, target, b, e.span, \|en, v| XCtor "prism_rtl::Turn::Finished", [[v]]
        else: XCtor "prism_rtl::Turn::Finished", [[Own (ValueOf lx, env, e)]]
    EMatch s, arms: TailMatch lx, env, s, arms, e.span
    EIf (CondExpr c), thenB, (? elseB): XIf (AsBool (ValueOf lx, env, c)), (TailBlock lx, env, thenB), (TailBlock lx, env, elseB)
    ECall callee, args, ignore, ignore: match ?TailCallee lx, env, callee:
        ? qk:
            let job = Or lx.rsNames[qk], (Snake (BareName qk))
            let jobName = PathIn lx, (OwnerOf qk), (Camel (BareName qk))
            let ((ptys, ignore)) = SchemeParts lx, qk
            let fields = JobFieldNames lx, qk
            let vals = NamedArgsOwned lx, env, qk, args
            if EntersAtOnce lx, qk, args: XMethod (XCall (PathIn lx, (OwnerOf qk), "start_{job}"), vals), "cycle", [[]]
            else: if IsColorPoly lx, qk: XCtor "prism_rtl::Turn::More", [[(XCall (PathIn lx, (OwnerOf qk), "start_{job}"), vals)]]
            else: XCtor "prism_rtl::Turn::More", [[(XCall "Rc::new", [[(XRecord jobName, (Each (Range0 (Len vals)), \|i| (((Or fields[i], "arg"), (Or vals[i], (XRaw "()"))))))]])]]
        nil: match ?LocalJobFn lx, env, callee:
            ? f: XMethod (StartCall f, (StartArgs lx, env, f, args)), "cycle", [[]]
            nil: match ?PreludeJobCall lx, env, e:
                ? job: XMethod job, "cycle", [[]]
                nil: XCtor "prism_rtl::Turn::Finished", [[Own (ValueOf lx, env, e)]]
    otherwise: XCtor "prism_rtl::Turn::Finished", [[Own (ValueOf lx, env, e)]]

TailBlock: unbounded fn Lx, Env, Block -> Ex
fn TailBlock lx, env, b = TailFrom lx, env, b, 0

# A job's block from statement `i` on. A statement whose value needs a call is cut there:
# the frame's continuation is the statement again, the call's place bound to its result.
TailFrom: unbounded fn Lx, Env, Block, Nat -> Ex
fn TailFrom lx, env, b, i:
    let s = Or b.stmts[i], dummyStmtL
    if i + 1 >= (Len b.stmts): match s.kind:
        SExpr x: Tail lx, env, x
        otherwise: XCtor "prism_rtl::Turn::Finished", [[XRaw "()"]]
    else:
        let ?found = match s.kind:
            SLet ignore, ignore, x: ?FrameCall lx, env, x, False
            SExpr x: ?FrameCall lx, env, x, False
            otherwise: nil
        let ?looping = match s.kind:
            SLet p, ignore, x: match x.kind:
                EUpdate target, ub: if HasTopWhile lx, ub: ? ((p, target, ub, x)) else: nil
                otherwise: nil
            otherwise: nil
        match ?looping:
            ? ((p, target, ub, x)):
                UpdTail lx, env, target, ub, b.span, \|en, v|
                    let po = RustPat lx, p, (TypeAt lx, x.span), Owned, "l{s.span.start}"
                    let rest = TailFrom lx, (BindAll en, po.binds), b, i + 1
                    Prepend [[(DoLet po.pa, v)]], rest
            nil: match ?found:
                ? c: Frame lx, env, c, (RestText lx, s.span, c.span, b.span), \|env2| TailFrom lx, env2, b, i
                nil:
                    let ((dos, env2)) = BlockStmt lx, env, s
                    match TailFrom lx, env2, b, i + 1:
                        XBlock more, last: XBlock (Append dos, more), last
                        last: if (Len dos) == 0: last else: XBlock dos, last

# ---- `while` in an `update` block of a job (D6: every turn of a `while` in an unbounded
# `&` block is a cycle point; a loop whose turns are unbounded inside one cycle could keep
# a tick from ending). The block runs as statements up to a `while` at its top level; the
# loop is a job over the block's state (`this` and its `&` locals), one turn a cycle
# (`loop_job`); what follows the loop is its continuation. A `while` nested in an `if`,
# a `match` or another loop still turns within the cycle (gap LP).

# Whether an `update` block has a `while` at its top level that the shrink check did
# not clear: a loop job (D6). A loop it cleared turns within the cycle, one unit of work.
HasTopWhile: fn Lx, Block -> Bool
fn HasTopWhile lx, b = Fold b.stmts, False, \|f, st| f or IsCycleWhile lx, st

IsCycleWhile: fn Lx, Stmt -> Bool
fn IsCycleWhile lx, st = match st.kind:
    SWhile ignore, ignore: HasKey lx.unshrunk, (PlaceKey lx, st.span)
    otherwise: False

# An `update` block in a job, its value given to `Cont` (with the environment outside the
# block); `to` is where the source the continuation covers ends.
UpdTail: unbounded fn Lx, Env, Expr, Block, Range, (unbounded fn Env, Ex -> Ex) -> Ex
fn UpdTail lx, env, target, b, to, Cont:
    let t = RustTy lx, (Peel (TypeAt lx, target.span))
    let tv = ValueOf lx, env, target
    let env1 = Bind env, "&_", (BnLocal "this", Owned, t)
    Prepend [[(DoLet (PaBind "mut this"), (Own tv))]], (UpdTailFrom lx, env, env1, b, 0, to, Cont)

UpdTailFrom: unbounded fn Lx, Env, Env, Block, Nat, Range, (unbounded fn Env, Ex -> Ex) -> Ex
fn UpdTailFrom lx, outer, env, b, i, to, Cont:
    if i >= (Len b.stmts): Cont outer, (XRaw "this")
    else:
        let s = Or b.stmts[i], dummyStmtL
        let ?loop = match s.kind:
            SWhile c, wb: if IsCycleWhile lx, s: ? ((c, wb)) else: nil
            otherwise: nil
        match ?loop:
            ? ((c, wb)): WhileJob lx, outer, env, c, wb, s.span, (RestText lx, (Range(start=s.span.end, end=s.span.end)), (Range(start=s.span.end, end=s.span.end)), to), \|o2, e2| UpdTailFrom lx, o2, e2, b, i + 1, to, Cont
            nil:
                let ((dos, env2)) = UpdStmt lx, env, s
                Prepend dos, (UpdTailFrom lx, outer, env2, b, i + 1, to, Cont)

Prepend: fn [Do], Ex -> Ex
fn Prepend dos, (XBlock more, last) = XBlock (Append dos, more), last
fn Prepend dos, x = if (Len dos) == 0: x else: XBlock dos, x

# One `while` as a loop job: the step closure takes the state a turn (`Ok`) or gives it
# back when the condition fails (`Err`); the continuation takes the state again by the
# same names. Locals the loop or the rest reads are cloned into each closure first.
WhileJob: unbounded fn Lx, Env, Env, Cond, Block, Range, Text, (unbounded fn Env, Env -> Ex) -> Ex
fn WhileJob lx, outer, env, c, wb, span, restText, Cont:
    let state = Fold (Keys env.names), [[]], \|acc, k| if (Take k, 1) != "&": acc else: match env.names[k]:
        ? (BnLocal rs, ignore, bt): Push acc, ((k, rs, bt))
        otherwise: acc
    let names = Each state, \|((ignore, rs, ignore))| rs
    let stTy = RsTuple (Each state, \|((ignore, ignore, bt))| bt)
    let pat = PaTuple (Each names, \|n| PaBind "mut {n}")
    let pack = XTuple (Each names, \|n| XRaw n)
    let envS = Fold state, env, \|en, ((k, rs, bt))| Bind en, k, (BnLocal rs, Owned, bt)
    let loopText = match lx.g.srcs[lx.file]:
        ? src: SpanText src, span
        nil: ""
    # The loop's other locals: borrowed or owned, cloned into the step closure.
    let caps = CapsIn envS, loopText, names
    let capDos = Each caps, \|((ignore, rs, mode, bt))| DoLet (PaBind rs), (Own (VlPlace (XRaw rs), mode, bt))
    let envC = Fold caps, envS, \|en, ((k, rs, ignore, bt))| Bind en, k, (BnLocal rs, Owned, bt)
    let ((bodyDos, ignore)) = UpdStmts lx, envC, wb.stmts
    let again = XCtor "Ok", [[pack]]
    let stop = XCtor "Err", [[pack]]
    let turn = match c:
        CondExpr x: XIf (AsBool (ValueOf lx, envC, x)), (XBlock bodyDos, again), stop
        CondBind p, x, ?g:
            let po = RustPat lx, p, (TypeAt lx, x.span), Owned, "w{span.start}"
            let envB = BindAll envC, po.binds
            let ((inner, ignore)) = UpdStmts lx, envB, wb.stmts
            let conds = Append po.conds, (GuardConds lx, envB, ?g)
            Own (ArmsValue (Own (ValueOf lx, envC, x)), [[XArm(pat=po.pa, conds=conds, body=(XBlock inner, again)), XArm(pat=PaWild, conds=[[]], body=stop)]], "'w{span.start}", stTy)
    # The continuation: the state by its names again, and the outer locals the rest reads.
    let outCaps = CapsIn outer, restText, names
    let outDos = Each outCaps, \|((ignore, rs, mode, bt))| DoLet (PaBind rs), (Own (VlPlace (XRaw rs), mode, bt))
    let outer2 = Fold outCaps, outer, \|en, ((k, rs, ignore, bt))| Bind en, k, (BnLocal rs, Owned, bt)
    let env2 = Fold outCaps, envS, \|en, ((k, rs, ignore, bt))| Bind en, k, (BnLocal rs, Owned, bt)
    let stepFn = Prepend capDos, (XClosure True, [[(PaTyped pat, stTy)]], turn)
    let enter = XCall "call_then", [[(XCall "loop_job", [[pack, stepFn]]), (XClosure True, [[(PaTyped pat, stTy)]], (Cont outer2, env2))]]
    Prepend outDos, enter

# The locals of `env` a source text names, other than `skip`: each to clone into a closure.
CapsIn: fn Env, Text, [Text] -> [((Text, Text, Holding, RsTy))]
fn CapsIn env, text, skip = Fold (Keys env.names), [[]], \|acc, k| match env.names[k]:
    ? (BnLocal rs, mode, bt):
        if (HasText skip, rs) or (Take rs, 5) == "self." or not (Mentions text, (Drop k, (Len (MarksOf k)))): acc
        else: Push acc, ((k, rs, mode, bt))
    otherwise: acc

# The first call (leftmost, innermost) of an unbounded function with a job that an
# expression makes whatever its value: not under a lambda, not in an arm of a `match` or
# a branch of an `if`, not right of `and` or `or`. With `top`, a call the expression is
# itself is a tail call, which leaves no frame. A call whose place is bound is done.
?FrameCall: unbounded fn Lx, Env, Expr, Bool -> ?Expr
fn ?FrameCall lx, env, e, top:
    if HasKey env.spans, (PlaceKey lx, e.span): nil
    else: match e.kind:
        EGroup x: ?FrameCall lx, env, x, top
        ECall c, args, ignore, ignore: match ?FirstFrame lx, env, (Each args, \|a| a.value):
            ? x: ? x
            nil:
                if top: nil
                else: match ?TailCallee lx, env, c:
                    ? ignore: ? e
                    nil: match ?LocalJobFn lx, env, c:
                        ? ignore: ? e
                        nil: match ?PreludeJobCall lx, env, e:
                            ? ignore: ? e
                            nil: nil
        EMatch x, ignore: ?FrameCall lx, env, x, False
        EIf (CondExpr x), ignore, ignore: ?FrameCall lx, env, x, False
        EBinary op, l, r: if op == "and" or op == "or": ?FrameCall lx, env, l, False else: ?FirstFrame lx, env, [[l, r]]
        ETuple es: ?FirstFrame lx, env, es
        EArray es: ?FirstFrame lx, env, es
        EUnary ignore, x: ?FrameCall lx, env, x, False
        EField x, ignore, ignore: ?FrameCall lx, env, x, False
        EIndex x, i: ?FirstFrame lx, env, [[x, i]]
        EMethod x, ignore, args: ?FirstFrame lx, env, (Append [[x]], (Each args, \|a| a.value))
        ECast x, ignore, ignore: ?FrameCall lx, env, x, False
        ELit l: match l.kind:
            LText segs: ?FirstFrame lx, env, (Placeholders segs)
            otherwise: nil
        otherwise: nil

Placeholders: fn [TextSeg] -> [Expr]
fn Placeholders segs = Fold segs, [[]], \|acc, sg| match sg:
    SegPlaceholder x: Push acc, x
    otherwise: acc

?FirstFrame: unbounded fn Lx, Env, [Expr] -> ?Expr
fn ?FirstFrame lx, env, es = Fold es, nil, \|?found, x| match ?found:
    ? f: ? f
    nil: ?FrameCall lx, env, x, False

# A frame (D6): entering `call` is a cycle point. The callee's job runs to its result,
# which resumes `Cont` (in the cycle the callee finishes) with the call's place bound to
# it. The continuation is a closure that owns what it reads: each borrowed local the rest
# of the source names is cloned into it first.
Frame: unbounded fn Lx, Env, Expr, Text, (unbounded fn Env -> Ex) -> Ex
fn Frame lx, env, call, restText, Cont = match call.kind:
    ECall c, args, ignore, ignore:
        let ?qk = ?TailCallee lx, env, c
        let qk = Or ?qk, ""
        let base = match ?qk:
            ? q: Or lx.rsNames[q], (Snake (BareName q))
            nil: Snake (CalleeText c)
        let v = "{base}_{call.span.start}"
        let t = RustTy lx, (Peel (TypeAt lx, call.span))
        let caps = Fold (Keys env.names), [[]], \|acc, k| match env.names[k]:
            ? (BnLocal rs, mode, bt): if (mode == ByRef or mode == RcRef) and Mentions restText, k: Push acc, ((k, rs, mode, bt)) else: acc
            otherwise: acc
        let dos = Each caps, \|((ignore, rs, mode, bt))| DoLet (PaBind rs), (Own (VlPlace (XRaw rs), mode, bt))
        let env2 = Fold caps, env, \|en, ((k, rs, ignore, bt))| Bind en, k, (BnLocal rs, Owned, bt)
        let vals = match ?qk:
            ? q: NamedArgsOwned lx, env2, q, args
            nil: match ?LocalJobFn lx, env2, c:
                ? f: StartArgs lx, env2, f, args
                nil: Each args, \|a| Own (ValueOf lx, env2, a.value)
        let env3 = BindSpan env2, (PlaceKey lx, call.span), (VlOwned (XRaw v), t)
        let body = Cont env3
        let ((job, how)) = match ?qk:
            ? q: (((XCall (PathIn lx, (OwnerOf q), "start_{base}"), vals), (if EntersAtOnce lx, q, args: "call_value" else: "call_then")))
            nil: match ?LocalJobFn lx, env2, c:
                ? f: (((StartCall f, vals), "call_value"))
                nil: match ?PreludeJobCall lx, env2, call:
                    ? pj: ((pj, "call_value"))
                    nil: (((Refusal "a call this frame cannot enter"), "call_then"))
        let enter = XCall how, [[job, (XClosure True, [[(PaTyped (PaBind v), t)]], body)]]
        if (Len dos) == 0: enter else: XBlock dos, enter
    otherwise: Cont env

# A local whose value is an unbounded function: its `Start` (docs/backend.md).
?LocalJobFn: unbounded fn Lx, Env, Expr -> ?Vl
fn ?LocalJobFn lx, env, c = match c.kind:
    EName n:
        if (Len n.path) == 1 and HasKey env.names, (SNameKey n): ?JobValue (NameValue lx, env, n, c.span)
        else: nil
    EGroup x: ?LocalJobFn lx, env, x
    EField ignore, ignore, ignore: ?JobValue (ValueOf lx, env, c)
    otherwise: nil

?JobValue: fn Vl -> ?Vl
fn ?JobValue f = match ValueTy f:
    RsJobFn ignore, ignore: ? f
    otherwise: nil

# A `Start` applied: one argument as itself, several as a tuple.
StartCall: fn Vl, [Ex] -> Ex
fn StartCall f, vals = XApply (Ref f), [[OneOrTuple vals]]

OneOrTuple: fn [Ex] -> Ex
fn OneOrTuple [[one]] = one
fn OneOrTuple vals = XTuple vals

CalleeText: fn Expr -> Text
fn CalleeText c = match c.kind:
    EName n: Dotted n.path
    EGroup x: CalleeText x
    otherwise: "call"

# The source a frame's continuation covers: from `from` to the end of `to`, the call
# included: a local its arguments name is cloned before the frame, so that no inner
# frame finds it still borrowed.
RestText: fn Lx, Range, Range, Range -> Text
fn RestText lx, from, call, to = match lx.g.srcs[lx.file]:
    ? src: SpanText src, (Range(start=from.start, end=to.end))
    nil: ""

# Whether `text` names `name` as a whole word (a frame's captures; a mention in a
# comment or a text only clones one more local).
Mentions: fn Text, Text -> Bool
fn Mentions text, name:
    let parts = Split text, name
    let last = Dec (Len parts)
    # Between parts i and i + 1 stands an occurrence; an empty part is two occurrences
    # side by side (`ee` in `callee` for `e`), so its edge is the name's own letter.
    Fold (Range0 last), False, \|found, i|
        let before = Or parts[i], ""
        let after = Or parts[i + 1], ""
        let leftWord = if before != "": EndsIdent before else: i > 0 and EndsIdent name
        let rightWord = if after != "": StartsIdent after else: (i + 1) < last and StartsIdent name
        found or ((not leftWord) and not rightWord)

EndsIdent: fn Text -> Bool
fn EndsIdent t = (Len t) > 0 and IsIdentChar (Drop t, (Dec (Len t)))

StartsIdent: fn Text -> Bool
fn StartsIdent t = (Len t) > 0 and IsIdentChar (Take t, 1)

TailBody: unbounded fn Lx, Env, FnBody -> Ex
fn TailBody lx, env, (BodyExpr x) = Tail lx, env, x
fn TailBody lx, env, (BodyBlock b) = TailBlock lx, env, b

TailMatch: unbounded fn Lx, Env, Expr, [Arm], Range -> Ex
fn TailMatch lx, env, s, arms, span:
    let sv = ValueOf lx, env, s
    let sty = TypeAt lx, s.span
    let label = "m{span.start}"
    let byRef = Each (Range0 (Len arms)), \|i| ArmPat lx, (Or arms[i], dummyArm).?pattern, sty, ByRef, "{label}_{i}"
    let chain = Fold byRef, False, \|f, po| f or Fold po.conds, False, \|f2, c| f2 or IsLetCond c
    let owned = match sv:
        VlOwned ignore, ignore: not chain
        otherwise: False
    let pats = if owned: Each (Range0 (Len arms)), \|i| ArmPat lx, (Or arms[i], dummyArm).?pattern, sty, Owned, "{label}_{i}" else: byRef
    let xarms = Each (Range0 (Len arms)), \|i|
        let arm = Or arms[i], dummyArm
        let po = Or pats[i], (PatOut(pa=PaWild, conds=[[]], binds=[[]]))
        let env2 = BindAll env, po.binds
        XArm(pat=po.pa, conds=(Append po.conds, (GuardConds lx, env2, arm.?guard)), body=(TailBlock lx, env2, arm.body))
    let scrut = if owned: Own sv else: Ref sv
    Own (ArmsValue scrut, xarms, "'{label}", RsUnit)

# The unbounded function a call in tail position enters, when it has a job.
?TailCallee: fn Lx, Env, Expr -> ?Text
fn ?TailCallee lx, env, callee = match callee.kind:
    EName n:
        if (Len n.path) == 1 and HasKey env.names, (SNameKey n): nil
        else:
            let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
            match ?qk:
                ? qk: if (HasText lx.unbs, qk) and not (InPrelude lx, qk): ? qk else: nil
                nil: nil
    otherwise: nil

SchemeParts: fn Lx, Text -> (([Ty], Ty))
fn SchemeParts lx, qk = match lx.g.vals[qk]:
    ? v: match v.scheme.ty:
        TyFn ignore, ps, r: ((ps, r))
        other: (([[]], other))
    nil: (([[]], TyErr))

# A job's fields: its function's parameter names.
JobFieldNames: unbounded fn Lx, Text -> [Text]
fn JobFieldNames lx, qk:
    let clauses = ClausesOf lx.g, qk
    let ((ptys, ignore)) = SchemeParts lx, qk
    let pts = Each ptys, \|p| RustTy lx, (Peel p)
    Each (ParamNames lx, clauses, pts), \|((n, ignore))| n

ClausesOf: fn G, Text -> [FnClause]
fn ClausesOf g, qk = Fold g.defs, [[]], \|acc, d| if d.qk == qk: DefClauses d, acc else: acc

DefClauses: fn Def, [FnClause] -> [FnClause]
fn DefClauses d, other = match d.body:
    DbFn cs: cs
    otherwise: other

# The job of an unbounded function: its parameters as fields, its body to the next cycle.
JobDefOf: unbounded fn Lx, Text, [FnClause], Scheme -> JobDef
fn JobDefOf lx, qk, clauses, sc:
    let ((ptys, res)) = match sc.ty:
        TyFn ignore, ps, r: ((ps, r))
        other: (([[]], other))
    let pts = Each ptys, \|p| RustTy lx, (Peel p)
    let names = ParamNames lx, clauses, pts
    let body = JobClauses lx, clauses, names, ptys, pts
    let base = Or lx.rsNames[qk], (Snake (BareName qk))
    JobDef(name=(Camel (BareName qk)), start="start_{base}", generics=(SchemeGenerics lx, sc), fields=(Each (Range0 (Len pts)), \|i| (((Or (Each names, \|((n, ignore))| n)[i], "arg"), (Or pts[i], RsUnit)))), ret=(RustTy lx, (Peel res)), body=body, doc=(SignatureText lx, qk))

# A job's clauses: the parameters are the job's fields, `self.t`.
JobClauses: unbounded fn Lx, [FnClause], [((Text, Bool))], [Ty], [RsTy] -> Ex
fn JobClauses lx, clauses, names, ptys, pts:
    let lets = Each (Range0 (Len names)), \|i|
        let ((rs, ignore)) = Or names[i], (("arg", True))
        DoLet (PaBind rs), (XRaw "&self.{rs}")
    let inner = ClausesBody lx, emptyEnv, clauses, names, ptys, TailBody, "j"
    XBlock lets, inner

# ---------------------------------------------------------------------------------------
# Widget blocks: one node per block, children in static positions merged in (Compiler
# ch. 3, "The translation"; docs/backend.md, "A widget block")
# ---------------------------------------------------------------------------------------

# An event as an expression reaches it: a node of the block's graph (a source, a named
# event or a combinator) and the pipe of pure transforms after it, which calls straight
# through (Compiler ch. 3, the half counter): given the node's value and what to do with
# the result, the code.
type EvRef = record:
    node: Nat
    pipe: unbounded fn Ex, (unbounded fn Ex -> [Do]) -> [Do]

IdPipe: unbounded fn Ex, (unbounded fn Ex -> [Do]) -> [Do]
fn IdPipe x, K = K x

EvRefOf: fn Nat -> EvRef
fn EvRefOf n = EvRef(node=n, pipe=IdPipe)

# One node of the graph: its method, its value's type, what it is, and what each firing
# does (`outs`, in page order). A combinator's `inputs` are its stamped fields.
type Gn = record:
    id: Nat
    name: Text
    ty: RsTy
    kind: GnKind
    height: Nat
    inputs: [Text]
    # An `!Updated` node's: what its dynamic reads, closed over the dynamic `let`s when the
    # node is finished.
    reads: [Read]
    # The least height a combinator takes: a row's `!Updated` node over what the row reads
    # through its parent sits above the block's writers of it (pick RE).
    floor: Nat
    outs: [Out]
    # An `!Updated` node over a structural dynamic (pick ST): decided at the end of the
    # node's construction step, not in the wake, and fired at the start of the next tick.
    structural: Bool

# What a node of the graph is: a source (a place's answer, `@started`, an `@Defer`, a row's
# port), a named event, or a combinator decided in the wake (a merge, `!Union`, `!Both`,
# `!Except`, `!MergeAll`, a `for`'s gather, `!Updated`); `never` fires nothing.
type GnKind = choice:
    GnNamed
    GnAnswer
    GnStarted
    GnDeferred
    GnPort
    GnMerge
    GnUnion
    GnBoth
    GnExcept
    GnMergeAll
    GnGather
    GnUpdated
    GnNever
derive ^Eq, ^Show

# A kind's word, which names its node when nothing else does.
KindWord: fn GnKind -> Text
fn KindWord k = match k:
    GnNamed: "named"
    GnAnswer: "answer"
    GnStarted: "started"
    GnDeferred: "deferred"
    GnPort: "port"
    GnMerge: "merge"
    GnUnion: "union"
    GnBoth: "both"
    GnExcept: "except"
    GnMergeAll: "mergeall"
    GnGather: "gather"
    GnUpdated: "updated"
    GnNever: "never"

type Out = record:
    pipe: unbounded fn Ex, (unbounded fn Ex -> [Do]) -> [Do]
    sink: Sk

# Where a firing goes: another node's method, a combinator's stamped input, a hold, a
# request field, the root's result, an `@Defer`, `@Run`'s machine.
type Sk = choice:
    SkNode Nat
    SkIn Nat, Nat
    SkHold Text
    SkRequest Pos, Text
    SkResult
    SkArm Text
    SkCycle Text, Text, Nat
    SkUp Text
    SkPort Text
    # `@Machine`: the state hold, the step function's path, the output node.
    SkMachine Text, Text, Nat

# A place of the block: its position, its level as the program's `crate::Elem` (its
# snapshot, `to_pod` for the document), and when a live field reads a dynamic its getter
# (the patch pass pulls it after the tick, docs/backend.md "Marks").
type Place = record:
    pos: Pos
    level: Ex
    getter: Text
    reads: [Read]

# What a dynamic reads, for the marks (docs/backend.md, "Marks"): a hold or a dynamic
# `let`'s getter of this node by its field or method name, or, in a row, one of its block's
# read through the parent (gap DY), whose writes in the block mark the rows.
type Read = choice:
    OwnRead Text
    ParentRead Text
derive ^Eq, ^Show

HasRead: fn [Read], Read -> Bool
fn HasRead rs, r = Fold rs, False, \|seen, x| seen or x == r

AddRead: fn [Read], Read -> [Read]
fn AddRead rs, r = if HasRead rs, r: rs else: Push rs, r

UnionReads: fn [Read], [Read] -> [Read]
fn UnionReads xs, ys = Fold ys, xs, \|acc, y| AddRead acc, y

# What a block (or an inlined widget) gives back.
type Wres = choice:
    WrEv EvRef
    WrDyn Ex, [Read], RsTy
    WrPlain Ex, RsTy
    WrUnit
    # A host's output: its child's result, the first part of the line's tuple pattern, and
    # the child's document, the second part (pick HO).
    WrHosted Wres, Bn

# The state of lowering one node.
type Wx = record:
    lx: Lx
    node: Text
    pos: Pos
    gns: [Gn]
    fields: [((Text, RsTy, Text))]
    inits: [((Text, Ex))]
    lets: [Do]
    build: [Do]
    places: [Place]
    # The places whose element answers an event: position, the graph node the answer fires,
    # its type, and the tag's `Answer` accessor (a hosted place is answered typed, pick HO).
    answers: [((Pos, Nat, RsTy, Text))]
    started: [Nat]
    defers: [((Text, Nat))]
    getters: [MethDef]
    dynReads: (Text ==> [Read])
    taken: [Text]
    fallible: Bool
    depth: Nat
    result: Wres
    rows: [NodeDef]
    builders: [ForDef]
    buildHolds: [Read]
    upSink: Text
    gens: [GenDef]
    genHolds: [((Text, [Read]))]
    ports: [Text]
    subs: [((Text, Text, RsTy))]
    parentEnv: Env
    # The hosts of the block (`@HostDocument`, `@HostSome`), in order (pick HO): host `k`
    # (from 1) is `hosts[k - 1]`, and a position of scope `k` is a place of its child.
    hosts: [HostDef]
    # The places whose element answers a dynamic: position, the hold, its type, and the
    # tag's `Answer` accessor. An answer or a push there writes the hold.
    dynPlaces: [((Pos, Text, RsTy, Text))]
    # The hosts' fields, `hosts[k - 1].name` (`host_k`): kept apart for the positions'
    # spelling.
    scopes: [Text]
    # Where this node's own places (scope 0) go: nowhere when `nil`, the World's document;
    # when set, an enclosing host's document, and the parent's method that this node calls
    # when a place of its own may have moved (`host_k_moved` of the owner for a row of a
    # hosted child's `for`, `document_moved` of a row of such a row).
    hostedBy: ?Text
    # The root's dynamic result: what it reads and its type (the World hears it at the
    # build and whenever it moves).
    rootDyn: ?((Ex, [Read], RsTy))
    # The `for`s whose rows read the block: what the rows read of it, by builder (gap DY).
    rowMarks: [RowMarks]
    # The `for`s' rows, lowered and waiting for the block's heights (pick RE).
    pending: [PendingRow]
    # A row's: the heights above which its block's names are written, by the name the row
    # reads through the parent, set when the row is finished (pick RE).
    floors: (Text ==> Nat)
    # The node's structural dynamics (pick ST), each kept as a snapshot taken in the
    # construction step: a host's child document, a `for`'s gathered dynamic.
    snaps: [SnapDef]
    # A row whose result its block gathers (pick ST): the block's method that marks the
    # gathered snapshot, and the row's reads behind the result, a write of which calls it.
    resultMoved: ?((Text, [Read]))
    # A host's dynamic answers to its child's places (`@ $d`, round 3 DY): the owner's
    # getter for each, and what it reads, a write behind which fires the getter's port.
    dynAnswers: [((Text, [Read]))]
    # The holds and dynamic `let`s whose value at the build stands in a local, `{f}_init`,
    # bound in the build environment under `{name}#init`: what a supplier's dynamic answer
    # reads while the owner's node is being made (round 3 DY).
    inited: [Text]

# A `for`'s rows' (or a `rebuild`'s generation's) reads of their block, as the block's own
# names (gap DY): the builder's field; what the rows' places read, whose writes in the block
# mark every row; and the names the rows' `!Updated` nodes read, a write behind one of
# which tells every row through its `parent_wrote_{m}` (pick RE; a generation hears none,
# `UpdatedGaps`).
type RowMarks = record:
    builder: Text
    reads: [Read]
    wrote: [Text]
    kind: RowKind

# A host of the block (`@HostDocument`, `@HostSome`; pick HO): its line's position, its
# field (`host_k`, `k` the scope of its child's places), and that scope.
type HostDef = record:
    pos: Pos
    name: Text
    scope: Nat

# A structural dynamic of the node (Semantics ch. 7, "Structural dynamics"; pick ST): its
# getter `name` answers a snapshot, `prism_rtl::Snapshot` in the field `{name}_snap`, which
# the construction step takes from the live computation `{name}_now` once the structure
# behind it has settled: before the host's `for` over `$doc` runs (the child's builders
# have), or after the gathering `for` has built its rows. `eq` says the snapshot compares,
# so its update event fires only when the value moved; `what` names it in a fault.
type SnapDef = record:
    name: Text
    ty: RsTy
    eq: Bool
    builder: Text
    before: Bool
    what: Text

# A `for`'s row, lowered but not finished: its `!Updated` nodes over what it reads through
# the parent sit above the block's writers of it, so the row's heights wait for the block's
# (pick RE), and the block's gather sits one above the rows' heights.
type PendingRow = record:
    wx: Wx
    qk: Text
    params: [((Text, RsTy))]
    gather: ?Nat

# The names a node's own methods and the `Node` interface take.
let nodeHooks = [["path", "build", "wake", "started", "deferred", "answer", "push", "swap", "leave", "patch", "clean_up", "edges", "release", "leave_row", "remove_places"]]

# A fresh node state: its fields, initializers, getters, dynamic reads and taken names given,
# no graph and no places yet. `?hostedBy` is set for a row of a hosted child's `for` or
# `rebuild` (its places are the enclosing host's; the name is the parent's method it tells
# when one may have moved).
NewWx: fn Lx, Text, [((Text, RsTy, Text))], [((Text, Ex))], [MethDef], (Text ==> [Read]), [Text], Nat, ?Text -> Wx
fn NewWx lx, name, fields, inits, getters, dynReads, taken, depth, ?hostedBy:
    let hostedFields = match ?hostedBy:
        ? ignore: [[(("enclosing", hostOfTy, "the host whose document this row's places are entries of (pick HO)"))]]
        nil: [[]]
    let hostedInits = match ?hostedBy:
        ? ignore: [[(("enclosing", (XRaw "enclosing")))]]
        nil: [[]]
    Wx(lx=lx, node=name, pos=pos0, gns=[[]], fields=(Append fields, hostedFields), inits=(Append inits, hostedInits), lets=[[]], build=[[]], places=[[]], answers=[[]], started=[[]], defers=[[]], getters=getters, dynReads=dynReads, taken=(Push taken, "enclosing"), fallible=False, depth=depth, result=WrUnit, rows=[[]], builders=[[]], buildHolds=[[]], upSink="", gens=[[]], genHolds=[[]], ports=[[]], subs=[[]], parentEnv=emptyEnv, hosts=[[]], dynPlaces=[[]], scopes=[[]], hostedBy=?hostedBy, rootDyn=nil, rowMarks=[[]], pending=[[]], floors={}, snaps=[[]], resultMoved=nil, dynAnswers=[[]], inited=[[]])

# A name not yet taken in the node: `base`, else `base_2`, `base_3`.
FreshName: fn Wx, Text -> ((Text, Wx))
fn FreshName wx, base:
    let pick = if not (HasText wx.taken, base): base else: "{base}_{FirstFree wx.taken, base, 2}"
    let wx2 = update wx:
        &_.taken <= Push &_.taken, pick
    ((pick, wx2))

FirstFree: fn [Text], Text, Nat -> Nat
fn FirstFree taken, base, from = Fold (Range0 (Len taken)), from, \|n, ignore| if HasText taken, "{base}_{n}": n + 1 else: n

# A new node of the graph.
AddGn: fn Wx, Text, RsTy, GnKind, Nat -> ((Nat, Wx))
fn AddGn wx, name, ty, kind, height:
    let id = Len wx.gns
    let wx2 = update wx:
        &_.gns <= Push &_.gns, Gn(id=id, name=name, ty=ty, kind=kind, height=height, inputs=[[]], reads=[[]], floor=0, outs=[[]], structural=False)
    ((id, wx2))

# An event reference given a consumer.
Connect: fn Wx, EvRef, Sk -> Wx
fn Connect wx, r, sink = update wx:
    &_.gns <= Each &_.gns, \|n| if n.id == r.node: AddOut n, (Out(pipe=r.pipe, sink=sink)) else: n

AddOut: fn Gn, Out -> Gn
fn AddOut n, o = update n:
    &_.outs <= Push &_.outs, o

AddField: fn Wx, Text, RsTy, Text, Ex -> Wx
fn AddField wx, name, t, doc, init = update wx:
    &_.fields <= Push &_.fields, ((name, t, doc))
    &_.inits <= Push &_.inits, ((name, init))

HeightOf: fn Wx, Nat -> Nat
fn HeightOf wx, n = match wx.gns[n]:
    ? g: g.height
    nil: 0

GnOf: fn Wx, Nat -> Gn
fn GnOf wx, n = Or wx.gns[n], (Gn(id=n, name="never", ty=RsUnit, kind=GnNever, height=0, inputs=[[]], reads=[[]], floor=0, outs=[[]], structural=False))

# A plain value of the block, bound at the build and kept as a field: the build reads the
# Rust local, the methods the field.
BindPlain: fn Env, Env, Text, Text, RsTy -> ((Env, Env))
fn BindPlain benv, menv, nkey, rs, t = (((Bind benv, nkey, (BnLocal rs, Owned, t)), (Bind menv, nkey, (BnLocal "self.{rs}", Owned, t))))

# ---------------------------------------------------------------------------------------
# A node from a widget definition
# ---------------------------------------------------------------------------------------

# A widget (`@name:` or `fn @Name params:` with one clause) as a node: its parameters are
# its constructor's and fields; its block lowers into the node.
NodeDefOf: unbounded fn Lx, Text, [Pattern], Block, Scheme, Bool -> NodeDef
fn NodeDefOf lx, qk, params, body, sc, isRoot:
    let name = Camel (BareName qk)
    let ptys = match sc.ty:
        TyFn ignore, ps, ignore: ps
        otherwise: [[]]
    let wx0 = NewWx lx, name, [[]], [[]], [[]], {}, nodeHooks, 0, nil
    let ((ps, wx1, benv, menv)) = Fold (Range0 (Len params)), (([[]], wx0, emptyEnv, emptyEnv)), \|((acc, w, be, me)), i|
        let p = Or params[i], dummyPat
        let nkey = PlainBinder lx, p
        let base = if nkey == "": "arg{i}" else: Snake nkey
        let ((rs, w2)) = FreshName w, base
        let t = RustTy lx, (Peel (Or ptys[i], TyErr))
        let w3 = update w2:
            &_.fields <= Push &_.fields, ((rs, t, "a parameter"))
            &_.inits <= Push &_.inits, ((rs, (XMethod (XRaw rs), "clone", [[]])))
        let ((be2, me2)) = BindPlain be, me, nkey, rs, t
        (((Push acc, ((rs, t))), w3, be2, me2))
    let wx2 = BlockInto wx1, benv, menv, body
    let wx3 = if isRoot: RootResult wx2 else: wx2
    FinishNode wx3, qk, ps, False

# The root's result goes to the World (docs/backend.md: `cx.result(..)`).
RootResult: fn Wx -> Wx
fn RootResult wx = match wx.result:
    WrEv r: Connect wx, r, SkResult
    WrDyn x, rds, t: update wx:
        &_.rootDyn <= ? ((x, rds, t))
        &_.getters <= Push &_.getters, MethDef(name="result_value", recv=RecvRef, params=[[]], cx=CxRef, ret=RsPod, body=[[]], tail=(XMethod x, "to_pod", [[]]), doc="The root's dynamic result, pulled after the tick.")
        &_.fields <= Push &_.fields, (("result_last", (RsCell (RsOpt RsPod)), "the result the World last heard"))
        &_.inits <= Push &_.inits, (("result_last", (XRaw "RefCell::new(None)")))
        &_.build <= Push &_.build, (DoExpr (XRaw "\{ let r = node.result_value(cx); *node.result_last.borrow_mut() = Some(r.clone()); cx.result(Outcome::Value(r)); \}"))
    WrPlain x, ignore: update wx:
        &_.build <= Push &_.build, (DoExpr (XMethod (XRaw "cx"), "result", [[(XCtor "Outcome::Value", [[(XMethod x, "to_pod", [[]])]])]]))
    otherwise: wx

# A block's statements into the node, names bound before any line is read (one binding
# group): the bound events, holds and dynamics first, then every line in page order.
BlockInto: unbounded fn Wx, Env, Env, Block -> Wx
fn BlockInto wx, benv, menv, b:
    let ((wx1, be1, me1)) = Fold b.stmts, ((wx, benv, menv)), \|((w, be, me)), s| PreBind w, be, me, s
    let n = Len b.stmts
    let ((wx2, ignore, ignore)) = Fold (Range0 n), ((wx1, be1, me1)), \|((w, be, me)), i| WidgetStmt w, be, me, (Or b.stmts[i], dummyStmtL), i + 1 == n
    wx2

# Names first: a bound event is a node of its own, a hold or a bound dynamic a field, a
# dynamic `let` a getter.
PreBind: unbounded fn Wx, Env, Env, Stmt -> ((Wx, Env, Env))
fn PreBind wx, benv, menv, s = match s.kind:
    SBind p, init, ?step: match p.kind:
        PName n: PreBindName wx, benv, menv, n, (HowBound ?step)
        PTuple ps: Fold ps, ((wx, benv, menv)), \|((w, be, me)), q| match q.kind:
            PName n: PreBindName w, be, me, n, AsBind
            otherwise: ((w, be, me))
        otherwise: ((wx, benv, menv))
    SLet p, ignore, ignore: match p.kind:
        PName n: PreBindName wx, benv, menv, n, AsLet
        otherwise: ((wx, benv, menv))
    SFn c:
        let fname = DefNameText c.name
        ((wx, (Bind benv, fname, (BnLocalFn c)), (Bind menv, fname, (BnLocalFn c))))
    otherwise: ((wx, benv, menv))

# How a line binds its name: `$x <- init then step` (a hold), `p <- e` (a bind), `let`.
type HowBound = choice:
    AsHold
    AsBind
    AsLet
derive ^Eq, ^Show

HowBound: fn ?Expr -> HowBound
fn HowBound (? ignore) = AsHold
fn HowBound nil = AsBind

PreBindName: unbounded fn Wx, Env, Env, SName, HowBound -> ((Wx, Env, Env))
fn PreBindName wx, benv, menv, n, how:
    let lx = wx.lx
    let nkey = SNameKey n
    let full = BinderTy lx, n.span
    let layer = LayerOf full
    let t = RustTy lx, (Peel full)
    let ((rs, wx1)) = FreshName wx, (Snake nkey)
    if layer == LyEv or IsSwitched full:
        let et = RustTy lx, (Peel (Peel full))
        let ((id, wx2)) = AddGn wx1, rs, et, GnNamed, 0
        let b = BnEv (EvRefOf id), t
        # Its value form (`!x` passed to a function, read by a supplier): a port the event
        # fires, made before the node so that a closure in the build can hold it.
        let pf = "{rs}_v_port"
        let pt = RsRc (RsPort et)
        let wx3 = update (Connect wx2, (EvRefOf id), (SkPort "{rs}_v")):
            &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind pf), pt), (XRaw "Rc::new(Port::new())"))
            &_.fields <= Push &_.fields, ((pf, pt, "`{nkey}` as a value: the port it fires"))
            &_.inits <= Push &_.inits, ((pf, (XRaw "{pf}.clone()")))
        let be = Bind (Bind benv, nkey, b), "{nkey}#port", (BnLocal pf, Owned, pt)
        let me = Bind (Bind menv, nkey, b), "{nkey}#port", (BnLocal "self.{pf}", Owned, pt)
        ((wx3, be, me))
    else: match ((layer, how)):
        ((LyDyn, AsLet)):
            let b = BnDyn (XMethod (XRaw "self"), rs, [[XRaw "cx"]]), [[OwnRead rs]], t
            ((wx1, (Bind benv, nkey, b), (Bind menv, nkey, b)))
        ((LyDyn, ignore)):
            let b = BnHold rs, t
            ((wx1, (Bind benv, nkey, b), (Bind menv, nkey, b)))
        otherwise:
            let ((be, me)) = BindPlain benv, menv, nkey, rs, t
            ((wx1, be, me))

# `$!a`: a dynamic of events, which `@Switch` hears (a `rebuild` handing back an event is a
# builder and a switch in one path, round 46 RD): it binds as the event its generation
# forwards.
IsSwitched: fn Ty -> Bool
fn IsSwitched t = match t:
    TySig "$", (TySig "!", ignore): True
    otherwise: False

# The binding a prebound name has.
?BindingOf: fn Env, Pattern -> ?Bn
fn ?BindingOf env, p = match p.kind:
    PName n: env.names[SNameKey n]
    PTuple ps: ? (BnParts (Each ps, \|q| ?BindingOfName env, q))
    otherwise: nil

?BindingOfName: fn Env, Pattern -> ?Bn
fn ?BindingOfName env, p = match p.kind:
    PName n: env.names[SNameKey n]
    otherwise: nil

# One statement of a widget block.
WidgetStmt: unbounded fn Wx, Env, Env, Stmt, Bool -> ((Wx, Env, Env))
fn WidgetStmt wx, benv, menv, s, last:
    let lx = wx.lx
    match s.kind:
        SBind p, e, nil:
            let ((wx2, res)) = BuildLine wx, benv, menv, e, (?BindingOf menv, p)
            let wx3 = BindRes wx2, menv, p, res
            match ((res, p.kind)):
                (((WrDyn ex, rds, t), PName n)):
                    let b = BnDyn ex, rds, t
                    ((wx3, (Bind benv, (SNameKey n), b), (Bind menv, (SNameKey n), b)))
                (((WrHosted inner, doc), PTuple ps)): BindHosted wx3, benv, menv, inner, doc, ps
                otherwise: ((wx3, benv, menv))
        SBind p, init, (? step):
            let ((wx2, be2)) = HoldLine wx, benv, menv, p, init, step
            ((wx2, be2, menv))
        SIgnore e:
            let ((wx2, ignore)) = BuildLine wx, benv, menv, e, nil
            ((wx2, benv, menv))
        SLet p, ignore, e:
            let ((wx2, be2)) = LetLine wx, benv, menv, p, e
            ((wx2, be2, menv))
        SExpr e: match e.kind:
            EFreeSigil "@", x:
                let ((res, wx2)) = ResultOf wx, benv, menv, x
                let wx3 = update wx2:
                    &_.result <= res
                ((wx3, benv, menv))
            otherwise:
                let ((wx2, res)) = BuildLine wx, benv, menv, e, nil
                let wx3 = if last: SetResult wx2, res else: wx2
                ((wx3, benv, menv))
        SEmit ignore: ((wx, benv, menv))
        SSignature ignore: ((wx, benv, menv))
        SFn c: ((wx, benv, menv))
        otherwise:
            let wx2 = update wx:
                &_.build <= Push &_.build, (RefusalDo "a statement this back end does not lower yet")
            ((wx2, benv, menv))

# A host's child's result bound to the first part of the line's pattern, whatever type
# the checker gave the name (a generic `a` in the window library's `((r, $elems))`): an
# event or a dynamic as itself, so `@ r` gives it on. The child's document is bound to the
# second part: a dynamic of the owner's, its getter `host_k_doc` (pick HO), in place of the
# hold the prebinding took it for.
BindHosted: fn Wx, Env, Env, Wres, Bn, [Pattern] -> ((Wx, Env, Env))
fn BindHosted wx, benv, menv, res, doc, ps:
    let ?r = match res:
        WrEv r: ? (BnEv r, RsUnit)
        WrDyn ex, rds, t: ? (BnDyn ex, rds, t)
        otherwise: nil
    let ((be1, me1)) = BindPart benv, menv, ps[0], ?r
    BindPart2 wx, be1, me1, ps[1], (? doc)

BindPart: fn Env, Env, ?Pattern, ?Bn -> ((Env, Env))
fn BindPart benv, menv, ?p, ?b = match ((?p, ?b)):
    ((? p, ? b)): match p.kind:
        PName n: (((Bind benv, (SNameKey n), b), (Bind menv, (SNameKey n), b)))
        otherwise: ((benv, menv))
    otherwise: ((benv, menv))

BindPart2: fn Wx, Env, Env, ?Pattern, ?Bn -> ((Wx, Env, Env))
fn BindPart2 wx, benv, menv, ?p, ?b:
    let ((be, me)) = BindPart benv, menv, ?p, ?b
    ((wx, be, me))

SetResult: fn Wx, Wres -> Wx
fn SetResult wx, res = update wx:
    &_.result <= res

# `@ v`: what the block gives back, by its layer.
ResultOf: unbounded fn Wx, Env, Env, Expr -> ((Wres, Wx))
fn ResultOf wx, benv, menv, x:
    let lx = wx.lx
    let full = TypeAt lx, x.span
    let t = RustTy lx, (Peel full)
    let ?bound = match x.kind:
        EName n: if (Len n.path) == 1: menv.names[SNameKey n] else: nil
        otherwise: nil
    match ?bound:
        ? (BnEv r, ignore): ((WrEv r, wx))
        ? (BnDyn ex, rds, bt): (((WrDyn ex, rds, bt), wx))
        otherwise: ResultOfTyped wx, benv, menv, x, full, t

ResultOfTyped: unbounded fn Wx, Env, Env, Expr, Ty, RsTy -> ((Wres, Wx))
fn ResultOfTyped wx, benv, menv, x, full, t:
    let lx = wx.lx
    match LayerOf full:
        LyEv:
            let ((r, wx2)) = EventRef wx, menv, x
            ((WrEv r, wx2))
        LyDyn:
            let ((ex, reads)) = DynamicExpr wx, menv, x
            (((WrDyn ex, reads, t), wx))
        otherwise:
            if t == RsUnit: ((WrUnit, wx))
            else: (((WrPlain (Own (ValueOf lx, benv, x)), t), wx))

# `$x <- init then step`: a `Hold` field; the step event writes it. Its initial value stands
# in the local `{f}_init` first, the hold's value at the build, which a supplier's dynamic
# answer reads while the node is being made (`InitEnv`, round 3 DY); the build environment
# binds it under `{name}#init`.
HoldLine: unbounded fn Wx, Env, Env, Pattern, Expr, Expr -> ((Wx, Env))
fn HoldLine wx, benv, menv, p, init, step:
    let lx = wx.lx
    match ?BindingOf menv, p:
        ? (BnHold f, t):
            let iv = Own (ValueOf lx, benv, init)
            let wx1 = AddField wx, f, (RsHold t), "`{PatText p}`", (XCall "Hold::new", [[XRaw "{f}_init.clone()", XRaw "cx"]])
            let ((r, wx2)) = EventRef wx1, menv, step
            let wx3 = update (Connect wx2, r, (SkHold f)):
                &_.lets <= Push &_.lets, (DoLet (PaBind "{f}_init"), iv)
                &_.inited <= Push &_.inited, f
            ((wx3, (Bind benv, "{PatText p}#init", (BnLocal "{f}_init", Owned, t))))
        otherwise: ((wx, benv))

# The build environment with every name that has a value at the build (`{name}#init`) read
# as that local: what a supplier's dynamic answer evaluates to while the owner's node is
# being made (round 3 DY). Every other name keeps its binding.
InitEnv: fn Env -> Env
fn InitEnv env = Fold (Keys env.names), env, \|en, k| match (((Len k) -? 5, env.names[k])):
    ((? n, ? b)): if (Drop k, n) == "#init": Bind en, (Take k, n), b else: en
    otherwise: en

# Whether every read behind a dynamic has a value at the build: a hold or a dynamic `let`
# with its `{f}_init`, nothing structural, nothing of a parent.
AllInited: fn Wx, [Read] -> Bool
fn AllInited wx, reads = Fold (ReadsClosed wx.dynReads, reads), True, \|ok, r| ok and match r:
    OwnRead f: HasText wx.inited, f
    ParentRead ignore: False

PatText: fn Pattern -> Text
fn PatText p = match p.kind:
    PName n: SNameKey n
    otherwise: "_"

# `let` in a widget block: an event names a node fed by its expression; a dynamic a
# getter, and, when everything it reads has a value at the build, that value in the local
# `{rs}_init` too (`InitEnv`, round 3 DY); a plain value a field computed at the build.
LetLine: unbounded fn Wx, Env, Env, Pattern, Expr -> ((Wx, Env))
fn LetLine wx, benv, menv, p, e:
    let lx = wx.lx
    match ?BindingOf menv, p:
        ? (BnEv er, t):
            let ((r, wx2)) = EventRef wx, menv, e
            let fed = RustTy lx, (Peel (Peel (TypeAt lx, e.span)))
            let r2 = match t:
                RsEvent (RsRes ignore): if fed == RsError: ErrPipe r else: r
                RsRes ignore: if fed == RsError: ErrPipe r else: r
                otherwise: r
            (((Connect wx2, r2, (SkNode er.node)), benv))
        ? (BnDyn ignore, ignore, t):
            let rs = Snake (PatText p)
            let ((ex, reads)) = DynamicExpr wx, menv, e
            let getter = MethDef(name=rs, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=ex, doc="`{PatText p}`")
            let wx2 = update wx:
                &_.getters <= Push &_.getters, getter
                &_.dynReads <= Insert &_.dynReads, rs, reads
            if AllInited wx2, reads:
                let wx3 = update wx2:
                    &_.lets <= Push &_.lets, (DoLet (PaBind "{rs}_init"), (Own (ValueOf lx, (InitEnv benv), e)))
                    &_.inited <= Push &_.inited, rs
                ((wx3, (Bind benv, "{PatText p}#init", (BnLocal "{rs}_init", Owned, t))))
            else: ((wx2, benv))
        ? (BnLocal rs, ignore, t):
            let local = Base rs
            let v = Own (ValueOf lx, benv, e)
            let f = Drop rs, 5
            let wx2 = update wx:
                &_.lets <= Push &_.lets, (DoLet (PaBind f), v)
                &_.fields <= Push &_.fields, ((f, t, "`{PatText p}`"))
                &_.inits <= Push &_.inits, ((f, (XMethod (XRaw f), "clone", [[]])))
            ((wx2, benv))
        otherwise: ((wx, benv))

# An event of `Error`s feeding a `!~T`: each firing is the `~T`'s failure.
ErrPipe: fn EvRef -> EvRef
fn ErrPipe r = EvRef(node=r.node, pipe=(\|x, K| r.pipe x, \|y| K (XCtor "Err", [[y]])))

# An owned value where a `~T` is wanted: a bare `Error` is its failure (the checker's
# pick ER lets an `Error(..)` wait for its type).
OwnAs: fn RsTy, Vl -> Ex
fn OwnAs t, v = match t:
    RsRes ignore: if (ValueTy v) == RsError: XCtor "Err", [[Own v]] else: Own v
    otherwise: Own v

# `p <- e`: an element or a blueprint, its output or result bound.
BindRes: fn Wx, Env, Pattern, Wres -> Wx
fn BindRes wx2, menv, p, res = match ?BindingOf menv, p:
        ? (BnEv er, ignore): match res:
            WrEv r: if r.node == er.node: wx2 else: Connect wx2, r, (SkNode er.node)
            otherwise: wx2
        otherwise: wx2

# A line that builds: an element (a place), a widget applied (inlined), or a builder. The
# bound name, when there is one, is where the output goes.
BuildLine: unbounded fn Wx, Env, Env, Expr, ?Bn -> ((Wx, Wres))
fn BuildLine wx, benv, menv, e, ?bound:
    let lx = wx.lx
    let full = TypeAt lx, e.span
    match e.kind:
        EGroup x: BuildLine wx, benv, menv, x, ?bound
        EWidgetBlock b: InlineBlock wx, benv, menv, b, lx
        EFor ?binders, source, body: ForLine wx, benv, menv, ?binders, source, body, e, ?bound
        ERebuild scrut, body: RebuildLine wx, benv, menv, scrut, body, e, ?bound
        EIf (CondExpr c), thenB, (? elseB): IfGenLine wx, menv, c, thenB, elseB, e
        otherwise: match Peel full:
            TyElem ignore, ignore: ElementLine wx, benv, menv, e, ?bound
            TyAt ignore, ignore: WidgetLine wx, benv, menv, e, ?bound
            otherwise:
                let wx2 = update wx:
                    &_.build <= Push &_.build, (RefusalDo "a building line this back end does not lower yet")
                ((wx2, WrUnit))

# ---------------------------------------------------------------------------------------
# Elements (docs/backend.md: each place goes out with `cx.added` in its `Level`; an answer
# calls the input method; a request field's firing is `cx.request`)
# ---------------------------------------------------------------------------------------

ElementLine: unbounded fn Wx, Env, Env, Expr, ?Bn -> ((Wx, Wres))
fn ElementLine wx, benv, menv, e, ?bound:
    let lx = wx.lx
    let ((tagName, args)) = match e.kind:
        ECall c, xs, ignore, ignore: (((TagNameOf lx, c), xs))
        EName n: (((TagNameOf lx, e), [[]]))
        otherwise: (("", [[]]))
    let full = TypeAt lx, e.span
    match lx.g.tags[tagName]:
        nil:
            let wx2 = update wx:
                &_.build <= Push &_.build, (RefusalDo "an element of an unknown tag")
            ((wx2, WrUnit))
        ? tg:
            let pos = wx.pos
            let wx1 = update wx:
                &_.pos <= NextPos &_.pos
            let structPath = PathIn lx, tg.home, (TagStruct tg.name)
            let ((liveFields, constFields, reads, wx2)) = Fold tg.fields, (([[]], [[]], [[]], wx1)), \|((lf, cf, rd, w)), ((fname, fty))|
                match ?TagArg args, fname:
                    nil: ((lf, cf, rd, w))
                    ? arg:
                        match LayerOf fty:
                            LyEv:
                                let ((r, w2)) = EventRef w, menv, arg
                                ((lf, cf, rd, (Connect w2, r, (SkRequest pos, (RequestField tg, fname)))))
                            otherwise:
                                let ((ex, rds)) = DynamicExpr w, menv, arg
                                let cv = Own (ValueOf lx, benv, arg)
                                (((Push lf, ((Snake fname, ex))), (Push cf, ((Snake fname, cv))), (UnionReads rd, rds), w))
            let live = (Len reads) > 0
            let ((getter, wx3)) = if live: FreshName wx2, (Snake (BareName tg.name)) else: (("", wx2))
            let variant = VariantOf lx, tg
            # the place's level as the program's `Elem`: read by its getter in the methods when
            # a field is live, else the constant; at the build the constant fields' value
            let level = XCtor variant, [[(XRecord structPath, (if live: liveFields else: constFields))]]
            let atBuild = XCtor variant, [[(XRecord structPath, constFields)]]
            let added = if live: XMethod (XRaw "node"), getter, [[XRaw "cx"]] else: level
            let wx4 = update wx3:
                &_.places <= Push &_.places, Place(pos=pos, level=level, getter=getter, reads=reads)
                &_.build <= if Emits wx3, pos: Push &_.build, (DoExpr (XMethod (XRaw "cx"), "added", [[(XRaw (PlaceAt wx3, "node", pos)), (XMethod added, "to_pod", [[]])]])) else: &_.build
            ElementOutput wx4, menv, tg, (ElementOut lx, tg, full), pos, ?bound, atBuild

# An element's output type at this application: the tag's, instantiated by the checker
# (`Prelude.Unwrap`'s `!a` is `!unit` where its value is `!~unit`). A type variable the
# program leaves open is the answer as it came, a `Pod`.
ElementOut: unbounded fn Lx, TagInfo, Ty -> RsTy
fn ElementOut lx, tg, full:
    let t = match Peel full:
        TyElem ignore, o: RustTy lx, (Peel o)
        otherwise: RustTy lx, (Peel tg.out)
    match t:
        RsGen ignore: RsPod
        otherwise: t

# The tag an element expression names.
TagNameOf: fn Lx, Expr -> Text
fn TagNameOf lx, c = match c.kind:
    EName n:
        let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
        Or ?qk, (Dotted n.path)
    EGroup x: TagNameOf lx, x
    otherwise: ""

?TagArg: fn [Arg], Text -> ?Expr
fn ?TagArg args, fname = Fold args, nil, \|?found, a| match a.?name:
    ? n: if n.name == fname: ? a.value else: ?found
    nil: ?found

# A request field's name in `cx.request`: set when the tag has several request fields.
RequestField: fn TagInfo, Text -> Text
fn RequestField tg, fname:
    let evs = Filter tg.fields, \|((ignore, t))| (LayerOf t) == LyEv
    if (Len evs) > 1: fname else: ""

# An element's output: an event answered at its place, a dynamic pushed to it, a plain
# value as its first value.
ElementOutput: unbounded fn Wx, Env, TagInfo, RsTy, Pos, ?Bn, Ex -> ((Wx, Wres))
fn ElementOutput wx, menv, tg, out, pos, ?bound, level:
    let lx = wx.lx
    match ?bound:
        ? (BnParts parts): BundleOutput wx, tg, out, pos, parts, level
        otherwise: ElementOutputOf wx, menv, tg, out, pos, ?bound, level

# A bundle's output (`Gui.Window`'s `((WindowId, !WindowInput))`), taken apart by its
# tuple pattern: the plain parts are the place's first value (one part itself, several a
# tuple), the event part its answers (docs/backend.md, "Answers"; the World protocol's
# bundle). A `$` part, or a second event part, is not lowered yet; nor is a bundle in a
# hosted scope, whose `Answer` variant would carry two types.
BundleOutput: unbounded fn Wx, TagInfo, RsTy, Pos, [?Bn], Ex -> ((Wx, Wres))
fn BundleOutput wx, tg, out, pos, parts, level:
    if not (Emits wx, pos):
        let wx2 = update wx:
            &_.build <= Push &_.build, (RefusalDo "a bundle ({tg.name}) in a hosted scope")
        ((wx2, WrUnit))
    else: BundleOutputOf wx, tg, out, pos, parts, level

BundleOutputOf: unbounded fn Wx, TagInfo, RsTy, Pos, [?Bn], Ex -> ((Wx, Wres))
fn BundleOutputOf wx, tg, out, pos, parts, level:
    let layers = match tg.out:
        TyTuple cs: Each cs, \|c| LayerOf c
        otherwise: [[]]
    let tys = match out:
        RsTuple ts: ts
        otherwise: [[]]
    let idx = Range0 (Len layers)
    let plainIx = Filter idx, \|i| (Or layers[i], LyPlain) == LyPlain
    let evIx = Filter idx, \|i| (Or layers[i], LyPlain) == LyEv
    let dynIx = Filter idx, \|i| (Or layers[i], LyPlain) == LyDyn
    let wx1 = BundleFirst wx, tg, pos, plainIx, tys, parts, level
    let wx2 = Fold evIx, wx1, \|w, i| BundleAnswer w, pos, (Or tys[i], RsUnit), (Or parts[i], nil)
    if (Len evIx) > 1 or (Len dynIx) > 0:
        let wx3 = update wx2:
            &_.build <= Push &_.build, (RefusalDo "a bundle with a `$` part or two event parts ({tg.name})")
        ((wx3, WrUnit))
    else: ((wx2, WrUnit))

# A bundle's plain parts, from the place's first value: each bound part a field.
BundleFirst: unbounded fn Wx, TagInfo, Pos, [Nat], [RsTy], [?Bn], Ex -> Wx
fn BundleFirst wx, tg, pos, plainIx, tys, parts, level = match plainIx:
    [[]]: wx
    otherwise:
        let one = (Len plainIx) == 1
        let plainTy = if one: Or tys[Or plainIx[0], 0], RsUnit else: RsTuple (Each plainIx, \|i| Or tys[i], RsUnit)
        let wx1 = update wx:
            &_.lets <= Append &_.lets, [[(FirstValueLet wx, pos, tg, level), (DoLet (PaBind "bundle_{PlaceText pos}"), (XDecode plainTy, (XRaw "&first_{PlaceText pos}")))]]
            &_.fallible <= True
        Fold (Range0 (Len plainIx)), wx1, \|w, k|
            let i = Or plainIx[k], 0
            match parts[i]:
                ? (? (BnLocal rs, ignore, ignore)):
                    let f = Drop rs, 5
                    let part = if one: XRaw "bundle_{PlaceText pos}" else: XRaw "bundle_{PlaceText pos}.{k}.clone()"
                    update w:
                        &_.lets <= Push &_.lets, (DoLet (PaBind f), part)
                        &_.fields <= Push &_.fields, ((f, (Or tys[i], RsUnit), "place {PlaceText pos}'s answer, part {i} of its first value"))
                        &_.inits <= Push &_.inits, ((f, (XMethod (XRaw f), "clone", [[]])))
                otherwise: w

# A bundle's event part: the place's answers.
BundleAnswer: fn Wx, Pos, RsTy, ?Bn -> Wx
fn BundleAnswer wx, pos, et, ?b:
    let t = match et:
        RsEvent inner: inner
        otherwise: et
    let ((id, wx2)) = match ?b:
        ? (BnEv er, ignore): ((er.node, wx))
        otherwise:
            let ((nm, w)) = FreshName wx, "place_{PlaceText pos}"
            AddGn w, nm, t, GnAnswer, 0
    update wx2:
        &_.answers <= Push &_.answers, ((pos, id, t, ""))

# A place's first value at the build: from the World (`cx.first_value`, by the element as
# it is built, the plain data every World answer is), or in a hosted scope from the
# enclosing host, which builds its supplier row for the place now (the one early
# construction, prism_rtl's `Host::first_value`) and answers typed, by the tag's `Answer`
# accessor. Either way the local `first_{pos}` holds the value, decoded from a `Pod` only
# from the World.
FirstValueLet: fn Wx, Pos, TagInfo, Ex -> Do
fn FirstValueLet wx, pos, tg, level:
    let missing = XCall "Fault::answer", [[XRaw "\"no first value for {tg.name}\""]]
    if Emits wx, pos:
        let asked = XMethod (XRaw "cx"), "first_value", [[(XUnary "&", (XMethod level, "to_pod", [[]]))]]
        DoLet (PaBind "first_{PlaceText pos}"), (XTry (XMethod asked, "ok_or", [[missing]]))
    else:
        let host = HostLocal wx, pos
        let asked = XTry (XMethod (XRaw host), "first_value", [[(XRaw "&{PlaceAt wx, "", pos}"), (XUnary "&", level), XRaw "cx"]])
        DoLet (PaBind "first_{PlaceText pos}"), (XTry (XMethod (XTry (XMethod asked, "ok_or", [[missing]])), (AnswerAccessor tg), [[]]))

# The host whose document a position's place is an entry of, as the build spells it (a
# local before the node exists): the host of its scope, or for a node's own places in a
# hosted scope the enclosing host, which every hosted node's `build` is given.
HostLocal: fn Wx, Pos -> Text
fn HostLocal wx, pos = if pos.scope == 0: "enclosing" else: Or wx.scopes[Dec pos.scope], ""

# A tag's variant of the program's `Answer` enum, and the accessor that takes the variant's
# value out (`ui_button`), emitted beside `crate::Elem`.
AnswerVariant: fn TagInfo -> Text
fn AnswerVariant tg = "crate::Answer::{TagStruct tg.name}"

AnswerAccessor: fn TagInfo -> Text
fn AnswerAccessor tg = Snake (TagStruct tg.name)

ElementOutputOf: unbounded fn Wx, Env, TagInfo, RsTy, Pos, ?Bn, Ex -> ((Wx, Wres))
fn ElementOutputOf wx, menv, tg, out, pos, ?bound, level:
    let lx = wx.lx
    match LayerOf tg.out:
        LyEv:
            let ((id, wx2)) = match ?bound:
                ? (BnEv er, ignore): ((er.node, wx))
                otherwise:
                    let ((nm, w)) = FreshName wx, "place_{PlaceText pos}"
                    AddGn w, nm, out, GnAnswer, 0
            let wx3 = update wx2:
                &_.answers <= Push &_.answers, ((pos, id, out, (AnswerAccessor tg)))
            ((wx3, (WrEv (EvRefOf id))))
        LyDyn:
            let ((f, wx1)) = match ?bound:
                ? (BnHold hf, ignore): ((hf, wx))
                otherwise: FreshName wx, "place_{PlaceText pos}"
            let emits = Emits wx, pos
            # a World's first value is plain data, decoded; a host's is typed already
            let first = if emits: XDecode out, (XRaw "&first_{PlaceText pos}") else: XRaw "first_{PlaceText pos}"
            let wx2 = update wx1:
                &_.lets <= Push &_.lets, (FirstValueLet wx, pos, tg, level)
                &_.fields <= Push &_.fields, ((f, RsHold out, "pushed to place {PlaceText pos}"))
                &_.inits <= Push &_.inits, ((f, (XCall "Hold::new", [[first, XRaw "cx"]])))
                &_.dynPlaces <= Push &_.dynPlaces, ((pos, f, out, (AnswerAccessor tg)))
                &_.fallible <= True
            # a World's pushes are keyed by the element: the place listens for them; a hosted
            # place's come typed from its host
            let wx3 = if emits: update wx2:
                &_.lets <= Push &_.lets, (DoLet (PaBind "{f}_element"), (XMethod level, "to_pod", [[]]))
                &_.fields <= Push &_.fields, (("{f}_element", RsPod, "place {PlaceText pos}'s element, which pushes are keyed by"))
                &_.inits <= Push &_.inits, (("{f}_element", (XRaw "{f}_element.clone()")))
                &_.build <= Push &_.build, (DoExpr (XMethod (XRaw "cx"), "listen", [[(XRaw "node.{f}_element.clone()"), (XRaw "&(node.clone() as Rc<dyn Node>)")]]))
            else: wx2
            ((wx3, (WrDyn (XMethod (XRaw "self.{f}"), "get", [[XRaw "cx"]]), [[OwnRead f]], out)))
        otherwise: match ?bound:
            ? (BnLocal rs, ignore, ignore):
                let f = Drop rs, 5
                let first = if Emits wx, pos: XDecode out, (XRaw "&first_{PlaceText pos}") else: XRaw "first_{PlaceText pos}"
                let wx2 = update wx:
                    &_.lets <= Append &_.lets, [[(FirstValueLet wx, pos, tg, level), (DoLet (PaBind f), first)]]
                    &_.fields <= Push &_.fields, ((f, out, "place {PlaceText pos}'s answer, its first value"))
                    &_.inits <= Push &_.inits, ((f, (XMethod (XRaw f), "clone", [[]])))
                    &_.fallible <= True
                ((wx2, WrUnit))
            otherwise: ((wx, WrUnit))

# ---------------------------------------------------------------------------------------
# Widgets applied in a static position: transparent (Semantics ch. 8), so their places
# take numbers in the caller's sequence, and inlined into the caller's node
# ---------------------------------------------------------------------------------------

WidgetLine: unbounded fn Wx, Env, Env, Expr, ?Bn -> ((Wx, Wres))
fn WidgetLine wx, benv, menv, e, ?bound:
    let lx = wx.lx
    let ((callee, args)) = match e.kind:
        ECall c, xs, ignore, ignore: ((c, xs))
        otherwise: ((e, [[]]))
    let qk = match callee.kind:
        EName n:
            let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
            Or ?q, ""
        otherwise: ""
    let ?target = match ?bound:
        ? (BnEv er, ignore): ? er.node
        otherwise: nil
    let ?param = match callee.kind:
        EName n: if (Len n.path) == 1: menv.names[SNameKey n] else: nil
        otherwise: nil
    match ?param:
        ? (BnWidget x, cbenv, cmenv, clx): ApplyWidgetParam wx, x, cbenv, cmenv, clx, (Len args)
        otherwise: WidgetCall wx, benv, menv, e, ?bound, qk, args, ?target

# A widget parameter applied (`@child` as a statement): its argument lowered here, in its
# caller's environments and context, so its places take this node's next positions
# (transparent, Semantics ch. 8). A blueprint parameter applied to arguments is not
# lowered yet.
ApplyWidgetParam: unbounded fn Wx, Expr, Env, Env, Lx, Nat -> ((Wx, Wres))
fn ApplyWidgetParam wx, x, cbenv, cmenv, clx, nargs:
    if nargs > 0:
        let wx2 = update wx:
            &_.build <= Push &_.build, (RefusalDo "a widget parameter applied to arguments")
        ((wx2, WrUnit))
    else: if wx.depth > 32: ((wx, WrUnit))
    else:
        let lx = wx.lx
        let inner = update wx:
            &_.lx <= clx
            &_.depth <= &_.depth + 1
        let ((done, res)) = BuildLine inner, cbenv, cmenv, x, nil
        let back = update done:
            &_.lx <= lx
            &_.depth <= wx.depth
        ((back, res))

# A widget block in a static position, `@widget:` applied: its statements lowered into this
# node in a scope of their own.
InlineBlock: unbounded fn Wx, Env, Env, Block, Lx -> ((Wx, Wres))
fn InlineBlock wx, benv, menv, b, lx:
    let inner = update wx:
        &_.result <= WrUnit
    let done = BlockInto inner, benv, menv, b
    let back = update done:
        &_.result <= wx.result
    ((back, done.result))

WidgetCall: unbounded fn Wx, Env, Env, Expr, ?Bn, Text, [Arg], ?Nat -> ((Wx, Wres))
fn WidgetCall wx, benv, menv, e, ?bound, qk, args, ?target:
    let lx = wx.lx
    match qk:
        "Prelude.@started": StartedLine wx, ?bound
        "Prelude.@Switch": SwitchLine wx, menv, args
        "Prelude.@Defer": DeferLine wx, menv, args, e, ?target
        "Prelude.@Run": RunLine wx, benv, args, e, ?target
        "Prelude.@Machine": MachineLine wx, benv, menv, args, e, ?target
        "Prelude.@HostDocument": HostLine wx, benv, menv, HostEach, args, ?bound
        "Prelude.@HostSome": HostLine wx, benv, menv, HostSome, args, ?bound
        otherwise: match lx.g.vals[qk]:
            ? v: InlineWidget wx, benv, menv, qk, v, args, e
            nil:
                let wx2 = update wx:
                    &_.build <= Push &_.build, (RefusalDo "a widget this back end does not lower yet")
                ((wx2, WrUnit))

# A host (docs/backend.md, "Hosting"; prism_rtl's `host`; pick HO): the child, a named
# widget or a widget parameter's argument, is inlined into this node in a scope of its own,
# `k`, its places counted from 0 and keyed by their path relative to the child; they go to no
# document. The host is a `for p, e <- $doc` in this node: `$doc` is the getter `host_k_doc`
# (every child place's level, a dynamic within the tick whose reads are everything the
# child's places, builders and generations read, so a write behind any of them marks the
# host's readers and rows and fires `!Updated $doc`), its rows are prism_rtl's `HostRow`s
# built by the ordinary builder from the document after the tick (R7, R8), and the way back
# is the typed dispatch `host_k_answer` from a child place's path into the child's input
# method. The node holds the host as prism_rtl's `Host` (the supplier, the rows, the two
# methods), linked to the node once it is made, since a child place's first value asks the
# host before then. The child's result is the line's first part (`WrHosted`), the document
# the second.
# The two host forms (`@HostDocument`, and `@HostSome`, whose `nil` forwards).
type HostForm = choice:
    HostEach
    HostSome
derive ^Eq, ^Show

HostLine: unbounded fn Wx, Env, Env, HostForm, [Arg], ?Bn -> ((Wx, Wres))
fn HostLine wx, benv, menv, form, args, ?bound:
    let lx = wx.lx
    let pos = wx.pos
    let k = (Len wx.scopes) + 1
    let hf = "host_{k}"
    let rowsName = "{hf}_rows"
    let docGetter = "{hf}_doc"
    let wx1 = update wx:
        &_.taken <= Append &_.taken, [[hf, rowsName, docGetter, "{docGetter}_now", "{docGetter}_snap", "{hf}_answer", "{hf}_moved"]]
    match ((args[0], args[1])):
        ((? child, ? sup)):
            # the supplier's dynamic answers (`@ $d`, round 3 DY): a getter of this node per
            # dynamic, read through the owner's link, and a port each marks
            let ((wxd, dynEnv, dynLets)) = DynamicAnswers wx1, benv, menv, hf, sup.value
            let offered = Own (ValueOf lx, dynEnv, sup.value)
            let supplier0 = match form:
                HostEach: offered
                HostSome: XCall "prism_rtl::forward_on_none", [[offered]]
            let supplier = if (Len dynLets) == 0: supplier0 else: XBlock dynLets, supplier0
            # the scope the host's rows build in: the World's, or the enclosing host's
            let enclosing = if Emits wx, pos: XRaw "None" else: XCtor "Some", [[(XCast (XRaw "{HostLocal wx, pos}.clone()"), hostOfTy)]]
            let made = XCall "prism_rtl::Host::new", [[(XRaw (PlaceAt wx, "", pos)), (XRaw "{rowsName}.clone()"), supplier, enclosing, (XRaw "{wx.node}::{docGetter}"), (XRaw "{wx.node}::{hf}_answer")]]
            let hostTy = RsNamed "Rc<prism_rtl::Host<crate::Elem, crate::Answer, {wx.node}>>", [[]]
            let rowsTy = RsNamed "prism_rtl::Rows<crate::Elem, crate::Answer>", [[]]
            let docTy = RsMap RsPath, elemTy
            let what = "the document of the child hosted at place {PlaceText pos}"
            let wx2 = update wxd:
                &_.pos <= NextPos &_.pos
                &_.lets <= Append &_.lets, [[(DoLet (PaBind rowsName), (XRaw "Rc::new(RefCell::new(Map::new()))")), (DoLet (PaBind hf), made)]]
                &_.fields <= Append &_.fields, [[((hf, hostTy, "the host at place {PlaceText pos}: its supplier, its rows, and the way back into its child (pick HO)")), ((rowsName, rowsTy, "the rows of the host at place {PlaceText pos}: `for p, e <- $doc`, one supplier blueprint per child place")), (("{docGetter}_snap", (RsSnapshot docTy), "`$doc` of the host at place {PlaceText pos}, a structural dynamic: its snapshot after the tick (pick ST)"))]]
                &_.inits <= Append &_.inits, [[((hf, (XRaw "{hf}.clone()"))), ((rowsName, (XRaw "{rowsName}.clone()"))), (("{docGetter}_snap", (XCall "Snapshot::new", [[XRaw "\"{what}\""]])))]]
                &_.hosts <= Push &_.hosts, HostDef(pos=pos, name=hf, scope=k)
                &_.snaps <= Push &_.snaps, SnapDef(name=docGetter, ty=docTy, eq=True, builder=rowsName, before=True, what=what)
                &_.getters <= Push &_.getters, (SnapGetter docGetter, docTy, "The document of the child hosted at place {PlaceText pos}, `$doc`, a structural dynamic (pick ST): the snapshot taken in the construction step, the document after the tick from then on; during propagation, the document as the tick opened.")
                &_.scopes <= Push &_.scopes, hf
                &_.builders <= Push &_.builders, ForDef(name=rowsName, pos=pos, at=(PlaceAt wx, "self", pos), keyTy=RsPath, valueTy=elemTy, rowNode="prism_rtl::HostRow::<crate::Elem, crate::Answer>", keyed=True, source=docGetter, parent="self.{hf}.clone()", passed=[[]])
                &_.buildHolds <= AddRead &_.buildHolds, (OwnRead docGetter)
                &_.rowMarks <= Push &_.rowMarks, RowMarks(builder=rowsName, reads=[[OwnRead docGetter]], wrote=[[]], kind=ForRow)
                &_.fallible <= True
            let inner = update wx2:
                &_.pos <= ScopePos k
                &_.result <= WrUnit
            let ((done, res)) = BuildLine inner, benv, menv, child.value, nil
            # the child's: its places (at any depth of scopes, a nested host's included), its
            # builders' sources and its generations' sources, and what its rows read of this
            # node, as this node's own reads
            let childPlaces = Drop done.places, (Len wx2.places)
            let childBuilds = Filter done.buildHolds, \|h| not (HasRead wx2.buildHolds, h)
            let childGens = Fold (Drop done.genHolds, (Len wx2.genHolds)), [[]], \|acc, ((ignore, hs))| UnionReads acc, hs
            let childRows = Fold (Drop done.rowMarks, (Len wx2.rowMarks)), [[]], \|acc, rm| UnionReads acc, rm.reads
            let docReads = Fold childPlaces, (UnionReads (UnionReads childBuilds, childGens), childRows), \|acc, pl| UnionReads acc, pl.reads
            let InScope = \|p| p.scope == k
            let getter = HostDocGetter "{docGetter}_now", pos, (Filter childPlaces, \|pl| InScope pl.pos), (Filter (Drop done.builders, (Len wx2.builders)), \|b| InScope b.pos), (Filter (Drop done.gens, (Len wx2.gens)), \|gd| InScope gd.pos)
            let back = update done:
                &_.pos <= wx2.pos
                &_.result <= wx.result
                &_.getters <= Push &_.getters, getter
                &_.dynReads <= Insert &_.dynReads, docGetter, docReads
            let docBn = BnDyn (XMethod (XRaw "self"), docGetter, [[XRaw "cx"]]), [[OwnRead docGetter]], docTy
            ((back, (WrHosted res, docBn)))
        otherwise:
            let wx2 = update wx1:
                &_.pos <= NextPos &_.pos
                &_.build <= Push &_.build, (RefusalDo "a host without its child or its supplier")
            ((wx2, (WrHosted WrUnit, (BnLocal "()", Owned, RsUnit))))

# A supplier's dynamic answers (`@ $d`, `$d` a hold or a derived dynamic of this node; round
# 3 DY): each `@ x` of the supplier whose `x` is a dynamic that is not a constant gets a
# getter of this node, `host_k_dyn_j`, that reads it at the read point, and a port,
# `host_k_dyn_j_port`, fired by a write behind it (`HoldWritten`), so the blueprint's
# updates push the child's place the next tick. The supplier is made before the node, so it
# reads the getter through the owner's link, `host_k_owner`, linked at the build; while the
# node is being made (an early row's first value) it reads the dynamic's value at the build,
# `InitEnv`. Bound for `PureBlueprint` under `#owner` and `#dyn{span}`; the locals the
# supplier's closure moves in are cloned first (`dynLets`). A dynamic answer reading what has
# no value at the build (a pushed place, a structural dynamic, a later `let`) is refused
# there, loudly.
DynamicAnswers: unbounded fn Wx, Env, Env, Text, Expr -> ((Wx, Env, [Do]))
fn DynamicAnswers wx, benv, menv, hf, sup:
    let lx = wx.lx
    let dyns = Fold (ExprsIn sup), [[]], \|acc, x| match x.kind:
        EFreeSigil "@", y: match ?DynamicAnswer lx, y:
            ? d: Push acc, ((y, d))
            nil: acc
        otherwise: acc
    if (Len dyns) == 0: ((wx, benv, [[]]))
    else:
        let owner = "{hf}_owner"
        let wx1 = update wx:
            &_.taken <= Push &_.taken, owner
            &_.lets <= Push &_.lets, (DoLet (PaBind owner), (XRaw "prism_rtl::Link::<{wx.node}>::new()"))
            &_.build <= Push &_.build, (DoExpr (XMethod (XRaw owner), "link", [[XRaw "&node"]]))
        let env0 = Bind benv, "#owner", (BnLocal owner, Owned, RsUnit)
        let lets0 = [[(DoLet (PaBind owner), (XRaw "{owner}.clone()"))]]
        Fold (Range0 (Len dyns)), ((wx1, env0, lets0)), \|((w, en, ls)), j| match dyns[j]:
            ? ((y, d)):
                let name = "{hf}_dyn_{j + 1}"
                let port = "{name}_port"
                let ((ex, reads)) = DynamicExpr w, menv, d
                let t = RustTy lx, (Peel (TypeAt lx, d.span))
                if not (AllInited w, reads): ((w, en, ls))
                else:
                    let w2 = update w:
                        &_.taken <= Append &_.taken, [[name, port]]
                        &_.getters <= Push &_.getters, (MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=ex, doc="The host at `{hf}`'s dynamic answer `{SrcText lx, lx.file, y.span}`, read at the read point (round 3 DY)."))
                        &_.lets <= Push &_.lets, (DoLet (PaTyped (PaBind port), (RsRc (RsPort RsUnit))), (XRaw "Rc::new(Port::new())"))
                        &_.fields <= Push &_.fields, ((port, (RsRc (RsPort RsUnit)), "the dynamic answer `{name}` moved: its blueprints push the child's place next tick"))
                        &_.inits <= Push &_.inits, ((port, (XRaw "{port}.clone()")))
                        &_.dynAnswers <= Push &_.dynAnswers, ((name, reads))
                    ((w2, (Bind en, "#dyn{DynKey y}", (BnLocal name, Owned, t)), (Push ls, (DoLet (PaBind port), (XRaw "{port}.clone()")))))
            nil: ((w, en, ls))

# The dynamic a supplier's `@ x` answers with, when `x` is a dynamic that is not a constant:
# `x` itself, or the `d` of `$ d` when `d` is a dynamic already.
?DynamicAnswer: fn Lx, Expr -> ?Expr
fn ?DynamicAnswer lx, x:
    if (LayerOf (TypeAt lx, x.span)) != LyDyn: nil
    else: match x.kind:
        EFreeSigil "$", inner: if (LayerOf (TypeAt lx, inner.span)) == LyDyn: ? inner else: nil
        otherwise: ? x

# The key a supplier's `@ x` is bound under in the supplier's environment.
DynKey: fn Expr -> Text
fn DynKey x = "{x.span.start}:{x.span.end}"

# The hosted child's document as the owner computes it live, `host_k_doc_now` (pick HO):
# every place of the child at the read point, keyed by its path relative to the child: the
# places in the child's scope, and under each of its `for`s and `rebuild`s their rows' own
# documents. Only the snapshot (`SnapGetter`) reads it, once per tick in the construction
# step (pick ST).
HostDocGetter: fn Text, Pos, [Place], [ForDef], [GenDef] -> MethDef
fn HostDocGetter name, pos, places, builders, gens:
    let start = DoLet (PaBind "mut doc"), (XRaw "Map::new()")
    let body = DocumentBody MapInsert, places, builders, gens
    MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=(RsMap RsPath, elemTy), body=(Append [[start]], body), tail=(XRaw "doc"), doc="The document of the child hosted at place {PlaceText pos} computed live: each of its places by its path relative to the child, its level at the read point (pick HO). Read only by the snapshot `$doc` answers from (pick ST).")

# A structural dynamic's getter (pick ST): its snapshot at the read point.
SnapGetter: fn Text, RsTy, Text -> MethDef
fn SnapGetter name, t, doc = MethDef(name=name, recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=(XMethod (XRaw "self.{name}_snap"), "get", [[XRaw "cx"]]), doc=doc)

# `@started`: takes a number, makes no place, fires in the tick after the build.
StartedLine: fn Wx, ?Bn -> ((Wx, Wres))
fn StartedLine wx, ?bound:
    let wx1 = update wx:
        &_.pos <= NextPos &_.pos
    let ((id, wx2)) = match ?bound:
        ? (BnEv er, ignore): ((er.node, wx1))
        otherwise:
            let ((nm, w)) = FreshName wx1, "started"
            AddGn w, nm, RsUnit, GnStarted, 0
    let wx3 = update wx2:
        &_.started <= Push &_.started, id
    ((wx3, (WrEv (EvRefOf id))))

# `@Defer !e`: a `Defer` field armed by each firing; the next tick's `deferred` fires it.
DeferLine: unbounded fn Wx, Env, [Arg], Expr, ?Nat -> ((Wx, Wres))
fn DeferLine wx, menv, args, e, ?target:
    let lx = wx.lx
    let t = RustTy lx, (OutOf (TypeAt lx, e.span))
    let ((field, wx1)) = FreshName wx, "deferred"
    let ((id, wx2)) = match ?target:
        ? n: ((n, wx1))
        nil: AddGn wx1, "{field}_fired", t, GnDeferred, 0
    let wx3 = AddField wx2, field, (RsDefer t), "`@Defer`", (XRaw "Defer::new()")
    let wx4 = update wx3:
        &_.defers <= Push &_.defers, ((field, id))
    match args[0]:
        ? a:
            let ((r, wx5)) = EventRef wx4, menv, a.value
            (((Connect wx5, r, (SkArm field)), (WrEv (EvRefOf id))))
        nil: ((wx4, (WrEv (EvRefOf id))))

# `@Run F, x` (Semantics Appendix B, over `@started`, `@Defer` and `@Machine`): it takes
# a number for its `@started`; the job is a `Hold`, the merge `!started <| !again` cycles
# it once per tick, a `More` arms the `@Defer`, a `Finished` fires the result.
RunLine: unbounded fn Wx, Env, [Arg], Expr, ?Nat -> ((Wx, Wres))
fn RunLine wx, benv, args, e, ?target:
    let lx = wx.lx
    let t = RustTy lx, (OutOf (TypeAt lx, e.span))
    let ((p, wx1)) = FreshName wx, "run"
    let wx2 = update wx1:
        &_.pos <= NextPos &_.pos
        &_.taken <= Append &_.taken, [["{p}_job", "{p}_again", "{p}_started", "{p}_turn"]]
    let start = match args[0]:
        ? a: match a.value.kind:
            EName n:
                let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
                StartPath lx, (Or ?q, "")
            otherwise: "compile_error!(\"{loweringRefusal}an `@Run` of a function value that is not a name\")"
        nil: "compile_error!(\"{loweringRefusal}an `@Run` without its function\")"
    let x = match args[1]:
        ? a: Own (ValueOf lx, benv, a.value)
        nil: XRaw "()"
    let wx3 = AddField wx2, "{p}_job", (RsHold (RsJob t)), "`@Run`'s job (`@Machine`'s state)", (XCall "Hold::new", [[(XCall start, [[x]]), XRaw "cx"]])
    let wx4 = AddField wx3, "{p}_again", (RsDefer RsUnit), "`@Run`'s `!again`", (XRaw "Defer::new()")
    let ((s, wx5)) = AddGn wx4, "{p}_started", RsUnit, GnStarted, 0
    let ((a, wx6)) = AddGn wx5, "{p}_again", RsUnit, GnDeferred, 0
    let ((m, wx7)) = Merge wx6, "{p}_turn", RsUnit, (EvRefOf s), (EvRefOf a)
    let ((res, wx8)) = match ?target:
        ? n: ((n, wx7))
        nil: AddGn wx7, "{p}_done", t, GnNamed, 0
    let wx9 = update (Connect wx8, (EvRefOf m), (SkCycle "{p}_job", "{p}_again", res)):
        &_.started <= Push &_.started, s
        &_.defers <= Push &_.defers, (("{p}_again", a))
    ((wx9, (WrEv (EvRefOf res))))

# `@Machine step, init, !a` (Semantics Appendix B): the state a hold; each firing of
# `!a` steps it, writes the new state and fires the output when the step gives one. The
# step is a named function; a function value is not lowered yet.
MachineLine: unbounded fn Wx, Env, Env, [Arg], Expr, ?Nat -> ((Wx, Wres))
fn MachineLine wx, benv, menv, args, e, ?target:
    let lx = wx.lx
    let t = RustTy lx, (OutOf (TypeAt lx, e.span))
    let ((f, wx1)) = FreshName wx, "machine"
    let step = match args[0]:
        ? a: match a.value.kind:
            EName n:
                let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
                match ?q:
                    ? q: ValuePath lx, q
                    nil: ""
            otherwise: ""
        nil: ""
    match ((step, args[1], args[2])):
        ((sp, ? init, ? ev)) if sp != "":
            let st = RustTy lx, (Peel (TypeAt lx, init.value.span))
            let x = Own (ValueOf lx, benv, init.value)
            let wx2 = AddField wx1, "{f}_state", (RsHold st), "`@Machine`'s state", (XCall "Hold::new", [[x, XRaw "cx"]])
            let ((out, wx3)) = match ?target:
                ? n: ((n, wx2))
                nil: AddGn wx2, "{f}_fired", t, GnNamed, 0
            let ((r, wx4)) = EventRef wx3, menv, ev.value
            (((Connect wx4, r, (SkMachine "{f}_state", sp, out)), (WrEv (EvRefOf out))))
        otherwise:
            let wx2 = update wx1:
                &_.build <= Push &_.build, (RefusalDo "an `@Machine` whose step is not a named function")
            ((wx2, WrUnit))

# A user widget inlined: its parameters bound to the arguments by layer (an event to the
# caller's event, a dynamic to its reader, a plain value to a field), its block lowered
# into the caller's node with its positions in the caller's sequence.
InlineWidget: unbounded fn Wx, Env, Env, Text, ValInfo, [Arg], Expr -> ((Wx, Wres))
fn InlineWidget wx, benv, menv, qk, v, args, e:
    let lx = wx.lx
    let clauses = ClausesOf lx.g, qk
    let ?w = ?WidgetDeclOf lx.g, qk
    let ((params, ?body)) = match ?w:
        ? wd: (([[]], ? wd.body))
        nil: match clauses:
            [[c]]: match c.body:
                BodyBlock b: ((c.params, ? b))
                BodyExpr x: ((c.params, ? (Block(stmts=[[Stmt(kind=(SExpr x), span=x.span)]], inline=True, span=x.span))))
            otherwise: (([[]], nil))
    match ?body:
        nil:
            if (Len clauses) == 0:
                # A widget with no body, a builtin of the prelude this back end does not
                # lower (`@HostSome`, `@Element`, `@Machine`, ...): refused, and not taken
                # for a widget of several clauses, whose generation would lower the call
                # again, without end.
                let wx2 = update wx:
                    &_.build <= Push &_.build, (RefusalDo "the builtin widget {BareName qk}")
                ((wx2, WrUnit))
            else:
                # A widget of several clauses in a static position: the clause is chosen at
                # the build from the arguments, which are plain, so it is a generation built
                # once (a `rebuild` whose source never changes), each clause a row
                # (`ClauseRow`).
                match args[0]:
                    ? a:
                        let call = Block(stmts=[[Stmt(kind=(SExpr e), span=e.span)]], inline=True, span=e.span)
                        RebuildLine wx, benv, menv, a.value, call, e, nil
                    nil:
                        let wx2 = update wx:
                            &_.build <= Push &_.build, (RefusalDo "a widget of several clauses that takes no arguments")
                        ((wx2, WrUnit))
        ? body:
            if wx.depth > 16: ((wx, WrUnit))
            else:
                let lxc = InModuleAt lx, v.file, v.home, lx.site
                let ptys = match v.scheme.ty:
                    TyFn ignore, ps, ignore: ps
                    otherwise: [[]]
                let ((wx1, be1, me1)) = Fold (Range0 (Len params)), ((wx, emptyEnv, emptyEnv)), \|((w, be, me)), i|
                    let p = Or params[i], dummyPat
                    let nkey = PlainBinder lxc, p
                    let pty = Or ptys[i], TyErr
                    match args[i]:
                        nil: ((w, be, me))
                        ? a: BindParam w, benv, menv, be, me, nkey, pty, a.value
                let inner = update wx1:
                    &_.lx <= lxc
                    &_.depth <= &_.depth + 1
                    &_.result <= WrUnit
                let done = BlockInto inner, be1, me1, body
                let back = update done:
                    &_.lx <= lx
                    &_.depth <= wx.depth
                    &_.result <= wx.result
                ((back, done.result))

?WidgetDeclOf: fn G, Text -> ?WidgetDecl
fn ?WidgetDeclOf g, qk = Fold g.defs, nil, \|?found, d| if d.qk == qk: ?DefWidget d, ?found else: ?found

?DefWidget: fn Def, ?WidgetDecl -> ?WidgetDecl
fn ?DefWidget d, ?other = match d.body:
    DbWidget w: ? w
    otherwise: ?other

# One parameter of an inlined widget, bound in the callee's environments from an argument
# lowered in the caller's.
BindParam: unbounded fn Wx, Env, Env, Env, Env, Text, Ty, Expr -> ((Wx, Env, Env))
fn BindParam wx, cbenv, cmenv, be, me, nkey, pty, arg:
    let lx = wx.lx
    let t = RustTy lx, (Peel pty)
    match LayerOf pty:
        LyBlueprint:
            let b = BnWidget arg, cbenv, cmenv, lx
            ((wx, (Bind be, nkey, b), (Bind me, nkey, b)))
        LyEv:
            let ((r, wx2)) = EventRef wx, cmenv, arg
            let b = BnEv r, t
            ((wx2, (Bind be, nkey, b), (Bind me, nkey, b)))
        LyDyn:
            let ((ex, reads)) = DynamicExpr wx, cmenv, arg
            let b = BnDyn ex, reads, t
            ((wx, (Bind be, nkey, b), (Bind me, nkey, b)))
        otherwise:
            let ((rs, wx2)) = FreshName wx, (Snake nkey)
            let v = Own (ValueOf lx, cbenv, arg)
            let wx3 = update wx2:
                &_.lets <= Push &_.lets, (DoLet (PaBind rs), v)
                &_.fields <= Push &_.fields, ((rs, t, "`{nkey}`"))
                &_.inits <= Push &_.inits, ((rs, (XMethod (XRaw rs), "clone", [[]])))
            let ((be2, me2)) = BindPlain be, me, nkey, rs, t
            ((wx3, be2, me2))

# ---------------------------------------------------------------------------------------
# Dynamics and events inside a block
# ---------------------------------------------------------------------------------------

# A dynamic expression as its reader: the plain expression over the current values, each
# hold read at the read point (`self.x.get(cx)`), and the holds and getters it reads, for
# the marks (docs/backend.md, "Marks"). Lifting is the checker's; at one moment a lifted
# expression is the plain one.
DynamicExpr: unbounded fn Wx, Env, Expr -> ((Ex, [Read]))
fn DynamicExpr wx, menv, e:
    let v = ValueOf wx.lx, menv, e
    let reads = Fold (ExprsIn e), [[]], \|acc, x| match x.kind:
        EName n: match menv.names[SNameKey n]:
            ? (BnHold f, ignore): AddRead acc, (OwnRead f)
            ? (BnDyn ignore, rs, ignore): UnionReads acc, rs
            otherwise: acc
        otherwise: acc
    ((Own v, reads))

# A node that never fires (`never`).
NeverEvent: fn Wx, RsTy -> ((EvRef, Wx))
fn NeverEvent wx, t:
    let ((id, wx2)) = AddGn wx, "never", t, GnNever, 0
    ((EvRefOf id, wx2))

# An event expression as a reference into the block's graph (Compiler ch. 3): a pure
# transform extends the pipe and calls straight through; `<|` is a combinator, a merge
# that records its inputs and decides in the node's wake (option (c)).
EventRef: unbounded fn Wx, Env, Expr -> ((EvRef, Wx))
fn EventRef wx, menv, e:
    let lx = wx.lx
    let t = RustTy lx, (Peel (TypeAt lx, e.span))
    match e.kind:
        EGroup x: EventRef wx, menv, x
        EName n: match menv.names[SNameKey n]:
            ? (BnEv r, ignore): ((r, wx))
            otherwise: NeverEvent wx, t
        EBinary "<|", l, r:
            let ((lr, w1)) = EventRef wx, menv, l
            let ((rr, w2)) = EventRef w1, menv, r
            let ((nm, w3)) = FreshName w2, "anon"
            let ((id, w4)) = Merge w3, nm, t, lr, rr
            ((EvRefOf id, w4))
        EBinary "on", l, r:
            let ((rr, w1)) = EventRef wx, menv, r
            let value = Own (ValueOf lx, menv, l)
            ((EvRef(node=rr.node, pipe=(\|x, K| rr.pipe x, \|ignore| K value)), w1))
        ECall c, args, ignore, ignore: match CalleeKey lx, c:
            "Prelude.!Filter": FilterEvent wx, menv, args, False
            "Prelude.!Present": FilterEvent wx, menv, args, True
            "Prelude.!Gate": GateEvent wx, menv, args
            "Prelude.!Union": PairEvent wx, menv, args, GnUnion, t
            "Prelude.!Both": PairEvent wx, menv, args, GnBoth, t
            "Prelude.!Except": PairEvent wx, menv, args, GnExcept, t
            "Prelude.!MergeAll": MergeAllEvent wx, menv, args, t
            "Prelude.!Updated": UpdatedEvent wx, menv, args, t
            otherwise: EventMap wx, menv, e
        EIf (CondExpr c), thenB, (? elseB): match ((?BlockExpr thenB, ?BlockExpr elseB)):
            ((? a, ? b)): EventIf wx, menv, c, a, b, t
            otherwise: EventMap wx, menv, e
        otherwise: EventMap wx, menv, e

# `if $c: !a else: !b`, an `if` lifted to events (Type System ch. 4): each branch gated by
# the condition at its firing, the two merged.
EventIf: unbounded fn Wx, Env, Expr, Expr, Expr, RsTy -> ((EvRef, Wx))
fn EventIf wx, menv, c, a, b, t:
    let cond = AsBool (ValueOf wx.lx, menv, c)
    let ((ra, w1)) = EventRef wx, menv, a
    let ((rb, w2)) = EventRef w1, menv, b
    let ga = EvRef(node=ra.node, pipe=(\|x, K| ra.pipe x, \|y| [[(DoIf cond, (K y), [[]])]]))
    let gb = EvRef(node=rb.node, pipe=(\|x, K| rb.pipe x, \|y| [[(DoIf (XBin "==", cond, (XRaw "false")), (K y), [[]])]]))
    let ((nm, w3)) = FreshName w2, "chosen"
    let ((id, w4)) = Merge w3, nm, t, ga, gb
    ((EvRefOf id, w4))

# A block that is one expression: that expression.
?BlockExpr: fn Block -> ?Expr
fn ?BlockExpr b = match b.stmts:
    [[st]]: match st.kind:
        SExpr x: ? x
        otherwise: nil
    otherwise: nil

CalleeKey: fn Lx, Expr -> Text
fn CalleeKey lx, c = match c.kind:
    EName n:
        let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
        Or ?q, ""
    otherwise: ""

# `!Union`, `!Both`, `!Except`: combinators of two events, deciding in the wake.
PairEvent: unbounded fn Wx, Env, [Arg], GnKind, RsTy -> ((EvRef, Wx))
fn PairEvent wx, menv, args, kind, t = match ((args[0], args[1])):
    ((? a, ? b)):
        let ((ra, w1)) = EventRef wx, menv, a.value
        let ((rb, w2)) = EventRef w1, menv, b.value
        let lt = RustTy wx.lx, (Peel (TypeAt wx.lx, a.value.span))
        let rt = RustTy wx.lx, (Peel (TypeAt wx.lx, b.value.span))
        let ((nm, w3)) = FreshName w2, (KindWord kind)
        let ((id, w4)) = Combinator w3, nm, t, kind, ra, rb, lt, rt
        ((EvRefOf id, w4))
    otherwise: NeverEvent wx, t

# `!MergeAll [[!a, ..]]`: every input that fired this tick, in the list's order, one
# firing of the list (a combinator of as many inputs as the literal has). A list that is
# not a literal is not lowered yet.
MergeAllEvent: unbounded fn Wx, Env, [Arg], RsTy -> ((EvRef, Wx))
fn MergeAllEvent wx, menv, args, t = match args[0]:
    ? a: match a.value.kind:
        EArray es:
            let et = match t:
                RsArray x: x
                otherwise: RsUnit
            let ((nm, w1)) = FreshName wx, "merged"
            let ((id, w2)) = AddGn w1, nm, t, GnMergeAll, 1
            let ins = Each (Range0 (Len es)), \|i| "{nm}_{i}"
            let w3 = Fold ins, w2, \|w, f| AddField w, f, (RsStamped et), "an input of `!MergeAll`", (XRaw "Stamped::new()")
            let w4 = update w3:
                &_.gns <= Each &_.gns, \|n| if n.id == id: WithInputs n, ins else: n
            let w5 = Fold (Range0 (Len es)), w4, \|w, i|
                let ((r, w6)) = EventRef w, menv, (Or es[i], a.value)
                Connect w6, r, (SkIn id, i)
            ((EvRefOf id, w5))
        otherwise:
            let ((r, w1)) = NeverEvent wx, t
            let w2 = update w1:
                &_.build <= Push &_.build, (RefusalDo "`!MergeAll` of a list that is not a literal")
            ((r, w2))
    nil: NeverEvent wx, t

# `!Updated $d`: the event half of a dynamic (Semantics R3; README pick UP). A graph node
# of kind "updated", decided in the wake like a merge, one above every node whose sink
# writes a hold the dynamic reads: a write to one of them sets the node's `_moved` flag and
# asks the wake; the decision takes the flag (once a tick, so a double firing cannot
# happen) and fires the dynamic's value after the tick, read through `Cx::after`. A sample
# of the same dynamic in that tick reads the value as the tick opened (R2). The node keeps
# the dynamic's reads; they are closed over the dynamic `let`s and the writers found when
# the node is finished, since a `let $b` may follow its `!Updated`.
UpdatedEvent: unbounded fn Wx, Env, [Arg], RsTy -> ((EvRef, Wx))
fn UpdatedEvent wx, menv, args, t = match args[0]:
    ? a:
        let ((ex, reads)) = DynamicExpr wx, menv, a.value
        let ((nm, w1)) = FreshName wx, "updated"
        let ((id, w2)) = AddGn w1, nm, t, GnUpdated, 1
        let w3 = AddField w2, "{nm}_moved", (RsNamed "Cell<bool>", [[]]), "a hold `!{nm}`'s dynamic reads was written this tick", (XRaw "Cell::new(false)")
        let w4 = update w3:
            &_.gns <= Each &_.gns, \|n| if n.id == id: WithReads n, reads else: n
            &_.getters <= Push &_.getters, (MethDef(name="{nm}_value", recv=RecvRef, params=[[]], cx=CxRef, ret=t, body=[[]], tail=ex, doc="The dynamic `!{nm}` is the event half of, which the wake reads after the tick."))
        ((EvRefOf id, w4))
    nil: NeverEvent wx, t

# `!Filter !?a` fires the present values; `!Present` fires `unit` for them.
FilterEvent: unbounded fn Wx, Env, [Arg], Bool -> ((EvRef, Wx))
fn FilterEvent wx, menv, args, isUnit:
    match args[0]:
        nil: NeverEvent wx, RsUnit
        ? a:
            let ((r, w1)) = EventRef wx, menv, a.value
            let bound = if isUnit: PaWild else: PaBind "w"
            let pipe = \|x, K| r.pipe x, \|y| [[(DoIfLet (PaCtor "Some", [[bound]]), y, (K (XRaw (if isUnit: "()" else: "w"))), [[]])]]
            ((EvRef(node=r.node, pipe=pipe), w1))

# `!Gate $b, !e` fires `!e` while `$b` reads true.
GateEvent: unbounded fn Wx, Env, [Arg] -> ((EvRef, Wx))
fn GateEvent wx, menv, args = match args[1]:
    nil: NeverEvent wx, RsUnit
    ? a:
        let ((r, w1)) = EventRef wx, menv, a.value
        let cond = match args[0]:
            ? b: AsBool (ValueOf wx.lx, menv, b.value)
            nil: XRaw "false"
        let pipe = \|x, K| r.pipe x, \|y| [[(DoIf cond, (K y), [[]])]]
        ((EvRef(node=r.node, pipe=pipe), w1))

# Any other event expression maps the one event among its operands: the event's value is
# bound at its place in the source, and the expression lowers as a plain one over it.
EventMap: unbounded fn Wx, Env, Expr -> ((EvRef, Wx))
fn EventMap wx, menv, e:
    let lx = wx.lx
    let t = RustTy lx, (Peel (TypeAt lx, e.span))
    let evs = Filter (Operands e), \|x| (LayerOf (TypeAt lx, x.span)) == LyEv
    match evs:
        [[one]]:
            let ((r, w1)) = EventRef wx, menv, one
            let et = RustTy lx, (Peel (TypeAt lx, one.span))
            let k = PlaceKey lx, one.span
            let pipe = \|x, K| r.pipe x, \|y| K (Own (ValueOf lx, (BindSpan menv, k, (FiringValue y, et)), e))
            ((EvRef(node=r.node, pipe=pipe), w1))
        otherwise: NeverEvent wx, t

# A firing's value where an expression reads it: a local is a place, anything else an
# owned temporary.
FiringValue: fn Ex, RsTy -> Vl
fn FiringValue (XRaw n), t = VlPlace (XRaw n), Owned, t
fn FiringValue x, t = VlOwned x, t

# The operands of an expression, one level down.
Operands: fn Expr -> [Expr]
fn Operands e = match e.kind:
    ECall c, args, ignore, ignore: Append [[c]], (Each args, \|a| a.value)
    EMethod r, ignore, args: Append [[r]], (Each args, \|a| a.value)
    EBinary ignore, l, r: [[l, r]]
    EUnary ignore, x: [[x]]
    EFreeSigil ignore, x: [[x]]
    EGroup x: [[x]]
    EField r, ignore, ignore: [[r]]
    EIndex r, i: [[r, i]]
    ETuple es: es
    EArray es: es
    EMap kvs: Fold kvs, [[]], \|acc, ((k, v))| Append acc, [[k, v]]
    ELit l: match l.kind:
        LText segs: Fold segs, [[]], \|acc, sg| match sg:
            SegPlaceholder x: Push acc, x
            otherwise: acc
        otherwise: [[]]
    otherwise: [[]]

# A merge `l <| r` (CXb: the left wins): a combinator node with a stamped field per input.
Merge: fn Wx, Text, RsTy, EvRef, EvRef -> ((Nat, Wx))
fn Merge wx, name, t, l, r = Combinator wx, name, t, GnMerge, l, r, t, t

# A combinator of two inputs: its stamped fields, its node, its inputs connected.
Combinator: fn Wx, Text, RsTy, GnKind, EvRef, EvRef, RsTy, RsTy -> ((Nat, Wx))
fn Combinator wx, name, t, kind, l, r, lt, rt:
    let ((id, wx1)) = AddGn wx, name, t, kind, 1
    let wx2 = AddField wx1, "{name}_left", (RsStamped lt), "`{name}`'s left input", (XRaw "Stamped::new()")
    let wx3 = AddField wx2, "{name}_right", (RsStamped rt), "its right input", (XRaw "Stamped::new()")
    let wx4 = update wx3:
        &_.gns <= Each &_.gns, \|n| if n.id == id: WithInputs n, [["{name}_left", "{name}_right"]] else: n
    ((id, (Connect (Connect wx4, l, (SkIn id, 0)), r, (SkIn id, 1))))

WithInputs: fn Gn, [Text] -> Gn
fn WithInputs n, ins = update n:
    &_.inputs <= ins

WithReads: fn Gn, [Read] -> Gn
fn WithReads n, reads = update n:
    &_.reads <= reads

# ---------------------------------------------------------------------------------------
# The node, finished: heights, methods, the `Node` hooks, the build
# ---------------------------------------------------------------------------------------

# Heights (Q-B8; Compiler ch. 3, "The analyses"): a source is at 0, a named event at the
# height of what fires it, a combinator one above its inputs; an "updated" node's inputs
# are the writers of the holds its dynamic reads (its `reads`, closed). The graph is
# acyclic within a tick (the checker's prompt-cycle check), so as many rounds as nodes
# settle it.
Heights: fn [Gn] -> [Gn]
fn Heights gns = Fold gns, gns, \|cur, ignore| Each cur, \|n| HeightStep cur, n

HeightStep: fn [Gn], Gn -> Gn
fn HeightStep gns, n:
    let feeders = Filter gns, \|m| Fold m.outs, False, \|f, o| f or Feeds o.sink, n
    let top = Fold feeders, 0, \|hi, m| Max hi, m.height
    let h = match n.kind:
        GnNamed: top
        kind: if IsComb kind: Max (top + 1), n.floor else: n.height
    update n:
        &_.height <= h

# The kinds decided in the wake, one above what feeds them.
IsComb: fn GnKind -> Bool
fn IsComb k = match k:
    GnMerge: True
    GnUnion: True
    GnBoth: True
    GnExcept: True
    GnMergeAll: True
    GnUpdated: True
    otherwise: False

# Whether a sink feeds a node: by firing it, or, for an "updated" node, by writing a hold
# its dynamic reads (`SkHold`, and `@Machine`'s state).
Feeds: fn Sk, Gn -> Bool
fn Feeds (SkNode m), n = m == n.id
fn Feeds (SkIn m, ignore), n = m == n.id
fn Feeds (SkCycle ignore, ignore, m), n = m == n.id
fn Feeds (SkMachine f, ignore, m), n = m == n.id or Writes f, n
fn Feeds (SkHold f), n = Writes f, n
fn Feeds other, n = False

# Whether a write to hold `f` moves an "updated" node's dynamic.
Writes: fn Text, Gn -> Bool
fn Writes f, n = Moves (OwnRead f), n

# Whether a write behind a read (a hold of this node, or a name of the block read through
# the parent) moves an "updated" node's dynamic.
Moves: fn Read, Gn -> Bool
fn Moves r, n = n.kind == GnUpdated and HasRead n.reads, r

# The holds a place reads, through the getters of dynamic `let`s.
ReadsClosed: fn (Text ==> [Read]), [Read] -> [Read]
fn ReadsClosed dyn, reads = Fold (Range0 4), reads, \|acc, ignore| Fold acc, acc, \|a, r| UnionReads a, (GetterReads dyn, r)

# What a read reaches through the node's getters: a dynamic `let`'s reads; a hold, or a
# read through the parent, nothing more.
GetterReads: fn (Text ==> [Read]), Read -> [Read]
fn GetterReads dyn, (OwnRead n) = Or dyn[n], [[]]
fn GetterReads dyn, (ParentRead ignore) = [[]]

# The same closure stopped at the structural dynamics (pick ST): a snapshot's name is kept
# and what lies behind it is not entered, so a structural `!Updated` node's reads are the
# snapshots it reads and the holds it reads beside them. A write behind a snapshot moves the
# node only through the snapshot, when it is taken and has moved.
ReadsStopping: fn (Text ==> [Read]), [Text], [Read] -> [Read]
fn ReadsStopping dyn, roots, reads = Fold (Range0 4), reads, \|acc, ignore| Fold acc, acc, \|a, r| match r:
    OwnRead n: if HasText roots, n: a else: UnionReads a, (GetterReads dyn, r)
    ParentRead ignore: a

# Whether a closed read set reaches a structural dynamic.
ReachesSnap: fn [Text], [Read] -> Bool
fn ReachesSnap roots, reads = Fold reads, False, \|f, r| f or match r:
    OwnRead n: HasText roots, n
    ParentRead ignore: False

SnapNames: fn Wx -> [Text]
fn SnapNames wx = Each wx.snaps, \|sn| sn.name

WakeConst: fn [Nat], Nat -> Text
fn WakeConst heights, h = if (Len heights) <= 1: "WAKE" else: "WAKE_{h}"

SelfCall: fn Text, [Ex] -> Do
fn SelfCall m, args = DoExpr (XMethod (XRaw "self"), m, (Push args, (XRaw "cx")))

# What a firing does at its sink.
SinkCode: fn Sinks, Sk, Ex -> [Do]
fn SinkCode sk, target, y = match target:
    SkNode m: [[(SelfCall (GnOf sk.wx, m).name, [[y]])]]
    SkIn m, i:
        let g = GnOf sk.wx, m
        Append [[DoExpr (XMethod (XRaw "self.{Or g.inputs[i], ""}"), "set", [[y, XRaw "cx"]])]], (AskWake sk, g.height)
    SkHold f: Append [[(DoExpr (XMethod (XRaw "self.{f}"), "set", [[y, XRaw "cx"]]))]], (HoldWritten sk, f)
    SkRequest pos, field:
        let fieldEx = if field == "": XRaw "None" else: XRaw "Some(\"{field}\")"
        # a hosted place's request goes to its host: out with a forwarded element, else nowhere
        if Emits sk.wx, pos: [[DoExpr (XMethod (XRaw "cx"), "request", [[(XRaw (PlaceAt sk.wx, "self", pos)), fieldEx, (XMethod y, "to_pod", [[]])]])]]
        else: [[DoExpr (XMethod (XRaw "cx"), "keep", [[(XMethod (XRaw (HostField sk.wx, pos)), "request", [[(XRaw "&{PlaceAt sk.wx, "self", pos}"), fieldEx, (XMethod y, "to_pod", [[]]), XRaw "cx"]])]])]]
    SkResult: [[DoExpr (XMethod (XRaw "cx"), "result", [[(XCtor "Outcome::Fired", [[(XMethod y, "to_pod", [[]])]])]])]]
    SkArm f: [[DoExpr (XMethod (XRaw "self.{f}"), "arm", [[y, XRaw "self.clone()", XRaw "cx"]])]]
    SkMachine f, step, out:
        let stepped = XCall step, [[(XRaw "&self.{f}.get(cx)"), (XUnary "&", y)]]
        Append [[(DoLet (PaTuple [[PaBind "machine_s", PaBind "machine_b"]]), stepped), DoExpr (XMethod (XRaw "self.{f}"), "set", [[XRaw "machine_s", XRaw "cx"]]), (DoIfLet (PaCtor "Some", [[PaBind "machine_b"]]), (XRaw "machine_b"), [[(SelfCall (GnOf sk.wx, out).name, [[XRaw "machine_b"]])]], [[]])]], (MovedMarks sk, f)
    SkPort f: [[DoExpr (XMethod (XMethod (XRaw "self.{f}_port"), "fire", [[y, XRaw "cx"]]), "ok", [[]])]]
    SkUp m:
        let keyed = (Len (Filter sk.wx.fields, \|((f, ignore, ignore))| f == "key")) > 0
        let args = if keyed: [[(XMethod (XRaw "self.key"), "clone", [[]]), y, XRaw "cx"]] else: [[y, XRaw "cx"]]
        [[(DoIfLet (PaCtor "Some", [[PaBind "parent"]]), (XMethod (XRaw "self.parent"), "upgrade", [[]]), [[DoExpr (XMethod (XRaw "parent"), m, args)]], [[]])]]
    SkCycle job, again, res:
        let more = [[DoExpr (XMethod (XRaw "self.{job}"), "set", [[XRaw "next", XRaw "cx"]]), DoExpr (XMethod (XRaw "self.{again}"), "arm", [[XRaw "()", XRaw "self.clone()", XRaw "cx"]])]]
        let fin = [[(SelfCall (GnOf sk.wx, res).name, [[XRaw "b"]])]]
        [[(DoMatch (XMethod (XMethod (XRaw "self.{job}"), "get", [[XRaw "cx"]]), "cycle", [[]]), [[(((PaCtor "prism_rtl::Turn::More", [[PaBind "next"]]), more)), (((PaCtor "prism_rtl::Turn::Finished", [[PaBind "b"]]), fin))]])]]

# What a write of hold `f` (or of the pseudo-hold behind a host's document, `host_k_doc`,
# when a node of the hosted child wrote behind it) marks, after the `set` (docs/backend.md,
# "Marks"): the node is dirtied when a place reads it; a hosted node tells its host that a
# place of its may have moved (`document_moved`); the builders and generations over it are
# listed for the build; the rows of its `for`s that read it are dirtied and told; the
# "updated" nodes over it are told and the wake asked. The `set` is the caller's: an answer
# or a push at a place writes the place's hold the same way (`DynPlaceWrite`).
HoldWritten: fn Sinks, Text -> [Do]
fn HoldWritten sk, f:
    let r = OwnRead f
    let readByPlace = HasRead sk.dirty, r
    # a hosted node's places are all entries of hosts' documents: nothing of its own to patch
    let ((dirty, told)) = match sk.wx.?hostedBy:
        ? ignore: (([[]], (if readByPlace: [[DoExpr (XMethod (XRaw "self"), "document_moved", [[XRaw "cx"]])]] else: [[]])))
        nil: (((if readByPlace: [[DoExpr (XMethod (XRaw "cx"), "dirty", [[XRaw "self.clone()"]])]] else: [[]]), [[]]))
    let stales = Fold sk.wx.genHolds, [[]], \|acc, ((gname, hs))| if HasRead (ReadsClosed sk.wx.dynReads, hs), r: Push acc, (DoExpr (XMethod (XRaw "self.{gname}_stale"), "set", [[XRaw "true"]])) else: acc
    let rowMarks = Fold sk.wx.rowMarks, [[]], \|acc, rm| Append acc, (RowWritten sk.wx, rm, r)
    let builds = (HasRead sk.builds, r) or (Len stales) > 0
    # the build is listed once: here, or by the marks when a structural dynamic moves
    let rebuildIt = if builds and not (ListsBuild sk, r): Append stales, [[DoExpr (XMethod (XRaw "cx"), "build_later", [[XRaw "self.clone()"]])]] else: stales
    # a row whose result its block gathers tells the block when a hold behind the result moves
    let gathered = match sk.wx.?resultMoved:
        ? ((m, rds)): if HasRead rds, r: [[(DoIfLet (PaCtor "Some", [[PaBind "parent"]]), (XMethod (XRaw "self.parent"), "upgrade", [[]]), [[DoExpr (XMethod (XRaw "parent"), m, [[XRaw "cx"]])]], [[]])]] else: [[]]
        nil: [[]]
    Append (Append (Append (Append (Append dirty, told), rebuildIt), rowMarks), gathered), (MovedMarks sk, f)

# The host whose document a position's place is an entry of, as the methods spell it: the
# host of its scope, or for a node's own places in a hosted scope the enclosing host.
HostField: fn Wx, Pos -> Text
fn HostField wx, pos = "self.{HostLocal wx, pos}"

# A hold written: every "updated" node whose dynamic reads it is told (its `_moved` flag),
# and the wake asked at its height, once per height.
MovedMarks: fn Sinks, Text -> [Do]
fn MovedMarks sk, f = MovedBy sk, (OwnRead f)

# A write behind a read: the "updated" nodes over it told and the wake asked at their
# heights; a structural one (pick ST) told and the build listed, where it is decided; the
# snapshots the write lies behind marked, and the build listed to take them.
MovedBy: fn Sinks, Read -> [Do]
fn MovedBy sk, r:
    let moved = Filter sk.wx.gns, \|g| Moves r, g
    let flags = Each moved, \|g| DoExpr (XMethod (XRaw "self.{g.name}_moved"), "set", [[XRaw "true"]])
    let heights = SortNats (Fold (Filter moved, \|g| not g.structural), [[]], \|acc, g| AddNat acc, g.height)
    let marks = Each (SnapsBehind sk.wx, r), \|sn| DoExpr (XMethod (XRaw "self.{sn.name}_snap"), "mark", [[XRaw "cx"]])
    let listed = if ListsBuild sk, r: [[DoExpr (XMethod (XRaw "cx"), "build_later", [[XRaw "self.clone()"]])]] else: [[]]
    # a host's dynamic answer over it: its port fired, so its blueprints push next tick
    let answers = Each (Filter sk.wx.dynAnswers, \|((ignore, rds))| HasRead (ReadsClosed sk.wx.dynReads, rds), r), \|((name, ignore))| DoExpr (XMethod (XMethod (XRaw "self.{name}_port"), "fire", [[XRaw "()", XRaw "cx"]]), "ok", [[]])
    Append (Append (Append (Fold heights, flags, \|acc, h| Append acc, (AskWake sk, h)), marks), listed), answers

# The snapshots a write behind a read marks: the structural dynamic itself (a host's
# `host_k_moved` writes behind `host_k_doc` with no hold), or one whose reads reach it.
SnapsBehind: fn Wx, Read -> [SnapDef]
fn SnapsBehind wx, r = Filter wx.snaps, \|sn| r == (OwnRead sn.name) or HasRead (ReadsClosed wx.dynReads, [[OwnRead sn.name]]), r

# Whether a write behind a read lists the node's build through its marks: a structural
# "updated" node moved, or a snapshot marked.
ListsBuild: fn Sinks, Read -> Bool
fn ListsBuild sk, r = (Fold sk.wx.gns, False, \|f, g| f or (g.structural and Moves r, g)) or (Len (SnapsBehind sk.wx, r)) > 0

FiringCode: unbounded fn Sinks, Gn, Ex -> [Do]
fn FiringCode sk, g, x:
    let many = (Len g.outs) > 1 and not (IsCopy g.ty)
    let xv = if many: XMethod x, "clone", [[]] else: x
    Fold g.outs, [[]], \|acc, o| Append acc, (o.pipe xv, \|y| SinkCode sk, o.sink, y)

FinishNode: unbounded fn Wx, Text, [((Text, RsTy))], Bool -> NodeDef
fn FinishNode wx0, qk, params, isRow:
    # An "updated" node's reads, closed over the dynamic `let`s now that every line is in;
    # its height is one above the writers of those holds. The `for` rows are finished with
    # the block's heights known (pick RE), the gathers one above their rows'.
    let roots = SnapNames wx0
    let closedGns = Each wx0.gns, \|g| if g.kind == GnUpdated: CloseUpdated wx0.dynReads, roots, g else: g
    let ((rowDefs, gns2)) = FinishPending wx0, (Heights closedGns)
    let isGen = isRow and (Len (Filter wx0.fields, \|((f, ignore, ignore))| f == "key")) == 0
    let wx = update wx0:
        &_.gns <= Heights gns2
        &_.build <= Append &_.build, (UpdatedGaps wx0, closedGns, isGen)
        &_.rows <= Fold rowDefs, &_.rows, \|acc, rd| Append (Push acc, rd), rd.children
    let combs = Filter wx.gns, \|g| ((IsComb g.kind) and not g.structural) or g.kind == GnGather
    let structural = Filter wx.gns, \|g| g.structural
    let heights = SortNats (Fold combs, [[]], \|acc, g| AddNat acc, g.height)
    let many = (Len heights) > 1
    let consts = Each heights, \|h| (((WakeConst heights, h), h, "merges' height above the node's inputs"))
    let live = Filter wx.places, \|p| p.getter != ""
    let rootReads = match wx.?rootDyn:
        ? ((ignore, rds, ignore)): ReadsClosed wx.dynReads, rds
        nil: [[]]
    let dirtyHolds = Fold live, rootReads, \|acc, p| UnionReads acc, (ReadsClosed wx.dynReads, p.reads)
    let buildHolds = ReadsClosed wx.dynReads, wx.buildHolds
    let sinks = Sinks(wx=wx, dirty=dirtyHolds, builds=buildHolds, heights=heights, many=many)
    let evMethods = Each (Filter wx.gns, \|g| g.kind != GnNever), \|g| MethDef(name=g.name, recv=RecvRc, params=[[(("v", g.ty))]], cx=CxMut, ret=RsUnit, body=(FiringCode sinks, g, (XRaw "v")), tail=(XRaw "()"), doc=(GnDoc g))
    let gatherIns = Each (Filter wx.gns, \|g| g.kind == GnGather), \|g| GatherIn sinks, g
    let placeGetters = Each live, \|p| MethDef(name=p.getter, recv=RecvRef, params=[[]], cx=CxRef, ret=elemTy, body=[[]], tail=p.level, doc="Place {PlaceText p.pos}'s level, read at the read point.")
    let wakeBody = if many: [[(WakeByHeight combs, heights)]] else: Each combs, \|g| Decide g
    let startedBody = Each wx.started, \|st| SelfCall (GnOf wx, st).name, [[XRaw "()"]]
    let deferredBody = Each wx.defers, \|((f, id))| DoIfLet (PaCtor "Some", [[PaBind "v"]]), (XMethod (XRaw "self.{f}"), "fired", [[XRaw "cx"]]), [[(SelfCall (GnOf wx, id).name, [[XRaw "v"]])]], [[]]
    # the patch pass sends the World the places that go to it; a hosted place is read out
    # of its host's document
    let patchBody0 = Fold (Filter live, \|p| Emits wx, p.pos), [[]], \|acc, p| Append acc, (PatchPlace wx, p)
    let patchBody = Append patchBody0, (RootDynPatch wx)
    let buildBody = Append (BuildSteps sinks, False), (Each structural, \|g| StructuralFire g)
    let pushBody = Each (Filter wx.dynPlaces, \|((pos, ignore, ignore, ignore))| Emits wx, pos), \|((pos, f, t, ignore))| DoIf (XBin "==", (XRaw "element"), (XRaw "&self.{f}_element")), (DynPlaceWrite sinks, f, (XDecode t, (XRaw "v"))), [[]]
    let hooks = Filter [[(("wake", wakeBody)), (("started", startedBody)), (("deferred", deferredBody)), (("build", buildBody)), (("push", pushBody)), (("patch", patchBody))]], \|((ignore, b))| (Len b) > 0
    let startedReg = if (Len wx.started) > 0: [[DoExpr (XMethod (XRaw "cx"), "on_started", [[XRaw "node.clone()"]])]] else: [[]]
    # the hosts linked to the node, then the builders and the snapshots (a place over a
    # structural dynamic reads its snapshot at the build), then the places out
    let links = Each wx.hosts, \|h| DoExpr (XMethod (XRaw "node.{h.name}"), "link", [[XRaw "&node"]])
    let rowsBuilt = Append links, (BuildSteps sinks, True)
    let subscribed = Each wx.subs, \|((ev, m, t))| DoExpr (XCall "subscribe_row", [[XRaw "&node", (XMethod (XRaw "node.parent"), "upgrade", [[]]), XRaw "|p| &p.{ev}_port", XRaw "|n, v, cx| n.{m}(v.clone(), cx)", XRaw "&node.{m}_sub"]])
    # the World's answers, by path, to the places that go to it; a hosted place is answered
    # typed by its host, through `host_k_answer` (the places of scope `k`) or `deliver` (a
    # hosted node's own)
    let answers = Append (Each (Filter wx.answers, \|((pos, ignore, ignore, ignore))| Emits wx, pos), \|((pos, id, t, ignore))| AnswerArm wx, pos, id, t), (Each (Filter wx.dynPlaces, \|((pos, ignore, ignore, ignore))| Emits wx, pos), \|((pos, f, t, ignore))| DynAnswerArm sinks, pos, f, t)
    let forwards = Append (Each (Filter wx.builders, \|b| Emits wx, b.pos), \|b| (((PosPat b.pos, ", Segment::Key(k), rest @ .."), (ForwardAnswer b)))), (Each (Filter wx.gens, \|gd| Emits wx, gd.pos), \|gd| (((PosPat gd.pos, ", Segment::Gen(g), rest @ .."), (ForwardGen gd))))
    let hostMethods = Fold wx.hosts, [[]], \|acc, h| Append acc, [[(TypedDispatch sinks, "{h.name}_answer", h.scope), (HostMoved sinks, h)]]
    let gatheredMoved = Each (Filter wx.snaps, \|sn| not sn.before), \|sn| GatheredMoved sn
    let hostedMethods = match wx.?hostedBy:
        ? ignore: [[(TypedDispatch sinks, "deliver", 0), (DocumentGetter wx)]]
        nil: [[]]
    let movedMethod = match wx.?hostedBy:
        ? m: [[DocumentMoved m]]
        nil: [[]]
    let rowMethods = if isRow: RowMethods wx else: [[]]
    let heard = Each (RowHears wx), \|m| MethDef(name="parent_wrote_{m}", recv=RecvRc, params=[[]], cx=CxMut, ret=RsUnit, body=(Append (MovedBy sinks, (ParentRead m)), (Fold wx.rowMarks, [[]], \|acc, rm| Append acc, (RowWritten wx, rm, (ParentRead m)))), tail=(XRaw "()"), doc="The block wrote behind its `{m}`, which this row reads through the parent: the `!Updated` nodes over it are told and the wake asked at their heights; the rows of this row's own `for`s that read it are marked.")
    let top = Fold wx.gns, 0, \|hi, g| Max hi, g.height
    let wakesField = if many: [[(("wakes", RsWakes, "the heights asked for this tick, lowest first"))]] else: [[]]
    let wakesInit = if many: [[(("wakes", (XRaw "Wakes::default()")))]] else: [[]]
    let genFields = Fold wx.gens, [[]], \|acc, gd| Append acc, [[((gd.name, (RsCell (RsOpt (RsNamed "Rc<dyn Row>", [[]]))), "the current generation of the `rebuild` at place {PlaceText gd.pos}")), (("{gd.name}_count", (RsNamed "Cell<u32>", [[]]), "how many generations it has built")), (("{gd.name}_stale", (RsNamed "Cell<bool>", [[]]), "its source changed since it was built"))]]
    let genInits = Fold wx.gens, [[]], \|acc, gd| Append acc, [[((gd.name, (XRaw "RefCell::new(None)"))), (("{gd.name}_count", (XRaw "Cell::new(0)"))), (("{gd.name}_stale", (XRaw "Cell::new(false)")))]]
    let portFields = Each wx.ports, \|pn| (("{pn}_port", (RsPort (GnTyNamed wx, pn)), "`!{pn}`, which rows subscribe to"))
    let portInits = Each wx.ports, \|pn| (("{pn}_port", (XRaw "Port::new()")))
    let subFields = Each wx.subs, \|((ev, m, t))| (("{m}_sub", (RsNamed "Cell<Option<Handle>>", [[]]), "the subscription to the parent's `!{ev}`"))
    let subInits = Each wx.subs, \|((ev, m, t))| (("{m}_sub", (XRaw "Cell::new(None)")))
    let queuedFields = Each structural, \|g| (("{g.name}_queued", (RsStamped RsUnit), "`!{g.name}` is queued for the next tick (pick ST)"))
    let queuedInits = Each structural, \|g| (("{g.name}_queued", (XRaw "Stamped::new()")))
    let fallible = wx.fallible or isRow or (Len wx.builders) > 0 or (Len wx.gens) > 0
    NodeDef(name=wx.node, prism=(BareName qk), doc=(DefinitionText wx.lx, qk), params=params, fields=(Append (Append (Append (Append (Append wx.fields, wakesField), genFields), portFields), subFields), queuedFields), consts=consts, lets=wx.lets, inits=(Append (Append (Append (Append (Append wx.inits, wakesInit), genInits), portInits), subInits), queuedInits), build=(Append (Append (Append rowsBuilt, wx.build), subscribed), startedReg), fallible=fallible, methods=(Append (Append (Append (Append (Append (Append (Append (Append evMethods, gatherIns), placeGetters), wx.getters), rowMethods), heard), hostMethods), gatheredMoved), movedMethod), answers=(Append answers, forwards), hooks=hooks, builders=wx.builders, wakes=many, children=wx.rows, gens=wx.gens, subs=wx.subs, top=top, rowKind=(if isRow: (if isGen: GenerationRow else: ForRow) else: NotARow), hosted=hostedMethods)

# A node of the hosted child wrote behind the host's document (a row's own hold): what a
# write of a hold the document reads marks, with no hold set (`HoldWritten` of the getter,
# whose reads are the child's).
HostMoved: fn Sinks, HostDef -> MethDef
fn HostMoved sk, h = MethDef(name="{h.name}_moved", recv=RecvRc, params=[[]], cx=CxMut, ret=RsUnit, body=(HoldWritten sk, "{h.name}_doc"), tail=(XRaw "()"), doc="A node of the child hosted at place {PlaceText h.pos} wrote behind its document: the readers of `$doc` are marked as for a write of a hold it reads (pick HO).")

# An "updated" node's reads closed (pick UP), and whether it is structural (pick ST): when
# the closure reaches a snapshot, the node is decided at the end of the construction step,
# and its reads stop at the snapshots it reaches.
CloseUpdated: fn (Text ==> [Read]), [Text], Gn -> Gn
fn CloseUpdated dyn, roots, g:
    let closed = ReadsClosed dyn, g.reads
    if ReachesSnap roots, closed:
        let stopped = WithReads g, (ReadsStopping dyn, roots, g.reads)
        update stopped:
            &_.structural <= True
    else: WithReads g, closed

# The construction step of the node (pick ST): the builders and generations scope by scope,
# a hosted child's before its host's (a host's `for` over `$doc` runs after the child's own
# structure has settled, in the one `build` of the node they are inlined into; siblings keep
# their order), with each structural dynamic's snapshot taken where the structure behind it
# has settled: a host's `$doc` before the host's `for` over it builds its rows, a `for`'s
# gathered dynamic after its builder. In the build (`atBuild`, spelled from `node`) every
# snapshot is taken; in `Node::build` a marked one is taken and compared, and the structural
# "updated" nodes over a snapshot that moved are told.
BuildSteps: fn Sinks, Bool -> [Do]
fn BuildSteps sk, atBuild:
    let wx = sk.wx
    let recv = if atBuild: "node" else: "self"
    let Take = \|sn| if atBuild: SnapTakeAtBuild sn else: SnapTake sk, sn
    let Builder = \|b|
        let before = Each (Filter wx.snaps, \|sn| sn.before and sn.builder == b.name), Take
        let after = Each (Filter wx.snaps, \|sn| (not sn.before) and sn.builder == b.name), Take
        Append (Push before, (DoExpr (XTry (XMethod (XRaw recv), "{b.name}_build", [[XRaw "cx"]])))), after
    let Gen = \|gd| if atBuild: DoExpr (XTry (XMethod (XRaw recv), "{gd.name}_build", [[XRaw "cx"]])) else: DoIf (XMethod (XRaw "self.{gd.name}_stale"), "replace", [[XRaw "false"]]), [[DoExpr (XTry (XMethod (XRaw "self"), "{gd.name}_build", [[XRaw "cx"]]))]], [[]]
    Fold (Range0 ((Len wx.scopes) + 1)), [[]], \|acc, i|
        let k = Or ((Len wx.scopes) -? i), 0
        let builders = Fold (Filter wx.builders, \|b| b.pos.scope == k), [[]], \|a, b| Append a, (Builder b)
        Append (Append acc, builders), (Each (Filter wx.gens, \|gd| gd.pos.scope == k), Gen)

# The snapshot taken at the build: the structure as built.
SnapTakeAtBuild: fn SnapDef -> Do
fn SnapTakeAtBuild sn = DoExpr (XMethod (XRaw "node.{sn.name}_snap"), "take", [[(XMethod (XRaw "node"), "{sn.name}_now", [[XRaw "cx"]]), XRaw "cx"]])

# The snapshot taken in `Node::build` when a write marked it: compared where the type has
# equality, so the structural "updated" nodes over it are told only when it moved; else told
# whenever it was marked (R3 as loosened: a spurious firing is allowed, a double one never).
SnapTake: fn Sinks, SnapDef -> Do
fn SnapTake sk, sn:
    let now = XMethod (XRaw "self"), "{sn.name}_now", [[XRaw "cx"]]
    let told = Each (Filter sk.wx.gns, \|g| g.structural and HasRead g.reads, (OwnRead sn.name)), \|g| DoExpr (XMethod (XRaw "self.{g.name}_moved"), "set", [[XRaw "true"]])
    let taken = if sn.eq: [[(DoIf (XMethod (XRaw "self.{sn.name}_snap"), "take_compared", [[now, XRaw "cx"]]), told, [[]])]]
        else: Append [[(DoExpr (XMethod (XRaw "self.{sn.name}_snap"), "take", [[now, XRaw "cx"]]))]], told
    DoIf (XMethod (XRaw "self.{sn.name}_snap"), "marked", [[XRaw "cx"]]), taken, [[]]

# A structural "updated" node decided, the last act of the construction step (pick ST): told
# this tick (a snapshot it reads moved, or a hold it reads beside them was written), its
# firing is queued for the start of the next tick, which is owed, once; the value is read
# then, at that tick's read point: the snapshots and holds after this tick.
StructuralFire: fn Gn -> Do
fn StructuralFire g:
    let queue = DoExpr (XMethod (XRaw "cx"), "answer_later", [[XRaw "Box::new(move |cx| \{ let v = node.{g.name}_value(cx); node.{g.name}(v, cx); Ok(()) \})"]])
    DoIf (XRaw "self.{g.name}_moved.replace(false) && !self.{g.name}_queued.fired(cx)"), [[(DoExpr (XMethod (XRaw "self.{g.name}_queued"), "set", [[XRaw "()", XRaw "cx"]])), (DoLet (PaBind "node"), (XRaw "self.clone()")), queue]], [[]]

# A row's hold behind its gathered result moved (pick ST): the block marks the gathered
# dynamic's snapshot and lists its build to take it.
GatheredMoved: fn SnapDef -> MethDef
fn GatheredMoved sn = MethDef(name="{sn.name}_moved", recv=RecvRc, params=[[]], cx=CxMut, ret=RsUnit, body=[[(DoExpr (XMethod (XRaw "self.{sn.name}_snap"), "mark", [[XRaw "cx"]])), (DoExpr (XMethod (XRaw "cx"), "build_later", [[XRaw "self.clone()"]]))]], tail=(XRaw "()"), doc="A row's result moved: the `for`'s gathered dynamic is marked, and its snapshot taken after the builder (pick ST).")

# A hosted row's own places, for its host's document (`Row::document`): each by its path
# relative to the row, and under its `for`s and `rebuild`s their rows'.
DocumentGetter: fn Wx -> MethDef
fn DocumentGetter wx:
    let IsOwn = \|p| p.scope == 0
    let body = DocumentBody VecPush, (Filter wx.places, \|pl| IsOwn pl.pos), (Filter wx.builders, \|b| IsOwn b.pos), (Filter wx.gens, \|gd| IsOwn gd.pos)
    MethDef(name="document", recv=RecvRef, params=[[]], cx=CxRef, ret=(RsNamed "Vec<(Path, crate::Elem)>", [[]]), body=(Append [[(DoLet (PaBind "mut doc"), (XRaw "Vec::new()"))]], body), tail=(XRaw "doc"), doc="The row's own places, entries of its host's document, by their paths relative to the row (pick HO).")

# A hosted row's place may have moved (a hold it reads was written): its parent is told,
# and tells its host in turn.
DocumentMoved: fn Text -> MethDef
fn DocumentMoved m = MethDef(name="document_moved", recv=RecvRc, params=[[]], cx=CxMut, ret=RsUnit, body=[[(DoIfLet (PaCtor "Some", [[PaBind "parent"]]), (XMethod (XRaw "self.parent"), "upgrade", [[]]), [[DoExpr (XMethod (XRaw "parent"), m, [[XRaw "cx"]])]], [[]])]], tail=(XRaw "()"), doc="A place of this row may have moved: its host's document moved, and the host's readers and rows are marked (pick HO).")

# The entries of a document: each place at the read point (its getter when a field is live,
# else its constant), and under each `for` and `rebuild` the rows' own documents, keyed
# under the place's path. `Add` spells the collection's insert of `path, e`: into the `doc`
# map (`MapInsert`) or onto the `doc` vector (`VecPush`).
DocumentBody: fn (fn Ex, Ex -> Do), [Place], [ForDef], [GenDef] -> [Do]
fn DocumentBody Add, places, builders, gens:
    let statics = Each places, \|pl|
        let level = if pl.getter == "": pl.level else: XMethod (XRaw "self"), pl.getter, [[XRaw "cx"]]
        Add (XRaw "Path::root().at({pl.pos.at})"), level
    let rows = Each builders, \|b| DoFor (PaTuple [[PaBind "k", PaBind "row"]]), (XRaw "self.{b.name}.borrow().iter()"), [[(DoFor (PaTuple [[PaBind "p", PaBind "e"]]), (XRaw "row.document(cx)"), [[(Add (XRaw "Path::root().at({b.pos.at}).child(Segment::Key(k.to_pod())).join(&p)"), (XRaw "e"))]])]]
    let generations = Each gens, \|gd| DoIfLet (PaCtor "Some", [[PaBind "row"]]), (XRaw "self.{gd.name}.borrow().as_ref()"), [[(DoLet (PaBind "g"), (XRaw "self.{gd.name}_count.get() - 1")), (DoFor (PaTuple [[PaBind "p", PaBind "e"]]), (XRaw "row.document(cx)"), [[(Add (XRaw "Path::root().at({gd.pos.at}).child(Segment::Gen(g)).join(&p)"), (XRaw "e"))]])]], [[]]
    Append (Append statics, rows), generations

MapInsert: fn Ex, Ex -> Do
fn MapInsert path, e = DoExpr (XMethod (XRaw "doc"), "insert", [[path, e]])

VecPush: fn Ex, Ex -> Do
fn VecPush path, e = DoExpr (XMethod (XRaw "doc"), "push", [[XTuple [[path, e]]]])

# A World's answer at a place whose element answers a dynamic (a push, or an answer by
# path): the hold written from the plain data, the node patched.
DynAnswerArm: fn Sinks, Pos, Text, RsTy -> ((Text, Ex))
fn DynAnswerArm sk, pos, f, t = (((PosPat pos, ""), (XBlock (DynPlaceWrite sk, f, (XDecode t, (XRaw "v"))), (XRaw "()"))))

# The write of a place's hold from the answer `value`: the hold set, and everything a
# hold's sink marks (the node patched, the builders and rows over it, the "updated" nodes
# over it told at height 0, before any wake, so the wake is only asked).
DynPlaceWrite: fn Sinks, Text, Ex -> [Do]
fn DynPlaceWrite sk, f, value = Append [[DoExpr (XMethod (XRaw "self.{f}"), "set", [[value, XRaw "cx"]])]], (HoldWritten sk, f)

# What an "updated" node cannot be given: a read of anything that is not a hold a sink of
# this node writes, a dynamic `let` over such, or a structural dynamic of the node (its
# snapshot decides the node at the end of construction, pick ST); in a generation, a name of
# the block read through the parent. A row's reads through the parent are checked where the
# block is finished, as the block's own: a name the row hears a write behind must stand over
# a hold of the block or a name the block hears itself, and not over a structural dynamic of
# the block, which the block decides at the end of its construction step, where the row's
# node has no decision of its own (gap SU). Refused loudly rather than lowered to an event
# that never fires, or one that reads a snapshot before it is taken.
UpdatedGaps: fn Wx, [Gn], Bool -> [Do]
fn UpdatedGaps wx, gns, isGen:
    let holds = Fold wx.fields, [[]], \|acc, ((f, t, ignore))| if IsHold t: Push acc, f else: acc
    let derived = Keys wx.dynReads
    let roots = SnapNames wx
    let own = Fold (Filter gns, \|g| g.kind == GnUpdated), [[]], \|acc, g| Fold g.reads, acc, \|a, r| match r:
        # a generation is not told of its block's writes (it has no `parent_wrote`): refused
        # loudly rather than an event that never fires
        ParentRead f: if isGen: Push a, (RefusalDo "`!Updated` of a dynamic in a generation that reads its block's `{f}`, which the block does not tell a generation of (gap DY)") else: a
        OwnRead f:
            if (HasText holds, f) or (HasText derived, f) or (HasText roots, f): a
            else: Push a, (RefusalDo "`!Updated` of a dynamic that reads `{f}`, which no sink of this node writes (no height for its event)")
    Fold wx.pending, own, \|acc, p| Fold (RowHears p.wx), acc, \|a, m|
        let behind = ReadsClosed wx.dynReads, [[OwnRead m]]
        let written = Fold behind, False, \|w, r| w or match r:
            OwnRead h: HasText holds, h
            ParentRead ignore: True
        if (HasText roots, m) or ReachesSnap roots, behind: Push a, (RefusalDo "`!Updated` of a dynamic in a row that reads its block's `{m}`, a structural dynamic the block decides at the end of its construction step (gap SU)")
        else: if written or (HasText derived, m): a
        else: Push a, (RefusalDo "`!Updated` of a dynamic in a row that reads its block's `{m}`, which no sink of the block writes (no height for its event)")

# The block's `for` rows finished with the block's heights (pick RE): each `!Updated` node
# of a row sits at least one above the block's writers of the holds behind what it reads
# through the parent, the floors of the block's own parent names inherited; the block's
# gather of a row's firings sits one above the row's heights.
FinishPending: unbounded fn Wx, [Gn] -> (([NodeDef], [Gn]))
fn FinishPending wx, gns = Fold wx.pending, (([[]], gns)), \|((defs, cur)), p|
    let floors = Fold (RowHears p.wx), {}, \|acc, m| Insert acc, m, (ParentFloor wx, cur, [[ParentRead m]])
    let floored = update p.wx:
        &_.floors <= floors
        &_.gns <= Each &_.gns, \|g| if g.kind == GnUpdated: WithFloor g, (ParentFloor wx, cur, (ReadsClosed p.wx.dynReads, g.reads)) else: g
    let def = FinishNode floored, p.qk, p.params, True
    let next = match p.?gather:
        ? gid: Each cur, \|g| if g.id == gid: WithHeight g, (def.top + 1) else: g
        nil: cur
    (((Push defs, def), next))

# One above the block's writers of the holds behind what a row reads through the parent,
# and the block's own floor for what it reads through its parent in turn.
ParentFloor: fn Wx, [Gn], [Read] -> Nat
fn ParentFloor wx, gns, reads = Fold reads, 0, \|hi, r| match r:
    ParentRead m: Fold (ReadsClosed wx.dynReads, [[OwnRead m]]), hi, \|h2, hr| match hr:
        OwnRead f: Fold gns, h2, \|h3, g| if WritesHold g, f: Max h3, (g.height + 1) else: h3
        ParentRead up: Max h2, (Or wx.floors[up], 0)
    OwnRead ignore: hi

WritesHold: fn Gn, Text -> Bool
fn WritesHold g, f = Fold g.outs, False, \|acc, o| acc or SinkWritesHold o.sink, f

SinkWritesHold: fn Sk, Text -> Bool
fn SinkWritesHold (SkHold h), f = h == f
fn SinkWritesHold (SkMachine h, ignore, ignore), f = h == f
fn SinkWritesHold other, f = False

WithFloor: fn Gn, Nat -> Gn
fn WithFloor g, h = update g:
    &_.floor <= h

WithHeight: fn Gn, Nat -> Gn
fn WithHeight g, h = update g:
    &_.height <= h

# The block's names a row must hear a write behind (pick RE): what its `!Updated` nodes
# read through the parent, and what its own rows hear, closed over its dynamic `let`s. The
# block tells the row through `parent_wrote_{m}`.
RowHears: fn Wx -> [Text]
fn RowHears wx:
    let fromUpdated = Fold (Filter wx.gns, \|g| g.kind == GnUpdated), [[]], \|acc, g| UnionReads acc, (ReadsClosed wx.dynReads, g.reads)
    let fromRows = Fold wx.rowMarks, [[]], \|acc, rm| UnionReads acc, (ReadsClosed wx.dynReads, (Append rm.reads, (Each rm.wrote, \|m| OwnRead m)))
    Fold (UnionReads fromUpdated, fromRows), [[]], \|acc, r| match r:
        ParentRead m: AddText acc, m
        OwnRead ignore: acc

# A write behind a read of the block (a hold of it, or a name it reads through its own
# parent): the rows of a `for` whose places read it are dirtied, and the rows that hear it
# are told through `parent_wrote_{m}`.
RowWritten: fn Wx, RowMarks, Read -> [Do]
fn RowWritten wx, rm, r:
    let dirty = if HasRead (ReadsClosed wx.dynReads, rm.reads), r: [[DoExpr (XRaw "cx.dirty(row.clone())")]] else: [[]]
    let told = Fold rm.wrote, [[]], \|acc, m| if HasRead (ReadsClosed wx.dynReads, [[OwnRead m]]), r: Push acc, (DoExpr (XRaw "row.parent_wrote_{m}(cx)")) else: acc
    let body = Append dirty, told
    if (Len body) == 0: [[]]
    else: match rm.kind:
        GenerationRow: [[(DoIfLet (PaCtor "Some", [[PaBind "row"]]), (XRaw "self.{rm.builder}.borrow().as_ref()"), body, [[]])]]
        otherwise: [[(DoFor (PaBind "row"), (XRaw "self.{rm.builder}.borrow().values()"), body)]]

# The patch pass for one live place: its level read and sent as changed.
PatchPlace: fn Wx, Place -> [Do]
fn PatchPlace wx, p:
    let pull = DoLet (PaBind p.getter), (XMethod (XRaw "self"), p.getter, [[XRaw "cx"]])
    let at = XRaw (PlaceAt wx, "self", p.pos)
    [[pull, (DoExpr (XMethod (XRaw "cx"), "changed", [[at, (XMethod (XRaw p.getter), "to_pod", [[]])]]))]]

# Whether a position's place goes out to the World's document: the node's own, when the
# node is not itself in a hosted scope. Any other place is an entry of a host's document
# (pick HO), spelled by its path relative to the hosted child.
Emits: fn Wx, Pos -> Bool
fn Emits wx, pos = pos.scope == 0 and wx.?hostedBy == nil

# A place's path as Rust spells it from `recv` (`self`, `node`, or "" in the build, before
# the node exists): the node's own path for a place that goes to the World, or, for a place
# of a host's document, its path relative to the hosted child (`Path::root().at(n)`), under
# which a host's row builds (pick HO).
PlaceAt: fn Wx, Text, Pos -> Text
fn PlaceAt wx, recv, pos:
    if Emits wx, pos: (if recv == "": "path.at({pos.at})" else: "{recv}.path.at({pos.at})")
    else: "Path::root().at({pos.at})"

# The pattern of an answer at a place, `tail` the rest of its segments.
PosPat: fn Pos, Text -> Text
fn PosPat pos, tail = "[Segment::Pos({pos.at}){tail}]"

# What the rows of a `for` or `rebuild` at the block's current position tell when a place
# of theirs may have moved: nothing when the rows' places go to the World; the host's
# `host_k_moved` for rows of a hosted child's `for`; and the parent row's `document_moved`
# for rows of a row that is itself hosted (pick HO).
?HostedRows: fn Wx -> ?Text
fn ?HostedRows wx:
    if wx.pos.scope > 0: ? "{Or wx.scopes[Dec wx.pos.scope], ""}_moved"
    else: match wx.?hostedBy:
        ? ignore: ? "document_moved"
        nil: nil

# The root's dynamic result at the patch pass: sent when it moved.
RootDynPatch: fn Wx -> [Do]
fn RootDynPatch wx = match wx.?rootDyn:
    ? ignore: [[DoExpr (XRaw "let r = self.result_value(cx); if self.result_last.borrow().as_ref() != Some(&r) \{ *self.result_last.borrow_mut() = Some(r.clone()); cx.result(Outcome::Value(r)); \}")]]
    nil: [[]]

# A World's answer at a place: the input method called with the decoded value.
AnswerArm: fn Wx, Pos, Nat, RsTy -> ((Text, Ex))
fn AnswerArm wx, pos, id, t:
    let call = XMethod (XRaw "self"), (GnOf wx, id).name, [[(XDecode t, (XRaw "v")), XRaw "cx"]]
    (((PosPat pos, ""), call))

# A host's typed answer to a place of its child (pick HO): the input method called with the
# tag's variant of `crate::Answer` taken apart (a variant of another tag is a fault).
TypedAnswerArm: fn Wx, Pos, Nat, Text -> ((Pa, [Do]))
fn TypedAnswerArm wx, pos, id, acc = (((PaLit (PosPat pos, "")), [[(SelfCall (GnOf wx, id).name, [[(XTry (XMethod (XRaw "v"), acc, [[]]))]])]]))

TypedDynArm: fn Sinks, Pos, Text, Text -> ((Pa, [Do]))
fn TypedDynArm sk, pos, f, acc = (((PaLit (PosPat pos, "")), (DynPlaceWrite sk, f, (XTry (XMethod (XRaw "v"), acc, [[]])))))

# A host's typed answer under a `for`'s or a `rebuild`'s place of its child: to the row its
# key names, or the current generation, which delivers it on (prelude `Row::deliver`).
TypedForwardArm: fn ForDef, Text -> ((Pa, [Do]))
fn TypedForwardArm b, segs:
    let rowOf = XMethod (XMethod (XMethod (XRaw "self.{b.name}"), "borrow", [[]]), "get", [[(XUnary "&", (XDecode b.keyTy, (XRaw "k")))]]), "cloned", [[]]
    (((PaLit (PosPat b.pos, ", Segment::Key(k), rest @ ..")), [[(DoLet (PaBind "row"), rowOf), (DoMatch (XRaw "row"), [[(((PaCtor "Some", [[PaBind "row"]]), [[DoExpr (XTry (XMethod (XRaw "row"), "deliver", [[XRaw "rest", XRaw "v", XRaw "cx"]]))]])), ((PaUnit "None", [[DoReturn (XRaw "Err(Fault::answer(format!(\"no row \{k\} under the hosted place \{\}\", Path({segs}.to_vec()))))")]]))]])]]))

TypedGenArm: fn GenDef -> ((Pa, [Do]))
fn TypedGenArm gd:
    let current = XMethod (XMethod (XRaw "self.{gd.name}"), "borrow", [[]]), "clone", [[]]
    let isCurrent = XBin "==", (XBin "+", (XRaw "*g"), (XRaw "1")), (XMethod (XRaw "self.{gd.name}_count"), "get", [[]])
    (((PaLit (PosPat gd.pos, ", Segment::Gen(g), rest @ ..")), [[(DoLet (PaBind "row"), current), (DoIfLet (PaCtor "Some", [[PaBind "row"]]), (XRaw "row"), [[(DoIf isCurrent, [[DoExpr (XTry (XMethod (XRaw "row"), "deliver", [[XRaw "rest", XRaw "v", XRaw "cx"]]))]], [[]])]], [[]])]]))

# The typed dispatch from a child place's path into the child's places (pick HO): the owner's
# `host_k_answer` for the places of scope `k`, and a hosted node's `deliver` for its own
# (`Row::deliver`, called by its host's rows). A place with no answer, or no place, is a
# fault of the tick: a host answers only what its child asks.
TypedDispatch: fn Sinks, Text, Nat -> MethDef
fn TypedDispatch sk, name, scope:
    let wx = sk.wx
    let InScope = \|p| p.scope == scope
    # the owner's `host_k_answer` takes the child place's path; a hosted node's `deliver`, a
    # `Row` hook, the segments under its parent's place
    let ((recv, param, segs, doc)) = if scope > 0: ((RecvRc, (("place", (RsRef RsPath))), "place.segments()", "The host at place {PlaceText (Or wx.hosts[Dec scope], dummyHost).pos} answers its child's place `place` (pick HO): into the child's input method, a hold the place's element answers, or the row of a `for` or `rebuild` under it."))
        else: ((RecvOwned, (("at", (RsNamed "&[Segment]", [[]]))), "at", "A host's answer to a place of this row's own, `at` under the row (pick HO): into the input method, a hold, or a row under it."))
    let answers = Each (Filter wx.answers, \|((pos, ignore, ignore, ignore))| InScope pos), \|((pos, id, ignore, acc))| TypedAnswerArm wx, pos, id, acc
    let dyns = Each (Filter wx.dynPlaces, \|((pos, ignore, ignore, ignore))| InScope pos), \|((pos, f, ignore, acc))| TypedDynArm sk, pos, f, acc
    let rows = Each (Filter wx.builders, \|b| InScope b.pos), \|b| TypedForwardArm b, segs
    let gens = Each (Filter wx.gens, \|gd| InScope gd.pos), \|gd| TypedGenArm gd
    let none = ((PaWild, [[DoReturn (XRaw "Err(Fault::answer(format!(\"no hosted place at \{\} to answer\", Path({segs}.to_vec()))))")]]))
    let arms = Push (Append (Append (Append answers, dyns), rows), gens), none
    MethDef(name=name, recv=recv, params=[[param, (("v", (RsRef answerTy)))]], cx=CxMut, ret=(RsNamed "Done", [[]]), body=[[(DoMatch (XRaw segs), arms)]], tail=(XRaw "Ok(())"), doc=doc)

let dummyHost = HostDef(pos=pos0, name="", scope=0)

# What the sinks' code needs of the node: the holds whose writes mark a place or a
# builder, the heights, and whether the wake dispatches by height.
type Sinks = record:
    wx: Wx
    dirty: [Read]
    builds: [Read]
    heights: [Nat]
    many: Bool

SortNats: fn [Nat] -> [Nat]
fn SortNats xs = Fold xs, [[]], \|acc, x| Append (Push (Filter acc, \|y| y < x), x), (Filter acc, \|y| not (y < x))

# Asking for a wake at a combinator's height: once per height (and, when the node has
# combinators at several heights, the height recorded, so the wake knows which ones run:
# `Node::wake` is not told the height, gap WH of the README).
AskWake: fn Sinks, Nat -> [Do]
fn AskWake sk, h:
    let c = "Self::{WakeConst sk.heights, h}"
    let ask = DoExpr (XMethod (XRaw "self.wakes"), "ask", [[XRaw c]])
    let wake = DoExpr (XMethod (XRaw "cx"), "wake", [[XRaw c, XRaw "self.clone()"]])
    if sk.many: [[ask, wake]] else: [[wake]]

# A gather's input: a row's firing, collected by key into the tick's one firing.
GatherIn: fn Sinks, Gn -> MethDef
fn GatherIn sk, g:
    let field = Or g.inputs[0], ""
    let kt = match g.ty:
        RsMap k, ignore: k
        otherwise: RsUnit
    let vt = match g.ty:
        RsMap ignore, v: v
        otherwise: RsUnit
    let current = XMethod (XMethod (XRaw "self.{field}"), "get", [[XRaw "cx"]]), "unwrap_or_default", [[]]
    let collect = [[(DoLet (PaBind "mut all"), current), (DoExpr (XMethod (XRaw "all"), "insert", [[XRaw "k", XRaw "v"]])), (DoExpr (XMethod (XRaw "self.{field}"), "set", [[XRaw "all", XRaw "cx"]]))]]
    let body = Append collect, (AskWake sk, g.height)
    MethDef(name="{g.name}_in", recv=RecvRc, params=[[(("k", kt)), (("v", vt))]], cx=CxMut, ret=RsUnit, body=body, tail=(XRaw "()"), doc="A row's firing, gathered by its key.")

Decide: fn Gn -> Do
fn Decide g = match g.kind:
    GnGather: DoIfLet (PaCtor "Some", [[PaBind "v"]]), (XMethod (XRaw "self.{Or g.inputs[0], ""}"), "take", [[XRaw "cx"]]), [[(SelfCall g.name, [[XRaw "v"]])]], [[]]
    GnMerge: MergeDecide g
    GnUpdated: UpdatedDecide g
    GnMergeAll:
        let pushes = Each g.inputs, \|f| DoIfLet (PaCtor "Some", [[PaBind "x"]]), (XMethod (XRaw "self.{f}"), "take", [[XRaw "cx"]]), [[DoExpr (XMethod (XRaw "all"), "push_back", [[XRaw "x"]])]], [[]]
        let start = DoLet (PaBind "mut all"), (XRaw "Array::new()")
        let fire = DoIf (XRaw "!all.is_empty()"), [[(SelfCall g.name, [[XRaw "all"]])]], [[]]
        DoIf (XRaw "true"), (Push (Append [[start]], pushes), fire), [[]]
    kind: PairDecide g, kind

# An "updated" node decides: the flag taken (once a tick: a hold it reads was written), the
# dynamic read after the tick, the event fired with it. No dedupe (pick UD): the event
# fires whenever the dynamic was recomputed, equal value or not.
UpdatedDecide: fn Gn -> Do
fn UpdatedDecide g = DoIf (XMethod (XRaw "self.{g.name}_moved"), "replace", [[XRaw "false"]]), [[(DoLet (PaBind "after"), (XRaw "cx.after(|cx| self.{g.name}_value(cx))")), (SelfCall g.name, [[XRaw "after"]])]], [[]]

# Both inputs read, then decided: `!Union` joins the maps (the left's keys win), `!Both`
# pairs them, `!Except` fires the left without the right.
PairDecide: fn Gn, GnKind -> Do
fn PairDecide g, kind:
    let getL = XMethod (XRaw "self.{Or g.inputs[0], ""}"), "take", [[XRaw "cx"]]
    let getR = XMethod (XRaw "self.{Or g.inputs[1], ""}"), "take", [[XRaw "cx"]]
    let both = XTuple [[getL, getR]]
    let Fire = \|x| [[(SelfCall g.name, [[x]])]]
    let sa = PaCtor "Some", [[PaBind "a"]]
    let sb = PaCtor "Some", [[PaBind "b"]]
    let some2 = PaTuple [[sa, sb]]
    let left = PaTuple [[sa, (PaUnit "None")]]
    let right = PaTuple [[(PaUnit "None"), sb]]
    let cases = match kind:
        GnUnion: [[((some2, (Fire (XCall "union", [[XRaw "&a", XRaw "&b"]])))), ((left, (Fire (XRaw "a")))), ((right, (Fire (XRaw "b")))), ((PaWild, [[]]))]]
        GnBoth: [[((some2, (Fire (XTuple [[XRaw "a", XRaw "b"]])))), ((PaWild, [[]]))]]
        otherwise: [[((left, (Fire (XRaw "a")))), ((PaWild, [[]]))]]
    DoMatch both, cases

# The wake of a node with combinators at several heights: the lowest height asked runs
# its combinators.
WakeByHeight: fn [Gn], [Nat] -> Do
fn WakeByHeight combs, heights = DoMatch (XMethod (XRaw "self.wakes"), "next", [[]]), (Push (Each heights, \|h| ((PaLit "Self::{WakeConst heights, h}", (Each (Filter combs, \|g| g.height == h), \|g| Decide g)))), ((PaWild, [[]])))

# An answer under a `for`'s place goes to the row its key names.
ForwardAnswer: fn ForDef -> Ex
fn ForwardAnswer b:
    let rowOf = XMethod (XMethod (XMethod (XRaw "self.{b.name}"), "borrow", [[]]), "get", [[(XUnary "&", (XDecode b.keyTy, (XRaw "k")))]]), "cloned", [[]]
    XBlock [[(DoLet (PaBind "row"), rowOf), (DoIfLet (PaCtor "Some", [[PaBind "row"]]), (XRaw "row"), [[DoExpr (XTry (XMethod (XRaw "row"), "answer", [[XRaw "rest", XRaw "v", XRaw "cx"]]))]], [[]])]], (XRaw "()")

IsHold: fn RsTy -> Bool
fn IsHold (RsHold ignore) = True
fn IsHold other = False

HeldTy: fn RsTy, RsTy -> RsTy
fn HeldTy (RsHold i), other = i
fn HeldTy t, other = other

# A row's own methods: its places torn down (the ones that went to the World; a hosted
# row's leave its host's document with the row), its rows' and generations' too.
RowMethods: fn Wx -> [MethDef]
fn RowMethods wx:
    let removes = Each (Filter wx.places, \|p| Emits wx, p.pos), \|p| DoExpr (XMethod (XRaw "cx"), "removed", [[(XRaw (PlaceAt wx, "self", p.pos))]])
    let nested = Append (Each wx.builders, \|b| DoExpr (XRaw "self.{b.name}.borrow().values().for_each(|row| row.leave_row(cx))")), (Each wx.gens, \|gd| DoIfLet (PaCtor "Some", [[PaBind "row"]]), (XRaw "self.{gd.name}.borrow().as_ref()"), [[DoExpr (XRaw "row.leave_row(cx)")]], [[]])
    [[MethDef(name="remove_places", recv=RecvRef, params=[[]], cx=CxMut, ret=RsUnit, body=(Append removes, nested), tail=(XRaw "()"), doc="The row left: its places are torn down.")]]

GnDoc: fn Gn -> Text
fn GnDoc g = match g.kind:
    GnAnswer: "`{g.name}`: an answer at its place."
    GnStarted: "`@started`, the tick after the build."
    GnDeferred: "An `@Defer` firing, the tick after it was armed."
    GnMerge: "The merge `{g.name}`, decided in the wake."
    GnUpdated: if g.structural: "`!Updated` of a structural dynamic (pick ST): its value after the tick before, fired at the start of this tick, the first firing, when it moved." else: "`!Updated`: the dynamic's value after the tick, fired in the wake when a hold it reads was written."
    otherwise: "`!{g.name}`."

# The merge decides once, after its inputs: the left first.
MergeDecide: fn Gn -> Do
# Each input taken as it is decided, so a wake the node gets again in the tick (an input
# fired anew through a host's answer) decides only what came since.
fn MergeDecide g:
    let call = [[(SelfCall g.name, [[XRaw "v"]])]]
    let takeL = DoLet (PaBind "left"), (XMethod (XRaw "self.{Or g.inputs[0], ""}"), "take", [[XRaw "cx"]])
    let takeR = DoLet (PaBind "right"), (XMethod (XRaw "self.{Or g.inputs[1], ""}"), "take", [[XRaw "cx"]])
    let right = DoIfLet (PaCtor "Some", [[PaBind "v"]]), (XRaw "right"), call, [[]]
    DoIf (XRaw "true"), [[takeL, takeR, (DoIfLet (PaCtor "Some", [[PaBind "v"]]), (XRaw "left"), call, [[right]])]], [[]]

# ---------------------------------------------------------------------------------------
# The program
# ---------------------------------------------------------------------------------------

InModule: fn Lx, Nat, Text -> Lx
fn InModule lx, file, home = update lx:
    &_.file <= file
    &_.home <= home
    &_.site <= home

# The same, with the code placed in another module (an inlined widget's in its caller's,
# a check line's in `main.rs`).
InModuleAt: fn Lx, Nat, Text, Text -> Lx
fn InModuleAt lx, file, home, site = update lx:
    &_.file <= file
    &_.home <= home
    &_.site <= site

# The whole program as a model: one Rust module per Prism module (the prelude's is the
# template's own), a node per root widget (the ones the tests name and `@main`), every
# other widget inlined where it is applied.
LowerProgram: unbounded fn [Src], [Module], Nat, TProgram, Text -> Model
fn LowerProgram srcs, trees, shown, tp, name:
    let ((g, ignore)) = BuildG srcs, trees
    let ((tys, apps, bs, ims)) = TypedTables tp
    let mods = NeededMods g, shown
    let rsMods = Fold mods, {}, \|acc, m| Insert acc, m, (RustModName m)
    let lx0 = Lx(g=g, tys=tys, apps=apps, binders=bs, impls=ims, file=0, home="", site="", rsMods=rsMods, rsNames=(ValueNames g), layouts=(Layouts g), unbs=[[]], notes=[[]], globals=(GlobalNames g), inNode=False, unshrunk=(Fold tp.unshrunk, {}, \|m, a| Insert m, (AtKey a), True))
    let lx = update lx0:
        &_.unbs <= JobRoots lx0
    let roots = RootWidgets lx
    let modDefs = Each mods, \|m| ModDefOf lx, m, roots, (Or g.mods[m], dummyMod), mods
    let programs = Each roots, \|((qk, ignore))| ProgDefOf lx, qk
    let mainQk = Fold g.defs, "", \|found, d| if found == "" and (IsMain d.qk): d.qk else: found
    let ?root = if mainQk == "": nil else: ? (ProgDefOf lx, mainQk)
    let checks = Fold g.defs, [[]], \|acc, d| match d.body:
        DbCheck c: Push acc, (CheckDefOf (InModuleAt lx, d.file, d.home, "\u{0}main"), c)
        otherwise: acc
    Model(name=name, mods=modDefs, programs=programs, root=?root, checks=checks, elem=(ElemRow lx, mods), answer=(AnswerEnum (InModuleAt lx, 0, "", "\u{0}main"), mods), scripts=[[]], notes=[[]])

# The modules a program needs: its own files', and the modules they use or whose families
# they emit, followed (the prelude's are emitted only when reached).
NeededMods: unbounded fn G, Nat -> [Text]
fn NeededMods g, shown:
    let own = Filter (Keys g.mods), \|m| (Or g.mods[m], dummyMod).file < shown and m != "Prelude"
    let grown = Fold (Range0 6), own, \|acc, ignore| Fold acc, acc, \|a, m| UnionTexts a, (ModRefs g, m)
    Filter (Keys g.mods), \|m| m != "Prelude" and HasText grown, m

ModRefs: unbounded fn G, Text -> [Text]
fn ModRefs g, m = match g.mods[m]:
    ? info:
        let used = Each info.uses, \|((u, ignore))| u
        let fams = match info.tree.?emitRow:
            ? rw: Fold rw.terms, [[]], \|acc, t| match t:
                RFamily q: Push acc, (Or g.famOwner[Dotted q.path], (Dotted q.path))
                otherwise: acc
            nil: [[]]
        Filter (Append used, fams), \|x| HasKey g.mods, x
    nil: [[]]

# The root widgets: every widget a test names, and the root module's `@main`.
RootWidgets: fn Lx -> [((Text, Bool))]
fn RootWidgets lx:
    let tested = Fold lx.g.defs, [[]], \|acc, d| match d.body:
        DbTest t: match BlueprintQk (InModule lx, d.file, d.home), t.blueprint:
            "": acc
            qk: if HasText (Each acc, \|((q, ignore))| q), qk: acc else: Push acc, ((qk, True))
        otherwise: acc
    let main = Fold lx.g.defs, [[]], \|acc, d| if IsMain d.qk: Push acc, ((d.qk, False)) else: acc
    Fold main, tested, \|acc, ((k, b))| if HasText (Each acc, \|((q, ignore))| q), k: acc else: Push acc, ((k, b))

# The root module's `@main` (`@$main` too: Semantics ch. 6).
IsMain: fn Text -> Bool
fn IsMain qk = (OwnerOf qk) == "" and (Base (BareName qk)) == "main" and (Take (BareName qk), 1) == "@"

BlueprintQk: fn Lx, Expr -> Text
fn BlueprintQk lx, e = match e.kind:
    ECall c, ignore, ignore, ignore: BlueprintQk lx, c
    EGroup x: BlueprintQk lx, x
    EName n:
        let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
        Or ?q, ""
    otherwise: ""

# A definition's value, or for a block with no signature its definition's place.
ValOf: fn Lx, Text -> ValInfo
fn ValOf lx, qk = match lx.g.vals[qk]:
    ? v: v
    nil:
        let d = Fold lx.g.defs, dummyDef, \|found, df| if df.qk == qk: df else: found
        ValInfo(qk=qk, scheme=(Mono TyErr), sort="fn", hasSig=False, home=d.home, file=d.file, span=d.span)

# The program around a root widget.
ProgDefOf: unbounded fn Lx, Text -> ProgDef
fn ProgDefOf lx, qk:
    let v = ValOf lx, qk
    let ptys = match v.scheme.ty:
        TyFn ignore, ps, ignore: ps
        otherwise: [[]]
    let lxm = InModuleAt lx, v.file, v.home, "\u{0}main"
    let params = Each (Range0 (Len ptys)), \|i| (("arg{i}", (RustTy lxm, (Peel (Or ptys[i], TyErr)))))
    let node = "{RustModName v.home}::{Camel (BareName qk)}"
    let gui = HasText (Or lx.g.mods[v.home], dummyMod).emitRw.fams, "Gui"
    ProgDef(name="{Camel (BareName qk)}Program", prism=(Drop (BareName qk), 1), node=node, params=params, fallible=True, world=(if gui: "canvas" else: "cli"))

# The unbounded functions with jobs: those `@Run` is given, and those they tail-call.
JobRoots: unbounded fn Lx -> [Text]
fn JobRoots lx:
    let direct = Fold lx.g.defs, [[]], \|acc, d|
        let lxd = InModule lx, d.file, d.home
        UnionTexts (UnionTexts acc, (RunTargets lxd, d)), (UnboundedValues lxd, d)
    Fold (Range0 8), direct, \|acc, ignore| Fold acc, acc, \|a, qk| UnionTexts a, (TailTargets lx, qk)

# The unbounded functions a definition names as values, not called: each value is its
# `Start` (docs/backend.md), so each has a job.
UnboundedValues: unbounded fn Lx, Def -> [Text]
fn UnboundedValues lx, d:
    let es = match d.body:
        DbWidget w: BlockExprs w.body
        DbFn cs: Fold cs, [[]], \|acc, c| Append acc, (BodyExprs c.body)
        DbLet l: ExprsIn l.value
        otherwise: [[]]
    let callees = Fold es, [[]], \|acc, e| match e.kind:
        ECall c, ignore, ignore, ignore: Push acc, (PlaceKey lx, c.span)
        otherwise: acc
    Fold es, [[]], \|acc, e| match e.kind:
        EName n:
            if HasText callees, (PlaceKey lx, e.span): acc
            else:
                let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
                match ?q:
                    ? q: if IsUnbounded lx, q: AddText acc, q else: acc
                    nil: acc
        otherwise: acc

# A function whose color is a variable (`u fn`, D8): unbounded where a caller gives it an
# unbounded closure. Entering it is not a cycle point (it is not an unbounded function);
# the calls it makes through its closures are.
InPrelude: fn Lx, Text -> Bool
fn InPrelude lx, q = match lx.g.vals[q]:
    ? v: v.home == "Prelude"
    nil: False

IsColorPoly: fn Lx, Text -> Bool
fn IsColorPoly lx, q = match lx.g.vals[q]:
    ? v: match v.scheme.ty:
        TyFn (CQ ignore), ignore, ignore: True
        TyFn (CRigid ignore), ignore, ignore: True
        otherwise: False
    nil: False

# A color-polymorphic function is entered at once (it is not an unbounded function)
# unless this call instantiates its color variable unbounded: an argument at a function
# parameter is itself unbounded (D6: then the call is a cycle point). An argument whose
# color is a variable of the caller's own stays entered at once.
EntersAtOnce: fn Lx, Text, [Arg] -> Bool
fn EntersAtOnce lx, q, args = (IsColorPoly lx, q) and not (Fold args, False, \|seen, a| seen or IsUnboundedArg lx, a)

IsUnboundedArg: fn Lx, Arg -> Bool
fn IsUnboundedArg lx, a = match Peel (TypeAt lx, a.value.span):
    TyFn CUnbound, ignore, ignore: True
    otherwise: False

IsUnbounded: fn Lx, Text -> Bool
fn IsUnbounded lx, q = match lx.g.vals[q]:
    ? v: match v.scheme.ty:
        TyFn CBound, ignore, ignore: False
        TyFn ignore, ignore, ignore: True
        otherwise: False
    nil: False

RunTargets: unbounded fn Lx, Def -> [Text]
fn RunTargets lx, d:
    let es = match d.body:
        DbWidget w: BlockExprs w.body
        DbFn cs: Fold cs, [[]], \|acc, c| Append acc, (BodyExprs c.body)
        otherwise: [[]]
    Fold es, [[]], \|acc, e| match e.kind:
        ECall c, args, ignore, ignore:
            if (BlueprintQk lx, c) == "Prelude.@Run": match args[0]:
                ? a: match a.value.kind:
                    EName n:
                        let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
                        match ?q:
                            ? q: AddText acc, q
                            nil: acc
                    otherwise: acc
                nil: acc
            else: acc
        otherwise: acc

# The unbounded functions a function calls, in tail position or not: each has a job.
TailTargets: unbounded fn Lx, Text -> [Text]
fn TailTargets lx, qk:
    let v = Or lx.g.vals[qk], (Builtin qk, (Mono TyErr))
    let lxm = InModule lx, v.file, v.home
    Fold (ClausesOf lx.g, qk), [[]], \|acc, c| UnionTexts acc, (TailsOfBody lxm, c.body)

TailsOfBody: unbounded fn Lx, FnBody -> [Text]
fn TailsOfBody lx, body = Fold (BodyExprs body), [[]], \|acc, e| match e.kind:
    ECall c, ignore, ignore, ignore:
        let q = BlueprintQk lx, c
        match lx.g.vals[q]:
            ? v: match v.scheme.ty:
                TyFn CBound, ignore, ignore: acc
                TyFn ignore, ignore, ignore: AddText acc, q
                otherwise: acc
            nil: acc
    otherwise: acc

# One Prism module's Rust module.
ModDefOf: unbounded fn Lx, Text, [((Text, Bool))], ModInfo, [Text] -> ModDef
fn ModDefOf lx0, m, roots, info, mods:
    let lx = InModule lx0, info.file, m
    let path = match lx.g.srcs[info.file]:
        ? src: src.path
        nil: ""
    let types = Fold (Values lx.g.types), [[]], \|acc, ti| if ti.home == m: Append acc, (TyDefs lx, ti) else: acc
    let tags = Fold (Values lx.g.tags), [[]], \|acc, tg| if tg.home == m and tg.kind != "Prelude.Fault": Push acc, (ItTag (TagDefOf lx, tg)) else: acc
    let defs = Fold lx.g.defs, [[]], \|acc, d| if d.home == m: Append acc, (DefItems (InModule lx, d.file, m), d, roots) else: acc
    let traits = Fold (Values lx.g.traits), [[]], \|acc, tr| if tr.home == m: Push acc, (ItTrait (TraitDefOf lx, tr)) else: acc
    let impls = Fold (Values lx.g.impls), [[]], \|acc, ims| Fold ims, acc, \|a, im| if im.home == m and not im.derived: Push a, (ItImpl (ImplDefOf (InModule lx, im.file, m), im)) else: a
    let uses = Filter (Each mods, \|o| RustModName o), \|o| o != (RustModName m)
    ModDef(name=(RustModName m), prism=m, path=path, uses=uses, items=(Append (Append (Append (Append types, tags), traits), impls), defs))

# A definition's items: a function (and its job when `@Run` cycles it), a node for a root
# widget, a getter for a `let`.
DefItems: unbounded fn Lx, Def, [((Text, Bool))] -> [Item]
fn DefItems lx, d, roots:
    let isRoot = HasText (Each roots, \|((q, ignore))| q), d.qk
    match d.body:
        DbWidget w:
            if isRoot: NodeItems (NodeDefOf lx, d.qk, [[]], w.body, (Or lx.g.vals[d.qk], (Builtin d.qk, (Mono TyErr))).scheme, True)
            else: [[ItNote "`{d.name}` is inlined where it is applied."]]
        DbFn clauses: match lx.g.vals[d.qk]:
            nil: [[]]
            ? v: match v.scheme.ty:
                TyFn ignore, ignore, (TyAt ignore, ignore):
                    if not isRoot: [[ItNote "`{d.name}` is inlined where it is applied."]]
                    else: match clauses:
                        [[c]]: match c.body:
                            BodyBlock b: NodeItems (NodeDefOf lx, d.qk, c.params, b, v.scheme, True)
                            otherwise: [[ItRefused "`{d.name}`, a root widget whose body is one expression"]]
                        otherwise: [[ItRefused "`{d.name}`, a root widget of several clauses"]]
                otherwise:
                    let f = ItFn (FnDefOf lx, d.qk, clauses, v.scheme)
                    if HasText lx.unbs, d.qk: [[f, ItJob (JobDefOf lx, d.qk, clauses, v.scheme)]] else: [[f]]
        DbLet l: [[ItFn (LetGetter lx, d.qk, l)]]
        otherwise: [[]]

# A node and the rows of its `for`s.
NodeItems: fn NodeDef -> [Item]
fn NodeItems n = Append [[ItNode n]], (Each n.children, \|c| ItNode c)

# A declared type's Rust type (docs/backend.md, "Types").
TyDefs: unbounded fn Lx, TyInfo -> [Item]
fn TyDefs lx, ti:
    let derives = Each ti.derives, \|dn| BareName dn
    let params = Each ti.params, \|p| Camel p
    let floaty = Floaty lx.g, (TyCon ti.name, [[]]), [[]]
    let bare = BareName ti.name
    let Mk = \|shape, cases| TyDef(name=(Camel bare), prism=bare, params=params, shape=shape, cases=cases, eq=(HasText derives, "Eq"), ord=(HasText derives, "Ord"), floaty=floaty, show=(if HasOwnShow lx, ti.name: ShownOwn else: if HasText derives, "Show": ShownDerived else: NotShown), pod=((TyPodable lx, (TyCon ti.name, [[]]), [[]]) and Fold cases, True, \|ok, c| ok and Fold c.fields, True, \|ok2, ((ignore, ft))| ok2 and Podable ft), doc=(TypeDoc lx, ti))
    match ti.body:
        BRecord fs:
            let fields = Each (Range0 (Len fs)), \|i|
                let ((fname, ft)) = Or fs[i], (("", TyErr))
                let rt = RustTy lx, ft
                ((Snake fname, (if RcField lx, ti.name, i: RsRc rt else: rt)))
            [[ItType (Mk ShapeRecord, [[CaseDef(name=(Camel bare), prism=bare, fields=fields)]])]]
        BChoice cases:
            let defs = Each cases, \|((cn, ats))|
                let ck = QualKey ti.home, cn
                CaseDef(name=(Camel cn), prism=cn, fields=(Each (Range0 (Len ats)), \|i| (("", (CaseField lx, ck, i, (Or ats[i], TyErr))))))
            let shape = match cases:
                [[((cn, [[]]))]]: if IsLowerText cn: ShapeUnit else: ShapeChoice
                [[((cn, ignore))]]: if cn == bare: ShapeNewtype else: ShapeChoice
                otherwise: ShapeChoice
            [[ItType (Mk shape, defs)]]
        BRowKind: if ti.name == "Prelude.Fault": [[]] else: [[ItRow (RowDefOf lx, ti)]]
        otherwise: [[]]

# Whether a checker type can cross to a World, through the declarations it names: a
# record holding a function anywhere inside is not `^Pod` (a type reached again is taken
# as podable, so cycles end).
TyPodable: unbounded fn Lx, Ty, [Text] -> Bool
fn TyPodable lx, t, seen = match t:
    TyFn ignore, ignore, ignore: False
    TyAt ignore, ignore: False
    TySig "!", ignore: False
    TySig "$", ignore: False
    TySig ignore, i: TyPodable lx, i, seen
    TyTuple ts: Fold ts, True, \|ok, x| ok and TyPodable lx, x, seen
    TyArray e: TyPodable lx, e, seen
    TyMap k, v: (TyPodable lx, k, seen) and TyPodable lx, v, seen
    TyCon n, args:
        if HasText seen, n: True
        else:
            let more = Push seen, n
            let argsOk = Fold args, True, \|ok, x| ok and TyPodable lx, x, more
            argsOk and match lx.g.types[n]:
                ? ti: match ti.body:
                    BRecord fs: Fold fs, True, \|ok, ((ignore, ft))| ok and TyPodable lx, ft, more
                    BChoice cs: Fold cs, True, \|ok, ((ignore, ats))| ok and Fold ats, True, \|ok2, x| ok2 and TyPodable lx, x, more
                    BAlias a: TyPodable lx, a, more
                    otherwise: True
                nil: True
    otherwise: True

# Whether a type's Rust type compares (`PartialEq`): the plain scalars, text, paths, errors
# and elements do; a tuple, array or map when its parts do; a declared type when it derives
# `^Eq` or has its own `impl ^Eq`, and its arguments compare; a function, a job, an event or
# a dynamic never. A structural dynamic's snapshot of such a type dedupes its update event
# (pick ST).
TyHasEq: unbounded fn Lx, Ty, [Text] -> Bool
fn TyHasEq lx, t, seen = match t:
    TyFn ignore, ignore, ignore: False
    TyAt ignore, ignore: False
    TySig "!", ignore: False
    TySig "$", ignore: False
    TySig ignore, i: TyHasEq lx, i, seen
    TyTuple ts: Fold ts, True, \|ok, x| ok and TyHasEq lx, x, seen
    TyArray e: TyHasEq lx, e, seen
    TyMap k, v: (TyHasEq lx, k, seen) and TyHasEq lx, v, seen
    TyElem ignore, ignore: True
    TyElemAny ignore: True
    TyCon n, args:
        if HasText seen, n: True
        else:
            let argsOk = Fold args, True, \|ok, x| ok and TyHasEq lx, x, (Push seen, n)
            argsOk and match lx.g.types[n]:
                ? ti: (Fold ti.derives, False, \|f, d| f or (BareName d) == "Eq") or HasOwnEq lx, n
                nil: True
    otherwise: False

HasOwnEq: fn Lx, Text -> Bool
fn HasOwnEq lx, tn = Fold (Or lx.g.impls["Prelude.Eq"], [[]]), False, \|f, im| f or (HeadName im.head) == tn

CaseField: unbounded fn Lx, Text, Nat, Ty -> RsTy
fn CaseField lx, ck, i, t:
    let rt = RustTy lx, t
    if RcField lx, ck, i: RsRc rt else: rt

TypeDoc: fn Lx, TyInfo -> Text
fn TypeDoc lx, ti = match lx.g.srcs[ti.file]:
    ? src: Trim (LineText src, (CLineOf src.starts, ti.span.start))
    nil: ti.name

# A tag's struct: an element tag's `Level`, its plain and dynamic fields (an event field
# is a request); any other tag's fields, all plain.
TagDefOf: unbounded fn Lx, TagInfo -> TagDef
fn TagDefOf lx, tg:
    let fields = Each (LevelFields tg), \|((fname, ft))| ((fname, (Snake fname), (RustTy lx, (Peel ft))))
    TagDef(name=(TagStruct tg.name), tagName=tg.name, fields=fields, doc=(TypeDoc lx, (TyInfo(name=tg.name, home=tg.home, params=[[]], body=BOpaque, derives=[[]], file=tg.file, span=tg.span))), pod=(Fold fields, True, \|ok, ((ignore, ignore, t))| ok and Podable t))

LevelFields: fn TagInfo -> [((Text, Ty))]
fn LevelFields tg = Filter tg.fields, \|((ignore, ft))| (LayerOf ft) != LyEv

# The tags of a row kind, in their modules: the variants of its enum (pick RV). A tag
# whose module the program does not emit is not among them.
KindTags: fn Lx, Text, [Text] -> [TagInfo]
fn KindTags lx, kind, mods = Filter (Values lx.g.tags), \|tg| tg.kind == kind and HasText mods, tg.home

RowDefOf: unbounded fn Lx, TyInfo -> RowDef
fn RowDefOf lx, ti:
    let tags = KindTags lx, ti.name, (Keys lx.rsMods)
    let cases = Each tags, \|tg| (((TagStruct tg.name), (PathIn lx, tg.home, (TagStruct tg.name))))
    let pod = Fold tags, True, \|ok, tg| ok and (TagDefOf lx, tg).pod
    RowDef(name=(Camel (BareName ti.name)), prism=ti.name, cases=cases, pod=pod, doc=(TypeDoc lx, ti))

# `crate::Elem`: every element tag's `Level`, the value of a document's entry; the
# prelude's element tags among them (`Prelude.Unwrap`, `Prelude.Exceptions`), which the
# prelude template defines.
ElemRow: unbounded fn Lx, [Text] -> RowDef
fn ElemRow lx, mods:
    let tags = KindTags lx, "Element", (Push mods, "Prelude")
    let cases = Each tags, \|tg| (((TagStruct tg.name), "{RustModName tg.home}::{TagStruct tg.name}"))
    let pod = Fold tags, True, \|ok, tg| ok and (TagDefOf lx, tg).pod
    RowDef(name="Elem", prism="Elem", cases=cases, pod=pod, doc="`Elem r`: an element as a document holds it, its `Level` in a tick.")

# `crate::Answer`: a variant per element tag, carrying the tag's output type.
AnswerEnum: unbounded fn Lx, [Text] -> AnswerDef
fn AnswerEnum lx, mods:
    let tags = KindTags lx, "Element", (Push mods, "Prelude")
    AnswerDef(cases=(Each tags, \|tg| AnswerCase(variant=(TagStruct tg.name), accessor=(AnswerAccessor tg), structPath="{RustModName tg.home}::{TagStruct tg.name}", tagName=tg.name, ty=(AnswerTy lx, tg))))

# What an answer to a tag's element carries: its output's value; of a bundle (a tuple with
# an event part, `Gui.Window`'s `((WindowId, !WindowInput))`) the event part's, which is
# what a World answers with; a type variable left open, the answer as it came, a `Pod`.
AnswerTy: unbounded fn Lx, TagInfo -> RsTy
fn AnswerTy lx, tg:
    let out = Peel tg.out
    let part = match out:
        TyTuple cs: Fold cs, out, \|found, c| if (LayerOf c) == LyEv: Peel c else: found
        otherwise: out
    match RustTy lx, part:
        RsGen ignore: RsPod
        t: t

# The Rust path of a tag's enum variant and of its struct, from the current module.
TagPaths: fn Lx, TagInfo -> ((Text, Text))
fn TagPaths lx, tg:
    let st = TagStruct tg.name
    let structPath = PathIn lx, tg.home, st
    (("{KindPath lx, tg.kind}::{st}", structPath))

VariantOf: fn Lx, TagInfo -> Text
fn VariantOf lx, tg = "{KindPath lx, tg.kind}::{TagStruct tg.name}"

KindPath: fn Lx, Text -> Text
fn KindPath lx, kind = if kind == "Element": "crate::Elem" else: PathIn lx, (Or lx.g.types[kind], dummyTyInfo).home, (Camel (BareName kind))

# A `check` block: each line's value as plain data, or the fault that stopped it.
CheckDefOf: unbounded fn Lx, CheckDecl -> CheckDef
fn CheckDefOf lx, c = CheckDef(name=c.name.name, lines=(Each c.lines, \|l| XCtor "Ok", [[(XMethod (Own (ValueOf lx, emptyEnv, l.expr)), "to_pod", [[]])]]))

# ---------------------------------------------------------------------------------------
# `for` (docs/backend.md, "Dynamic structure"): a builder node of rows keyed by the
# source's keys, each row a node of its own whose `$_` (or `$v`) is a projection of the
# source, the block's `{name}_source` getter at the row's key, read at the row's read
# point and written by nobody (pick RE); a row's event result gathers into the block's
# `!(K ==> T)`, one firing a tick
# ---------------------------------------------------------------------------------------

ForLine: unbounded fn Wx, Env, Env, ?ForBinders, Expr, Block, Expr, ?Bn -> ((Wx, Wres))
fn ForLine wx, benv, menv, ?binders, source, body, e, ?bound:
    let lx = wx.lx
    let pos = wx.pos
    let wx1 = update wx:
        &_.pos <= NextPos &_.pos
    let ((srcEx, reads)) = DynamicExpr wx1, menv, source
    let srcTy = Peel (TypeAt lx, source.span)
    let ((kt, vt, keyed)) = match srcTy:
        TyMap k, v: (((RustTy lx, k), (RustTy lx, v), True))
        TyArray v: ((RsNat, (RustTy lx, v), False))
        otherwise: ((RsUnit, RsUnit, True))
    let src = if keyed: srcEx else: XCall "indexed", [[(XUnary "&", srcEx)]]
    let base = match ?bound:
        ? (BnEv er, ignore): (GnOf wx1, er.node).name
        otherwise: "rows"
    let ((name, wx2a)) = FreshName wx1, base
    # The source as a getter of the block, which the builder and every row's entry read: a
    # dynamic `let` of the block for the marks.
    let srcGetter = "{name}_source"
    let wx2 = update wx2a:
        &_.taken <= Push &_.taken, srcGetter
        &_.getters <= Push &_.getters, (MethDef(name=srcGetter, recv=RecvRef, params=[[]], cx=CxRef, ret=(RsMap kt, vt), body=[[]], tail=src, doc="The source of the `for` at place {PlaceText pos} by key, at the read point: what its builder and its rows' entries read."))
        &_.dynReads <= Insert &_.dynReads, srcGetter, reads
    let rowName = "{wx.node}{RowSuffix wx}Row"
    let locals = RowLocals benv, menv, body
    let rowFields = Append [[(("key", kt, "the row's key")), (("left_entry", (RsCell (RsOpt vt)), "the entry as the tick its key left opened, kept from the row's leaving on (R8)")), (("parent", (RsWeak wx.node), "the node of the `for`"))]], (Each locals, \|l| ((l.field, l.ty, "`{l.name}`, the block's")))
    let rowInits = Append [[(("key", (XRaw "key.clone()"))), (("left_entry", (XRaw "RefCell::new(None)"))), (("parent", (XRaw "parent")))]], (Each locals, \|l| ((l.field, (XRaw l.field))))
    let rowTaken = Append (Append nodeHooks, [["key", "value", "parent", "entry", "left_entry"]]), (Each locals, \|l| l.field)
    let rowWx0 = NewWx lx, rowName, rowFields, rowInits, [[(EntryGetter srcGetter, vt)]], {"entry": [[ParentRead srcGetter]]}, rowTaken, wx.depth, (?HostedRows wx)
    let keyB = BnLocal "key", Owned, kt
    let keyM = BnLocal "self.key", Owned, kt
    let benvL = Fold locals, (RowReads benv, "parent.upgrade().expect(\"the block outlives its rows\")"), \|en, l| Bind en, l.name, (BnLocal l.field, Owned, l.ty)
    let menvL = Fold locals, (RowReads menv, parentRef), \|en, l| Bind en, l.name, (BnLocal "self.{l.field}", Owned, l.ty)
    let passed = Append (HostedPassed wx), (Each locals, \|l| l.passed)
    let rowParams = Append (Append [[(("key", kt)), (("value", vt)), (("parent", (RsWeak wx.node)))]], (HostedParams wx)), (Each locals, \|l| ((l.field, l.ty)))
    # `$_`: in the build the entry after the tick, which the builder passes; in the methods the
    # projection, marked by the block's writes behind the source.
    let entryM = BnDyn (XMethod (XRaw "self"), "entry", [[XRaw "cx"]]), [[ParentRead srcGetter]], vt
    let ((rbe, rme)) = ForEnvs benvL, menvL, ?binders, keyB, keyM, (BnLocal "value", Owned, vt), entryM, vt
    let rowWx = BlockInto rowWx0, rbe, rme, body
    let wx3 = update wx2:
        &_.rowMarks <= Push &_.rowMarks, RowMarks(builder=name, reads=(RowPlaceReads rowWx), wrote=(RowHears rowWx), kind=ForRow)
    let full = TypeAt lx, e.span
    let outTy = RustTy lx, (Peel full)
    match rowWx.result:
        WrEv r:
            let ((gid, wx4)) = AddGn wx3, "{name}_all", outTy, GnGather, 1
            let wx5 = AddField wx4, "{name}_gathered", (RsStamped outTy), "the rows' firings this tick, by key", (XRaw "Stamped::new()")
            let wx6 = update wx5:
                &_.gns <= Each &_.gns, \|n| if n.id == gid: WithInputs n, [["{name}_gathered"]] else: n
            let rowDone = Connect rowWx, r, (SkUp "{name}_all_in")
            let wx7 = AddBuilder wx6, name, pos, kt, vt, rowName, keyed, reads, (PendingRow(wx=rowDone, qk=rowName, params=rowParams, gather=(? gid))), passed
            ((wx7, (WrEv (EvRefOf gid))))
        WrDyn ex, resultReads, rt:
            # The gathered dynamic `$(K ==> T)` is structural (pick ST): the rows' results by
            # key are computed live by `{name}_all_now`, snapshotted after the builder has run,
            # and read from the snapshot. A row whose own hold behind its result is written
            # marks the snapshot through `{name}_all_moved`; the block's writes behind the
            # results, read through the parent, mark it as the snapshot's own reads.
            let gathered = "{name}_all"
            let gatheredTy = RsMap kt, rt
            let ownBehind = Filter (ReadsClosed rowWx.dynReads, resultReads), \|r| match r:
                OwnRead ignore: True
                ParentRead ignore: False
            let rowDone = update rowWx:
                &_.getters <= Push &_.getters, (MethDef(name="result", recv=RecvRef, params=[[]], cx=CxRef, ret=rt, body=[[]], tail=ex, doc="The row's result, which the block gathers by key."))
                &_.resultMoved <= if (Len ownBehind) > 0: ? (("{gathered}_moved", ownBehind)) else: nil
            let wx4 = AddBuilder wx3, name, pos, kt, vt, rowName, keyed, reads, (PendingRow(wx=rowDone, qk=rowName, params=rowParams, gather=nil)), passed
            let all = XRaw "self.{name}.borrow().iter().map(|(k, row)| (k.clone(), row.result(cx))).collect()"
            let what = "the dynamic gathered by the `for` at place {PlaceText pos}"
            let wx5 = update wx4:
                &_.taken <= Append &_.taken, [[gathered, "{gathered}_now", "{gathered}_snap", "{gathered}_moved"]]
                &_.getters <= Append &_.getters, [[(MethDef(name="{gathered}_now", recv=RecvRef, params=[[]], cx=CxRef, ret=gatheredTy, body=[[]], tail=all, doc="The rows' results by key, computed live: what the snapshot of the `for`'s dynamic is taken from (pick ST).")), (SnapGetter gathered, gatheredTy, "The `for`'s dynamic, the rows' results by key, a structural dynamic (pick ST): the snapshot taken after the builder has run, the results after the tick from then on; during propagation, the results as the tick opened.")]]
                &_.fields <= Push &_.fields, (("{gathered}_snap", (RsSnapshot gatheredTy), "the `for` at place {PlaceText pos}'s gathered dynamic, structural: its snapshot after the tick (pick ST)"))
                &_.inits <= Push &_.inits, (("{gathered}_snap", (XCall "Snapshot::new", [[XRaw "\"{what}\""]])))
                &_.snaps <= Push &_.snaps, SnapDef(name=gathered, ty=gatheredTy, eq=(TyHasEq lx, (Peel full), [[]]), builder=name, before=False, what=what)
                &_.dynReads <= Insert &_.dynReads, gathered, (UnionReads reads, (BlockReads (ReadsClosed rowWx.dynReads, resultReads)))
            ((wx5, (WrDyn (XMethod (XRaw "self"), gathered, [[XRaw "cx"]]), [[OwnRead gathered]], gatheredTy)))
        otherwise:
            let wx4 = AddBuilder wx3, name, pos, kt, vt, rowName, keyed, reads, (PendingRow(wx=rowWx, qk=rowName, params=rowParams, gather=nil)), passed
            ((wx4, WrUnit))

# A row's entry, `$_`: the block's source at the row's key, at the read point (a projection
# of the block's holds, written by nobody, pick RE). From the row's leaving on, the value as
# the leaving tick opened: a key that leaves ends its row at the end of that tick (R8), and
# the entry after that tick does not exist, so the leaving reads it as the tick opened
# (`Cx::before`) and keeps it in `left_entry`.
EntryGetter: fn Text, RsTy -> MethDef
fn EntryGetter srcGetter, vt:
    let found = XMethod (XMethod (XMethod (XRaw "parent"), srcGetter, [[XRaw "cx"]]), "get", [[XRaw "&self.key"]]), "cloned", [[]]
    let opened = XMethod (XMethod (XRaw "cx"), "before", [[(XClosure False, [[PaBind "cx"]], found)]]), "expect", [[XRaw "\"a row's key is in its source as its tick opened\""]]
    let body = [[(DoIfLet (PaCtor "Some", [[PaBind "v"]]), (XRaw "self.left_entry.borrow().as_ref()"), [[(DoReturn (XMethod (XRaw "v"), "clone", [[]]))]], [[]]), (DoLet (PaBind "parent"), (XRaw parentRef))]]
    let tail = XMatch found, [[XArm(pat=(PaCtor "Some", [[PaBind "v"]]), conds=[[]], body=(XRaw "v")), XArm(pat=(PaUnit "None"), conds=[[]], body=opened)]], False
    MethDef(name="entry", recv=RecvRef, params=[[]], cx=CxRef, ret=vt, body=body, tail=tail, doc="The row's entry, `$_`: the block's source at this key, at the read point; from the row's leaving on, the value as the leaving tick opened.")

AddBuilder: fn Wx, Text, Pos, RsTy, RsTy, Text, Bool, [Read], PendingRow, [Ex] -> Wx
fn AddBuilder wx, name, pos, kt, vt, rowName, keyed, reads, waiting, passed:
    let wx0 = AddField wx, name, (RsCell (RsMap kt, (RsRc (RsNamed rowName, [[]])))), "the rows of the `for` at place {PlaceText pos}", (XRaw "RefCell::new(Map::new())")
    update wx0:
        &_.builders <= Push &_.builders, ForDef(name=name, pos=pos, at=(PlaceAt wx, "self", pos), keyTy=kt, valueTy=vt, rowNode=rowName, keyed=keyed, source="{name}_source", parent="Rc::downgrade(self)", passed=passed)
        &_.buildHolds <= UnionReads &_.buildHolds, reads
        &_.pending <= Push &_.pending, waiting

# What a row's places read of its block, as the block's own reads: the block's writes of
# these mark the rows (`RowMarks`).
RowPlaceReads: fn Wx -> [Read]
fn RowPlaceReads rowWx = Fold rowWx.places, [[]], \|acc, pl| UnionReads acc, (BlockReads (ReadsClosed rowWx.dynReads, pl.reads))

# A row of a hosted child's `for` or `rebuild` (or of a hosted row) takes the host whose
# document its places are entries of, `enclosing`, as a parameter of its `build` and keeps
# it (pick HO): its places ask their first values of it, and a host of its own builds in
# its scope.
HostedParams: fn Wx -> [((Text, RsTy))]
fn HostedParams wx = match ?HostedRows wx:
    ? ignore: [[(("enclosing", hostOfTy))]]
    nil: [[]]

HostedPassed: fn Wx -> [Ex]
fn HostedPassed wx = match ?HostedRows wx:
    ? ignore: [[XRaw "{HostField wx, wx.pos}.clone()"]]
    nil: [[]]

# A row's view of its block's holds and dynamic `let`s: read through the parent at the
# row's read point, each a `ParentRead` in what it reads, so the row's places that read
# one are live and the block's writes of it mark the rows (gap DY).
RowReads: fn Env, Text -> Env
fn RowReads env, pref = Fold (Keys env.names), env, \|en, k| match env.names[k]:
    ? (BnHold f, t): Bind en, k, (BnDyn (XMethod (XRaw "{pref}.{f}"), "get", [[XRaw "cx"]]), [[ParentRead f]], t)
    ? (BnDyn (XMethod (XRaw "self"), m, xs), ignore, t): Bind en, k, (BnDyn (XMethod (XRaw pref), m, xs), [[ParentRead m]], t)
    otherwise: en

# A row's reads of its block, as the block's own reads: the block's writes of these mark
# the rows.
BlockReads: fn [Read] -> [Read]
fn BlockReads reads = Fold reads, [[]], \|acc, r| match r:
    ParentRead f: AddRead acc, (OwnRead f)
    OwnRead ignore: acc

# The block's plain values a row reads (a parameter, a plain `let`): each a field of the
# row, which the block passes to its `build`, since a row's build has no block to read.
type RowLocal = record:
    name: Text
    field: Text
    ty: RsTy
    passed: Ex

RowLocals: unbounded fn Env, Env, Block -> [RowLocal]
fn RowLocals benv, menv, body = Fold (ReadNames (BlockExprs body)), [[]], \|acc, n| match menv.names[n]:
    ? (BnLocal rs, mode, t):
        let field = Snake n
        if field == "key" or field == "value" or field == "parent" or field == "path": acc
        else: Push acc, (RowLocal(name=n, field=field, ty=t, passed=(Own (VlPlace (XRaw rs), mode, t))))
    otherwise: acc

# A row's environments: the block's names, `key`, `$_`, and the `for`'s binders.
ForEnvs: unbounded fn Env, Env, ?ForBinders, Bn, Bn, Bn, Bn, RsTy -> ((Env, Env))
fn ForEnvs benv, menv, ?binders, keyB, keyM, valB, valM, vt:
    let be0 = Bind (Bind benv, "key", keyB), "$_", valB
    let me0 = Bind (Bind menv, "key", keyM), "$_", valM
    match ?binders:
        nil: ((be0, me0))
        ? fb: match fb.?second:
            ? second:
                let be1 = BindPat be0, fb.first, keyB, "key", kt0
                let me1 = BindPat me0, fb.first, keyM, "self.key", kt0
                (((BindPat be1, second, valB, "value", vt), (BindPat me1, second, valM, "", vt)))
            nil: (((BindPat be0, fb.first, valB, "value", vt), (BindPat me0, fb.first, valM, "", vt)))

let kt0 = RsUnit

# A `for` binder: a name binds the key or the entry; a tuple binds its parts, each the
# part of the entry (`for ((path, text)) <- files:`).
BindPat: fn Env, Pattern, Bn, Text, RsTy -> Env
fn BindPat env, p, b, whole, t = match p.kind:
    PName n: Bind env, (SNameKey n), b
    PGroup q: BindPat env, q, b, whole, t
    PTuple ps:
        let ts = match t:
            RsTuple xs: xs
            otherwise: [[]]
        Fold (Range0 (Len ps)), env, \|en, i| match ps[i]:
            ? q: match q.kind:
                PName n: Bind en, (SNameKey n), (PartBn b, whole, i, (Or ts[i], RsUnit))
                otherwise: en
            nil: en
    otherwise: env

# Part `i` of a tuple entry: of the build's value, or of the row's entry projection.
PartBn: fn Bn, Text, Nat, RsTy -> Bn
fn PartBn (BnDyn x, rds, ignore), whole, i, t = BnDyn (XField x, "{i}"), rds, t
fn PartBn other, whole, i, t = BnLocal "{whole}.{i}", Owned, t

# What tells a node's rows apart in their names: nothing for the first, a count for the
# rest (the finished rows, with their children, and the `for` rows still pending).
RowSuffix: fn Wx -> Text
fn RowSuffix wx:
    let n = (Len wx.rows) + (Len wx.pending)
    if n == 0: "" else: "{n}"

GnTyNamed: fn Wx, Text -> RsTy
fn GnTyNamed wx, n = Fold wx.gns, RsUnit, \|acc, g| if g.name == n: g.ty else: acc

# ---------------------------------------------------------------------------------------
# `rebuild` and `@Switch` (docs/backend.md, "Dynamic structure"; Compiler ch. 3)
# ---------------------------------------------------------------------------------------

# A row's environments from its block's: `_` the generation's value (or the `for` entry),
# and each event of the block the row's body names a source of the row, fed by the
# block's port for it.
RowEnv: unbounded fn Wx, Wx, Env, Block -> ((Wx, Wx, Env))
fn RowEnv parent, rowWx, menv, body:
    let names = ReadNames (BlockExprs body)
    Fold names, ((parent, rowWx, emptyEnv)), \|((p, r, env)), n| match menv.names[n]:
        ? (BnLocal rs, mode, t):
            let fieldOf = if (Take rs, 5) == "self.": Drop rs, 5 else: rs
            ((p, r, (Bind env, n, (BnLocal "self.parent.upgrade().expect(\"the block outlives its rows\").{fieldOf}", Owned, t))))
        ? (BnEv er, t):
            let pname = (GnOf p, er.node).name
            let ((rs, r1)) = FreshName r, (Snake n)
            let ((id, r2)) = AddGn r1, rs, t, GnPort, 0
            let r3 = update r2:
                &_.subs <= Push &_.subs, ((pname, rs, t))
            let p2 = if HasText p.ports, pname: p else: Connect (WithPort p, pname), (EvRefOf er.node), (SkPort pname)
            ((p2, r3, (Bind env, n, (BnEv (EvRefOf id), t))))
        # The block's dynamics and holds, read through the parent at the row's read point,
        # each a `ParentRead` in what it reads, so a generation's place that reads one is
        # live and the block's writes of it mark the generation (gap DY).
        ? (BnDyn (XMethod recv, m, xs), ignore, t):
            if recv == (XRaw "self"): ((p, r, (Bind env, n, (BnDyn (XMethod (XRaw parentRef), m, xs), [[ParentRead m]], t))))
            else: ((p, r, env))
        ? (BnHold f, t): ((p, r, (Bind env, n, (BnDyn (XMethod (XRaw "{parentRef}.{f}"), "get", [[XRaw "cx"]]), [[ParentRead f]], t))))
        otherwise: ((p, r, env))

let parentRef = "self.parent.upgrade().expect(\"the block outlives its rows\")"

WithPort: fn Wx, Text -> Wx
fn WithPort wx, pname = update wx:
    &_.ports <= Push &_.ports, pname

RebuildLine: unbounded fn Wx, Env, Env, Expr, Block, Expr, ?Bn -> ((Wx, Wres))
fn RebuildLine wx, benv, menv, scrut, body, e, ?bound:
    let lx = wx.lx
    let pos = wx.pos
    let wx1 = update wx:
        &_.pos <= NextPos &_.pos
    let ((srcEx, reads)) = DynamicExpr wx1, menv, scrut
    let vt = RustTy lx, (Peel (TypeAt lx, scrut.span))
    let ((name, wx2)) = FreshName wx1, "generation"
    let ((upId, wx3)) = match ?bound:
        ? (BnEv er, ignore): ((er.node, wx2))
        otherwise: AddGn wx2, "{name}_fired", (RustTy lx, (Peel (Peel (TypeAt lx, e.span)))), GnNamed, 0
    let ((cases, wx4)) = GenCases wx3, menv, body, vt, name
    let rowDefs = Each cases, \|c| c.node
    let select = GenSelect wx4, menv, body, cases, pos
    let wx5 = update wx4:
        &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, at=(PlaceAt wx, "self", pos), source=srcEx, valueTy=vt, select=select)
        &_.genHolds <= Push &_.genHolds, ((name, reads))
        &_.rows <= Fold rowDefs, &_.rows, \|acc, rd| Append (Push acc, rd), rd.children
        &_.getters <= Push &_.getters, (GenUp name, (GnOf wx4, upId).name, (GnOf wx4, upId).ty)
    ((wx5, (WrEv (EvRefOf upId))))

# One generation's node, for the block or for one clause of the widget it applies.
type GenCase = record:
    node: NodeDef
    params: [((Text, RsTy))]
    pat: Pa
    conds: [Cc]
    # What each parameter is built from: the arm's binders, owned.
    passed: [Ex]

GenCases: unbounded fn Wx, Env, Block, RsTy, Text -> (([GenCase], Wx))
fn GenCases wx, menv, body, vt, name:
    let lx = wx.lx
    let rowName = "{wx.node}Gen{RowSuffix wx}"
    match ?ClauseCall lx, body:
        ? ((qk, args)):
            let clauses = ClausesOf lx.g, qk
            let v = ValOf lx, qk
            Fold (Range0 (Len clauses)), (([[]], wx)), \|((acc, w)), i|
                let c = Or clauses[i], dummyClause
                let cr = ClauseRowOf w, menv, c, v, "{rowName}{i}", name
                (((Push acc, cr.case), cr.parent))
        nil:
            let whole = GenRowOf wx, menv, body, vt, rowName, name
            ((([[GenCase(node=whole.node, params=[[(("value", vt))]], pat=PaWild, conds=[[]], passed=[[XRaw "value"]])]]), whole.parent))

# A generation's body that is one application of a widget of several clauses: the widget
# and the arguments.
?ClauseCall: fn Lx, Block -> ?((Text, [Arg]))
fn ?ClauseCall lx, body = match body.stmts:
    [[st]]: match st.kind:
        SExpr x: ?ClauseCallX lx, x
        SIgnore x: ?ClauseCallX lx, x
        otherwise: nil
    otherwise: nil

?ClauseCallX: fn Lx, Expr -> ?((Text, [Arg]))
fn ?ClauseCallX lx, x = match x.kind:
    ECall c, args, ignore, ignore:
        let qk = BlueprintQk lx, c
        if (Len (ClausesOf lx.g, qk)) > 1: ? ((qk, args)) else: nil
    otherwise: nil

type ClauseRow = record:
    case: GenCase
    parent: Wx

# One clause's generation: its parameters' binders the row's fields, chosen by matching
# the arguments (in the block, `_` the generation's value).
ClauseRowOf: unbounded fn Wx, Env, FnClause, ValInfo, Text, Text -> ClauseRow
fn ClauseRowOf wx, menv, c, v, rowName, genName:
    let upName = "{genName}_up"
    let lx = wx.lx
    let lxc = InModuleAt lx, v.file, v.home, lx.site
    let ptys = match v.scheme.ty:
        TyFn ignore, ps, ignore: ps
        otherwise: [[]]
    let binders = Fold c.params, [[]], \|acc, p| Append acc, (PatternBinders p)
    let fields = Each binders, \|((bn, r))| (((Snake bn), (RustTy lxc, (Peel (BinderTy lxc, r))), bn))
    let rowFields = Push (Each fields, \|((f, t, bn))| ((f, t, "`{bn}`"))), (("parent", (RsWeak wx.node), "the node of the `rebuild`"))
    let rowInits = Push (Each fields, \|((f, ignore, ignore))| ((f, (XMethod (XRaw f), "clone", [[]])))), (("parent", (XRaw "parent")))
    let rowTaken = Append nodeHooks, (Push (Each fields, \|((f, ignore, ignore))| f), "parent")
    let r0 = NewWx lxc, rowName, rowFields, rowInits, [[]], {}, rowTaken, wx.depth, (?HostedRows wx)
    let body = match c.body:
        BodyBlock b: b
        BodyExpr x: Block(stmts=[[(Stmt(kind=(SExpr x), span=x.span))]], inline=True, span=x.span)
    let ((p1, r1, ports)) = RowEnv wx, r0, menv, body
    let ((be, me)) = Fold fields, ((emptyEnv, emptyEnv)), \|((b, m)), ((f, t, bn))| BindPlain b, m, bn, f, t
    let r2 = BlockInto r1, be, me, body
    let r3 = match r2.result:
        WrEv r: Connect r2, r, (SkUp upName)
        otherwise: r2
    let node = FinishNode r3, rowName, (Append (Push (Each fields, \|((f, t, ignore))| ((f, t))), (("parent", (RsWeak wx.node)))), (HostedParams wx)), True
    let p2 = GenMarked p1, genName, r3
    let pos = Each (Range0 (Len c.params)), \|i| RustPat lxc, (Or c.params[i], dummyPat), (Or ptys[i], TyErr), ByRef, "c{i}"
    let pa = PaTuple (Each pos, \|o| o.pa)
    let binds = Fold pos, {}, \|m, o| Fold o.binds, m, \|m2, ((n, b))| Insert m2, n, b
    let passed = Each fields, \|((f, t, bn))| match binds[bn]:
        ? (BnLocal rs, mode, bt): Own (VlPlace (XRaw rs), mode, bt)
        otherwise: XMethod (XRaw f), "clone", [[]]
    ClauseRow(case=GenCase(node=node, params=(Each fields, \|((f, t, ignore))| ((f, t))), pat=pa, conds=(Fold pos, [[]], \|acc, o| Append acc, o.conds), passed=passed), parent=p2)


type GenRow = record:
    node: NodeDef
    parent: Wx

# A generation's node: its `_` a plain field, the block's events it names through ports,
# its result forwarded up to the `rebuild`'s.
GenRowOf: unbounded fn Wx, Env, Block, RsTy, Text, Text -> GenRow
fn GenRowOf wx, menv, body, vt, rowName, genName:
    let lx = wx.lx
    let upName = "{genName}_up"
    let r0 = NewWx lx, rowName, [[(("value", vt, "the generation's value, `_`")), (("parent", (RsWeak wx.node), "the node of the `rebuild`"))]], [[(("value", (XMethod (XRaw "value"), "clone", [[]]))), (("parent", (XRaw "parent")))]], [[]], {}, (Append nodeHooks, [["value", "parent"]]), wx.depth, (?HostedRows wx)
    let ((p1, r1, ports)) = RowEnv wx, r0, menv, body
    let be = Bind (BuildSpelling ports), "_", (BnLocal "value", Owned, vt)
    let me = Bind ports, "_", (BnLocal "self.value", Owned, vt)
    let r2 = BlockInto r1, be, me, body
    let r3 = match r2.result:
        WrEv r: Connect r2, r, (SkUp upName)
        otherwise: r2
    GenRow(node=(FinishNode r3, rowName, (Append [[(("value", vt)), (("parent", (RsWeak wx.node)))]], (HostedParams wx)), True), parent=(GenMarked p1, genName, r3))

# The block's writes behind what a generation's places read mark the generation (gap DY;
# `RowMarks` of kind `GenerationRow`: the current one is dirtied, and told nothing).
GenMarked: fn Wx, Text, Wx -> Wx
fn GenMarked parent, genName, rowWx:
    let reads = RowPlaceReads rowWx
    if (Len reads) == 0: parent
    else: update parent:
        &_.rowMarks <= Push &_.rowMarks, RowMarks(builder=genName, reads=reads, wrote=[[]], kind=GenerationRow)

# A row's names as its constructor spells them: the block through the `parent` argument.
BuildSpelling: fn Env -> Env
fn BuildSpelling env = Fold (Keys env.names), env, \|en, k| match env.names[k]:
    ? (BnLocal rs, mode, t): if (Take rs, 12) == "self.parent.": Bind en, k, (BnLocal (Drop rs, 5), mode, t) else: en
    ? (BnDyn (XMethod (XRaw rs), m, xs), ds, t): if (Take rs, 12) == "self.parent.": Bind en, k, (BnDyn (XMethod (XRaw (Drop rs, 5)), m, xs), ds, t) else: en
    otherwise: en

let dummyGen = GenDef(name="", pos=pos0, at="", source=(XRaw ""), valueTy=RsUnit, select=(XRaw ""))

# The generation built: the one case, its row's constructor.
GenSelect: unbounded fn Wx, Env, Block, [GenCase], Pos -> Ex
fn GenSelect wx, menv, body, cases, pos:
    let tail = Append (Append [[XRaw "Rc::downgrade(self)"]], (HostedPassed wx)), [[XRaw "cx"]]
    match ?ClauseCall wx.lx, body:
        nil: match cases[0]:
            ? c: XTry (XCall "{c.node.name}::build", (Append [[XRaw "path", XRaw "value"]], tail))
            nil: Refusal "a `rebuild` with no generation"
        ? ((qk, args)):
            let env = Bind menv, "_", (BnLocal "value", Owned, RsUnit)
            let scrut = XTuple (Each args, \|a| Argument wx.lx, env, a.value)
            let arms = Each cases, \|c|
                let made = XTry (XCall "{c.node.name}::build", (Append (Append [[XRaw "path.clone()"]], c.passed), tail))
                XArm(pat=c.pat, conds=c.conds, body=(XCast made, (RsNamed "Rc<dyn Row>", [[]])))
            Own (ArmsValue scrut, arms, "'select", (RsNamed "Rc<dyn Row>", [[]]))

# The `rebuild`'s up-forwarding: a generation's result fires the block's event.
GenUp: fn Text, Text, RsTy -> MethDef
fn GenUp name, upName, t = MethDef(name="{name}_up", recv=RecvRc, params=[[(("v", t))]], cx=CxMut, ret=RsUnit, body=[[(SelfCall upName, [[XRaw "v"]])]], tail=(XRaw "()"), doc="The current generation's result fires the `rebuild`'s.")

ForwardGen: fn GenDef -> Ex
fn ForwardGen gd:
    let current = XMethod (XMethod (XRaw "self.{gd.name}"), "borrow", [[]]), "clone", [[]]
    let isCurrent = XBin "==", (XBin "+", (XRaw "*g"), (XRaw "1")), (XMethod (XRaw "self.{gd.name}_count"), "get", [[]])
    XBlock [[(DoLet (PaBind "row"), current), (DoIfLet (PaCtor "Some", [[PaBind "row"]]), (XRaw "row"), [[(DoIf isCurrent, [[DoExpr (XTry (XMethod (XRaw "row"), "answer", [[XRaw "rest", XRaw "v", XRaw "cx"]]))]], [[]])]], [[]])]], (XRaw "()")

# `@Switch $!a`: the event its `rebuild` forwards.
SwitchLine: unbounded fn Wx, Env, [Arg] -> ((Wx, Wres))
fn SwitchLine wx, menv, args = match args[0]:
    ? a:
        let ((r, wx2)) = EventRef wx, menv, a.value
        ((wx2, (WrEv r)))
    nil: ((wx, WrUnit))

# ---------------------------------------------------------------------------------------
# Traits and impls (docs/backend.md: a trait is a Rust trait, `derive` impls; a program's
# own `impl ^Show` prints by `p.raw`)
# ---------------------------------------------------------------------------------------

HasOwnShow: fn Lx, Text -> Bool
fn HasOwnShow lx, tn = Fold (Or lx.g.impls["Prelude.Show"], [[]]), False, \|f, im| f or ((not im.derived) and (HeadName im.head) == tn)

HeadName: fn Ty -> Text
fn HeadName (TyCon n, ignore) = n
fn HeadName other = ""

# A trait's parameter as `Self` in its methods' types.
SelfIn: unbounded fn Ty, Text -> Ty
fn SelfIn t, param = Instantiated t, [[param]], [[(TyCon "\u{0}Self", [[]])]]

TraitDefOf: unbounded fn Lx, TraitInfo -> TraitDef
fn TraitDefOf lx0, tr:
    let lx = InModule lx0, tr.file, tr.home
    let methods = Each tr.methods, \|mq|
        let v = Or lx.g.vals[mq], (Builtin mq, (Mono TyErr))
        let sc = update v.scheme:
            &_.ty <= SelfIn &_.ty, tr.param
            &_.qs <= Filter &_.qs, \|q| q != tr.param
            &_.bounds <= Filter &_.bounds, \|((q, ignore))| q != tr.param
        let defaultQk = Fold tr.defaults, "", \|f, dq| if (BareName dq) == (BareName mq): dq else: f
        let clauses = if defaultQk == "": [[]] else: DefaultClauses lx.g, defaultQk
        let fd = FnDefOf lx, mq, (if (Len clauses) == 0: [[dummyClause]] else: clauses), sc
        update fd:
            &_.public <= (Len clauses) > 0
    TraitDef(name=(Camel (BareName tr.name)), methods=methods, defaults=tr.defaults, doc=(TypeDoc lx, (TyInfo(name=tr.name, home=tr.home, params=[[]], body=BOpaque, derives=[[]], file=tr.file, span=tr.span))))

DefaultClauses: fn G, Text -> [FnClause]
fn DefaultClauses g, qk = Fold g.defs, [[]], \|acc, d| if d.qk == qk: DefaultOf d, acc else: acc

DefaultOf: fn Def, [FnClause] -> [FnClause]
fn DefaultOf d, other = match d.body:
    DbDefault cs, ignore: cs
    otherwise: other

# An impl's methods, each with its trait's scheme at the impl's head.
ImplDefOf: unbounded fn Lx, ImplInfo -> ImplDef
fn ImplDefOf lx, im:
    let tr = Or lx.g.traits[im.cls], dummyTraitInfo
    let head = RustTy lx, im.head
    let defs = Filter lx.g.defs, \|d| IsMethodOf d, im
    let methods = Each defs, \|d|
        let mq = Fold tr.methods, "", \|found, q| if (BareName q) == d.name: q else: found
        let v = Or lx.g.vals[mq], (Builtin mq, (Mono TyErr))
        let sc = update v.scheme:
            &_.ty <= Instantiated &_.ty, [[tr.param]], [[im.head]]
            &_.qs <= Filter &_.qs, \|q| q != tr.param
            &_.bounds <= Filter &_.bounds, \|((q, ignore))| q != tr.param
        let fd = FnDefOf lx, mq, (MethodClauses d), sc
        if (Take im.cls, 8) == "Prelude.": Renamed fd, "{Snake d.name}_{Snake (BareName (HeadName im.head))}" else: fd
    let generics = Each im.qs, \|q| ((Camel q, [["Clone"]]))
    ImplDef(cls=im.cls, tr=(PathIn lx, tr.home, (Camel (BareName im.cls))), head=head, generics=generics, methods=methods, doc="")

Renamed: fn FnDef, Text -> FnDef
fn Renamed fd, n = update fd:
    &_.name <= n

IsMethodOf: fn Def, ImplInfo -> Bool
fn IsMethodOf d, im = match d.body:
    DbMethod ignore, cls, other: cls == im.cls and other.span == im.span and other.file == im.file
    otherwise: False

MethodClauses: fn Def -> [FnClause]
fn MethodClauses d = match d.body:
    DbMethod cs, ignore, ignore: cs
    otherwise: [[]]

# A building `if` over a plain condition (Semantics ch. 4: it picks its arm once, at the
# build): each arm a generation of its own, one built (pick BI of the README: under its
# place `n/#0`, where the book's arms are transparent).
IfGenLine: unbounded fn Wx, Env, Expr, Block, Block, Expr -> ((Wx, Wres))
fn IfGenLine wx, menv, c, thenB, elseB, e:
    let lx = wx.lx
    let pos = wx.pos
    let wx1 = update wx:
        &_.pos <= NextPos &_.pos
    let ((name, wx2)) = FreshName wx1, "arm"
    let base = "{wx.node}{Camel name}{RowSuffix wx}"
    let yes = GenRowOf wx2, menv, thenB, RsUnit, "{base}Then", name
    let no = GenRowOf yes.parent, menv, elseB, RsUnit, "{base}Else", name
    let cond = AsBool (ValueOf lx, menv, c)
    let tail = Append (Append [[XRaw "Rc::downgrade(self)"]], (HostedPassed wx)), [[XRaw "cx"]]
    let Mk = \|n| XCast (XTry (XCall "{n.name}::build", (Append [[XRaw "path", XRaw "value"]], tail))), (RsNamed "Rc<dyn Row>", [[]])
    let select = XIf cond, (Mk yes.node), (Mk no.node)
    let wx3 = update no.parent:
        &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, at=(PlaceAt wx, "self", pos), source=(XRaw "()"), valueTy=RsUnit, select=select)
        &_.genHolds <= Push &_.genHolds, ((name, [[]]))
        &_.rows <= Append (Append (Append (Push &_.rows, yes.node), yes.node.children), [[no.node]]), no.node.children
        &_.getters <= Push &_.getters, (MethDef(name="{name}_up", recv=RecvRc, params=[[(("v", RsUnit))]], cx=CxMut, ret=RsUnit, body=[[]], tail=(XRaw "()"), doc="An arm's result, which a building `if` of widgets drops."))
    ((wx3, WrUnit))
