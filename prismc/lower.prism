# Lowering: the checked program to the core form emission spells as Rust (Compiler ch. 3,
# "The translation, construct by construct"; docs/backend.md, the contract). The input is
# the tree as parsed, the checker's environment (CheckEnv's `G`: every module, type,
# constructor, tag, trait and impl, every definition with its clauses) and its typed
# tables (typed.prism's `TProgram`: the type of every expression, the lifting decision at
# every application, the impl solved at every method). The output, a `Model`, decides
# everything: one Rust type per Prism type, names, which value is borrowed and which is
# cloned, the node of every widget with its fields, methods, heights and places, the
# step machine of every unbounded function. Emission (emit.prism) and the templates
# (templates/*.prism) only spell it (K9).
#
# The core form is a small imperative language (Compiler ch. 4, "The class model"):
# expressions (`Ex`), statements (`Do`), patterns (`Pa`) and Rust types (`RsTy`), with
# items (`Item`) for types, tags, functions, jobs and nodes. Every constructor here has a
# prefix of its type, since constructors share one namespace with the modules this one
# uses (Rs, X, Do, Pa, Cc, It, Bn, Vl, Sk).
#
# Written by Claude, 1 November 2026, on the claude-self-hosting branch. Subject to change:
# Jimmy rewrites it by hand, and an implementer reading it uses their own discretion.
module Lower
emit r
use Ast.*
use Lexer.*
use CheckErrors.*
use CheckTypes.*
use CheckEnv.*
use Typed.*

# ---------------------------------------------------------------------------------------
# The core form
# ---------------------------------------------------------------------------------------

# A Rust type (docs/backend.md, "Types").
type RsTy = choice:
    RsNat
    RsInt
    RsU8
    RsFloat
    RsBool
    RsChar
    RsText
    RsUnit
    RsPath
    RsDuration
    RsError
    RsNamed Text, [RsTy]
    RsOpt RsTy
    RsRes RsTy
    RsTuple [RsTy]
    RsArray RsTy
    RsMap RsTy, RsTy
    RsFn [RsTy], RsTy
    RsJobFn RsTy, RsTy
    RsJob RsTy
    RsEvent RsTy
    RsDyn RsTy
    RsGen Text
    RsRc RsTy
    RsRef RsTy
    RsPod
    RsShowAny
    RsHold RsTy
    RsStamped RsTy
    RsDefer RsTy
    RsWeak Text
    RsCell RsTy
    RsWakes
    RsPort RsTy
    RsUnknown Text
derive ^Eq, ^Show

# An expression. Every one is a Rust expression; `XRaw` is a name, a path or a literal
# already spelled.
type Ex = choice:
    XRaw Text
    XCall Text, [Ex]
    XApply Ex, [Ex]
    XMethod Ex, Text, [Ex]
    XBin Text, Ex, Ex
    XUnary Text, Ex
    XCtor Text, [Ex]
    XRecord Text, [((Text, Ex))]
    XTuple [Ex]
    XVec [Ex]
    XText Text
    XFormat [Ex]
    XMatch Ex, [XArm], Bool
    XChain Text, Ex, [XArm]
    XIf Ex, Ex, Ex
    XBlock [Do], Ex
    XLabeled Text, [Do], Ex
    XClosure Bool, [Pa], Ex
    XTry Ex
    XField Ex, Text
    XDecode RsTy, Ex
    XCast Ex, RsTy
derive ^Eq, ^Show

# One arm of a `match` or of an if-let chain: the pattern, the conditions after it (a
# guard, or a `let` through a reference counted payload), the value.
type XArm = record:
    pat: Pa
    conds: [Cc]
    body: Ex
derive ^Eq, ^Show

type Cc = choice:
    CcIf Ex
    CcLet Pa, Ex
derive ^Eq, ^Show

# A Rust pattern.
type Pa = choice:
    PaWild
    PaBind Text
    PaCtor Text, [Pa]
    PaUnit Text
    PaRecord Text, [((Text, Pa))], Bool
    PaTuple [Pa]
    PaLit Text
    PaTyped Pa, RsTy
derive ^Eq, ^Show

# A statement of a method body.
type Do = choice:
    DoLet Pa, Ex
    DoLetElse Pa, Ex, Ex
    DoAssign Ex, Ex
    DoWhile Ex, [Do]
    DoWhileLet Pa, Ex, [Do]
    DoExpr Ex
    DoIf Ex, [Do], [Do]
    DoIfLet Pa, Ex, [Do], [Do]
    DoMatch Ex, [((Pa, [Do]))]
    DoReturn Ex
    DoNote Text
derive ^Eq, ^Show

# A Rust type declaration: a record (one case named as the type, named fields), a choice
# (cases with positional fields), a newtype or a unit type.
type TyDef = record:
    name: Text
    prism: Text
    params: [Text]
    kind: Text
    cases: [CaseDef]
    eq: Bool
    ord: Bool
    floaty: Bool
    show: Text
    pod: Bool
    doc: Text
derive ^Eq, ^Show

type CaseDef = record:
    name: Text
    prism: Text
    fields: [((Text, RsTy))]
derive ^Eq, ^Show

# An element tag: the `Level` struct (its plain and dynamic fields, as values after the
# tick) and the tag's qualified name.
type TagDef = record:
    name: Text
    tagName: Text
    fields: [((Text, Text, RsTy))]
    doc: Text
derive ^Eq, ^Show

# A plain function, a top-level `let` (a getter with no parameters), or a check line.
type FnDef = record:
    name: Text
    generics: [((Text, [Text]))]
    params: [((Text, RsTy))]
    ret: RsTy
    body: Ex
    doc: Text
    public: Bool
derive ^Eq, ^Show

# A step machine (D6): one per unbounded function of a group whose calls between
# unbounded functions are all tail calls, so the job needs no stack (`Normalize`).
type JobDef = record:
    name: Text
    start: Text
    generics: [((Text, [Text]))]
    fields: [((Text, RsTy))]
    ret: RsTy
    body: Ex
    doc: Text
derive ^Eq, ^Show

# A method of a node.
type MethDef = record:
    name: Text
    recv: Text
    params: [((Text, RsTy))]
    cx: Text
    ret: RsTy
    body: [Do]
    tail: Ex
    doc: Text
derive ^Eq, ^Show

# A node: one widget block's storage and methods (docs/backend.md, "A widget block").
type NodeDef = record:
    name: Text
    prism: Text
    doc: Text
    params: [((Text, RsTy))]
    fields: [((Text, RsTy, Text))]
    consts: [((Text, Nat, Text))]
    lets: [Do]
    inits: [((Text, Ex))]
    build: [Do]
    fallible: Bool
    methods: [MethDef]
    answers: [((Text, Ex))]
    hooks: [((Text, [Do]))]
    builders: [ForDef]
    wakes: Bool
    children: [NodeDef]
    gens: [GenDef]
    subs: [((Text, Text, RsTy))]
    rowKind: Text
derive ^Eq, ^Show

# A `rebuild` (docs/backend.md, "Dynamic structure"): one generation at `path/n/#g`,
# torn down and built anew from the source after a tick that changed it; the clause of a
# widget of several clauses chosen by matching its arguments.
type GenDef = record:
    name: Text
    pos: Nat
    source: Ex
    valueTy: RsTy
    select: Ex

# A port a row subscribes to: the parent's event `name`, fired to every live row.
type PortDef = record:
    name: Text
    ty: RsTy

# A `for` builder (docs/backend.md, "Dynamic structure"): a map of rows, each a node of
# its own at `path/n/[k]`, rebuilt from the source after the tick.
type ForDef = record:
    name: Text
    pos: Nat
    source: Ex
    keyTy: RsTy
    valueTy: RsTy
    rowNode: Text
    keyed: Bool

# The program of a root widget, as a World drives it.
type ProgDef = record:
    name: Text
    prism: Text
    node: Text
    params: [((Text, RsTy))]
    fallible: Bool
    world: Text
derive ^Eq, ^Show

# A compiled `check` block: each line's value as plain data.
type CheckDef = record:
    name: Text
    lines: [Ex]
derive ^Eq, ^Show

# A program's own trait: each method an associated function over `Self`, a default's body.
type TraitDef = record:
    name: Text
    methods: [FnDef]
    defaults: [Text]
    doc: Text
derive ^Eq, ^Show

# An `impl`: of a program's trait, its methods; of `^Show`, `^Eq` or `^Ord`, the Rust
# trait the emitted code's operators and printer read, over a function of its own.
type ImplDef = record:
    cls: Text
    tr: Text
    head: RsTy
    generics: [((Text, [Text]))]
    methods: [FnDef]
    doc: Text
derive ^Eq, ^Show

type Item = choice:
    ItTrait TraitDef
    ItImpl ImplDef
    ItType TyDef
    ItTag TagDef
    ItFn FnDef
    ItJob JobDef
    ItNode NodeDef
    ItNote Text
derive ^Eq, ^Show

# One Prism module as one Rust module.
type ModDef = record:
    name: Text
    prism: Text
    path: Text
    uses: [Text]
    items: [Item]
derive ^Eq, ^Show

type Model = record:
    name: Text
    mods: [ModDef]
    programs: [ProgDef]
    root: ?ProgDef
    checks: [CheckDef]
    scripts: [Text]
    notes: [Text]
derive ^Eq, ^Show

# ---------------------------------------------------------------------------------------
# The context: the environment, the typed tables by place, the module being lowered
# ---------------------------------------------------------------------------------------

type Lx = record:
    g: G
    tys: (Text ==> Ty)
    apps: (Text ==> AppNote)
    binders: (Text ==> Ty)
    impls: (Text ==> [ImplNote])
    file: Nat
    home: Text
    site: Text
    rsMods: (Text ==> Text)
    rsNames: (Text ==> Text)
    layouts: (Text ==> [Bool])
    unbs: [Text]
    notes: [Text]
derive ^Eq, ^Show

# A key into the typed tables: the file and the range.
LoKey: fn Lx, Range -> Text
fn LoKey lx, r = "{lx.file}:{r.start}:{r.end}"

LoTyOf: fn Lx, Range -> Ty
fn LoTyOf lx, r = Or lx.tys[LoKey lx, r], TyErr

?LoAppOf: fn Lx, Range -> ?AppNote
fn ?LoAppOf lx, r = lx.apps[LoKey lx, r]

LoBinderTy: fn Lx, Range -> Ty
fn LoBinderTy lx, r = Or lx.binders[LoKey lx, r], (LoTyOf lx, r)

# How the constraint of trait `cls` at a place was solved: `builtin`, `derived ..`,
# `impl ..`, `given`, or "" when none was recorded.
LoImplHow: fn Lx, Range, Text -> Text
fn LoImplHow lx, r, cls = Fold (Or lx.impls[LoKey lx, r], [[]]), "", \|found, n| if found == "" and n.cls == cls: n.how else: found

# The tables of the typed program by place.
LoTables: fn TProgram -> (((Text ==> Ty), (Text ==> AppNote), (Text ==> Ty), (Text ==> [ImplNote])))
fn LoTables tp:
    let tys = Fold tp.exprs, {}, \|m, n| Insert m, (AtKey n.at), n.ty
    let apps = Fold tp.apps, {}, \|m, n| Insert m, (AtKey n.at), n
    let bs = Fold tp.binders, {}, \|m, n| Insert m, (AtKey n.at), n.ty
    let ims = Fold tp.impls, {}, \|m, n| Insert m, (AtKey n.at), (Push (Or m[AtKey n.at], [[]]), n)
    ((tys, apps, bs, ims))

# ---------------------------------------------------------------------------------------
# Names (Compiler ch. 4: a block's class is named after its function, a binding after its
# variable; pick NM of the README: Rust's conventions)
# ---------------------------------------------------------------------------------------

let rustKeywords = [["as", "async", "await", "box", "break", "const", "continue", "crate", "do", "dyn", "else", "enum", "extern", "false", "final", "fn", "for", "gen", "if", "impl", "in", "let", "loop", "macro", "match", "mod", "move", "mut", "override", "priv", "pub", "ref", "return", "self", "static", "struct", "super", "trait", "true", "try", "type", "typeof", "unsafe", "unsized", "use", "virtual", "where", "while", "yield", "u8", "u16", "u32", "u64", "i8", "i16", "i32", "i64", "f32", "f64", "bool", "char", "str", "usize", "isize", "cx", "node", "path", "v", "p"]]

# A Prism name without its sigils.
LoBase: fn Text -> Text
fn LoBase name = Drop name, (Len (MarksOf name))

# `rootModule` and `ParseNat` as `root_module` and `parse_nat`; a Rust keyword, or a name
# the emitted code uses for itself, takes a `_`.
LoSnake: fn Text -> Text
fn LoSnake name:
    let ((out, ignore)) = Fold (Chars (LoBase name)), (("", "")), \|((acc, prev)), c|
        let sep = if (IsUpper c) and ((IsLower prev) or (IsDigit prev)): "_" else: ""
        ((("{acc}{sep}{LoLowerChar c}"), c))
    let plain = if out == "": "x" else: out
    if HasText rustKeywords, plain: "{plain}_" else: plain

LoLowerChar: fn Text -> Text
fn LoLowerChar c = if IsUpper c: Lower c else: c

# A type or constructor name as Rust writes one: the first letter upper.
LoCamel: fn Text -> Text
fn LoCamel name:
    let b = LoBase name
    let first = Take b, 1
    let fixed = if IsLower first: "{Upper first}{Drop b, 1}" else: b
    if fixed == "Self": "Self_" else: fixed

# A Prism module's Rust module.
LoModName: fn Text -> Text
fn LoModName m = if m == "": "program" else: LoSnake (Join (Split m, "."), "_")

# The Rust path of a module's item `name` as written in module `here`.
LoPathIn: fn Lx, Text, Text -> Text
fn LoPathIn lx, owner, name:
    if owner == lx.site: name
    else: if owner == "Prelude": name
    else: "{Or lx.rsMods[owner], (LoModName owner)}::{name}"

# The Rust name of a top-level value of a module: its snake case, with a suffix by its
# sigil when another value of the module has the same base (`?ParseNat` and `~ParseNat`).
LoValueNames: fn G -> (Text ==> Text)
fn LoValueNames g:
    let keys = Keys g.vals
    let bases = Fold keys, {}, \|m, k| Insert m, (LoBaseKey k), (Push (Or m[LoBaseKey k], [[]]), k)
    Fold keys, {}, \|m, k| Insert m, k, (LoValueName k, (Len (Or bases[LoBaseKey k], [[]])))

LoBaseKey: fn Text -> Text
fn LoBaseKey k:
    let parts = Split k, "."
    let last = Or (?Last parts), k
    "{Join (Take parts, (Dec (Len parts))), "."}.{LoSnake last}"

LoValueName: fn Text, Nat -> Text
fn LoValueName k, count:
    let last = BareName k
    let marks = MarksOf last
    let base = LoSnake last
    if count > 1 and marks != "": "{Drop base, 0}_{LoSigilWord (Take marks, 1)}"
    else: base

LoSigilWord: fn Text -> Text
fn LoSigilWord "?" = "opt"
fn LoSigilWord "~" = "try"
fn LoSigilWord "!" = "ev"
fn LoSigilWord "$" = "dyn"
fn LoSigilWord "@" = "widget"
fn LoSigilWord "&" = "ref"
fn LoSigilWord other = "x"

# A top-level value's Rust path from the current module.
LoValuePath: fn Lx, Text -> Text
fn LoValuePath lx, qk:
    let owner = match lx.g.vals[qk]:
        ? v: v.home
        nil: LoOwnerOf qk
    LoPathIn lx, owner, (Or lx.rsNames[qk], (LoSnake (BareName qk)))

# The module a qualified key belongs to: everything before its last segment.
LoOwnerOf: fn Text -> Text
fn LoOwnerOf qk:
    let parts = Split qk, "."
    Join (Take parts, (Dec (Len parts))), "."

# A tag's Rust struct: its family and name run together (`Ui.Button` is `UiButton`).
LoTagStruct: fn Text -> Text
fn LoTagStruct tn = Concat (Each (Split tn, "."), \|p| LoCamel p)

# ---------------------------------------------------------------------------------------
# Types (docs/backend.md, "Types")
# ---------------------------------------------------------------------------------------

# A checker type as a Rust type. The time layers outside are the caller's to peel: a `$a`
# or `!a` that is a value is `Dynamic` or `Event`.
LoTy: unbounded fn Lx, Ty -> RsTy
fn LoTy lx, t = match t:
    TyCon "Nat", [[]]: RsNat
    TyCon "Int", [[]]: RsInt
    TyCon "U8", [[]]: RsU8
    TyCon "Float", [[]]: RsFloat
    TyCon "Bool", [[]]: RsBool
    TyCon "Char", [[]]: RsChar
    TyCon "Text", [[]]: RsText
    TyCon "unit", [[]]: RsUnit
    TyCon "Path", [[]]: RsPath
    TyCon "Duration", [[]]: RsDuration
    TyCon "Prelude.Error", [[]]: RsError
    TyCon "\u{0}Self", [[]]: RsNamed "Self", [[]]
    TyCon "Buffer", [[a]]: RsArray (LoTy lx, a)
    TyCon "Table", [[k, v]]: RsArray (RsTuple [[(LoTy lx, k), (LoTy lx, v)]])
    TyCon n, args: LoNamedTy lx, n, (Each args, \|a| LoTy lx, a)
    TyFn c, ps, res:
        if c == CUnbound: RsJobFn (LoTyOfParams lx, ps), (LoTy lx, res)
        else: RsFn (Each ps, \|p| LoTy lx, p), (LoTy lx, res)
    TyTuple [[]]: RsUnit
    TyTuple ts: RsTuple (Each ts, \|a| LoTy lx, a)
    TyArray e: RsArray (LoTy lx, e)
    TyMap k, v: RsMap (LoTy lx, k), (LoTy lx, v)
    TySig "?", i: RsOpt (LoTy lx, i)
    TySig "~", i: RsRes (LoTy lx, i)
    TySig "!", i: RsEvent (LoTy lx, i)
    TySig "$", i: RsDyn (LoTy lx, i)
    TySig "&", i: LoTy lx, i
    TySig ignore, i: LoTy lx, i
    TyQ n: RsGen (LoCamel n)
    TyRigid n: RsGen (LoCamel n)
    TyFlex ignore: RsUnit
    TyAny ignore: RsShowAny
    TyElem ignore, ignore: RsPod
    TyElemAny ignore: RsPod
    TyAt i, ignore: RsUnknown "a blueprint value"
    TyAssoc ignore, ignore: RsUnknown "an associated type"
    TyErr: RsUnknown "a type the checker did not find"

# An unbounded function's parameter as a job function's: one parameter is itself, several
# a tuple.
LoTyOfParams: unbounded fn Lx, [Ty] -> RsTy
fn LoTyOfParams lx, ps = match ps:
    [[p]]: LoTy lx, p
    otherwise: RsTuple (Each ps, \|p| LoTy lx, p)

# A declared type: an alias is its target; a prelude type is the prelude module's.
LoNamedTy: unbounded fn Lx, Text, [RsTy] -> RsTy
fn LoNamedTy lx, n, args = match lx.g.types[n]:
    ? ti: match ti.body:
        BAlias a: LoTy lx, a
        BRowKind: RsPod
        otherwise: RsNamed (LoPathIn lx, ti.home, (LoCamel (BareName n))), args
    nil: if HasKey lx.g.families, n: RsPod else: RsNamed (LoCamel (BareName n)), args

# A type with its time layers peeled: what a value of it holds at one moment.
LoPeel: fn Ty -> Ty
fn LoPeel t = match t:
    TySig "$", i: LoPeel i
    TySig "!", i: LoPeel i
    TySig "&", i: LoPeel i
    otherwise: t

# What a blueprint gives, its layers peeled: `@!Term` holds a `Term` at a firing.
LoOutOf: fn Ty -> Ty
fn LoOutOf t = match t:
    TyAt i, ignore: LoPeel i
    otherwise: LoPeel t

# The outermost time layer of a type: `$`, `!`, `@` or "".
LoLayer: fn Ty -> Text
fn LoLayer t = match t:
    TySig "$", ignore: "$"
    TySig "!", ignore: "!"
    TySig "&", i: LoLayer i
    TyAt ignore, ignore: "@"
    otherwise: ""

# Whether a constructor's fields hold their type's own values by value (directly, in an
# optional or a tuple), so they go behind an `Rc` (docs/backend.md: recursive payloads
# behind `Rc`). Arrays and maps are behind a pointer already.
LoLayouts: unbounded fn G -> (Text ==> [Bool])
fn LoLayouts g = Fold (Values g.ctors), {}, \|m, c| Insert m, c.name, (Each c.args, \|a| LoReaches g, a, c.owner, [[]])

LoReaches: unbounded fn G, Ty, Text, [Text] -> Bool
fn LoReaches g, t, target, seen = match t:
    TyCon n, args:
        if n == target: True
        else: if HasText seen, n: False
        else: if Fold args, False, \|f, a| f or LoReaches g, a, target, seen: True
        else: match g.types[n]:
            ? ti: match ti.body:
                BRecord fs: Fold fs, False, \|f, ((ignore, ft))| f or LoReaches g, ft, target, (Push seen, n)
                BChoice cs: Fold cs, False, \|f, ((ignore, ats))| f or Fold ats, False, \|f2, at| f2 or LoReaches g, at, target, (Push seen, n)
                BAlias a: LoReaches g, a, target, (Push seen, n)
                otherwise: False
            nil: False
    TySig "?", i: LoReaches g, i, target, seen
    TySig "~", i: LoReaches g, i, target, seen
    TyTuple ts: Fold ts, False, \|f, a| f or LoReaches g, a, target, seen
    otherwise: False

# Whether constructor `ctor`'s field `i` is behind an `Rc`.
LoRcField: fn Lx, Text, Nat -> Bool
fn LoRcField lx, ctor, i = Or (Or lx.layouts[ctor], [[]])[i], False

# Whether a type holds a `Float` anywhere, which keeps it out of `Eq` and `Ord`.
LoFloaty: unbounded fn G, Ty, [Text] -> Bool
fn LoFloaty g, t, seen = match t:
    TyCon "Float", [[]]: True
    TyCon n, args:
        if Fold args, False, \|f, a| f or LoFloaty g, a, seen: True
        else: if HasText seen, n: False
        else: match g.types[n]:
            ? ti: match ti.body:
                BRecord fs: Fold fs, False, \|f, ((ignore, ft))| f or LoFloaty g, ft, (Push seen, n)
                BChoice cs: Fold cs, False, \|f, ((ignore, ats))| f or Fold ats, False, \|f2, at| f2 or LoFloaty g, at, (Push seen, n)
                otherwise: False
            nil: False
    TySig ignore, i: LoFloaty g, i, seen
    TyTuple ts: Fold ts, False, \|f, a| f or LoFloaty g, a, seen
    TyArray e: LoFloaty g, e, seen
    TyMap k, v: (LoFloaty g, k, seen) or LoFloaty g, v, seen
    otherwise: False

# Whether a Rust type can cross to a World (`ToPod`, `FromPod`).
LoPodable: unbounded fn RsTy -> Bool
fn LoPodable t = match t:
    RsFn ignore, ignore: False
    RsJobFn ignore, ignore: False
    RsJob ignore: False
    RsEvent ignore: False
    RsDyn ignore: False
    RsShowAny: False
    RsUnknown ignore: False
    RsGen ignore: True
    RsNamed ignore, args: Fold args, True, \|ok, a| ok and LoPodable a
    RsOpt i: LoPodable i
    RsRes i: LoPodable i
    RsRc i: LoPodable i
    RsTuple ts: Fold ts, True, \|ok, a| ok and LoPodable a
    RsArray e: LoPodable e
    RsMap k, v: (LoPodable k) and LoPodable v
    otherwise: True

# ---------------------------------------------------------------------------------------
# Values: what a Prism name stands for, and how a value is borrowed or owned (Compiler
# ch. 4, "The ownership layer": a function takes references and returns a value)
# ---------------------------------------------------------------------------------------

# A name where it is read. `BnLocal` is a Rust place and how it holds its value: `ref` a
# `&T`, `own` a `T` (a local, a field), `rc` a `&Rc<T>` (a payload behind an `Rc`, matched
# through a reference), `rcown` an `Rc<T>`. In a widget block a hold reads at the read
# point, a derived dynamic is a reader, and an event is a node of the block's graph.
type Bn = choice:
    BnLocal Text, Text, RsTy
    BnHold Text, RsTy
    BnDyn Ex, [Text], RsTy
    BnEv EvRef, RsTy

type LoEnv = record:
    names: (Text ==> Bn)
    spans: (Text ==> Vl)

let emptyEnv = LoEnv(names={}, spans={})

LoBindSpan: fn LoEnv, Text, Vl -> LoEnv
fn LoBindSpan env, nkey, v = update env:
    &_.spans <= Insert &_.spans, nkey, v

LoBind: fn LoEnv, Text, Bn -> LoEnv
fn LoBind env, name, b = update env:
    &_.names <= Insert &_.names, name, b

# A lowered value: a place with its mode, or an owned temporary.
type Vl = choice:
    VlPlace Ex, Text, RsTy
    VlOwned Ex, RsTy

LoVlTy: fn Vl -> RsTy
fn LoVlTy (VlPlace ignore, ignore, t) = t
fn LoVlTy (VlOwned ignore, t) = t

LoLocal: fn Text, Text, RsTy -> Vl
fn LoLocal rs, mode, t = VlPlace (XRaw rs), mode, t

# The value, owned: a place is cloned (values are cheap to clone, docs/backend.md).
LoOwn: fn Vl -> Ex
fn LoOwn (VlPlace x, "rc", ignore) = XMethod (XUnary "*", (XUnary "*", x)), "clone", [[]]
fn LoOwn (VlPlace x, "rcown", ignore) = XMethod (XUnary "*", x), "clone", [[]]
fn LoOwn (VlPlace x, mode, t) = if LoIsCopy t: LoCopy (VlPlace x, mode, t) else: XMethod x, "clone", [[]]
fn LoOwn (VlOwned e, ignore) = e

# The value, borrowed: what a parameter takes.
LoRef: fn Vl -> Ex
fn LoRef (VlPlace x, "ref", ignore) = x
fn LoRef (VlPlace x, "rc", ignore) = XUnary "&", (XUnary "*", (XUnary "*", x))
fn LoRef (VlPlace x, "rcown", ignore) = XUnary "&", (XUnary "*", x)
fn LoRef (VlPlace x, ignore, ignore) = XUnary "&", x
fn LoRef (VlOwned e, ignore) = XUnary "&", e

# A copy type's value: `bool`, `f64`, `u8`, `char`, `()`.
LoCopy: fn Vl -> Ex
fn LoCopy (VlPlace x, "ref", ignore) = XUnary "*", x
fn LoCopy (VlPlace x, "rc", ignore) = XUnary "*", (XUnary "*", (XUnary "*", x))
fn LoCopy (VlPlace x, ignore, ignore) = x
fn LoCopy (VlOwned e, ignore) = e

LoIsCopy: fn RsTy -> Bool
fn LoIsCopy t = t == RsBool or t == RsFloat or t == RsU8 or t == RsChar or t == RsUnit

# A value used as a condition or an operand of `and`.
LoBool: fn Vl -> Ex
fn LoBool v = LoCopy v

# ---------------------------------------------------------------------------------------
# Literals
# ---------------------------------------------------------------------------------------

# A Rust string literal's inside.
LoEscape: fn Text -> Text
fn LoEscape t = Concat (Each (Chars t), \|c| LoEscapeChar c)

LoEscapeChar: fn Text -> Text
fn LoEscapeChar "\\" = "\\\\"
fn LoEscapeChar "\"" = "\\\""
fn LoEscapeChar "\n" = "\\n"
fn LoEscapeChar "\t" = "\\t"
fn LoEscapeChar "\u{d}" = "\\r"
fn LoEscapeChar "\u{0}" = "\\0"
fn LoEscapeChar c = c

# A number literal of a numeric type.
LoNumber: fn RsTy, Text, Bool -> Ex
fn LoNumber t, digits, neg:
    let clean = Concat (Filter (Chars digits), \|c| c != "_")
    let signed = if neg: "-{clean}" else: clean
    match t:
        RsNat: if (Len clean) <= 9: XCall "Nat::from", [[XRaw "{clean}u32"]] else: XRaw "Nat::from_int(Int::from({clean}i64)).unwrap()"
        RsInt: XCall "Int::from", [[XRaw (if (Len clean) <= 18: "{signed}" else: "{signed}i64")]]
        RsU8: XRaw "{clean}u8"
        RsFloat: XRaw (if Contains clean, ".": signed else: "{signed}.0")
        otherwise: XCall "Int::from", [[XRaw signed]]

LoLit: unbounded fn Lx, LoEnv, Literal, Range, Bool -> Vl
fn LoLit lx, env, l, span, neg:
    let t = LoTy lx, (LoPeel (LoTyOf lx, span))
    match l.kind:
        LInt d: VlOwned (LoNumber t, d, neg), t
        LFloat d: VlOwned (XRaw (if neg: "-{d}" else: d)), RsFloat
        LChar c: VlOwned (XRaw "'{LoEscapeChar c}'"), RsChar
        LDuration d, u: VlOwned (XRaw "todo!(\"a Duration literal\")"), RsDuration
        LText segs: LoTextSegs lx, env, segs

# A text, interpolated: `Text::from(format!(..))`, a `Text` placed as it is and any other
# value through `^Show` (Type System ch. 4).
LoTextSegs: unbounded fn Lx, LoEnv, [TextSeg] -> Vl
fn LoTextSegs lx, env, segs:
    let plain = Fold segs, True, \|ok, s| ok and LoPlainSeg s
    if plain: VlOwned (XText (Concat (Each segs, \|s| LoPlainText s))), RsText
    else: VlOwned (XFormat (Each segs, \|s| LoSeg lx, env, s)), RsText

LoPlainSeg: fn TextSeg -> Bool
fn LoPlainSeg (SegPlain ignore) = True
fn LoPlainSeg (SegPlaceholder ignore) = False

LoPlainText: fn TextSeg -> Text
fn LoPlainText (SegPlain t) = t
fn LoPlainText (SegPlaceholder ignore) = ""

LoSeg: unbounded fn Lx, LoEnv, TextSeg -> Ex
fn LoSeg lx, env, (SegPlain t) = XText t
fn LoSeg lx, env, (SegPlaceholder e):
    let v = LoX lx, env, e
    LoShownPart v

# A placeholder's text: a `Text` or a number as it displays, anything else as it shows.
LoShownPart: fn Vl -> Ex
fn LoShownPart v = match LoVlTy v:
    RsText: LoRef v
    RsNat: LoRef v
    RsInt: LoRef v
    RsU8: LoRef v
    otherwise: XCall "show", [[LoRef v]]

# ---------------------------------------------------------------------------------------
# Plain expressions (docs/backend.md, "Functions and lifting": a plain function takes
# references, its clauses one `match`)
# ---------------------------------------------------------------------------------------

LoTodo: fn Text -> Ex
fn LoTodo what = XCall "todo!", [[XRaw "\"{LoEscape what}\""]]

LoX: unbounded fn Lx, LoEnv, Expr -> Vl
fn LoX lx, env, e = match env.spans[LoKey lx, e.span]:
    ? v: v
    nil: LoXKind lx, env, e

# An event's value inside the expression that maps it is bound by the event's place in
# the source (`LoEnv.spans`), so the map is the plain expression over that value.
LoXKind: unbounded fn Lx, LoEnv, Expr -> Vl
fn LoXKind lx, env, e:
    let t = LoTy lx, (LoPeel (LoTyOf lx, e.span))
    match e.kind:
        EName n: LoName lx, env, n, e.span
        ELit l: LoLit lx, env, l, e.span, False
        EUnit ignore: VlOwned (XRaw "()"), RsUnit
        EBound b: match env.names[b]:
            ? (BnLocal rs, mode, bt): LoLocal rs, mode, bt
            otherwise: VlOwned (LoTodo "`{b}` outside a `for`"), t
        ENil ignore: VlOwned (XRaw "None"), t
        ETuple es: VlOwned (XTuple (Each es, \|x| LoOwn (LoX lx, env, x))), t
        EArray [[]]: VlOwned (XRaw "Array::new()"), t
        EArray es: VlOwned (XCall "Array::from", [[XVec (Each es, \|x| LoOwn (LoX lx, env, x))]]), t
        EMap [[]]: VlOwned (XRaw "Map::new()"), t
        EMap kvs: VlOwned (XCall "map_of", [[XVec (Each kvs, \|((k, v))| XTuple [[LoOwn (LoX lx, env, k), LoOwn (LoX lx, env, v)]])]]), t
        EGroup x: LoX lx, env, x
        ECall c, args, ignore, ignore: LoCall lx, env, c, args, e.span
        EMethod r, m, args: LoCall lx, env, (Expr(kind=(EName m), span=m.span)), (Append [[Arg(name=nil, value=r, span=r.span)]], args), e.span
        EBinary op, l, r: LoBinary lx, env, op, l, r, e.span
        EUnary "not", x: VlOwned (XUnary "!", (LoBool (LoX lx, env, x))), RsBool
        EUnary "neg", x: match x.kind:
            ELit l: LoLit lx, env, l, x.span, True
            otherwise:
                let v = LoX lx, env, x
                if LoIsCopy t: VlOwned (XUnary "-", (LoCopy v)), t else: VlOwned (XUnary "-", (LoRef v)), t
        EUnary ignore, x: LoX lx, env, x
        EFreeSigil "?", x: VlOwned (XCtor "Some", [[LoOwn (LoX lx, env, x)]]), t
        EFreeSigil "~", x: VlOwned (XCtor "Ok", [[LoOwn (LoX lx, env, x)]]), t
        EFreeSigil ignore, x: LoX lx, env, x
        EField r, ignore, name: LoFieldOf lx, env, r, name.name
        EIndex r, i: LoIndex lx, env, r, i, t
        ELambda ?ps, body: LoLambdaRc lx, env, e, (Or ?ps, [[]]), body
        EIf c, thenB, ?elseB: LoIf lx, env, c, thenB, ?elseB, t
        EMatch s, arms: LoMatch lx, env, s, arms, t, e.span
        ETemplate tp: LoTemplate lx, env, tp
        ECast x, ignore, ignore: LoX lx, env, x
        ETypeArgs x, ignore: LoX lx, env, x
        EGiven b: LoGiven lx, env, b, t, e.span
        EUpdate target, b: LoUpdate lx, env, target, b, t, e.span
        EAny x: VlOwned (XCall "Rc::new", [[LoOwn (LoX lx, env, x)]]), RsShowAny
        otherwise: VlOwned (LoTodo "an expression this back end does not lower yet"), t

# A name: a local, or a global value, constructor or `let`.
LoName: unbounded fn Lx, LoEnv, SName, Range -> Vl
fn LoName lx, env, n, span:
    let nkey = SNameKey n
    let t = LoTy lx, (LoPeel (LoTyOf lx, span))
    let ?local = if (Len n.path) == 1: env.names[nkey] else: nil
    match ?local:
        ? (BnLocal rs, mode, lt): LoLocal rs, mode, lt
        ? (BnHold f, ht): VlOwned (XMethod (XRaw "self.{f}"), "get", [[XRaw "cx"]]), ht
        ? (BnDyn x, ignore, dt): VlOwned x, dt
        ? (BnEv ignore, et): VlOwned (LoTodo "an event read as a value"), et
        nil:
            let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
            match ?qk:
                ? "True": VlOwned (XRaw "true"), RsBool
                ? "False": VlOwned (XRaw "false"), RsBool
                ? "Prelude.never": VlOwned (XRaw "Event::never()"), t
                ? qk: LoGlobalValue lx, qk, span, t
                nil: VlOwned (LoTodo "the name {nkey}, which nothing declares"), t

# A global named, not called: a constructor with no fields, a top-level `let` (its
# getter), a fault kind, or a function as a value.
LoGlobalValue: unbounded fn Lx, Text, Range, RsTy -> Vl
fn LoGlobalValue lx, qk, span, t = match lx.g.ctors[qk]:
    ? c: LoCtorApp lx, emptyEnv, c, [[]], span
    nil: match lx.g.tags[qk]:
        ? tg: VlOwned (XRaw "\"{tg.name}\""), t
        nil: if Fold lx.g.defs, False, \|f, d| f or (d.qk == qk and LoIsLetDef d): VlOwned (XCall (LoValuePath lx, qk), [[]]), t
        else: match lx.g.vals[qk]:
            ? v:
                let isLet = Fold lx.g.defs, False, \|f, d| f or (d.qk == qk and LoIsLetDef d)
                if isLet: VlOwned (XCall (LoValuePath lx, qk), [[]]), t
                else: match t:
                    RsJobFn ignore, ignore: VlOwned (XRaw (LoStartPath lx, qk)), t
                    otherwise: VlOwned (XCall "Rc::new", [[XRaw (LoValuePath lx, qk)]]), t
            nil: VlOwned (LoTodo "the global {qk}"), t

LoIsLetDef: fn Def -> Bool
fn LoIsLetDef d = match d.body:
    DbLet ignore: True
    otherwise: False

# The `Start` of an unbounded function: what its value is when passed to `@Run`.
LoStartPath: fn Lx, Text -> Text
fn LoStartPath lx, qk:
    let owner = match lx.g.vals[qk]:
        ? v: v.home
        nil: LoOwnerOf qk
    LoPathIn lx, owner, "start_{Or lx.rsNames[qk], (LoSnake (BareName qk))}"

# `f a, b`.
LoCall: unbounded fn Lx, LoEnv, Expr, [Arg], Range -> Vl
fn LoCall lx, env, callee, args, span:
    let t = LoTy lx, (LoPeel (LoTyOf lx, span))
    match callee.kind:
        EName n:
            let nkey = SNameKey n
            let ?local = if (Len n.path) == 1: env.names[nkey] else: nil
            match ?local:
                ? b: VlOwned (XApply (LoRef (LoName lx, env, n, callee.span)), (Each args, \|a| LoArg lx, env, a.value)), t
                nil:
                    let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
                    match ?qk:
                        ? qk: LoGlobalCall lx, env, qk, args, span, t
                        nil: VlOwned (LoTodo "a call of {nkey}, which nothing declares"), t
        EGroup x: LoCall lx, env, x, args, span
        otherwise: VlOwned (XApply (LoRef (LoX lx, env, callee)), (Each args, \|a| LoArg lx, env, a.value)), t

# An argument as a parameter takes it: borrowed, a lambda as a borrowed closure.
LoArg: unbounded fn Lx, LoEnv, Expr -> Ex
fn LoArg lx, env, e = match env.spans[LoKey lx, e.span]:
    ? v: LoRef v
    nil: LoArgKind lx, env, e

LoArgKind: unbounded fn Lx, LoEnv, Expr -> Ex
fn LoArgKind lx, env, e = match e.kind:
    ELambda ?ps, body: XUnary "&", (LoLambdaArg lx, env, (Or ?ps, [[]]), body)
    EGroup x: LoArg lx, env, x
    EName n:
        let t = LoTyOf lx, e.span
        match LoPeel t:
            TyFn ignore, ignore, ignore:
                let ?local = if (Len n.path) == 1: env.names[SNameKey n] else: nil
                match ?local:
                    ? ignore: LoRef (LoX lx, env, e)
                    nil:
                        let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
                        match ?qk:
                            ? qk: if HasKey lx.g.ctors, qk: LoRef (LoX lx, env, e) else: XUnary "&", (XRaw (LoValuePath lx, qk))
                            nil: LoRef (LoX lx, env, e)
            otherwise: LoRef (LoX lx, env, e)
    otherwise: LoRef (LoX lx, env, e)

# A call of a global: a constructor, a trait method, a prelude function, a program's own.
LoGlobalCall: unbounded fn Lx, LoEnv, Text, [Arg], Range, RsTy -> Vl
fn LoGlobalCall lx, env, qk, args, span, t:
    match lx.g.ctors[qk]:
        ? c: LoCtorApp lx, env, c, args, span
        nil: match lx.g.vals[qk]:
            ? v:
                if v.sort == "method": LoMethodCall lx, env, v, args, span, t
                else: if v.home == "Prelude": LoPreludeCall lx, env, qk, args, span, t
                else: VlOwned (XCall (LoValuePath lx, qk), (LoArgsFor lx, env, v, args)), t
            nil: VlOwned (LoTodo "a call of {qk}"), t

# A function's arguments, borrowed; a bare `Error(..)` where the parameter is a `~T` is
# that `~T`'s failure (the checker's pick ER lets it wait for its type).
LoArgsFor: unbounded fn Lx, LoEnv, ValInfo, [Arg] -> [Ex]
fn LoArgsFor lx, env, v, args:
    let ps = match v.scheme.ty:
        TyFn ignore, xs, ignore: xs
        otherwise: [[]]
    Each (Range0 (Len args)), \|i|
        let a = Or args[i], (Arg(name=nil, value=dummyExpr, span=Range(start=0, end=0)))
        let isTry = match LoPeel (Or ps[i], TyErr):
            TySig "~", ignore: True
            otherwise: False
        let isError = match LoPeel (LoTyOf lx, a.value.span):
            TyCon "Prelude.Error", ignore: True
            otherwise: False
        if isTry and isError: XUnary "&", (XCtor "Err", [[LoOwn (LoX lx, env, a.value)]]) else: LoArg lx, env, a.value

let dummyExpr = Expr(kind=EError, span=Range(start=0, end=0))

# A constructor applied (docs/backend.md: a record is a struct, a choice an enum with
# recursive payloads behind `Rc`, a newtype a tuple struct, a unit type a unit struct).
LoCtorApp: unbounded fn Lx, LoEnv, CtorInfo, [Arg], Range -> Vl
fn LoCtorApp lx, env, c, args, span:
    let t = LoTy lx, (LoPeel (LoTyOf lx, span))
    let owner = Or lx.g.types[c.owner], dummyTyInfo
    let tyPath = LoPathIn lx, owner.home, (LoCamel (BareName c.owner))
    let vals = LoCtorArgs lx, env, c, args
    if c.owner == "Bool": VlOwned (XRaw (if c.name == "True": "true" else: "false")), RsBool
    else: if c.owner == "Prelude.Error":
        let kind = Or vals[0], (XRaw "\"\"")
        let msg = Or vals[1], (XText "")
        let made = XCall "Error::new", [[kind, msg]]
        match t:
            RsRes ignore: VlOwned (XCtor "Err", [[made]]), t
            otherwise: VlOwned made, RsError
    else: match owner.body:
        BRecord fs:
            if (Len c.fields) == 0: VlOwned (XRaw tyPath), t
            else: VlOwned (XRecord tyPath, (Each (Range0 (Len c.fields)), \|i| (((LoSnake (Or c.fields[i], "")), (Or vals[i], (XRaw "Default::default()")))))), t
        BChoice cases:
            let isUnitType = (Len cases) == 1 and (Len c.args) == 0 and IsLowerText (BareName c.name)
            let path = if isUnitType: tyPath else: "{tyPath}::{LoCamel (BareName c.name)}"
            if (Len c.args) == 0: VlOwned (XRaw path), t
            else: VlOwned (XCtor path, vals), t
        otherwise: VlOwned (LoTodo "a constructor of {c.owner}"), t

LoArgNamed: fn Arg -> Bool
fn LoArgNamed a = match a.?name:
    ? ignore: True
    nil: False

# A constructor's arguments, by position or by field name, owned, an `Rc` where the
# field is recursive.
LoCtorArgs: unbounded fn Lx, LoEnv, CtorInfo, [Arg] -> [Ex]
fn LoCtorArgs lx, env, c, args:
    let named = Fold args, False, \|f, a| f or LoArgNamed a
    let ordered = if named: Each c.fields, \|f| Fold args, nil, \|?found, a| match a.?name:
        ? n: if n.name == f: ? a.value else: ?found
        nil: ?found
    else: Each args, \|a| ? a.value
    Each (Range0 (Len ordered)), \|i| match ordered[i]:
        ? (? x):
            let v = LoOwn (LoX lx, env, x)
            if c.owner == "Prelude.Error" and i == 0: v
            else: if LoRcField lx, c.name, i: XCall "Rc::new", [[v]] else: v
        otherwise: XRaw "Default::default()"

# A trait method applied: the operator a builtin, derived or written impl answers (an
# `impl ^Eq` is emitted as Rust's `PartialEq`, so `==` reaches it), or the method of a
# program's own trait.
LoMethodCall: unbounded fn Lx, LoEnv, ValInfo, [Arg], Range, RsTy -> Vl
fn LoMethodCall lx, env, v, args, span, t:
    let cls = Or (Each v.scheme.bounds, \|((ignore, c))| c)[0], ""
    let m = BareName v.qk
    let vals = Each args, \|a| LoX lx, env, a.value
    if (Take cls, 8) == "Prelude.": LoPreludeMethod lx, cls, m, vals, span, t
    else:
        let tr = Or lx.g.traits[cls], dummyTraitInfo
        let path = LoPathIn lx, tr.home, "{LoCamel (BareName cls)}::{LoSnake m}"
        VlOwned (XCall path, (Each args, \|a| LoArg lx, env, a.value)), t

let dummyTraitInfo = TraitInfo(name="", home="", param="a", supers=[[]], methods=[[]], defaults=[[]], assocs=[[]], file=0, span=Range(start=0, end=0))

LoPreludeMethod: unbounded fn Lx, Text, Text, [Vl], Range, RsTy -> Vl
fn LoPreludeMethod lx, cls, m, vals, span, t:
    let a = Or vals[0], (VlOwned (XRaw "()"), RsUnit)
    let b = Or vals[1], (VlOwned (XRaw "()"), RsUnit)
    if m == "Show": VlOwned (XCall "show_text", [[LoRef a]]), RsText
    else: if m == "Compare": VlOwned (XCall "compare", [[LoRef a, LoRef b]]), t
    else: if m == "Children": VlOwned (XCall "children", [[LoRef a]]), t
    else: LoOp lx, m, a, b, span, t

# A binary operator.
LoBinary: unbounded fn Lx, LoEnv, Text, Expr, Expr, Range -> Vl
fn LoBinary lx, env, op, l, r, span:
    let t = LoTy lx, (LoPeel (LoTyOf lx, span))
    if op == "and": VlOwned (XBin "&&", (LoBool (LoX lx, env, l)), (LoBool (LoX lx, env, r))), RsBool
    else: if op == "or": VlOwned (XBin "||", (LoBool (LoX lx, env, l)), (LoBool (LoX lx, env, r))), RsBool
    else: LoOp lx, op, (LoX lx, env, l), (LoX lx, env, r), span, t

# An operator over two values of the left one's type (Type System ch. 3: `^Eq`, `^Ord`,
# `^Num` on the built-in numbers; `/` gives `?a` on the integers, doubt QD).
LoOp: fn Lx, Text, Vl, Vl, Range, RsTy -> Vl
fn LoOp lx, op, a, b, span, t:
    let at = LoVlTy a
    let generic = match at:
        RsGen ignore: True
        otherwise: False
    if HasText [["==", "!=", "<", "<=", ">", ">="]], op: VlOwned (XBin op, (LoRef a), (LoRef b)), RsBool
    else: if op == "mod": VlOwned (XMethod (LoRef a), "modulo", [[LoRef b]]), t
    else: if generic: VlOwned (XCall "Num::{LoNumMethod op}", [[LoRef a, LoRef b]]), t
    else: if op == "/":
        if at == RsFloat: VlOwned (XBin "/", (LoCopy a), (LoCopy b)), t
        else: VlOwned (XMethod (LoRef a), "div", [[LoRef b]]), t
    else: if op == "-?":
        if at == RsNat: VlOwned (XMethod (LoRef a), "checked_sub", [[LoRef b]]), t
        else: VlOwned (XCtor "Some", [[(XBin "-", (LoRef a), (LoRef b))]]), t
    else: if op == "+?": VlOwned (XCtor "Some", [[(XBin "+", (LoRef a), (LoRef b))]]), t
    else: if op == "*?": VlOwned (XCtor "Some", [[(XBin "*", (LoRef a), (LoRef b))]]), t
    else: if LoIsCopy at: VlOwned (XBin op, (LoCopy a), (LoCopy b)), t
    else: VlOwned (XBin op, (LoRef a), (LoRef b)), t

LoNumMethod: fn Text -> Text
fn LoNumMethod "+" = "add"
fn LoNumMethod "-" = "sub"
fn LoNumMethod "*" = "mul"
fn LoNumMethod "/" = "div_opt"
fn LoNumMethod "+?" = "add_opt"
fn LoNumMethod "-?" = "sub_opt"
fn LoNumMethod "*?" = "mul_opt"
fn LoNumMethod other = "add"

# A prelude function (prelude.prism; its Rust is templates/prelude.prism): borrowed
# arguments, the variant for a text or a map where one name serves several (doubt LZ).
LoPreludeCall: unbounded fn Lx, LoEnv, Text, [Arg], Range, RsTy -> Vl
fn LoPreludeCall lx, env, qk, args, span, t:
    let name = Or lx.rsNames[qk], (LoSnake (BareName qk))
    let first = match args[0]:
        ? a: LoTy lx, (LoPeel (LoTyOf lx, a.value.span))
        nil: RsUnit
    let variant = LoPreludeVariant name, first
    VlOwned (XCall variant, (Each args, \|a| LoArg lx, env, a.value)), t

LoPreludeVariant: fn Text, RsTy -> Text
fn LoPreludeVariant name, first = match first:
    RsText: if HasText [["len", "take", "drop"]], name: "{name}_text" else: name
    RsMap ignore, ignore: if HasText [["len", "fold", "each", "filter"]], name: "{name}_map" else: name
    otherwise: name

# `r.field`: a place when `r` is one (Type System ch. 1, "Sigils on fields": `r.?f` reads
# the same field).
LoFieldOf: unbounded fn Lx, LoEnv, Expr, Text -> Vl
fn LoFieldOf lx, env, r, name:
    let rv = LoX lx, env, r
    let rty = LoPeel (LoTyOf lx, r.span)
    let ((ft, rc)) = LoFieldInfo lx, rty, name
    let f = LoSnake name
    let mode = if rc: "rcown" else: "own"
    match rv:
        VlPlace x, ignore, ignore: VlPlace (XField x, f), mode, ft
        VlOwned x, ignore: VlPlace (XField x, f), mode, ft

# A record field's Rust type and whether it is behind an `Rc`.
LoFieldInfo: unbounded fn Lx, Ty, Text -> ((RsTy, Bool))
fn LoFieldInfo lx, rty, name = match rty:
    TyCon n, args: match lx.g.ctors[n]:
        ? c:
            let ?fix = Fold (Range0 (Len c.fields)), nil, \|?found, i| if (Or c.fields[i], "") == name: ? i else: ?found
            match ?fix:
                ? i:
                    let ft = Or c.args[i], TyErr
                    let inst = LoInstantiate ft, c.params, args
                    (((LoTy lx, inst), (LoRcField lx, c.name, i)))
                nil: (((RsUnknown "a field {name}"), False))
        nil: (((RsUnknown "a field {name}"), False))
    otherwise: (((RsUnknown "a field {name} of a non-record"), False))

# A field's declared type with the record's parameters replaced by its arguments.
LoInstantiate: unbounded fn Ty, [Text], [Ty] -> Ty
fn LoInstantiate t, params, args = match t:
    TyQ q:
        let ?hit = Fold (Range0 (Len params)), nil, \|?found, i| if (Or params[i], "") == q: args[i] else: ?found
        Or ?hit, t
    TyCon n, xs: TyCon n, (Each xs, \|x| LoInstantiate x, params, args)
    TyFn c, ps, res: TyFn c, (Each ps, \|x| LoInstantiate x, params, args), (LoInstantiate res, params, args)
    TyTuple ts: TyTuple (Each ts, \|x| LoInstantiate x, params, args)
    TyArray e: TyArray (LoInstantiate e, params, args)
    TyMap k, v: TyMap (LoInstantiate k, params, args), (LoInstantiate v, params, args)
    TySig s, i: TySig s, (LoInstantiate i, params, args)
    otherwise: t

# `xs[i]`: an optional, of an array, a map or a text.
LoIndex: unbounded fn Lx, LoEnv, Expr, Expr, RsTy -> Vl
fn LoIndex lx, env, r, i, t:
    let rt = LoTy lx, (LoPeel (LoTyOf lx, r.span))
    let f = match rt:
        RsMap ignore, ignore: "get"
        RsText: "index_text"
        otherwise: "index"
    VlOwned (XCall f, [[(LoArg lx, env, r), (LoArg lx, env, i)]]), (RsOpt t)

# The names an expression or block reads, for a closure's captures.
LoReadNames: unbounded fn [Expr] -> [Text]
fn LoReadNames es = Fold es, [[]], \|acc, x| match x.kind:
    EName n: if (Len n.path) == 1: AddText acc, (SNameKey n) else: acc
    otherwise: acc

LoBodyExprs: unbounded fn LambdaBody -> [Expr]
fn LoBodyExprs (LbExpr x) = ExprsIn x
fn LoBodyExprs (LbBlock b) = BlockExprs b

# A lambda as a value: `Rc::new(move |..| ..)`, its captures cloned in first
# (docs/backend.md, "`fn a -> b` as a value").
LoLambdaRc: unbounded fn Lx, LoEnv, Expr, [Pattern], LambdaBody -> Vl
fn LoLambdaRc lx, env, e, ps, body:
    let ft = LoTy lx, (LoPeel (LoTyOf lx, e.span))
    let pts = match ft:
        RsFn xs, ignore: xs
        otherwise: [[]]
    let caps = Filter (LoReadNames (LoBodyExprs body)), \|n| match env.names[n]:
        ? (BnLocal ignore, ignore, ignore): True
        otherwise: False
    let ((dos, env1)) = Fold caps, (([[]], env)), \|((acc, en)), n| match env.names[n]:
        ? (BnLocal rs, mode, ct):
            let d = DoLet (PaBind rs), (LoOwn (LoLocal rs, mode, ct))
            (((Push acc, d), (LoBind en, n, (BnLocal rs, "own", ct))))
        otherwise: ((acc, en))
    let ((pas, env2)) = LoParams lx, env1, ps, pts, True
    let v = LoLambdaBody lx, env2, body
    VlOwned (XBlock dos, (XCall "Rc::new", [[(XClosure True, pas, (LoOwn v))]])), ft

# A lambda passed to a parameter: a borrowed closure, its types from the parameter.
LoLambdaArg: unbounded fn Lx, LoEnv, [Pattern], LambdaBody -> Ex
fn LoLambdaArg lx, env, ps, body:
    let ((pas, env2)) = LoParams lx, env, ps, [[]], False
    let v = LoLambdaBody lx, env2, body
    XClosure False, pas, (LoOwn v)

LoLambdaBody: unbounded fn Lx, LoEnv, LambdaBody -> Vl
fn LoLambdaBody lx, env, (LbExpr x) = LoX lx, env, x
fn LoLambdaBody lx, env, (LbBlock b) = LoBlock lx, env, b

# Closure parameters: irrefutable patterns, each a reference; typed when the closure is
# a value.
LoParams: unbounded fn Lx, LoEnv, [Pattern], [RsTy], Bool -> (([Pa], LoEnv))
fn LoParams lx, env, ps, pts, typed = Fold (Range0 (Len ps)), (([[]], env)), \|((acc, en)), i| match ps[i]:
    ? p:
        let po = LoPat lx, p, (LoBinderTyOfPattern lx, p), "ref", "a{p.span.start}"
        let en2 = LoBindAll en, po.binds
        let pa = if typed: PaTyped po.pa, (RsRef (Or pts[i], (RsUnknown "a parameter"))) else: po.pa
        (((Push acc, pa), en2))
    nil: ((acc, en))

LoBindAll: fn LoEnv, [((Text, Bn))] -> LoEnv
fn LoBindAll env, bs = Fold bs, env, \|en, ((n, b))| LoBind en, n, b

# A pattern's type, as the checker recorded it for its binder or the pattern.
LoBinderTyOfPattern: fn Lx, Pattern -> Ty
fn LoBinderTyOfPattern lx, p = match p.kind:
    PName n: LoBinderTy lx, n.span
    otherwise: LoTyOf lx, p.span

# `if c: a else: b`, and `if p <- e: ..` as a `match`.
LoIf: unbounded fn Lx, LoEnv, Cond, Block, ?Block, RsTy -> Vl
fn LoIf lx, env, c, thenB, ?elseB, t:
    let elseV = match ?elseB:
        ? b: LoOwn (LoBlock lx, env, b)
        nil: XRaw "()"
    match c:
        CondExpr x: VlOwned (XIf (LoBool (LoX lx, env, x)), (LoOwn (LoBlock lx, env, thenB)), elseV), t
        CondBind p, x, ?g:
            let sv = LoX lx, env, x
            let po = LoPat lx, p, (LoTyOf lx, x.span), "ref", "c{x.span.start}"
            let env2 = LoBindAll env, po.binds
            let guard = match ?g:
                ? ge: [[CcIf (LoBool (LoX lx, env2, ge))]]
                nil: [[]]
            let arm = XArm(pat=po.pa, conds=(Append po.conds, guard), body=(LoOwn (LoBlock lx, env2, thenB)))
            let other = XArm(pat=PaWild, conds=[[]], body=elseV)
            LoArmsValue (LoRef sv), [[arm, other]], "c{x.span.start}", t

# A `match` or an if-let chain over arms: `match` when every condition is a guard, the
# chain when one goes through an `Rc` (a Rust pattern cannot).
LoArmsValue: fn Ex, [XArm], Text, RsTy -> Vl
fn LoArmsValue scrut, arms, label, t:
    let chain = Fold arms, False, \|f, a| f or Fold a.conds, False, \|f2, c| f2 or LoIsLetCond c
    let guarded = Fold arms, False, \|f, a| f or (Len a.conds) > 0
    if chain: VlOwned (XChain label, scrut, arms), t
    else: VlOwned (XMatch scrut, arms, guarded), t

LoIsLetCond: fn Cc -> Bool
fn LoIsLetCond (CcLet ignore, ignore) = True
fn LoIsLetCond (CcIf ignore) = False

# `match s: arms` (a plain `match`; widget blocks lower theirs in the block's node).
LoMatch: unbounded fn Lx, LoEnv, Expr, [Arm], RsTy, Range -> Vl
fn LoMatch lx, env, s, arms, t, span:
    let sv = LoX lx, env, s
    let sty = LoTyOf lx, s.span
    let label = "m{span.start}"
    let byRef = Each (Range0 (Len arms)), \|i| LoArmPat lx, (Or arms[i], dummyArm).?pattern, sty, "ref", "{label}_{i}"
    let chain = Fold byRef, False, \|f, po| f or Fold po.conds, False, \|f2, c| f2 or LoIsLetCond c
    let owned = match sv:
        VlOwned ignore, ignore: not chain
        otherwise: False
    let pats = if owned: Each (Range0 (Len arms)), \|i| LoArmPat lx, (Or arms[i], dummyArm).?pattern, sty, "own", "{label}_{i}" else: byRef
    let xarms = Each (Range0 (Len arms)), \|i|
        let arm = Or arms[i], dummyArm
        let po = Or pats[i], (PatOut(pa=PaWild, conds=[[]], binds=[[]]))
        let env2 = LoBindAll env, po.binds
        let guard = match arm.?guard:
            ? ge: [[CcIf (LoBool (LoX lx, env2, ge))]]
            nil: [[]]
        XArm(pat=po.pa, conds=(Append po.conds, guard), body=(LoOwn (LoBlock lx, env2, arm.body)))
    let scrut = if owned: LoOwn sv else: LoRef sv
    LoArmsValue scrut, xarms, label, t

let dummyArm = Arm(pattern=nil, guard=nil, body=Block(stmts=[[]], inline=True, span=Range(start=0, end=0)), span=Range(start=0, end=0))

LoArmPat: unbounded fn Lx, ?Pattern, Ty, Text, Text -> PatOut
fn LoArmPat lx, (? p), ty, mode, fresh = LoPat lx, p, ty, mode, fresh
fn LoArmPat lx, nil, ty, mode, fresh = PatOut(pa=PaWild, conds=[[]], binds=[[]])

# A block of `let`s and a last expression, in page order (gap DG of the README: the
# group's dependency order is the checker's to give).
LoBlock: unbounded fn Lx, LoEnv, Block -> Vl
fn LoBlock lx, env, b = if LoGivenish b.stmts: LoGiven lx, env, b, (LoBlockTy lx, b), b.span else: LoPlainBlock lx, env, b

# A block of binds and guards is a `given:` (Semantics ch. 4), whether or not the word is
# written: a function's body may be one.
LoGivenish: fn [Stmt] -> Bool
fn LoGivenish stmts = Fold stmts, False, \|f, s| f or LoIsGuardish s

LoIsGuardish: fn Stmt -> Bool
fn LoIsGuardish s = match s.kind:
    SBind ignore, ignore, nil: True
    SRequire ignore: True
    SForbid ignore: True
    otherwise: False

LoBlockTy: unbounded fn Lx, Block -> RsTy
fn LoBlockTy lx, b = match (Or b.stmts[Dec (Len b.stmts)], dummyStmtL).kind:
    SExpr x: LoTy lx, (LoPeel (LoTyOf lx, x.span))
    otherwise: RsUnit

LoPlainBlock: unbounded fn Lx, LoEnv, Block -> Vl
fn LoPlainBlock lx, env, b:
    let n = Len b.stmts
    let ((dos, env2, ?last)) = Fold (Range0 n), (([[]], env, nil)), \|((acc, en, ?lv)), i|
        let s = Or b.stmts[i], dummyStmtL
        if i + 1 == n: match s.kind:
            SExpr x: ((acc, en, ? (LoX lx, en, x)))
            otherwise:
                let ((more, en2)) = LoStmt lx, en, s
                (((Append acc, more), en2, nil))
        else:
            let ((more, en2)) = LoStmt lx, en, s
            (((Append acc, more), en2, ?lv))
    let last = Or ?last, (VlOwned (XRaw "()"), RsUnit)
    if (Len dos) == 0: last
    else: VlOwned (XBlock dos, (LoOwn last)), (LoVlTy last)

let dummyStmtL = Stmt(kind=(SExpr (Expr(kind=EError, span=Range(start=0, end=0)))), span=Range(start=0, end=0))

# One statement of an expression block.
LoStmt: unbounded fn Lx, LoEnv, Stmt -> (([Do], LoEnv))
fn LoStmt lx, env, s = match s.kind:
    SLet p, ignore, x:
        let v = LoX lx, env, x
        let po = LoPat lx, p, (LoTyOf lx, x.span), "own", "l{s.span.start}"
        (([[(DoLet po.pa, (LoOwn v))]], (LoBindAll env, po.binds)))
    SExpr x: (([[DoExpr (LoOwn (LoX lx, env, x))]], env))
    SSignature ignore: (([[]], env))
    SFn f: (([[DoNote "a local function {DefNameText f.name}: not lowered yet"]], env))
    otherwise: (([[DoNote "a statement this back end does not lower yet"]], env))

# ---------------------------------------------------------------------------------------
# Patterns: a Rust pattern, the conditions after it, and the names it binds
# ---------------------------------------------------------------------------------------

type PatOut = record:
    pa: Pa
    conds: [Cc]
    binds: [((Text, Bn))]

LoPatOut: fn Pa -> PatOut
fn LoPatOut pa = PatOut(pa=pa, conds=[[]], binds=[[]])

# A pattern against a scrutinee of checker type `ty`, matched by reference (`ref`: its
# binders are references) or by value (`own`). `fresh` names the binders a condition
# needs.
LoPat: unbounded fn Lx, Pattern, Ty, Text, Text -> PatOut
fn LoPat lx, p, ty, mode, fresh = match p.kind:
    PName n:
        let nkey = SNameKey n
        let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
        let isCtor = match ?qk:
            ? qk: (HasKey lx.g.ctors, qk) and ((IsUpperText (LoBase nkey)) or (Len n.path) > 1 or LoIsUnitCtor lx, qk)
            nil: False
        if isCtor: LoCtorPat lx, n, [[]], ty, mode, fresh
        else:
            let rs = LoSnake nkey
            let bt = LoTy lx, (LoPeel (LoBinderTy lx, n.span))
            PatOut(pa=(PaBind rs), conds=[[]], binds=[[((nkey, (BnLocal rs, mode, bt)))]])
    PIgnore: LoPatOut PaWild
    PUnit: LoPatOut PaWild
    PNil: LoPatOut (PaUnit "None")
    PLit l: LoLitPat lx, l, ty, mode, fresh, False
    PNeg l: LoLitPat lx, l, ty, mode, fresh, True
    PSigil "?", q: LoWrapPat lx, "Some", q, (LoInner ty), mode, fresh
    PSigil "~", q: LoWrapPat lx, "Ok", q, (LoInner ty), mode, fresh
    PSigil ignore, q: LoPat lx, q, ty, mode, fresh
    PGroup q: LoPat lx, q, ty, mode, fresh
    PCtor n, ps: LoCtorPat lx, n, ps, ty, mode, fresh
    PRecord n, fps, rest: LoRecordPat lx, n, fps, rest, ty, mode, fresh
    PTuple ps:
        let ts = match LoPeel ty:
            TyTuple xs: xs
            otherwise: [[]]
        let subs = Each (Range0 (Len ps)), \|i| LoPat lx, (Or ps[i], dummyPat), (Or ts[i], TyErr), mode, "{fresh}_{i}"
        PatOut(pa=(PaTuple (Each subs, \|o| o.pa)), conds=(Fold subs, [[]], \|acc, o| Append acc, o.conds), binds=(Fold subs, [[]], \|acc, o| Append acc, o.binds))
    PArray ps: LoArrayPat lx, ps, ty, mode, fresh
    otherwise: PatOut(pa=PaWild, conds=[[CcIf (LoTodo "a pattern this back end does not lower yet")]], binds=[[]])

let dummyPat = Pattern(kind=PIgnore, span=Range(start=0, end=0))

LoInner: fn Ty -> Ty
fn LoInner t = match LoPeel t:
    TySig "?", i: i
    TySig "~", i: i
    otherwise: TyErr

# Whether a constructor is a unit type's value (`click`), which a lowercase name may name.
LoIsUnitCtor: fn Lx, Text -> Bool
fn LoIsUnitCtor lx, qk = match lx.g.ctors[qk]:
    ? c: match (Or lx.g.types[c.owner], dummyTyInfo).body:
        BChoice [[((ignore, [[]]))]]: IsLowerText (BareName qk)
        otherwise: False
    nil: False

LoWrapPat: unbounded fn Lx, Text, Pattern, Ty, Text, Text -> PatOut
fn LoWrapPat lx, ctor, q, inner, mode, fresh:
    let o = LoPat lx, q, inner, mode, fresh
    update o:
        &_.pa <= PaCtor ctor, [[&_.pa]]

# A literal: a fresh binder and an equality after it (a number or a text is no Rust
# literal pattern).
LoLitPat: unbounded fn Lx, Literal, Ty, Text, Text, Bool -> PatOut
fn LoLitPat lx, l, ty, mode, fresh, neg:
    let t = LoTy lx, (LoPeel ty)
    match l.kind:
        LChar c: LoPatOut (PaLit "'{LoEscapeChar c}'")
        otherwise:
            let lit = LoLit lx, emptyEnv, l, l.span, neg
            let lv = VlOwned (LoOwn lit), t
            let b = LoLocal fresh, mode, t
            PatOut(pa=(PaBind fresh), conds=[[CcIf (XBin "==", (LoRef b), (LoRef lv))]], binds=[[]])

# `Ctor p, q`: a choice's case, a newtype, a unit type's value, `True`, a record by
# position. A payload behind an `Rc` matches through a `let` after the pattern.
LoCtorPat: unbounded fn Lx, SName, [Pattern], Ty, Text, Text -> PatOut
fn LoCtorPat lx, n, ps, ty, mode, fresh:
    let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
    match ?qk:
        ? "True": LoPatOut (PaLit "true")
        ? "False": LoPatOut (PaLit "false")
        ? qk: match lx.g.ctors[qk]:
            ? c:
                let owner = Or lx.g.types[c.owner], dummyTyInfo
                let tyPath = LoPathIn lx, owner.home, (LoCamel (BareName c.owner))
                let args = match LoPeel ty:
                    TyCon ignore, xs: xs
                    otherwise: [[]]
                let subs = Each (Range0 (Len ps)), \|i| LoSubPat lx, c, i, (Or ps[i], dummyPat), (LoInstantiate (Or c.args[i], TyErr), c.params, args), mode, "{fresh}_{i}"
                let conds = Fold subs, [[]], \|acc, o| Append acc, o.conds
                let binds = Fold subs, [[]], \|acc, o| Append acc, o.binds
                let pas = Each subs, \|o| o.pa
                match owner.body:
                    BRecord fs: PatOut(pa=(PaRecord tyPath, (Each (Range0 (Len pas)), \|i| (((LoSnake (Or c.fields[i], "")), (Or pas[i], PaWild)))), ((Len pas) < (Len c.fields))), conds=conds, binds=binds)
                    otherwise:
                        let isUnitType = (Len c.args) == 0 and LoIsUnitCtor lx, qk
                        let path = if isUnitType: tyPath else: "{tyPath}::{LoCamel (BareName c.name)}"
                        if (Len c.args) == 0: PatOut(pa=(PaUnit path), conds=[[]], binds=[[]])
                        else: PatOut(pa=(PaCtor path, pas), conds=conds, binds=binds)
            nil: PatOut(pa=PaWild, conds=[[CcIf (LoTodo "a pattern of {qk}")]], binds=[[]])
        nil: PatOut(pa=PaWild, conds=[[CcIf (LoTodo "a pattern of an unknown constructor")]], binds=[[]])

# A constructor's field `i` in a pattern: through an `Rc`, a binder holds the `Rc` and a
# nested pattern matches behind it in a `let`.
LoSubPat: unbounded fn Lx, CtorInfo, Nat, Pattern, Ty, Text, Text -> PatOut
fn LoSubPat lx, c, i, p, ty, mode, fresh:
    if not (LoRcField lx, c.name, i): LoPat lx, p, ty, mode, fresh
    else:
        let rcMode = if mode == "own": "rcown" else: "rc"
        match p.kind:
            PIgnore: LoPatOut PaWild
            PName n:
                let o = LoPat lx, p, ty, rcMode, fresh
                match o.pa:
                    PaBind ignore: o
                    otherwise: LoBehindRc lx, p, ty, rcMode, fresh
            otherwise: LoBehindRc lx, p, ty, rcMode, fresh

LoBehindRc: unbounded fn Lx, Pattern, Ty, Text, Text -> PatOut
fn LoBehindRc lx, p, ty, rcMode, fresh:
    let inner = LoPat lx, p, ty, "ref", "{fresh}_r"
    let place = LoRef (LoLocal fresh, rcMode, (RsUnknown "a payload"))
    PatOut(pa=(PaBind fresh), conds=(Append [[(CcLet inner.pa, place)]], inner.conds), binds=inner.binds)

# `Rec(f=p, ..)` (a record) or `Error(kind=K, ..)` (the prelude's error, matched in `~T`
# as `Err`).
LoRecordPat: unbounded fn Lx, SName, [FieldPat], Bool, Ty, Text, Text -> PatOut
fn LoRecordPat lx, n, fps, rest, ty, mode, fresh:
    let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
    let qk = Or ?qk, ""
    if qk == "Prelude.Error": LoErrorPat lx, fps, ty, mode, fresh
    else: match lx.g.ctors[qk]:
        ? c:
            let owner = Or lx.g.types[c.owner], dummyTyInfo
            let tyPath = LoPathIn lx, owner.home, (LoCamel (BareName c.owner))
            let args = match LoPeel ty:
                TyCon ignore, xs: xs
                otherwise: [[]]
            let subs = Each (Range0 (Len fps)), \|i|
                let fp = Or fps[i], dummyFieldPat
                let fname = match fp.?name:
                    ? id: id.name
                    nil: Or c.fields[i], ""
                let fix = Fold (Range0 (Len c.fields)), i, \|found, j| if (Or c.fields[j], "") == fname: j else: found
                ((LoSnake fname, (LoSubPat lx, c, fix, fp.pattern, (LoInstantiate (Or c.args[fix], TyErr), c.params, args), mode, "{fresh}_{i}")))
            let conds = Fold subs, [[]], \|acc, ((ignore, o))| Append acc, o.conds
            let binds = Fold subs, [[]], \|acc, ((ignore, o))| Append acc, o.binds
            PatOut(pa=(PaRecord tyPath, (Each subs, \|((f, o))| ((f, o.pa))), (rest or (Len subs) < (Len c.fields))), conds=conds, binds=binds)
        nil: PatOut(pa=PaWild, conds=[[CcIf (LoTodo "an element pattern")]], binds=[[]])

let dummyFieldPat = FieldPat(name=nil, pattern=dummyPat, span=Range(start=0, end=0))

# `Error(kind=Fs.NotFound, message=m)`: `Err(e)` and the kind compared after it.
LoErrorPat: unbounded fn Lx, [FieldPat], Ty, Text, Text -> PatOut
fn LoErrorPat lx, fps, ty, mode, fresh:
    let e = LoLocal fresh, mode, RsError
    let parts = Each fps, \|fp|
        let fname = match fp.?name:
            ? id: id.name
            nil: ""
        if fname == "kind": match fp.pattern.kind:
            PName k:
                let ((?kq, ignore)) = ResolveValue lx.g, lx.home, k
                match ?kq:
                    ? kq: if HasKey lx.g.tags, kq: ((([[CcIf (XBin "==", (XRaw "&*{fresh}.kind"), (XRaw "\"{kq}\""))]]), [[]])) else: (([[]], [[((SNameKey k, (BnLocal "{fresh}.kind", "own", RsText)))]]))
                    nil: (([[]], [[((SNameKey k, (BnLocal "{fresh}.kind", "own", RsText)))]]))
            otherwise: (([[]], [[]]))
        else: if fname == "message": match fp.pattern.kind:
            PName m: (([[]], [[((SNameKey m, (BnLocal "{fresh}.message", "own", RsText)))]]))
            otherwise: (([[]], [[]]))
        else: (([[]], [[]]))
    let wrapped = match LoPeel ty:
        TySig "~", ignore: PaCtor "Err", [[PaBind fresh]]
        otherwise: PaBind fresh
    PatOut(pa=wrapped, conds=(Fold parts, [[]], \|acc, ((cs, ignore))| Append acc, cs), binds=(Fold parts, [[]], \|acc, ((ignore, bs))| Append acc, bs))

# `[[a, b]]`: the length, then each element by index.
LoArrayPat: unbounded fn Lx, [Pattern], Ty, Text, Text -> PatOut
fn LoArrayPat lx, ps, ty, mode, fresh:
    let et = match LoPeel ty:
        TyArray x: x
        otherwise: TyErr
    let arr = LoLocal fresh, mode, (LoTy lx, (LoPeel ty))
    let lenCond = CcIf (XBin "==", (XMethod (LoRef arr), "len", [[]]), (XRaw "{Len ps}"))
    let subs = Each (Range0 (Len ps)), \|i| ((i, (LoPat lx, (Or ps[i], dummyPat), et, "own", "{fresh}_{i}")))
    let conds = Fold subs, [[lenCond]], \|acc, ((i, o))| Append (Push acc, (CcLet (PaCtor "Some", [[o.pa]]), (XCall "index", [[LoRef arr, XRaw "&Nat::from({i}u32)"]]))), o.conds
    let binds = Fold subs, [[]], \|acc, ((ignore, o))| Append acc, o.binds
    PatOut(pa=(PaBind fresh), conds=conds, binds=binds)

# ---------------------------------------------------------------------------------------
# Templates, `given:` and `update` blocks
# ---------------------------------------------------------------------------------------

# A code template in a plain function (Templates ch. 2, the function form): its text
# built run by run; a placeholder alone on its line indents its text's lines to its
# column (`place`, the prelude's).
LoTemplate: unbounded fn Lx, LoEnv, Template -> Vl
fn LoTemplate lx, env, tp:
    let start = [[(DoLet (PaBind "mut out"), (XRaw "String::new()"))]]
    let dos = Fold tp.parts, start, \|acc, part| Append acc, (LoTemplatePart lx, env, part)
    VlOwned (XBlock dos, (XCall "Text::from", [[XRaw "out"]])), RsText

LoTemplatePart: unbounded fn Lx, LoEnv, TemplatePart -> [Do]
fn LoTemplatePart lx, env, part = match part:
    TpText t: [[DoExpr (XMethod (XRaw "out"), "push_str", [[XRaw "\"{LoEscape t}\""]])]]
    TpPlaceholder x, ?col:
        let v = LoX lx, env, x
        let column = match ?col:
            ? c: XRaw "Some({c})"
            nil: XRaw "None"
        [[DoExpr (XCall "place", [[XRaw "&mut out", LoShownText v, column]])]]
    TpBlock b:
        let v = LoBlock lx, env, b
        if (LoVlTy v) == RsUnit: [[DoExpr (LoOwn v)]]
        else: [[DoExpr (XCall "place", [[XRaw "&mut out", LoShownText v, XRaw "None"]])]]
    TpCall n, args, ?parts, ignore:
        let plain = SName(sigils=(Drop n.sigils, 1), path=n.path, span=n.span)
        let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
        let ((?qk2, ignore)) = ResolveValue lx.g, lx.home, plain
        let callee = match ?qk:
            ? q: LoValuePath lx, q
            nil: match ?qk2:
                ? q: LoValuePath lx, q
                nil: LoSnake (SNameKey n)
        let body = match ?parts:
            ? ps:
                let inner = Fold ps, [[(DoLet (PaBind "mut out"), (XRaw "String::new()"))]], \|acc, p| Append acc, (LoTemplatePart lx, env, p)
                [[(XUnary "&", (XBlock inner, (XCall "Text::from", [[XRaw "out"]])))]]
            nil: [[]]
        let call = XCall callee, (Append (Each args, \|a| LoArg lx, env, a.value), body)
        [[DoExpr (XCall "place", [[XRaw "&mut out", (XUnary "&", call), XRaw "None"]])]]

# A value as a template or interpolation places it: a text as it is, any other value as
# it shows.
LoShownText: fn Vl -> Ex
fn LoShownText v = match LoVlTy v:
    RsText: LoRef v
    otherwise: XUnary "&", (XCall "show_text", [[LoRef v]])

# `given:` (Semantics ch. 4): `let`s, binds that fail on `nil` (or on an `Error`), the
# guards, and the answer last; a failed guard under `~` is `Prelude.Unmet` with the
# guard's source text (D11).
LoGiven: unbounded fn Lx, LoEnv, Block, RsTy, Range -> Vl
fn LoGiven lx, env, b, t, span:
    let label = "'g{span.start}"
    let isTry = match t:
        RsRes ignore: True
        otherwise: False
    let n = Len b.stmts
    let ((dos, env2, ?last)) = Fold (Range0 n), (([[]], env, nil)), \|((acc, en, ?lv)), i|
        let s = Or b.stmts[i], dummyStmtL
        let fail = if isTry: "Err(Error::new(\"Prelude.Unmet\", \"{LoEscape (LoSourceText lx, s.span)}\"))" else: "None"
        match s.kind:
            SBind p, x, nil:
                let v = LoX lx, en, x
                let po = LoPat lx, p, (LoInner (LoTyOf lx, x.span)), "own", "g{s.span.start}"
                (((Push acc, (LoGivenBind isTry, po.pa, (LoOwn v), label)), (LoBindAll en, po.binds), ?lv))
            SRequire c: (((Push acc, (DoIf (XUnary "!", (LoBool (LoX lx, en, c))), [[DoExpr (XRaw "break {label} {fail}")]], [[]])), en, ?lv))
            SForbid c: (((Push acc, (DoIf (LoBool (LoX lx, en, c)), [[DoExpr (XRaw "break {label} {fail}")]], [[]])), en, ?lv))
            SExpr x:
                if i + 1 == n: ((acc, en, ? (LoX lx, en, x)))
                else: (((Push acc, (DoExpr (LoOwn (LoX lx, en, x)))), en, ?lv))
            otherwise:
                let ((more, en2)) = LoStmt lx, en, s
                (((Append acc, more), en2, ?lv))
    let last = Or ?last, (VlOwned (XRaw "None"), t)
    VlOwned (XLabeled label, dos, (LoOwn last)), t

# A bind in `given:`: `let Some(p) = e else { break 'g None; }`, or under `~` the error
# passed on.
LoGivenBind: fn Bool, Pa, Ex, Text -> Do
fn LoGivenBind isTry, pa, x, label:
    if isTry: DoLet pa, (XMatch x, [[XArm(pat=(PaCtor "Ok", [[PaBind "v"]]), conds=[[]], body=(XRaw "v")), XArm(pat=(PaCtor "Err", [[PaBind "e"]]), conds=[[]], body=(XRaw "break {label} Err(e)"))]], False)
    else: DoLetElse (PaCtor "Some", [[pa]]), x, (XRaw "break {label} None")

# The source a range covers, in the file being lowered.
LoSourceText: fn Lx, Range -> Text
fn LoSourceText lx, r = match lx.g.srcs[lx.file]:
    ? src: SpanText src, r
    nil: ""

# `update x: ...` (Semantics ch. 5, `&` blocks): native mutation of a fresh copy, which
# `Rc::make_mut` and the persistent collections update in place when it is unique
# (Compiler ch. 3, "Unique values"). `&_` is `this`; a `let &i` is a `mut` local.
LoUpdate: unbounded fn Lx, LoEnv, Expr, Block, RsTy, Range -> Vl
fn LoUpdate lx, env, target, b, t, span:
    let tv = LoX lx, env, target
    let env1 = LoBind env, "&_", (BnLocal "this", "own", t)
    let ((dos, ignore)) = LoUpdStmts lx, env1, b.stmts
    VlOwned (XBlock (Append [[(DoLet (PaBind "mut this"), (LoOwn tv))]], dos), (XRaw "this")), t

LoUpdStmts: unbounded fn Lx, LoEnv, [Stmt] -> (([Do], LoEnv))
fn LoUpdStmts lx, env, stmts = Fold stmts, (([[]], env)), \|((acc, en)), s|
    let ((more, en2)) = LoUpdStmt lx, en, s
    (((Append acc, more), en2))

LoUpdStmt: unbounded fn Lx, LoEnv, Stmt -> (([Do], LoEnv))
fn LoUpdStmt lx, env, s = match s.kind:
    SSet target, value:
        let v = LoOwn (LoX lx, env, value)
        (([[(LoAssign lx, env, target, v)]], env))
    SAccum target, op, value:
        let cur = LoPlaceOf lx, env, target
        let tt = LoTy lx, (LoPeel (LoTyOf lx, target.span))
        let rv = LoX lx, env, value
        let bin = Take op, 1
        let next = LoOp lx, bin, (VlPlace cur, "own", tt), rv, s.span, tt
        (([[(LoAssign lx, env, target, (LoOwn next))]], env))
    SLet p, ignore, x:
        let v = LoOwn (LoX lx, env, x)
        match p.kind:
            PName n:
                if (Take n.sigils, 1) == "&":
                    let rs = LoSnake (SNameKey n)
                    let bt = LoTy lx, (LoPeel (LoTyOf lx, x.span))
                    (([[(DoLet (PaBind "mut {rs}"), v)]], (LoBind env, (SNameKey n), (BnLocal rs, "own", bt))))
                else: LoStmt lx, env, s
            otherwise: LoStmt lx, env, s
    SWhile c, body:
        let ((inner, ignore)) = LoUpdStmts lx, env, body.stmts
        match c:
            CondExpr x: (([[(DoWhile (LoBool (LoX lx, env, x)), inner)]], env))
            CondBind p, x, ignore:
                let po = LoPat lx, p, (LoTyOf lx, x.span), "own", "w{s.span.start}"
                let ((inner2, ignore)) = LoUpdStmts lx, (LoBindAll env, po.binds), body.stmts
                (([[(DoWhileLet po.pa, (LoOwn (LoX lx, env, x)), inner2)]], env))
    SExpr x: match x.kind:
        EIf c, thenB, ?elseB: (([[(LoUpdIf lx, env, c, thenB, ?elseB)]], env))
        EMatch scrut, arms: (([[(LoUpdMatch lx, env, scrut, arms)]], env))
        otherwise: (([[DoExpr (LoOwn (LoX lx, env, x))]], env))
    otherwise: LoStmt lx, env, s

LoUpdIf: unbounded fn Lx, LoEnv, Cond, Block, ?Block -> Do
fn LoUpdIf lx, env, c, thenB, ?elseB:
    let ((elseDos, ignore)) = match ?elseB:
        ? b: LoUpdStmts lx, env, b.stmts
        nil: (([[]], env))
    match c:
        CondExpr x:
            let ((thenDos, ignore)) = LoUpdStmts lx, env, thenB.stmts
            DoIf (LoBool (LoX lx, env, x)), thenDos, elseDos
        CondBind p, x, ignore:
            let po = LoPat lx, p, (LoTyOf lx, x.span), "own", "u{x.span.start}"
            let ((thenDos, ignore)) = LoUpdStmts lx, (LoBindAll env, po.binds), thenB.stmts
            DoIfLet po.pa, (LoOwn (LoX lx, env, x)), thenDos, elseDos

LoUpdMatch: unbounded fn Lx, LoEnv, Expr, [Arm] -> Do
fn LoUpdMatch lx, env, scrut, arms:
    let sv = LoX lx, env, scrut
    let sty = LoTyOf lx, scrut.span
    let cases = Each (Range0 (Len arms)), \|i|
        let arm = Or arms[i], dummyArm
        let po = LoArmPat lx, arm.?pattern, sty, "ref", "u{scrut.span.start}_{i}"
        let ((dos, ignore)) = LoUpdStmts lx, (LoBindAll env, po.binds), arm.body.stmts
        let guarded = Append po.conds, (LoGuardConds lx, (LoBindAll env, po.binds), arm.?guard)
        ((po.pa, (if (Len guarded) == 0: dos else: [[DoNote "a guarded arm: not lowered yet"]])))
    DoMatch (LoRef sv), cases

LoGuardConds: unbounded fn Lx, LoEnv, ?Expr -> [Cc]
fn LoGuardConds lx, env, (? ge) = [[CcIf (LoBool (LoX lx, env, ge))]]
fn LoGuardConds lx, env, nil = [[]]

# The place a reference path names: `&_.f.g`, `&i`, `&_[k].f`.
LoPlaceOf: unbounded fn Lx, LoEnv, Expr -> Ex
fn LoPlaceOf lx, env, e = match e.kind:
    EName n: match env.names[SNameKey n]:
        ? (BnLocal rs, ignore, ignore): XRaw rs
        otherwise: XRaw (LoSnake (SNameKey n))
    EField r, ignore, name: XField (LoPlaceOf lx, env, r), (LoSnake name.name)
    EIndex r, k:
        let rt = LoTy lx, (LoPeel (LoTyOf lx, r.span))
        let f = match rt:
            RsMap ignore, ignore: "at_mut_map"
            otherwise: "at_mut"
        XUnary "*", (XCall f, [[(XUnary "&mut ", (LoPlaceOf lx, env, r)), (LoArg lx, env, k)]])
    EGroup x: LoPlaceOf lx, env, x
    otherwise: LoTodo "a reference path this back end does not lower"

# `&p <= v`; on a map's key, an insertion.
LoAssign: unbounded fn Lx, LoEnv, Expr, Ex -> Do
fn LoAssign lx, env, target, v = match target.kind:
    EIndex r, k:
        let rt = LoTy lx, (LoPeel (LoTyOf lx, r.span))
        match rt:
            RsMap ignore, ignore: DoExpr (XMethod (LoPlaceOf lx, env, r), "insert", [[LoOwn (LoX lx, env, k), v]])
            otherwise: DoAssign (LoPlaceOf lx, env, target), v
    EGroup x: LoAssign lx, env, x, v
    otherwise: DoAssign (LoPlaceOf lx, env, target), v

# ---------------------------------------------------------------------------------------
# Functions (docs/backend.md: a plain function is a Rust `fn` taking references, its
# clauses one `match`; generics are Rust's, monomorphized by rustc, doubt MO)
# ---------------------------------------------------------------------------------------

# A trait bound as Rust's: `^Eq` is `PartialEq`, `^Ord` `PartialOrd` (a `Float` has no
# total order in Rust), `^Show` the printer's, `^Num` the prelude's.
LoBoundOf: fn Lx, Text -> [Text]
fn LoBoundOf lx, "Prelude.Eq" = [["PartialEq"]]
fn LoBoundOf lx, "Prelude.Ord" = [["PartialOrd"]]
fn LoBoundOf lx, "Prelude.Show" = [["Show"]]
fn LoBoundOf lx, "Prelude.Num" = [["Num"]]
fn LoBoundOf lx, "Prelude.Pod" = [["ToPod", "FromPod"]]
fn LoBoundOf lx, cls = match lx.g.traits[cls]:
    ? tr: [[(LoPathIn lx, tr.home, (LoCamel (BareName cls)))]]
    nil: [[]]

# A scheme's type variables as Rust generics with their bounds.
LoGenerics: fn Lx, Scheme -> [((Text, [Text]))]
fn LoGenerics lx, sc = Each sc.qs, \|q|
    let bs = Fold sc.bounds, [["Clone"]], \|acc, ((v, cls))| if v == q: UnionTexts acc, (LoBoundOf lx, cls) else: acc
    ((LoCamel q, bs))

# The parameters of a function's clauses: a name every clause binds at a position names
# the parameter; any other position is matched, named after its type.
LoParamNames: fn Lx, [FnClause], [RsTy] -> [((Text, Bool))]
fn LoParamNames lx, clauses, pts = Each (Range0 (Len pts)), \|i|
    let names = Each clauses, \|c| LoPlainBinder lx, (Or c.params[i], dummyPat)
    let first = Or names[0], ""
    let same = first != "" and Fold names, True, \|ok, n| ok and n == first
    if same: ((LoSnake first, False)) else: (((LoParamWord (Or pts[i], RsUnit), i), True))

# The binder a parameter pattern is, when it is one: its name with sigils.
LoPlainBinder: fn Lx, Pattern -> Text
fn LoPlainBinder lx, p = match p.kind:
    PName n:
        let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
        let isCtor = match ?qk:
            ? qk: (HasKey lx.g.ctors, qk) and ((IsUpperText (LoBase (SNameKey n))) or LoIsUnitCtor lx, qk)
            nil: False
        if isCtor: "" else: SNameKey n
    PGroup q: LoPlainBinder lx, q
    otherwise: ""

# A matched parameter's name: its type's (`term` for a `Term`), else `arg`.
LoParamWord: fn RsTy, Nat -> Text
fn LoParamWord t, i:
    let base = match t:
        RsNamed n, ignore: LoSnake (Or (?Last (Split n, "::")), "arg")
        RsText: "text"
        RsNat: "n"
        RsInt: "i"
        RsArray ignore: "xs"
        RsMap ignore, ignore: "map"
        RsOpt ignore: "opt"
        otherwise: "arg"
    "{base}{i}"

# A function's clauses as one body over its parameters (each a reference, `ref`).
LoClauses: unbounded fn Lx, LoEnv, [FnClause], [((Text, Bool))], [Ty], (fn Lx, LoEnv, FnBody -> Ex), Text -> Ex
fn LoClauses lx, env, clauses, names, ptys, Body, label:
    let env1 = Fold (Range0 (Len names)), env, \|en, i|
        let ((rs, matched)) = Or names[i], (("", True))
        if matched: en
        else: LoBind en, (LoPlainBinder lx, (Or (Or clauses[0], dummyClause).params[i], dummyPat)), (BnLocal rs, "ref", (LoTy lx, (LoPeel (Or ptys[i], TyErr))))
    let scrutIx = Filter (Range0 (Len names)), \|i| match names[i]:
        ? ((ignore, True)): True
        otherwise: False
    if (Len scrutIx) == 0:
        let c = Or clauses[0], dummyClause
        Body lx, env1, c.body
    else:
        let scrut = match scrutIx:
            [[i]]: XRaw (Or (Each names, \|((n, ignore))| n)[i], "arg")
            otherwise: XTuple (Each scrutIx, \|i| XRaw (Or (Each names, \|((n, ignore))| n)[i], "arg"))
        let arms = Each (Range0 (Len clauses)), \|ci|
            let c = Or clauses[ci], dummyClause
            let pos = Each scrutIx, \|i| LoPat lx, (Or c.params[i], dummyPat), (Or ptys[i], TyErr), "ref", "{label}{ci}_{i}"
            let pa = match pos:
                [[o]]: o.pa
                otherwise: PaTuple (Each pos, \|o| o.pa)
            let conds = Fold pos, [[]], \|acc, o| Append acc, o.conds
            let binds = Fold pos, [[]], \|acc, o| Append acc, o.binds
            XArm(pat=pa, conds=conds, body=(Body lx, (LoBindAll env1, binds), c.body))
        LoOwn (LoArmsValue scrut, arms, "'{label}", RsUnit)

let dummyClause = FnClause(name=(DefOp "", Range(start=0, end=0)), params=[[]], body=(BodyExpr (Expr(kind=EError, span=Range(start=0, end=0)))), span=Range(start=0, end=0))

LoFnBodyValue: unbounded fn Lx, LoEnv, FnBody -> Ex
fn LoFnBodyValue lx, env, (BodyExpr x) = LoOwn (LoX lx, env, x)
fn LoFnBodyValue lx, env, (BodyBlock b) = LoOwn (LoBlock lx, env, b)

# A plain function: its scheme's types, its clauses as a `match`.
LoFnDef: unbounded fn Lx, Text, [FnClause], Scheme -> FnDef
fn LoFnDef lx, qk, clauses, sc:
    let ((ptys, res)) = match sc.ty:
        TyFn ignore, ps, r: ((ps, r))
        other: (([[]], other))
    let pts = Each ptys, \|p| LoTy lx, (LoPeel p)
    let names = LoParamNames lx, clauses, pts
    let body = LoClauses lx, emptyEnv, clauses, names, ptys, LoFnBodyValue, "c"
    let params = Each (Range0 (Len pts)), \|i| (((Or (Each names, \|((n, ignore))| n)[i], "arg"), (RsRef (Or pts[i], RsUnit))))
    FnDef(name=(Or lx.rsNames[qk], (LoSnake (BareName qk))), generics=(LoGenerics lx, sc), params=params, ret=(LoTy lx, (LoPeel res)), body=body, doc=(LoSignatureText lx, qk), public=True)

# A definition's Prism signature, for the doc comment.
LoSignatureText: fn Lx, Text -> Text
fn LoSignatureText lx, qk = match lx.g.vals[qk]:
    ? v: match lx.g.srcs[v.file]:
        ? src: Trim (SpanText src, v.span)
        nil: BareName qk
    nil: BareName qk

# A definition's whole Prism source, its signature with it.
LoDefinitionText: fn Lx, Text -> Text
fn LoDefinitionText lx, qk:
    let spans = Fold lx.g.defs, [[]], \|acc, d| if d.qk == qk: Push acc, ((d.file, d.span)) else: acc
    let sig = match lx.g.vals[qk]:
        ? v: if v.span.start < (Or (Each spans, \|((ignore, r))| r.start)[0], 0): [[((v.file, v.span))]] else: [[]]
        nil: [[]]
    Join (Each (Append sig, spans), \|((f, r))| LoSrcText lx, f, r), "\n"

LoSrcText: fn Lx, Nat, Range -> Text
fn LoSrcText lx, f, r = match lx.g.srcs[f]:
    ? src: LoDropTrailingComments (SpanText src, r)
    nil: ""

# A definition's span runs to the next one, so it takes the comments that introduce the
# next (or a test file's header): the quote stops at its last line of code.
LoDropTrailingComments: fn Text -> Text
fn LoDropTrailingComments t:
    let lines = Split t, "\n"
    let keep = Fold (Range0 (Len lines)), 0, \|k, i| if LoIsCodeLine (Or lines[i], ""): i + 1 else: k
    TrimEnd (Join (Take lines, keep), "\n")

LoIsCodeLine: fn Text -> Bool
fn LoIsCodeLine l:
    let s = Trim l
    s != "" and (Take s, 1) != "#"

# A top-level `let`: a getter computing its value (pick TL of the README).
LoLetDef: unbounded fn Lx, Text, LetDecl -> FnDef
fn LoLetDef lx, qk, l:
    let t = LoTy lx, (LoPeel (LoTyOf lx, l.value.span))
    let v = LoX lx, emptyEnv, l.value
    FnDef(name=(Or lx.rsNames[qk], (LoSnake (BareName qk))), generics=[[]], params=[[]], ret=t, body=(LoOwn v), doc="let {BareName qk}", public=True)

# ---------------------------------------------------------------------------------------
# Unbounded functions as step machines (Semantics ch. 7; D6; docs/backend.md, "Unbounded
# functions and `@Run`")
# ---------------------------------------------------------------------------------------

# A job's body: bounded code to the next cycle point. A tail call of an unbounded function
# is a cycle point that leaves no frame: the job is the callee with its arguments
# (`Turn::More`); any other result ends the job (`Turn::Finished`). A call of an unbounded
# function that is not a tail call runs direct-style inside the cycle (doubt DS).
LoTail: unbounded fn Lx, LoEnv, Expr -> Ex
fn LoTail lx, env, e = match e.kind:
    EGroup x: LoTail lx, env, x
    EMatch s, arms: LoTailMatch lx, env, s, arms, e.span
    EIf (CondExpr c), thenB, (? elseB): XIf (LoBool (LoX lx, env, c)), (LoTailBlock lx, env, thenB), (LoTailBlock lx, env, elseB)
    ECall callee, args, ignore, ignore: match ?LoTailCallee lx, env, callee:
        ? qk:
            let job = Or lx.rsNames[qk], (LoSnake (BareName qk))
            let jobName = LoPathIn lx, (LoOwnerOf qk), (LoCamel (BareName qk))
            let ((ptys, ignore)) = LoSchemeParts lx, qk
            let fields = LoJobFieldNames lx, qk
            let vals = Each args, \|a| LoOwn (LoX lx, env, a.value)
            XCtor "Turn::More", [[(XCall "Rc::new", [[(XRecord jobName, (Each (Range0 (Len vals)), \|i| (((Or fields[i], "arg"), (Or vals[i], (XRaw "()"))))))]])]]
        nil: XCtor "Turn::Finished", [[LoOwn (LoX lx, env, e)]]
    otherwise: XCtor "Turn::Finished", [[LoOwn (LoX lx, env, e)]]

LoTailBlock: unbounded fn Lx, LoEnv, Block -> Ex
fn LoTailBlock lx, env, b:
    let n = Len b.stmts
    let ((dos, env2)) = Fold (Range0 (Dec n)), (([[]], env)), \|((acc, en)), i|
        let ((more, en2)) = LoStmt lx, en, (Or b.stmts[i], dummyStmtL)
        (((Append acc, more), en2))
    let last = match (Or b.stmts[Dec n], dummyStmtL).kind:
        SExpr x: LoTail lx, env2, x
        otherwise: XCtor "Turn::Finished", [[XRaw "()"]]
    if (Len dos) == 0: last else: XBlock dos, last

LoTailBody: unbounded fn Lx, LoEnv, FnBody -> Ex
fn LoTailBody lx, env, (BodyExpr x) = LoTail lx, env, x
fn LoTailBody lx, env, (BodyBlock b) = LoTailBlock lx, env, b

LoTailMatch: unbounded fn Lx, LoEnv, Expr, [Arm], Range -> Ex
fn LoTailMatch lx, env, s, arms, span:
    let sv = LoX lx, env, s
    let sty = LoTyOf lx, s.span
    let label = "m{span.start}"
    let byRef = Each (Range0 (Len arms)), \|i| LoArmPat lx, (Or arms[i], dummyArm).?pattern, sty, "ref", "{label}_{i}"
    let chain = Fold byRef, False, \|f, po| f or Fold po.conds, False, \|f2, c| f2 or LoIsLetCond c
    let owned = match sv:
        VlOwned ignore, ignore: not chain
        otherwise: False
    let pats = if owned: Each (Range0 (Len arms)), \|i| LoArmPat lx, (Or arms[i], dummyArm).?pattern, sty, "own", "{label}_{i}" else: byRef
    let xarms = Each (Range0 (Len arms)), \|i|
        let arm = Or arms[i], dummyArm
        let po = Or pats[i], (PatOut(pa=PaWild, conds=[[]], binds=[[]]))
        let env2 = LoBindAll env, po.binds
        XArm(pat=po.pa, conds=(Append po.conds, (LoGuardConds lx, env2, arm.?guard)), body=(LoTailBlock lx, env2, arm.body))
    let scrut = if owned: LoOwn sv else: LoRef sv
    LoOwn (LoArmsValue scrut, xarms, "'{label}", RsUnit)

# The unbounded function a call in tail position enters, when it has a job.
?LoTailCallee: fn Lx, LoEnv, Expr -> ?Text
fn ?LoTailCallee lx, env, callee = match callee.kind:
    EName n:
        if (Len n.path) == 1 and HasKey env.names, (SNameKey n): nil
        else:
            let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
            match ?qk:
                ? qk: if HasText lx.unbs, qk: ? qk else: nil
                nil: nil
    otherwise: nil

LoSchemeParts: fn Lx, Text -> (([Ty], Ty))
fn LoSchemeParts lx, qk = match lx.g.vals[qk]:
    ? v: match v.scheme.ty:
        TyFn ignore, ps, r: ((ps, r))
        other: (([[]], other))
    nil: (([[]], TyErr))

# A job's fields: its function's parameter names.
LoJobFieldNames: unbounded fn Lx, Text -> [Text]
fn LoJobFieldNames lx, qk:
    let clauses = LoClausesOf lx.g, qk
    let ((ptys, ignore)) = LoSchemeParts lx, qk
    let pts = Each ptys, \|p| LoTy lx, (LoPeel p)
    Each (LoParamNames lx, clauses, pts), \|((n, ignore))| n

LoClausesOf: fn G, Text -> [FnClause]
fn LoClausesOf g, qk = Fold g.defs, [[]], \|acc, d| if d.qk == qk: LoDefClauses d, acc else: acc

LoDefClauses: fn Def, [FnClause] -> [FnClause]
fn LoDefClauses d, other = match d.body:
    DbFn cs: cs
    otherwise: other

# The job of an unbounded function: its parameters as fields, its body to the next cycle.
LoJobDef: unbounded fn Lx, Text, [FnClause], Scheme -> JobDef
fn LoJobDef lx, qk, clauses, sc:
    let ((ptys, res)) = match sc.ty:
        TyFn ignore, ps, r: ((ps, r))
        other: (([[]], other))
    let pts = Each ptys, \|p| LoTy lx, (LoPeel p)
    let names = LoParamNames lx, clauses, pts
    let body = LoJobClauses lx, clauses, names, ptys, pts
    let base = Or lx.rsNames[qk], (LoSnake (BareName qk))
    JobDef(name=(LoCamel (BareName qk)), start="start_{base}", generics=(LoGenerics lx, sc), fields=(Each (Range0 (Len pts)), \|i| (((Or (Each names, \|((n, ignore))| n)[i], "arg"), (Or pts[i], RsUnit)))), ret=(LoTy lx, (LoPeel res)), body=body, doc=(LoSignatureText lx, qk))

# A job's clauses: the parameters are the job's fields, `self.t`.
LoJobClauses: unbounded fn Lx, [FnClause], [((Text, Bool))], [Ty], [RsTy] -> Ex
fn LoJobClauses lx, clauses, names, ptys, pts:
    let lets = Each (Range0 (Len names)), \|i|
        let ((rs, ignore)) = Or names[i], (("arg", True))
        DoLet (PaBind rs), (XRaw "&self.{rs}")
    let inner = LoClauses lx, emptyEnv, clauses, names, ptys, LoTailBody, "j"
    XBlock lets, inner

# ---------------------------------------------------------------------------------------
# Widget blocks: one node per block, children in static positions merged in (Compiler
# ch. 3, "The translation"; docs/backend.md, "A widget block")
# ---------------------------------------------------------------------------------------

# An event as an expression reaches it: a node of the block's graph (a source, a named
# event or a combinator) and the pipe of pure transforms after it, which calls straight
# through (Compiler ch. 3, the half counter): given the node's value and what to do with
# the result, the code.
type EvRef = record:
    node: Nat
    pipe: unbounded fn Ex, (unbounded fn Ex -> [Do]) -> [Do]

LoIdPipe: unbounded fn Ex, (unbounded fn Ex -> [Do]) -> [Do]
fn LoIdPipe x, K = K x

LoEvOf: fn Nat -> EvRef
fn LoEvOf n = EvRef(node=n, pipe=LoIdPipe)

# One node of the graph: its method, its value's type, what it is, and what each firing
# does (`outs`, in page order).
type Gn = record:
    id: Nat
    name: Text
    ty: RsTy
    kind: Text
    height: Nat
    inputs: [Text]
    outs: [Out]

type Out = record:
    pipe: unbounded fn Ex, (unbounded fn Ex -> [Do]) -> [Do]
    sink: Sk

# Where a firing goes: another node's method, a combinator's stamped input, a hold, a
# request field, the root's result, an `@Defer`, `@Run`'s machine.
type Sk = choice:
    SkNode Nat
    SkIn Nat, Nat
    SkHold Text
    SkRequest Nat, Text
    SkResult
    SkArm Text
    SkCycle Text, Text, Nat
    SkUp Text
    SkPort Text

# A place of the block: its position, its `Level`, and when a live field reads a dynamic
# its getter (the patch pass pulls it after the tick, docs/backend.md "Marks").
type Place = record:
    pos: Nat
    level: Ex
    getter: Text
    reads: [Text]

# What a block (or an inlined widget) gives back.
type Wres = choice:
    WrEv EvRef
    WrDyn Ex, [Text], RsTy
    WrPlain Ex, RsTy
    WrUnit

# The state of lowering one node.
type Wx = record:
    lx: Lx
    node: Text
    pos: Nat
    gns: [Gn]
    fields: [((Text, RsTy, Text))]
    inits: [((Text, Ex))]
    lets: [Do]
    build: [Do]
    places: [Place]
    answers: [((Nat, Nat, RsTy))]
    started: [Nat]
    defers: [((Text, Nat))]
    getters: [MethDef]
    dynReads: (Text ==> [Text])
    taken: [Text]
    fallible: Bool
    depth: Nat
    result: Wres
    rows: [NodeDef]
    builders: [ForDef]
    buildHolds: [Text]
    upSink: Text
    gens: [GenDef]
    genHolds: [((Text, [Text]))]
    ports: [Text]
    subs: [((Text, Text, RsTy))]
    parentEnv: LoEnv

# The names a node's own methods and the `Node` interface take.
let nodeHooks = [["path", "build", "wake", "started", "deferred", "answer", "push", "swap", "leave", "patch", "clean_up", "edges", "release", "leave_row", "remove_places"]]

# A name not yet taken in the node: `base`, else `base_2`, `base_3`.
LoFresh: fn Wx, Text -> ((Text, Wx))
fn LoFresh wx, base:
    let pick = if not (HasText wx.taken, base): base else: "{base}_{LoFirstFree wx.taken, base, 2}"
    let wx2 = update wx:
        &_.taken <= Push &_.taken, pick
    ((pick, wx2))

LoFirstFree: fn [Text], Text, Nat -> Nat
fn LoFirstFree taken, base, from = Fold (Range0 (Len taken)), from, \|n, ignore| if HasText taken, "{base}_{n}": n + 1 else: n

# A new node of the graph.
LoAddGn: fn Wx, Text, RsTy, Text, Nat -> ((Nat, Wx))
fn LoAddGn wx, name, ty, kind, height:
    let id = Len wx.gns
    let wx2 = update wx:
        &_.gns <= Push &_.gns, Gn(id=id, name=name, ty=ty, kind=kind, height=height, inputs=[[]], outs=[[]])
    ((id, wx2))

# An event reference given a consumer.
LoConnect: fn Wx, EvRef, Sk -> Wx
fn LoConnect wx, r, sink = update wx:
    &_.gns <= Each &_.gns, \|n| if n.id == r.node: LoAddOut n, (Out(pipe=r.pipe, sink=sink)) else: n

LoAddOut: fn Gn, Out -> Gn
fn LoAddOut n, o = update n:
    &_.outs <= Push &_.outs, o

LoAddField: fn Wx, Text, RsTy, Text, Ex -> Wx
fn LoAddField wx, name, t, doc, init = update wx:
    &_.fields <= Push &_.fields, ((name, t, doc))
    &_.inits <= Push &_.inits, ((name, init))

LoHeightOf: fn Wx, Nat -> Nat
fn LoHeightOf wx, n = match wx.gns[n]:
    ? g: g.height
    nil: 0

LoGnOf: fn Wx, Nat -> Gn
fn LoGnOf wx, n = Or wx.gns[n], (Gn(id=n, name="never", ty=RsUnit, kind="never", height=0, inputs=[[]], outs=[[]]))

# A plain value of the block, bound at the build and kept as a field: the build reads the
# Rust local, the methods the field.
LoBindPlain: fn LoEnv, LoEnv, Text, Text, RsTy -> ((LoEnv, LoEnv))
fn LoBindPlain benv, menv, nkey, rs, t = (((LoBind benv, nkey, (BnLocal rs, "own", t)), (LoBind menv, nkey, (BnLocal "self.{rs}", "own", t))))

# ---------------------------------------------------------------------------------------
# A node from a widget definition
# ---------------------------------------------------------------------------------------

# A widget (`@name:` or `fn @Name params:` with one clause) as a node: its parameters are
# its constructor's and fields; its block lowers into the node.
LoNodeDef: unbounded fn Lx, Text, [Pattern], Block, Scheme, Bool -> NodeDef
fn LoNodeDef lx, qk, params, body, sc, isRoot:
    let name = LoCamel (BareName qk)
    let ptys = match sc.ty:
        TyFn ignore, ps, ignore: ps
        otherwise: [[]]
    let wx0 = Wx(lx=lx, node=name, pos=0, gns=[[]], fields=[[]], inits=[[]], lets=[[]], build=[[]], places=[[]], answers=[[]], started=[[]], defers=[[]], getters=[[]], dynReads={}, taken=nodeHooks, fallible=False, depth=0, result=WrUnit, rows=[[]], builders=[[]], buildHolds=[[]], upSink="", gens=[[]], genHolds=[[]], ports=[[]], subs=[[]], parentEnv=emptyEnv)
    let ((ps, wx1, benv, menv)) = Fold (Range0 (Len params)), (([[]], wx0, emptyEnv, emptyEnv)), \|((acc, w, be, me)), i|
        let p = Or params[i], dummyPat
        let nkey = LoPlainBinder lx, p
        let base = if nkey == "": "arg{i}" else: LoSnake nkey
        let ((rs, w2)) = LoFresh w, base
        let t = LoTy lx, (LoPeel (Or ptys[i], TyErr))
        let w3 = update w2:
            &_.fields <= Push &_.fields, ((rs, t, "a parameter"))
            &_.inits <= Push &_.inits, ((rs, (XMethod (XRaw rs), "clone", [[]])))
        let ((be2, me2)) = LoBindPlain be, me, nkey, rs, t
        (((Push acc, ((rs, t))), w3, be2, me2))
    let wx2 = LoBlockInto wx1, benv, menv, body
    let wx3 = if isRoot: LoRootResult wx2 else: wx2
    LoFinishNode wx3, qk, ps, False

# The root's result goes to the World (docs/backend.md: `cx.result(..)`).
LoRootResult: fn Wx -> Wx
fn LoRootResult wx = match wx.result:
    WrEv r: LoConnect wx, r, SkResult
    WrPlain x, ignore: update wx:
        &_.build <= Push &_.build, (DoExpr (XMethod (XRaw "cx"), "result", [[(XCtor "Outcome::Value", [[(XMethod x, "to_pod", [[]])]])]]))
    otherwise: wx

# A block's statements into the node, names bound before any line is read (one binding
# group): the bound events, holds and dynamics first, then every line in page order.
LoBlockInto: unbounded fn Wx, LoEnv, LoEnv, Block -> Wx
fn LoBlockInto wx, benv, menv, b:
    let ((wx1, be1, me1)) = Fold b.stmts, ((wx, benv, menv)), \|((w, be, me)), s| LoPreBind w, be, me, s
    let n = Len b.stmts
    let ((wx2, ignore, ignore)) = Fold (Range0 n), ((wx1, be1, me1)), \|((w, be, me)), i| LoWStmt w, be, me, (Or b.stmts[i], dummyStmtL), i + 1 == n
    wx2

# Names first: a bound event is a node of its own, a hold or a bound dynamic a field, a
# dynamic `let` a getter.
LoPreBind: unbounded fn Wx, LoEnv, LoEnv, Stmt -> ((Wx, LoEnv, LoEnv))
fn LoPreBind wx, benv, menv, s = match s.kind:
    SBind p, init, ?step: match p.kind:
        PName n: LoPreBindName wx, benv, menv, n, (LoHowBound ?step)
        otherwise: ((wx, benv, menv))
    SLet p, ignore, ignore: match p.kind:
        PName n: LoPreBindName wx, benv, menv, n, "let"
        otherwise: ((wx, benv, menv))
    otherwise: ((wx, benv, menv))

LoHowBound: fn ?Expr -> Text
fn LoHowBound (? ignore) = "hold"
fn LoHowBound nil = "bind"

LoPreBindName: unbounded fn Wx, LoEnv, LoEnv, SName, Text -> ((Wx, LoEnv, LoEnv))
fn LoPreBindName wx, benv, menv, n, how:
    let lx = wx.lx
    let nkey = SNameKey n
    let full = LoBinderTy lx, n.span
    let layer = LoLayer full
    let t = LoTy lx, (LoPeel full)
    let ((rs, wx1)) = LoFresh wx, (LoSnake nkey)
    if layer == "!" or LoIsSwitched full:
        let ((id, wx2)) = LoAddGn wx1, rs, (LoTy lx, (LoPeel (LoPeel full))), "named", 0
        let b = BnEv (LoEvOf id), t
        ((wx2, (LoBind benv, nkey, b), (LoBind menv, nkey, b)))
    else: if layer == "$" and how == "let":
        let b = BnDyn (XMethod (XRaw "self"), rs, [[XRaw "cx"]]), [[rs]], t
        ((wx1, (LoBind benv, nkey, b), (LoBind menv, nkey, b)))
    else: if layer == "$":
        let b = BnHold rs, t
        ((wx1, (LoBind benv, nkey, b), (LoBind menv, nkey, b)))
    else:
        let ((be, me)) = LoBindPlain benv, menv, nkey, rs, t
        ((wx1, be, me))

# `$!a`: a dynamic of events, which `@Switch` hears (a `rebuild` handing back an event is a
# builder and a switch in one path, round 46 RD): it binds as the event its generation
# forwards.
LoIsSwitched: fn Ty -> Bool
fn LoIsSwitched t = match t:
    TySig "$", (TySig "!", ignore): True
    otherwise: False

# The binding a prebound name has.
?LoBound: fn LoEnv, Pattern -> ?Bn
fn ?LoBound env, p = match p.kind:
    PName n: env.names[SNameKey n]
    otherwise: nil

# One statement of a widget block.
LoWStmt: unbounded fn Wx, LoEnv, LoEnv, Stmt, Bool -> ((Wx, LoEnv, LoEnv))
fn LoWStmt wx, benv, menv, s, last:
    let lx = wx.lx
    match s.kind:
        SBind p, e, nil:
            let ((wx2, res)) = LoBuildLine wx, benv, menv, e, (?LoBound menv, p)
            let wx3 = LoBindRes wx2, menv, p, res
            match ((res, p.kind)):
                (((WrDyn ex, rds, t), PName n)):
                    let b = BnDyn ex, rds, t
                    ((wx3, (LoBind benv, (SNameKey n), b), (LoBind menv, (SNameKey n), b)))
                otherwise: ((wx3, benv, menv))
        SBind p, init, (? step):
            let wx2 = LoHoldLine wx, benv, menv, p, init, step
            ((wx2, benv, menv))
        SIgnore e:
            let ((wx2, ignore)) = LoBuildLine wx, benv, menv, e, nil
            ((wx2, benv, menv))
        SLet p, ignore, e:
            let wx2 = LoLetLine wx, benv, menv, p, e
            ((wx2, benv, menv))
        SExpr e: match e.kind:
            EFreeSigil "@", x:
                let ((res, wx2)) = LoResultOf wx, benv, menv, x
                let wx3 = update wx2:
                    &_.result <= res
                ((wx3, benv, menv))
            otherwise:
                let ((wx2, res)) = LoBuildLine wx, benv, menv, e, nil
                let wx3 = if last: LoSetResult wx2, res else: wx2
                ((wx3, benv, menv))
        SEmit ignore: ((wx, benv, menv))
        SSignature ignore: ((wx, benv, menv))
        otherwise:
            let wx2 = update wx:
                &_.build <= Push &_.build, (DoNote "a statement this back end does not lower yet")
            ((wx2, benv, menv))

LoSetResult: fn Wx, Wres -> Wx
fn LoSetResult wx, res = update wx:
    &_.result <= res

# `@ v`: what the block gives back, by its layer.
LoResultOf: unbounded fn Wx, LoEnv, LoEnv, Expr -> ((Wres, Wx))
fn LoResultOf wx, benv, menv, x:
    let lx = wx.lx
    let full = LoTyOf lx, x.span
    let t = LoTy lx, (LoPeel full)
    match LoLayer full:
        "!":
            let ((r, wx2)) = LoEv wx, menv, x
            ((WrEv r, wx2))
        "$":
            let ((ex, reads)) = LoDyn wx, menv, x
            (((WrDyn ex, reads, t), wx))
        otherwise:
            if t == RsUnit: ((WrUnit, wx))
            else: (((WrPlain (LoOwn (LoX lx, benv, x)), t), wx))

# `$x <- init then step`: a `Hold` field; the step event writes it.
LoHoldLine: unbounded fn Wx, LoEnv, LoEnv, Pattern, Expr, Expr -> Wx
fn LoHoldLine wx, benv, menv, p, init, step:
    let lx = wx.lx
    match ?LoBound menv, p:
        ? (BnHold f, t):
            let iv = LoOwn (LoX lx, benv, init)
            let wx1 = LoAddField wx, f, (RsHold t), "`{LoPatText p}`", (XCall "Hold::new", [[iv, XRaw "cx"]])
            let ((r, wx2)) = LoEv wx1, menv, step
            LoConnect wx2, r, (SkHold f)
        otherwise: wx

LoPatText: fn Pattern -> Text
fn LoPatText p = match p.kind:
    PName n: SNameKey n
    otherwise: "_"

# `let` in a widget block: an event names a node fed by its expression; a dynamic a
# getter; a plain value a field computed at the build.
LoLetLine: unbounded fn Wx, LoEnv, LoEnv, Pattern, Expr -> Wx
fn LoLetLine wx, benv, menv, p, e:
    let lx = wx.lx
    match ?LoBound menv, p:
        ? (BnEv er, t):
            let ((r, wx2)) = LoEv wx, menv, e
            LoConnect wx2, r, (SkNode er.node)
        ? (BnDyn ignore, ignore, t):
            let rs = LoSnake (LoPatText p)
            let ((ex, reads)) = LoDyn wx, menv, e
            let getter = MethDef(name=rs, recv="ref", params=[[]], cx="ref", ret=t, body=[[]], tail=ex, doc="`{LoPatText p}`")
            update wx:
                &_.getters <= Push &_.getters, getter
                &_.dynReads <= Insert &_.dynReads, rs, reads
        ? (BnLocal rs, ignore, t):
            let local = LoBase rs
            let v = LoOwn (LoX lx, benv, e)
            let f = Drop rs, 5
            update wx:
                &_.lets <= Push &_.lets, (DoLet (PaBind f), v)
                &_.fields <= Push &_.fields, ((f, t, "`{LoPatText p}`"))
                &_.inits <= Push &_.inits, ((f, (XMethod (XRaw f), "clone", [[]])))
        otherwise: wx

# `p <- e`: an element or a blueprint, its output or result bound.
LoBindRes: fn Wx, LoEnv, Pattern, Wres -> Wx
fn LoBindRes wx2, menv, p, res = match ?LoBound menv, p:
        ? (BnEv er, ignore): match res:
            WrEv r: if r.node == er.node: wx2 else: LoConnect wx2, r, (SkNode er.node)
            otherwise: wx2
        otherwise: wx2

# A line that builds: an element (a place), a widget applied (inlined), or a builder. The
# bound name, when there is one, is where the output goes.
LoBuildLine: unbounded fn Wx, LoEnv, LoEnv, Expr, ?Bn -> ((Wx, Wres))
fn LoBuildLine wx, benv, menv, e, ?bound:
    let lx = wx.lx
    let full = LoTyOf lx, e.span
    match e.kind:
        EGroup x: LoBuildLine wx, benv, menv, x, ?bound
        EFor ?binders, source, body: LoForLine wx, benv, menv, ?binders, source, body, e, ?bound
        ERebuild scrut, body: LoRebuildLine wx, benv, menv, scrut, body, e, ?bound
        EIf (CondExpr c), thenB, (? elseB): LoIfGenLine wx, menv, c, thenB, elseB, e
        otherwise: match LoPeel full:
            TyElem ignore, ignore: LoElementLine wx, benv, menv, e, ?bound
            TyAt ignore, ignore: LoWidgetLine wx, benv, menv, e, ?bound
            otherwise:
                let wx2 = update wx:
                    &_.build <= Push &_.build, (DoNote "a building line this back end does not lower yet")
                ((wx2, WrUnit))

# ---------------------------------------------------------------------------------------
# Elements (docs/backend.md: each place goes out with `cx.added` in its `Level`; an answer
# calls the input method; a request field's firing is `cx.request`)
# ---------------------------------------------------------------------------------------

LoElementLine: unbounded fn Wx, LoEnv, LoEnv, Expr, ?Bn -> ((Wx, Wres))
fn LoElementLine wx, benv, menv, e, ?bound:
    let lx = wx.lx
    let ((tagName, args)) = match e.kind:
        ECall c, xs, ignore, ignore: (((LoTagNameOf lx, c), xs))
        EName n: (((LoTagNameOf lx, e), [[]]))
        otherwise: (("", [[]]))
    match lx.g.tags[tagName]:
        nil:
            let wx2 = update wx:
                &_.build <= Push &_.build, (DoNote "an element of an unknown tag")
            ((wx2, WrUnit))
        ? tg:
            let pos = wx.pos
            let wx1 = update wx:
                &_.pos <= &_.pos + 1
            let structPath = LoPathIn lx, tg.home, (LoTagStruct tg.name)
            let ((liveFields, constFields, reads, wx2)) = Fold tg.fields, (([[]], [[]], [[]], wx1)), \|((lf, cf, rd, w)), ((fname, fty))|
                match ?LoTagArg args, fname:
                    nil: ((lf, cf, rd, w))
                    ? arg:
                        match LoLayer fty:
                            "!":
                                let ((r, w2)) = LoEv w, menv, arg
                                ((lf, cf, rd, (LoConnect w2, r, (SkRequest pos, (LoRequestField tg, fname)))))
                            otherwise:
                                let ((ex, rds)) = LoDyn w, menv, arg
                                let cv = LoOwn (LoX lx, benv, arg)
                                (((Push lf, ((LoSnake fname, ex))), (Push cf, ((LoSnake fname, cv))), (UnionTexts rd, rds), w))
            let live = (Len reads) > 0
            let ((getter, wx3)) = if live: LoFresh wx2, (LoSnake (BareName tg.name)) else: (("", wx2))
            let level = XMethod (XRecord structPath, (if live: liveFields else: constFields)), "to_pod", [[]]
            let added = if live: XMethod (XRaw "node"), getter, [[XRaw "cx"]] else: level
            let wx4 = update wx3:
                &_.places <= Push &_.places, Place(pos=pos, level=level, getter=getter, reads=reads)
                &_.build <= Push &_.build, (DoExpr (XMethod (XRaw "cx"), "added", [[(XMethod (XRaw "node.path"), "at", [[XRaw "{pos}"]]), added]]))
            LoElementOutput wx4, menv, tg, pos, ?bound, (XMethod (XRecord structPath, constFields), "to_pod", [[]])

# The tag an element expression names.
LoTagNameOf: fn Lx, Expr -> Text
fn LoTagNameOf lx, c = match c.kind:
    EName n:
        let ((?qk, ignore)) = ResolveValue lx.g, lx.home, n
        Or ?qk, (Dotted n.path)
    EGroup x: LoTagNameOf lx, x
    otherwise: ""

?LoTagArg: fn [Arg], Text -> ?Expr
fn ?LoTagArg args, fname = Fold args, nil, \|?found, a| match a.?name:
    ? n: if n.name == fname: ? a.value else: ?found
    nil: ?found

# A request field's name in `cx.request`: set when the tag has several request fields.
LoRequestField: fn TagInfo, Text -> Text
fn LoRequestField tg, fname:
    let evs = Filter tg.fields, \|((ignore, t))| (LoLayer t) == "!"
    if (Len evs) > 1: fname else: ""

# An element's output: an event answered at its place, a dynamic pushed to it, a plain
# value as its first value.
LoElementOutput: unbounded fn Wx, LoEnv, TagInfo, Nat, ?Bn, Ex -> ((Wx, Wres))
fn LoElementOutput wx, menv, tg, pos, ?bound, level:
    let lx = wx.lx
    let out = LoTy lx, (LoPeel tg.out)
    match LoLayer tg.out:
        "!":
            let ((id, wx2)) = match ?bound:
                ? (BnEv er, ignore): ((er.node, wx))
                otherwise:
                    let ((nm, w)) = LoFresh wx, "place_{pos}"
                    LoAddGn w, nm, out, "answer", 0
            let wx3 = update wx2:
                &_.answers <= Push &_.answers, ((pos, id, out))
            ((wx3, (WrEv (LoEvOf id))))
        "$":
            let ((f, wx1)) = match ?bound:
                ? (BnHold hf, ignore): ((hf, wx))
                otherwise: LoFresh wx, "place_{pos}"
            let asked = XMethod (XRaw "cx"), "first_value", [[(XUnary "&", level)]]
            let first = XTry (XMethod asked, "ok_or", [[(XCall "Fault::answer", [[XRaw "\"no first value for {tg.name}\""]])]])
            let wx2 = update wx1:
                &_.lets <= Push &_.lets, (DoLet (PaBind "first_{pos}"), first)
                &_.fields <= Push &_.fields, ((f, RsHold out, "pushed to place {pos}"))
                &_.inits <= Push &_.inits, ((f, (XCall "Hold::new", [[(XDecode out, (XRaw "&first_{pos}")), XRaw "cx"]])))
                &_.fallible <= True
            ((wx2, (WrDyn (XMethod (XRaw "self.{f}"), "get", [[XRaw "cx"]]), [[f]], out)))
        otherwise: match ?bound:
            ? (BnLocal rs, ignore, ignore):
                let f = Drop rs, 5
                let asked = XMethod (XRaw "cx"), "first_value", [[(XUnary "&", level)]]
                let first = XTry (XMethod asked, "ok_or", [[(XCall "Fault::answer", [[XRaw "\"no first value for {tg.name}\""]])]])
                let wx2 = update wx:
                    &_.lets <= Append &_.lets, [[(DoLet (PaBind "first_{pos}"), first), (DoLet (PaBind f), (XDecode out, (XRaw "&first_{pos}")))]]
                    &_.fields <= Push &_.fields, ((f, out, "place {pos}'s answer, its first value"))
                    &_.inits <= Push &_.inits, ((f, (XMethod (XRaw f), "clone", [[]])))
                    &_.fallible <= True
                ((wx2, WrUnit))
            otherwise: ((wx, WrUnit))

# ---------------------------------------------------------------------------------------
# Widgets applied in a static position: transparent (Semantics ch. 8), so their places
# take numbers in the caller's sequence, and inlined into the caller's node
# ---------------------------------------------------------------------------------------

LoWidgetLine: unbounded fn Wx, LoEnv, LoEnv, Expr, ?Bn -> ((Wx, Wres))
fn LoWidgetLine wx, benv, menv, e, ?bound:
    let lx = wx.lx
    let ((callee, args)) = match e.kind:
        ECall c, xs, ignore, ignore: ((c, xs))
        otherwise: ((e, [[]]))
    let qk = match callee.kind:
        EName n:
            let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
            Or ?q, ""
        otherwise: ""
    let ?target = match ?bound:
        ? (BnEv er, ignore): ? er.node
        otherwise: nil
    if qk == "Prelude.@started": LoStartedLine wx, ?bound
    else: if qk == "Prelude.@Switch": LoSwitchLine wx, menv, args
    else: if qk == "Prelude.@Defer": LoDeferLine wx, menv, args, e, ?target
    else: if qk == "Prelude.@Run": LoRunLine wx, benv, args, e, ?target
    else: match lx.g.vals[qk]:
        ? v: LoInlineWidget wx, benv, menv, qk, v, args, e
        nil:
            let wx2 = update wx:
                &_.build <= Push &_.build, (DoNote "a widget this back end does not lower yet")
            ((wx2, WrUnit))

# `@started`: takes a number, makes no place, fires in the tick after the build.
LoStartedLine: fn Wx, ?Bn -> ((Wx, Wres))
fn LoStartedLine wx, ?bound:
    let wx1 = update wx:
        &_.pos <= &_.pos + 1
    let ((id, wx2)) = match ?bound:
        ? (BnEv er, ignore): ((er.node, wx1))
        otherwise:
            let ((nm, w)) = LoFresh wx1, "started"
            LoAddGn w, nm, RsUnit, "started", 0
    let wx3 = update wx2:
        &_.started <= Push &_.started, id
    ((wx3, (WrEv (LoEvOf id))))

# `@Defer !e`: a `Defer` field armed by each firing; the next tick's `deferred` fires it.
LoDeferLine: unbounded fn Wx, LoEnv, [Arg], Expr, ?Nat -> ((Wx, Wres))
fn LoDeferLine wx, menv, args, e, ?target:
    let lx = wx.lx
    let t = LoTy lx, (LoOutOf (LoTyOf lx, e.span))
    let ((field, wx1)) = LoFresh wx, "deferred"
    let ((id, wx2)) = match ?target:
        ? n: ((n, wx1))
        nil: LoAddGn wx1, "{field}_fired", t, "deferred", 0
    let wx3 = LoAddField wx2, field, (RsDefer t), "`@Defer`", (XRaw "Defer::new()")
    let wx4 = update wx3:
        &_.defers <= Push &_.defers, ((field, id))
    match args[0]:
        ? a:
            let ((r, wx5)) = LoEv wx4, menv, a.value
            (((LoConnect wx5, r, (SkArm field)), (WrEv (LoEvOf id))))
        nil: ((wx4, (WrEv (LoEvOf id))))

# `@Run F, x` (Semantics Appendix B, over `@started`, `@Defer` and `@Machine`): it takes
# a number for its `@started`; the job is a `Hold`, the merge `!started <| !again` cycles
# it once per tick, a `More` arms the `@Defer`, a `Finished` fires the result.
LoRunLine: unbounded fn Wx, LoEnv, [Arg], Expr, ?Nat -> ((Wx, Wres))
fn LoRunLine wx, benv, args, e, ?target:
    let lx = wx.lx
    let t = LoTy lx, (LoOutOf (LoTyOf lx, e.span))
    let ((p, wx1)) = LoFresh wx, "run"
    let wx2 = update wx1:
        &_.pos <= &_.pos + 1
        &_.taken <= Append &_.taken, [["{p}_job", "{p}_again", "{p}_started", "{p}_turn"]]
    let start = match args[0]:
        ? a: match a.value.kind:
            EName n:
                let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
                LoStartPath lx, (Or ?q, "")
            otherwise: "todo!"
        nil: "todo!"
    let x = match args[1]:
        ? a: LoOwn (LoX lx, benv, a.value)
        nil: XRaw "()"
    let wx3 = LoAddField wx2, "{p}_job", (RsHold (RsJob t)), "`@Run`'s job (`@Machine`'s state)", (XCall "Hold::new", [[(XCall start, [[x]]), XRaw "cx"]])
    let wx4 = LoAddField wx3, "{p}_again", (RsDefer RsUnit), "`@Run`'s `!again`", (XRaw "Defer::new()")
    let ((s, wx5)) = LoAddGn wx4, "{p}_started", RsUnit, "started", 0
    let ((a, wx6)) = LoAddGn wx5, "{p}_again", RsUnit, "deferred", 0
    let ((m, wx7)) = LoMerge wx6, "{p}_turn", RsUnit, (LoEvOf s), (LoEvOf a)
    let ((res, wx8)) = match ?target:
        ? n: ((n, wx7))
        nil: LoAddGn wx7, "{p}_done", t, "named", 0
    let wx9 = update (LoConnect wx8, (LoEvOf m), (SkCycle "{p}_job", "{p}_again", res)):
        &_.started <= Push &_.started, s
        &_.defers <= Push &_.defers, (("{p}_again", a))
    ((wx9, (WrEv (LoEvOf res))))

# A user widget inlined: its parameters bound to the arguments by layer (an event to the
# caller's event, a dynamic to its reader, a plain value to a field), its block lowered
# into the caller's node with its positions in the caller's sequence.
LoInlineWidget: unbounded fn Wx, LoEnv, LoEnv, Text, ValInfo, [Arg], Expr -> ((Wx, Wres))
fn LoInlineWidget wx, benv, menv, qk, v, args, e:
    let lx = wx.lx
    let clauses = LoClausesOf lx.g, qk
    let ?w = ?LoWidgetDeclOf lx.g, qk
    let ((params, ?body)) = match ?w:
        ? wd: (([[]], ? wd.body))
        nil: match clauses:
            [[c]]: match c.body:
                BodyBlock b: ((c.params, ? b))
                BodyExpr x: ((c.params, ? (Block(stmts=[[Stmt(kind=(SExpr x), span=x.span)]], inline=True, span=x.span))))
            otherwise: (([[]], nil))
    match ?body:
        nil:
            let wx2 = update wx:
                &_.build <= Push &_.build, (DoNote "a widget with several clauses: not lowered yet")
            ((wx2, WrUnit))
        ? body:
            if wx.depth > 16: ((wx, WrUnit))
            else:
                let lxc = LoAtSite lx, v.file, v.home, lx.site
                let ptys = match v.scheme.ty:
                    TyFn ignore, ps, ignore: ps
                    otherwise: [[]]
                let ((wx1, be1, me1)) = Fold (Range0 (Len params)), ((wx, emptyEnv, emptyEnv)), \|((w, be, me)), i|
                    let p = Or params[i], dummyPat
                    let nkey = LoPlainBinder lxc, p
                    let pty = Or ptys[i], TyErr
                    match args[i]:
                        nil: ((w, be, me))
                        ? a: LoBindParam w, benv, menv, be, me, nkey, pty, a.value
                let inner = update wx1:
                    &_.lx <= lxc
                    &_.depth <= &_.depth + 1
                    &_.result <= WrUnit
                let done = LoBlockInto inner, be1, me1, body
                let back = update done:
                    &_.lx <= lx
                    &_.depth <= wx.depth
                    &_.result <= wx.result
                ((back, done.result))

?LoWidgetDeclOf: fn G, Text -> ?WidgetDecl
fn ?LoWidgetDeclOf g, qk = Fold g.defs, nil, \|?found, d| if d.qk == qk: ?LoDefWidget d, ?found else: ?found

?LoDefWidget: fn Def, ?WidgetDecl -> ?WidgetDecl
fn ?LoDefWidget d, ?other = match d.body:
    DbWidget w: ? w
    otherwise: ?other

# One parameter of an inlined widget, bound in the callee's environments from an argument
# lowered in the caller's.
LoBindParam: unbounded fn Wx, LoEnv, LoEnv, LoEnv, LoEnv, Text, Ty, Expr -> ((Wx, LoEnv, LoEnv))
fn LoBindParam wx, cbenv, cmenv, be, me, nkey, pty, arg:
    let lx = wx.lx
    let t = LoTy lx, (LoPeel pty)
    match LoLayer pty:
        "!":
            let ((r, wx2)) = LoEv wx, cmenv, arg
            let b = BnEv r, t
            ((wx2, (LoBind be, nkey, b), (LoBind me, nkey, b)))
        "$":
            let ((ex, reads)) = LoDyn wx, cmenv, arg
            let b = BnDyn ex, reads, t
            ((wx, (LoBind be, nkey, b), (LoBind me, nkey, b)))
        otherwise:
            let ((rs, wx2)) = LoFresh wx, (LoSnake nkey)
            let v = LoOwn (LoX lx, cbenv, arg)
            let wx3 = update wx2:
                &_.lets <= Push &_.lets, (DoLet (PaBind rs), v)
                &_.fields <= Push &_.fields, ((rs, t, "`{nkey}`"))
                &_.inits <= Push &_.inits, ((rs, (XMethod (XRaw rs), "clone", [[]])))
            let ((be2, me2)) = LoBindPlain be, me, nkey, rs, t
            ((wx3, be2, me2))

# ---------------------------------------------------------------------------------------
# Dynamics and events inside a block
# ---------------------------------------------------------------------------------------

# A dynamic expression as its reader: the plain expression over the current values, each
# hold read at the read point (`self.x.get(cx)`), and the holds and getters it reads, for
# the marks (docs/backend.md, "Marks"). Lifting is the checker's; at one moment a lifted
# expression is the plain one.
LoDyn: unbounded fn Wx, LoEnv, Expr -> ((Ex, [Text]))
fn LoDyn wx, menv, e:
    let v = LoX wx.lx, menv, e
    let reads = Fold (ExprsIn e), [[]], \|acc, x| match x.kind:
        EName n: match menv.names[SNameKey n]:
            ? (BnHold f, ignore): AddText acc, f
            ? (BnDyn ignore, rs, ignore): UnionTexts acc, rs
            otherwise: acc
        otherwise: acc
    ((LoOwn v, reads))

# A node that never fires (`never`).
LoNever: fn Wx, RsTy -> ((EvRef, Wx))
fn LoNever wx, t:
    let ((id, wx2)) = LoAddGn wx, "never", t, "never", 0
    ((LoEvOf id, wx2))

# An event expression as a reference into the block's graph (Compiler ch. 3): a pure
# transform extends the pipe and calls straight through; `<|` is a combinator, a merge
# that records its inputs and decides in the node's wake (option (c)).
LoEv: unbounded fn Wx, LoEnv, Expr -> ((EvRef, Wx))
fn LoEv wx, menv, e:
    let lx = wx.lx
    let t = LoTy lx, (LoPeel (LoTyOf lx, e.span))
    match e.kind:
        EGroup x: LoEv wx, menv, x
        EName n: match menv.names[SNameKey n]:
            ? (BnEv r, ignore): ((r, wx))
            otherwise: LoNever wx, t
        EBinary "<|", l, r:
            let ((lr, w1)) = LoEv wx, menv, l
            let ((rr, w2)) = LoEv w1, menv, r
            let ((nm, w3)) = LoFresh w2, "anon"
            let ((id, w4)) = LoMerge w3, nm, t, lr, rr
            ((LoEvOf id, w4))
        EBinary "on", l, r:
            let ((rr, w1)) = LoEv wx, menv, r
            let value = LoOwn (LoX lx, menv, l)
            ((EvRef(node=rr.node, pipe=(\|x, K| rr.pipe x, \|ignore| K value)), w1))
        ECall c, args, ignore, ignore: match LoEvPrelude lx, c:
            "Prelude.!Filter": LoFilterEv wx, menv, args, False
            "Prelude.!Present": LoFilterEv wx, menv, args, True
            "Prelude.!Gate": LoGateEv wx, menv, args
            "Prelude.!Union": LoPairEv wx, menv, args, "union", t
            "Prelude.!Both": LoPairEv wx, menv, args, "both", t
            "Prelude.!Except": LoPairEv wx, menv, args, "except", t
            otherwise: LoEvMap wx, menv, e
        otherwise: LoEvMap wx, menv, e

LoEvPrelude: fn Lx, Expr -> Text
fn LoEvPrelude lx, c = match c.kind:
    EName n:
        let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
        Or ?q, ""
    otherwise: ""

# `!Union`, `!Both`, `!Except`: combinators of two events, deciding in the wake.
LoPairEv: unbounded fn Wx, LoEnv, [Arg], Text, RsTy -> ((EvRef, Wx))
fn LoPairEv wx, menv, args, kind, t = match ((args[0], args[1])):
    ((? a, ? b)):
        let ((ra, w1)) = LoEv wx, menv, a.value
        let ((rb, w2)) = LoEv w1, menv, b.value
        let lt = LoTy wx.lx, (LoPeel (LoTyOf wx.lx, a.value.span))
        let rt = LoTy wx.lx, (LoPeel (LoTyOf wx.lx, b.value.span))
        let ((nm, w3)) = LoFresh w2, kind
        let ((id, w4)) = LoComb w3, nm, t, kind, ra, rb, lt, rt
        ((LoEvOf id, w4))
    otherwise: LoNever wx, t

# `!Filter !?a` fires the present values; `!Present` fires `unit` for them.
LoFilterEv: unbounded fn Wx, LoEnv, [Arg], Bool -> ((EvRef, Wx))
fn LoFilterEv wx, menv, args, isUnit:
    match args[0]:
        nil: LoNever wx, RsUnit
        ? a:
            let ((r, w1)) = LoEv wx, menv, a.value
            let bound = if isUnit: PaWild else: PaBind "w"
            let pipe = \|x, K| r.pipe x, \|y| [[(DoIfLet (PaCtor "Some", [[bound]]), y, (K (XRaw (if isUnit: "()" else: "w"))), [[]])]]
            ((EvRef(node=r.node, pipe=pipe), w1))

# `!Gate $b, !e` fires `!e` while `$b` reads true.
LoGateEv: unbounded fn Wx, LoEnv, [Arg] -> ((EvRef, Wx))
fn LoGateEv wx, menv, args = match args[1]:
    nil: LoNever wx, RsUnit
    ? a:
        let ((r, w1)) = LoEv wx, menv, a.value
        let cond = match args[0]:
            ? b: LoBool (LoX wx.lx, menv, b.value)
            nil: XRaw "false"
        let pipe = \|x, K| r.pipe x, \|y| [[(DoIf cond, (K y), [[]])]]
        ((EvRef(node=r.node, pipe=pipe), w1))

# Any other event expression maps the one event among its operands: the event's value is
# bound at its place in the source, and the expression lowers as a plain one over it.
LoEvMap: unbounded fn Wx, LoEnv, Expr -> ((EvRef, Wx))
fn LoEvMap wx, menv, e:
    let lx = wx.lx
    let t = LoTy lx, (LoPeel (LoTyOf lx, e.span))
    let evs = Filter (LoChildren e), \|x| (LoLayer (LoTyOf lx, x.span)) == "!"
    match evs:
        [[one]]:
            let ((r, w1)) = LoEv wx, menv, one
            let et = LoTy lx, (LoPeel (LoTyOf lx, one.span))
            let k = LoKey lx, one.span
            let pipe = \|x, K| r.pipe x, \|y| K (LoOwn (LoX lx, (LoBindSpan menv, k, (LoEvValue y, et)), e))
            ((EvRef(node=r.node, pipe=pipe), w1))
        otherwise: LoNever wx, t

# A firing's value where an expression reads it: a local is a place, anything else an
# owned temporary.
LoEvValue: fn Ex, RsTy -> Vl
fn LoEvValue (XRaw n), t = VlPlace (XRaw n), "own", t
fn LoEvValue x, t = VlOwned x, t

# The operands of an expression, one level down.
LoChildren: fn Expr -> [Expr]
fn LoChildren e = match e.kind:
    ECall c, args, ignore, ignore: Append [[c]], (Each args, \|a| a.value)
    EMethod r, ignore, args: Append [[r]], (Each args, \|a| a.value)
    EBinary ignore, l, r: [[l, r]]
    EUnary ignore, x: [[x]]
    EFreeSigil ignore, x: [[x]]
    EGroup x: [[x]]
    EField r, ignore, ignore: [[r]]
    EIndex r, i: [[r, i]]
    ETuple es: es
    EArray es: es
    EMap kvs: Fold kvs, [[]], \|acc, ((k, v))| Append acc, [[k, v]]
    ELit l: match l.kind:
        LText segs: Fold segs, [[]], \|acc, sg| match sg:
            SegPlaceholder x: Push acc, x
            otherwise: acc
        otherwise: [[]]
    otherwise: [[]]

# A merge `l <| r` (CXb: the left wins): a combinator node with a stamped field per input.
LoMerge: fn Wx, Text, RsTy, EvRef, EvRef -> ((Nat, Wx))
fn LoMerge wx, name, t, l, r = LoComb wx, name, t, "merge", l, r, t, t

# A combinator of two inputs: its stamped fields, its node, its inputs connected.
LoComb: fn Wx, Text, RsTy, Text, EvRef, EvRef, RsTy, RsTy -> ((Nat, Wx))
fn LoComb wx, name, t, kind, l, r, lt, rt:
    let ((id, wx1)) = LoAddGn wx, name, t, kind, 1
    let wx2 = LoAddField wx1, "{name}_left", (RsStamped lt), "`{name}`'s left input", (XRaw "Stamped::new()")
    let wx3 = LoAddField wx2, "{name}_right", (RsStamped rt), "its right input", (XRaw "Stamped::new()")
    let wx4 = update wx3:
        &_.gns <= Each &_.gns, \|n| if n.id == id: LoWithInputs n, [["{name}_left", "{name}_right"]] else: n
    ((id, (LoConnect (LoConnect wx4, l, (SkIn id, 0)), r, (SkIn id, 1))))

LoWithInputs: fn Gn, [Text] -> Gn
fn LoWithInputs n, ins = update n:
    &_.inputs <= ins

# ---------------------------------------------------------------------------------------
# The node, finished: heights, methods, the `Node` hooks, the build
# ---------------------------------------------------------------------------------------

# Heights (Q-B8; Compiler ch. 3, "The analyses"): a source is at 0, a named event at the
# height of what fires it, a combinator one above its inputs. The graph is acyclic within
# a tick (the checker's prompt-cycle check), so as many rounds as nodes settle it.
LoHeights: fn [Gn] -> [Gn]
fn LoHeights gns = Fold gns, gns, \|cur, ignore| Each cur, \|n| LoHeightStep cur, n

LoHeightStep: fn [Gn], Gn -> Gn
fn LoHeightStep gns, n:
    let feeders = Filter gns, \|m| Fold m.outs, False, \|f, o| f or LoFeeds o.sink, n.id
    let top = Fold feeders, 0, \|hi, m| Max hi, m.height
    let h = if LoIsComb n.kind: top + 1 else: if n.kind == "named": top else: n.height
    update n:
        &_.height <= h

LoIsComb: fn Text -> Bool
fn LoIsComb k = HasText [["merge", "union", "both", "except"]], k

LoFeeds: fn Sk, Nat -> Bool
fn LoFeeds (SkNode m), id = m == id
fn LoFeeds (SkIn m, ignore), id = m == id
fn LoFeeds (SkCycle ignore, ignore, m), id = m == id
fn LoFeeds other, id = False

# The holds a place reads, through the getters of dynamic `let`s.
LoReadsClosed: fn (Text ==> [Text]), [Text] -> [Text]
fn LoReadsClosed dyn, reads = Fold (Range0 4), reads, \|acc, ignore| Fold acc, acc, \|a, r| UnionTexts a, (Or dyn[r], [[]])

LoWakeConst: fn [Nat], Nat -> Text
fn LoWakeConst heights, h = if (Len heights) <= 1: "WAKE" else: "WAKE_{h}"

LoSelfCall: fn Text, [Ex] -> Do
fn LoSelfCall m, args = DoExpr (XMethod (XRaw "self"), m, (Push args, (XRaw "cx")))

# What a firing does at its sink.
LoSinkCode: fn LoSinks, Sk, Ex -> [Do]
fn LoSinkCode sk, target, y = match target:
    SkNode m: [[(LoSelfCall (LoGnOf sk.wx, m).name, [[y]])]]
    SkIn m, i:
        let g = LoGnOf sk.wx, m
        Append [[DoExpr (XMethod (XRaw "self.{Or g.inputs[i], ""}"), "set", [[y, XRaw "cx"]])]], (LoAskWake sk, g.height)
    SkHold f:
        let set = DoExpr (XMethod (XRaw "self.{f}"), "set", [[y, XRaw "cx"]])
        let dirty = if HasText sk.dirty, f: [[DoExpr (XMethod (XRaw "cx"), "dirty", [[XRaw "self.clone()"]])]] else: [[]]
        let stales = Fold sk.wx.genHolds, [[]], \|acc, ((gname, hs))| if HasText (LoReadsClosed sk.wx.dynReads, hs), f: Push acc, (DoExpr (XMethod (XRaw "self.{gname}_stale"), "set", [[XRaw "true"]])) else: acc
        let builds = (HasText sk.builds, f) or (Len stales) > 0
        let rebuildIt = if builds: Append stales, [[DoExpr (XMethod (XRaw "cx"), "build_later", [[XRaw "self.clone()"]])]] else: [[]]
        Append (Append [[set]], dirty), rebuildIt
    SkRequest pos, field:
        let fieldEx = if field == "": XRaw "None" else: XRaw "Some(\"{field}\")"
        [[DoExpr (XMethod (XRaw "cx"), "request", [[(XMethod (XRaw "self.path"), "at", [[XRaw "{pos}"]]), fieldEx, (XMethod y, "to_pod", [[]])]])]]
    SkResult: [[DoExpr (XMethod (XRaw "cx"), "result", [[(XCtor "Outcome::Fired", [[(XMethod y, "to_pod", [[]])]])]])]]
    SkArm f: [[DoExpr (XMethod (XRaw "self.{f}"), "arm", [[y, XRaw "self.clone()", XRaw "cx"]])]]
    SkPort f: [[DoExpr (XMethod (XMethod (XRaw "self.{f}_port"), "fire", [[y, XRaw "cx"]]), "ok", [[]])]]
    SkUp m:
        let keyed = (Len (Filter sk.wx.fields, \|((f, ignore, ignore))| f == "key")) > 0
        let args = if keyed: [[(XMethod (XRaw "self.key"), "clone", [[]]), y, XRaw "cx"]] else: [[y, XRaw "cx"]]
        [[(DoIfLet (PaCtor "Some", [[PaBind "parent"]]), (XMethod (XRaw "self.parent"), "upgrade", [[]]), [[DoExpr (XMethod (XRaw "parent"), m, args)]], [[]])]]
    SkCycle job, again, res:
        let more = [[DoExpr (XMethod (XRaw "self.{job}"), "set", [[XRaw "next", XRaw "cx"]]), DoExpr (XMethod (XRaw "self.{again}"), "arm", [[XRaw "()", XRaw "self.clone()", XRaw "cx"]])]]
        let fin = [[(LoSelfCall (LoGnOf sk.wx, res).name, [[XRaw "b"]])]]
        [[(DoMatch (XMethod (XMethod (XRaw "self.{job}"), "get", [[XRaw "cx"]]), "cycle", [[]]), [[(((PaCtor "Turn::More", [[PaBind "next"]]), more)), (((PaCtor "Turn::Finished", [[PaBind "b"]]), fin))]])]]

LoFire: unbounded fn LoSinks, Gn, Ex -> [Do]
fn LoFire sk, g, x:
    let many = (Len g.outs) > 1 and not (LoIsCopy g.ty)
    let xv = if many: XMethod x, "clone", [[]] else: x
    Fold g.outs, [[]], \|acc, o| Append acc, (o.pipe xv, \|y| LoSinkCode sk, o.sink, y)

LoFinishNode: unbounded fn Wx, Text, [((Text, RsTy))], Bool -> NodeDef
fn LoFinishNode wx0, qk, params, isRow:
    let wx = update wx0:
        &_.gns <= LoHeights &_.gns
    let combs = Filter wx.gns, \|g| (LoIsComb g.kind) or g.kind == "gather"
    let heights = LoSortNats (Fold combs, [[]], \|acc, g| AddNat acc, g.height)
    let many = (Len heights) > 1
    let consts = Each heights, \|h| (((LoWakeConst heights, h), h, "merges' height above the node's inputs"))
    let live = Filter wx.places, \|p| p.getter != ""
    let dirtyHolds = Fold live, [[]], \|acc, p| UnionTexts acc, (LoReadsClosed wx.dynReads, p.reads)
    let buildHolds = LoReadsClosed wx.dynReads, wx.buildHolds
    let sinks = LoSinks(wx=wx, dirty=dirtyHolds, builds=buildHolds, heights=heights, many=many)
    let evMethods = Each (Filter wx.gns, \|g| g.kind != "never"), \|g| MethDef(name=g.name, recv="rc", params=[[(("v", g.ty))]], cx="mut", ret=RsUnit, body=(LoFire sinks, g, (XRaw "v")), tail=(XRaw "()"), doc=(LoGnDoc g))
    let gatherIns = Each (Filter wx.gns, \|g| g.kind == "gather"), \|g| LoGatherIn sinks, g
    let placeGetters = Each live, \|p| MethDef(name=p.getter, recv="ref", params=[[]], cx="ref", ret=RsPod, body=[[]], tail=p.level, doc="Place {p.pos}'s `Level`, pulled after the tick.")
    let wakeBody = if many: [[(LoWakeByHeight combs, heights)]] else: Each combs, \|g| LoDecide g
    let startedBody = Each wx.started, \|st| LoSelfCall (LoGnOf wx, st).name, [[XRaw "()"]]
    let deferredBody = Each wx.defers, \|((f, id))| DoIfLet (PaCtor "Some", [[PaBind "v"]]), (XMethod (XRaw "self.{f}"), "fired", [[XRaw "cx"]]), [[(LoSelfCall (LoGnOf wx, id).name, [[XRaw "v"]])]], [[]]
    let patchBody = Fold live, [[]], \|acc, p| Append acc, (LoPatchPlace p)
    let genBuild = Each wx.gens, \|gd| DoIf (XMethod (XRaw "self.{gd.name}_stale"), "replace", [[XRaw "false"]]), [[DoExpr (XTry (XMethod (XRaw "self"), "{gd.name}_build", [[XRaw "cx"]]))]], [[]]
    let buildBody = Append (Each wx.builders, \|b| DoExpr (XTry (XMethod (XRaw "self"), "{b.name}_build", [[XRaw "cx"]]))), genBuild
    let hooks = Filter [[(("wake", wakeBody)), (("started", startedBody)), (("deferred", deferredBody)), (("build", buildBody)), (("patch", patchBody))]], \|((ignore, b))| (Len b) > 0
    let startedReg = if (Len wx.started) > 0: [[DoExpr (XMethod (XRaw "cx"), "on_started", [[XRaw "node.clone()"]])]] else: [[]]
    let rowsBuilt = Append (Each wx.builders, \|b| DoExpr (XTry (XMethod (XRaw "node"), "{b.name}_build", [[XRaw "cx"]]))), (Each wx.gens, \|gd| DoExpr (XTry (XMethod (XRaw "node"), "{gd.name}_build", [[XRaw "cx"]])))
    let subscribed = Each wx.subs, \|((ev, m, t))| DoExpr (XCall "subscribe_row", [[XRaw "&node", (XMethod (XRaw "node.parent"), "upgrade", [[]]), XRaw "|p| &p.{ev}_port", XRaw "|n, v, cx| n.{m}(v.clone(), cx)", XRaw "&node.{m}_sub"]])
    let answers = Each wx.answers, \|((pos, id, t))| LoAnswerArm wx, pos, id, t
    let forwards = Append (Each wx.builders, \|b| (("[Segment::Pos({b.pos}), Segment::Key(k), rest @ ..]", (LoForwardAnswer b)))), (Each wx.gens, \|gd| (("[Segment::Pos({gd.pos}), Segment::Gen(g), rest @ ..]", (LoForwardGen gd))))
    let rowMethods = if isRow: LoRowMethods wx, dirtyHolds else: [[]]
    let wakesField = if many: [[(("wakes", RsWakes, "the heights asked for this tick, lowest first"))]] else: [[]]
    let wakesInit = if many: [[(("wakes", (XRaw "Wakes::default()")))]] else: [[]]
    let genFields = Fold wx.gens, [[]], \|acc, gd| Append acc, [[((gd.name, (RsCell (RsOpt (RsNamed "Rc<dyn Row>", [[]]))), "the current generation of the `rebuild` at place {gd.pos}")), (("{gd.name}_count", (RsNamed "Cell<u32>", [[]]), "how many generations it has built")), (("{gd.name}_stale", (RsNamed "Cell<bool>", [[]]), "its source changed since it was built"))]]
    let genInits = Fold wx.gens, [[]], \|acc, gd| Append acc, [[((gd.name, (XRaw "RefCell::new(None)"))), (("{gd.name}_count", (XRaw "Cell::new(0)"))), (("{gd.name}_stale", (XRaw "Cell::new(false)")))]]
    let portFields = Each wx.ports, \|pn| (("{pn}_port", (RsPort (LoGnTyNamed wx, pn)), "`!{pn}`, which rows subscribe to"))
    let portInits = Each wx.ports, \|pn| (("{pn}_port", (XRaw "Port::new()")))
    let subFields = Each wx.subs, \|((ev, m, t))| (("{m}_sub", (RsNamed "Cell<Option<Handle>>", [[]]), "the subscription to the parent's `!{ev}`"))
    let subInits = Each wx.subs, \|((ev, m, t))| (("{m}_sub", (XRaw "Cell::new(None)")))
    let fallible = wx.fallible or isRow or (Len wx.builders) > 0 or (Len wx.gens) > 0
    NodeDef(name=wx.node, prism=(BareName qk), doc=(LoDefinitionText wx.lx, qk), params=params, fields=(Append (Append (Append (Append wx.fields, wakesField), genFields), portFields), subFields), consts=consts, lets=wx.lets, inits=(Append (Append (Append (Append wx.inits, wakesInit), genInits), portInits), subInits), build=(Append (Append (Append wx.build, rowsBuilt), subscribed), startedReg), fallible=fallible, methods=(Append (Append (Append (Append evMethods, gatherIns), placeGetters), wx.getters), rowMethods), answers=(Append answers, forwards), hooks=hooks, builders=wx.builders, wakes=many, children=wx.rows, gens=wx.gens, subs=wx.subs, rowKind=(if isRow: (if (Len (Filter wx.fields, \|((f, ignore, ignore))| f == "key")) > 0: "for" else: "gen") else: ""))

# The patch pass for one live place: its `Level` pulled and sent as changed.
LoPatchPlace: fn Place -> [Do]
fn LoPatchPlace p:
    let pull = DoLet (PaBind p.getter), (XMethod (XRaw "self"), p.getter, [[XRaw "cx"]])
    let at = XMethod (XRaw "self.path"), "at", [[XRaw "{p.pos}"]]
    [[pull, (DoExpr (XMethod (XRaw "cx"), "changed", [[at, XRaw p.getter]]))]]

# An answer at a place: the input method called with the decoded value.
LoAnswerArm: fn Wx, Nat, Nat, RsTy -> ((Text, Ex))
fn LoAnswerArm wx, pos, id, t:
    let call = XMethod (XRaw "self"), (LoGnOf wx, id).name, [[(XDecode t, (XRaw "v")), XRaw "cx"]]
    (("[Segment::Pos({pos})]", call))

# What the sinks' code needs of the node: the holds whose writes mark a place or a
# builder, the heights, and whether the wake dispatches by height.
type LoSinks = record:
    wx: Wx
    dirty: [Text]
    builds: [Text]
    heights: [Nat]
    many: Bool

LoSortNats: fn [Nat] -> [Nat]
fn LoSortNats xs = Fold xs, [[]], \|acc, x| Append (Push (Filter acc, \|y| y < x), x), (Filter acc, \|y| not (y < x))

# Asking for a wake at a combinator's height: once per height (and, when the node has
# combinators at several heights, the height recorded, so the wake knows which ones run:
# `Node::wake` is not told the height, gap WH of the README).
LoAskWake: fn LoSinks, Nat -> [Do]
fn LoAskWake sk, h:
    let c = "Self::{LoWakeConst sk.heights, h}"
    let ask = DoExpr (XMethod (XRaw "self.wakes"), "ask", [[XRaw c]])
    let wake = DoExpr (XMethod (XRaw "cx"), "wake", [[XRaw c, XRaw "self.clone()"]])
    if sk.many: [[ask, wake]] else: [[wake]]

# A gather's input: a row's firing, collected by key into the tick's one firing.
LoGatherIn: fn LoSinks, Gn -> MethDef
fn LoGatherIn sk, g:
    let field = Or g.inputs[0], ""
    let kt = match g.ty:
        RsMap k, ignore: k
        otherwise: RsUnit
    let vt = match g.ty:
        RsMap ignore, v: v
        otherwise: RsUnit
    let current = XMethod (XMethod (XRaw "self.{field}"), "get", [[XRaw "cx"]]), "unwrap_or_default", [[]]
    let collect = [[(DoLet (PaBind "mut all"), current), (DoExpr (XMethod (XRaw "all"), "insert", [[XRaw "k", XRaw "v"]])), (DoExpr (XMethod (XRaw "self.{field}"), "set", [[XRaw "all", XRaw "cx"]]))]]
    let body = Append collect, (LoAskWake sk, g.height)
    MethDef(name="{g.name}_in", recv="rc", params=[[(("k", kt)), (("v", vt))]], cx="mut", ret=RsUnit, body=body, tail=(XRaw "()"), doc="A row's firing, gathered by its key.")

LoDecide: fn Gn -> Do
fn LoDecide g = match g.kind:
    "gather": DoIfLet (PaCtor "Some", [[PaBind "v"]]), (XMethod (XRaw "self.{Or g.inputs[0], ""}"), "get", [[XRaw "cx"]]), [[(LoSelfCall g.name, [[XRaw "v"]])]], [[]]
    "merge": LoMergeDecide g
    kind: LoPairDecide g, kind

# Both inputs read, then decided: `!Union` joins the maps (the left's keys win), `!Both`
# pairs them, `!Except` fires the left without the right.
LoPairDecide: fn Gn, Text -> Do
fn LoPairDecide g, kind:
    let getL = XMethod (XRaw "self.{Or g.inputs[0], ""}"), "get", [[XRaw "cx"]]
    let getR = XMethod (XRaw "self.{Or g.inputs[1], ""}"), "get", [[XRaw "cx"]]
    let both = XTuple [[getL, getR]]
    let Fire = \|x| [[(LoSelfCall g.name, [[x]])]]
    let sa = PaCtor "Some", [[PaBind "a"]]
    let sb = PaCtor "Some", [[PaBind "b"]]
    let some2 = PaTuple [[sa, sb]]
    let left = PaTuple [[sa, (PaUnit "None")]]
    let right = PaTuple [[(PaUnit "None"), sb]]
    let cases = match kind:
        "union": [[((some2, (Fire (XCall "union", [[XRaw "&a", XRaw "&b"]])))), ((left, (Fire (XRaw "a")))), ((right, (Fire (XRaw "b")))), ((PaWild, [[]]))]]
        "both": [[((some2, (Fire (XTuple [[XRaw "a", XRaw "b"]])))), ((PaWild, [[]]))]]
        otherwise: [[((left, (Fire (XRaw "a")))), ((PaWild, [[]]))]]
    DoMatch both, cases

# The wake of a node with combinators at several heights: the lowest height asked runs
# its combinators.
LoWakeByHeight: fn [Gn], [Nat] -> Do
fn LoWakeByHeight combs, heights = DoMatch (XMethod (XRaw "self.wakes"), "next", [[]]), (Push (Each heights, \|h| ((PaLit "Self::{LoWakeConst heights, h}", (Each (Filter combs, \|g| g.height == h), \|g| LoDecide g)))), ((PaWild, [[]])))

# An answer under a `for`'s place goes to the row its key names.
LoForwardAnswer: fn ForDef -> Ex
fn LoForwardAnswer b:
    let rowOf = XMethod (XMethod (XMethod (XRaw "self.{b.name}"), "borrow", [[]]), "get", [[(XUnary "&", (XDecode b.keyTy, (XRaw "k")))]]), "cloned", [[]]
    XBlock [[(DoLet (PaBind "row"), rowOf), (DoIfLet (PaCtor "Some", [[PaBind "row"]]), (XRaw "row"), [[DoExpr (XTry (XMethod (XRaw "row"), "answer", [[XRaw "rest", XRaw "v", XRaw "cx"]]))]], [[]])]], (XRaw "()")

LoHeldTy: fn RsTy, RsTy -> RsTy
fn LoHeldTy (RsHold i), other = i
fn LoHeldTy t, other = other

# A row's own methods: its value updated by the builder, its places torn down.
LoRowMethods: fn Wx, [Text] -> [MethDef]
fn LoRowMethods wx, dirty:
    let vt = Fold wx.fields, RsUnit, \|acc, ((f, t, ignore))| if f == "value": LoHeldTy t, acc else: acc
    let set = DoExpr (XMethod (XRaw "self.value"), "set", [[XRaw "v", XRaw "cx"]])
    let mark = if HasText dirty, "value": [[DoExpr (XMethod (XRaw "cx"), "dirty", [[XRaw "self.clone()"]])]] else: [[]]
    let held = Fold wx.fields, False, \|acc, ((f, t, ignore))| acc or (f == "value" and (LoHeldTy t, RsUnit) != RsUnit)
    let updater = MethDef(name="update", recv="rc", params=[[(("v", vt))]], cx="mut", ret=RsUnit, body=(Append [[set]], mark), tail=(XRaw "()"), doc="A kept row's entry changed: its `$_` hears it.")
    let removes = Each wx.places, \|p| DoExpr (XMethod (XRaw "cx"), "removed", [[(XMethod (XRaw "self.path"), "at", [[XRaw "{p.pos}"]])]])
    let nested = Append (Each wx.builders, \|b| DoExpr (XRaw "self.{b.name}.borrow().values().for_each(|row| row.leave_row(cx))")), (Each wx.gens, \|gd| DoIfLet (PaCtor "Some", [[PaBind "row"]]), (XRaw "self.{gd.name}.borrow().as_ref()"), [[DoExpr (XRaw "row.leave_row(cx)")]], [[]])
    let remove = MethDef(name="remove_places", recv="ref", params=[[]], cx="mut", ret=RsUnit, body=(Append removes, nested), tail=(XRaw "()"), doc="The row left: its places are torn down.")
    if held: [[updater, remove]] else: [[remove]]

LoGnDoc: fn Gn -> Text
fn LoGnDoc g = match g.kind:
    "answer": "`{g.name}`: an answer at its place."
    "started": "`@started`, the tick after the build."
    "deferred": "An `@Defer` firing, the tick after it was armed."
    "merge": "The merge `{g.name}`, decided in the wake."
    otherwise: "`!{g.name}`."

# The merge decides once, after its inputs: the left first.
LoMergeDecide: fn Gn -> Do
fn LoMergeDecide g:
    let call = [[(LoSelfCall g.name, [[XRaw "v"]])]]
    let right = DoIfLet (PaCtor "Some", [[PaBind "v"]]), (XMethod (XRaw "self.{Or g.inputs[1], ""}"), "get", [[XRaw "cx"]]), call, [[]]
    DoIfLet (PaCtor "Some", [[PaBind "v"]]), (XMethod (XRaw "self.{Or g.inputs[0], ""}"), "get", [[XRaw "cx"]]), call, [[right]]

# ---------------------------------------------------------------------------------------
# The program
# ---------------------------------------------------------------------------------------

LoAt: fn Lx, Nat, Text -> Lx
fn LoAt lx, file, home = update lx:
    &_.file <= file
    &_.home <= home
    &_.site <= home

# The same, with the code placed in another module (an inlined widget's in its caller's,
# a check line's in `main.rs`).
LoAtSite: fn Lx, Nat, Text, Text -> Lx
fn LoAtSite lx, file, home, site = update lx:
    &_.file <= file
    &_.home <= home
    &_.site <= site

# The whole program as a model: one Rust module per Prism module (the prelude's is the
# template's own), a node per root widget (the ones the tests name and `@main`), every
# other widget inlined where it is applied.
LowerProgram: unbounded fn [Src], [Module], Nat, TProgram, Text -> Model
fn LowerProgram srcs, trees, shown, tp, name:
    let ((g, ignore)) = BuildG srcs, trees
    let ((tys, apps, bs, ims)) = LoTables tp
    let mods = LoNeededMods g, shown
    let rsMods = Fold mods, {}, \|acc, m| Insert acc, m, (LoModName m)
    let lx0 = Lx(g=g, tys=tys, apps=apps, binders=bs, impls=ims, file=0, home="", site="", rsMods=rsMods, rsNames=(LoValueNames g), layouts=(LoLayouts g), unbs=[[]], notes=[[]])
    let lx = update lx0:
        &_.unbs <= LoJobRoots lx0
    let roots = LoRootWidgets lx
    let modDefs = Each mods, \|m| LoModDef lx, m, roots, (Or g.mods[m], dummyMod), mods
    let programs = Each roots, \|((qk, ignore))| LoProgDef lx, qk
    let mainQk = Fold g.defs, "", \|found, d| if found == "" and (LoIsMain d.qk): d.qk else: found
    let ?root = if mainQk == "": nil else: ? (LoProgDef lx, mainQk)
    let checks = Fold g.defs, [[]], \|acc, d| match d.body:
        DbCheck c: Push acc, (LoCheckDef (LoAtSite lx, d.file, d.home, "\u{0}main"), c)
        otherwise: acc
    Model(name=name, mods=modDefs, programs=programs, root=?root, checks=checks, scripts=[[]], notes=[[]])

# The modules a program needs: its own files', and the modules they use or whose families
# they emit, followed (the prelude's are emitted only when reached).
LoNeededMods: unbounded fn G, Nat -> [Text]
fn LoNeededMods g, shown:
    let own = Filter (Keys g.mods), \|m| (Or g.mods[m], dummyMod).file < shown and m != "Prelude"
    let grown = Fold (Range0 6), own, \|acc, ignore| Fold acc, acc, \|a, m| UnionTexts a, (LoModRefs g, m)
    Filter (Keys g.mods), \|m| m != "Prelude" and HasText grown, m

LoModRefs: unbounded fn G, Text -> [Text]
fn LoModRefs g, m = match g.mods[m]:
    ? info:
        let used = Each info.uses, \|((u, ignore))| u
        let fams = match info.tree.?emitRow:
            ? rw: Fold rw.terms, [[]], \|acc, t| match t:
                RFamily q: Push acc, (Or g.famOwner[Dotted q.path], (Dotted q.path))
                otherwise: acc
            nil: [[]]
        Filter (Append used, fams), \|x| HasKey g.mods, x
    nil: [[]]

# The root widgets: every widget a test names, and the root module's `@main`.
LoRootWidgets: fn Lx -> [((Text, Bool))]
fn LoRootWidgets lx:
    let tested = Fold lx.g.defs, [[]], \|acc, d| match d.body:
        DbTest t: match LoBlueprintQk (LoAt lx, d.file, d.home), t.blueprint:
            "": acc
            qk: if HasText (Each acc, \|((q, ignore))| q), qk: acc else: Push acc, ((qk, True))
        otherwise: acc
    let main = Fold lx.g.defs, [[]], \|acc, d| if LoIsMain d.qk: Push acc, ((d.qk, False)) else: acc
    Fold main, tested, \|acc, ((k, b))| if HasText (Each acc, \|((q, ignore))| q), k: acc else: Push acc, ((k, b))

# The root module's `@main` (`@$main` too: Semantics ch. 6).
LoIsMain: fn Text -> Bool
fn LoIsMain qk = (LoOwnerOf qk) == "" and (LoBase (BareName qk)) == "main" and (Take (BareName qk), 1) == "@"

LoBlueprintQk: fn Lx, Expr -> Text
fn LoBlueprintQk lx, e = match e.kind:
    ECall c, ignore, ignore, ignore: LoBlueprintQk lx, c
    EGroup x: LoBlueprintQk lx, x
    EName n:
        let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
        Or ?q, ""
    otherwise: ""

# A definition's value, or for a block with no signature its definition's place.
LoValOf: fn Lx, Text -> ValInfo
fn LoValOf lx, qk = match lx.g.vals[qk]:
    ? v: v
    nil:
        let d = Fold lx.g.defs, dummyDef, \|found, df| if df.qk == qk: df else: found
        ValInfo(qk=qk, scheme=(Mono TyErr), sort="fn", hasSig=False, home=d.home, file=d.file, span=d.span)

# The program around a root widget.
LoProgDef: unbounded fn Lx, Text -> ProgDef
fn LoProgDef lx, qk:
    let v = LoValOf lx, qk
    let ptys = match v.scheme.ty:
        TyFn ignore, ps, ignore: ps
        otherwise: [[]]
    let lxm = LoAtSite lx, v.file, v.home, "\u{0}main"
    let params = Each (Range0 (Len ptys)), \|i| (("arg{i}", (LoTy lxm, (LoPeel (Or ptys[i], TyErr)))))
    let node = "{LoModName v.home}::{LoCamel (BareName qk)}"
    let gui = HasText (Or lx.g.mods[v.home], dummyMod).emitRw.fams, "Gui"
    ProgDef(name="{LoCamel (BareName qk)}Program", prism=(LoBase (BareName qk)), node=node, params=params, fallible=True, world=(if gui: "canvas" else: "cli"))

# The unbounded functions with jobs: those `@Run` is given, and those they tail-call.
LoJobRoots: unbounded fn Lx -> [Text]
fn LoJobRoots lx:
    let direct = Fold lx.g.defs, [[]], \|acc, d| UnionTexts acc, (LoRunTargets (LoAt lx, d.file, d.home), d)
    Fold (Range0 8), direct, \|acc, ignore| Fold acc, acc, \|a, qk| UnionTexts a, (LoTailTargets lx, qk)

LoRunTargets: unbounded fn Lx, Def -> [Text]
fn LoRunTargets lx, d:
    let es = match d.body:
        DbWidget w: BlockExprs w.body
        DbFn cs: Fold cs, [[]], \|acc, c| Append acc, (BodyExprs c.body)
        otherwise: [[]]
    Fold es, [[]], \|acc, e| match e.kind:
        ECall c, args, ignore, ignore:
            if (LoBlueprintQk lx, c) == "Prelude.@Run": match args[0]:
                ? a: match a.value.kind:
                    EName n:
                        let ((?q, ignore)) = ResolveValue lx.g, lx.home, n
                        match ?q:
                            ? q: AddText acc, q
                            nil: acc
                    otherwise: acc
                nil: acc
            else: acc
        otherwise: acc

# The unbounded functions a function calls in tail position.
LoTailTargets: unbounded fn Lx, Text -> [Text]
fn LoTailTargets lx, qk:
    let v = Or lx.g.vals[qk], (Builtin qk, (Mono TyErr))
    let lxm = LoAt lx, v.file, v.home
    Fold (LoClausesOf lx.g, qk), [[]], \|acc, c| UnionTexts acc, (LoTailsOfBody lxm, c.body)

LoTailsOfBody: unbounded fn Lx, FnBody -> [Text]
fn LoTailsOfBody lx, (BodyExpr x) = LoTailsOf lx, x
fn LoTailsOfBody lx, (BodyBlock b) = LoTailsOfBlock lx, b

LoTailsOfBlock: unbounded fn Lx, Block -> [Text]
fn LoTailsOfBlock lx, b = match (Or b.stmts[Dec (Len b.stmts)], dummyStmtL).kind:
    SExpr x: LoTailsOf lx, x
    otherwise: [[]]

LoTailsOf: unbounded fn Lx, Expr -> [Text]
fn LoTailsOf lx, e = match e.kind:
    EGroup x: LoTailsOf lx, x
    EMatch ignore, arms: Fold arms, [[]], \|acc, a| UnionTexts acc, (LoTailsOfBlock lx, a.body)
    EIf ignore, t, (? el): UnionTexts (LoTailsOfBlock lx, t), (LoTailsOfBlock lx, el)
    ECall c, ignore, ignore, ignore:
        let q = LoBlueprintQk lx, c
        match lx.g.vals[q]:
            ? v: match v.scheme.ty:
                TyFn CUnbound, ignore, ignore: [[q]]
                otherwise: [[]]
            nil: [[]]
    otherwise: [[]]

# One Prism module's Rust module.
LoModDef: unbounded fn Lx, Text, [((Text, Bool))], ModInfo, [Text] -> ModDef
fn LoModDef lx0, m, roots, info, mods:
    let lx = LoAt lx0, info.file, m
    let path = match lx.g.srcs[info.file]:
        ? src: src.path
        nil: ""
    let types = Fold (Values lx.g.types), [[]], \|acc, ti| if ti.home == m: Append acc, (LoTyDefs lx, ti) else: acc
    let tags = Fold (Values lx.g.tags), [[]], \|acc, tg| if tg.home == m and tg.kind == "Element": Push acc, (ItTag (LoTagDef lx, tg)) else: acc
    let defs = Fold lx.g.defs, [[]], \|acc, d| if d.home == m: Append acc, (LoDefItems (LoAt lx, d.file, m), d, roots) else: acc
    let traits = Fold (Values lx.g.traits), [[]], \|acc, tr| if tr.home == m: Push acc, (ItTrait (LoTraitDef lx, tr)) else: acc
    let impls = Fold (Values lx.g.impls), [[]], \|acc, ims| Fold ims, acc, \|a, im| if im.home == m and not im.derived: Push a, (ItImpl (LoImplDef (LoAt lx, im.file, m), im)) else: a
    let uses = Filter (Each mods, \|o| LoModName o), \|o| o != (LoModName m)
    ModDef(name=(LoModName m), prism=m, path=path, uses=uses, items=(Append (Append (Append (Append types, tags), traits), impls), defs))

# A definition's items: a function (and its job when `@Run` cycles it), a node for a root
# widget, a getter for a `let`.
LoDefItems: unbounded fn Lx, Def, [((Text, Bool))] -> [Item]
fn LoDefItems lx, d, roots:
    let isRoot = HasText (Each roots, \|((q, ignore))| q), d.qk
    match d.body:
        DbWidget w:
            if isRoot: LoNodeItems (LoNodeDef lx, d.qk, [[]], w.body, (Or lx.g.vals[d.qk], (Builtin d.qk, (Mono TyErr))).scheme, True)
            else: [[ItNote "`{d.name}` is inlined where it is applied."]]
        DbFn clauses: match lx.g.vals[d.qk]:
            nil: [[]]
            ? v: match v.scheme.ty:
                TyFn ignore, ignore, (TyAt ignore, ignore):
                    if not isRoot: [[ItNote "`{d.name}` is inlined where it is applied."]]
                    else: match clauses:
                        [[c]]: match c.body:
                            BodyBlock b: LoNodeItems (LoNodeDef lx, d.qk, c.params, b, v.scheme, True)
                            otherwise: [[ItNote "`{d.name}`: a root widget whose body is one expression is not lowered yet."]]
                        otherwise: [[ItNote "`{d.name}`: a root widget of several clauses is not lowered yet."]]
                otherwise:
                    let f = ItFn (LoFnDef lx, d.qk, clauses, v.scheme)
                    if HasText lx.unbs, d.qk: [[f, ItJob (LoJobDef lx, d.qk, clauses, v.scheme)]] else: [[f]]
        DbLet l: [[ItFn (LoLetDef lx, d.qk, l)]]
        otherwise: [[]]

# A node and the rows of its `for`s.
LoNodeItems: fn NodeDef -> [Item]
fn LoNodeItems n = Append [[ItNode n]], (Each n.children, \|c| ItNode c)

# A declared type's Rust type (docs/backend.md, "Types").
LoTyDefs: unbounded fn Lx, TyInfo -> [Item]
fn LoTyDefs lx, ti:
    let derives = Each ti.derives, \|dn| BareName dn
    let params = Each ti.params, \|p| LoCamel p
    let floaty = LoFloaty lx.g, (TyCon ti.name, [[]]), [[]]
    let bare = BareName ti.name
    let Mk = \|kind, cases| TyDef(name=(LoCamel bare), prism=bare, params=params, kind=kind, cases=cases, eq=(HasText derives, "Eq"), ord=(HasText derives, "Ord"), floaty=floaty, show=(if LoHasOwnShow lx, ti.name: "own" else: if HasText derives, "Show": "derive" else: ""), pod=(Fold cases, True, \|ok, c| ok and Fold c.fields, True, \|ok2, ((ignore, ft))| ok2 and LoPodable ft), doc=(LoTypeDoc lx, ti))
    match ti.body:
        BRecord fs:
            let fields = Each (Range0 (Len fs)), \|i|
                let ((fname, ft)) = Or fs[i], (("", TyErr))
                let rt = LoTy lx, ft
                ((LoSnake fname, (if LoRcField lx, ti.name, i: RsRc rt else: rt)))
            [[ItType (Mk "record", [[CaseDef(name=(LoCamel bare), prism=bare, fields=fields)]])]]
        BChoice cases:
            let defs = Each cases, \|((cn, ats))|
                let ck = QualKey ti.home, cn
                CaseDef(name=(LoCamel cn), prism=cn, fields=(Each (Range0 (Len ats)), \|i| (("", (LoCaseField lx, ck, i, (Or ats[i], TyErr))))))
            let kind = match cases:
                [[((cn, [[]]))]]: if IsLowerText cn: "unit" else: "choice"
                [[((cn, ignore))]]: if cn == bare: "newtype" else: "choice"
                otherwise: "choice"
            [[ItType (Mk kind, defs)]]
        otherwise: [[]]

LoCaseField: unbounded fn Lx, Text, Nat, Ty -> RsTy
fn LoCaseField lx, ck, i, t:
    let rt = LoTy lx, t
    if LoRcField lx, ck, i: RsRc rt else: rt

LoTypeDoc: fn Lx, TyInfo -> Text
fn LoTypeDoc lx, ti = match lx.g.srcs[ti.file]:
    ? src: Trim (LineText src, (CLineOf src.starts, ti.span.start))
    nil: ti.name

# An element tag's `Level`: its plain and dynamic fields (an event field is a request).
LoTagDef: unbounded fn Lx, TagInfo -> TagDef
fn LoTagDef lx, tg:
    let fields = Filter tg.fields, \|((ignore, ft))| (LoLayer ft) != "!"
    TagDef(name=(LoTagStruct tg.name), tagName=tg.name, fields=(Each fields, \|((fname, ft))| ((fname, (LoSnake fname), (LoTy lx, (LoPeel ft))))), doc=(LoTypeDoc lx, (TyInfo(name=tg.name, home=tg.home, params=[[]], body=BOpaque, derives=[[]], file=tg.file, span=tg.span))))

# A `check` block: each line's value as plain data, or the fault that stopped it.
LoCheckDef: unbounded fn Lx, CheckDecl -> CheckDef
fn LoCheckDef lx, c = CheckDef(name=c.name.name, lines=(Each c.lines, \|l| XCtor "Ok", [[(XMethod (LoOwn (LoX lx, emptyEnv, l.expr)), "to_pod", [[]])]]))

# ---------------------------------------------------------------------------------------
# `for` (docs/backend.md, "Dynamic structure"): a builder node of rows keyed by the
# source's keys, each row a node of its own whose `$_` (or `$v`) is a hold the builder
# updates; a row's event result gathers into the block's `!(K ==> T)`, one firing a tick
# ---------------------------------------------------------------------------------------

LoForLine: unbounded fn Wx, LoEnv, LoEnv, ?ForBinders, Expr, Block, Expr, ?Bn -> ((Wx, Wres))
fn LoForLine wx, benv, menv, ?binders, source, body, e, ?bound:
    let lx = wx.lx
    let pos = wx.pos
    let wx1 = update wx:
        &_.pos <= &_.pos + 1
    let ((srcEx, reads)) = LoDyn wx1, menv, source
    let srcTy = LoPeel (LoTyOf lx, source.span)
    let ((kt, vt, keyed)) = match srcTy:
        TyMap k, v: (((LoTy lx, k), (LoTy lx, v), True))
        TyArray v: ((RsNat, (LoTy lx, v), False))
        otherwise: ((RsUnit, RsUnit, True))
    let src = if keyed: srcEx else: XCall "indexed", [[(XUnary "&", srcEx)]]
    let base = match ?bound:
        ? (BnEv er, ignore): (LoGnOf wx1, er.node).name
        otherwise: "rows"
    let ((name, wx2)) = LoFresh wx1, base
    let rowName = "{wx.node}{if (Len wx.rows) == 0: "" else: "{Len wx.rows}"}Row"
    let rowWx0 = Wx(lx=lx, node=rowName, pos=0, gns=[[]], fields=[[(("key", kt, "the row's key")), (("value", (RsHold vt), "the row's entry, `$_`")), (("parent", (RsWeak wx.node), "the node of the `for`"))]], inits=[[(("key", (XRaw "key"))), (("value", (XCall "Hold::new", [[XRaw "value", XRaw "cx"]]))), (("parent", (XRaw "parent")))]], lets=[[]], build=[[]], places=[[]], answers=[[]], started=[[]], defers=[[]], getters=[[]], dynReads={}, taken=(Append nodeHooks, [["key", "value", "parent", "update"]]), fallible=False, depth=wx.depth, result=WrUnit, rows=[[]], builders=[[]], buildHolds=[[]], upSink="", gens=[[]], genHolds=[[]], ports=[[]], subs=[[]], parentEnv=emptyEnv)
    let keyB = BnLocal "key", "own", kt
    let keyM = BnLocal "self.key", "own", kt
    let ((rbe, rme)) = LoForEnvs benv, menv, ?binders, keyB, keyM, (BnLocal "value", "own", vt), (BnHold "value", vt), vt
    let rowWx = LoBlockInto rowWx0, rbe, rme, body
    let full = LoTyOf lx, e.span
    let outTy = LoTy lx, (LoPeel full)
    match rowWx.result:
        WrEv r:
            let rowH = Fold (LoHeights rowWx.gns), 0, \|hi, g| Max hi, g.height
            let ((gid, wx3)) = LoAddGn wx2, "{name}_all", outTy, "gather", (rowH + 1)
            let wx4 = LoAddField wx3, "{name}_gathered", (RsStamped outTy), "the rows' firings this tick, by key", (XRaw "Stamped::new()")
            let wx5 = update wx4:
                &_.gns <= Each &_.gns, \|n| if n.id == gid: LoWithInputs n, [["{name}_gathered"]] else: n
            let rowDone = LoConnect rowWx, r, (SkUp "{name}_all_in")
            let wx6 = LoAddBuilder wx5, name, pos, src, kt, vt, rowName, keyed, reads, (LoFinishNode rowDone, rowName, [[(("key", kt)), (("value", vt)), (("parent", (RsWeak wx.node)))]], True)
            ((wx6, (WrEv (LoEvOf gid))))
        WrDyn ex, ignore, rt:
            let rowDone = update rowWx:
                &_.getters <= Push &_.getters, (MethDef(name="result", recv="ref", params=[[]], cx="ref", ret=rt, body=[[]], tail=ex, doc="The row's result, which the block gathers by key."))
            let wx3 = LoAddBuilder wx2, name, pos, src, kt, vt, rowName, keyed, reads, (LoFinishNode rowDone, rowName, [[(("key", kt)), (("value", vt)), (("parent", (RsWeak wx.node)))]], True)
            let all = XRaw "self.{name}.borrow().iter().map(|(k, row)| (k.clone(), row.result(cx))).collect()"
            let wx4 = update wx3:
                &_.getters <= Push &_.getters, (MethDef(name="{name}_all", recv="ref", params=[[]], cx="ref", ret=(RsMap kt, rt), body=[[]], tail=all, doc="The rows' results by key: the `for`'s dynamic."))
            ((wx4, (WrDyn (XMethod (XRaw "self"), "{name}_all", [[XRaw "cx"]]), [[]], (RsMap kt, rt))))
        otherwise:
            let wx3 = LoAddBuilder wx2, name, pos, src, kt, vt, rowName, keyed, reads, (LoFinishNode rowWx, rowName, [[(("key", kt)), (("value", vt)), (("parent", (RsWeak wx.node)))]], True)
            ((wx3, WrUnit))

LoAddBuilder: fn Wx, Text, Nat, Ex, RsTy, RsTy, Text, Bool, [Text], NodeDef -> Wx
fn LoAddBuilder wx, name, pos, src, kt, vt, rowName, keyed, reads, rowDef:
    let wx1 = LoAddField wx, name, (RsCell (RsMap kt, (RsRc (RsNamed rowName, [[]])))), "the rows of the `for` at place {pos}", (XRaw "RefCell::new(Map::new())")
    update wx1:
        &_.builders <= Push &_.builders, ForDef(name=name, pos=pos, source=src, keyTy=kt, valueTy=vt, rowNode=rowName, keyed=keyed)
        &_.buildHolds <= UnionTexts &_.buildHolds, reads
        &_.rows <= Append (Push &_.rows, rowDef), rowDef.children

# A row's environments: the block's names, `key`, `$_`, and the `for`'s binders.
LoForEnvs: unbounded fn LoEnv, LoEnv, ?ForBinders, Bn, Bn, Bn, Bn, RsTy -> ((LoEnv, LoEnv))
fn LoForEnvs benv, menv, ?binders, keyB, keyM, valB, valM, vt:
    let be0 = LoBind (LoBind benv, "key", keyB), "$_", valB
    let me0 = LoBind (LoBind menv, "key", keyM), "$_", valM
    match ?binders:
        nil: ((be0, me0))
        ? fb: match fb.?second:
            ? second:
                let be1 = LoBindPat be0, fb.first, keyB, "key", kt0
                let me1 = LoBindPat me0, fb.first, keyM, "self.key", kt0
                (((LoBindPat be1, second, valB, "value", vt), (LoBindPat me1, second, valM, "self.value.get(cx)", vt)))
            nil: (((LoBindPat be0, fb.first, valB, "value", vt), (LoBindPat me0, fb.first, valM, "self.value.get(cx)", vt)))

let kt0 = RsUnit

# A `for` binder: a name binds the key or the entry; a tuple binds its parts, each the
# part of the entry (`for ((path, text)) <- files:`).
LoBindPat: fn LoEnv, Pattern, Bn, Text, RsTy -> LoEnv
fn LoBindPat env, p, b, whole, t = match p.kind:
    PName n: LoBind env, (SNameKey n), b
    PGroup q: LoBindPat env, q, b, whole, t
    PTuple ps:
        let ts = match t:
            RsTuple xs: xs
            otherwise: [[]]
        Fold (Range0 (Len ps)), env, \|en, i| match ps[i]:
            ? q: match q.kind:
                PName n: LoBind en, (SNameKey n), (LoPartBn b, whole, i, (Or ts[i], RsUnit))
                otherwise: en
            nil: en
    otherwise: env

# Part `i` of a tuple entry: of the build's value, or read from the row's hold.
LoPartBn: fn Bn, Text, Nat, RsTy -> Bn
fn LoPartBn (BnHold f, ignore), whole, i, t = BnDyn (XField (XMethod (XRaw "self.{f}"), "get", [[XRaw "cx"]]), "{i}"), [[f]], t
fn LoPartBn other, whole, i, t = BnLocal "{whole}.{i}", "own", t

LoGnTyNamed: fn Wx, Text -> RsTy
fn LoGnTyNamed wx, n = Fold wx.gns, RsUnit, \|acc, g| if g.name == n: g.ty else: acc

# ---------------------------------------------------------------------------------------
# `rebuild` and `@Switch` (docs/backend.md, "Dynamic structure"; Compiler ch. 3)
# ---------------------------------------------------------------------------------------

# A row's environments from its block's: `_` the generation's value (or the `for` entry),
# and each event of the block the row's body names a source of the row, fed by the
# block's port for it.
LoRowEnv: unbounded fn Wx, Wx, LoEnv, Block -> ((Wx, Wx, LoEnv))
fn LoRowEnv parent, rowWx, menv, body:
    let names = LoReadNames (BlockExprs body)
    Fold names, ((parent, rowWx, emptyEnv)), \|((p, r, env)), n| match menv.names[n]:
        ? (BnLocal rs, mode, t):
            let fieldOf = if (Take rs, 5) == "self.": Drop rs, 5 else: rs
            ((p, r, (LoBind env, n, (BnLocal "self.parent.upgrade().expect(\"the block outlives its rows\").{fieldOf}", "own", t))))
        ? (BnEv er, t):
            let pname = (LoGnOf p, er.node).name
            let ((rs, r1)) = LoFresh r, (LoSnake n)
            let ((id, r2)) = LoAddGn r1, rs, t, "port", 0
            let r3 = update r2:
                &_.subs <= Push &_.subs, ((pname, rs, t))
            let p2 = if HasText p.ports, pname: p else: LoConnect (LoWithPort p, pname), (LoEvOf er.node), (SkPort pname)
            ((p2, r3, (LoBind env, n, (BnEv (LoEvOf id), t))))
        otherwise: ((p, r, env))

LoWithPort: fn Wx, Text -> Wx
fn LoWithPort wx, pname = update wx:
    &_.ports <= Push &_.ports, pname

LoRebuildLine: unbounded fn Wx, LoEnv, LoEnv, Expr, Block, Expr, ?Bn -> ((Wx, Wres))
fn LoRebuildLine wx, benv, menv, scrut, body, e, ?bound:
    let lx = wx.lx
    let pos = wx.pos
    let wx1 = update wx:
        &_.pos <= &_.pos + 1
    let ((srcEx, reads)) = LoDyn wx1, menv, scrut
    let vt = LoTy lx, (LoPeel (LoTyOf lx, scrut.span))
    let ((name, wx2)) = LoFresh wx1, "generation"
    let ((upId, wx3)) = match ?bound:
        ? (BnEv er, ignore): ((er.node, wx2))
        otherwise: LoAddGn wx2, "{name}_fired", (LoTy lx, (LoPeel (LoPeel (LoTyOf lx, e.span)))), "named", 0
    let ((cases, wx4)) = LoGenCases wx3, menv, body, vt, name
    let rowDefs = Each cases, \|c| c.node
    let select = LoGenSelect wx4, menv, body, cases, pos
    let wx5 = update wx4:
        &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, source=srcEx, valueTy=vt, select=select)
        &_.genHolds <= Push &_.genHolds, ((name, reads))
        &_.rows <= Fold rowDefs, &_.rows, \|acc, rd| Append (Push acc, rd), rd.children
        &_.getters <= Push &_.getters, (LoGenUp name, (LoGnOf wx4, upId).name, (LoGnOf wx4, upId).ty)
    ((wx5, (WrEv (LoEvOf upId))))

# One generation's node, for the block or for one clause of the widget it applies.
type GenCase = record:
    node: NodeDef
    params: [((Text, RsTy))]
    pat: Pa
    conds: [Cc]

LoGenCases: unbounded fn Wx, LoEnv, Block, RsTy, Text -> (([GenCase], Wx))
fn LoGenCases wx, menv, body, vt, name:
    let lx = wx.lx
    let rowName = "{wx.node}Gen{if (Len wx.rows) == 0: "" else: "{Len wx.rows}"}"
    match ?LoClauseCall lx, body:
        ? ((qk, args)):
            let clauses = LoClausesOf lx.g, qk
            let v = LoValOf lx, qk
            Fold (Range0 (Len clauses)), (([[]], wx)), \|((acc, w)), i|
                let c = Or clauses[i], dummyClause
                let cr = LoClauseRow w, menv, c, v, "{rowName}{i}", "{name}_up"
                (((Push acc, cr.case), cr.parent))
        nil:
            let whole = LoGenRow wx, menv, body, vt, rowName, "{name}_up"
            ((([[GenCase(node=whole.node, params=[[(("value", vt))]], pat=PaWild, conds=[[]])]]), whole.parent))

# A generation's body that is one application of a widget of several clauses: the widget
# and the arguments.
?LoClauseCall: fn Lx, Block -> ?((Text, [Arg]))
fn ?LoClauseCall lx, body = match body.stmts:
    [[st]]: match st.kind:
        SExpr x: ?LoClauseCallX lx, x
        SIgnore x: ?LoClauseCallX lx, x
        otherwise: nil
    otherwise: nil

?LoClauseCallX: fn Lx, Expr -> ?((Text, [Arg]))
fn ?LoClauseCallX lx, x = match x.kind:
    ECall c, args, ignore, ignore:
        let qk = LoBlueprintQk lx, c
        if (Len (LoClausesOf lx.g, qk)) > 1: ? ((qk, args)) else: nil
    otherwise: nil

type ClauseRow = record:
    case: GenCase
    parent: Wx

# One clause's generation: its parameters' binders the row's fields, chosen by matching
# the arguments (in the block, `_` the generation's value).
LoClauseRow: unbounded fn Wx, LoEnv, FnClause, ValInfo, Text, Text -> ClauseRow
fn LoClauseRow wx, menv, c, v, rowName, upName:
    let lx = wx.lx
    let lxc = LoAtSite lx, v.file, v.home, lx.site
    let ptys = match v.scheme.ty:
        TyFn ignore, ps, ignore: ps
        otherwise: [[]]
    let binders = Fold c.params, [[]], \|acc, p| Append acc, (PatternBinders p)
    let fields = Each binders, \|((bn, r))| (((LoSnake bn), (LoTy lxc, (LoPeel (LoBinderTy lxc, r))), bn))
    let rowFields = Push (Each fields, \|((f, t, bn))| ((f, t, "`{bn}`"))), (("parent", (RsWeak wx.node), "the node of the `rebuild`"))
    let rowInits = Push (Each fields, \|((f, ignore, ignore))| ((f, (XMethod (XRaw f), "clone", [[]])))), (("parent", (XRaw "parent")))
    let rowTaken = Append nodeHooks, (Push (Each fields, \|((f, ignore, ignore))| f), "parent")
    let r0 = Wx(lx=lxc, node=rowName, pos=0, gns=[[]], fields=rowFields, inits=rowInits, lets=[[]], build=[[]], places=[[]], answers=[[]], started=[[]], defers=[[]], getters=[[]], dynReads={}, taken=rowTaken, fallible=False, depth=wx.depth, result=WrUnit, rows=[[]], builders=[[]], buildHolds=[[]], upSink="", gens=[[]], genHolds=[[]], ports=[[]], subs=[[]], parentEnv=emptyEnv)
    let body = match c.body:
        BodyBlock b: b
        BodyExpr x: Block(stmts=[[(Stmt(kind=(SExpr x), span=x.span))]], inline=True, span=x.span)
    let ((p1, r1, ports)) = LoRowEnv wx, r0, menv, body
    let ((be, me)) = Fold fields, ((emptyEnv, emptyEnv)), \|((b, m)), ((f, t, bn))| LoBindPlain b, m, bn, f, t
    let r2 = LoBlockInto r1, be, me, body
    let r3 = match r2.result:
        WrEv r: LoConnect r2, r, (SkUp upName)
        otherwise: r2
    let node = LoFinishNode r3, rowName, (Push (Each fields, \|((f, t, ignore))| ((f, t))), (("parent", (RsWeak wx.node)))), True
    let pos = Each (Range0 (Len c.params)), \|i| LoPat lxc, (Or c.params[i], dummyPat), (Or ptys[i], TyErr), "ref", "c{i}"
    let pa = PaTuple (Each pos, \|o| o.pa)
    ClauseRow(case=GenCase(node=node, params=(Each fields, \|((f, t, ignore))| ((f, t))), pat=pa, conds=(Fold pos, [[]], \|acc, o| Append acc, o.conds)), parent=p1)


type GenRow = record:
    node: NodeDef
    parent: Wx

# A generation's node: its `_` a plain field, the block's events it names through ports,
# its result forwarded up to the `rebuild`'s.
LoGenRow: unbounded fn Wx, LoEnv, Block, RsTy, Text, Text -> GenRow
fn LoGenRow wx, menv, body, vt, rowName, upName:
    let lx = wx.lx
    let r0 = Wx(lx=lx, node=rowName, pos=0, gns=[[]], fields=[[(("value", vt, "the generation's value, `_`")), (("parent", (RsWeak wx.node), "the node of the `rebuild`"))]], inits=[[(("value", (XMethod (XRaw "value"), "clone", [[]]))), (("parent", (XRaw "parent")))]], lets=[[]], build=[[]], places=[[]], answers=[[]], started=[[]], defers=[[]], getters=[[]], dynReads={}, taken=(Append nodeHooks, [["value", "parent"]]), fallible=False, depth=wx.depth, result=WrUnit, rows=[[]], builders=[[]], buildHolds=[[]], upSink="", gens=[[]], genHolds=[[]], ports=[[]], subs=[[]], parentEnv=emptyEnv)
    let ((p1, r1, ports)) = LoRowEnv wx, r0, menv, body
    let be = LoBind (LoBuildSpelling ports), "_", (BnLocal "value", "own", vt)
    let me = LoBind ports, "_", (BnLocal "self.value", "own", vt)
    let r2 = LoBlockInto r1, be, me, body
    let r3 = match r2.result:
        WrEv r: LoConnect r2, r, (SkUp upName)
        otherwise: r2
    GenRow(node=(LoFinishNode r3, rowName, [[(("value", vt)), (("parent", (RsWeak wx.node)))]], True), parent=p1)

# A row's names as its constructor spells them: the block through the `parent` argument.
LoBuildSpelling: fn LoEnv -> LoEnv
fn LoBuildSpelling env = Fold (Keys env.names), env, \|en, k| match env.names[k]:
    ? (BnLocal rs, mode, t): if (Take rs, 12) == "self.parent.": LoBind en, k, (BnLocal (Drop rs, 5), mode, t) else: en
    otherwise: en

let dummyGen = GenDef(name="", pos=0, source=(XRaw ""), valueTy=RsUnit, select=(XRaw ""))

# The generation built: the one case, its row's constructor.
LoGenSelect: unbounded fn Wx, LoEnv, Block, [GenCase], Nat -> Ex
fn LoGenSelect wx, menv, body, cases, pos = match ?LoClauseCall wx.lx, body:
    nil: match cases[0]:
        ? c: XTry (XCall "{c.node.name}::build", [[XRaw "path", XRaw "value", XRaw "Rc::downgrade(self)", XRaw "cx"]])
        nil: XRaw "todo!()"
    ? ((qk, args)):
        let env = LoBind menv, "_", (BnLocal "value", "own", RsUnit)
        let scrut = XTuple (Each args, \|a| LoArg wx.lx, env, a.value)
        let arms = Each cases, \|c|
            let passed = Each c.params, \|((f, ignore))| XMethod (XRaw f), "clone", [[]]
            let made = XTry (XCall "{c.node.name}::build", (Append (Append [[XRaw "path.clone()"]], passed), [[XRaw "Rc::downgrade(self)", XRaw "cx"]]))
            XArm(pat=c.pat, conds=c.conds, body=(XCast made, (RsNamed "Rc<dyn Row>", [[]])))
        LoOwn (LoArmsValue scrut, arms, "'select", (RsNamed "Rc<dyn Row>", [[]]))

# The `rebuild`'s up-forwarding: a generation's result fires the block's event.
LoGenUp: fn Text, Text, RsTy -> MethDef
fn LoGenUp name, upName, t = MethDef(name="{name}_up", recv="rc", params=[[(("v", t))]], cx="mut", ret=RsUnit, body=[[(LoSelfCall upName, [[XRaw "v"]])]], tail=(XRaw "()"), doc="The current generation's result fires the `rebuild`'s.")

LoForwardGen: fn GenDef -> Ex
fn LoForwardGen gd:
    let current = XMethod (XMethod (XRaw "self.{gd.name}"), "borrow", [[]]), "clone", [[]]
    let isCurrent = XBin "==", (XBin "+", (XRaw "*g"), (XRaw "1")), (XMethod (XRaw "self.{gd.name}_count"), "get", [[]])
    XBlock [[(DoLet (PaBind "row"), current), (DoIfLet (PaCtor "Some", [[PaBind "row"]]), (XRaw "row"), [[(DoIf isCurrent, [[DoExpr (XTry (XMethod (XRaw "row"), "answer", [[XRaw "rest", XRaw "v", XRaw "cx"]]))]], [[]])]], [[]])]], (XRaw "()")

# `@Switch $!a`: the event its `rebuild` forwards.
LoSwitchLine: unbounded fn Wx, LoEnv, [Arg] -> ((Wx, Wres))
fn LoSwitchLine wx, menv, args = match args[0]:
    ? a:
        let ((r, wx2)) = LoEv wx, menv, a.value
        ((wx2, (WrEv r)))
    nil: ((wx, WrUnit))

# ---------------------------------------------------------------------------------------
# Traits and impls (docs/backend.md: a trait is a Rust trait, `derive` impls; a program's
# own `impl ^Show` prints by `p.raw`)
# ---------------------------------------------------------------------------------------

LoHasOwnShow: fn Lx, Text -> Bool
fn LoHasOwnShow lx, tn = Fold (Or lx.g.impls["Prelude.Show"], [[]]), False, \|f, im| f or ((not im.derived) and (LoHeadName im.head) == tn)

LoHeadName: fn Ty -> Text
fn LoHeadName (TyCon n, ignore) = n
fn LoHeadName other = ""

# A trait's parameter as `Self` in its methods' types.
LoSelfIn: unbounded fn Ty, Text -> Ty
fn LoSelfIn t, param = LoInstantiate t, [[param]], [[(TyCon "\u{0}Self", [[]])]]

LoTraitDef: unbounded fn Lx, TraitInfo -> TraitDef
fn LoTraitDef lx0, tr:
    let lx = LoAt lx0, tr.file, tr.home
    let methods = Each tr.methods, \|mq|
        let v = Or lx.g.vals[mq], (Builtin mq, (Mono TyErr))
        let sc = update v.scheme:
            &_.ty <= LoSelfIn &_.ty, tr.param
            &_.qs <= Filter &_.qs, \|q| q != tr.param
            &_.bounds <= Filter &_.bounds, \|((q, ignore))| q != tr.param
        let defaultQk = Fold tr.defaults, "", \|f, dq| if (BareName dq) == (BareName mq): dq else: f
        let clauses = if defaultQk == "": [[]] else: LoDefaultClauses lx.g, defaultQk
        let fd = LoFnDef lx, mq, (if (Len clauses) == 0: [[dummyClause]] else: clauses), sc
        update fd:
            &_.public <= (Len clauses) > 0
    TraitDef(name=(LoCamel (BareName tr.name)), methods=methods, defaults=tr.defaults, doc=(LoTypeDoc lx, (TyInfo(name=tr.name, home=tr.home, params=[[]], body=BOpaque, derives=[[]], file=tr.file, span=tr.span))))

LoDefaultClauses: fn G, Text -> [FnClause]
fn LoDefaultClauses g, qk = Fold g.defs, [[]], \|acc, d| if d.qk == qk: LoDefaultOf d, acc else: acc

LoDefaultOf: fn Def, [FnClause] -> [FnClause]
fn LoDefaultOf d, other = match d.body:
    DbDefault cs, ignore: cs
    otherwise: other

# An impl's methods, each with its trait's scheme at the impl's head.
LoImplDef: unbounded fn Lx, ImplInfo -> ImplDef
fn LoImplDef lx, im:
    let tr = Or lx.g.traits[im.cls], dummyTraitInfo
    let head = LoTy lx, im.head
    let defs = Filter lx.g.defs, \|d| LoIsMethodOf d, im
    let methods = Each defs, \|d|
        let mq = Fold tr.methods, "", \|found, q| if (BareName q) == d.name: q else: found
        let v = Or lx.g.vals[mq], (Builtin mq, (Mono TyErr))
        let sc = update v.scheme:
            &_.ty <= LoInstantiate &_.ty, [[tr.param]], [[im.head]]
            &_.qs <= Filter &_.qs, \|q| q != tr.param
            &_.bounds <= Filter &_.bounds, \|((q, ignore))| q != tr.param
        let fd = LoFnDef lx, mq, (LoMethodClauses d), sc
        if (Take im.cls, 8) == "Prelude.": LoRenamed fd, "{LoSnake d.name}_{LoSnake (BareName (LoHeadName im.head))}" else: fd
    let generics = Each im.qs, \|q| ((LoCamel q, [["Clone"]]))
    ImplDef(cls=im.cls, tr=(LoPathIn lx, tr.home, (LoCamel (BareName im.cls))), head=head, generics=generics, methods=methods, doc="")

LoRenamed: fn FnDef, Text -> FnDef
fn LoRenamed fd, n = update fd:
    &_.name <= n

LoIsMethodOf: fn Def, ImplInfo -> Bool
fn LoIsMethodOf d, im = match d.body:
    DbMethod ignore, cls, other: cls == im.cls and other.span == im.span and other.file == im.file
    otherwise: False

LoMethodClauses: fn Def -> [FnClause]
fn LoMethodClauses d = match d.body:
    DbMethod cs, ignore, ignore: cs
    otherwise: [[]]

# A building `if` over a plain condition (Semantics ch. 4: it picks its arm once, at the
# build): each arm a generation of its own, one built (pick BI of the README: under its
# place `n/#0`, where the book's arms are transparent).
LoIfGenLine: unbounded fn Wx, LoEnv, Expr, Block, Block, Expr -> ((Wx, Wres))
fn LoIfGenLine wx, menv, c, thenB, elseB, e:
    let lx = wx.lx
    let pos = wx.pos
    let wx1 = update wx:
        &_.pos <= &_.pos + 1
    let ((name, wx2)) = LoFresh wx1, "arm"
    let base = "{wx.node}{LoCamel name}{if (Len wx.rows) == 0: "" else: "{Len wx.rows}"}"
    let yes = LoGenRow wx2, menv, thenB, RsUnit, "{base}Then", "{name}_up"
    let no = LoGenRow yes.parent, menv, elseB, RsUnit, "{base}Else", "{name}_up"
    let cond = LoBool (LoX lx, menv, c)
    let Mk = \|n| XCast (XTry (XCall "{n.name}::build", [[XRaw "path", XRaw "value", XRaw "Rc::downgrade(self)", XRaw "cx"]])), (RsNamed "Rc<dyn Row>", [[]])
    let select = XIf cond, (Mk yes.node), (Mk no.node)
    let wx3 = update no.parent:
        &_.gens <= Push &_.gens, GenDef(name=name, pos=pos, source=(XRaw "()"), valueTy=RsUnit, select=select)
        &_.genHolds <= Push &_.genHolds, ((name, [[]]))
        &_.rows <= Append (Append (Append (Push &_.rows, yes.node), yes.node.children), [[no.node]]), no.node.children
        &_.getters <= Push &_.getters, (MethDef(name="{name}_up", recv="rc", params=[[(("v", RsUnit))]], cx="mut", ret=RsUnit, body=[[]], tail=(XRaw "()"), doc="An arm's result, which a building `if` of widgets drops."))
    ((wx3, WrUnit))
