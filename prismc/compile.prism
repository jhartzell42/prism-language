# ---------------------------------------------------------------------------------------
# `compile FILES|DIR... -o OUT`: the back end (lower/, emit/)
# ---------------------------------------------------------------------------------------

# `compile FILES|DIR... -o OUT [--name NAME] [--prelude DIR] [--runtime PATH]
# [--tests]`: every argument read (a `.prism` file loose, a directory as a tree,
# claude/modules-style-pass.md), with the
# prelude's modules the program does not replace; test modules only with `--tests`. The
# program is parsed, checked (and refused on an error), lowered and emitted through `@Run`
# as a Rust crate in OUT whose dependencies on `prism_rtl` and the Worlds are found at
# `--runtime PATH` (`RuntimeOf` gives the default). An
# option it does not know, or an option with no value after
# it is refused.
@CompileMain: fn [Text] -> @unit
fn @CompileMain opts:
    ?root <- Process.Env(name="PRISM_ROOT")
    let bad = BadOptions opts, [["--tests"]], compileValued
    let out = Or (?OptionValue opts, "-o"), "prismc-out"
    let ?runtime = ?RuntimeOf (?OptionValue opts, "--runtime"), ?root, out
    if (Len bad) > 0: @Refuse "{Join bad, "; "} (compile takes -o OUT, --name NAME, --prelude DIR, --runtime PATH, --tests)"
    else: if ?runtime == nil: @Refuse "an absolute -o needs --runtime PATH or PRISM_ROOT: the runtime's path from {out} cannot be told from its segments"
    else:
        let prelude = NoSlash (Or (?OptionValue opts, "--prelude"), "library")
        let settings = CompileSettings(out=out, prelude=prelude, name=(Or (?OptionValue opts, "--name"), "program"), runtime=(Or ?runtime, ""))
        @ReadSources (Compiling settings), (PlainArgs opts, compileValued), prelude, (HasText opts, "--tests")

# The options of `compile` that take a value.
let compileValued = [["-o", "--prelude", "--name", "--runtime"]]

# Where the crate finds the runtime: `--runtime PATH`; else, for a relative OUT, `..` per
# directory of OUT, which is relative to the repository root (as `./prism` and the
# bootstraps call prismc, so an emitted crate, and the seed, name no machine's paths); else,
# for an absolute OUT, `PRISM_ROOT`; else nothing, and the compile is refused.
#
?RuntimeOf: fn ?Text, ?Text, Text -> ?Text
fn ?RuntimeOf ?named, ?root, out = match ?named:
    ? r: ? r
    nil: if not (HasPrefix out, "/"): ? (RuntimeFor out) else: ?root

# `..` per directory of OUT, which is relative to the repository root.
RuntimeFor: fn Text -> Text
fn RuntimeFor out:
    let parts = Filter (SplitOn out, "/"), \|p| p != "" and p != "."
    if (Len parts) == 0: "." else: Join (Each parts, \|ignore| ".."), "/"

# What the back end is asked to compile, and what it gives back.
type CompileJob = record:
    read: ReadInput
    name: Text
    runtime: Text
derive ^Eq, ^Show

type Compiled = record:
    files: [((Text, Text))]
    failed: Bool
    report: Text
derive ^Eq, ^Show

# The back end over a program: its files read as trees and parsed, the checker (refusing on
# an error, as `--check` reports it), then lowering and emission.
CompileProgram: unbounded fn CompileJob -> Compiled
fn CompileProgram job:
    let read = Assemble job.read
    if (Len read.errors) > 0: Compiled(files=[[]], failed=True, report=(TreeReport job.read, read.errors))
    else:
        let pp = ParseProgram read
        if pp.errors != "": Compiled(files=[[]], failed=True, report="{pp.errors}parse errors")
        else:
            let pre = TreeDeclDiags pp
            let report = CheckProgram pp.srcs, (Each pp.trees, \|t| WithoutTests t), [[]], pp.shown, True, False, pre
            if report.errors > 0: Compiled(files=[[]], failed=True, report="{report.text}{report.errors} error{if report.errors == 1: "" else: "s"}")
            else:
                let model = Lower.Program.LowerProgram pp.srcs, pp.trees, pp.shown, report.typed, job.name
                let files = Emit.Rust.Items.EmitCrate model, job.runtime, read.scripts
                let refused = Fold files, [[]], \|acc, ((path, text))| Fold (Refusals text), acc, \|a, r| AddText a, "{path}: {r}"
                if (Len refused) == 0: Compiled(files=files, failed=False, report="")
                else: Compiled(files=files, failed=True, report="{Concat (Each refused, \|r| "error[{RefusalClass r}]: {r}\n")}{Len refused} construct{if (Len refused) == 1: "" else: "s"} the back end does not lower (the crate is written, with a `compile_error!` at each)")

# A refusal's class in the report: `internal` for a guard no checked program reaches (the
# message, after its file, begins "a prismc bug: ", `Lower.Expr.InternalBug`), else
# `not-lowered`.
RefusalClass: fn Text -> Text
fn RefusalClass r = if (Len (SplitOn r, ": a prismc bug: ")) > 1: "internal" else: "not-lowered"

# What lowering refused, as the emitted text marks it (`Lower.Refusal`, whose words these
# are): each distinct message once.
Refusals: fn Text -> [Text]
fn Refusals text:
    let marker = "compile_error!(\"prismc does not lower "
    let parts = SplitOn text, marker
    Fold (Drop parts, 1), [[]], \|acc, part| AddText acc, (Or (SplitOn part, "\")")[0], part)

# A tree without its `test` declarations: the checker reads a test's blueprint by its
# root's signature, which a `@name:` block has none of, so tests are checked by running
# them (pick PT); `check` blocks stay, and are checked.
WithoutTests: fn Module -> Module
fn WithoutTests m = update m:
    &_.decls <= Filter &_.decls, \|d| not (IsTestDecl d)

IsTestDecl: fn Decl -> Bool
fn IsTestDecl d = match d.kind:
    DTest ignore: True
    otherwise: False

# Writes the crate, and gives up with the diagnostics when the compile failed.
@FinishCompile: fn Text, ?Compiled -> @unit
fn @FinishCompile out, nil:
    @ unit
fn @FinishCompile out, (? o):
    ignore <- for ((path, text)) <- o.files:
        Fs.Output(path="{out}/{path}", $text=$ text)
    !started <- @started
    let !~verdict = (if o.failed: Error(kind=Prismc.Refused, message=o.report) else: ~ unit) on !started
    ignore <- Prelude.Unwrap(!~value=!~verdict)
