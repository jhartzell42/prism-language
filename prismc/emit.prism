# Emission: the model lowering decided (lower.prism) spelled as a Rust crate through the
# templates (templates/rust.prism, templates/prelude.prism): `Cargo.toml`, `src/main.rs`,
# `src/prelude.rs` and one `src/NAME.rs` per Prism module. Each function here spells one
# construct of the core form; nothing here decides (K9). An expression's text is
# relative to the column it starts at, so a template's placeholder alone on its line
# indents a piece of several lines as a person would.
#
# Written by Claude, 1 November 2026, on the claude-self-hosting branch. Subject to change:
# Jimmy rewrites it by hand, and an implementer reading it uses their own discretion.
module Emit
emit r
use Lexer.*
use CheckErrors.*
use Lower.*
use RustTemplates.*
use PreludeTemplate.*

# ---------------------------------------------------------------------------------------
# Types
# ---------------------------------------------------------------------------------------

Type: unbounded fn OutTy -> Text
fn Type t = match t:
    OutNat: "Nat"
    OutInt: "Int"
    OutU8: "u8"
    OutFloat: "f64"
    OutBool: "bool"
    OutChar: "char"
    OutText: "Text"
    OutUnit: "()"
    OutPath: "Path"
    OutDuration: "Duration"
    OutError: "Error"
    OutNamed n, [[]]: n
    OutNamed n, args: "{n}<{Types args}>"
    OutOpt i: "Option<{Type i}>"
    OutRes i: "Result<{Type i}, Error>"
    OutTuple [[one]]: "({Type one},)"
    OutTuple ts: "({Types ts})"
    OutArray e: "Array<{Type e}>"
    OutMap k, v: "Map<{Type k}, {Type v}>"
    OutFn ps, r: "Rc<dyn Fn({RefTypes ps}) -> {Type r}>"
    OutRef (OutFn ps, r): "&dyn Fn({RefTypes ps}) -> {Type r}"
    OutRef i: "&{Type i}"
    OutJobFn a, b: "Rc<dyn Fn({Type a}) -> Rc<dyn prism_rtl::Job<{Type b}>>>"
    OutJob b: "Rc<dyn prism_rtl::Job<{Type b}>>"
    OutEvent i: "Event<{Type i}>"
    OutDyn i: "Dynamic<{Type i}>"
    OutGen n: n
    OutRc i: "Rc<{Type i}>"
    OutPod: "Pod"
    OutShowAny: "Rc<dyn Show>"
    OutHold i: "Hold<{Type i}>"
    OutStamped i: "Stamped<{Type i}>"
    OutSnapshot i: "Snapshot<{Type i}>"
    OutDefer i: "Defer<{Type i}>"
    OutWeak n: "Weak<{n}>"
    OutCell i: "RefCell<{Type i}>"
    OutWakes: "Wakes"
    OutCount: "u32"
    OutObj i: "Rc<dyn {Type i}>"
    OutSlice i: "[{Type i}]"
    OutPort i: "Port<{Type i}>"
    OutLive i: "Live<{Type i}>"
    OutUnknown what: "() /* {what} */"
    OutQuantified b: "compile_error!(\"{loweringRefusal}a quantified type variable of `{b}`: no instantiation gives it a type\")"

Types: unbounded fn [OutTy] -> Text
fn Types ts = Join (Each ts, \|t| Type t), ", "

RefTypes: unbounded fn [OutTy] -> Text
fn RefTypes ts = Join (Each ts, \|t| "&{Type t}"), ", "

# ---------------------------------------------------------------------------------------
# Expressions
# ---------------------------------------------------------------------------------------

# Whether an expression must be parenthesized as an operand or a receiver.
IsLoose: fn Ex -> Bool
fn IsLoose x = match x:
    XBlock [[]], inner: IsLoose inner
    XTyped inner, ignore: IsLoose inner
    XBin ignore, ignore, ignore: True
    XUnary ignore, ignore: True
    XClosure ignore, ignore, ignore: True
    XIf ignore, ignore, ignore: True
    XMatch ignore, ignore, ignore, ignore: True
    XChain ignore, ignore, ignore, ignore: True
    XCast ignore, ignore: True
    XRef ignore: True
    XRefMut ignore: True
    XDeref ignore: True
    otherwise: False

Tight: unbounded fn Ex -> Text
fn Tight x = if IsLoose x: "({Expression x})" else: Expression x

Operand: unbounded fn Ex -> Text
fn Operand x = match x:
    XBlock [[]], inner: Operand inner
    XTyped inner, ignore: Operand inner
    XBin ignore, ignore, ignore: "({Expression x})"
    XClosure ignore, ignore, ignore: "({Expression x})"
    XIf ignore, ignore, ignore: "({Expression x})"
    XCast ignore, ignore: "({Expression x})"
    otherwise: Expression x

Args: unbounded fn [Ex] -> Text
fn Args xs = Join (Each xs, \|x| Expression x), ", "

Expression: unbounded fn Ex -> Text
fn Expression x = match x:
    XVar n: n
    XPath p: p
    XSelf: "self"
    XCx: "cx"
    XConst n: "Self::{n}"
    XUnit: "()"
    XNone: "None"
    XBool b: if b: "true" else: "false"
    XNat d: if (Len d) <= 9: "Nat::from({d}u32)" else: "Nat::from_int(Int::from({d}i64)).unwrap()"
    XInt d: if (Len (if (Take d, 1) == "-": Drop d, 1 else: d)) <= 18: "Int::from({d})" else: "Int::from({d}i64)"
    XByte d: "{d}u8"
    XFloat d: d
    XIndex n: "{n}"
    XChar c: "'{CharEscape c}'"
    XStr t: "\"{Escape t}\""
    XRef y: "&{Operand y}"
    XRefMut y: "&mut {Operand y}"
    XDeref y: "*{Operand y}"
    XTarget y: "(*{Expression y})"
    XClone y: "{Tight y}.clone()"
    XWeak y: "Rc::downgrade({Expression y})"
    XUpgrade y: "{Tight y}.upgrade()"
    XBreak l, y: "break {Label l} {Expression y}"
    XBreakLoop: "break"
    XLater y: "Box::new(move |cx| \{ {Expression y}; Ok(()) \})"
    XFormatStr parts: FormatStr parts
    XIsCase y, [[]]: "false"
    XIsCase y, cs: "matches!({Expression y}, {Join (Each cs, \|c| "{c}(..)"), " | "})"
    XRefusal what: "compile_error!(\"{loweringRefusal}{Escape what}\")"
    XUnreachable: "unreachable!()"
    XCall f, args: "{f}({Args args})"
    XApply f, args: "{Tight f}({Args args})"
    XMethod r, m, args: "{Tight r}.{m}({Args args})"
    XBin op, l, r: "{Operand l} {op} {Operand r}"
    XUnary op, y: "{op}{Operand y}"
    XCtor p, args: "{p}({Args args})"
    XRecord p, fs: "{p} \{ {Join (Each fs, \|((f, v))| FieldInit f, v), ", "} \}"
    XTuple [[one]]: "({Expression one},)"
    XTuple xs: "({Args xs})"
    XVec xs: "vec![{Args xs}]"
    XText t: "Text::from(\"{Escape t}\")"
    XFormat parts: Format parts
    XMatch s, arms, fallback, ignore: Match (Expression s), (Arms arms, fallback)
    XChain label, s, arms, ignore: Chain (Label label), s, arms
    XIf c, t, e: IfExpression c, t, e
    XBlock [[]], e: Expression e
    XBlock dos, e: Block (Statements dos), (Expression e)
    XLabeled label, dos, e, ignore: Labeled (Label label), (Statements dos), (Expression e)
    XClosure mv, ps, body: "{if mv: "move " else: ""}|{Join (Each ps, \|p| Pattern p), ", "}| {Expression body}"
    XTry y, ignore: "{Tight y}?"
    XField r, f: "{Tight r}.{f}"
    XPart r, k: "{Tight r}.{k}"
    XDecode t, y: "{DecodeHead t}::from_pod({Expression y})?"
    XCast y, t: "{Tight y} as {Type t}"
    XTyped y, ignore: Expression y

FieldInit: unbounded fn Text, Ex -> Text
fn FieldInit f, (XVar v) = if v == f: f else: "{f}: {v}"
fn FieldInit f, v = "{f}: {Expression v}"

DecodeHead: unbounded fn OutTy -> Text
fn DecodeHead t = match t:
    OutNamed n, [[]]: n
    OutNat: "Nat"
    OutInt: "Int"
    OutText: "Text"
    otherwise: "<{Type t}>"

Label: fn Text -> Text
fn Label l = if (Take l, 1) == "'": l else: "'{l}"

# `Text::from(format!(..))`: the literal runs with their braces doubled, a `{}` per value.
Format: unbounded fn [Ex] -> Text
fn Format parts:
    let lit = Concat (Each parts, \|p| FormatPiece p)
    let vals = Filter parts, \|p| not (IsText p)
    if (Len vals) == 0: "Text::from(\"{lit}\")"
    else: "Text::from(format!(\"{lit}\", {Args vals}))"

# `format!(..)`, a message's text (a fault's), not a `Text`: a local is named in the
# literal, any other value placed by position.
FormatStr: unbounded fn [Ex] -> Text
fn FormatStr parts:
    let lit = Concat (Each parts, \|p| StrPiece p)
    let vals = Filter parts, \|p| not (IsText p) and not (IsVar p)
    if (Len vals) == 0: "\"{lit}\"" else: "format!(\"{lit}\", {Args vals})"

IsVar: fn Ex -> Bool
fn IsVar (XVar ignore) = True
fn IsVar other = False

StrPiece: fn Ex -> Text
fn StrPiece (XVar n) = "\{{n}\}"
fn StrPiece other = FormatPiece other

IsText: fn Ex -> Bool
fn IsText (XText ignore) = True
fn IsText other = False

FormatPiece: fn Ex -> Text
fn FormatPiece (XText t) = FormatEscape (Escape t)
fn FormatPiece other = "\{\}"

FormatEscape: fn Text -> Text
fn FormatEscape t = Concat (Each (Chars t), \|c| FormatEscapeChar c)

FormatEscapeChar: fn Text -> Text
fn FormatEscapeChar "\{" = "\{\{"
fn FormatEscapeChar "\}" = "\}\}"
fn FormatEscapeChar c = c

# `if c { a } else { b }` on one line when both sides are short.
IfExpression: unbounded fn Ex, Ex, Ex -> Text
fn IfExpression c, t, e:
    let ct = Expression c
    let tt = Expression t
    let et = Expression e
    let short = not (Contains "{tt}{et}", "\n") and (Len "{ct}{tt}{et}") < 70
    if short: "if {ct} \{ {tt} \} else \{ {et} \}" else: If ct, tt, et

# A `match`'s arms, guards joined; the fallback arm when a guard leaves the match open.
Arms: unbounded fn [XArm], Bool -> Text
fn Arms arms, fallback:
    let lines = Each arms, \|a| Arm a
    let all = if fallback: Push lines, "_ => unreachable!(\"no arm matched\")," else: lines
    Join all, "\n"

Arm: unbounded fn XArm -> Text
fn Arm a:
    let guard = if (Len a.conds) == 0: "" else: " if {Join (Each a.conds, \|c| Condition c), " && "}"
    let body = Expression a.body
    "{Pattern a.pat}{guard} => {body},"

Condition: unbounded fn Cc -> Text
fn Condition (CcIf x) = Operand x
fn Condition (CcLet p, x) = "let {Pattern p} = {Expression x}"

# An if-let chain over arms in a labelled block: each arm breaks with its value; a last arm
# that matches anything ends the block.
Chain: unbounded fn Text, Ex, [XArm] -> Text
fn Chain label, s, arms:
    let inPlace = match s:
        XRef y: IsBound y
        otherwise: IsBound s
    let ((bind, scrut)) = if inPlace: (([[]], Expression s)) else: (([["let scrutinee = {Expression s};"]], "scrutinee"))
    let n = Len arms
    let lines = Each (Range0 n), \|i|
        let a = Or arms[i], (XArm(pat=PaWild, conds=[[]], body=XUnit))
        let catchAll = (a.pat == PaWild) and (Len a.conds) == 0
        if catchAll: Expression a.body
        else:
            let head = Join (Append [["let {Pattern a.pat} = {scrut}"]], (Each a.conds, \|c| Condition c)), " && "
            ChainArm head, label, (Continued (Expression a.body), "    ")
    let ends = match ?Last arms:
        ? a: (a.pat == PaWild) and (Len a.conds) == 0
        nil: False
    let tail = if ends: [[]] else: [["unreachable!(\"no clause matched\")"]]
    "{label}: \{\n{Indent (Join (Append (Append bind, lines), tail), "\n")}\n\}"

# A place a name is bound to (a local, a field of the node, of the block through a row's
# parent, the element a `for &s` loop updates): a chain matches it where it stands.
IsBound: fn Ex -> Bool
fn IsBound x = match x:
    XVar ignore: True
    XField XSelf, ignore: True
    XField (XMethod (XUpgrade ignore), ignore, ignore), ignore: True
    XTarget ignore: True
    XPart (XVar ignore), ignore: True
    otherwise: False

# A text placed after other text on an indented line: its later lines take the indent.
Continued: fn Text, Text -> Text
fn Continued t, pad:
    let ls = Split t, "\n"
    Join (Each (Range0 (Len ls)), \|i| if i == 0 or (Or ls[i], "") == "": Or ls[i], "" else: "{pad}{Or ls[i], ""}"), "\n"

# A function's body: a block's statements and value without its braces.
BodyLines: unbounded fn Ex -> Text
fn BodyLines (XBlock dos, e) = if (Len dos) == 0: BodyLines e else: "{Statements dos}\n{BodyLines e}"
fn BodyLines x = Expression x

# Every line of a text four spaces in.
Indent: fn Text -> Text
fn Indent t = Join (Each (Split t, "\n"), \|l| if l == "": "" else: "    {l}"), "\n"

# ---------------------------------------------------------------------------------------
# Patterns and statements
# ---------------------------------------------------------------------------------------

Pattern: unbounded fn Pa -> Text
fn Pattern p = match p:
    PaWild: "_"
    PaBind n: n
    PaMut n: "mut {n}"
    PaCtor c, ps: "{c}({Join (Each ps, \|q| Pattern q), ", "})"
    PaUnit c: c
    PaRecord c, fs, rest:
        let parts = Each fs, \|((f, q))| match q:
            PaBind n: if n == f: f else: "{f}: {n}"
            otherwise: "{f}: {Pattern q}"
        let all = if rest: Push parts, ".." else: parts
        "{c} \{ {Join all, ", "} \}"
    PaTuple [[one]]: "({Pattern one},)"
    PaTuple ps: "({Join (Each ps, \|q| Pattern q), ", "})"
    PaChar c: "'{CharEscape c}'"
    PaBool b: if b: "true" else: "false"
    PaIndex n: "{n}"
    PaConst n: "Self::{n}"
    PaSlice ps: "[{Join (Each ps, \|q| Pattern q), ", "}]"
    PaRest "": ".."
    PaRest n: "{n} @ .."
    PaTyped q, t: "{Pattern q}: {Type t}"

Statements: unbounded fn [Do] -> Text
fn Statements dos = Join (Each dos, \|d| Statement d), "\n"

Statement: unbounded fn Do -> Text
fn Statement d = match d:
    DoLet p, x: "let {Pattern p} = {Expression x};"
    DoLetElse p, x, e: "let {Pattern p} = {Expression x} else \{ {Expression e} \};"
    DoAssign p, x: "{Expression p} = {Expression x};"
    DoWhile c, body: IfStmt "while {Expression c}", (Statements body)
    DoWhileLet p, x, body: IfStmt "while let {Pattern p} = {Expression x}", (Statements body)
    DoFor p, x, body: IfStmt "for {Pattern p} in {Expression x}", (Statements body)
    DoExpr x: "{Expression x};"
    DoIf c, t, e: "{IfStmt "if {Expression c}", (Statements t)}{ElseBranch e}"
    DoIfLet p, x, t, e: "{IfStmt "if let {Pattern p} = {Expression x}", (Statements t)}{ElseBranch e}"
    DoMatch x, cases: Match (Expression x), (Join (Each cases, \|((p, body))| ArmBlock (Pattern p), (Statements body)), "\n")
    DoReturn x: "return {Expression x};"
    DoScope body: "\{ {InlineStatements body} \};"
    DoLine body: "{InlineStatements body};"
    DoNote t: "// {t}"

# Statements on one line (`DoScope`, `DoLine`).
InlineStatements: unbounded fn [Do] -> Text
fn InlineStatements dos = Join (Each dos, \|d| InlineStatement d), " "

InlineStatement: unbounded fn Do -> Text
fn InlineStatement (DoIf c, t, [[]]) = "if {Expression c} \{ {InlineStatements t} \}"
fn InlineStatement d = Statement d

# An `else`, `else if` for a lone `if` inside.
ElseBranch: unbounded fn [Do] -> Text
fn ElseBranch [[]] = ""
fn ElseBranch [[(DoIf c, t, e)]] = " else {Statement (DoIf c, t, e)}"
fn ElseBranch [[(DoIfLet p, x, t, e)]] = " else {Statement (DoIfLet p, x, t, e)}"
fn ElseBranch body = Else (Statements body)

# ---------------------------------------------------------------------------------------
# Items
# ---------------------------------------------------------------------------------------

Generics: fn [((Text, [Text]))] -> Text
fn Generics [[]] = ""
fn Generics gs = "<{Join (Each gs, \|((g, bs))| if (Len bs) == 0: g else: "{g}: {Join bs, " + "}"), ", "}>"

GenericNames: fn [Text] -> Text
fn GenericNames [[]] = ""
fn GenericNames ps = "<{Join ps, ", "}>"

Bounded: fn [Text], Text -> Text
fn Bounded [[]], ignore = ""
fn Bounded ps, tr = "<{Join (Each ps, \|p| "{p}: {tr}"), ", "}>"

RustItem: unbounded fn Item -> Text
fn RustItem it = match it:
    ItTrait t: RustTrait t
    ItImpl i: RustImpl i
    ItType t: TypeDecl t
    ItTag t: RustTag t
    ItRow r: RustRow r
    ItFn f: RustFn f
    ItJob j: RustJob j
    ItNode n: RustNode n
    ItNote t: "// {t}\n"
    ItRefused t: "compile_error!(\"{loweringRefusal}{Escape t}\");\n"

RustTrait: unbounded fn TraitDef -> Text
fn RustTrait t:
    let ms = Join (Each t.methods, \|f| TraitMethod f), "\n"
    "{SourceDoc "", t.doc}pub trait {t.name} \{\n{Indent ms}\n\}\n"

Signature: unbounded fn FnDef, Text -> Text
fn Signature f, vis:
    let params = Join (Each f.params, \|((n, t))| "{n}: {Type t}"), ", "
    "{vis}fn {f.name}{Generics f.generics}({params}) -> {Type f.ret}"

TraitMethod: unbounded fn FnDef -> Text
fn TraitMethod f = if f.public: Fn "", (Signature f, ""), (BodyLines f.body) else: "{Signature f, ""};"

# An impl: a program's trait's methods inside it; `^Show`, `^Eq` and `^Ord` as Rust's
# traits over the method, a function of its own.
RustImpl: unbounded fn ImplDef -> Text
fn RustImpl i:
    let head = Type i.head
    let gens = Generics i.generics
    match i.cls:
        "Prelude.Show":
            let fns = Join (Each i.methods, \|f| RustFn f), "\n"
            let shown = Or (Each i.methods, \|f| f.name)[0], "show"
            "{fns}\n{Impl gens, "Show", head, "fn show(&self, p: &mut Printer)", "p.raw(&{shown}(self).to_string());"}"
        "Prelude.Eq":
            let fns = Join (Each i.methods, \|f| RustFn f), "\n"
            let eq = Fold i.methods, "", \|acc, f| if (Take f.name, 2) != "ne" and acc == "": f.name else: acc
            "{fns}\n{Impl gens, "PartialEq", head, "fn eq(&self, other: &Self) -> bool", "{eq}(self, other)"}"
        otherwise: "impl{gens} {i.tr} for {head} \{\n{Indent (Join (Each i.methods, \|f| Fn "", (Signature f, ""), (BodyLines f.body)), "\n")}\n\}\n"

RustFn: unbounded fn FnDef -> Text
fn RustFn f:
    let params = Join (Each f.params, \|((n, t))| "{n}: {Type t}"), ", "
    # A function may build a job or a closure over its type parameters, which then live
    # as long as the program (every Prism type does).
    let sig = "pub fn {f.name}{StaticGenerics f.generics}({params}) -> {Type f.ret}"
    Fn (SourceDoc "", f.doc), sig, (BodyLines f.body)

StaticGenerics: fn [((Text, [Text]))] -> Text
fn StaticGenerics gs = Generics (Each gs, \|((g, bs))| ((g, (Push bs, "'static"))))

RustJob: unbounded fn JobDef -> Text
fn RustJob j:
    let gnames = GenericNames (Each j.generics, \|((g, ignore))| g)
    # Public: a tail call from another module builds the job by its fields.
    let fields = Join (Each j.fields, \|((n, t))| "pub {n}: {Type t},"), "\n"
    let params = Join (Each j.fields, \|((n, t))| "{n}: {Type t}"), ", "
    # A job is an `Rc<dyn Job>`, so its type parameters live as long as the program.
    let bounded = StaticGenerics j.generics
    let start = "pub fn {j.start}{bounded}({params}) -> Rc<dyn prism_rtl::Job<{Type j.ret}>>"
    let startBody = "Rc::new({j.name} \{ {Join (Each j.fields, \|((n, ignore))| n), ", "} \})"
    Job (SourceDoc "", j.doc), j.name, gnames, bounded, fields, (Type j.ret), (BodyLines j.body), start, startBody

# A type, its derives, and its printer and plain-data impls (docs/backend.md, "Printing").
TypeDecl: unbounded fn TyDef -> Text
fn TypeDecl t:
    let eq = t.eq and not t.floaty
    let ord = t.ord and not t.floaty
    let derives = Join (Filter [["Clone", (if t.eq or t.ord: "PartialEq" else: ""), (if eq or ord: "Eq" else: ""), (if t.ord: "PartialOrd" else: ""), (if ord: "Ord" else: "")]], \|d| d != ""), ", "
    let head = "{t.name}{GenericNames t.params}"
    let doc = SourceDoc "`{t.prism}`:", t.doc
    let decl = match t.shape:
        ShapeRecord:
            let c = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]]))
            Struct doc, derives, head, (Join (Each c.fields, \|((f, ft))| "pub {f}: {Type ft},"), "\n")
        ShapeUnit: TupleStruct doc, derives, head, ""
        ShapeNewtype:
            let c = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]]))
            TupleStruct doc, derives, head, "({Join (Each c.fields, \|((ignore, ft))| "pub {Type ft}"), ", "})"
        otherwise: Enum doc, derives, head, (Join (Each t.cases, \|c| EnumCase c), "\n")
    let show = if t.show == ShownDerived: "\n{ShowImpl t, head}" else: ""
    let pod = if t.pod: "\n{ToPodImpl t, head}\n{FromPodImpl t, head}" else: ""
    "{decl}{show}{pod}"

EnumCase: unbounded fn CaseDef -> Text
fn EnumCase c = if (Len c.fields) == 0: "{c.name}," else: "{c.name}({Join (Each c.fields, \|((ignore, ft))| Type ft), ", "}),"

# The bound variables of a case, `a0, a1`.
Binders: fn Nat -> [Text]
fn Binders n = Each (Range0 n), \|i| "a{i}"

CasePattern: fn TyDef, CaseDef -> Text
fn CasePattern t, c = match t.shape:
    ShapeNewtype: "{t.name}({Join (Binders (Len c.fields)), ", "})"
    ShapeUnit: t.name
    otherwise: if (Len c.fields) == 0: "{t.name}::{c.name}" else: "{t.name}::{c.name}({Join (Binders (Len c.fields)), ", "})"

# `derive ^Show`: one printer call per constructor; the printer decides the parentheses.
ShowImpl: unbounded fn TyDef, Text -> Text
fn ShowImpl t, head:
    let body = match t.shape:
        ShapeRecord:
            let c = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]]))
            "p.record(\"{t.prism}\", &[{Join (Each c.fields, \|((f, ignore))| "(\"{PrismField f}\", &self.{f})"), ", "}]);"
        otherwise: MatchSelf (Join (Each t.cases, \|c| "{CasePattern t, c} => p.choice(\"{c.prism}\", &[{Join (Binders (Len c.fields)), ", "}]),"), "\n")
    Impl (Bounded t.params, "Show"), "Show", head, "fn show(&self, p: &mut Printer)", body

# A field's Prism spelling: the Rust one without the `_` a keyword took.
PrismField: fn Text -> Text
fn PrismField f = if (Drop f, (Dec (Len f))) == "_": Take f, (Dec (Len f)) else: f

ToPodImpl: unbounded fn TyDef, Text -> Text
fn ToPodImpl t, head:
    let body = match t.shape:
        ShapeRecord:
            let c = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]]))
            "Pod::record(\"{t.prism}\", vec![{Join (Each c.fields, \|((f, ignore))| "(\"{PrismField f}\", self.{f}.to_pod())"), ", "}])"
        otherwise: MatchSelf (Join (Each t.cases, \|c| "{CasePattern t, c} => Pod::Choice(\"{c.prism}\".into(), vec![{Join (Each (Binders (Len c.fields)), \|b| "{b}.to_pod()"), ", "}]),"), "\n")
    let shown = if t.show == ShownOwn: ShownPod body else: body
    Impl (Bounded t.params, "ToPod"), "ToPod", head, "fn to_pod(&self) -> Pod", shown

FromPodImpl: unbounded fn TyDef, Text -> Text
fn FromPodImpl t, head:
    let body = match t.shape:
        ShapeRecord:
            let c = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]]))
            "Ok({t.name} \{ {Join (Each c.fields, \|((f, ignore))| "{f}: FromPod::from_pod(field(p, \"{PrismField f}\")?)?"), ", "} \})"
        otherwise:
            let arms = Each t.cases, \|c|
                let n = Len c.fields
                let made = if n == 0: (if t.shape == ShapeUnit: t.name else: "{t.name}::{c.name}") else: "{if t.shape == ShapeNewtype: t.name else: "{t.name}::{c.name}"}({Join (Each (Range0 n), \|i| "FromPod::from_pod(&a[{i}])?"), ", "})"
                "Pod::Choice(c, a) if &**c == \"{c.prism}\" && a.len() == {n} => Ok({made}),"
            FromPodBody (Join arms, "\n"), "a {t.prism}"
    Impl (Bounded t.params, "FromPod"), "FromPod", head, "fn from_pod(p: &Pod) -> Result<Self, Fault>", body

RustTag: unbounded fn TagDef -> Text
fn RustTag t:
    let fields = Join (Each t.fields, \|((ignore, f, ft))| "pub {f}: {Type ft},"), "\n"
    let pods = Join (Each t.fields, \|((p, f, ignore))| "(\"{p}\", self.{f}.to_pod())"), ", "
    let derives = if t.pod: "Clone, PartialEq" else: "Clone"
    let reads = Join (Each t.fields, \|((p, f, ignore))| "{f}: FromPod::from_pod(field(p, \"{p}\")?)?"), ", "
    let back = if t.pod: "\n{TagFromPod t.name, t.tagName, reads}" else: ""
    "{Tag (SourceDoc "The `Level` of `{t.tagName}`:", t.doc), derives, t.name, fields, t.tagName, pods}{back}"

# A row kind's enum (pick RV): a variant per tag, printing and crossing as the tag's level.
RustRow: unbounded fn RowDef -> Text
fn RustRow r:
    let derives = if r.pod: "Clone, PartialEq" else: "Clone"
    let cases = Join (Each r.cases, \|((v, st))| "{v}({st}),"), "\n"
    let pods = Join (Each r.cases, \|((v, ignore))| "{r.name}::{v}(x) => x.to_pod(),"), "\n"
    let reads = Join (Each r.cases, \|((v, st))| "Some(t) if t == {st}::TAG => Ok({r.name}::{v}(FromPod::from_pod(p)?)),"), "\n"
    let back = if r.pod: "\n{RowFromPod r.name, reads}" else: ""
    # An empty row's enum has no values: its match is over `*self`, with no arms.
    let pods2 = if (Len r.cases) == 0: "_ => unreachable!()," else: pods
    "{Row (SourceDoc "`{r.prism}`, a row kind's values:", r.doc), derives, r.name, cases, pods2}{back}"

# `crate::Answer` (pick HO): a variant per element tag with the tag's output; an accessor
# per variant; the decode of a World's answer by the element's tag. With no element tag the
# enum is empty, and its matches are over the value, which has none.
RustAnswer: unbounded fn AnswerDef -> Text
fn RustAnswer a:
    let cases = Join (Each a.cases, \|c| "{c.variant}({Type c.ty}),"), "\n"
    let tags = if (Len a.cases) == 0: "_ => unreachable!()," else: Join (Each a.cases, \|c| "Answer::{c.variant}(_) => {c.structPath}::TAG,"), "\n"
    let accessors = Join (Each a.cases, \|c| AnswerGetter c.accessor, c.variant, c.tagName, (Type c.ty)), "\n"
    let decodes = if (Len a.cases) == 0: "_ => unreachable!()," else: Join (Each a.cases, \|c| "Elem::{c.variant}(..) => Ok(Answer::{c.variant}({DecodeHead c.ty}::from_pod(v)?)),"), "\n"
    AnswerType cases, tags, accessors, decodes

# ---------------------------------------------------------------------------------------
# Nodes and programs
# ---------------------------------------------------------------------------------------

RustNode: unbounded fn NodeDef -> Text
fn RustNode n:
    let fields = Join (Each n.fields, \|((f, t, doc))| "{Doc doc}{f}: {Type t},"), "\n"
    let consts = Concat (Each n.consts, \|((c, h, doc))| "{Doc "The {doc}."}const {c}: u32 = {h};\n")
    let params = Concat (Each n.params, \|((p, t))| "{p}: {Type t}, ")
    let ret = if n.fallible: "Result<Rc<{n.name}>, Fault>" else: "Rc<{n.name}>"
    let inits = Join (Append [["path"]], (Each n.inits, \|((f, v))| FieldInit f, v)), ", "
    let tail = if n.fallible: "Ok(node)" else: "node"
    let restText = if (Len n.build) == 0: tail else: "{Statements n.build}\n{tail}"
    let build = Build n.name, params, ret, (Statements n.lets), inits, restText
    let methods = Join (Each n.methods, \|m| RustMethod m), "\n"
    let answer = if (Len n.answers) == 0: "" else: Answer (Join (Each n.answers, \|((pat, call))| "{Pattern pat} => {Expression call},"), "\n")
    let builders = Concat (Append (Each n.builders, \|b| "\n{ForBuilder b}"), (Each n.gens, \|gd| "\n{GenBuilder gd}"))
    let rowImpl = if n.rowKind == NotARow: "" else: "\n{RustRowImpl n}"
    let hooks = Join (Each n.hooks, \|((h, body))| if h == "push": PushHook (Statements body) else: Hook h, (Statements body)), "\n"
    let doc = SourceDoc "`{n.prism}`: a node of its own (docs/backend.md, \"A widget block\").", n.doc
    "{Node doc, n.name, fields, consts, build, "{methods}{builders}", hooks, answer}{rowImpl}"

# A `for`'s builder: rows that left torn down, new keys built.
ForBuilder: unbounded fn ForDef -> Text
fn ForBuilder b = ForBuild b.name, (Expression b.at), (Type b.keyTy), (Type b.valueTy), b.rowNode, b.source, (Expression b.parent), (Concat (Each b.passed, \|x| ", {Expression x}"))

# A `rebuild`'s builder: the old generation torn down, the next one built.
GenBuilder: unbounded fn GenDef -> Text
fn GenBuilder gd:
    # a transparent generation (a widget of several clauses in a static position) stands at
    # its caller's path
    let path = if gd.transparent: "self.path.clone()" else: "{Expression gd.at}.child(Segment::Gen(g))"
    GenBuild gd.name, (Expression gd.at), path, (Expression gd.source), (Type gd.valueTy), (Expression gd.select)

# A row's leaving (prelude `Row`): a `for` row keeps its entry as the tick opened, since
# its key is gone from the source after it (R8); its places are torn down; its
# subscriptions let go. A hosted row's `Row` methods beside it.
RustRowImpl: unbounded fn NodeDef -> Text
fn RustRowImpl n:
    let kept = if n.rowKind == ForRow: [["*self.left_entry.borrow_mut() = Some(self.entry(cx));"]] else: [[]]
    let unsubscribe = Each n.subs, \|((ev, m, ignore))| "if let (Some(p), Some(h)) = (self.parent.upgrade(), self.{m}_sub.take()) \{\n    p.{ev}_port.unsubscribe(h);\n\}"
    RowImpl n.name, (Join (Append (Push kept, "self.remove_places(cx);"), unsubscribe), "\n"), (Join (Each n.hosted, \|m| RustMethod m), "\n")

RustMethod: unbounded fn MethDef -> Text
fn RustMethod m:
    let recv = match m.recv:
        RecvRc: "self: &Rc<Self>"
        RecvRef: "&self"
        RecvOwned: "self: Rc<Self>"
    let cx = match m.cx:
        CxMut: ", cx: &mut Cx"
        CxRef: ", cx: &Cx"
        CxNone: ""
    let params = Concat (Each m.params, \|((p, t))| ", {p}: {Type t}")
    let ret = if m.ret == OutUnit: "" else: " -> {Type m.ret}"
    let sig = "fn {m.name}({recv}{params}{cx}){ret}"
    let body = if m.ret == OutUnit: Statements m.body else: if (Len m.body) == 0: BodyLines m.tail else: "{Statements m.body}\n{BodyLines m.tail}"
    Method (Doc m.doc), sig, body

RustProgram: unbounded fn ProgDef, Bool -> Text
fn RustProgram p, fallible:
    let n = Len p.params
    let names = Each p.params, \|((a, ignore))| a
    let decode = if n == 0: "let _ = args;" else: DecodeArgs p, names
    let call = "{p.node}::build(Path::root(), {Concat (Each names, \|a| "{a}, ")}&mut cx){if fallible: "?" else: ""}"
    Program p.name, p.prism, p.node, decode, call

DecodeArgs: unbounded fn ProgDef, [Text] -> Text
fn DecodeArgs p, names:
    let n = Len names
    let plural = if n == 1: "" else: "s"
    let head = "let [{Join names, ", "}] = args else \{ return Err(Fault::answer(\"@{p.prism} takes {n} argument{plural}\")) \};"
    Join (Append [[head]], (Each p.params, \|((a, t))| "let {a} = {DecodeHead t}::from_pod({a})?;")), "\n"

# ---------------------------------------------------------------------------------------
# The crate
# ---------------------------------------------------------------------------------------

RustModule: unbounded fn ModDef -> Text
fn RustModule m:
    let uses = if (Len m.uses) == 0: "" else: "#[allow(unused_imports)]\nuse crate::\{{Join m.uses, ", "}\};"
    Module (if m.prism == "": "The root module" else: "The module `{m.prism}`"), m.path, uses, (Join (Each m.items, \|it| RustItem it), "\n")

# Whether a node is built fallibly: the program's `?`.
NodeFallible: fn Model, Text -> Bool
fn NodeFallible model, path = Fold model.mods, False, \|f, m| Fold m.items, f, \|f2, it| match it:
    ItNode n: f2 or ("{m.name}::{n.name}" == path and n.fallible)
    otherwise: f2

# The crate's files: path and text.
EmitCrate: unbounded fn Model, Text, [Text] -> [((Text, Text))]
fn EmitCrate model, runtime, scripts:
    let gui = match model.?root:
        ? r: r.world == "canvas"
        nil: False
    let cargo = Cargo model.name, runtime, (if gui: "\"canvas\"" else: "")
    let mods = Concat (Each model.mods, \|m| "mod {m.name};\n")
    let programs = Join (Each (AllPrograms model), \|p| RustProgram p, (NodeFallible model, p.node)), "\n"
    let regs = Concat (Each model.programs, \|p| ".program::<{p.name}>(\"{p.prism}\")\n")
    let checks = Concat (Each model.checks, \|c| ".check(\"{c.name}\", || vec![{Join (Each c.lines, \|l| Expression l), ", "}])\n")
    let scriptList = Concat (Each scripts, \|s| "\"{Escape s}\",\n")
    let runRoot = match model.?root:
        ? r: RunRoot r.name
        nil: NoRoot model.name
    let world = match model.?root:
        ? r: r.world
        nil: "test"
    let main = Main model.name, "mod prelude;\n{mods}", "{RustRow model.elem}\n{RustAnswer model.answer}\n{programs}", "{regs}{checks}", scriptList, runRoot, world
    let files = Each model.mods, \|m| (("src/{m.name}.rs", (RustModule m)))
    Append [[(("Cargo.toml", cargo)), (("src/main.rs", main)), (("src/prelude.rs", (PreludeSource "")))]], files

# Every program, the root's among them, once.
AllPrograms: fn Model -> [ProgDef]
fn AllPrograms model = match model.?root:
    ? r: if Fold model.programs, False, \|f, p| f or p.name == r.name: model.programs else: Push model.programs, r
    nil: model.programs
