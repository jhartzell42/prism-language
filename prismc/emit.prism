# Emission: the core form (lower.prism) spelled as Rust through the template set
# (templates/rust.prism; Templates ch. 2, Compiler ch. 4). One Rust module per Prism
# module, one getter per declaration, one Rust `fn` per Prism function, a `main` that
# installs the program's tables and runs the root under the World `--world` names, and a
# `Cargo.toml` (decisions.md D1, D16).
#
# Every nested function (a lambda's body, a `match`'s arms, a widget block) is a Rust `fn`
# item, hoisted to the top of the Rust function it stands in, so that the expression
# where it is used stays on one line: `function("Lexer.lam312", "lambda", &[V], &[],
# false, lam_312, vec![l_c.clone()])`. Emission decides nothing: lowering did.
#
# Written by Claude, 31 October 2026, on the claude-self-hosting branch. Subject to change:
# Jimmy rewrites it by hand, and an implementer reading it uses their own discretion.
module Emit
emit r
use Ast.*
use Lexer.*
use Parser.*
use Lower.*
use RustTemplates.*

# A piece of Rust: the `fn` items it needs hoisted, and its code.
type ZRs = record:
    items: [Text]
    code: Text
derive ^Eq, ^Show

ZjCode: fn Text -> ZRs
fn ZjCode t = ZRs(items=[[]], code=t)

ZjLines: fn [Text] -> Text
fn ZjLines ls = Join (Filter ls, \|l| l != ""), "\n"

ZjItems: fn [ZRs] -> [Text]
fn ZjItems rs = Fold rs, [[]], \|acc, r| Append acc, r.items

ZjCodes: fn [ZRs] -> Text
fn ZjCodes rs = Join (Each rs, \|r| r.code), ", "

# ---------------------------------------------------------------------------------------
# Literals
# ---------------------------------------------------------------------------------------

ZjReplace: fn Text, Text, Text -> Text
fn ZjReplace t, a, b = Join (Split t, a), b

# A text as the inside of a Rust string literal.
ZjEscape: fn Text -> Text
fn ZjEscape t = ZjReplace (ZjReplace (ZjReplace (ZjReplace (ZjReplace (ZjReplace t, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n"), "\t", "\\t"), "\u{d}", "\\r"), "\u{0}", "\\0"

ZjStr: fn Text -> Text
fn ZjStr t = "\"{ZjEscape t}\""

ZjChar: fn Text -> Text
fn ZjChar "'" = "'\\''"
fn ZjChar "\\" = "'\\\\'"
fn ZjChar "\n" = "'\\n'"
fn ZjChar "\t" = "'\\t'"
fn ZjChar "\u{d}" = "'\\r'"
fn ZjChar "\u{0}" = "'\\0'"
fn ZjChar c = "'{c}'"

ZjInt: fn Text -> Text
fn ZjInt s:
    let digits = Concat (Filter (Chars s), \|c| c != "_")
    let body = if (Take digits, 1) == "-": Drop digits, 1 else: digits
    if (Len body) > 0 and (Len body) <= 17 and (AllChars body, IsDigit): "small({digits})" else: "int({ZjStr digits})"

ZjFloat: fn Text -> Text
fn ZjFloat s = if (Contains s, ".") or (Contains s, "e") or (Contains s, "E"): "float({s})" else: "float({s}.0)"

ZjLayers: fn [Text] -> Text
fn ZjLayers ls = "&[{Join ls, ", "}]"

ZjNats: fn [Bool] -> Text
fn ZjNats ns = "&[{Join (Each ns, \|n| if n: "true" else: "false"), ", "}]"

ZjBool: fn Bool -> Text
fn ZjBool True = "true"
fn ZjBool False = "false"

ZjOptStr: fn ?Text -> Text
fn ZjOptStr nil = "None"
fn ZjOptStr (? t) = "Some({ZjStr t})"

ZjStrs: fn [Text] -> Text
fn ZjStrs ts = "&[{Join (Each ts, ZjStr), ", "}]"

# ---------------------------------------------------------------------------------------
# Expressions: each one line of Rust of type `Value`, its nested functions hoisted
# ---------------------------------------------------------------------------------------

ZjX: fn ZExpr -> ZRs
fn ZjX (ZLocal rs) = ZjCode "{rs}.clone()"
fn ZjX (ZGlobal path) = ZjCode "{path}()?"
fn ZjX (ZInt s) = ZjCode (ZjInt s)
fn ZjX (ZFloat s) = ZjCode (ZjFloat s)
fn ZjX (ZText s) = ZjCode "text({ZjStr s})"
fn ZjX (ZChar c) = ZjCode "ch({ZjChar c})"
fn ZjX (ZDuration n) = ZjCode "duration({n})"
fn ZjX (ZBool v) = ZjCode "boolean({ZjBool v})"
fn ZjX ZUnit = ZjCode "unit()"
fn ZjX ZNil = ZjCode "nil()"
fn ZjX ZNever = ZjCode "never(b)"
fn ZjX (ZTag t) = ZjCode "tag({ZjStr t})?"
fn ZjX (ZQualBuiltin n) = if (Take n, 1) == "@": ZjCode "builtin_value({ZjStr n})?" else: ZjCode "builtin({ZjStr n}, {ZjStr n}, &[], &[])"
fn ZjX (ZApply f, args) = ZjCall "apply", (Append [[ZjRef f]], [[ZjVec args]])
fn ZjX (ZApplyNamed f, args):
    let vals = Each args, \|a| ZjX a.value
    let named = Each (ZjZip args, vals), \|((a, v))| "({ZjOptStr a.name}, {v.code})"
    let fr = ZjX f
    ZRs(items=(Append fr.items, (ZjItems vals)), code="apply_named(&{fr.code}, vec![{Join named, ", "}], b)?")
fn ZjX (ZApplyWith f, args, over):
    let fr = ZjX f
    let ar = ZjVec args
    let os = Each over, \|o| if o == "": "None" else: "Some({o})"
    ZRs(items=(Append fr.items, ar.items), code="apply_with(&{fr.code}, {ar.code}, &[{Join os, ", "}], b)?")
fn ZjX (ZElement t, args):
    let vals = Each args, \|a| ZjX a.value
    let named = Each (ZjZip args, vals), \|((a, v))| "({ZjOptStr a.name}, {v.code})"
    ZRs(items=(ZjItems vals), code="element({ZjStr t}, vec![{Join named, ", "}])?")
fn ZjX (ZBin op, x, y) = ZjCall "binop", [[ZjCode "Op::{op}", ZjX x, ZjX y]]
fn ZjX (ZAndOr op, x, y):
    let xr = ZjX x
    let yr = ZjX y
    ZRs(items=(Append xr.items, yr.items), code="and_or(Op::{op}, {xr.code}, |b| Ok({yr.code}), b)?")
fn ZjX (ZOn x, e) = ZjCall "on", [[ZjX x, ZjX e]]
fn ZjX (ZMerge x, y) = ZjCall "merge", [[ZjX x, ZjX y]]
fn ZjX (ZUn op, x) = ZjCall "unop", [[ZjCode "UnOp::{op}", ZjX x]]
fn ZjX (ZField r, n) = ZjCall "field", [[ZjX r, ZjCode (ZjStr n)]]
fn ZjX (ZIndex r, k) = ZjCall "index", [[ZjX r, ZjX k]]
fn ZjX (ZSome x) = ZjCall "some", [[ZjX x]]
fn ZjX (ZOk x) = ZjCall "okay", [[ZjX x]]
fn ZjX (ZConst x):
    let xr = ZjX x
    ZRs(items=xr.items, code="constant({xr.code}, b)")
fn ZjX (ZTuple xs):
    let v = ZjVec xs
    ZRs(items=v.items, code="tuple({v.code})")
fn ZjX (ZArray xs):
    let v = ZjVec xs
    ZRs(items=v.items, code="array({v.code})")
fn ZjX (ZMap xs) = ZjCall "map", [[ZjVec xs]]
fn ZjX (ZInterp parts, vals):
    let ps = Each parts, ZjOptStr
    let v = ZjVec vals
    ZRs(items=v.items, code="interpolate(&[{Join ps, ", "}], {v.code}, b)?")
fn ZjX (ZFn f) = ZjFunc f
fn ZjX (ZBlueprint bd) = ZjBuildValue bd
fn ZjX (ZBranch arms) = ZjBranch arms, (ZjX arms.scrutinee)
fn ZjX (ZBuildBranch bb) = ZjBuilding bb
fn ZjX (ZBlock stmts, value):
    let ss = ZjStmts stmts
    let vr = ZjX value
    if (Len stmts) == 0: vr
    else: ZRs(items=(Append ss.items, vr.items), code=(RsBlock ss.code, vr.code))
fn ZjX (ZGiven fallible, steps) = ZjGiven fallible, steps
fn ZjX (ZUpdate root, target, ups):
    let tr = ZjX target
    let us = ZjUpds ups
    ZRs(items=(Append tr.items, us.items), code=(RsUpdate root, tr.code, us.code))
fn ZjX (ZTemplate parts):
    let p = ZjParts parts
    ZRs(items=p.items, code="text(&{p.code})")
fn ZjX (ZRebuild src, kind, bd):
    let sr = ZjX src
    let br = ZjBuildValue bd
    ZRs(items=(Append sr.items, br.items), code="rebuild({sr.code}, ResultKind::{kind}, {br.code}, b)?")
fn ZjX (ZFor src, kind, bd):
    let sr = ZjX src
    let br = ZjBuildValue bd
    ZRs(items=(Append sr.items, br.items), code="for_each({sr.code}, ResultKind::{kind}, {br.code}, b)?")
fn ZjX (ZBindBuild x) = ZjCall "bind_build", [[ZjX x]]
fn ZjX (ZRead root, steps):
    let st = ZjSteps steps
    ZRs(items=st.items, code="lens::read_element(&{root}, &[{st.code}])?")
fn ZjX (ZFault msg) = ZjCode "fail({ZjStr msg})?"

ZjZip: fn [a], [b] -> [((a, b))]
fn ZjZip xs, ys:
    let ((ignore, out)) = Fold xs, ((0, [[]])), \|((i, acc)), x| match ys[i]:
        ? y: ((i + 1, (Push acc, ((x, y)))))
        nil: ((i + 1, acc))
    out

# `&{f}`: a function value borrowed for an application.
ZjRef: fn ZExpr -> ZRs
fn ZjRef f:
    let r = ZjX f
    ZRs(items=r.items, code="&{r.code}")

ZjVec: fn [ZExpr] -> ZRs
fn ZjVec xs:
    let rs = Each xs, ZjX
    ZRs(items=(ZjItems rs), code="vec![{ZjCodes rs}]")

# `name(args.., b)?`
ZjCall: fn Text, [ZRs] -> ZRs
fn ZjCall name, args = ZRs(items=(ZjItems args), code="{name}({ZjCodes args}, b)?")

ZjSteps: fn [ZStep] -> ZRs
fn ZjSteps steps:
    let rs = Each steps, \|s| match s:
        ZField1 n: ZjCode "step({ZjStr n})"
        ZIndex1 k:
            let kr = ZjX k
            ZRs(items=kr.items, code="at_key({kr.code})")
    ZRs(items=(ZjItems rs), code=(ZjCodes rs))

# ---------------------------------------------------------------------------------------
# Patterns: `let`-else steps over a subject, failing to `fail`
# ---------------------------------------------------------------------------------------

ZjPat: fn ZPat, Text, Text, Text, [Text] -> [Text]
fn ZjPat ZpIgnore, subj, fail, v, muts = [[]]
fn ZjPat (ZpBind rs), subj, fail, v, muts = [["{ZjMut rs, muts}{rs} = {subj}.clone();"]]
fn ZjPat (ZpBool x), subj, fail, v, muts = [[(RsTest "pat::is_bool(&{subj}, {ZjBool x})", fail)]]
fn ZjPat ZpUnit, subj, fail, v, muts = [[(RsTest "pat::is_unit(&{subj})", fail)]]
fn ZjPat ZpNil, subj, fail, v, muts = [[(RsTest "pat::is_nil(&{subj})", fail)]]
fn ZjPat (ZpInt s), subj, fail, v, muts = [[(RsTest "pat_int(&{subj}, {ZjStr s})", fail)]]
fn ZjPat (ZpChar c), subj, fail, v, muts = [[(RsTest "pat::char(&{subj}, {ZjChar c})", fail)]]
fn ZjPat (ZpText t), subj, fail, v, muts = [[(RsTest "pat::text(&{subj}, {ZjStr t})", fail)]]
fn ZjPat (ZpFloat f), subj, fail, v, muts = [[(RsTest "pat::float(&{subj}, {f})", fail)]]
fn ZjPat ZpNever, subj, fail, v, muts = [[fail]]
fn ZjPat (ZpCtorName n), subj, fail, v, muts = [[(RsTest "pat::is_ctor(&{subj}, {ZjStr n})", fail)]]
fn ZjPat (ZpTagName n), subj, fail, v, muts = [[(RsTest "pat::is_tag(&{subj}, {ZjStr n})", fail)]]
fn ZjPat (ZpFamily f), subj, fail, v, muts = [[(RsTest "pat::family(&{subj}, {ZjStr f})", fail)]]
fn ZjPat (ZpCtor base, full, args), subj, fail, v, muts = ZjParts1 "pat::ctor(&{subj}, {ZjStr base}, {ZjOptStr full}, {Len args})", args, fail, v, muts
fn ZjPat (ZpRecord full, base, names, rest, ps), subj, fail, v, muts = ZjParts1 "pat::record(&{subj}, {ZjStr full}, {ZjStr base}, &[{Join (Each names, ZjOptStr), ", "}], {ZjBool rest})", ps, fail, v, muts
fn ZjPat (ZpTuple ps), subj, fail, v, muts = ZjParts1 "pat::tuple(&{subj}, {Len ps})", ps, fail, v, muts
fn ZjPat (ZpArray ps), subj, fail, v, muts = ZjParts1 "pat::array(&{subj}, {Len ps})", ps, fail, v, muts
fn ZjPat (ZpSome p), subj, fail, v, muts = Append [[(RsLetElse v, "pat::some(&{subj})", fail)]], (ZjPat p, v, fail, "{v}_0", muts)
fn ZjPat (ZpOk p), subj, fail, v, muts = Append [[(RsLetElse v, "pat::ok(&{subj})", fail)]], (ZjPat p, v, fail, "{v}_0", muts)

ZjMut: fn Text, [Text] -> Text
fn ZjMut rs, muts = if (Fold muts, False, \|q, m| q or m == rs): "let mut " else: "let "

# A pattern with parts: the parts taken, each part's pattern on it.
ZjParts1: fn Text, [ZPat], Text, Text, [Text] -> [Text]
fn ZjParts1 probe, ps, fail, v, muts:
    let anyPart = Fold ps, False, \|q, p| q or p != ZpIgnore
    let head = if anyPart: RsLetElse v, probe, fail else: RsLetElse "_", probe, fail
    let ((ignore, rest)) = Fold ps, ((0, [[]])), \|((i, acc)), p| ((i + 1, (Append acc, (ZjPat p, "{v}[{i}]", fail, "{v}_{i}", muts))))
    Append [[head]], rest

# ---------------------------------------------------------------------------------------
# Functions
# ---------------------------------------------------------------------------------------

ZjCaps: fn [ZCap], Text -> Text
fn ZjCaps caps, from:
    let ((ignore, out)) = Fold caps, ((0, [[]])), \|((i, acc)), c| ((i + 1, (Push acc, "let {c.rs} = {from}[{i}].clone();")))
    ZjLines out

ZjCapValues: fn [ZCap] -> ZRs
fn ZjCapValues caps:
    let rs = Each caps, \|c| ZjX c.value
    ZRs(items=(ZjItems rs), code=(ZjCodes rs))

# A function value: its body's `fn` hoisted, and the value made from it.
ZjFunc: fn ZFunc -> ZRs
fn ZjFunc f:
    let cv = ZjCapValues f.caps
    let value = if f.isWidget: "widget_function({ZjStr f.site}, {ZjStr f.name}, {Len f.layers}, {f.rs}, vec![{cv.code}])"
        else: "function({ZjStr f.site}, {ZjStr f.name}, {ZjLayers f.layers}, {ZjNats f.nat}, {ZjBool f.peel}, {f.rs}, vec![{cv.code}])"
    ZRs(items=(Push cv.items, (ZjFuncItem f)), code=value)

# The Rust `fn` of a function: a body over `cap` and `args`, or for a widget function a
# block built through `b`.
ZjFuncItem: fn ZFunc -> Text
fn ZjFuncItem f:
    let selfLine = match f.selfName:
        ? rs: "let {rs} = again({ZjStr f.site}, {ZjStr f.name}, cap);"
        nil: ""
    let clauses = Each f.clauses, \|c| ZjClause c, f.isWidget
    let items = Join (ZjItems clauses), "\n"
    let prologue = ZjLines [[items, (ZjCaps f.caps, "cap"), selfLine]]
    let body = ZjLines (Each clauses, \|c| c.code)
    if f.isWidget:
        let rowLine = match f.families:
            ? fams: "set_emit({ZjStrs fams}, b)?;"
            nil: ""
        RsBuildFn f.rs, f.loc, (ZjLines [[rowLine, prologue]]), (ZjLines [[body, "Err(no_clause({ZjStr f.name}, &args))"]])
    else: RsBodyFn f.rs, (if f.isUnbounded: "within_unbounded" else: "within"), f.loc, prologue, body, f.name

ZjClause: fn ZClause, Bool -> ZRs
fn ZjClause c, isWidget:
    let ((ignore, pats)) = Fold c.params, ((0, [[]])), \|((i, acc)), p| ((i + 1, (Append acc, (ZjPat p, "args[{i}]", "break '{c.label};", "{c.label}_{i}", [[]]))))
    let body = match c.body:
        ZbExpr x: ZjReturn (ZjX x)
        ZbWidgetExpr x: ZjReturn (ZjX (ZBindBuild x))
        ZbWidget w: ZjWideReturn w
    ZRs(items=body.items, code=(RsClause c.label, "{Len c.params}", (ZjLines pats), body.code))

ZjReturn: fn ZRs -> ZRs
fn ZjReturn r = ZRs(items=r.items, code=(if (Contains r.code, "\n"): RsReturn r.code else: "return Ok({r.code});"))

# ---------------------------------------------------------------------------------------
# A `match` or `if` as an expression
# ---------------------------------------------------------------------------------------

ZjBranch: fn ZArms, ZRs -> ZRs
fn ZjBranch a, scrut:
    let ev = ZjCapValues a.env
    let arms = Each a.arms, ZjArm
    let fallback = if a.exhaustive: "Err(no_arm(&s))" else: "Ok(unit())"
    let prologue = ZjLines [[(Join (ZjItems arms), "\n"), (ZjCaps a.env, "env")]]
    let item = RsArmsFn a.rs, prologue, (ZjLines (Each arms, \|r| r.code)), fallback
    ZRs(items=(Push (Append scrut.items, ev.items), item), code="branch({scrut.code}, &[{ev.code}], {a.rs}, b)?")

ZjArm: fn ZArm -> ZRs
fn ZjArm a:
    let fail = "break '{a.label};"
    let tests = ZjPat a.pattern, "s", fail, "{a.label}_p", [[]]
    let guard = match a.guard:
        ? g: ZjX g
        nil: ZjCode ""
    let gl = if guard.code == "": "" else: RsGuard guard.code, fail
    let body = ZjReturn (ZjX a.body)
    ZRs(items=(Append guard.items, body.items), code=(RsArm a.label, (ZjLines (Push tests, gl)), body.code))

# A building `match` or `if` in a widget block.
ZjBuilding: fn ZBuilding -> ZRs
fn ZjBuilding bb:
    let s = "s_{bb.label}"
    let scrut = ZjX bb.scrutinee
    let lifted = ZjBranch bb.lifted, (ZjCode s)
    let arms = Each bb.arms, \|a| ZjBArm a, s
    let fallback = if bb.exhaustive: "return Err(no_arm(&{s}));" else: "unit()"
    let items = Append (Append scrut.items, lifted.items), (ZjItems arms)
    ZRs(items=items, code=(RsBuilding s, scrut.code, lifted.code, (ZjLines (Each arms, \|r| r.code)), fallback))

ZjBArm: fn ZBArm, Text -> ZRs
fn ZjBArm a, s:
    let fail = "break '{a.label};"
    let tests = ZjPat a.pattern, s, fail, "{a.label}_p", [[]]
    let guard = match a.guard:
        ? g: ZjX g
        nil: ZjCode ""
    let gl = if guard.code == "": "" else: RsGuard guard.code, fail
    let w = ZjWide a.body
    let r = ZjX a.body.result
    ZRs(items=(Append (Append guard.items, w.items), r.items), code=(RsArm a.label, (ZjLines (Push tests, gl)), (ZjLines [[w.code, "break '{s} {r.code};"]])))

# ---------------------------------------------------------------------------------------
# Widget blocks
# ---------------------------------------------------------------------------------------

# A blueprint over a widget block: its `fn` hoisted, the blueprint made from it.
ZjBuildValue: fn ZBuild -> ZRs
fn ZjBuildValue bd:
    let cv = ZjCapValues bd.caps
    ZRs(items=(Push cv.items, (ZjBuildItem bd)), code="blueprint({ZjStr bd.name}, vec![{cv.code}], {bd.rs})")

ZjBuildItem: fn ZBuild -> Text
fn ZjBuildItem bd:
    let rowLine = match bd.families:
        ? fams: "set_emit({ZjStrs fams}, b)?;"
        nil: ""
    let w = ZjWideReturn bd.body
    let prologue = ZjLines [[rowLine, (Join w.items, "\n"), (ZjCaps bd.caps, "cap"), (ZjBuildArgs bd.args)]]
    RsBuildFn bd.rs, bd.loc, prologue, w.code

ZjBuildArgs: fn ZBuildArgs -> Text
fn ZjBuildArgs ZaNone = ""
fn ZjBuildArgs ZaAt = ""
fn ZjBuildArgs (ZaRebuild rs) = "let {rs} = row_arg(args, 0);"
fn ZjBuildArgs (ZaFor kp, vp, ixRs, outerIx, outerJx):
    let kxLine = match outerJx:
        ? j: "let l_kx = {j}.clone();"
        nil: ""
    let jxLine = match outerIx:
        ? i: "let l_jx = {i}.clone();"
        nil: ""
    let fail = "return Err(mismatch(\"for\", &row_value));"
    let keyPat = match kp:
        ? p: ZjPat p, "l_key", fail, "row_k", [[]]
        nil: [[]]
    let valuePat = match vp:
        ? p: ZjPat p, "row_value", fail, "row_v", [[]]
        nil: [["let l__ = row_value.clone();", "let ld__ = row_value.clone();"]]
    ZjLines (Append (Append [[kxLine, jxLine, "let {ixRs} = row_arg(args, 2);", "let l_key = row_arg(args, 0);", "let row_value = row_arg(args, 1);"]], keyPat), valuePat)

# A widget block's lines, then `return Ok(value);`.
ZjWideReturn: fn ZWide -> ZRs
fn ZjWideReturn w:
    let lines = ZjWide w
    let r = ZjReturn (ZjX w.result)
    ZRs(items=(Append lines.items, r.items), code=(ZjLines [[lines.code, r.code]]))

ZjWide: fn ZWide -> ZRs
fn ZjWide w:
    let ((ignore, rs)) = Fold w.lines, ((0, [[]])), \|((i, acc)), l| ((i + 1, (Push acc, (ZjLine l, i))))
    ZRs(items=(ZjItems rs), code=(ZjLines (Each rs, \|r| r.code)))

ZjLine: fn ZLine, Nat -> ZRs
fn ZjLine (ZwRow fams), i = ZjCode "set_emit({ZjStrs fams}, b)?;"
fn ZjLine (ZwLet p, x), i = ZjLetPat p, (ZjX x), "t{i}", [[]]
fn ZjLine (ZwHold rs, x), i:
    let xr = ZjX x
    ZRs(items=xr.items, code="let {rs} = hold({xr.code}, b)?;")
fn ZjLine (ZwForward rs), i = ZjCode "let {rs} = forward(b)?;"
fn ZjLine (ZwBind p, x, resolves), i:
    let bound = ZjLetPat p, (ZjX x), "t{i}", [[]]
    let rl = Each resolves, \|((f, binder))| "resolve(&{f}, &{binder}, b)?;"
    ZRs(items=bound.items, code=(ZjLines (Append [[bound.code]], rl)))
fn ZjLine (ZwThen rs, t), i:
    let tr = ZjX t
    ZRs(items=tr.items, code="hold_on(&{rs}, &{tr.code}, b)?;")
fn ZjLine (ZwDo x), i:
    let xr = ZjX x
    ZRs(items=xr.items, code="let _ = {xr.code};")
fn ZjLine (ZwStmt s), i = ZjStmt s, i
fn ZjLine (ZwFault msg), i = ZjCode "return Err(fault({ZjStr msg}));"

# `let p = x;`: a binder at once, any other pattern through a temporary that must match.
ZjLetPat: fn ZPat, ZRs, Text, [Text] -> ZRs
fn ZjLetPat p, xr, t, muts = match p:
    ZpBind rs: ZRs(items=xr.items, code="{ZjMut rs, muts}{rs} = {xr.code};")
    otherwise:
        let tests = ZjPat p, t, "return Err(mismatch(\"let\", &{t}));", "{t}_p", muts
        ZRs(items=xr.items, code=(ZjLines (Append [["let {t} = {xr.code};"]], tests)))

# ---------------------------------------------------------------------------------------
# Expression blocks, `given:`
# ---------------------------------------------------------------------------------------

ZjStmts: fn [ZStmt] -> ZRs
fn ZjStmts stmts:
    let ((ignore, rs)) = Fold stmts, ((0, [[]])), \|((i, acc)), s| ((i + 1, (Push acc, (ZjStmt s, i))))
    ZRs(items=(ZjItems rs), code=(ZjLines (Each rs, \|r| r.code)))

ZjStmt: fn ZStmt, Nat -> ZRs
fn ZjStmt (ZsLet p, x), i = ZjLetPat p, (ZjX x), "t{i}", [[]]
fn ZjStmt (ZsDo x), i:
    let xr = ZjX x
    ZRs(items=xr.items, code="let _ = {xr.code};")
fn ZjStmt (ZsFault msg), i = ZjCode "return Err(fault({ZjStr msg}));"

ZjGiven: fn Bool, [ZGivenStep] -> ZRs
fn ZjGiven fallible, steps:
    let ((ignore, rs)) = Fold steps, ((0, [[]])), \|((i, acc)), s| ((i + 1, (Push acc, (ZjGivenStep fallible, s, i))))
    ZRs(items=(ZjItems rs), code=(RsGiven (ZjLines (Each rs, \|r| r.code)), "unit()"))

ZjGivenStep: fn Bool, ZGivenStep, Nat -> ZRs
fn ZjGivenStep fallible, (ZgBind p, x, txt), i:
    let xr = ZjX x
    let t = "g{i}"
    let tests = ZjPat p, t, "break 'given give_up({ZjBool fallible}, {ZjStr txt});", "{t}_p", [[]]
    ZRs(items=xr.items, code=(ZjLines (Append [[(RsGivenBind t, xr.code)]], tests)))
fn ZjGivenStep fallible, (ZgLet p, x), i = ZjLetPat p, (ZjX x), "g{i}", [[]]
fn ZjGivenStep fallible, (ZgGuard want, c, txt), i:
    let cr = ZjX c
    ZRs(items=cr.items, code="if truth(&{cr.code})? != {ZjBool want} \{ break 'given give_up({ZjBool fallible}, {ZjStr txt}); \}")
fn ZjGivenStep fallible, (ZgLet1 s), i = ZjStmt s, i
fn ZjGivenStep fallible, (ZgAnswer x), i:
    let xr = ZjX x
    ZRs(items=xr.items, code="break 'given given_answer({ZjBool fallible}, {xr.code});")
fn ZjGivenStep fallible, (ZgFault msg), i = ZjCode "return Err(fault({ZjStr msg}));"

# ---------------------------------------------------------------------------------------
# `&` blocks
# ---------------------------------------------------------------------------------------

ZjUpds: fn [ZUpd] -> ZRs
fn ZjUpds ups:
    let ((ignore, rs)) = Fold ups, ((0, [[]])), \|((i, acc)), u| ((i + 1, (Push acc, (ZjUpd u, i))))
    ZRs(items=(ZjItems rs), code=(ZjLines (Each rs, \|r| r.code)))

ZjUpd: fn ZUpd, Nat -> ZRs
fn ZjUpd (ZuSet root, steps, v), i:
    let vr = ZjX v
    let st = ZjSteps steps
    ZRs(items=(Append vr.items, st.items), code="\{ let v = {vr.code}; let st: Vec<Step> = vec![{st.code}]; lens::set_in(&mut {root}, &st, v)?; \}")
fn ZjUpd (ZuAccum root, steps, op, v), i:
    let vr = ZjX v
    let st = ZjSteps steps
    ZRs(items=(Append vr.items, st.items), code="\{ let v = {vr.code}; let st: Vec<Step> = vec![{st.code}]; let now = lens::read(&{root}, &st)?; let next = binop(Op::{op}, now, v, &mut None)?; lens::set_in(&mut {root}, &st, next)?; \}")
fn ZjUpd (ZuLet p, x, amps), i = ZjLetPat p, (ZjX x), "u{i}", amps
fn ZjUpd (ZuWhile c, body, label), i:
    let chk = ZjCond c, "break '{label};", label
    let b = ZjUpds body
    ZRs(items=(Append chk.items, b.items), code=(RsWhile label, chk.code, b.code))
fn ZjUpd (ZuIf c, yes, no, label), i:
    let chk = ZjCond c, "break 'then_{label};", label
    let y = ZjUpds yes
    let n = ZjUpds no
    ZRs(items=(Append (Append chk.items, y.items), n.items), code=(RsIf label, chk.code, y.code, n.code))
fn ZjUpd (ZuMatch s, arms, label), i:
    let sr = ZjX s
    let ar = Each arms, \|a| ZjUArm a, label
    ZRs(items=(Append sr.items, (ZjItems ar)), code=(RsMatch label, sr.code, (ZjLines (Each ar, \|r| r.code))))
fn ZjUpd (ZuFor coll, kp, vp, body, label, outerIx, outerJx), i:
    let cr = ZjX coll
    let fail = "return Err(mismatch(\"for\", &v_{label}));"
    let kpl = match kp:
        ? p: ZjPat p, "k_{label}", fail, "kp_{label}", [[]]
        nil: [[]]
    let vpl = match vp:
        ? p: ZjPat p, "v_{label}", fail, "vp_{label}", [[]]
        nil: match kp:
            ? ignore: [[]]
            nil: [["let l__ = v_{label}.clone();"]]
    let binds = ZjLines (Append (Append (ZjLoopNames label, outerIx, outerJx), kpl), vpl)
    let b = ZjUpds body
    ZRs(items=(Append cr.items, b.items), code=(RsFor label, cr.code, binds, b.code))
fn ZjUpd (ZuForRef root, steps, body, label, hidden, outerIx, outerJx), i:
    let st = ZjSteps steps
    let hide = match hidden:
        ? h: "let mut {h} = std::mem::take(&mut {root});"
        nil: ""
    let unhide = match hidden:
        ? h: "{root} = {h};"
        nil: ""
    let b = ZjUpds body
    ZRs(items=(Append st.items, b.items), code=(RsForRef label, root, st.code, hide, (ZjLines (ZjLoopNames label, outerIx, outerJx)), b.code, unhide))
fn ZjUpd (ZuDo x), i:
    let xr = ZjX x
    ZRs(items=xr.items, code="let _ = {xr.code};")
fn ZjUpd (ZuFault msg), i = ZjCode "return Err(fault({ZjStr msg}));"

# A loop's `ix` and `key`, and the enclosing loops' as `jx` and `kx`.
ZjLoopNames: fn Text, ?Text, ?Text -> [Text]
fn ZjLoopNames label, outerIx, outerJx:
    let kxLine = match outerJx:
        ? j: "let l_kx = {j}.clone();"
        nil: ""
    let jxLine = match outerIx:
        ? i: "let l_jx = {i}.clone();"
        nil: ""
    [[kxLine, jxLine, "let l_ix = nat(ix_{label});", "let l_key = k_{label}.clone();"]]

ZjCond: fn ZCond, Text, Text -> ZRs
fn ZjCond (ZcExpr x), fail, label:
    let xr = ZjX x
    ZRs(items=xr.items, code=(RsGuard xr.code, fail))
fn ZjCond (ZcBind p, v, g), fail, label:
    let vr = ZjX v
    let t = "c_{label}"
    let tests = ZjPat p, t, fail, "{t}_p", [[]]
    let gr = match g:
        ? x: ZjX x
        nil: ZjCode ""
    let gl = if gr.code == "": "" else: RsGuard gr.code, fail
    ZRs(items=(Append vr.items, gr.items), code=(ZjLines (Push (Append [["let {t} = {vr.code};"]], tests), gl)))

ZjUArm: fn ZUArm, Text -> ZRs
fn ZjUArm a, label:
    let fail = "break '{a.label};"
    let tests = ZjPat a.pattern, "s_{label}", fail, "{a.label}_p", [[]]
    let gr = match a.guard:
        ? g: ZjX g
        nil: ZjCode ""
    let gl = if gr.code == "": "" else: RsGuard gr.code, fail
    let b = ZjUpds a.body
    ZRs(items=(Append gr.items, b.items), code=(RsArm a.label, (ZjLines (Push tests, gl)), (ZjLines [[b.code, "break '{label};"]])))

# ---------------------------------------------------------------------------------------
# Code templates: a `String` built part by part
# ---------------------------------------------------------------------------------------

ZjParts: fn [ZPart] -> ZRs
fn ZjParts parts:
    let rs = Each parts, ZjPart
    ZRs(items=(ZjItems rs), code=(RsTemplate (ZjLines (Each rs, \|r| r.code))))

ZjPart: fn ZPart -> ZRs
fn ZjPart (ZtText t) = ZjCode "out.push_str({ZjStr t});"
fn ZjPart (ZtPlace x, col):
    let xr = ZjX x
    let c = match col:
        ? n: "Some({n})"
        nil: "None"
    ZRs(items=xr.items, code="place(&mut out, &{xr.code}, {c}, b)?;")
fn ZjPart (ZtBlock x):
    let xr = ZjX x
    ZRs(items=xr.items, code="place_value(&mut out, &{xr.code}, b)?;")
fn ZjPart (ZtCall f, args, body):
    let fr = ZjX f
    let ars = Each args, ZjX
    let bodyArg = match body:
        ? ps: ? (ZjParts ps)
        nil: nil
    let all = match bodyArg:
        ? br: Push ars, ZRs(items=br.items, code="text(&{br.code})")
        nil: ars
    ZRs(items=(Append fr.items, (ZjItems all)), code="\{ let v = apply(&{fr.code}, vec![{ZjCodes all}], b)?; out.push_str(&display(&v, b)?); \}")

# ---------------------------------------------------------------------------------------
# Modules and the program
# ---------------------------------------------------------------------------------------

ZjModule: fn ZModOut -> Text
fn ZjModule m:
    let items = Each m.items, ZjItem
    let label = if m.name == "": "The root" else: "Module `{m.name}`"
    RsModule m.file, label, (Join items, "\n")

ZjItem: fn ZItem -> Text
fn ZjItem (ZiFn getter, name, f):
    let fr = ZjFunc f
    Join (Append [[(RsGetter "`{name}`, at {f.loc}.", getter, f.site, "Ok({fr.code})")]], fr.items), "\n"
fn ZjItem (ZiImpl getter, f):
    let fr = ZjFunc f
    Join (Append [[(RsGetter "`{f.name}` of an `impl`, at {f.loc}.", getter, f.site, "Ok({fr.code})")]], fr.items), "\n"
fn ZjItem (ZiLet getter, site, p, x, rs):
    let xr = ZjX x
    let body = match p:
        ZpBind ignore: ZjLines [[(Join xr.items, "\n"), "let b: &mut Bx = &mut None;", "Ok({xr.code})"]]
        otherwise:
            let bound = ZjLetPat p, xr, "v", [[]]
            ZjLines [[(Join bound.items, "\n"), "let b: &mut Bx = &mut None;", bound.code, "Ok({rs})"]]
    RsGetter "A `let`.", getter, site, body
fn ZjItem (ZiWidget getter, bd):
    let item = ZjBuildItem bd
    Join [[(RsGetter "`{bd.name}`, at {bd.loc}.", getter, "{bd.loc}.{bd.name}", "Ok(blueprint({ZjStr bd.name}, vec![], {bd.rs}))"), item]], "\n"
fn ZjItem (ZiCtor getter, c) = RsGetter "The constructor `{c}`.", getter, "ctor.{c}", "ctor({ZjStr c})"
fn ZjItem (ZiBuiltin getter, n, layers, nat, isValue):
    let value = if isValue: "builtin_value({ZjStr n})" else: "Ok(builtin({ZjStr "builtin.{n}"}, {ZjStr n}, {ZjLayers layers}, {ZjNats nat}))"
    RsGetter "`{n}`, written in Rust (prism_dyn::builtins).", getter, "builtin.{n}", value
fn ZjItem (ZiMethod getter, m):
    let dr = match m.default:
        ? f: ? (ZjFunc f)
        nil: nil
    let defaultCode = match dr:
        ? r: "Some({r.code})"
        nil: "None"
    let items = match dr:
        ? r: r.items
        nil: [[]]
    let value = "Ok(method({ZjStr m.site}, MethodMeta \{ trait_name: {ZjStr m.traitName}.into(), name: {ZjStr m.name}.into(), dispatch: {m.dispatch}, default: {defaultCode}, prelude: {ZjBool m.prelude} \}, {ZjLayers m.layers}))"
    Join (Append [[(RsGetter "`{m.name}`, a method of `^{m.traitName}`.", getter, m.site, value)]], items), "\n"

# The files of the emitted crate: `Cargo.toml`, `src/main.rs`, a file per module.
ZjProgram: fn ZProg, [ZModOut], Text, Text, [((Text, ZExpr))], [((Text, ZExpr))] -> [((Text, Text))]
fn ZjProgram prog, mods, name, runtime, checks, named:
    let modLines = Join (Each mods, \|m| "mod {m.rs};"), "\n"
    let ctors = Join (Each prog.ctors, ZjCtorMeta), "\n"
    let tagNames = Keys prog.tags
    let tagLines = Fold tagNames, [[]], \|acc, n| match prog.tags[n]:
        ? t: Push acc, (ZjTagDecl t)
        nil: acc
    let tags = Join tagLines, "\n"
    let impls = Join (Each prog.impls, ZjImplLines), "\n"
    let root = match prog.mods[""]:
        ? m: match ZRootMain m:
            ? main: "crate::m_main::{ZGlobalRs main}()"
            nil: "fail(\"the root file has no `@main` (Semantics ch. 6)\")"
        nil: "fail(\"prism run needs exactly one file with no `module` line (Semantics ch. 6)\")"
    let declared = Each (ZTestPrograms prog), \|((n, path))| "({ZjStr n}, {path}()?),"
    let written = Each (ZDedupChecks named), ZjNamedProgram
    let programs = Join (Append declared, written), "\n"
    let main = RsMain name, modLines, ctors, tags, impls, root, programs, (Join (Each (ZDedupChecks checks), ZjCheck), "\n")
    let files = Each mods, \|m| (("src/{m.rs}.rs", ZjModule m))
    Append [[(("Cargo.toml", (RsCargo name, runtime))), (("src/main.rs", main))]], files

ZjCtorMeta: fn ZCtor -> Text
fn ZjCtorMeta c = "ctor_meta({ZjStr c.name}, {ZjStr c.typeName}, {ZjBool c.isRecord}, {ZjStrs c.fields}, {ZjNats c.nat}, {ZjLayers c.layers}, {c.index}),"

ZjTagDecl: fn ZTagInfo -> Text
fn ZjTagDecl t:
    let fields = Join (Each t.fields, \|((n, k))| "({ZjStr n}, FieldKind::{k})"), ", "
    "tag_decl({ZjStr t.name}, &[{fields}], {t.outKind}, {ZjBool t.fault}),"

ZjImplLines: fn ZImpl -> Text
fn ZjImplLines i:
    let head = "tables::add_impl({ZjStr i.traitName}, {ZjStr i.typeHead});"
    let methods = Each i.methods, \|((n, ignore))| "tables::add_impl_method({ZjStr i.traitName}, {ZjStr i.typeHead}, {ZjStr n}, crate::{ZRsMod i.home}::gi_{ZMangle i.traitName}_{ZMangle i.typeHead}_{ZMangle n}()?);"
    Join (Append [[head]], methods), "\n"

# ---------------------------------------------------------------------------------------
# The compile job, run through `@Run` (the parser is unbounded, D7)
# ---------------------------------------------------------------------------------------

type ZJob = record:
    files: [((Text, Text))]                  # the program's files, path and text
    prelude: [((Text, Text))]                # the prelude's files that were found
    name: Text                               # the emitted crate's name
    runtime: Text                            # where `prism_rt` and `prism_dyn` are, from the crate
derive ^Eq, ^Show

type ZOutcome = record:
    files: [((Text, Text))]                  # each emitted file, its path in the crate
    failed: Bool
    report: Text
derive ^Eq, ^Show

# Parse every file, gather the program, lower each module, emit the crate. A file with a
# lexical or parse error, or a program without exactly one root file, fails the job with
# the diagnostics; out-of-scope features are reported by the code that reaches them.
ZCompile: unbounded fn ZJob -> ZOutcome
fn ZCompile job:
    let tests = Filter job.files, \|((f, ignore))| ZIsScript f
    let programFiles = Filter job.files, \|((f, ignore))| not (ZIsScript f)
    let user = Each programFiles, \|((f, t))| ZParseSource f, t, False
    let scripts = Each tests, \|((f, t))| ZParseSource f, t, False
    let libs = Each job.prelude, \|((f, t))| ZParseSource f, t, True
    let errors = Fold (Append (Append user, libs), scripts), [[]], \|acc, ((s, ds))| Append acc, (ZErrorsOf s, ds)
    let userSources = Each user, \|((s, ignore))| s
    let kept = Filter (Each libs, \|((s, ignore))| s), \|l| ZKeepBundled userSources, l
    let roots = Filter userSources, \|s| (ZModName s.tree) == ""
    if (Len errors) > 0: ZOutcome(files=[[]], failed=True, report=(Join errors, "\n"))
    else: if (Len roots) != 1: ZOutcome(files=[[]], failed=True, report="prism run needs exactly one file with no `module` line (Semantics ch. 6), and was given {Len roots}: {Join (Each roots, \|s| s.file), ", "}")
    else:
        let prog = ZGather (Append userSources, kept)
        let mods = Fold prog.order, [[]], \|acc, n| match prog.mods[n]:
            ? m: Push acc, (ZLowerModule prog, m)
            nil: acc
        let checks = Fold scripts, [[]], \|acc, ((sc, ignore))| Append acc, (ZScriptChecks prog, sc)
        let named = Fold scripts, [[]], \|acc, ((sc, ignore))| Append acc, (ZScriptPrograms prog, sc)
        let files = ZjProgram prog, mods, job.name, job.runtime, checks, named
        ZOutcome(files=files, failed=False, report=(Join prog.errors, "\n"))

ZIsScript: fn Text -> Bool
fn ZIsScript f = (Drop f, (Or ((Len f) -? 10), 0)) == ".prismtest"

ZParseSource: unbounded fn Text, Text, Bool -> ((ZSource, [Diag]))
fn ZParseSource file, text, bundled:
    let parsed = ParseFile text
    ((ZSource(file=file, text=text, tree=parsed.tree, bundled=bundled), parsed.diags))

# The diagnostics that stop a compile, `file:line:col: message`; out-of-scope features
# pass (the code that reaches one fails when it runs).
ZErrorsOf: fn ZSource, [Diag] -> [Text]
fn ZErrorsOf s, ds:
    let env = ZTopEnv (ZModOf s)
    Each (Filter ds, \|d| d.stage != "out"), \|d| "{ZLoc env, d.span}: {d.message}"

# Where the runtime crates are from an emitted crate at `out`, a path under the current
# directory: one `..` per directory.
ZRuntimeFor: fn Text -> Text
fn ZRuntimeFor out:
    let parts = Filter (Split out, "/"), \|p| p != "" and p != "."
    if (Len parts) == 0: "." else: Join (Each parts, \|ignore| ".."), "/"

# A test script's `check` lines, each its expression's text and the expression lowered in
# the script's module: the `.prism` file of its name, or else the root (Semantics ch. 6:
# tests are declarations of their module).
ZScriptChecks: fn ZProg, ZSource -> [((Text, ZExpr))]
fn ZScriptChecks prog, sc:
    let env = ZScriptEnv prog, sc
    Fold sc.tree.decls, [[]], \|acc, d| match d.kind:
        DCheck c: Fold c.lines, acc, \|a, l| Push a, (((Trim (ZSpanText env, l.expr.span)), (ZLx prog, env, l.expr)))
        otherwise: acc

ZjCheck: fn ((Text, ZExpr)) -> Text
fn ZjCheck ((text, x)):
    let xr = ZjX x
    let items = Join xr.items, "\n"
    "{ZjStr text} => Some((|| -> R<Value> \{ {items} Ok({xr.code}) \})()),"

# One arm per expression text: the first of several identical lines.
ZDedupChecks: fn [((Text, ZExpr))] -> [((Text, ZExpr))]
fn ZDedupChecks cs:
    let ((ignore, kept)) = Fold cs, (({}, [[]])), \|((seen, acc)), ((t, x))| match seen[t]:
        ? ignore: ((seen, acc))
        nil: (((Insert seen, t, True), (Push acc, ((t, x)))))
    kept

# A script's names resolve in its module: the `.prism` file of its name, or the root.
ZScriptEnv: fn ZProg, ZSource -> ZEnv
fn ZScriptEnv prog, sc:
    let stem = Take sc.file, (Or ((Len sc.file) -? 10), 0)
    let owners = Filter prog.order, \|n| match prog.mods[n]:
        ? m: m.file == "{stem}.prism"
        nil: False
    let home = Or owners[0], ""
    ZEnv(home=home, file=sc.file, src=sc.text, starts=(ZLineStarts sc.text), locals={}, mark="", aliases={})

# The programs a script's `test name, @program:` lines name, by the text after the `@`, as
# the Test World names them: `@counter`, or an application, `@Normal (App ..)`.
ZScriptPrograms: fn ZProg, ZSource -> [((Text, ZExpr))]
fn ZScriptPrograms prog, sc:
    let env = ZScriptEnv prog, sc
    Fold sc.tree.decls, [[]], \|acc, d| match d.kind:
        DTest t: Push acc, (((Drop (Trim (ZSpanText env, t.blueprint.span)), 1), (ZLx prog, env, t.blueprint)))
        otherwise: acc

ZjNamedProgram: fn ((Text, ZExpr)) -> Text
fn ZjNamedProgram ((name, x)):
    let xr = ZjX x
    let items = Join xr.items, "\n"
    "({ZjStr name}, (|| -> R<Value> \{ {items} Ok({xr.code}) \})()?),"
