# Emission: the model lowering decided (lower.prism) spelled as a Rust crate through the
# templates (templates/rust.prism, templates/prelude.prism): `Cargo.toml`, `src/main.rs`,
# `src/prelude.rs` and one `src/NAME.rs` per Prism module. Each function here spells one
# construct of the core form; nothing here decides (K9). An expression's text is
# relative to the column it starts at, so a template's placeholder alone on its line
# indents a piece of several lines as a person would.
#
# Written by Claude, 1 November 2026, on the claude-self-hosting branch. Subject to change:
# Jimmy rewrites it by hand, and an implementer reading it uses their own discretion.
module Emit
emit r
use Lexer.*
use CheckErrors.*
use Lower.*
use RustTemplates.*
use PreludeTemplate.*

# ---------------------------------------------------------------------------------------
# Types
# ---------------------------------------------------------------------------------------

EmTy: unbounded fn RsTy -> Text
fn EmTy t = match t:
    RsNat: "Nat"
    RsInt: "Int"
    RsU8: "u8"
    RsFloat: "f64"
    RsBool: "bool"
    RsChar: "char"
    RsText: "Text"
    RsUnit: "()"
    RsPath: "Path"
    RsDuration: "Duration"
    RsError: "Error"
    RsNamed n, [[]]: n
    RsNamed n, args: "{n}<{EmTys args}>"
    RsOpt i: "Option<{EmTy i}>"
    RsRes i: "Result<{EmTy i}, Error>"
    RsTuple ts: "({EmTys ts})"
    RsArray e: "Array<{EmTy e}>"
    RsMap k, v: "Map<{EmTy k}, {EmTy v}>"
    RsFn ps, r: "Rc<dyn Fn({EmRefTys ps}) -> {EmTy r}>"
    RsRef (RsFn ps, r): "&dyn Fn({EmRefTys ps}) -> {EmTy r}"
    RsRef i: "&{EmTy i}"
    RsJobFn a, b: "Rc<dyn Fn({EmTy a}) -> Rc<dyn prism_rtl::Job<{EmTy b}>>>"
    RsJob b: "Rc<dyn prism_rtl::Job<{EmTy b}>>"
    RsEvent i: "Event<{EmTy i}>"
    RsDyn i: "Dynamic<{EmTy i}>"
    RsGen n: n
    RsRc i: "Rc<{EmTy i}>"
    RsPod: "Pod"
    RsShowAny: "Rc<dyn Show>"
    RsHold i: "Hold<{EmTy i}>"
    RsStamped i: "Stamped<{EmTy i}>"
    RsDefer i: "Defer<{EmTy i}>"
    RsWeak n: "Weak<{n}>"
    RsCell i: "RefCell<{EmTy i}>"
    RsWakes: "Wakes"
    RsPort i: "Port<{EmTy i}>"
    RsUnknown what: "() /* {what} */"

EmTys: unbounded fn [RsTy] -> Text
fn EmTys ts = Join (Each ts, \|t| EmTy t), ", "

EmRefTys: unbounded fn [RsTy] -> Text
fn EmRefTys ts = Join (Each ts, \|t| "&{EmTy t}"), ", "

# ---------------------------------------------------------------------------------------
# Expressions
# ---------------------------------------------------------------------------------------

# Whether an expression must be parenthesized as an operand or a receiver.
EmLoose: fn Ex -> Bool
fn EmLoose x = match x:
    XBin ignore, ignore, ignore: True
    XUnary ignore, ignore: True
    XClosure ignore, ignore, ignore: True
    XIf ignore, ignore, ignore: True
    XMatch ignore, ignore, ignore: True
    XChain ignore, ignore, ignore: True
    XCast ignore, ignore: True
    otherwise: False

EmTight: unbounded fn Ex -> Text
fn EmTight x = if EmLoose x: "({EmEx x})" else: EmEx x

EmOperand: unbounded fn Ex -> Text
fn EmOperand x = match x:
    XBin ignore, ignore, ignore: "({EmEx x})"
    XClosure ignore, ignore, ignore: "({EmEx x})"
    XIf ignore, ignore, ignore: "({EmEx x})"
    XCast ignore, ignore: "({EmEx x})"
    otherwise: EmEx x

EmArgs: unbounded fn [Ex] -> Text
fn EmArgs xs = Join (Each xs, \|x| EmEx x), ", "

EmEx: unbounded fn Ex -> Text
fn EmEx x = match x:
    XRaw t: t
    XCall f, args: "{f}({EmArgs args})"
    XApply f, args: "{EmTight f}({EmArgs args})"
    XMethod r, m, args: "{EmTight r}.{m}({EmArgs args})"
    XBin op, l, r: "{EmOperand l} {op} {EmOperand r}"
    XUnary op, y: "{op}{EmOperand y}"
    XCtor p, args: "{p}({EmArgs args})"
    XRecord p, fs: "{p} \{ {Join (Each fs, \|((f, v))| EmFieldInit f, v), ", "} \}"
    XTuple [[one]]: "({EmEx one},)"
    XTuple xs: "({EmArgs xs})"
    XVec xs: "vec![{EmArgs xs}]"
    XText t: "Text::from(\"{LoEscape t}\")"
    XFormat parts: EmFormat parts
    XMatch s, arms, fallback: TmMatch (EmEx s), (EmArms arms, fallback)
    XChain label, s, arms: EmChain (EmLabel label), s, arms
    XIf c, t, e: EmIf c, t, e
    XBlock [[]], e: EmEx e
    XBlock dos, e: TmBlock (EmDos dos), (EmEx e)
    XLabeled label, dos, e: TmLabeled (EmLabel label), (EmDos dos), (EmEx e)
    XClosure mv, ps, body: "{if mv: "move " else: ""}|{Join (Each ps, \|p| EmPa p), ", "}| {EmEx body}"
    XTry y: "{EmTight y}?"
    XField r, f: "{EmTight r}.{f}"
    XDecode t, y: "{EmDecodeHead t}::from_pod({EmEx y})?"
    XCast y, t: "{EmTight y} as {EmTy t}"

EmFieldInit: unbounded fn Text, Ex -> Text
fn EmFieldInit f, (XRaw v) = if v == f: f else: "{f}: {v}"
fn EmFieldInit f, v = "{f}: {EmEx v}"

EmDecodeHead: unbounded fn RsTy -> Text
fn EmDecodeHead t = match t:
    RsNamed n, [[]]: n
    RsNat: "Nat"
    RsInt: "Int"
    RsText: "Text"
    otherwise: "<{EmTy t}>"

EmLabel: fn Text -> Text
fn EmLabel l = if (Take l, 1) == "'": l else: "'{l}"

# `Text::from(format!(..))`: the literal runs with their braces doubled, a `{}` per value.
EmFormat: unbounded fn [Ex] -> Text
fn EmFormat parts:
    let lit = Concat (Each parts, \|p| EmFormatPiece p)
    let vals = Filter parts, \|p| not (EmIsText p)
    if (Len vals) == 0: "Text::from(\"{lit}\")"
    else: "Text::from(format!(\"{lit}\", {EmArgs vals}))"

EmIsText: fn Ex -> Bool
fn EmIsText (XText ignore) = True
fn EmIsText other = False

EmFormatPiece: fn Ex -> Text
fn EmFormatPiece (XText t) = EmFormatEscape (LoEscape t)
fn EmFormatPiece other = "\{\}"

EmFormatEscape: fn Text -> Text
fn EmFormatEscape t = Concat (Each (Chars t), \|c| if c == "\{": "\{\{" else: if c == "\}": "\}\}" else: c)

# `if c { a } else { b }` on one line when both sides are short.
EmIf: unbounded fn Ex, Ex, Ex -> Text
fn EmIf c, t, e:
    let ct = EmEx c
    let tt = EmEx t
    let et = EmEx e
    let short = not (Contains "{tt}{et}", "\n") and (Len "{ct}{tt}{et}") < 70
    if short: "if {ct} \{ {tt} \} else \{ {et} \}" else: TmIf ct, tt, et

# A `match`'s arms, guards joined; the fallback arm when a guard leaves the match open.
EmArms: unbounded fn [XArm], Bool -> Text
fn EmArms arms, fallback:
    let lines = Each arms, \|a| EmArm a
    let all = if fallback: Push lines, "_ => unreachable!(\"no arm matched\")," else: lines
    Join all, "\n"

EmArm: unbounded fn XArm -> Text
fn EmArm a:
    let guard = if (Len a.conds) == 0: "" else: " if {Join (Each a.conds, \|c| EmCond c), " && "}"
    let body = EmEx a.body
    "{EmPa a.pat}{guard} => {body},"

EmCond: unbounded fn Cc -> Text
fn EmCond (CcIf x) = EmOperand x
fn EmCond (CcLet p, x) = "let {EmPa p} = {EmEx x}"

# An if-let chain over arms in a labelled block: each arm breaks with its value; a last arm
# that matches anything ends the block.
EmChain: unbounded fn Text, Ex, [XArm] -> Text
fn EmChain label, s, arms:
    let ((bind, scrut)) = match s:
        XRaw n: (([[]], n))
        XUnary "&", (XRaw n): (([[]], "&{n}"))
        otherwise: (([["let scrutinee = {EmEx s};"]], "scrutinee"))
    let n = Len arms
    let lines = Each (Range0 n), \|i|
        let a = Or arms[i], (XArm(pat=PaWild, conds=[[]], body=(XRaw "()")))
        let catchAll = (a.pat == PaWild) and (Len a.conds) == 0
        if catchAll: EmEx a.body
        else:
            let head = Join (Append [["let {EmPa a.pat} = {scrut}"]], (Each a.conds, \|c| EmCond c)), " && "
            TmChainArm head, label, (EmContinued (EmEx a.body), "    ")
    let ends = match ?Last arms:
        ? a: (a.pat == PaWild) and (Len a.conds) == 0
        nil: False
    let tail = if ends: [[]] else: [["unreachable!(\"no clause matched\")"]]
    "{label}: \{\n{Indent (Join (Append (Append bind, lines), tail), "\n")}\n\}"

# A text placed after other text on an indented line: its later lines take the indent.
EmContinued: fn Text, Text -> Text
fn EmContinued t, pad:
    let ls = Split t, "\n"
    Join (Each (Range0 (Len ls)), \|i| if i == 0 or (Or ls[i], "") == "": Or ls[i], "" else: "{pad}{Or ls[i], ""}"), "\n"

# A function's body: a block's statements and value without its braces.
EmBody: unbounded fn Ex -> Text
fn EmBody (XBlock dos, e) = if (Len dos) == 0: EmBody e else: "{EmDos dos}\n{EmBody e}"
fn EmBody x = EmEx x

# Every line of a text four spaces in.
Indent: fn Text -> Text
fn Indent t = Join (Each (Split t, "\n"), \|l| if l == "": "" else: "    {l}"), "\n"

# ---------------------------------------------------------------------------------------
# Patterns and statements
# ---------------------------------------------------------------------------------------

EmPa: unbounded fn Pa -> Text
fn EmPa p = match p:
    PaWild: "_"
    PaBind n: n
    PaCtor c, ps: "{c}({Join (Each ps, \|q| EmPa q), ", "})"
    PaUnit c: c
    PaRecord c, fs, rest:
        let parts = Each fs, \|((f, q))| match q:
            PaBind n: if n == f: f else: "{f}: {n}"
            otherwise: "{f}: {EmPa q}"
        let all = if rest: Push parts, ".." else: parts
        "{c} \{ {Join all, ", "} \}"
    PaTuple [[one]]: "({EmPa one},)"
    PaTuple ps: "({Join (Each ps, \|q| EmPa q), ", "})"
    PaLit t: t
    PaTyped q, t: "{EmPa q}: {EmTy t}"

EmDos: unbounded fn [Do] -> Text
fn EmDos dos = Join (Each dos, \|d| EmDo d), "\n"

EmDo: unbounded fn Do -> Text
fn EmDo d = match d:
    DoLet p, x: "let {EmPa p} = {EmEx x};"
    DoLetElse p, x, e: "let {EmPa p} = {EmEx x} else \{ {EmEx e} \};"
    DoAssign p, x: "{EmEx p} = {EmEx x};"
    DoWhile c, body: TmIfStmt "while {EmEx c}", (EmDos body)
    DoWhileLet p, x, body: TmIfStmt "while let {EmPa p} = {EmEx x}", (EmDos body)
    DoExpr x: "{EmEx x};"
    DoIf c, t, e: "{TmIfStmt "if {EmEx c}", (EmDos t)}{EmElse e}"
    DoIfLet p, x, t, e: "{TmIfStmt "if let {EmPa p} = {EmEx x}", (EmDos t)}{EmElse e}"
    DoMatch x, cases: TmMatch (EmEx x), (Join (Each cases, \|((p, body))| TmArmBlock (EmPa p), (EmDos body)), "\n")
    DoReturn x: "return {EmEx x};"
    DoNote t: "// {t}"

# An `else`, `else if` for a lone `if` inside.
EmElse: unbounded fn [Do] -> Text
fn EmElse [[]] = ""
fn EmElse [[(DoIf c, t, e)]] = " else {EmDo (DoIf c, t, e)}"
fn EmElse [[(DoIfLet p, x, t, e)]] = " else {EmDo (DoIfLet p, x, t, e)}"
fn EmElse body = TmElse (EmDos body)

# ---------------------------------------------------------------------------------------
# Items
# ---------------------------------------------------------------------------------------

EmGenerics: fn [((Text, [Text]))] -> Text
fn EmGenerics [[]] = ""
fn EmGenerics gs = "<{Join (Each gs, \|((g, bs))| if (Len bs) == 0: g else: "{g}: {Join bs, " + "}"), ", "}>"

EmGenericNames: fn [Text] -> Text
fn EmGenericNames [[]] = ""
fn EmGenericNames ps = "<{Join ps, ", "}>"

EmBounded: fn [Text], Text -> Text
fn EmBounded [[]], ignore = ""
fn EmBounded ps, tr = "<{Join (Each ps, \|p| "{p}: {tr}"), ", "}>"

EmItem: unbounded fn Item -> Text
fn EmItem it = match it:
    ItTrait t: EmTraitDef t
    ItImpl i: EmImplDef i
    ItType t: EmTyDef t
    ItTag t: EmTagDef t
    ItFn f: EmFnDef f
    ItJob j: EmJobDef j
    ItNode n: EmNodeDef n
    ItNote t: "// {t}\n"
    ItRefused t: "compile_error!(\"{loweringRefusal}{LoEscape t}\");\n"

EmTraitDef: unbounded fn TraitDef -> Text
fn EmTraitDef t:
    let ms = Join (Each t.methods, \|f| EmTraitMethod f), "\n"
    "{TmSourceDoc "", t.doc}pub trait {t.name} \{\n{Indent ms}\n\}\n"

EmSig: unbounded fn FnDef, Text -> Text
fn EmSig f, vis:
    let params = Join (Each f.params, \|((n, t))| "{n}: {EmTy t}"), ", "
    "{vis}fn {f.name}{EmGenerics f.generics}({params}) -> {EmTy f.ret}"

EmTraitMethod: unbounded fn FnDef -> Text
fn EmTraitMethod f = if f.public: TmFn "", (EmSig f, ""), (EmBody f.body) else: "{EmSig f, ""};"

# An impl: a program's trait's methods inside it; `^Show`, `^Eq` and `^Ord` as Rust's
# traits over the method, a function of its own.
EmImplDef: unbounded fn ImplDef -> Text
fn EmImplDef i:
    let head = EmTy i.head
    let gens = EmGenerics i.generics
    if i.cls == "Prelude.Show":
        let fns = Join (Each i.methods, \|f| EmFnDef f), "\n"
        let shown = Or (Each i.methods, \|f| f.name)[0], "show"
        "{fns}\n{TmImpl gens, "Show", head, "fn show(&self, p: &mut Printer)", "p.raw(&{shown}(self).to_string());"}"
    else: if i.cls == "Prelude.Eq":
        let fns = Join (Each i.methods, \|f| EmFnDef f), "\n"
        let eq = Fold i.methods, "", \|acc, f| if (Take f.name, 2) != "ne" and acc == "": f.name else: acc
        "{fns}\n{TmImpl gens, "PartialEq", head, "fn eq(&self, other: &Self) -> bool", "{eq}(self, other)"}"
    else: "impl{gens} {i.tr} for {head} \{\n{Indent (Join (Each i.methods, \|f| TmFn "", (EmSig f, ""), (EmBody f.body)), "\n")}\n\}\n"

EmFnDef: unbounded fn FnDef -> Text
fn EmFnDef f:
    let params = Join (Each f.params, \|((n, t))| "{n}: {EmTy t}"), ", "
    # A function may build a job or a closure over its type parameters, which then live
    # as long as the program (every Prism type does).
    let sig = "pub fn {f.name}{EmStaticGenerics f.generics}({params}) -> {EmTy f.ret}"
    TmFn (TmSourceDoc "", f.doc), sig, (EmBody f.body)

EmStaticGenerics: fn [((Text, [Text]))] -> Text
fn EmStaticGenerics gs = EmGenerics (Each gs, \|((g, bs))| ((g, (Push bs, "'static"))))

EmJobDef: unbounded fn JobDef -> Text
fn EmJobDef j:
    let gnames = EmGenericNames (Each j.generics, \|((g, ignore))| g)
    let fields = Join (Each j.fields, \|((n, t))| "{n}: {EmTy t},"), "\n"
    let params = Join (Each j.fields, \|((n, t))| "{n}: {EmTy t}"), ", "
    # A job is an `Rc<dyn Job>`, so its type parameters live as long as the program.
    let bounded = EmStaticGenerics j.generics
    let start = "pub fn {j.start}{bounded}({params}) -> Rc<dyn prism_rtl::Job<{EmTy j.ret}>>"
    let startBody = "Rc::new({j.name} \{ {Join (Each j.fields, \|((n, ignore))| n), ", "} \})"
    TmJob (TmSourceDoc "", j.doc), j.name, gnames, bounded, fields, (EmTy j.ret), (EmBody j.body), start, startBody

# A type, its derives, and its printer and plain-data impls (docs/backend.md, "Printing").
EmTyDef: unbounded fn TyDef -> Text
fn EmTyDef t:
    let eq = t.eq and not t.floaty
    let ord = t.ord and not t.floaty
    let derives = Join (Filter [["Clone", (if t.eq or t.ord: "PartialEq" else: ""), (if eq or ord: "Eq" else: ""), (if t.ord: "PartialOrd" else: ""), (if ord: "Ord" else: "")]], \|d| d != ""), ", "
    let head = "{t.name}{EmGenericNames t.params}"
    let doc = TmSourceDoc "`{t.prism}`:", t.doc
    let decl = match t.kind:
        "record":
            let c = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]]))
            TmStruct doc, derives, head, (Join (Each c.fields, \|((f, ft))| "pub {f}: {EmTy ft},"), "\n")
        "unit": TmTupleStruct doc, derives, head, ""
        "newtype":
            let c = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]]))
            TmTupleStruct doc, derives, head, "({Join (Each c.fields, \|((ignore, ft))| "pub {EmTy ft}"), ", "})"
        otherwise: TmEnum doc, derives, head, (Join (Each t.cases, \|c| EmCase c), "\n")
    let show = if t.show == "derive": "\n{EmShowImpl t, head}" else: ""
    let pod = if t.pod: "\n{EmToPodImpl t, head}\n{EmFromPodImpl t, head}" else: ""
    "{decl}{show}{pod}"

EmCase: unbounded fn CaseDef -> Text
fn EmCase c = if (Len c.fields) == 0: "{c.name}," else: "{c.name}({Join (Each c.fields, \|((ignore, ft))| EmTy ft), ", "}),"

# The bound variables of a case, `a0, a1`.
EmBinders: fn Nat -> [Text]
fn EmBinders n = Each (Range0 n), \|i| "a{i}"

EmCasePattern: fn TyDef, CaseDef -> Text
fn EmCasePattern t, c = match t.kind:
    "newtype": "{t.name}({Join (EmBinders (Len c.fields)), ", "})"
    "unit": t.name
    otherwise: if (Len c.fields) == 0: "{t.name}::{c.name}" else: "{t.name}::{c.name}({Join (EmBinders (Len c.fields)), ", "})"

# `derive ^Show`: one printer call per constructor; the printer decides the parentheses.
EmShowImpl: unbounded fn TyDef, Text -> Text
fn EmShowImpl t, head:
    let body = match t.kind:
        "record":
            let c = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]]))
            "p.record(\"{t.prism}\", &[{Join (Each c.fields, \|((f, ignore))| "(\"{EmPrismField f}\", &self.{f})"), ", "}]);"
        otherwise: TmMatchSelf (Join (Each t.cases, \|c| "{EmCasePattern t, c} => p.choice(\"{c.prism}\", &[{Join (EmBinders (Len c.fields)), ", "}]),"), "\n")
    TmImpl (EmBounded t.params, "Show"), "Show", head, "fn show(&self, p: &mut Printer)", body

# A field's Prism spelling: the Rust one without the `_` a keyword took.
EmPrismField: fn Text -> Text
fn EmPrismField f = if (Drop f, (Dec (Len f))) == "_": Take f, (Dec (Len f)) else: f

EmToPodImpl: unbounded fn TyDef, Text -> Text
fn EmToPodImpl t, head:
    let body = match t.kind:
        "record":
            let c = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]]))
            "Pod::record(\"{t.prism}\", vec![{Join (Each c.fields, \|((f, ignore))| "(\"{EmPrismField f}\", self.{f}.to_pod())"), ", "}])"
        otherwise: TmMatchSelf (Join (Each t.cases, \|c| "{EmCasePattern t, c} => Pod::Choice(\"{c.prism}\".into(), vec![{Join (Each (EmBinders (Len c.fields)), \|b| "{b}.to_pod()"), ", "}]),"), "\n")
    let shown = if t.show == "own": TmShownPod body else: body
    TmImpl (EmBounded t.params, "ToPod"), "ToPod", head, "fn to_pod(&self) -> Pod", shown

EmFromPodImpl: unbounded fn TyDef, Text -> Text
fn EmFromPodImpl t, head:
    let body = match t.kind:
        "record":
            let c = Or t.cases[0], (CaseDef(name="", prism="", fields=[[]]))
            "Ok({t.name} \{ {Join (Each c.fields, \|((f, ignore))| "{f}: FromPod::from_pod(field(p, \"{EmPrismField f}\")?)?"), ", "} \})"
        otherwise:
            let arms = Each t.cases, \|c|
                let n = Len c.fields
                let made = if n == 0: (if t.kind == "unit": t.name else: "{t.name}::{c.name}") else: "{if t.kind == "newtype": t.name else: "{t.name}::{c.name}"}({Join (Each (Range0 n), \|i| "FromPod::from_pod(&a[{i}])?"), ", "})"
                "Pod::Choice(c, a) if &**c == \"{c.prism}\" && a.len() == {n} => Ok({made}),"
            TmFromPod (Join arms, "\n"), "a {t.prism}"
    TmImpl (EmBounded t.params, "FromPod"), "FromPod", head, "fn from_pod(p: &Pod) -> Result<Self, Fault>", body

EmTagDef: unbounded fn TagDef -> Text
fn EmTagDef t:
    let fields = Join (Each t.fields, \|((ignore, f, ft))| "pub {f}: {EmTy ft},"), "\n"
    let pods = Join (Each t.fields, \|((p, f, ignore))| "(\"{p}\", self.{f}.to_pod())"), ", "
    TmTag (TmSourceDoc "The `Level` of `{t.tagName}`:", t.doc), t.name, fields, t.tagName, pods

# ---------------------------------------------------------------------------------------
# Nodes and programs
# ---------------------------------------------------------------------------------------

EmNodeDef: unbounded fn NodeDef -> Text
fn EmNodeDef n:
    let fields = Join (Each n.fields, \|((f, t, doc))| "{TmDoc doc}{f}: {EmTy t},"), "\n"
    let consts = Concat (Each n.consts, \|((c, h, doc))| "{TmDoc "The {doc}."}const {c}: u32 = {h};\n")
    let params = Concat (Each n.params, \|((p, t))| "{p}: {EmTy t}, ")
    let ret = if n.fallible: "Result<Rc<{n.name}>, Fault>" else: "Rc<{n.name}>"
    let computed = Filter n.inits, \|((ignore, v))| not (EmIsRaw v)
    let moved = Filter n.inits, \|((ignore, v))| EmIsRaw v
    let inits = Join (Append [["path"]], (Each (Append computed, moved), \|((f, v))| EmFieldInit f, v)), ", "
    let tail = if n.fallible: "Ok(node)" else: "node"
    let restText = if (Len n.build) == 0: tail else: "{EmDos n.build}\n{tail}"
    let build = TmBuild n.name, params, ret, (EmDos n.lets), inits, restText
    let methods = Join (Each n.methods, \|m| EmMethod m), "\n"
    let answer = if (Len n.answers) == 0: "" else: TmAnswer (Join (Each n.answers, \|((pat, call))| "{pat} => {EmEx call},"), "\n")
    let builders = Concat (Append (Each n.builders, \|b| "\n{EmForDef b}"), (Each n.gens, \|gd| "\n{EmGenDef gd}"))
    let rowImpl = if n.rowKind == "": "" else: "\n{EmRowImpl n}"
    let hooks = Join (Each n.hooks, \|((h, body))| TmHook h, (EmDos body)), "\n"
    let doc = TmSourceDoc "`{n.prism}`: a node of its own (docs/backend.md, \"A widget block\").", n.doc
    "{TmNode doc, n.name, fields, consts, build, "{methods}{builders}", hooks, answer}{rowImpl}"

# A field initializer that moves a local: written last, after the ones that read it.
EmIsRaw: fn Ex -> Bool
fn EmIsRaw (XRaw ignore) = True
fn EmIsRaw other = False

# A `for`'s builder: rows that left torn down, new keys built, kept rows updated.
EmForDef: unbounded fn ForDef -> Text
fn EmForDef b = TmForBuild b.name, "{b.pos}", (EmEx b.source), (EmTy b.keyTy), (EmTy b.valueTy), b.rowNode, (Concat (Each b.passed, \|x| ", {EmEx x}"))

# A `rebuild`'s builder: the old generation torn down, the next one built.
EmGenDef: unbounded fn GenDef -> Text
fn EmGenDef gd = TmGenBuild gd.name, "{gd.pos}", (EmEx gd.source), (EmTy gd.valueTy), (EmEx gd.select)

# A row's leaving (prelude `Row`): its places torn down, its subscriptions let go.
EmRowImpl: unbounded fn NodeDef -> Text
fn EmRowImpl n = TmRowImpl n.name, (Join (Each n.subs, \|((ev, m, ignore))| "if let (Some(p), Some(h)) = (self.parent.upgrade(), self.{m}_sub.take()) \{\n    p.{ev}_port.unsubscribe(h);\n\}"), "\n")

EmMethod: unbounded fn MethDef -> Text
fn EmMethod m:
    let recv = if m.recv == "rc": "self: &Rc<Self>" else: "&self"
    let cx = if m.cx == "mut": ", cx: &mut Cx" else: if m.cx == "ref": ", cx: &Cx" else: ""
    let params = Concat (Each m.params, \|((p, t))| ", {p}: {EmTy t}")
    let ret = if m.ret == RsUnit: "" else: " -> {EmTy m.ret}"
    let sig = "fn {m.name}({recv}{params}{cx}){ret}"
    let body = if m.ret == RsUnit: EmDos m.body else: if (Len m.body) == 0: EmBody m.tail else: "{EmDos m.body}\n{EmBody m.tail}"
    TmMethod (TmDoc m.doc), sig, body

EmProgram: unbounded fn ProgDef, Bool -> Text
fn EmProgram p, fallible:
    let n = Len p.params
    let names = Each p.params, \|((a, ignore))| a
    let decode = if n == 0: "let _ = args;" else: EmDecodeArgs p, names
    let call = "{p.node}::build(Path::root(), {Concat (Each names, \|a| "{a}, ")}&mut cx){if fallible: "?" else: ""}"
    TmProgram p.name, p.prism, p.node, decode, call

EmDecodeArgs: unbounded fn ProgDef, [Text] -> Text
fn EmDecodeArgs p, names:
    let n = Len names
    let plural = if n == 1: "" else: "s"
    let head = "let [{Join names, ", "}] = args else \{ return Err(Fault::answer(\"@{p.prism} takes {n} argument{plural}\")) \};"
    Join (Append [[head]], (Each p.params, \|((a, t))| "let {a} = {EmDecodeHead t}::from_pod({a})?;")), "\n"

# ---------------------------------------------------------------------------------------
# The crate
# ---------------------------------------------------------------------------------------

EmModule: unbounded fn ModDef -> Text
fn EmModule m:
    let uses = if (Len m.uses) == 0: "" else: "#[allow(unused_imports)]\nuse crate::\{{Join m.uses, ", "}\};"
    TmModule (if m.prism == "": "The root module" else: "The module `{m.prism}`"), m.path, uses, (Join (Each m.items, \|it| EmItem it), "\n")

# Whether a node is built fallibly: the program's `?`.
EmNodeFallible: fn Model, Text -> Bool
fn EmNodeFallible model, path = Fold model.mods, False, \|f, m| Fold m.items, f, \|f2, it| match it:
    ItNode n: f2 or ("{m.name}::{n.name}" == path and n.fallible)
    otherwise: f2

# The crate's files: path and text.
EmitCrate: unbounded fn Model, Text, [Text] -> [((Text, Text))]
fn EmitCrate model, runtime, scripts:
    let gui = match model.?root:
        ? r: r.world == "canvas"
        nil: False
    let cargo = TmCargo model.name, runtime, (if gui: "\"canvas\"" else: "")
    let mods = Concat (Each model.mods, \|m| "mod {m.name};\n")
    let programs = Join (Each (EmAllPrograms model), \|p| EmProgram p, (EmNodeFallible model, p.node)), "\n"
    let regs = Concat (Each model.programs, \|p| ".program::<{p.name}>(\"{p.prism}\")\n")
    let checks = Concat (Each model.checks, \|c| ".check(\"{c.name}\", || vec![{Join (Each c.lines, \|l| EmEx l), ", "}])\n")
    let scriptList = Concat (Each scripts, \|s| "\"{LoEscape s}\",\n")
    let runRoot = match model.?root:
        ? r: TmRunRoot r.name
        nil: TmNoRoot model.name
    let world = match model.?root:
        ? r: r.world
        nil: "test"
    let main = TmMain model.name, "mod prelude;\n{mods}", programs, "{regs}{checks}", scriptList, runRoot, world
    let files = Each model.mods, \|m| (("src/{m.name}.rs", (EmModule m)))
    Append [[(("Cargo.toml", cargo)), (("src/main.rs", main)), (("src/prelude.rs", (TmPrelude "")))]], files

# Every program, the root's among them, once.
EmAllPrograms: fn Model -> [ProgDef]
fn EmAllPrograms model = match model.?root:
    ? r: if Fold model.programs, False, \|f, p| f or p.name == r.name: model.programs else: Push model.programs, r
    nil: model.programs
