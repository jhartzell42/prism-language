#!/usr/bin/env bash
# `basic-chess`: the basic chess example in a window, `prism run examples/basic-chess`.
# Options go to `prism run`.
#
# Written by Claude on the claude-document-chess branch; subject to change.
set -eu
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case "$link" in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
bin=$(cd "$(dirname "$self")" && pwd)
exec "$bin/prism" run "$@" "$bin/../examples/basic-chess"
