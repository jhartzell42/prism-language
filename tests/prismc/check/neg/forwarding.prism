# `forwarding`: the remainder after the answered tags leaves the host's row.
module Sandbox
emit r
use Fs.*

@Sandbox: fn @a emit Fs.* | r -> @a
fn @Sandbox @child:
    ((x, ignore)) <- @HostDocument @child, \|p, e| match e:
        Fs.Contents(..): @ $ (~ Contents(text="sandboxed"))
        otherwise: @Element e
    @ x
