# A widget of several clauses in a static position whose clauses end on a dynamic, bound
# by the caller: not lowered (the clause's dynamic is the generation's, which the caller
# would follow), refused loudly. Its plain-result twin lowers
# (tests/conformance/sem-ch08-clause-plain-result). Written by Claude on the claude-bugs
# branch; subject to change.
emit Ui.*
use Ui.*

@Pick: fn ?Nat -> @$Text
fn @Pick nil:
    !go <- Ui.Button(label=$"none")                              # 0
    $said <- "zero" then "zero!" on !go
    @ $said
fn @Pick (? n):
    !go <- Ui.Button(label=$"some {n}")                          # 0
    $said <- "n{n}" then "n{n}!" on !go
    @ $said

@main: @unit
@main:
    $picked <- @Pick (? 3)                                       # 0
    Ui.Label(text=$"{$picked}")                                  # 1
