# A quantified function (`forall o. fn ..`) is a function, so a parameter of that type may
# take a capital name and be called: `Use` names its `Echo` `Echo` and calls it. Found by
# the step 3 build on the library (`@HostSeats`'s `Supply`, a `Supplier d`).
# Written by Claude on the claude-self-hosting branch; subject to change.

type Echo = forall a. fn a -> a

Use: fn Echo -> Nat
fn Use Echo = Echo 3
