# The dynamic arms' tests: declarations of sem-ch04-building-match-dynamic.
emit Ui.*
use App.*

test a_loud_arm, @Panel (Loud "hey"):
    build
        => expect Ui.Label(text="hey 0 0")
    click at 1
        => expect Ui.Label(text="hey 1 0")
    click at 0
        => expect Ui.Label(text="hey 1 1")

test a_soft_arm, @Panel Soft:
    build
        => expect Ui.Label(text="soft 0")
    click at 0
        => expect Ui.Label(text="soft 1")
