# `mark-stack`: a blueprint's element binds a live field with its stack (doubt WL). A
# supplier's `e` is the live element, not a document's snapshot, so `text=t` hides a `$`.
emit Ui.*

@Shout: fn @a -> @a
fn @Shout @child:
    ((x, ignore)) <- @HostDocument @child, \|p, e| match e:
        Ui.Label(text=t): @Element Ui.Label(text=t)
        otherwise: @Element e
    @ x
