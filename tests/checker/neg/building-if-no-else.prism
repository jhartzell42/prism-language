# An `if` chooses between two branches, so it has an `else` (Jimmy's ruling IE: "if needs
# else"), a building `if` on a line of a widget block included: the checker passes this one
# today. Expected diagnostic derived by hand from the ruling. Written by Claude on the
# claude-bugs branch; subject to change.
emit Ui.*
use Ui.*

@Greeting: fn Bool -> @unit
fn @Greeting loud:
    Ui.Label($text=$"hello")
    if loud:
        Ui.Label($text=$"HELLO")

@page: @unit
@page:
    @Greeting True
