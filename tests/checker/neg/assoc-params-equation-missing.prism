# Jimmy's ruling, 12 November: associated types with parameters, generic. `Out` takes a
# parameter of the kind `Mode`, a closed choice, so the impl covers every case of `Mode`.
# It gives `Idle` and `Heating` and leaves out `Boiled`: an error at the impl naming it.
# Expected diagnostic derived by hand. Written by Claude on the claude-self-hosting
# branch; subject to change.
type Mode = choice:
    Idle
    Heating
    Boiled
derive ^Eq, ^Show

trait ^Appliance a:
    type Out (m: Mode)

type Kettle = record:
    degrees: Nat

impl ^Appliance Kettle:
    type Out Idle = Nat
    type Out Heating = Text
