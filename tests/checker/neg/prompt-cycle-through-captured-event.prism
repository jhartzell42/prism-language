# A prompt cycle through an event a lambda captures (Jimmy, 14 November, ruling PT,
# choice (a); a soundness hole before it): `@Use` is prompt in its function parameter, so
# the line that gives it a lambda reads what the lambda captures, `!fed`; `!fed` reads
# `!out` in the same tick, and `!out` is `@Use`'s result: `!press` fires `!fed`, which
# fires the lambda's result, `Make`'s, `!made`, `!out`, and `!fed` again, in one tick.
# Expected text derived by hand; never run.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit Ui.*

@Use: fn prompt (fn !Nat -> @!Nat) -> @!Nat
fn @Use Make:
    !made <- Make never
    @ !made

@host: @unit
@host:
    !press <- Ui.Button($label=$"press")
    let !fed = (1 on !press) <| !out
    !out <- @Use \|!ignored| @ !fed
    $seen <- 0 then !out
    Ui.Label($text=$"{$seen}")
