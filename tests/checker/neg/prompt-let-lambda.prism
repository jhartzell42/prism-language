# `prompt-cycle`: a lambda a `let` binds is read where its name is passed or called, by
# following the binding (pick PS). `@broken`'s `a` hands `Apply` the lambda `f`, which
# reads `b`, and `b` reads `a`; `@fine`'s lambda reads its own parameter, and checks
# clean.
emit Ui.*

Apply: fn Nat, (fn Nat -> Nat) -> Nat
fn Apply x, F = F x

@broken: @unit
@broken:
    let F = \|x| x + b
    let a = Apply 1, F
    let b = a + 1
    Ui.Label($text=$"{a}")

@fine: @unit
@fine:
    let F = \|x| x + 1
    let a = Apply 1, F
    let b = a + 1
    Ui.Label($text=$"{b}")
