# Written by Claude (host-4, the prismc run), 11 November 2026; subject to change.
# `prompt-cycle`: a widget function binds the result of a widget function it was given
# (`Seats $state, !responses`), and what it gives back, `!responses`, is lifted over that
# result's event. The function given at the program's one use, `@Echo`, gives its
# `!responses` straight back, so its result is prompt in it (Semantics ch. 7, "There are no
# cycles": each widget function has a summary, which arguments its result depends on
# promptly): `!asked` and `!responses` would fire each other in one tick.
emit Ui.*

@Echo: fn $Nat, !Nat -> @((unit, !Nat)) emit Ui.*
fn @Echo $state, !responses:
    Ui.Label($text=$"{$state}")                                    # 0
    @ ((unit, !responses))

@Loop: fn Nat, (fn $Nat, !Nat -> @((a, !Nat)) emit rest) -> @a emit rest
fn @Loop initial, Seats:
    ((results, !asked)) <- Seats $state, !responses
    let !responses = !asked + 1
    $state <- initial then !responses
    @ results

@host: @unit
@host:
    @Loop 0, @Echo
