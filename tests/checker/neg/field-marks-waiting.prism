# `mark-stack` through a waiting field read (pick FD; gap FM): two records have `n`, so
# `r.n` in the lambda waits for the record, which `Both` decides on the next line; the
# field is a `?Nat`, and the access shows no `?`.
type Left = record:
    n: ?Nat

type Right = record:
    n: ?Nat

Both: fn Nat -> Nat
fn Both k:
    let Get = \|r| r.n
    Or (Get (Left(n=? k))), 0
