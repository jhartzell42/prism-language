# `prompt-cycle`: a read in a `match` guard is a prompt read. `!a`'s only read of `!b` is
# in a guard and `!b` reads `!a`, so `@broken` has a cycle; `@fine`'s `!b` reads the
# button instead, and checks clean.
emit Ui.*

@broken: @unit
@broken:
    !go <- Ui.Button($label=$"Go")
    let !a = match 0:
        k if (Len [[!b <| 0 on !go]]) > k: !go
        otherwise: !go
    let !b = 2 + (0 on !a)
    Ui.Label($text=$"x")

@fine: @unit
@fine:
    !go <- Ui.Button($label=$"Go")
    let !a = match 0:
        k if (Len [[!b <| 0 on !go]]) > k: !go
        otherwise: !go
    let !b = 2 + (0 on !go)
    Ui.Label($text=$"x")
