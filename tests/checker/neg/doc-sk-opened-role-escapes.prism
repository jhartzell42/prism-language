# Part III ch. 6, doubt SK, and Type System ch. 7, "Traits during inference": a seat key,
# `any (r: Role d): ((Fixed r, SeatId d r))`, opened in a `match` arm gives a fresh rigid role type
# that may not reach the arm's result. The arm hands back the seat id, a `SeatId d r` at
# the arm's own `r`, so the hidden role would leave the arm: `existential-escape` at the
# arm's result. `Described role, id`, a `Text`, would be fine.
# Expected text derived by hand, in the wording of neg/existential-escape; never run.
# Written by Claude on the claude-self-hosting branch; subject to change.
trait ^Document d:
    type Role
    type SeatId (r: Role d)

type SeatKey d = any (r: Role d): ((Fixed r, SeatId d r))

Leaked: fn SeatKey d -> Text where d: ^Document
fn Leaked seatKey:
    let id = match seatKey:
        any ((role, seat)): seat
    "leaked"
