# `mismatch`: a closed local lambda generalizes with its waiting associated-type equation
# (`Item a = Text`) as a constraint (GHC's MonoLocalBinds, Jimmy's ruling SH); its use at a
# number pair cannot meet it, and is refused there: the item is `Nat` where `Takes` wants
# `Text`.
trait ^Box a:
    type Item
    Open: fn a -> Item a

type Pair a = record:
    one: a
    two: a

impl ^Box (Pair a):
    type Item = a
    fn Open p = p.one

Takes: fn Text -> Nat
fn Takes t = Len t

Wrong: fn Nat -> Nat
fn Wrong n:
    let G = \|x| Takes (Open x)
    G (Pair(one=n, two=n))
