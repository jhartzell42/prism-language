# Part III ch. 6, "Families indexed by document and role": matching a tag of `Seat.* d _`
# learns its role as a fresh type in the arm, so the `Seat.Query(..)` arm's output is
# `$?(Answer Count ρ)` for that arm's `ρ`, and the supplier must answer exactly that. This
# arm answers with a raiser's answer, a number, as if every role were a raiser: the
# literal's `^Num` at `Answer Count ρ`, which no equation decides for that arm's `ρ`, is
# `no-impl` at the literal. (A watcher is told a `Text`.) Expected text first derived by
# hand as a `mismatch`; since the soundness fix that refuses a constraint on an undecided
# associated type where it is solved (ca931cfd), the literal's constraint is what is
# refused, the text p13 gives.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit Ui.*

trait ^Document d:
    type Role
    type Query (r: Role d)
    type Answer (r: Role d)

type CountRole = choice:
    Raiser
    Watcher

type Count = record:
    total: Nat

type Whole = choice:
    Whole

impl ^Document Count:
    type Role = CountRole
    type Query r = Whole
    type Answer Raiser = Nat
    type Answer Watcher = Text

family Seat d (r: Role d) where d: ^Document

tag Seat.Query of Element $?(Answer d r):
    $query: Query d r

@Raising: @unit emit Seat.* Count Raiser
@Raising:
    $?told <- Seat.Query($query=$ Whole)

@Watching: @unit emit Seat.* Count Watcher
@Watching:
    $?told <- Seat.Query($query=$ Whole)

@Guests: @unit emit Seat.* Count _
@Guests:
    @Raising
    @Watching

@page: @unit
@page:
    ignore <- @Host @Guests, \|path, element| match element:
        Seat.Query(..): @ $ (? 5)
