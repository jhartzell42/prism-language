# `lens-map-key` (Jimmy's ruling ME, 11 November): a named lens cannot end at a map key,
# nor step through one: a key's part is an entry, not a location. The `update` block's
# own index paths (`&_.board[sq] <= nil`, Semantics ch. 5, "References and lens paths")
# stay, and so does a lens to an array's index.
# Written by Claude on the claude-lowering branch; subject to change.
type Regs = record:
    acc: Int
    x: Int

&?Named: fn &(Text ==> Int) -> &?Int
fn &?Named &registers = &registers["acc"]

&Inside: fn &(Text ==> Regs) -> &Int
fn &Inside &machines = &machines["first"].acc

Fine: fn (Text ==> Int) -> (Text ==> Int)
fn Fine registers = update registers:
    &_["acc"] <= nil
