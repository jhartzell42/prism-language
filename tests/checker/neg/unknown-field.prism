# `unknown-field`: an argument names its field as declared: `Pad.Note`'s field is `$text`,
# so `text=` names no field, and a plain record's `name` is no `?name`. Written by Claude on
# the claude-bugs branch; subject to change.
emit Ui.* | Pad.*

tag Pad.Note of Element unit:
    $text: Text

type Person = record:
    name: Text

@page: @unit
@page:
    let ann = Person(?name="Ann")
    ignore <- Pad.Note(text=$"hi")
# sigil-rename: skip (this test writes the forms the rename would change)
