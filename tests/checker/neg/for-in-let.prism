# `for` builds its block once per entry (Semantics ch. 4, "`for`"), so written as a value
# it is a blueprint, `@(Nat ==> Nat)`, as in a plain function (neg for-in-plain-function);
# a `let` of a widget block names that blueprint and builds nothing (`<-` builds it), so
# the name is no map. The checker types it as the plain map today, and prismc's back end
# refuses it ("a `for` outside a widget block as a value"). Written by Claude on the
# claude-lowering branch; subject to change.
emit Ui.*
use Ui.*

Count: fn (Nat ==> Nat) -> Nat
fn Count m = Size m

@main: @unit
@main:
    let xs = [[1, 2, 3]]
    let doubled = for x <- xs: @ x * 2
    Ui.Label($text=$"{Count doubled}")
