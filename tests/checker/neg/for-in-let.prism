# `for` builds its block once per entry and keeps each built block (Semantics ch. 4,
# "`for`"): it is a builder, and `<-` is the line that builds and binds its result. A
# `let` builds nothing, so a `for` on its right is an error, as a `for` in a plain
# function is (neg for-in-plain-function). The checker types it as the plain map today,
# and prismc's back end refuses it ("a `for` outside a widget block as a value"). Written
# by Claude on the claude-lowering branch; subject to change.
emit Ui.*
use Ui.*

Count: fn (Nat ==> Nat) -> Nat
fn Count m = Size m

@main: @unit
@main:
    let xs = [[1, 2, 3]]
    let doubled = for x <- xs: @ x * 2
    Ui.Label($text=$"{Count doubled}")
