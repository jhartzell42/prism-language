# A prompt cycle through a lambda a `let` puts in a record (ruling PT, choice (a)): what a
# function value captures is read by whatever holds it, so `box` reads `!fed`, and the
# line that gives `box` to `@Use`, prompt in it, reads `box`. Claude found the hole after
# choice (a) closed the one of a lambda written inside the argument itself.
# Expected text derived by hand; never run.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit Ui.*

type Box = record:
    @make: fn !Nat -> @!Nat

@Use: fn prompt Box -> @!Nat
fn @Use box:
    !made <- box.@make never
    @ !made

@host: @unit
@host:
    !press <- Ui.Button($label=$"press")
    let !fed = (1 on !press) <| !out
    let box = Box(@make=\|!ignored| @ !fed)
    !out <- @Use box
    $seen <- 0 then !out
    Ui.Label($text=$"{$seen}")
