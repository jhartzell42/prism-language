# Semantics ch. 7 and decisions.md D6: a cycle point at every call of an unbounded function
# from an unbounded function, the continuation saved as the machine's state. `Total` is not a
# tail call: each walk waits for both halves, so the job keeps a frame per pending `+`.
# Written for this test, to count the cycles of a recursion that is not a loop. Work in
# progress, subject to change.
emit Ui.*
test mod Tests

type Tree = choice:
    Leaf Nat
    Node Tree, Tree
derive ^Eq, ^Show

# The sum of the leaves. A tree of four nodes below the root is four calls, so five cycles:
# the first, and one after each call is entered.
Total: unbounded fn Tree -> Nat
fn Total (Leaf n) = n
fn Total (Node l, r):
    let a = Total l
    a + (Total r)

@Summed: fn Tree -> @unit
fn @Summed tree:
    !done <- @Run Total, tree                                 # 0
    $shown <- "working" then Show !done
    Ui.Label($text=$shown)                                   # 1
