# A generic widget function (`@Shown` over any `^Show` type) inlined at two calls of
# different types: its body at each call is lowered at that call's types. Written by Claude
# on the claude-bugs branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

@Shown: fn $a, Text -> @unit where a: ^Show
fn @Shown $x, label:
    Ui.Label(text=$"{label}={Show $x}")                          # 0

@main: @unit
@main:
    !go <- Ui.Button(label=$"go")                                # 0
    $n <- 1 then $n + 1 on !go
    @Shown $n, "n"                                               # 1
    @Shown $"t{$n}", "t"                                         # 2
