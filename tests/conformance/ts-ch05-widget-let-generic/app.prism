# Written by Claude on the claude-self-hosting branch; subject to change.
# A generalized `let` of a widget block (Type System ch. 5, a local `let` generalizes)
# used at two instantiations: a node field per instantiation,
# as an expression block's is a local per instantiation. `Twin`
# is used at Nat, in a plain label and over a hold, and at Bool.
emit Ui.*
test mod Tests

@shown: @unit
@shown:
    let Twin = \|x| ((x, x))
    !more <- Ui.Button($label=$"more")                       # 0
    $n <- 1 then $n + 1 on !more
    Ui.Label($text=$"{Show (Twin 3)} {Show (Twin True)}")    # 1
    Ui.Label($text=$"{Show (Twin $n)}")                      # 2
