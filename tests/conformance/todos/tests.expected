test todos_keep_their_rows

tick 0
  added:
    0: Ui.Button(label="Add")

tick 1
  in:
    0: click
  added:
    1/[0]/0: Ui.Button(label="Toggle")
    1/[0]/1: Ui.Button(label="Delete")
    1/[0]/2: Ui.Button(label="Star")
    1/[0]/3: Ui.Label(text="[ ] item 0")

tick 2
  in:
    1/[0]/2: click
  changed:
    1/[0]/3: Ui.Label(text="[ ] item 0 *")

tick 3
  in:
    1/[0]/0: click
  changed:
    1/[0]/3: Ui.Label(text="[x] item 0 *")

tick 4
  in:
    0: click
  added:
    1/[1]/0: Ui.Button(label="Toggle")
    1/[1]/1: Ui.Button(label="Delete")
    1/[1]/2: Ui.Button(label="Star")
    1/[1]/3: Ui.Label(text="[ ] item 1")

tick 5
  in:
    0: click
  added:
    1/[2]/0: Ui.Button(label="Toggle")
    1/[2]/1: Ui.Button(label="Delete")
    1/[2]/2: Ui.Button(label="Star")
    1/[2]/3: Ui.Label(text="[ ] item 2")

test the_star_follows_its_item

tick 0
  added:
    0: Ui.Button(label="Add")

tick 1
  in:
    0: click
  added:
    1/[0]/0: Ui.Button(label="Toggle")
    1/[0]/1: Ui.Button(label="Delete")
    1/[0]/2: Ui.Button(label="Star")
    1/[0]/3: Ui.Label(text="[ ] item 0")

tick 2
  in:
    0: click
  added:
    1/[1]/0: Ui.Button(label="Toggle")
    1/[1]/1: Ui.Button(label="Delete")
    1/[1]/2: Ui.Button(label="Star")
    1/[1]/3: Ui.Label(text="[ ] item 1")

tick 3
  in:
