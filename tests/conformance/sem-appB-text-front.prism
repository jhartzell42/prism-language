# Semantics Appendix B, Text: `Front` is the cursor at a text's start.
# Written by Claude on the claude-self-hosting branch; subject to change.

let sample = "héllo→世界"

# The first character, through the cursor at the front.
?FirstChar: fn Text -> ?Char
fn ?FirstChar t = match ?Step (Front t):
    ? ((c, ignore)): ? c
    nil: nil
