# A `let` above the line that binds a bundle with a late plain part, whose tuple pattern
# names that part (Semantics ch. 4, "Binding groups and cycles": any line may use any name
# the block binds, and "the order of a group's lines decides positions and nothing else";
# a `let` binds by any pattern that cannot fail; Type System ch. 2, "Bundles").
# Written by Claude on the claude-lowering branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

type Mode = choice:
    Loud Text
    Soft
derive ^Eq, ^Show

@Choose: fn Mode -> @((Nat, !Click))
fn @Choose mode:
    n <- match mode:
        Loud t:
            Ui.Label($text=$"{t}")
            @ 10
        Soft:
            @ 20
    !go <- Ui.Button($label=$"go")
    @ ((n, !go))

@Page: fn Mode -> @unit
fn @Page mode:
    let ((step, !go)) = both
    $total <- 0 then $total + step on !go
    Ui.Label($text=$"total {$total}")
    both <- @Choose mode
