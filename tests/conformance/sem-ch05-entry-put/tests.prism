# The tests of sem-ch05-entry-put.
emit r
use App.*

check put:
    (Place start, 3, "R") == Game(board={{1: "K", 2: "Q", 3: "R"}}, turn=0) => True
    (Place start, 1, "R") == Game(board={{1: "R", 2: "Q"}}, turn=0) => True

check remove:
    (Clear start, 1) == Game(board={{2: "Q"}}, turn=0) => True
    (Clear start, 5) == start => True

check read:
    (Move start, 1, 3) == Game(board={{2: "Q", 3: "K"}}, turn=1) => True
    (Move start, 5, 2) == Game(board={{1: "K"}}, turn=1) => True
    ?At start, 2 => ? "Q"
    ?At start, 5 => nil
