# sem-ch04-building-match-on-built-late-value-above where the lower `match`'s arm hosts
# a child beside the widget that gives its result: the host's place takes its number from what the `match` above built, which
# reads the arm's result (Semantics ch. 4, "Binding groups and cycles": "the order of a
# group's lines decides positions and nothing else"; ch. 9: a host re-emits its child's
# places under its own; ruling TC: places are counted as they are built). Nothing here
# is a cycle.
# Written by Claude on the claude-lowering branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

type Mode = choice:
    Loud Text
    Soft
derive ^Eq, ^Show

@Sized: fn Text -> @Nat
fn @Sized t:
    Ui.Label($text=$"{t}")
    @ Len t

@note: @unit
@note:
    Ui.Label($text=$"note")

@Panel: fn Mode -> @unit
fn @Panel mode:
    match n -? 15:                                                     # 0 and 1, or 0
        ? over:
            Ui.Label($text=$"over by {over}")
        nil:
            Ui.Label($text=$"under")
            Ui.Label($text=$"at {n}")
    n <- match mode:
        Loud t:
            size <- @Sized t                                           # 2
            ignore <- @Host @note, \|p, e| @Element e          # 3/[p]
            @ size + 9
        Soft:
            @ 20
    Ui.Label($text=$"below {n}")                                       # 4, or 1

@Page: fn Mode -> @unit
fn @Page mode:
    @Panel mode
