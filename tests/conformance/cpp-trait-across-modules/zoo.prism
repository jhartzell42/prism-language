# The impl of cpp-trait-across-modules (the root says why), in a module the trait's module
# never names. Written by Claude on the claude-self-hosting branch; subject to change.
module Zoo
emit Ui.*
use Aloud.*

type Bird = choice:
    Robin
    Wren
derive ^Eq, ^Show

impl ^Loud Bird:
    fn Loud Robin = "cheer"
    fn Loud Wren = "tit"
