# A `let` of a lambda in a hosted child under a host below a building `if`, closing over
# a name a pattern of its own binds inside the plain part of a place's bundle answer
# written below it, used at two types, so the `let` is generalized (Semantics ch. 4,
# "Binding groups and cycles"; ch. 9; Type System ch. 1). Reaches `LatePlainPartOf`'s
# marker "the name `a` inside the plain part of a late place's answer" on prismc-fd1.
# Written by Claude (sweep-7, the prismc run), 12 November 2026; subject to change.
emit Ui.* | Pad.*
test mod Tests
use Ui.*

tag Pad.Pair of Element ((((Nat, Nat)), $Text)):
    name: Text

Second: fn ((t, Nat)) -> Nat
fn Second ((ignore, k)) = k

@Inner: @unit
@Inner:
    let Wrap = \|x| ((x, a))
    Ui.Label($text=$"{Second (Wrap 1)} {Second (Wrap "a")}")                     # [0]
    ((((a, b)), $s)) <- Pad.Pair(name="pair")                          # [1]
    Ui.Label($text=$"{a} {b} {$s}")                                   # [2]

@Page: fn Bool -> @unit
fn @Page loud:
    if loud:
        Ui.Label($text=$"before")
    ignore <- @Host @Inner, \|p, e| match e:
        Pad.Pair(..): @ ((((3, 4)), $"up"))
        otherwise: @Element e

