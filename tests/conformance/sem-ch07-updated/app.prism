# A dynamic is a behavior and an event. `!Updated $d` is the event half of any dynamic,
# a hold's or a derived one's: it fires at n, at its height, with the value after n, in the
# same tick as the change that caused it; a sample of the same dynamic in that tick (`$d on
# !e`) reads the value as the tick opened (Semantics R2). The event fires whenever the
# dynamic is recomputed, deduped by nobody (pick UD: `$same` is `$a * 0`, always 0, and its
# event fires on every click). Written for prismc's back end. Work in progress, subject to
# change.
emit Ui.*
test mod Tests
use Ui.*

@halves: @unit
@halves:
    !bump <- Ui.Button($label=$"bump")                           # 0
    $a <- 0 then $a + 1 on !bump
    let $b = $a + 1
    let !newB = !Updated $b                                     # the event half: after n
    let !oldB = $b on !newB                                     # the behavior half: as n opened
    $lastNew <- 0 then !newB
    $lastOld <- 0 then !oldB
    $holdFired <- 0 then $holdFired + 1 on (!Updated $a)
    let $same = $a * 0
    $sameFired <- 0 then $sameFired + 1 on (!Updated $same)
    Ui.Label($text=$"b {$lastNew} was {$lastOld}")               # 1
    Ui.Label($text=$"a fired {$holdFired}, same fired {$sameFired}")   # 2
