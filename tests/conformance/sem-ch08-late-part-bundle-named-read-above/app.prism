# A bundle with a late plain part, bound whole to one name and passed to a widget by a
# line above the line that binds it (Semantics ch. 4, "Binding groups and cycles": any
# line may use any name the block binds, and "the order of a group's lines decides
# positions and nothing else"; ch. 8: `<-` builds the child and binds its result; Type
# System ch. 2, "Bundles"). sem-ch08-late-part-bundle-named with the reader above.
# Written by Claude on the claude-lowering branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

type Mode = choice:
    Loud Text
    Soft
derive ^Eq, ^Show

@Choose: fn Mode -> @((Nat, !Click))
fn @Choose mode:
    n <- match mode:
        Loud t:
            Ui.Label($text=$"{t}")
            @ 10
        Soft:
            @ 20
    !go <- Ui.Button($label=$"go")
    @ ((n, !go))

@Counter: fn ((Nat, !Click)) -> @unit
fn @Counter ((step, !go)):
    $total <- 0 then $total + step on !go
    Ui.Label($text=$"total {$total}")

@Page: fn Mode -> @unit
fn @Page mode:
    @Counter both
    both <- @Choose mode
