# The row values' tests: declarations of ts-ch02-row-values.prism (Semantics chapter 6).
emit Ui.* | Pad.*
use App.*

test marks_are_data, @sketch:
    build
    click Ui.Button(label="Add")

check inks:
    Width Ink.Line(from=2, to=7) => 5
    Ink.Line(from=2, to=7) => Ink.Line(from=2, to=7)
    Width Ink.Line(from=7, to=2) => 0
    Lines Ink.Fill(box=(Box 3, 4), marks=[[Ink.Line(from=0, to=1), Ink.Fill(box=(Box 1, 1), marks=[[Ink.Line(from=4, to=1)]])]]) => 2
    Ink.Line(from=1, to=2) == Ink.Line(from=1, to=2) => True
    Ink.Line(from=1, to=2) == Ink.Line(from=2, to=1) => False
