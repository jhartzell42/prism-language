# Bundles made by holds in constructors: declarations of ts-ch02-constructor-hold.
emit Ui.*
use App.*

test bundles_follow_their_parts, @page:
    build
        => expect Ui.Label(text="0/0")
    click at 0
        => expect Ui.Label(text="1/0")
    click at 1
        => expect Ui.Label(text="2/10")
