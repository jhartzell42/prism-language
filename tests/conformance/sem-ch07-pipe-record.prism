# A record field holding an unbounded function that takes a function (as prismc's own
# `EvRef.pipe`): a `let`-bound lambda in a bounded function fills it, passing on a lambda
# of its own;
# a `Start`'s function parameters are `Start`s whatever color the lambda's own type gives
# them. Written for prismc's back end. Work in progress, subject to change.
emit Ui.*

type Pipe = record:
    run: unbounded fn Nat, (unbounded fn Nat -> Nat) -> Nat

Id: unbounded fn Nat, (unbounded fn Nat -> Nat) -> Nat
fn Id x, K = K x

Wrap: fn Pipe, Nat -> Pipe
fn Wrap p, v:
    let Run = \|x, K| p.run x, \|ignore| K v
    Pipe(run=Run)

Grow: unbounded fn Nat -> Nat
fn Grow n = n + 1

Go: unbounded fn Nat -> Nat
fn Go n:
    let p = Wrap (Pipe(run=Id)), n
    p.run 0, Grow

@Piped: fn Nat -> @unit
fn @Piped n:
    !done <- @Run Go, n                                     # 0
    $shown <- "working" then Show !done
    Ui.Label(text=$shown)                                   # 1
