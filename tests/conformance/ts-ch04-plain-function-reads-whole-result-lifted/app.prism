# A plain function (no dynamic in its signature) whose body adds 1 to the dynamic a function
# that takes time whole gives, and hands the sum to a function with a `$` parameter (Type
# System ch. 4, Application).
# Written by Claude on the claude-lowering branch; subject to change.
emit Ui.*
test mod Tests

Gen: fn Nat -> [$Nat]
fn Gen n = [[$ n]]

$Head: fn [$Nat] -> $Nat
fn $Head xs = Or xs[0], ($ 0)

Five: fn $Nat -> Nat
fn Five $a = 5

Pick: fn Nat -> Nat
fn Pick n = Five (($Head (Gen n)) + 1)

@shown:
    Ui.Label($text=$"pick {Pick 3}")      # 0
