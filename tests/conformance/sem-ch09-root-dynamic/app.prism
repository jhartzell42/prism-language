# A root's dynamic result through two hosts (as `@$main`'s through `@Window`): each host's
# result is its child's, and the World hears the root's value at the build and whenever
# it moves. Written for prismc's back end. Work in progress, subject to change.
emit Ui.*
test mod Tests

@Wrap: fn @a -> @a
fn @Wrap @child:
    ((r, ignore)) <- @Host @child, \|p, e| @Element e
    @ r

@$counter: @$Text
@$counter:
    !inc <- Ui.Button($label=$"inc")
    $n <- 0 then $n + 1 on !inc
    @ $"{$n}"

@$inner: @$Text
@$inner:
    @Wrap @$counter

@$twice: @$Text
@$twice:
    @Wrap @$inner
