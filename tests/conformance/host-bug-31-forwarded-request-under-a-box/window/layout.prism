# `Window.Layout`, a child module of `Window`.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit r | Pane.* | Gui.*
use Window.*
use Window.Panes.*
use Window.Hosting.*
use Window.Widgets.*
use Window.Hits.*

# ---------------------------------------------------------------------------
# Layout as plain functions over plain data (layout.md): room down, size up, placed by the
# parent. A box's children are its host's document, `$(Path ==> $Elem)` (Jimmy, 6 November
# 2026), so the window lays out each element in a `for` row of its own (`@Laid`, in
# widgets.prism), one row per child: each row ends on its element's `Res`, plain data with
# `^Eq` holding its `Plan` in the room its parent gave it, so a change re-lays only the rows
# on its path and an equal result moves nothing above it. A `Plan` is a layout with its
# placing as data: its size and its `Part`, which `PlaceAt` places at an origin in the view,
# the part of the window that shows: a leaf whose ink falls wholly outside the view draws
# nothing and has no hits, so a change costs the commands of what the window shows, not of
# the whole tree. The placing is one plain pass at the window (`PlaceAt`).

type HitKind = choice:
    Clickable
    Focus
    Track Nat, Nat                            # a slider's, from low to high
    Opaque                                    # a frame's background: it takes the press, and answers nothing
derive ^Eq, ^Show

type Hit = record:
    rect: Rect
    chain: [Path]
    kind: HitKind
    turns: [Window.Turn]                      # the turns of the frames above it, outermost first
derive ^Eq, ^Show

type Placed = record:
    draw: [Draw]
    hits: [Hit]

type Room = record:
    minW: Float
    maxW: Float
    minH: Float
    maxH: Float
derive ^Eq, ^Show

# What an element is, for its layout: a leaf's data, a container's kind and spec; an element
# that is not the library's is laid as nothing.
type Kind = choice:
    KLabel Text
    KButton Text
    KInput Text, Nat
    KImage Text, Paint
    KSlider Nat, Nat, Nat                  # value, low, high
    KStack Bool, Float, Align              # down, spacing, align: VBox, HBox, Row, Column
    KLayers
    KShown Bool
    KFrame FrameSpec
    KGrid Nat
    KNone
derive ^Eq, ^Show

# A layout: its size, and how it is placed.
type Plan = record:
    size: Extent
    part: Part
derive ^Eq, ^Show

# A layout's placing as data: what `PlaceAt` draws at an origin in a view.
type Part = choice:
    PNothing
    PLabel Extent, [Text], Float                  # ink, lines, line height
    PButton Extent, Text, [Path]                  # ink, label, chain
    PInput Extent, Text, Nat, Float, [Path]       # ink, text, cursor, the text to the cursor's width, chain
    PImage Text, Paint, [Path]
    PSlider Float, Nat, Nat, [Path]               # how far along, low, high, chain
    PStack Bool, Float, Align, Float, [Plan]      # down, spacing, align, cross size, children
    PLayers [((Point, Point, Plan))]              # each child's anchor, offset and layout
    PFrame FrameSpec, Plan
    PGrid Nat, [Float], [Float], [Plan]           # columns, their widths, the rows' heights, children
derive ^Eq, ^Show

# A laid-out element, as its row ends on it: its kind, the room its parent gave it, its
# chain of paths from the window, its children's (the row's own `for` over them, by path), a
# leaf's measured texts, and its layout in that room. A parent that lays a child in another
# room (flex, stretch, a grid's cells) lays it again from this.
type Res = record:
    kind: Kind
    room: Room
    chain: [Path]
    kids: Path ==> Res
    sizes: Text ==> Extent
    plan: Plan
derive ^Eq, ^Show

Merged: fn Placed, Placed -> Placed
fn Merged a, b = Placed (Append a.draw, b.draw), (Append a.hits, b.hits)

let nothing = Placed [[]], [[]]

let unplanned = Plan (Extent 0.0, 0.0), PNothing

let huge = 1000000.0

let cell = 64.0

# the view inside a turned or scaled frame: everything, since nothing there is culled
let everywhere = Rect 0.0 - huge, 0.0 - huge, 2.0 * huge, 2.0 * huge

# 0 to n - 1
Indices: fn Nat -> [Nat]
fn Indices n = match n -? 1:
    ? m: Push (Indices m), m
    nil: [[]]

Bounded: fn Float -> Bool
fn Bounded x = x < huge

Ratio: fn Float, Float -> Float
fn Ratio a, b = if b == 0.0: 0.0 else: a / b

Clamp: fn Float, Float, Float -> Float
fn Clamp x, lo, hi = Max lo, (Min x, hi)

Loose: fn Float, Float -> Room
fn Loose w, h = Room 0.0, w, 0.0, h

Tight: fn Extent -> Room
fn Tight e = Room e.w, e.w, e.h, e.h

Fit: fn Room, Extent -> Extent
fn Fit r, e = Extent (Clamp e.w, r.minW, r.maxW), (Clamp e.h, r.minH, r.maxH)

# the view of a whole window of size `e`
Whole: fn Extent -> Rect
fn Whole e = Rect 0.0, 0.0, e.w, e.h

# whether ink in `r` can show in the view `v`: they overlap or touch
Shown: fn Rect, Rect -> Bool
fn Shown r, v = r.x <= v.x + v.w and v.x <= r.x + r.w and r.y <= v.y + v.h and v.y <= r.y + r.h

TextExtent: fn (Text ==> Extent), Text -> Extent
fn TextExtent sizes, t = Or sizes[t], (Extent 0.0, 0.0)

Padded: fn Extent, Float -> Extent
fn Padded e, p = Extent e.w + 2.0 * p, e.h + 2.0 * p

# a container's children in their paths' order (each knows its own chain)
Kids: fn (Path ==> Res) -> [Res]
fn Kids cs = Values cs

# the place at the end of a chain, the path a test clicks by
?Innermost: fn [Path] -> ?Path
fn ?Innermost chain:
    i <- (Len chain) -? 1
    chain[i]

ClickableAt: fn Rect, [Path] -> [Draw]
fn ClickableAt r, chain = match ?Innermost chain:
    ? p: [[Draw.Clickable(rect=r, path=p)]]
    nil: [[]]

# ---- an element as the layout reads it: its kind, its children, and the texts it asks the
# World to measure (each distinct word of a label and the space, a button's label, an
# input's text and its text up to the cursor)

KindOf: fn Elem -> Kind
fn KindOf e = match e:
    Pane.Label($text=$t): KLabel $t
    Pane.Button($label=$l): KButton $l
    Pane.TextInput($text=$t, $cursor=$c, ..): KInput $t, $c
    Pane.Image($src=$s, $paint=$b): KImage $s, $b
    Pane.Slider($value=$v, low=lo, high=hi): KSlider $v, lo, hi
    Pane.VBox(..): KStack True, 0.0, Start
    Pane.HBox(..): KStack False, 0.0, Start
    Pane.Column(spacing=g, align=a, ..): KStack True, g, a
    Pane.Row(spacing=g, align=a, ..): KStack False, g, a
    Pane.Layers(..): KLayers
    Pane.Shown($shown=$s, ..): KShown $s
    Pane.Frame($spec=$s, ..): KFrame $s
    Pane.Grid(columns=n, ..): KGrid n
    otherwise: KNone

# a container's children: its host's document, each child's dynamic by its path
KidsOf: fn Elem -> (Path ==> $Elem)
fn KidsOf e = match e:
    Pane.VBox($children=$cs): $cs
    Pane.HBox($children=$cs): $cs
    Pane.Row($children=$cs, ..): $cs
    Pane.Column($children=$cs, ..): $cs
    Pane.Layers($children=$cs): $cs
    Pane.Shown($children=$cs, ..): $cs
    Pane.Frame($children=$cs, ..): $cs
    Pane.Grid($children=$cs, ..): $cs
    otherwise: {{}}

# a text split at its spaces, a character at a time, walked with a cursor
Words: fn Text -> [Text]
fn Words t:
    let ((done, word)) = update (([[]], "")):
        let &c = Front t
        while ? ((ignore, next)) <- ?Step &c:
            &_ <= WordStep &_, (CharText &c)
            &c <= next
    Finished done, word

# The character at a cursor as a one-character text: the start of the text after it.
CharText: fn Cursor -> Text
fn CharText c = match ?Step (Front (After c)):
    ? ((ignore, one)): Before one
    nil: ""

WordStep: fn (([Text], Text)), Text -> (([Text], Text))
fn WordStep ((done, word)), c = if c == " ": (((Finished done, word), "")) else: ((done, "{word}{c}"))

Finished: fn [Text], Text -> [Text]
fn Finished done, word = if (Len word) > 0: Push done, word else: done

Joined: fn [Text], Text -> Text
fn Joined ws, sep = Fold ws, "", \|acc, w| if acc == "": w else: "{acc}{sep}{w}"

# a label's words and the space; a button's label; an input's text and its text to the cursor
TextsOf: fn Elem -> (Text ==> unit)
fn TextsOf e = match e:
    Pane.Label($text=$t): Fold (Words $t), {{" ": unit}}, \|a, w| Insert a, w, unit
    Pane.Button($label=$l): {{$l: unit}}
    Pane.TextInput($text=$t, $cursor=$c, ..): Insert {{$t: unit}}, (TextBefore $t, $c), unit
    otherwise: {{}}

# ---- labels, wrapped by words at the room's width

SpaceW: fn (Text ==> Extent) -> Float
fn SpaceW sizes = (TextExtent sizes, " ").w

LineH: fn (Text ==> Extent) -> Float
fn LineH sizes = (TextExtent sizes, " ").h

WordsW: fn (Text ==> Extent), [Text] -> Float
fn WordsW sizes, ws:
    let gaps = Float (Int (Or ((Max (Len ws), 1) -? 1), 0))
    (Fold ws, 0.0, \|acc, w| acc + (TextExtent sizes, w).w) + (SpaceW sizes) * gaps

type Lines = record:
    done: [Text]
    line: [Text]

WrapStep: fn (Text ==> Extent), Float, Lines, Text -> Lines
fn WrapStep sizes, maxW, acc, w = if (Len acc.line) == 0 or (WordsW sizes, (Push acc.line, w)) <= maxW: Lines acc.done, (Push acc.line, w) else: Lines (Push acc.done, (Joined acc.line, " ")), [[w]]

Wrap: fn (Text ==> Extent), Text, Float -> [Text]
fn Wrap sizes, t, maxW:
    let r = Fold (Words t), (Lines [[]], [[]]), \|acc, w| WrapStep sizes, maxW, acc, w
    if (Len r.line) == 0: r.done else: Push r.done, (Joined r.line, " ")

LineAt: fn Float, Point, ((Float, [Draw])), Text -> ((Float, [Draw]))
fn LineAt lineH, p, ((y, draws)), l:
    let d = Draw.Text(at=(Point p.x + 4.0, p.y + 4.0 + y), text=l)
    ((y + lineH, (Push draws, d)))

LinesDraw: fn Float, [Text], Point -> [Draw]
fn LinesDraw lineH, lines, p:
    let ((ignore, draws)) = Fold lines, ((0.0, [[]])), \|acc, l| LineAt lineH, p, acc, l
    draws

# its ink is its lines and their margin, before the room clamps its size
LayLabel: fn (Text ==> Extent), Text, Room -> Plan
fn LayLabel sizes, t, room:
    let natural = (WordsW sizes, (Words t)) + 8.0
    let lines = if natural <= room.maxW: [[t]] else: Wrap sizes, t, room.maxW - 8.0
    let width = if natural <= room.maxW: natural else: (Fold lines, 0.0, \|m, l| Max m, (WordsW sizes, (Words l))) + 8.0
    let ink = Extent width, (LineH sizes) * (Float (Int (Len lines))) + 8.0
    Plan (Fit room, ink), (PLabel ink, lines, (LineH sizes))

# ---- the other leaves

ButtonAt: fn Point, Extent, Text, [Path] -> Placed
fn ButtonAt p, size, l, chain:
    let box = Rect p.x + 2.0, p.y + 2.0, size.w - 4.0, size.h - 4.0
    let draws = [[Draw.Rect(rect=box, paint=Grey), Draw.Text(at=(Point p.x + 8.0, p.y + 8.0), text=l)]]
    Placed (Append draws, (ClickableAt box, chain)), [[(Hit box, chain, Clickable, [[]])]]

# its ink is its box and its text, before the room clamps its size
LayButton: fn (Text ==> Extent), Text, Room, [Path] -> Plan
fn LayButton sizes, l, room, chain:
    let ink = Padded (TextExtent sizes, l), 8.0
    Plan (Fit room, ink), (PButton ink, l, chain)

# a white box, the text, and a caret bar when the input has focus
InputDraw: fn ?[Path], Rect, [Path], Text, Float -> [Draw]
fn InputDraw ?focus, r, chain, t, beforeW:
    let caretX = r.x + 4.0 + beforeW
    let caret = match ?focus:
        ? f if f == chain: [[Draw.Rect(rect=(Rect caretX, r.y + 3.0, 2.0, r.h - 6.0), paint=Ink)]]
        otherwise: [[]]
    let box = [[Draw.Rect(rect=r, paint=Blue), Draw.Rect(rect=(Rect r.x + 1.0, r.y + 1.0, r.w - 2.0, r.h - 2.0), paint=Paper), Draw.Text(at=(Point r.x + 4.0, r.y + 4.0), text=t)]]
    Append (Append box, caret), (ClickableAt r, chain)

InputAt: fn ?[Path], Point, Extent, Text, Float, [Path] -> Placed
fn InputAt ?focus, p, size, t, beforeW, chain:
    let r = Rect p.x, p.y, size.w, size.h
    Placed (InputDraw ?focus, r, chain, t, beforeW), [[(Hit r, chain, Focus, [[]])]]

LayInput: fn (Text ==> Extent), Text, Nat, Room, [Path] -> Plan
fn LayInput sizes, t, c, room, chain:
    let te = TextExtent sizes, t
    let ink = Extent (Max te.w + 8.0, 200.0), te.h + 8.0
    Plan (Fit room, ink), (PInput ink, t, c, (TextExtent sizes, (TextBefore t, c)).w, chain)

ImageAt: fn Rect, Text, Paint, [Path] -> Placed
fn ImageAt r, src, paint, chain:
    let draws = [[Draw.Rect(rect=r, paint=paint), Draw.Image(rect=r, src=src)]]
    Placed (Append draws, (ClickableAt r, chain)), [[(Hit r, chain, Clickable, [[]])]]

LayImage: fn Text, Paint, Room, [Path] -> Plan
fn LayImage src, paint, room, chain = Plan (Fit room, (Extent cell, cell)), (PImage src, paint, chain)

# a track, its filled part and a knob; a press on it answers a step (`Track`)
SliderAt: fn Point, Extent, Float, Nat, Nat, [Path] -> Placed
fn SliderAt p, size, along, low, high, chain:
    let r = Rect p.x, p.y, size.w, size.h
    let mid = p.y + size.h * 0.5
    let knobX = p.x + (size.w - 8.0) * along
    let draws = [[Draw.Rect(rect=(Rect p.x, mid - 2.0, size.w, 4.0), paint=Grey), Draw.Rect(rect=(Rect p.x, mid - 2.0, knobX + 4.0 - p.x, 4.0), paint=Blue), Draw.Rect(rect=(Rect knobX, p.y + 2.0, 8.0, size.h - 4.0), paint=Ink)]]
    Placed (Append draws, (ClickableAt r, chain)), [[(Hit r, chain, (Track low, high), [[]])]]

# how far along from `low` to `high` a value is, from 0 to 1
Along: fn Nat, Nat, Nat -> Float
fn Along v, low, high = Clamp (Ratio (Float (Int (Or (v -? low), 0))), (Float (Int (Or (high -? low), 0)))), 0.0, 1.0

LaySlider: fn Nat, Nat, Nat, Room, [Path] -> Plan
fn LaySlider v, low, high, room, chain = Plan (Fit room, (Extent 200.0, 22.0)), (PSlider (Along v, low, high), low, high, chain)

# ---- a child's layout in a room: its row's own when it is the room its row was laid in,
# else laid again from its result

PlanIn: fn Res, Room -> Plan
fn PlanIn r, room = if room == r.room: r.plan else: LayRes r, room

LayRes: fn Res, Room -> Plan
fn LayRes r, room = LayKind r.kind, r.sizes, r.kids, room, r.chain

# The room a container lays its children in first, from its own: what each child's row is
# laid in (`@Laid`), so the container reuses its children's layouts where that room stands.
KidRoom: fn Kind, Room -> Room
fn KidRoom k, room = match k:
    KStack down, ignore, ignore: NaturalRoom down, room
    KLayers: Loose room.maxW, room.maxH
    KShown ignore: NaturalRoom True, room
    KFrame s: NaturalRoom True, (FrameInner s, room)
    KGrid ignore: Loose huge, huge
    otherwise: room

# ---- rows and columns: natural and fixed children first, the free room shared by flex, then
# placed one after another with the spacing, aligned across

FlexOf: fn Res -> Float
fn FlexOf r = match r.kind:
    KFrame s: s.flex
    otherwise: 0.0

MainOf: fn Bool, Extent -> Float
fn MainOf down, e = if down: e.h else: e.w

CrossOf: fn Bool, Extent -> Float
fn CrossOf down, e = if down: e.w else: e.h

MainMax: fn Bool, Room -> Float
fn MainMax down, r = if down: r.maxH else: r.maxW

CrossMax: fn Bool, Room -> Float
fn CrossMax down, r = if down: r.maxW else: r.maxH

RoomFor: fn Bool, Float, Float, Float, Float -> Room
fn RoomFor down, mlo, mhi, clo, chi = if down: Room clo, chi, mlo, mhi else: Room mlo, mhi, clo, chi

# the room a stack lays each child in first: any length, its own breadth at most
NaturalRoom: fn Bool, Room -> Room
fn NaturalRoom down, room = RoomFor down, 0.0, huge, 0.0, (CrossMax down, room)

ExtentOf: fn Bool, Float, Float -> Extent
fn ExtentOf down, m, c = if down: Extent c, m else: Extent m, c

PointOf: fn Bool, Point, Float, Float -> Point
fn PointOf down, p, m, c = if down: Point p.x + c, p.y + m else: Point p.x + m, p.y + c

FixedMain: fn Bool, [Res], [Plan], Nat -> Float
fn FixedMain down, kids, natural, i = match kids[i]:
    ? r: if (FlexOf r) > 0.0: 0.0 else: MainOf down, (Or natural[i], unplanned).size
    nil: 0.0

Final: fn [Res], [Plan], Nat, Bool, Float, Float, Room -> Plan
fn Final kids, natural, i, down, free, weights, room = match kids[i]:
    ? r if (FlexOf r) > 0.0 and weights > 0.0:
        let m = Ratio (free * (FlexOf r)), weights
        PlanIn r, (RoomFor down, m, m, 0.0, (CrossMax down, room))
    ? ignore: Or natural[i], unplanned
    nil: unplanned

Restretch: fn [Res], [Plan], Nat, Bool, Float -> Plan
fn Restretch kids, sized, i, down, crossSize = match kids[i]:
    ? r:
        let m = MainOf down, (Or sized[i], unplanned).size
        PlanIn r, (RoomFor down, m, m, crossSize, crossSize)
    nil: unplanned

StackStep: fn Bool, Float, Align, Float, Point, Rect, ?[Path], ((Float, Placed)), Plan -> ((Float, Placed))
fn StackStep down, spacing, align, crossSize, p, v, ?focus, ((off, placed)), l:
    let c = CrossOf down, l.size
    let cOff = match align:
        Middle: Ratio (crossSize - c), 2.0
        End: crossSize - c
        otherwise: 0.0
    let here = PlaceAt l, (PointOf down, p, off, cOff), v, ?focus
    ((off + (MainOf down, l.size) + spacing, (Merged placed, here)))

StackAt: fn Bool, Float, Align, Float, [Plan], Point, Rect, ?[Path] -> Placed
fn StackAt down, spacing, align, crossSize, plans, p, v, ?focus:
    let ((ignore, placed)) = Fold plans, ((0.0, nothing)), \|acc, l| StackStep down, spacing, align, crossSize, p, v, ?focus, acc, l
    placed

LayStack: fn (Path ==> Res), Room, Bool, Float, Align -> Plan
fn LayStack cs, room, down, spacing, align:
    let kids = Kids cs
    let gaps = spacing * (Max ((Float (Int (Len kids))) - 1.0), 0.0)
    let natural = Each kids, \|r| PlanIn r, (NaturalRoom down, room)
    let weights = Fold kids, 0.0, \|acc, r| acc + (FlexOf r)
    # with no flex the natural layouts stand; with it, the fixed length first, then the shares
    let sized = if weights > 0.0: Flexed kids, natural, down, spacing, gaps, weights, room else: natural
    let crossSize = Fold sized, (if down: room.minW else: room.minH), \|m, l| Max m, (CrossOf down, l.size)
    let plans = if align == Stretch: Each (Indices (Len kids)), \|i| Restretch kids, sized, i, down, crossSize else: sized
    let mainSize = (Fold plans, 0.0, \|acc, l| acc + (MainOf down, l.size)) + gaps
    let size = Fit room, (ExtentOf down, mainSize, crossSize)
    Plan size, (PStack down, spacing, align, (CrossOf down, size), plans)

# a stack's children with the free room shared by flex
Flexed: fn [Res], [Plan], Bool, Float, Float, Float, Room -> [Plan]
fn Flexed kids, natural, down, spacing, gaps, weights, room:
    let idx = Indices (Len kids)
    let fixed = Fold idx, 0.0, \|acc, i| acc + (FixedMain down, kids, natural, i)
    let free = if Bounded (MainMax down, room): Max ((MainMax down, room) - fixed - gaps), 0.0 else: 0.0
    Each idx, \|i| Final kids, natural, i, down, free, weights, room

# ---- layers: each child in the whole room, at its frame's anchor and offset; later is on top

AnchorOf: fn Res -> ((Point, Point))
fn AnchorOf r = match r.kind:
    KFrame s: ((s.anchor, s.offset))
    otherwise: (((Point 0.0, 0.0), (Point 0.0, 0.0)))

LayerOf: fn Room, Res -> ((Point, Point, Plan))
fn LayerOf room, r:
    let ((a, o)) = AnchorOf r
    ((a, o, (PlanIn r, (Loose room.maxW, room.maxH))))

LayLayers: fn (Path ==> Res), Room -> Plan
fn LayLayers cs, room:
    let layers = Each (Kids cs), \|r| LayerOf room, r
    let biggest = Fold layers, (Extent 0.0, 0.0), \|m, ((ignore, ignore, l))| Extent (Max m.w, l.size.w), (Max m.h, l.size.h)
    let size = Fit room, (Extent (if (Bounded room.maxW): room.maxW else: biggest.w), (if (Bounded room.maxH): room.maxH else: biggest.h))
    Plan size, (PLayers layers)

LayersAt: fn [((Point, Point, Plan))], Extent, Point, Rect, ?[Path] -> Placed
fn LayersAt layers, size, p, v, ?focus = Fold layers, nothing, \|acc, ((a, o, l))| Merged acc, (PlaceAt l, (Point p.x + (size.w - l.size.w) * a.x + o.x, p.y + (size.h - l.size.h) * a.y + o.y), v, ?focus)

# ---- the frame: a fixed size or an aspect ratio, padding, a background, and a turn

AspectRoom: fn Room, Float -> Room
fn AspectRoom r, a:
    let w0 = if (Bounded r.maxW): r.maxW else: r.maxH * a
    let h0 = Ratio w0, a
    let h = Min h0, r.maxH
    let w = if h0 > r.maxH: h * a else: w0
    Tight (Extent w, h)

FrameRoom: fn FrameSpec, Room -> Room
fn FrameRoom s, room:
    let ?w = match s.?width:
        ? x: ? (Clamp x, room.minW, room.maxW)
        nil: nil
    let ?h = match s.?height:
        ? x: ? (Clamp x, room.minH, room.maxH)
        nil: nil
    let r1 = Room (Or ?w, room.minW), (Or ?w, room.maxW), (Or ?h, room.minH), (Or ?h, room.maxH)
    match s.?aspect:
        ? a: AspectRoom r1, a
        nil: r1

# the room inside a frame's padding
FrameInner: fn FrameSpec, Room -> Room
fn FrameInner s, room:
    let pad2 = 2.0 * s.pad
    let outer = FrameRoom s, room
    Room (Max (outer.minW - pad2), 0.0), (Max (outer.maxW - pad2), 0.0), (Max (outer.minH - pad2), 0.0), (Max (outer.maxH - pad2), 0.0)

TurnPlaced: fn Window.Turn, Placed -> Placed
fn TurnPlaced t, pl = Placed [[Draw.Group(turn=t, draws=pl.draw)]], (Each pl.hits, \|h| Hit h.rect, h.chain, h.kind, (Append [[t]], h.turns))

# a turned or scaled frame culls nothing inside it: its view is everywhere
FrameAt: fn FrameSpec, Plan, Extent, Point, Rect, ?[Path] -> Placed
fn FrameAt s, child, size, p, v, ?focus:
    let level = s.turn == 0.0 and s.scale == 1.0
    let view = if level: v else: everywhere
    let box = Rect p.x, p.y, size.w, size.h
    let bg = match s.?bg:
        ? c if Shown box, view: [[Draw.Rect(rect=box, paint=c)]]
        otherwise: [[]]
    # a background takes the presses its children do not: a dialog over a board
    let shield = if (Len bg) > 0: [[(Hit box, [[]], Opaque, [[]])]] else: [[]]
    let inner = PlaceAt child, (Point p.x + s.pad, p.y + s.pad), view, ?focus
    let flat = Placed (Append bg, inner.draw), (Append shield, inner.hits)
    if level: flat else: TurnPlaced (Turn p.x + size.w * 0.5, p.y + size.h * 0.5, s.turn, s.scale), flat

LayFrame: fn FrameSpec, (Path ==> Res), Room -> Plan
fn LayFrame s, cs, room:
    let pad2 = 2.0 * s.pad
    let outer = FrameRoom s, room
    let child = LayStack cs, (FrameInner s, room), True, 0.0, Stretch
    Plan (Fit outer, (Extent child.size.w + pad2, child.size.h + pad2)), (PFrame s, child)

# ---- the grid: in the children's path order, `n` to a row; each column as wide as its widest
# child and each row as tall as its tallest, every child laid out to fill its cell

# the widest child of column `c`, and the tallest of row `c`
ColumnWidth: fn [Plan], Nat, Nat -> Float
fn ColumnWidth natural, n, c = Fold (Indices (Len natural)), 0.0, \|m, i| if i mod n == c: Max m, (Or natural[i], unplanned).size.w else: m

RowHeight: fn [Plan], Nat, Nat -> Float
fn RowHeight natural, n, c = Fold (Indices (Len natural)), 0.0, \|m, i| if (Or (i / n), 0) == c: Max m, (Or natural[i], unplanned).size.h else: m

Total: fn [Float] -> Float
fn Total xs = Fold xs, 0.0, \|acc, x| acc + x

# where each column or row starts: the sum of those before it
Starts: fn [Float] -> [Float]
fn Starts xs:
    let ((ignore, starts)) = Fold xs, ((0.0, [[]])), \|((at, acc)), x| ((at + x, (Push acc, at)))
    starts

# child `i`'s cell: its column's width and its row's height
CellOf: fn Nat, [Float], [Float], Nat -> Extent
fn CellOf n, widths, heights, i = Extent (Or widths[i mod n], 0.0), (Or heights[Or (i / n), 0], 0.0)

GridStep: fn Nat, [Float], [Float], Point, Rect, ?[Path], ((Nat, Placed)), Plan -> ((Nat, Placed))
fn GridStep n, xs, ys, p, v, ?focus, ((i, placed)), l:
    let at = Point p.x + (Or xs[i mod n], 0.0), p.y + (Or ys[Or (i / n), 0], 0.0)
    ((i + 1, (Merged placed, (PlaceAt l, at, v, ?focus))))

LayGrid: fn Nat, (Path ==> Res), Room -> Plan
fn LayGrid n, cs, room:
    let kids = Kids cs
    let natural = Each kids, \|r| PlanIn r, (Loose huge, huge)
    let widths = Each (Indices n), \|c| ColumnWidth natural, n, c
    let heights = Each (Indices (RowsFor (Len kids), n)), \|c| RowHeight natural, n, c
    let size = Fit room, (Extent (Total widths), (Total heights))
    let plans = Each (Indices (Len kids)), \|i| match kids[i]:
        ? r: PlanIn r, (Tight (CellOf n, widths, heights, i))
        nil: unplanned
    Plan size, (PGrid n, widths, heights, plans)

# how many rows `count` children take, `n` to a row
RowsFor: fn Nat, Nat -> Nat
fn RowsFor count, n = Or ((Or (count + n -? 1), 0) / n), 0

GridAt: fn Nat, [Float], [Float], [Plan], Point, Rect, ?[Path] -> Placed
fn GridAt n, widths, heights, plans, p, v, ?focus:
    let xs = Starts widths
    let ys = Starts heights
    let ((ignore, placed)) = Fold plans, ((0, nothing)), \|acc, l| GridStep n, xs, ys, p, v, ?focus, acc, l
    placed

# ---- the one layout, of a kind over its children's results, and the one placing

LayKind: fn Kind, (Text ==> Extent), (Path ==> Res), Room, [Path] -> Plan
fn LayKind k, sizes, cs, room, chain = match k:
    KLabel t: LayLabel sizes, t, room
    KButton l: LayButton sizes, l, room, chain
    KInput t, c: LayInput sizes, t, c, room, chain
    KImage s, b: LayImage s, b, room, chain
    KSlider v, lo, hi: LaySlider v, lo, hi, room, chain
    KStack down, g, a: LayStack cs, room, down, g, a
    KLayers: LayLayers cs, room
    KShown shown: if shown: LayStack cs, room, True, 0.0, Start else: Plan (Fit room, (Extent 0.0, 0.0)), PNothing
    KFrame s: LayFrame s, cs, room
    KGrid n: LayGrid n, cs, room
    KNone: unplanned

# an element's result in the room its parent gave it: what its row ends on
ResOf: fn Elem, Room, (Path ==> Res), (Text ==> Extent), [Path] -> Res
fn ResOf e, room, cs, sizes, chain:
    let k = KindOf e
    Res(kind=k, room=room, chain=chain, kids=cs, sizes=sizes, plan=(LayKind k, sizes, cs, room, chain))

PlaceAt: fn Plan, Point, Rect, ?[Path] -> Placed
fn PlaceAt l, p, v, ?focus = match l.part:
    PNothing: nothing
    PLabel ink, lines, lineH: if Shown (Rect p.x, p.y, ink.w, ink.h), v: Placed (LinesDraw lineH, lines, p), [[]] else: nothing
    PButton ink, t, chain: if Shown (Rect p.x, p.y, (Max l.size.w, ink.w), (Max l.size.h, ink.h)), v: ButtonAt p, l.size, t, chain else: nothing
    PInput ink, t, ignore, beforeW, chain: if Shown (Rect p.x, p.y, (Max l.size.w, ink.w), (Max l.size.h, ink.h)), v: InputAt ?focus, p, l.size, t, beforeW, chain else: nothing
    PImage src, paint, chain: if Shown (Rect p.x, p.y, l.size.w, l.size.h), v: ImageAt (Rect p.x, p.y, l.size.w, l.size.h), src, paint, chain else: nothing
    PSlider along, low, high, chain: if Shown (Rect p.x, p.y, l.size.w, l.size.h), v: SliderAt p, l.size, along, low, high, chain else: nothing
    PStack down, g, a, crossSize, plans: StackAt down, g, a, crossSize, plans, p, v, ?focus
    PLayers layers: LayersAt layers, l.size, p, v, ?focus
    PFrame s, child: FrameAt s, child, l.size, p, v, ?focus
    PGrid n, widths, heights, plans: GridAt n, widths, heights, plans, p, v, ?focus
