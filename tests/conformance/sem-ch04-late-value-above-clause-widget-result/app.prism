# A widget of several clauses with a plain result applied, above the line that gives it,
# to a building `match`'s late plain result (the arm reads the block, so the `match` is
# built after the node): the line's places are counted as built and its own result is
# read below it (Semantics ch. 4, "Binding groups and cycles": any line may use any name
# the block binds, and "the order of a group's lines decides positions and nothing
# else"; ch. 8: `<-` builds the child and binds its plain result; ruling TC). Nothing
# here is a cycle.
# Written by Claude on the claude-lowering branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

type Mode = choice:
    Loud Text
    Soft
derive ^Eq, ^Show

@Wide: fn Nat -> @Nat
fn @Wide 10:
    Ui.Label($text=$"ten")
    @ 1
fn @Wide k:
    @ 2

@Panel: fn Mode, $Nat -> @unit
fn @Panel mode, $k:
    w <- @Wide n                                                       # 1 when n is 10
    Ui.Label($text=$"wide {w}")                                        # 2, or 1
    n <- match mode:
        Loud t:
            Ui.Label($text=$"{t} {$k}")
            @ 10
        Soft:
            @ 20

@Page: fn Mode -> @unit
fn @Page mode:
    !add <- Ui.Button($label=$"add")                                   # 0
    $k <- 0 then $k + 1 on !add
    @Panel mode, $k
