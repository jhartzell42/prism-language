# Semantics ch. 7, "An unbounded function is a bounded body iterated", and Conformance
# ch. 1, "A job, computed": `Normalize` through `@Run`, one cycle per tick. The book's
# `turing/lambda.prism` is not in the books; this is a lambda calculus of de Bruijn
# indices small enough to read, written for this test.
emit Ui.*
test mod Tests

type Term = choice:
    Var Nat
    Lam Term
    App Term, Term
derive ^Eq, ^Show

# Shift the free variables at or above `cut` by `d`.
Shift: fn Int, Nat, Term -> Term
fn Shift d, cut, (Var n) = if n < cut: Var n else: Var (Or (?Nat ((Int n) + d)), 0)
fn Shift d, cut, (Lam b) = Lam (Shift d, cut + 1, b)
fn Shift d, cut, (App f, x) = App (Shift d, cut, f), (Shift d, cut, x)

# Substitute `s` for variable `j`.
Subst: fn Nat, Term, Term -> Term
fn Subst j, s, (Var n) = if n == j: s else: Var n
fn Subst j, s, (Lam b) = Lam (Subst j + 1, (Shift 1, 0, s), b)
fn Subst j, s, (App f, x) = App (Subst j, s, f), (Subst j, s, x)

# One leftmost-outermost reduction, or `nil` at a normal form. The book calls it `?Step`,
# which is the prelude's cursor step, so here it is `?Reduce`.
?Reduce: fn Term -> ?Term
fn ?Reduce (Var n) = nil
fn ?Reduce (Lam b) = match ?Reduce b:
    ? b2: ? (Lam b2)
    nil: nil
fn ?Reduce (App (Lam b), x) = ? (Shift -1, 0, (Subst 0, (Shift 1, 0, x), b))
fn ?Reduce (App f, x) = match ?Reduce f:
    ? f2: ? (App f2, x)
    nil: match ?Reduce x:
        ? x2: ? (App f, x2)
        nil: nil

Normalize: unbounded fn Term -> Term
fn Normalize t = match ?Reduce t:
    ? t2: Normalize t2
    nil: t

Describe: fn Term -> Text
fn Describe t = Show t

@Normal: fn Term -> @unit
fn @Normal term:
    !done <- @Run Normalize, term                           # 0
    $shown <- "working" then Describe !done
    Ui.Label($text=$shown)                                   # 1
