# The tests of sem-ch09-bundle-dynamic-part.
emit Ui.* | Pad.*
use App.*

test a_socket_under_the_world, @chat:
    with Pad.Socket(address="chat:7000") = "up", build
        => expect Ui.Label(text="up: none")
    send Pad.Socket(..), "hello"
        => expect Ui.Label(text="up: hello")
    push Pad.Socket(address="chat:7000") = "down"
        => expect Ui.Label(text="down: hello")

test a_socket_offline, @offline:
    build
        => expect Ui.Label(text="offline: none")
