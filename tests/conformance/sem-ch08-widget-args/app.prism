# Widget functions taking widget arguments (prismc's pick WB): a widget block passed as a
# value (`@Titled "A", @widget: ..`), a named widget passed (`@counter`), and one applied
# twice (`@Twice`), each inlined where the parameter is applied, so its places take the
# caller's next positions (transparent, Semantics ch. 8) and each application has its own
# holds. Written for prismc's back end. Work in progress, subject to change.
emit Ui.*
test mod Tests

@Titled: fn Text, @unit -> @unit
fn @Titled title, @inner:
    Ui.Label(text=$ title)
    @inner

@Twice: fn @unit -> @unit
fn @Twice @w:
    @w
    @w

@counter: @unit
@counter:
    !inc <- Ui.Button(label=$"+")
    $n <- 0 then $n + 1 on !inc
    Ui.Label(text=$"{$n}")

@page: @unit
@page:
    !poke <- Ui.Button(label=$"poke")                       # 0
    $shown <- "inside" then "poked" on !poke
    @Titled "A", @widget:                                   # 1
        Ui.Label(text=$shown)                               # 2
    @Titled "B", @counter                                   # 3, then 4 and 5
    @Twice @counter                                         # 6 and 7, then 8 and 9
