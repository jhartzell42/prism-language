# A merge of an event with `!Updated` of a mapped dynamic of another node: the dynamic is
# a blueprint value's result, written three combinators on from the click, and a plain
# function that takes it whole in a list maps it and gives its update event as an event
# value (Type System ch. 4). The merge decides once in the tick, after both
# (Semantics ch. 7: "double firings never"). Written by Claude on the claude-lowering
# branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

@Counter: prompt fn !Click -> @$Nat
fn @Counter !bump:
    $count <- 0 then $count + 1 on !bump
    $shown <- 0 then !Updated $count
    $handed <- 0 then !Updated $shown
    @ $handed

?Pick: fn Bool, @a -> ?@a
fn ?Pick b, @w = if b: ? @w else: nil

!Changes: fn [$Nat] -> !Nat
fn !Changes shown = !Updated ((Or shown[0], {$ 0}) + 1)

@page: @unit
@page:
    !bump <- Ui.Button($label=$"bump")                           # 0
    match ?Pick True, (@Counter !bump):                          # 1
        ? @$t:
            $n <- @$t
            let !changed = !Changes [[$n]]
            let !both = (100 on !bump) <| !changed
            $firings <- 0 then $firings + 1 on !both
            $last <- 0 then !both
            $seen <- 0 then !changed
            Ui.Label($text=$"{$firings}: {$last} {$seen}")       # 1
        nil: Ui.Label($text=$"none")
