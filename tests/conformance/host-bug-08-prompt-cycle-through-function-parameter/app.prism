emit Ui.* | Count.* | View.*
mod Documents
mod Counter
test mod Tests
use Documents.*
use Counter.*

@Pressing: fn Presser, Text -> @unit emit Ui.* | Count.*
fn @Pressing seat, name:
    !one <- Ui.Button($label=$"{name} +1")
    !response <- Count.Request(!requests=((Add 1) on !one))
    $total <- Count.Query($query=$ Whole)
    $last <- "nothing yet" then Show !response
    Ui.Label($text=$"{name} sees {$total}; {$last}")

@Seats: fn $Nat, !(Place ==> Response) -> @((unit, ![Asked Nat])) emit Ui.*
fn @Seats $state, !responses:
    !heard <- @HostPressers ($ {{(Presser "ada"): "ada", (Presser "bob"): "bob"}}), @Pressing, $state, !responses
    @ ((unit, InOrder !heard))

@host: @unit
@host:
    @InMemory 0, @Seats
