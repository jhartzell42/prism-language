# Part III ch. 6, doubt SK: a seat key is an existential over the role, `type SeatKey d =
# any (r: Role d): ((Fixed r, SeatId d r))`, since a seat id's type depends on its role.
# The role travels as `Fixed r`, the singleton whose value names its type,
# `Fixed<<Raiser>>` (Jimmy's ruling VO). A key is built with `any ((role, id))` inside a
# function generic in the role `r`. A `match` arm `any ((role, id)): ...` opens the key at
# the arm's own fresh `r`, and the impl's `Described` matches `Fixed<<Raiser>>`, which
# tells it `r` is `Raiser` and so `n` a `Nat`. A record field, `Due.seat`, holds a key.
# Expected transcript derived by hand from Part III ch. 6 (doubt SK) and Type System ch. 3
# ("Existentials"); never run.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit Ui.*
test mod Tests

trait ^Document d:
    type Role
    type SeatId (r: Role d)
    Described: forall (r: Role d). fn Fixed r, SeatId d r -> Text

type CountRole = choice:
    Raiser
    Watcher
derive ^Eq, ^Ord, ^Show

type Count = record:
    total: Nat
derive ^Eq, ^Show

impl ^Document Count:
    type Role = CountRole
    type SeatId Raiser = Nat
    type SeatId Watcher = Text
    fn Described Fixed<<Raiser>>, n = "raiser {n}"
    fn Described Fixed<<Watcher>>, name = "watcher {name}"

# A seat: a role, and a seat id of that role's own type.
type SeatKey d = any (r: Role d): ((Fixed r, SeatId d r))

# A record with a field of an existential type.
type Due d = record:
    seat: SeatKey d
    at: Nat

Keyed: forall d (r: Role d). fn Fixed r, SeatId d r -> SeatKey d where d: ^Document
fn Keyed role, id = any ((role, id))

# The key opened in an arm: the role and the seat id at the arm's own role type.
Told: fn SeatKey d -> Text where d: ^Document
fn Told seatKey = match seatKey:
    any ((role, id)): Described role, id

ToldDue: fn Due d -> Text where d: ^Document
fn ToldDue due = "{Told due.seat} at {due.at}"

@page: @unit
@page:
    let first = Due(seat=(Keyed<<Count, Raiser>> Fixed<<Raiser>>, 3), at=0)
    let second = Due(seat=(Keyed<<Count, Watcher>> Fixed<<Watcher>>, "ada"), at=1)
    Ui.Label($text=$ (ToldDue first))                                           # 0
    Ui.Label($text=$ (ToldDue second))                                          # 1
