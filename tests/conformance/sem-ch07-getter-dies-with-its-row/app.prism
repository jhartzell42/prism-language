# Holds die with their widget (Semantics ch. 7, "Holds die with their widget"), seen
# through a dynamic `let` of the row: when a row leaves the tree, its holds become
# constants with their last values, so a dynamic computed from them alone is a constant
# too, and one that also reads a dynamic outside the row is a stateless combinator that
# goes on reading it. A sibling keeps each through the row's result, and reads it again
# when something else on its line moves. sem-ch07-hold-dies-with-its-row with a `let`.
# Written by Claude on the claude-lowering branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

Wrap: fn $Nat -> [$Nat]
fn Wrap $a = [[$a]]

@ownHolds: @unit
@ownHolds:
    !drop <- Ui.Button($label=$"drop")                            # 0
    !ring <- Ui.Button($label=$"ring")                            # 1
    !keep <- Ui.Button($label=$"keep")                            # 2
    !more <- Ui.Button($label=$"more")                            # 3
    $bonus <- 0 then $bonus + 10 on !more
    $names <- {{1: "one", 2: "two"}} then Remove $names, 2 on !drop
    $all <- for k, $name <- $names:                              # 4/[k]
        $rings <- 0 then $rings + 1 on !ring
        let $twice = $rings * 2
        Ui.Label($text=$"{$name} {$rings}")                       # 4/[k]/0
        @ Wrap $twice
    $kept <- {{}} then $all on !keep
    for k, $part <- $kept:                                       # 5/[k]
        for j, $each <- $part:                                   # 5/[k]/0/[j]
            Ui.Label($text=$"kept {$each} {$bonus}")              # 5/[k]/0/[j]/0

@withOutside: @unit
@withOutside:
    !drop <- Ui.Button($label=$"drop")                            # 0
    !ring <- Ui.Button($label=$"ring")                            # 1
    !keep <- Ui.Button($label=$"keep")                            # 2
    !more <- Ui.Button($label=$"more")                            # 3
    $bonus <- 0 then $bonus + 10 on !more
    $names <- {{1: "one", 2: "two"}} then Remove $names, 2 on !drop
    $all <- for k, $name <- $names:                              # 4/[k]
        $rings <- 0 then $rings + 1 on !ring
        let $total = $rings + $bonus
        Ui.Label($text=$"{$name} {$rings}")                       # 4/[k]/0
        @ Wrap $total
    $kept <- {{}} then $all on !keep
    for k, $part <- $kept:                                       # 5/[k]
        for j, $each <- $part:                                   # 5/[k]/0/[j]
            Ui.Label($text=$"kept {$each}")                       # 5/[k]/0/[j]/0
