# A bundle with a late plain part, bound whole to one name, given another by a `let`
# (`let same = both`), and read as one value under that name by a
# line above the line that binds it: a function's argument in a place's field
# (Semantics ch. 4, "Binding groups and cycles": any line may use any name the block
# binds; Type System ch. 2, "Bundles": a bundle is a plain aggregate, a value a function
# takes). Written by Claude on the claude-lowering branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

type Mode = choice:
    Loud Text
    Soft
derive ^Eq, ^Show

@Choose: fn Mode -> @((Nat, !Click))
fn @Choose mode:
    n <- match mode:
        Loud t:
            Ui.Label($text=$"{t}")
            @ 10
        Soft:
            @ 20
    !go <- Ui.Button($label=$"go")
    @ ((n, !go))

StepOf: fn ((Nat, !Click)) -> Nat
fn StepOf ((step, ignore)) = step

@Page: fn Mode -> @unit
fn @Page mode:
    Ui.Label($text=$"step {StepOf same}")
    let same = both
    both <- @Choose mode
