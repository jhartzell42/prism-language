# Two traits each declare an associated type `Item`, in two modules, and one type
# implements both with different choices: a crate opens to its count and pours its label.
# An associated type is a type-level name of its trait's module (Jimmy's ruling AK): the
# root's own `Item` is `^Box`'s, and `^Bag`'s is `Bags.Item`, reached by qualification as
# any name of another module is. Written by Claude on the claude-bugs branch; subject to
# change.
emit Ui.*
mod Bags
test mod Tests

trait ^Box a:
    type Item
    Open: fn a -> Item a

type Crate = record:
    count: Nat
    label: Text
derive ^Eq, ^Show

impl ^Box Crate:
    type Item = Nat
    fn Open c = c.count

impl ^Bags.Bag Crate:
    type Item = Text
    fn Pour c = c.label

Opened: fn a -> Item a where a: ^Box
fn Opened x = Open x

Poured: fn a -> Bags.Item a where a: ^Bags.Bag
fn Poured x = Bags.Pour x

@main: @unit
@main:
    let c = Crate(count=4, label="figs")
    Ui.Label($text=$"{(Open c) + 1} {Bags.Pour c}! {(Opened c) + 2} {Poured c}?")    # 0
