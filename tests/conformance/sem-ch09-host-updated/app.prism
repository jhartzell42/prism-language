# A host's child document is `$(Path ==> $Elem c)` (Jimmy, 6 November 2026), and a program
# that wants it as one flat value of elements writes the `for` that flattens each entry
# (claude/incremental-host-document.md, part 4): `$flat` is that `for`'s gathered dynamic,
# and `!Updated $flat` its event half. A click on the forwarded child button moves the
# child's label in its tick; the label's entry is published in the tick after (the host
# level's tick, round 3 ST), its row's `$e` follows it there, and the gathered `$flat`
# is published in the tick after that (the gathered `for`'s tick): the host counts `$flat`'s
# updates there and shows the child's label text out of it. Written for prismc's back end.
# Work in progress, subject to change.
emit Ui.*
test mod Tests
use Ui.*

@child: @unit
@child:
    !inc <- Ui.Button($label=$"inc")                              # 0
    $n <- 0 then $n + 1 on !inc
    Ui.Label($text=$"{$n}")                                       # 1

Texts: fn (Path ==> Elem Ui.*) -> Text
fn Texts doc = Fold (Values doc), "", \|acc, e| match e:
    Ui.Label($text=$t): "{acc}[{$t}]"
    Ui.*: acc

@counter: @unit
@counter:
    ((ignore, $doc)) <- @Host @child, \|p, e| @Element e    # 0/[p]/0
    $flat <- for p, $e <- $doc:                                   # 1/[p], no places
        @ $e
    let !moved = !Updated $flat
    $moves <- 0 then $moves + 1 on !moved
    $latest <- "" then Texts !moved
    Ui.Label($text=$"{$moves} moves, latest {$latest}")           # 2
