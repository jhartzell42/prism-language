# Regular expressions as values: declarations of ts-ch02-regex-values.
emit r
use App.*

check equality:
    %/a/ == %/a/ => True
    %/a/ == %/a/i => False
    %/a/ == %/b/ => False
    %/a/b/ == %/a/b/ => True
    %/a/b/ == %/a/c/ => False
    %/a/b/i == %/a/b/ => False
    [[%/a/, %/b/]] == [[%/a/, %/b/]] => True
    (?Find %/b/, "abc") == (?Find %/b/, "abc") => True
    (?Find %/b/, "abc") == (?Find %/c/, "abc") => False

check show:
    Show %/a\/b/i => "%/a\\/b/i"
    Show %/(\w+) (\w+)/$2 $1/ => "%/(\\w+) (\\w+)/$2 $1/"
    Show Rule(name="n", pattern=%/x/) => "Rule(name=\"n\", pattern=%/x/)"
    Show (?Find %/b/, "ab") => ? "Match(text=\"b\", front=Cursor(at=1), back=Cursor(at=2), groups=[[? Group(text=\"b\", front=Cursor(at=1), back=Cursor(at=2))]], named=\{\{\}\})"
    Show (?Find %/(?<x>c)|d/, "c") => ? "Match(text=\"c\", front=Cursor(at=0), back=Cursor(at=1), groups=[[? Group(text=\"c\", front=Cursor(at=0), back=Cursor(at=1)), ? Group(text=\"c\", front=Cursor(at=0), back=Cursor(at=1))]], named=\{\{\"x\": Group(text=\"c\", front=Cursor(at=0), back=Cursor(at=1))\}\})"

check passing:
    Classify "42" => "number"
    Classify "Hello" => "word"
    Classify "4x" => "none"
    Count %/a/, "banana" => 3
    Twice %/ab/a/, "aabb" => "aa"
    Show (Or rules[1], (Rule(name="", pattern=%//))).pattern => "%/^[a-z]+$/i"
