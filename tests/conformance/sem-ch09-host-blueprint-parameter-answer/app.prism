# A widget's blueprint parameter given as a supplier's answer under a tag's arm, the
# argument a bundle answer of an event part and a `$` part (Semantics ch. 8: a blueprint
# is a value, passed and applied; ch. 9, "How a supplier answers": an arm gives the
# blueprint that answers the place; round 3 DY: any dynamic of the host answers a `$`
# output). Written by Claude on the claude-lowering branch; subject to change.
emit Ui.* | Pad.*
test mod Tests

tag Pad.Socket of Element ((!Text, $Nat)):
    address: Text

@chat: @unit
@chat:
    ((!rx, $peers)) <- Pad.Socket(address="chat:7000")
    $last <- "none" then !rx
    Ui.Label($text=$"{$peers}: {$last}")

@Hosting: fn @((!Text, $Nat)) -> @unit
fn @Hosting @answer:
    ignore <- @HostDocument @chat, \|p, e| match e:               # 1/[p]
        Pad.Socket(..): @answer
        otherwise: @Element e

@host: @unit
@host:
    !add <- Ui.Button($label=$"add")                              # 0
    $count <- 0 then $count + 1 on !add
    @Hosting (@ (("hello" on !add, $count)))
