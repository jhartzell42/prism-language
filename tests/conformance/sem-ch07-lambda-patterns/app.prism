# A lambda given to an unbounded `Fold` takes its parameters apart by pattern: a tuple,
# a nested tuple and an `ignore`; it reads a parameter of its function and not another
# whose name is inside a word it uses (`e` in `free`). Each call of `Grow`, and each call
# of the lambda, which calls it, is a cycle point (D6, D8). Written for prismc's back
# end. Work in progress, subject to change.
emit Ui.*
test mod Tests

Grow: unbounded fn Nat -> Nat
fn Grow n = n + 1

Sums: unbounded fn [((Nat, ((Nat, Nat))))], Nat, Nat -> ((Nat, Nat))
fn Sums xs, k, e = Fold xs, ((0, e)), \|((a, b)), ((x, ((y, ignore))))|
    let free = Grow (a + x)
    ((free + k, b + y))

Shown: fn ((Nat, Nat)) -> Text
fn Shown ((a, b)) = "{a} {b}"

Run: unbounded fn Nat -> Text
fn Run k = Shown (Sums [[((1, ((2, 9)))), ((3, ((4, 9))))]], k, 100)

@Summed: fn Nat -> @unit
fn @Summed k:
    !done <- @Run Run, k                                    # 0
    $shown <- "working" then !done
    Ui.Label(text=$shown)                                   # 1
