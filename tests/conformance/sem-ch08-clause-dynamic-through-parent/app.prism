# A widget of several clauses called in a `for` row with a dynamic of the row's block
# (Semantics ch. 4, "`for`": every other name keeps its kind inside a row; ch. 8: a widget
# application is transparent, its places in the caller's sequence): the row's key chooses
# the clause, and the clause's label follows the block's hold in the tick it is written.
# Written by Claude on the claude-lowering branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

@Show: fn Bool, $Nat -> @unit
fn @Show True, $n:
    Ui.Label($text=$"big {$n}")                                   # 0
fn @Show False, $n:
    Ui.Label($text=$"small")                                      # 0
    Ui.Label($text=$"{$n}")                                       # 1

@page: @unit
@page:
    !inc <- Ui.Button($label=$"inc")                              # 0
    !drop <- Ui.Button($label=$"drop")                            # 1
    $count <- 0 then $count + 1 on !inc
    $names <- {{1: "one", 2: "two"}} then Remove $names, 2 on !drop
    for k, $name <- $names:                                      # 2/[k]
        @Show (k == 1), $count
