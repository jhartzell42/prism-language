# A `let` of a tuple pattern whose value reads a building `match`'s plain result, written
# above the `match`, its names read by places above and below (Semantics ch. 4, "Binding
# groups and cycles": any line may use any name the block binds, and "the order of a
# group's lines decides positions and nothing else"; `let` binds by any pattern that
# cannot fail). Written by Claude on the claude-lowering branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

type Mode = choice:
    Loud Text
    Soft
derive ^Eq, ^Show

Sides: fn Nat -> ((Nat, Nat))
fn Sides n = ((n + 1, n * 2))

@Panel: fn Mode -> @unit
fn @Panel mode:
    let ((low, high)) = Sides n
    Ui.Label($text=$"low {low}")
    n <- match mode:
        Loud t:
            Ui.Label($text=$"{t}")
            @ 10
        Soft:
            @ 20
    Ui.Label($text=$"high {high}")

@Page: fn Mode -> @unit
fn @Page mode:
    @Panel mode
