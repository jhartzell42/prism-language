emit Ui.*
use App.*

test a_row_never_hears_its_birth, @labels:
    build
        => expect_none Ui.Label(..)
    click Ui.Button(label="Add a tag")
        => expect Ui.Label(text="tag 1")
    click Ui.Button(label="Add a tag")
        => expect_count Ui.Label(..), 2
    click at 1/[1]/1
        => expect_none Ui.Label(text="tag 1")
        => expect Ui.Label(text="tag 2")

test selling_from_the_shelf, @shop:
    build
        => expect Ui.Label(text="Dune: 2 left")
    click at 0/["Dune"]/1
        => expect Ui.Label(text="Dune: 1 left")
    click at 0/["Emma"]/1, click at 0/["Dune"]/1
        => expect Ui.Label(text="Dune: 0 left")
        => expect Ui.Label(text="Emma: 0 left")
