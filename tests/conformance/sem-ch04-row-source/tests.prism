# Written by Claude on the claude-self-hosting branch; subject to change.
test every_write_path_moves_the_rows, @rows:
    with Fs.Contents(path="m") = ~ Contents(text="a"), build
    click at 0
    push Fs.Contents(path="m") = ~ Contents(text="b")
    click at 0

test hosted_answers_move_the_rows, @hosted:
    with Fs.Contents(path="m") = ~ Contents(text="a"), build
    click at 0/[0]/0
    push Fs.Contents(path="m") = ~ Contents(text="b")
