# The mapped constants' tests: declarations of sem-ch07-flatten-mapped-constants.
emit Ui.*
use App.*

test the_flatten_adopts_each_constant, @page:
    build
        => expect Ui.Label(text="0")
    click at 0
        => expect Ui.Label(text="0")
    compute
        => expect Ui.Label(text="1")
    click at 1
        => expect Ui.Label(text="1")
    compute
        => expect Ui.Label(text="101")
