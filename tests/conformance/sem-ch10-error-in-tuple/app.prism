# A bare `Error(..)` as a tuple's part where the tuple meets a `((~Nat, Nat))`: the part is
# that `~Nat`'s failure (Semantics ch. 10). Written by Claude on the claude-bugs branch;
# subject to change.
emit Ui.*
test mod Tests

SaidN: fn ~Nat -> Text
fn SaidN (~ n) = "{n}"
fn SaidN (Error(message=m, ..)) = "!{m}"

Pick: fn ((~Nat, Nat)) -> Text
fn Pick ((~a, b)) = "{SaidN ~a}/{b}"

@main: @unit
@main:
    Ui.Label($text=$"{Pick ((Error(kind=Prelude.NotANumber, message="tup"), 2))} {Pick (((~ 1), 3))}")    # 0
