# Locals' Rust names (prismc/README.md, pick NM): a `?x` beside a plain `x` of the same
# scope, and a local named as a function of the module (`kind` beside `Kind`). Written
# for prismc's back end. Work in progress, subject to change.
emit Ui.*
test mod tests

Kind: fn Nat -> Text
fn Kind n = if n > 9: "big" else: "small"

Describe: fn Nat -> Text
fn Describe n:
    let ?half = ?Div n, 2
    let half = Or ?half, 0
    let kind = Kind n
    let label = match ?half:
        ? h: "{kind} {h}"
        nil: "{kind} none"
    "{label} {half}"

@shown: @unit
@shown:
    Ui.Label(text=$"{Describe 4} / {Describe 20}")             # 0
