# The tests of sem-ch09-bundle-plain-part-nested-pattern. The World's state for the
# element is the whole first value, the plain part and the `$` part's current value.
emit Ui.* | Pad.*
use App.*

test plain_part_taken_apart, @chat:
    with Pad.Port(address="chat:7000") = ((((7, "ann")), "up")), build
        => expect Ui.Label(text="port 7 of ann: up")
    push Pad.Port(address="chat:7000") = ((((7, "ann")), "down"))
        => expect Ui.Label(text="port 7 of ann: down")
