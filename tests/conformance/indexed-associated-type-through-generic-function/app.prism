# A generic function over a document and a role whose parameter and result are an
# associated type with indices (`Answer d r`, Type System ch. 6), called at a concrete
# document and role: the call gives a `Nat` at the raiser and a `Text` at the watcher, and
# reads each back at its own type. Found by the p16 run on the documents (the library's
# `?AnswerIn`, `?ResponseOf`, `LeftWith`, generic in `d`).
# Written by Claude on the claude-self-hosting branch; subject to change.
emit Ui.*
test mod Tests

trait ^Document d:
    type Role
    type Answer (r: Role d)

type CountRole = choice:
    Raiser
    Watcher
derive ^Eq, ^Debug

type Count = record:
    total: Nat

impl ^Document Count:
    type Role = CountRole
    type Answer Raiser = Nat
    type Answer Watcher = Text

?Kept: forall d (r: Role d). fn Fixed r, Answer d r -> ?(Answer d r) where d: ^Document
fn ?Kept role, answer = ? answer

@page: @unit
@page:
    let raised = Or (?Kept<<Count>> Fixed<<Raiser>>, 5), 0
    let watched = Or (?Kept<<Count>> Fixed<<Watcher>>, "seen"), ""
    Ui.Label($text=$"{raised + 1} {watched}")                                    # 0
