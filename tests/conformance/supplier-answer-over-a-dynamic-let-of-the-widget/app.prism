# A supplier a widget gives back answers with a function of a dynamic `let` of the widget
# (`let $d = $count + 1`, `@ $Present $d`): the supplier value bound in the build reads the
# `let` through its live dynamic, never through a method's `self` (rustc E0424). One of
# the variants pinning supplier-answer-of-whole-function-over-its-hold down.
# Written by Claude, 15 November 2026, on the claude-self-hosting branch. Subject to change.
emit Ui.* | Pad.*
test mod Tests

tag Pad.Gauge of Element $?Nat:
    name: Text

@meter: @unit emit Ui.* | Pad.*
@meter:
    $?level <- Pad.Gauge(name="tank")                                          # 0
    Ui.Label($text=$"level {Or $?level, 0}")                                   # 1

$Present: fn $s -> $?s
fn $Present $x = ? $x

@Counting: fn prompt !Ui.Click -> @(forall o. fn Path, prompt Element (Ui.* | Pad.*) o -> @o)
fn @Counting !add:
    $count <- 0 then $count + (1 on !add)
    let $d = $count + 1
    @ \|path, element| match element:
        Pad.Gauge(..): @ $Present $d
        otherwise: @Element element

@host: @unit
@host:
    !add <- Ui.Button($label=$"add")                                           # 0
    Supply <- @Counting !add
    ignore <- @Host @meter, Supply                                             # 1/[p]
