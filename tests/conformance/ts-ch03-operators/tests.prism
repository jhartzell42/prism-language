# The tests of ts-ch03-operators.
emit Ui.*
use App.*

test every_operator_has_a_case, @main:
    build
        => expect Ui.Label(text="9 14 5 3 1 9 14 False True False True")
        => expect Ui.Label(text="9 5 14 3 1 5 -7 False True")
        => expect Ui.Label(text="2.0 1.0 0.75 3.0 False")
        => expect Ui.Label(text="13 7 lt gt lt le 3 0 False True True")
    click at 0
        => expect Ui.Label(text="13 7 lt gt lt le 3 1 False True True")
    click at 1
        => expect Ui.Label(text="13 7 lt gt lt le 3 2 False True True")
