# Semantics ch. 6: the program half of the bird counter, a root file with no `module`
# line, using `Birds.*`.
emit Ui.*
use Birds.*
use Ui

Report: fn Nat, ?Species -> Text
fn Report n, nil = "{n} birds"
fn Report n, (? s) = "{n} birds, the last a {Show s}"

@main: @unit
@main:
    !robin <- @Spotter Robin                                # 0
    !wren <- @Spotter Wren                                  # 1
    !heron <- @Spotter Heron                                # 2
    let !seen = !robin <| !wren <| !heron
    $count <- 0 then $count + 1 on !seen
    $?last <- nil then ? !seen
    Ui.Label(text=(Report $count, $?last))                  # 3
