# A type of the program named as an associated type of a trait it implements, `type
# Reason = choice: ..` beside `trait ^Document d: type Reason (r: Role d)`, the
# associated type written through its trait where the names collide (ruling AQ): the
# impl's equation `type ^Document.Reason Player = Reason`, whose right side is the
# program's own type, and a signature's `^Document.Reason Board Player`. Found while
# isolating c6's errors: q11's checker kept both under one name and refused the program,
# "a second impl of `^Debug` for `GameRole`".
# Written by Claude (round after q11), 16 November 2026; subject to change.
emit Ui.*
test mod Tests

trait ^Document d:
    type Role
    type Reason (r: Role d)

type GameRole = choice:
    Player
    Spectator
derive ^Eq, ^Ord, ^Debug

type Reason = choice:
    NotYourMove
derive ^Eq, ^Debug

type Board = choice:
    Board

impl ^Document Board:
    type Role = GameRole
    type ^Document.Reason Player = Reason
    type ^Document.Reason Spectator = Never

Why: fn ^Document.Reason Board Player -> Text
fn Why NotYourMove = "not your move"

Again: fn Reason -> Text
fn Again reason = "again: {Why reason}"

@page: @unit
@page:
    Ui.Label($text=$"{Why NotYourMove}; {Again NotYourMove}")              # 0
