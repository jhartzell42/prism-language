# The tests of sem-ch05-named-lens-index.
emit r
use App.*

check lens_to_an_index:
    SetSecond [[1, 2, 3]], 9 => [[1, 9, 3]]
    ?ReadSecond [[1, 2, 3]] => ? 2
    ?ReadSecond [[1]] => nil
    BumpSecond [[1, 2, 3]] => [[1, 3, 3]]
    BumpSecond [[1]] => [[1]]

check lens_through_an_index:
    Charge [[Regs(acc=1, x=0), Regs(acc=2, x=0)]], 5 => [[Regs(acc=1, x=0), Regs(acc=7, x=0)]]

check lens_over_an_index_lens:
    Swap Deck(name="d", cards=[[4, 5]]), 8 => Deck(name="d", cards=[[4, 8]])
