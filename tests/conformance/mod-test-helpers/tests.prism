# A test module's helpers: a type and a function, for the checks alone.
type Pair = record:
    left: Nat
    right: Nat
derive ^Eq, ^Show

Sum: fn Pair -> Nat
fn Sum p = Add p.left, p.right

check helpers:
    Sum Pair(left=2, right=3) => 5
    Pair(left=1, right=2) == Pair(left=1, right=2) => True
    Show Pair(left=1, right=2) => "Pair(left=1, right=2)"
