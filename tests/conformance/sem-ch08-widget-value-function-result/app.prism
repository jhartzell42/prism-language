# A widget that gives a function back, a plain value that is no data, taken as a blueprint value; the block that applies it binds the function
# (Semantics ch. 8: "a blueprint builds nothing until a block applies it", at the applying
# block's next positions; Type System ch. 2: a blueprint is an opaque handle and still a
# value; ch. 4: a building `match`'s arm adds no path segment). Written by Claude on the
# claude-lowering branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

?Pick: fn Bool, @a -> ?@a
fn ?Pick b, @w = if b: ? @w else: nil

@Maker: @(fn Nat -> Nat)
@Maker:
    Ui.Label($text=$"maker")
    @ \|x| x + 1

@Page: fn Bool -> @unit
fn @Page b:
    match ?Pick b, @Maker:                                       # 0 and 1, or 0
        ? @T:
            Next <- @T
            let made = Next 7
            Ui.Label($text=$"made {made}")
        nil: Ui.Label($text=$"none")
    Ui.Label($text=$"end")                                       # 2, or 1
