# Jimmy's ruling, 12 November: `any` over a type variable with no trait bound. `Paired`
# hides the index `r` of two edits, `any r: ((Edit r, Edit r))`: the two share one index,
# and nothing else is known of it. A list holds pairs at different indexes, a reader's
# and a writer's. A `match` arm `any ((first, second))` opens a pair at the arm's own
# fresh `r`, and `Merged`, which needs both edits at one index, takes them. The kind of
# `r` comes from its use in `Edit r`.
# Expected transcript derived by hand from the ruling and Type System ch. 3
# ("Existentials"). Written by Claude on the claude-self-hosting branch; subject to change.
emit Ui.*
test mod Tests

type Access = choice:
    Reader
    Writer
derive ^Eq, ^Show

type Edit (r: Access) = record:
    count: Nat

# Two edits at one hidden index.
type Paired = any r: ((Edit r, Edit r))

Read: fn Nat -> Edit Reader
fn Read n = Edit(count=n)

Wrote: fn Nat -> Edit Writer
fn Wrote n = Edit(count=n)

Packed: fn Edit r, Edit r -> Paired
fn Packed first, second = any ((first, second))

Merged: fn Edit r, Edit r -> Edit r
fn Merged left, right = Edit(count=(left.count + right.count))

Counted: fn Edit r -> Nat
fn Counted edit = edit.count

Opened: fn Paired -> Nat
fn Opened pair = match pair:
    any ((first, second)): Counted (Merged first, second)

Total: fn [Paired] -> Nat
fn Total pairs = Fold pairs, 0, \|sum, pair| sum + (Opened pair)

@page: @unit
@page:
    let reads = Packed (Read 1), (Read 2)
    let writes = Packed (Wrote 10), (Wrote 20)
    let pairs = [[reads, writes]]
    Ui.Label($text=$"{Opened reads} + {Opened writes} = {Total pairs}")   # 0
