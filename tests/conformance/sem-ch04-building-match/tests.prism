# The building `match`'s tests: declarations of sem-ch04-building-match.
emit Ui.*
use App.*

test a_loud_arm, @Panel (Loud "hey"):
    build
        => expect Ui.Label(text="hey 0")
    click at 2
        => expect Ui.Label(text="hits 1")
    click at 0
        => expect Ui.Label(text="hey 1")

test the_guard_fails, @Panel (Loud ""):
    build
        => expect Ui.Button(label="empty")

test a_soft_arm, @Panel Soft:
    build
        => expect Ui.Label(text="no count")
    click at 2
        => expect Ui.Label(text="hits 1")
