# Dynamics named `at`, `child` and `join`: declarations of cpp-dynamic-named-at.
emit Ui.*
use App.*
use Ui.*

test paths_and_dynamics_named_alike, @names:
    build
        => expect Ui.Label(text="2/11")
    click at 0
        => expect Ui.Label(text="row 1 at 4")
        => expect Ui.Label(text="4/12")
