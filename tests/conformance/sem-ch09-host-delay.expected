  added:
    0: Ui.Button(label="tap")
    1/[1]/0: Ui.TextInput(name="in", text="")
    1/[2]/0: Ui.Label(text="0 hits, 0 keys")
    2: Ui.Label(text="0 taps")

tick 1
  in:
    0: click
  changed:
    2: Ui.Label(text="1 taps")

tick 2
  changed:
    1/[2]/0: Ui.Label(text="1 hits, 0 keys")

tick 3
