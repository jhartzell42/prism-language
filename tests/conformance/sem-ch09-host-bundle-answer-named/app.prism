# A supplier answers a bundle's tag with a bundle that is a name (Semantics ch. 9, "How a
# supplier answers"; Type System ch. 2, "Bundles": a bundle is a plain aggregate with
# functor values inside, so a `let` binds one): `@ pair` is `@ (("mock", 2 on !go))` of
# sem-ch09-host-bundle with the tuple named first. Written by Claude on the
# claude-lowering branch; subject to change.
emit Ui.* | Pad.*
test mod Tests

tag Pad.Door of Element ((Text, !Nat)):
    name: Text

@doors: @unit
@doors:
    ((door, !knocks)) <- Pad.Door(name="front")              # 0
    $count <- 0 then $count + !knocks
    Ui.Label($text=$"{door}: {$count}")                       # 1

@computed: @unit
@computed:
    !go <- Ui.Button($label=$"knock")                         # 0
    let pair = (("mock", 2 on !go))
    ignore <- @Host @doors, \|p, e| match e:         # 1/[p]
        Pad.Door(..): @ pair
        otherwise: @Element e
