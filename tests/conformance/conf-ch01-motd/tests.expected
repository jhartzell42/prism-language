  added:
    1: Fs.File(path="/etc/motd")
    2: Ui.Label(text="(reading...)")

tick 1
  requested:
    1: Read

tick 2
  in:
    1: ~ Contents(text="hello")
  changed:
    2: Ui.Label(text="hello")
