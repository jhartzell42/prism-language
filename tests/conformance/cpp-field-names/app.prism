# A record's field named as a node's member: the widget `@Shown` takes a parameter named
# `message`, so its node has a member `message`, and the record `Note`'s field `message`
# is read in the same program. The emitted C++ reads the record's field with `.`, the
# node's with `->` (gap FA of prismc/README.md). Written for prismc's back end; subject to
# change.
emit Ui.*
test mod tests
use Ui.*

type Note = record:
    message: Text
    count: Nat
derive ^Eq, ^Show

Told: fn Note -> Text
fn Told n = "{n.message} x{n.count}"

@Shown: fn Text -> @unit
fn @Shown message:
    Ui.Label(text=$"{message}")

@notes: @unit
@notes:
    ignore <- @Shown "hello"                                             # 0
    Ui.Label(text=$"{Told (Note(message="hi", count=2))}")               # 1
