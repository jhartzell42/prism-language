# Two mutually recursive lambdas of unbounded type in an unbounded function, each passed
# the other through a record: a call of an unbounded lambda is a cycle point (D6), so the
# recursion takes a tick a call. Were lambdas entered within the cycle, the whole
# recursion would run inside one tick, however deep. Written for prismc's back end. Work
# in progress, subject to change.
emit Ui.*

type Parity = record:
    even: unbounded fn Nat, Parity -> Bool
    odd: unbounded fn Nat, Parity -> Bool

IsEven: unbounded fn Nat -> Bool
fn IsEven n:
    let Even = \|k, ps| match k -? 1:
        ? j: ps.odd j, ps
        nil: True
    let Odd = \|k, ps| match k -? 1:
        ? j: ps.even j, ps
        nil: False
    let ps = Parity(even=Even, odd=Odd)
    ps.even n, ps

@Checked: fn Nat -> @unit
fn @Checked n:
    !done <- @Run IsEven, n                                 # 0
    $shown <- "working" then Show !done
    Ui.Label(text=$shown)                                   # 1
