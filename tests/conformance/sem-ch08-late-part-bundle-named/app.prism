# A widget's bundle result bound whole to one name when one of its plain parts is late:
# the part is a building `match`'s plain result, known when the arm is built (Semantics
# ch. 4: a building `match`'s arm "is fixed for the life of the block and adds no path
# segment"; ch. 8: `<-` builds the child and binds its result; Type System ch. 2,
# "Bundles": a bundle is a plain aggregate, so a name binds it). The page names the
# bundle and gives it on; its caller takes it apart. Written by Claude on the
# claude-lowering branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

type Mode = choice:
    Loud Text
    Soft
derive ^Eq, ^Show

@Choose: fn Mode -> @((Nat, !Click))
fn @Choose mode:
    n <- match mode:
        Loud t:
            Ui.Label($text=$"{t}")                                     # 0
            @ 10
        Soft:
            @ 20
    !go <- Ui.Button($label=$"go")                                     # 1, or 0
    @ ((n, !go))

@Named: fn Mode -> @((Nat, !Click))
fn @Named mode:
    both <- @Choose mode                                               # 0 and 1, or 0
    Ui.Label($text=$"named")                                           # 2, or 1
    @ both

@Page: fn Mode -> @unit
fn @Page mode:
    ((n, !go)) <- @Named mode                                          # 0 to 2, or 0 and 1
    $gone <- 0 then $gone + n on !go
    Ui.Label($text=$"n {n}, gone {$gone}")                             # 3, or 2
