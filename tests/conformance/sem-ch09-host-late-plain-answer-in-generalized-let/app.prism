# A `let` of a lambda in a hosted child under a host below a building `if`, closing over
# a place's plain answer written below it, used at two types, so the `let` is generalized
# (Semantics ch. 4, "Binding groups and cycles"; ch. 9: the host answers once it is placed;
# Type System ch. 1). Reaches `LateHostedOutput`'s marker "the plain answer `a` of a place
# under a host placed after its node" on prismc-fd1.
# Written by Claude (sweep-7, the prismc run), 12 November 2026; subject to change.
emit Ui.* | Pad.*
test mod Tests
use Ui.*

tag Pad.Count of Element Nat:
    name: Text

Second: fn ((t, Nat)) -> Nat
fn Second ((ignore, k)) = k

@Inner: @unit
@Inner:
    let Wrap = \|x| ((x, a))
    Ui.Label($text=$"{Second (Wrap 1)} {Second (Wrap "a")}")                     # [0]
    a <- Pad.Count(name="count")                                       # [1]
    Ui.Label($text=$"{a}")                                            # [2]

@Page: fn Bool -> @unit
fn @Page loud:
    if loud:
        Ui.Label($text=$"before")
    ignore <- @Host @Inner, \|p, e| match e:
        Pad.Count(..): @ 4
        otherwise: @Element e

