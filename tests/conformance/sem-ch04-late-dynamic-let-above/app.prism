# A `let` of a dynamic, written above a building `match` whose plain result it reads (Semantics ch. 4,
# "Binding groups and cycles": any line may use any name the block binds, and "the order
# of a group's lines decides positions and nothing else"). Written by Claude on the
# claude-lowering branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

type Mode = choice:
    Loud Text
    Soft
derive ^Eq, ^Show

@Panel: fn Mode -> @unit
fn @Panel mode:
    !go <- Ui.Button($label=$"go")
    $count <- 0 then $count + 1 on !go
    let $scaled = $count * n
    Ui.Label($text=$"scaled {$scaled}")
    n <- match mode:
        Loud t:
            Ui.Label($text=$"{t}")
            @ 10
        Soft:
            @ 20

@Page: fn Mode -> @unit
fn @Page mode:
    @Panel mode
