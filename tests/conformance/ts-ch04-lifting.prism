# Type System ch. 4: the rows of the lifting table, one program each, and `match` and
# `if` as lifting.
emit Ui.*

@diamond: @unit
@diamond:
    !set <- Ui.Button(label=$"Set")
    $a <- 0 then 5 on !set
    let $b = $a + 1
    let $c = $a * 2
    let $d = $b + $c
    Ui.Label(text=$"{$d}")

Double: fn Int -> Int
fn Double n = n * 2

!Bump: fn $Int, !unit -> !Int
fn !Bump $n, !go = $n + 1 on !go

@doubles: @unit
@doubles:
    !tap <- Ui.Button(label=$"Tap")
    $count <- 0 then $count + 1 on !tap
    let four = Double 2
    let $twice = Double $count
    let !jump = Double (1 on !tap)
    $jumped <- 0 then !jump
    $bumped <- 0 then !Bump $count, (unit on !tap)
    Ui.Label(text=$"{four} {$twice} {$jumped} {$bumped}")

@scores: @unit
@scores:
    !home <- Ui.Button(label=$"Home scores")
    !away <- Ui.Button(label=$"Away scores")
    $home <- 0 then $home + 1 on !home
    $away <- 0 then $away + 1 on !away
    let $level = $home == $away
    let $leader = match Compare $home, $away:
        Less: "away"
        Greater: "home"
        Equal: "level"
    let !shot = if $level: unit on !home else: never
    $shots <- 0 then $shots + 1 on !shot
    Ui.Label(text=$"{$home} to {$away}, {if $level: "level" else: $leader}, {$shots}")
