# A generic type's own `impl ^Debug` under a `where` bound: its method is a function over the
# impl's type parameter, and the type crosses as its text where its parameter shows, in
# both targets. Written by Claude on the claude-bugs branch; subject to change.
emit Ui.*
test mod Tests

type Bag a = record:
    items: [a]
    owner: Text

impl ^Debug (Bag a) where a: ^Debug:
    fn Debug b = "{b.owner}: {Fold b.items, "", \|acc, x| "{acc}{Debug x}."}"

@main: @unit
@main:
    let bag = Bag(items=[[1, 2]], owner="ann")
    Ui.Label($text=$"{Debug bag} {Debug [[(Bag(items=[["x"]], owner="bo"))]]}")    # 0
