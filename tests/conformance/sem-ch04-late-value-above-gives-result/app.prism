# A widget applied above a building `match`, taking the `match`'s plain result as its
# argument and giving a plain result of its own, which a line below reads (Semantics
# ch. 4, "Binding groups and cycles": any line may use any name the block binds, and "the
# order of a group's lines decides positions and nothing else"; ch. 8: `<-` binds the
# child's result). Nothing here is a cycle. Written by Claude on the claude-lowering
# branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

type Mode = choice:
    Loud Text
    Soft
derive ^Eq, ^Show

@Twice: fn Nat -> @Nat
fn @Twice k:
    Ui.Label($text=$"tile {k}")
    @ k * 2

@Panel: fn Mode -> @unit
fn @Panel mode:
    twice <- @Twice n                                                  # 0
    n <- match mode:
        Loud t:
            Ui.Label($text=$"{t}")                                     # 1
            @ 10
        Soft:
            @ 20
    Ui.Label($text=$"below {n}, twice {twice}")                        # 2, or 1

@Page: fn Mode -> @unit
fn @Page mode:
    @Panel mode
