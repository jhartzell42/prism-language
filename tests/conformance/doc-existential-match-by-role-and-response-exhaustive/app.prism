# A `match` on an existential over a role, its arms by the role's `Fixed` pattern and the
# response under it (Part III ch. 6, doubt SK: opening the existential tells the arm the
# role; ruling VO: a role that travels as a value is matched as `Fixed<<Raiser>>`). The
# arms cover every case: the raiser's accepted and declined responses, and the watcher's
# any response. Found while isolating tally's errors: q11's checker refused it,
# "this match misses `any ((_, Accepted))`", the watcher's arm notwithstanding.
# Written by Claude (round after q11), 16 November 2026; subject to change.
emit Ui.*
test mod Tests

trait ^Document d:
    type Role
    type Reason (r: Role d)

type Response d (r: Role d) = choice:
    Accepted
    Declined (Reason d r)
derive ^Eq, ^Debug

type CountRole = choice:
    Raiser
    Watcher
derive ^Eq, ^Ord, ^Debug

type Count = record:
    total: Nat
derive ^Eq, ^Debug

type TooHigh = choice:
    StopsAt Nat
derive ^Eq, ^Debug

impl ^Document Count:
    type Role = CountRole
    type Reason Raiser = TooHigh
    type Reason Watcher = Never

type Responded = any (r: Role Count): ((Fixed r, Response Count r))

Said: fn Responded -> Text
fn Said responded = match responded:
    any ((Fixed<<Raiser>>, Accepted)): "raiser: accepted"
    any ((Fixed<<Raiser>>, (Declined (StopsAt most)))): "raiser: declined, stops at {most}"
    any ((Fixed<<Watcher>>, ignore)): "a watcher"

@page: @unit
@page:
    let all: [Responded] = [[(any ((Fixed<<Raiser>>, Accepted))), (any ((Fixed<<Raiser>>, (Declined (StopsAt 5))))), (any ((Fixed<<Watcher>>, Accepted)))]]
    Ui.Label($text=$"{Joined (Each all, Said), "; "}")                                    # 0

Joined: fn [Text], Text -> Text
fn Joined texts, between = Fold texts, "", \|all, text| if all == "": text else: "{all}{between}{text}"
