# `?ParseNat` past 18 digits and past 64 bits: declarations of sem-appB-parse-nat.prism.
emit r
use App.*

check parse_nat:
    Parsed "0" => "0"
    Parsed "007" => "7"
    Parsed "123456789012345678" => "123456789012345678"
    Parsed "1234567890123456789" => "1234567890123456789"
    Parsed "18446744073709551616" => "18446744073709551616"
    Parsed "123456789012345678901234567890" => "123456789012345678901234567890"
    Parsed "" => "nil"
    Parsed "12a" => "nil"
    Parsed "-1" => "nil"
