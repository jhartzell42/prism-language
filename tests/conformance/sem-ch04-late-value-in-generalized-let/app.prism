# A `let` of a lambda that closes over a building `if`'s late plain result written below
# it, used at two types, so the `let` is generalized (Semantics ch. 4, "Binding groups and
# cycles": any line may use any name the block binds; Type System ch. 1: a `let` of a
# lambda is generalized). Used at one type the same `let` is late with its result
# (`MarkLateLets`) and lowers. Reaches `BindLate`'s marker "the late result `n` read at
# its block's build" on prismc-fd1.
# Written by Claude (sweep-7, the prismc run), 12 November 2026; subject to change.
emit Ui.*
test mod Tests
use Ui.*

Second: fn ((t, Nat)) -> Nat
fn Second ((ignore, k)) = k

@Page: fn Bool -> @unit
fn @Page loud:
    let Wrap = \|x| ((x, n))
    Ui.Label($text=$"{Second (Wrap 1)} {Second (Wrap "a")}")           # 0
    n <- if loud:
        Ui.Label($text=$"loud")                                        # 1
        @ 10
    else:
        @ 20
