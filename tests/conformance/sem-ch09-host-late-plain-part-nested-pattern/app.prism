# A late place's plain part taken apart by a pattern of its own: the place stands in a
# hosted child whose host answers the `$` part with a structural dynamic, so its first
# value is asked once the node stands, and the binder's pattern names the two halves of
# the plain part, a pair (Type System ch. 2, "Bundles and sparse tuples"; Semantics ch.
# 8: `<-` builds the child and binds its result by a pattern; ch. 9, "How a supplier
# answers"; ch. 7, "Structural dynamics", round 3 ST).
# sem-ch09-host-late-bundle-plain-part with the plain part a pair under a pattern.
# Written by Claude on the claude-lowering branch; subject to change.
emit Ui.* | Pad.*
test mod Tests

tag Pad.Socket of Element ((((Nat, Text)), !Text, $Nat)):
    address: Text

@chat: @unit
@chat:
    ((((id, owner)), !rx, $peers)) <- Pad.Socket(address="chat:7000")  # h0
    $last <- "none" then !rx
    Ui.Label($text=$"{id} of {owner}, {$peers}: {$last}")              # h1

@host: @unit
@host:
    !add <- Ui.Button($label=$"add")                                   # 0
    $names <- {1: "one"} then Insert $names, 2, "two" on !add
    $lens <- for k, $name <- $names:                                   # 1/[k]
        Ui.Label($text=$name)
        @ Len $name
    ignore <- @HostDocument @chat, \|p, e| match e:                    # 2/[p]
        Pad.Socket(..): @ ((((7, "ann")), "hello" on !add, Size $lens))
        otherwise: @Element e
