# A block reads at the build names bound on lines below (Semantics ch. 4, "Binding groups
# and cycles": a widget block is one binding group, any line may use any name the block
# binds, and the order of its lines decides positions and nothing else): the door's first
# value is asked with the initial value of `$called`, a hold bound below it; a plain `let`
# reads another below it, which reads `word`, a widget's plain result bound below that;
# the count's label reads `$count`, a hold below it whose step hears the button above.
# Neither hold nor `@Word` takes a position, so the places are the door, the two labels
# and the two buttons, in page order. Written by Claude on the claude-widget-plain branch,
# extended on claude-bugs; subject to change.
emit Ui.* | Pad.*
test mod Tests

tag Pad.Door of Element ((Text, !Nat)):
    $name: Text

@Word: fn Text -> @Text
fn @Word w:
    @ w

@page: @Text
@page:
    ((door, !knocks)) <- Pad.Door($name=$called)             # 0
    let excited = "{greeting}!"
    Ui.Label($text=$"{door}, {excited}")                     # 1
    let greeting = "hello {word}"
    $called <- "front" then "back" on !never
    word <- @Word "x"
    !never <- Ui.Button($label=$"never")                     # 2
    Ui.Label($text=$"{$count}")                              # 3
    !bump <- Ui.Button($label=$"bump")                       # 4
    $count <- 10 then $count + 1 on !bump
    @ door
