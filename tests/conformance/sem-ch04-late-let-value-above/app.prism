# A `let` over a building `match`'s plain result, taken as a value at the build by a line
# above both (Semantics ch. 4, "Binding groups and cycles": a widget block is one binding
# group, any line may use any name the block binds, and "the order of a group's lines
# decides positions and nothing else"; ch. 8: `<-` binds the arm's plain result).
# Written by Claude on the claude-lowering branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

type Mode = choice:
    Loud Text
    Soft
derive ^Eq, ^Show

@Tile: fn Nat -> @unit
fn @Tile k:
    Ui.Label($text=$"tile {k}")

@Panel: fn Mode -> @unit
fn @Panel mode:
    @Tile m                                                            # 0
    n <- match mode:
        Loud t:
            Ui.Label($text=$"{t}")                                     # 1
            @ 10
        Soft:
            @ 20
    let m = n + 1
    Ui.Label($text=$"below {m}")                                       # 2, or 1

@Page: fn Mode -> @unit
fn @Page mode:
    @Panel mode
