# A building `if` with no `else` (Semantics ch. 4, "The widget block": a building `match`
# or `if` over a plain scrutinee; its arm returns `unit`, so the line stands bare and the
# missing `else` builds nothing). Written by Claude on the claude-lowering branch; subject
# to change.
emit Ui.*
test mod Tests
use Ui.*

@Panel: fn Bool -> @unit
fn @Panel loud:
    if loud:
        Ui.Label($text=$"loud")                                  # 0
    Ui.Label($text=$"always")                                    # 1, or 0
