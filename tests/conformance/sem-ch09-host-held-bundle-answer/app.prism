# A host answers a place with a blueprint made outside the tag's arm whose output is a
# bundle with a function part: `let @made = @ ((F, !e))`, then `Pad.Counter(..): @made`
# (Type System ch. 2: `@ x` is the blueprint whose output is `x`; a function is a value,
# and a plain aggregate with a functor value inside is a bundle; "Bundles": the bundle is
# answered part by part; Semantics ch. 9, "How a supplier answers": an event answer is the
# next tick's input). sem-ch09-host-answer-without-arm with such a bundle for the plain
# number. Written by Claude on the claude-lowering branch; subject to change.
emit Ui.* | Pad.*
test mod Tests

tag Pad.Counter of Element ((fn Nat -> Nat, !Nat)):
    name: Text

@counted: @unit
@counted:
    ((Step, !bump)) <- Pad.Counter(name="c")
    $count <- 0 then Step ($count + !bump)
    Ui.Label($text=$"{$count}")

@mocked: @unit
@mocked:
    !go <- Ui.Button($label=$"go")
    let @made = @ ((\|n| n + 2, 3 on !go))
    ignore <- @Host @counted, \|p, e| match e:
        Pad.Counter(..): @made
        otherwise: @Element e
