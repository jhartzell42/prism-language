# A structural dynamic (Semantics ch. 7, "Structural dynamics"; round 3 ST): a host's child
# document `$doc`, a `for`'s gathered `$(K ==> T)`. It is a lawful dynamic one tick behind
# the structure: with S(n) fixed as the last act of n's construction step, its value after m
# is S(m-1), and it moves at n+1, the first firing of that owed tick, when S(n) differs from
# S(n-1), so `!Updated $doc` fires at n+1 with S(n). A dynamic lifted over `$doc` and a hold
# the host writes is an ordinary dynamic: it fires in the tick the hold is written, with the
# document one tick behind, and once in a tick where both move. Written for prismc's back
# end. Work in progress, subject to change.
emit Ui.*
test mod Tests
use Ui.*

@child: @unit
@child:
    !add <- Ui.Button($label=$"add")                                          # 0
    $names <- {1: "k1"} then Insert $names, (Size $names) + 1, "k{(Size $names) + 1}" on !add
    for k, $name <- $names:                                                  # 1/[k]
        Ui.Label($text=$name)                                                 # 1/[k]/0

type Pair = record:
    size: Nat
    clicks: Nat
derive ^Eq, ^Show

Paired: fn Nat, Nat -> Pair
fn Paired size, clicks = Pair size, clicks

# `$doc` and `$pair` are structural; `$clicks`, `$moves` and `$seen` are holds.
@host: @unit
@host:
    ((ignore, $doc)) <- @HostDocument @child, \|p, e| @Element e              # 0/[p]/0
    !tap <- Ui.Button($label=$"tap")                                           # 1
    $clicks <- 0 then $clicks + 1 on !tap
    $moves <- 0 then $moves + 1 on (!Updated $doc)
    let $pair = Paired (Size $doc), $clicks
    $seen <- Pair 0, 0 then !Updated $pair
    Ui.Label($text=$"{$moves} moves, {Size $doc} places")                     # 2
    Ui.Label($text=$"seen {$seen.size} places at {$seen.clicks} clicks")      # 3

# A `for`'s gathered dynamic is structural too: its event fires in the tick after the row
# is born, with the rows' results after the birth tick.
@gathered: @unit
@gathered:
    !add <- Ui.Button($label=$"add")                                          # 0
    $names <- {1: "one"} then Insert $names, 2, "three" on !add
    $lens <- for k, $name <- $names:                                         # 1/[k]
        Ui.Label($text=$name)                                                 # 1/[k]/0
        @ Len $name
    $heard <- 0 then $heard + 1 on (!Updated $lens)
    $rows <- 0 then Size (!Updated $lens)
    Ui.Label($text=$"{$heard} heard, {$rows} rows")                           # 2
