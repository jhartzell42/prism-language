# A host's supplier answers the child with the owner's own combinator (`!either`), and
# the child's answer feeds a combinator of its own, both in the one node the child is
# inlined into: the owner is woken again within its wake. Each combinator decides each
# input once a tick, so the owner's hold takes one write (Semantics R3). Written for
# prismc's back end. Work in progress, subject to change.
emit Ui.*
use Ui.*

?Echo: fn Path, Element o, !Click -> ?@o
fn ?Echo p, e, !back = match e:
    Ui.Button(..): ? @ !back
    otherwise: nil

@child: @unit
@child:
    !b <- Ui.Button(label=$"b")                                 # 0, answered
    !c <- Ui.Button(label=$"c")                                 # 1, answered
    let !hit = !b <| !c
    $hits <- 0 then $hits + 1 on !hit
    Ui.Label(text=$"{$hits} hits")                              # 2

@loop: @unit
@loop:
    !go <- Ui.Button(label=$"go")                               # 0
    !other <- Ui.Button(label=$"other")                         # 1
    let !either = !go <| !other
    ignore <- @HostSome @child, \|p, e| ?Echo p, e, !either     # 2/[p]
    $count <- 0 then $count + 1 on !either
    Ui.Label(text=$"{$count}")                                  # 3
