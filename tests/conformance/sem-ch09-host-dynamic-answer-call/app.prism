# A supplier's dynamic answer that is a call's result (Semantics ch. 9, "How a supplier
# answers"; round 3 DY: a supplier may answer a child's `$` place with any dynamic of the
# host): `$~Shout` takes the host's hold whole and gives a dynamic (Type System ch. 4,
# Application). The first value is read in the birth tick, each later change is a push
# delivered the next tick. Written by Claude on the claude-lowering branch; subject to
# change.
emit Ui.* | Fs.*
test mod Tests
use Fs.*

ShowResponse: fn ~Contents -> Text
fn ShowResponse (~ c) = c.text
fn ShowResponse (Error(..)) = "(cannot read)"

~Motd: fn Text -> ~Contents
fn ~Motd text = ~ Contents(text=text)

$~Shout: fn $Text -> $~Contents
fn $~Shout $text = ~Motd "{$text}!"

@child: @unit
@child:
    $~motd <- Fs.Contents(path="/etc/motd")                     # 0
    Ui.Label($text=$"{ShowResponse $~motd}")                     # 1

@host: @unit
@host:
    !change <- Ui.Button($label=$"change")                       # 0
    $motd <- "first" then "second" on !change
    ignore <- @HostDocument @child, \|p, e| match e:            # 1/[p]
        Fs.Contents(..): @ $~Shout $motd
        otherwise: @Element e
