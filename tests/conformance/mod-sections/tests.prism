# The root's test module: no header; the declarations of every section, bare.
test counting_up, @main:
    build
        => expect Ui.Label(text="a square of area 1")
    click Ui.Button(label="Next")
        => expect Ui.Label(text="a square of area 4")

check areas:
    Area (Square 3) => 9
    Area (Box 2, 5) => 10
    Caption 2 => "a square of area 4"
