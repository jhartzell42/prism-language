# Modules as directories (docs/modules-style-pass.md): a root divided into sections, each a
# file the header declares by `mod`. Every section sees the others' names bare, and the
# test module `tests.prism` sees them all; `prism run` reads no test module.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit Ui.*
mod shapes
mod labels
test mod tests
use Ui

@main: @unit
@main:
    !next <- Ui.Button(label=$"Next")                       # 0
    $n <- 1 then $n + 1 on !next
    Ui.Label(text=(Caption $n))                             # 1
