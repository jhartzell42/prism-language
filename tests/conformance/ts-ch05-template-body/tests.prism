# Audited: the body is the last argument; depth 0 takes the "[empty]" clause, depth 2 the general one, the note given both times.
# The template body's tests: declarations of ts-ch05-template-body.prism (Semantics chapter 6).
emit Ui.*
use App.*

test the_body_is_the_last_place, @shown:
    build
        => expect Ui.Label(text="[empty] body text (see below) / [2] body text (see below)")
