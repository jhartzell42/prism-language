# Derived by hand from Type System ch. 4 (a sigiled parameter is not lifted over) and
# Semantics ch. 7 (`$d on !e` samples the value as the tick opened): `Wrap`'s element is
# the count, `$Inc` one more, `$Plus` the ones and the tens, and `!Bump` the count at the
# tick's opening plus one, at a Go.
test a_dynamic_kept_whole

tick 0
  added:
    0: Ui.Button(label="Inc")
    1: Ui.Label(text="first 0")

tick 1
  in:
    0: click
  changed:
    1: Ui.Label(text="first 1")

tick 2
  in:
    0: click
  changed:
    1: Ui.Label(text="first 2")

test a_lift_over_one

tick 0
  added:
    0: Ui.Button(label="Inc")
    1: Ui.Label(text="inc 1")

tick 1
  in:
    0: click
  changed:
    1: Ui.Label(text="inc 2")

test a_lift_over_two

tick 0
  added:
    0: Ui.Button(label="Inc")
    1: Ui.Button(label="Ten")
    2: Ui.Label(text="sum 0")

tick 1
  in:
    0: click
  changed:
    2: Ui.Label(text="sum 1")

tick 2
  in:
    1: click
  changed:
    2: Ui.Label(text="sum 11")

tick 3
  in:
    0: click
    1: click
  changed:
    2: Ui.Label(text="sum 22")

test an_event_taken_whole

tick 0
  added:
    0: Ui.Button(label="Inc")
    1: Ui.Button(label="Go")
    2: Ui.Label(text="last 0")

tick 1
  in:
    1: click
  changed:
    2: Ui.Label(text="last 1")

tick 2
  in:
    0: click

tick 3
  in:
    0: click
    1: click
  changed:
    2: Ui.Label(text="last 2")
