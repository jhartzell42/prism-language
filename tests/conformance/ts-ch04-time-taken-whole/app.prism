# Functions whose parameters are sigiled take the dynamic or the event whole (Type System
# ch. 4, Application: "A sigiled parameter is not lifted over"): `Wrap` keeps the dynamic
# in a list, `$Inc` and `$Plus` lift inside their own bodies over one dynamic and over two,
# and `!Bump` fires on its event with its dynamic's value. Each is read by a caller and
# shown across ticks. Written by Claude on the claude-bugs branch; subject to change.
emit Ui.*
test mod Tests

Wrap: fn $Nat -> [$Nat]
fn Wrap $a = [[$a]]

$Inc: fn $Nat -> $Nat
fn $Inc $a = $a + 1

$Plus: fn $Nat, $Nat -> $Nat
fn $Plus $a, $b = $a + $b

!Bump: fn $Nat, !a -> !Nat
fn !Bump $n, !go = $n + 1 on !go

@wrapped:
    !inc <- Ui.Button(label=$"Inc")                             # 0
    $count <- 0 then $count + 1 on !inc
    let $first = Or (Wrap $count)[0], ($ 0)
    Ui.Label(text=$"first {$first}")                            # 1

@incremented:
    !inc <- Ui.Button(label=$"Inc")                             # 0
    $count <- 0 then $count + 1 on !inc
    Ui.Label(text=$"inc {$Inc $count}")                          # 1

@summed:
    !inc <- Ui.Button(label=$"Inc")                             # 0
    !dec <- Ui.Button(label=$"Ten")                             # 1
    $ones <- 0 then $ones + 1 on !inc
    $tens <- 0 then $tens + 10 on !dec
    Ui.Label(text=$"sum {$Plus $ones, $tens}")                    # 2

@bumped:
    !inc <- Ui.Button(label=$"Inc")                             # 0
    !go <- Ui.Button(label=$"Go")                               # 1
    $count <- 0 then $count + 1 on !inc
    $last <- 0 then !Bump $count, !go
    Ui.Label(text=$"last {$last}")                              # 2
