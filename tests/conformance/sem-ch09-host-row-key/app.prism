# A hosted `for` row's place whose level is constant but reads the row's key: the host's
# document reads the row's level through the row (`Row::document`), where the key is the
# row's own. Written by Claude on the claude-self-hosting branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

@child: @unit
@child:
    !add <- Ui.Button(label=$"add")                              # 0
    $items <- {0: unit} then (Insert $items, (Size $items), unit) on !add
    for k, $u <- $items:                                         # 1/[k]
        Ui.Label(text=$"item {k}")                               # 1/[k]/0

@forwarded: @unit
@forwarded:
    ((ignore, $doc)) <- @HostDocument @child, \|p, e| @Element e    # 0/[p]/0
    Ui.Label(text=$"{Size $doc} places")                         # 1
