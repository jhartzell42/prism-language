# prism_zero's transcript; the book prints none for this program, and it was checked by hand against the book's rules.
test hold_starts_over

tick 0
  added:
    0: Ui.Button(label="New round")
    1: Ui.Button(label="Score")
    2/#0/0: Ui.Label(text="round 0: 0")

tick 1
  in:
    1: click
  changed:
    2/#0/0: Ui.Label(text="round 0: 1")

tick 2
  in:
    0: click
    1: click
  added:
    2/#1/0: Ui.Label(text="round 1: 0")
  torn down:
    2/#0/0: Ui.Label(text="round 0: 1")
