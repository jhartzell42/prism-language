# A hold whose value is a tuple that holds a dynamic: it starts from a tuple written
# over `$a`, and takes a constant's tuple over `$b` on an event (Type System ch. 1: a
# dynamic of a tuple that holds a dynamic is a type as any other; Semantics ch. 7: a hold
# keeps the value its event gave it). The tuple holds the dynamic itself: `@Flatten`
# over its part follows `$a`, then `$b`. sem-ch07-flatten-held with the dynamics inside
# tuples. Written by Claude on the claude-lowering branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

$First: fn (($Nat, Text)) -> $Nat
fn $First (($n, ignore)) = $n

Named: fn (($Nat, Text)) -> Text
fn Named ((ignore, name)) = name

@page: @unit
@page:
    !inc <- Ui.Button($label=$"inc")                         # 0
    !swap <- Ui.Button($label=$"swap")                       # 1
    $a <- 0 then $a + 1 on !inc
    $b <- 100 then $b + 1 on !inc
    let $other = $ (($b, "t"))
    $held <- (($a, "s")) then $other on !swap
    let $$first = $First $held
    $shown <- @Flatten $$first
    Ui.Label($text=$"{$shown} {Named $held}")                # 2
