# The tests of sem-ch07-hold-of-tuple-holding-dynamic.
emit Ui.*
use App.*

test the_held_tuple_holds_the_dynamic, @page:
    build
        => expect Ui.Label(text="0 s")
    click at 0
        => expect Ui.Label(text="1 s")
    click at 1
        => expect Ui.Label(text="1 t")
    compute
        => expect Ui.Label(text="101 t")
