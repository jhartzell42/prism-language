# A widget defined in a block read as a blueprint value in the body of a function
# defined in the same block: the function hands it to a plain function, and the block's
# lines call the function and apply what comes back (Semantics ch. 3: `fn` and its `@`
# form define in the block, and a function of the block reads the block's names; ch. 8:
# "a blueprint builds nothing until a block applies it", at the applying block's next
# positions; Type System ch. 2: a blueprint is an opaque handle and still a value).
# sem-ch08-local-widget-passed-as-value with the reading inside a local function.
# Written by Claude on the claude-lowering branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

?Pick: fn Bool, @a -> ?@a
fn ?Pick b, @w = if b: ? @w else: nil

@page: @unit
@page:
    let n = 7
    @line:
        Ui.Label($text=$"line {n}")
    fn ?Made b = ?Pick b, @line
    match ?Made True:                                            # 0
        ? @t: @t
        nil: Ui.Label($text=$"none")
    match ?Made False:                                           # 1
        ? @t: @t
        nil: Ui.Label($text=$"none")
    Ui.Label($text=$"end")                                       # 2
