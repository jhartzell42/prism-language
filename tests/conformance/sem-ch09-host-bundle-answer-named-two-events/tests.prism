# The tests of sem-ch09-host-bundle-answer-named-two-events.
emit Ui.* | Pad.*
use App.*

test a_named_bundle_of_two_events, @mocked:
    build
        => expect Ui.Label(text="none, 0 lost")
    click at 0
    compute
        => expect Ui.Label(text="hello, 0 lost")
    click at 1
    compute
        => expect Ui.Label(text="hello, 3 lost")
