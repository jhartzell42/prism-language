# A building `match` whose arm ends on a plain result (Semantics ch. 4: the arm is fixed for
# the life of the block and adds no path segment; ch. 8: `<-` builds the child and binds
# its result, and the block's places are born in source order). The arm reads the block's
# own `$gone`, and the line after it reads the arm's result at the build.
# Written by Claude on the claude-lowering branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

type Mode = choice:
    Loud Text
    Soft
derive ^Eq, ^Show

@Panel: fn Mode -> @unit
fn @Panel mode:
    !go <- Ui.Button($label=$"go")                                     # 0
    $gone <- 0 then $gone + 1 on !go
    n <- match mode:                                                   # 1
        Loud t:
            Ui.Label($text=$"{t} {$gone}")                             # 1
            @ 10
        Soft:
            Ui.Label($text=$"soft")                                    # 1
            @ 20
    Ui.Label($text=$"n {n}")                                           # 2

@main: @unit
@main:
    @Panel (Loud "x")                                                  # 0, 1, 2
