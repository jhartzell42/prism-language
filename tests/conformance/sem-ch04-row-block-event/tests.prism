# Written by Claude on the claude-self-hosting branch; subject to change.
emit Ui.*
use App.*

test go_once, @host:
    build
    click at 0
    tick
    click at 1/["a"]/1
    tick

test go_alone, @alone:
    build
    click at 0
    click at 0

test go_nested, @nested:
    build
    click at 0
    click at 1/["a"]/2/["x"]/0
    click at 1/["a"]/0
