# The tests of sem-ch09-bundle-plain-beside-dynamic. The World's state for the element is
# the whole first value, the plain part and the `$` part's current value.
emit Ui.* | Pad.*
use App.*

test plain_beside_dynamic, @chat:
    with Pad.Port(address="chat:7000") = ((7, "up")), build
        => expect Ui.Label(text="port 7: up")
    push Pad.Port(address="chat:7000") = ((7, "down"))
        => expect Ui.Label(text="port 7: down")
