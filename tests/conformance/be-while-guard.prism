# A `while` over a fuel pattern with a guard (`while ? left <- &fuel -? 1 if &i < n:`), as
# prismc's lexer closes its layout: the guard ends the loop as a failed match does.
# Written for prismc's back end. Work in progress, subject to change.
emit Ui.*

Count: unbounded fn Nat -> Nat
fn Count n = update 0:
    let &fuel = 100
    let &i = 0
    while ? left <- &fuel -? 1 if &i < n:
        &fuel <= left
        &i += 1
        &_ += 2

Counts: unbounded fn Nat -> Text
fn Counts n = "{Count n} {Count 0}"

@Shown: fn Nat -> @unit
fn @Shown n:
    !done <- @Run Counts, n                                 # 0
    $shown <- "working" then !done
    Ui.Label(text=$shown)                                   # 1
