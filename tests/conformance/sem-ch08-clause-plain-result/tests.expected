# Derived by hand from Semantics ch. 4 and 8: the argument chooses the clause, whose places take the page's first positions (the page's own places take the next numbers after the places the clause built, ruling TC: 2 to 4 after the clause of two, 1 to 3 after the clause of one), and its plain result is bound at the build.
test some_clause

tick 0
  added:
    0: Ui.Label(text="some 3")
    1: Ui.Label(text="second")
    2: Ui.Label(text="n3")
    3: Ui.Button(label="go")
    4: Ui.Label(text="n3 0")
  result: "n3"

tick 1
  in:
    3: click
  changed:
    4: Ui.Label(text="n3 1")

test none_clause

tick 0
  added:
    0: Ui.Label(text="none")
    1: Ui.Label(text="zero")
    2: Ui.Button(label="go")
    3: Ui.Label(text="zero 0")
  result: "zero"
