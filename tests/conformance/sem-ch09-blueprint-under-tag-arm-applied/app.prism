# A blueprint value made under a tag's arm, a widget with a plain result, taken out of the
# option the function gives and applied by a block that binds its result (Semantics
# ch. 8: "a blueprint builds nothing until a block applies it", and `<-` binds its result;
# Type System ch. 2: a blueprint is an opaque handle and still a value, the same value
# whichever arm made it). Written by Claude on the claude-lowering branch; subject to
# change.
emit Ui.* | Pad.*
test mod Tests

?Pick: fn Bool, @a -> ?@a
fn ?Pick b, @w = if b: ? @w else: nil

tag Pad.Ask of Element Nat:
    question: Text

@Answerer: fn Nat -> @Nat
fn @Answerer n:
    Ui.Label($text=$"answering {n}")
    @ n + 1

?Made: fn Element (Ui.* | Pad.*) o -> ?@Nat
fn ?Made e = match e:
    Pad.Ask(..): ? (@Answerer 3)
    otherwise: nil

@host: @unit
@host:
    match ?Made (Pad.Ask(question="x")):
        ? @t:
            n <- @t
            Ui.Label($text=$"got {n}")
        nil: Ui.Label($text=$"none")
