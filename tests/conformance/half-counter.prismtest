# The half counter's tests: declarations of half-counter.prism (Semantics chapter 6). Not yet run.

test the_half_counter_only_counts_up, @halfcounter:
    build
        => expect Ui.Label(text="Count: 0")
        => expect_count Ui.Button(..), 1
    click Ui.Button(label="Increment")
        => expect Ui.Label(text="Count: 1")
    click Ui.Button(label="Increment")
        => expect Ui.Label(text="Count: 2")
    tick
        => expect Ui.Label(text="Count: 2")
