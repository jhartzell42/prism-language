emit Ui.* | Fs.*
use App.*
use Fs.*

test a_supplier_per_child_place, @mocked:
    build
        => expect_none Fs.Contents(..)
        => expect Ui.Label(text="3 places")
    click at 0/[0]/0
        => expect Ui.Label(text="1 mock")

test host_some_forwards_on_nil, @some:
    build
        => expect Ui.Label(text="0 given")
    click Ui.Button(label="Increment")
        => expect Ui.Label(text="1 given")

test a_forwarding_host_is_not_there, @forwarded:
    with Fs.Contents(path="/etc/motd") = ~ Contents(text="hello"), build
        => expect Fs.Contents(path="/etc/motd")
    click Ui.Button(label="Increment")
        => expect Ui.Label(text="1 hello")
    push Fs.Contents(path="/etc/motd") = ~ Contents(text="bye")
        => expect Ui.Label(text="1 bye")

test the_bare_child, @child:
    with Fs.Contents(path="/etc/motd") = ~ Contents(text="hello"), build
    click Ui.Button(label="Increment")
    push Fs.Contents(path="/etc/motd") = ~ Contents(text="bye")
