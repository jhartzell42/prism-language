# The book prints none for this program; checked by hand against the book's rules.
test a_supplier_per_child_place

tick 0
  added:
    0/[0]/0: Ui.Button(label="Increment")
    0/[2]/0: Ui.Label(text="0 mock")
    1: Ui.Label(text="3 places")

tick 1
  in:
    0/[0]/0: click
  changed:
    0/[2]/0: Ui.Label(text="1 mock")

