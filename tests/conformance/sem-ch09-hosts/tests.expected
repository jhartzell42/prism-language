test a_forwarding_host_is_not_there

tick 0
  added:
    0/[0]/0: Ui.Button(label="Increment")
    0/[1]/0: Fs.Contents(path="/etc/motd")
    0/[2]/0: Ui.Label(text="0 hello")

tick 1
  in:
    0/[0]/0: click
  changed:
    0/[2]/0: Ui.Label(text="1 hello")

tick 2
  in:
    Fs.Contents(path="/etc/motd") = ~ Contents(text="bye")
  changed:
    0/[2]/0: Ui.Label(text="1 bye")

test the_bare_child

tick 0
  added:
    0: Ui.Button(label="Increment")
    1: Fs.Contents(path="/etc/motd")
    2: Ui.Label(text="0 hello")

tick 1
  in:
    0: click
  changed:
    2: Ui.Label(text="1 hello")

tick 2
  in:
    Fs.Contents(path="/etc/motd") = ~ Contents(text="bye")
  changed:
    2: Ui.Label(text="1 bye")
