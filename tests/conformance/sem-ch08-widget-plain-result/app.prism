# A widget whose block ends on a plain value (Semantics ch. 4: "`@ v` lifts a plain value
# into the widget"; ch. 8: `<-` with a blueprint builds the child and binds its result):
# `@Door` ends on its door's first value, `door <- @Door $called` binds it at the page,
# and the page reads it in the build (a plain `let`, a hold's initial value, a plain
# argument of another widget) and in a dynamic a click re-reads on a later tick (a label,
# the hold's step); a tuple of names binds a plain tuple result part by part. Written by
# Claude on the claude-widget-plain branch; subject to change.
emit Ui.* | Pad.*
test mod Tests

tag Pad.Door of Element ((Text, !Nat)):
    name: $Text

@Door: fn $Text -> @Text
fn @Door $name:
    ((door, !knocks)) <- Pad.Door(name=$name)
    Ui.Label(text=$"inside {door}")
    @ door

@Sign: fn Text -> @unit
fn @Sign word:
    Ui.Label(text=$"sign {word}")

@Ends: fn Nat -> @((Nat, Nat))
fn @Ends n:
    @ ((n, n + 1))

@page: @$Text
@page:
    $called <- "front" then "back" on !never
    door <- @Door $called                                   # 0, 1
    let greeting = "hello {door}"
    Ui.Label(text=$"{greeting}")                            # 2
    @Sign door                                              # 3
    !more <- Ui.Button(label=$"more")                       # 4
    $n <- 0 then $n + 1 on !more
    Ui.Label(text=$"{door} knocked {$n}")                   # 5
    $said <- door then "{$said}, {door}" on !more
    !never <- Ui.Button(label=$"never")                     # 6
    ((low, high)) <- @Ends 2
    ((ignore, top)) <- @Ends high
    Ui.Label(text=$"{low} to {top} after {$n}")              # 7
    @ $said
