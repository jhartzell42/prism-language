# Duration literals (Semantics ch. 2, "Durations": a digit string with at most one point
# and a unit, a whole number of nanoseconds, a prefix minus) and the element they ask a
# World for, `Time.After` (Appendix B, `@Later`; prelude/time.prism): its request field
# carries a `Wake` whose `after` is a duration, and its output, the wake answered back, is
# heard in the tick the World delivers it. A transcript prints a duration in its largest
# whole unit (Type System ch. 2). Written by Claude on the claude-lowering branch; subject
# to change.
emit Ui.* | Time.*
test mod Tests

@sleeper: @$Nat
@sleeper:
    !go <- Ui.Button($label=$"go")                                          # 0
    !woke <- Time.After(!wakes=(Time.Wake(after=1.5s, context="nap") on !go))   # 1
    $n <- 0 then $n + 1 on !woke
    Ui.Label($text=$"woke {$n}")                                            # 2
    Ui.Label($text=$"{250ms} {1.3ms} {2min} {-2s} {1h} {7ns} {0.5us} {90s}")   # 3
    @ $n
