# A `let` of a bundle one of whose parts reads a building `match`'s plain result, read by
# a line above the `let` (Semantics ch. 4, "Binding groups and cycles": any line may use
# any name the block binds, and "the order of a group's lines decides positions and
# nothing else"). sem-ch04-late-let-bundle-above with the reader above the `let`.
# Written by Claude on the claude-lowering branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

type Mode = choice:
    Loud Text
    Soft
derive ^Eq, ^Show

@Panel: fn Mode -> @unit
fn @Panel mode:
    !go <- Ui.Button($label=$"go")
    @Counter pair
    let pair = ((n + 1, !go))
    n <- match mode:
        Loud t:
            Ui.Label($text=$"{t}")
            @ 10
        Soft:
            @ 20

@Counter: fn ((Nat, !Click)) -> @unit
fn @Counter ((step, !go)):
    $total <- 0 then $total + step on !go
    Ui.Label($text=$"total {$total}")

@Page: fn Mode -> @unit
fn @Page mode:
    @Panel mode
