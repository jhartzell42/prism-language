# A building `if` whose condition is a building `match`'s plain result, written above the
# `match` (Semantics ch. 4, "Binding groups and cycles": a widget block is one binding
# group, any line may use any name the block binds, and "the order of a group's lines
# decides positions and nothing else"; ruling IE2: a building `if` may stand without an
# `else`; ruling TC: places are counted as they are built). Nothing here is a cycle: the
# `match` does not read the `if`. Written by Claude on the claude-lowering branch; subject
# to change.
emit Ui.*
test mod Tests
use Ui.*

type Mode = choice:
    Loud Text
    Soft
derive ^Eq, ^Show

@Panel: fn Mode -> @unit
fn @Panel mode:
    if n > 15:                                                         # none, or 0
        Ui.Label($text=$"big {n}")
    n <- match mode:
        Loud t:
            Ui.Label($text=$"{t}")                                     # 0
            @ 10
        Soft:
            @ 20
    Ui.Label($text=$"below {n}")                                       # 1

@Page: fn Mode -> @unit
fn @Page mode:
    @Panel mode
