# The tests of sem-ch09-host-bundle-answer-structural-part.
emit Ui.* | Pad.*
use App.*

test a_structural_part_answers, @host:
    build
        => expect Ui.Label(text="1: none")
    click at 0
    compute
        => expect Ui.Label(text="1: hello")
    compute
        => expect Ui.Label(text="2: hello")
