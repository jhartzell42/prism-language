# A building `match`'s plain result taken as a value at the build by a line above it,
# where an arm reads a name of the block (Semantics ch. 4, "Binding groups and cycles":
# a widget block is one binding group, any line may use any name the block binds, and
# "the order of a group's lines decides positions and nothing else"; ch. 8: `<-` binds
# the arm's plain result). Nothing here is a cycle: the arm reads the widget's parameter,
# never the tile. Written by Claude on the claude-lowering branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

type Mode = choice:
    Loud Text
    Soft
derive ^Eq, ^Show

@Tile: fn Nat -> @unit
fn @Tile k:
    Ui.Label($text=$"tile {k}")

@Panel: fn Mode, Text -> @unit
fn @Panel mode, title:
    @Tile n                                                            # 0
    n <- match mode:
        Loud t:
            Ui.Label($text=$"{title}: {t}")                            # 1
            @ 10
        Soft:
            @ 20
    Ui.Label($text=$"below {n}")                                       # 2, or 1

@Page: fn Mode -> @unit
fn @Page mode:
    @Panel mode, "top"
