# `@HostList`, the list form of hosting (Semantics ch. 9: "the child's places in hand,
# answers sent down by path, a supplier for the rest"): each firing of the answers event
# hands each place its key names that answer, as a computed answer, the next tick's input,
# which is owed; the supplier forwards the rest, whose answers from the World arrive in
# their own tick. The paths come from the host's own document, one tick behind. An answer
# is made with its tag's output constructor, `Ui.Button.Output click` (Semantics rulings
# round 12, AQ). Written by Claude on the claude-lowering branch; subject to change.
emit Ui.*
test mod Tests
use Ui.*

@child: @unit
@child:
    !press <- Ui.Button($label=$"inner")                                 # 0
    $n <- 0 then $n + 1 on !press
    Ui.Label($text=$"pressed {$n}")                                      # 1

@list: @unit
@list:
    !send <- Ui.Button($label=$"send")                                   # 0
    let !answers = (Map (Each (Take (Keys $doc), 1), \|p| ((p, Ui.Button.Output click)))) on !send
    ((ignore, $doc)) <- @HostList @child, !answers, \|p, e| @Element e   # 1/[p]/0
