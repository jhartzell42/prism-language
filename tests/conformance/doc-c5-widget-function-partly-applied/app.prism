# Part VII ch. 7, step C5's test: a widget function applied to its settings only is a
# function value (Part III ch. 7; Part IV ch. 5, doubt PA's first ruling: `@InMemory
# fresh` leaves the guests' element tree for `@HostDocument` to supply). `@Counter 5` is
# passed to a function that builds it once, with the rest of its arguments; the count
# starts at 5.
# Written by Claude on the claude-lowering branch; subject to change.
emit Ui.*
test mod Tests

@Counter: fn Nat, Text -> @unit emit Ui.*
fn @Counter start, label:
    !press <- Ui.Button($label=$ label)                                         # 0
    $count <- start then $count + (1 on !press)
    Ui.Label($text=$"{label}: {$count}")                                        # 1

# Builds what it is given, once, with the label it chooses.
@Hosted: fn (fn Text -> @unit emit Ui.*) -> @unit emit Ui.*
fn @Hosted Make:
    Ui.Label($text=$"hosted")                                                   # 0
    Make "count"                                                                # 1

@page: @unit
@page:
    @Hosted (@Counter 5)
