# Chess as a document hosted by a hand-written implementation, Part IV ch. 5's "A
# hand-written implementation", the way the plan's step H2 builds it (Part IV ch. 13; Part
# VII ch. 7, step C6's test). The game is Part V ch. 9's, every position and every move;
# the protocol is Part IV ch. 3's, written out; the seats are Part IV ch. 5's record of
# live maps, one per role, hosted by the library's `@HostRole` and `@Seated`.
# Rules and Notation are host-chess's, copied unchanged: plain functions with no time.
# Written by Claude on the claude-self-hosting branch; subject to change.
emit rest | Seat.*
use Documents.*
use Rules.*
use Notation.*

# ---- the game (Part V ch. 9): every position and every move

type ChessGame = record:
    positions: [Position]
    moves: [ChessMove]
derive ^Eq, ^Show

let fresh = ChessGame(positions=[[start]], moves=[[]])

Now: fn ChessGame -> Position
fn Now g = Or (?Last g.positions), start

# why a move is not played (Part IV ch. 4, ruling NT): a value, never a sentence
type ChessReason = choice:
    NotYourMove
    IllegalMove ChessMove
derive ^Eq, ^Show

MoveBy: fn ChessGame, Color, ChessMove -> Stepped ChessGame ChessReason
fn MoveBy game, side, move = if side != (Now game).turn: Denied NotYourMove else:
    match ?Played (Now game), move:
        ? next: Next ChessGame(positions=(Push game.positions, next), moves=(Push game.moves, move))
        nil: Denied (IllegalMove move)

# ---- the protocol (Part IV ch. 3)

type ChessQuery = choice:
    Whole
derive ^Eq, ^Show

type ChessSeats rest = record:
    $player: (Color ==> $@(@unit emit Seat.* ChessGame Player | rest))
    $spectator: (Text ==> $@(@unit emit Seat.* ChessGame Spectator | rest))

type ChessResults = record:
    $player: (Color ==> unit)
    $spectator: (Text ==> unit)

impl ^Document ChessGame:
    type Role = GameRole
    type SeatId Player = Color
    type SeatId Spectator = Text
    type Request Player = ChessMove
    type Request Spectator = Never
    type Reason Player = ChessReason
    type Reason Spectator = Never
    type Query r = ChessQuery
    type Answer r = ChessGame
    type Seats rest = ChessSeats rest
    type Results = ChessResults
    fn @HostSeats seats, Supply:
        ((players, $playing)) <- @HostRole Fixed<<Player>>, seats.$player, Supply
        ((spectators, $watching)) <- @HostRole Fixed<<Spectator>>, seats.$spectator, Supply
        @ ((ChessResults($player=players, $spectator=spectators), $Merge [[$playing, $watching]]))

# One request's step, by role: a player moves; a spectator's request is `Never`.
Stepping: forall (r: Role ChessGame). fn ChessGame, Fixed r, SeatId ChessGame r, Request ChessGame r -> Stepped ChessGame (Reason ChessGame r)
fn Stepping game, Fixed<<Player>>, side, move = MoveBy game, side, move
fn Stepping game, Fixed<<Spectator>>, user, request = match request:

# ---- the hand-written implementation (Part IV ch. 5)

# One tick's requests in the default order: those to apply, and those that wait.
type Turned = record:
    apply: [Pending ChessGame]
    wait: [Pending ChessGame]

Turn: fn [Pending ChessGame] -> Turned
fn Turn due:
    let byPlace = Map (Each due, \|pending| ((pending.due.at, pending)))
    let order = OneATick (Each due, \|pending| pending.due)
    Turned(apply=(Picked byPlace, order.apply), wait=(Picked byPlace, order.wait))

# The applied requests, each against the game the one before left, with each response.
Steps: fn ChessGame, Turned -> ((ChessGame, [Responded ChessGame]))
fn Steps game, turn = Fold turn.apply, ((game, [[]])), \|((now, said)), pending| match pending.asked:
    any ((role, id, request)): match Stepping now, role, id, request:
        Next next: ((next, (Push said, Responded(at=pending.due.at, response=(any Accepted)))))
        Denied why: ((now, (Push said, Responded(at=pending.due.at, response=(any (Declined why))))))

PlayAll: fn ChessGame, Turned -> ChessGame
fn PlayAll game, turn = match Steps game, turn:
    ((next, said)): next

Judge: fn ChessGame, Turned -> [Responded ChessGame]
fn Judge game, turn = match Steps game, turn:
    ((next, said)): said

Waiting: fn Turned -> [Pending ChessGame]
fn Waiting turn = turn.wait

?Any: fn [a] -> ?unit
fn ?Any all = if (Len all) == 0: nil else: ? unit

@ChessByHand: fn Guests ChessGame -> @(Supplier ChessGame)
fn @ChessByHand $guests:
    !fired <- for at, $element <- $guests:                  # each place of the guests
        @Switch (!HeardAt at, $element)
    !again <- @Defer (!Filter (?Any (Waiting !turn)))       # a tick after a request waits
    let !due = Due $waiting, ((Values !fired) <| ([[]] on !again))   # this tick's and those that wait
    let !turn = Turn !due                                   # the default order (chapter 3)
    $game <- fresh then PlayAll $game, !turn                # the applied ones, each in turn
    $waiting <- [[]] then Waiting !turn                     # the rest, due in the next tick
    let !judged = Judge $game, !turn                        # Accepted or Declined why, by path
    @ \|path, seat, element| match element:
        Seat.Request(..): @ !Filter (?ResponseTo path, !judged)
        Seat.Query(..): @ $Loaded $game                      # never nil in memory
        Seat.Leave(..): @ unit

# ---- the game as words, for the participants; the document never speaks

Spelling: fn [ChessMove] -> Text
fn Spelling moves = if (Len moves) == 0: "none" else: Joined (Each moves, Spelled), " "

StatusText: fn ChessGame -> Text
fn StatusText game:
    let now = Now game
    let winner = Opponent now.turn
    if HasMove now: "{now.turn} to move; moves: {Spelling game.moves}" else:
        if InCheck now, now.turn: "checkmate, {winner} wins; moves: {Spelling game.moves}" else: "stalemate; moves: {Spelling game.moves}"
