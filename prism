#!/usr/bin/env bash
# The `prism` command (docs/architecture.md, "Single commands"), a thin shell over a
# native prismc:
#
#   ./prism compile [--target T] SRC... -o OUT   the program in OUT: a Rust crate, or C++
#   ./prism test [--target T] SRC...     compile, build, run the .prismtest scripts
#   ./prism run [--world W] [--print-world] SRC... [-- ARGS...]   compile, build, run the root
#   ./prism check [--world FAMS] SRC...  the checker's report
#
# `--target rust` (the default) or `--target cpp`: the C++ program (runtime/cpp) is built
# with make and `$CXX` (g++ by default) into target/prism-cpp/NAME, and runs its tests
# under the C++ Test World; `run` under the C++ target takes the CLI World only.
#
# SRC is a directory (every `.prism` and `.prismtest` under it), a `.prism` file (with the
# `.prismtest` of its name beside it, when there is one) or a `.prismtest` file. `test`
# runs every script under the compiled Test World, each transcript byte-equal to the
# `.expected` of its name. `run` builds with the World the root's `emit` row asks for, as
# prismc decides it from the root module's row: `Gui.*` the canvas World, anything else
# the CLI World; `--world cli|canvas` overrides. A root whose row has `Ui.*` without
# `Gui.*` is refused: no World answers Ui elements alone.
#
# prismc is `$PRISMC`, or the newest of target/bootstrap/prismc and target/keep/prismc-*
# (the old dynamic chain's binary left out). The crate goes to target/prism/NAME, the
# build to target/prism-build (debug for `test`, release for `run`).
#
# Written by Claude, 2 November 2026, on the claude-self-hosting branch. Subject to change.
set -eu
here=$PWD
root=$(cd "$(dirname "$0")" && pwd)
usage() { sed -n '4,9p' "$0" | sed 's/^# //' >&2; exit 2; }
cmd=${1:-}
[ -n "$cmd" ] || usage
shift

# The arguments: sources, options, and after `--` (or the first argument that is no
# source) the program's own.
srcs=()
out=""
world=""
target=rust
print_world=0
progargs=()
while [ $# -gt 0 ]; do
    case "$1" in
        -o) out=$2; shift 2 ;;
        --world) world=$2; shift 2 ;;
        --target) target=$2; shift 2 ;;
        --target=*) target=${1#--target=}; shift ;;
        --world=*) world=${1#--world=}; shift ;;
        --print-world) print_world=1; shift ;;
        --) shift; progargs=("$@"); break ;;
        *)
            if [ -d "$1" ] || [[ "$1" == *.prism ]] || [[ "$1" == *.prismtest ]]; then
                srcs+=("$1"); shift
            else
                progargs=("$@"); break
            fi ;;
    esac
done
[ ${#srcs[@]} -gt 0 ] || usage

# Paths relative to the repository root, where prismc and the crate expect them.
rel=()
for s in "${srcs[@]}"; do
    case "$s" in /*) a=$s ;; *) a=$here/$s ;; esac
    [ -e "$a" ] || { echo "prism: no such file or directory: $s" >&2; exit 2; }
    r=$(realpath -m --relative-to="$root" "$a")
    case "$r" in ../*) echo "prism: $s is outside the repository" >&2; exit 2 ;; esac
    rel+=("$r")
done
cd "$root"
ulimit -s unlimited 2>/dev/null || ulimit -s 1048576 2>/dev/null || true

prismc=${PRISMC:-}
if [ -z "$prismc" ]; then
    prismc=$(ls -t target/bootstrap/prismc target/keep/prismc-* 2>/dev/null | grep -v old-chain | head -1 || true)
    [ -n "$prismc" ] || { echo "prism: no prismc binary (target/keep/prismc-*, or make bootstrap)" >&2; exit 2; }
fi

# The sources as prismc takes them: a `.prism` file with the `.prismtest` of its name.
sources=()
for s in "${rel[@]}"; do
    sources+=("$s")
    if [[ "$s" == *.prism ]] && [ -f "${s%.prism}.prismtest" ]; then
        t="${s%.prism}.prismtest"
        case " ${rel[*]} " in *" $t "*) ;; *) sources+=("$t") ;; esac
    fi
done

# Every `.prism` file the sources name, directories walked.
prism_files() {
    for s in "${rel[@]}"; do
        if [ -d "$s" ]; then find "$s" -name '*.prism' | sort; elif [[ "$s" == *.prism ]]; then echo "$s"; fi
    done
}

if [ "$cmd" = check ]; then
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT
    mapfile -t files < <(prism_files)
    opts=()
    [ -n "$world" ] && opts=(--world "$world")
    code=0
    "$prismc" --check "${opts[@]}" "${files[@]}" --out "$tmp" > /dev/null 2>&1 || code=$?
    if [ -s "$tmp" ]; then cat "$tmp"; else echo "prism: the checker wrote nothing" >&2; fi
    exit $code
fi

first=${rel[0]%/}
name=$(basename "${first%.prism*}" | tr -c 'a-zA-Z0-9_\n' '_')
case "$name" in [0-9]*) name="p_$name" ;; esac
case "$cmd" in
    compile)
        [ -n "$out" ] || { echo "prism compile: -o OUT is required" >&2; exit 2; }
        case "$out" in /*) ;; *) out=$here/$out ;; esac
        r=$(realpath -m --relative-to="$root" "$out")
        case "$r" in ../*) ;; *) out=$r ;; esac ;;
    test|run) if [ "$target" = cpp ]; then out=target/prism-cpp/$name; else out=target/prism/$name; fi ;;
    *) echo "prism: unknown command $cmd (compile, test, run, check)" >&2; exit 2 ;;
esac
# The crate finds prism_rtl and the Worlds at the repository root: by `..`s when OUT is
# under it (prismc's default), else by the absolute path.
runtime=()
case "$out" in /*) runtime=(--runtime "$root") ;; esac
case "$target" in rust|cpp) ;; *) echo "prism: unknown target $target (rust, cpp)" >&2; exit 2 ;; esac
rm -rf "$out"
targetopt=()
[ "$target" = cpp ] && targetopt=(--target cpp)
"$prismc" compile "${sources[@]}" -o "$out" --name "$name" "${runtime[@]}" "${targetopt[@]}"
[ "$cmd" = compile ] && exit 0

if [ "$target" = cpp ]; then
    # The C++ program: make builds runtime/cpp's library and the program with $CXX.
    opt=-O1
    [ "$cmd" = run ] && opt=-O2
    make -s -C "$out" -j"$(nproc)" CXX="${CXX:-g++}" OPT="$opt" >&2
    if [ "$cmd" = test ]; then exec "$out/$name" test; fi
    asked=$(sed -n 's/^const std::string WORLD = "\(.*\)";$/\1/p' "$out/src/main.cpp")
    [ -n "$world" ] || world=$asked
    if [ "$print_world" = 1 ]; then echo "$world"; exit 0; fi
    exec "$out/$name" --world "$world" "${progargs[@]}"
fi

build() { # profile flags...
    (cd "$out" && CARGO_TARGET_DIR="$root/target/prism-build" cargo build --offline -q "$@")
}

if [ "$cmd" = test ]; then
    build
    exec target/prism-build/debug/"$name" test
fi

# run: the World prismc took from the root's row (`const WORLD` of the crate's main.rs),
# unless --world names one; --print-world prints it and stops before the build.
asked=$(sed -n 's/^const WORLD: &str = "\(.*\)";$/\1/p' "$out/src/main.rs")
if [ "$asked" = test ]; then
    echo "prism run: the program has no @main root to run (prism test runs its tests)" >&2
    exit 2
fi
if [ -z "$world" ]; then
    if [ "$asked" = none ]; then
        echo "prism run: the root's row has Ui.* without Gui.*: no World answers Ui elements alone; emit Gui.* for the canvas World, or pass --world" >&2
        exit 2
    fi
    world=$asked
fi
if [ "$print_world" = 1 ]; then
    echo "$world"
    exit 0
fi
case "$world" in
    canvas) build --release --features canvas ;;
    cli) build --release ;;
    *) echo "prism run: unknown World $world (cli, canvas)" >&2; exit 2 ;;
esac
exec target/prism-build/release/"$name" --world "$world" "${progargs[@]}"
