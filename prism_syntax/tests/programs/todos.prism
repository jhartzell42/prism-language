# Translated by hand from prism-reflex's examples/todos.prism (older spelling) into the books' spelling:
# `let @todos:` became a signature and `@todos:`, `@Button`/`@Label` became `Ui.Button`/`Ui.Label` elements (D10), `|` became `<|`.
type Todo = record:
    label: Text
    done: Bool

type Change = choice:
    Add Text
    Toggle
    Delete

Step: fn Nat ==> Todo, Nat, Change -> Nat ==> Todo
fn Step items, id, change = match change:
    Add label: Insert items, id, (Todo label, False)
    Toggle: match items[id]:
        ? t: Insert items, id, (Todo t.label, not t.done)
        nil: items
    Delete: Remove items, id

StepAll: fn Nat ==> Todo, Nat ==> Change -> Nat ==> Todo
fn StepAll items, changes:
    Fold changes, items, \|acc, id, c| Step acc, id, c

Describe: fn Todo, Bool -> Text
fn Describe t, starred:
    Concat [[(if t.done: "[x] " else: "[ ] "), t.label, (if starred: " *" else: "")]]

@todos: @unit
@todos:
    !add <- Ui.Button(label=$"Add")
    $next <- 0 then $next + 1 on !add
    let !adds = {$next: Add "item {$next}"} on !add
    !rows <- for $items:
        !toggle <- Ui.Button(label=$"Toggle")
        !delete <- Ui.Button(label=$"Delete")
        !star <- Ui.Button(label=$"Star")
        $starred <- False then not $starred on !star
        Ui.Label(text=(Describe $_, $starred))
        @ Toggle on !toggle <| Delete on !delete
    let !changes = !Union !adds, !rows
    $items <- {} then StepAll $items, !changes

test todos_keep_their_rows, @todos:
    build
        => expect Ui.Button(label="Add")
        => expect_none Ui.Label(..)
    click Ui.Button(label="Add")
        => expect Ui.Label(text="[ ] item 0")
        => expect_count Ui.Button(..), 4
    click Ui.Button(label="Star")
        => expect Ui.Label(text="[ ] item 0 *")
    click Ui.Button(label="Toggle")
        => expect Ui.Label(text="[x] item 0 *")
    click Ui.Button(label="Add")
        => expect Ui.Label(text="[ ] item 1")
        => expect Ui.Label(text="[x] item 0 *")
        => expect_count Ui.Label(..), 2
    click Ui.Button(label="Add")
        => expect_count Ui.Label(..), 3

