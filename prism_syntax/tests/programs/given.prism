# Translated by hand from prism-reflex's examples/given.prism (older spelling) into the books' spelling:
# the check named `forbid` (a keyword, reserved everywhere) became `forbids`.
# The `given:` block over `?` (prism-notes maybe-blocks.md): a bind takes the inside of an
# optional, a refutable pattern or a false `require` gives up, and giving up is nil.

type Shape = choice:
    Circle Int
    Square Int

?Half: fn Int -> ?Int
fn ?Half n:
    require (Mod n, 2) == 0
    h <- n / 2                     # division is already a `?Int`: a bind takes its inside
    ? h

?Quarter: fn Int -> ?Int
fn ?Quarter n:
    h <- ?Half n
    q <- ?Half h
    let r = q + 0
    ? r

?Side: fn ?Shape -> ?Int
fn ?Side ms:
    Square s <- ms
    ? s

?FirstEven: fn [Int] -> ?Int
fn ?FirstEven xs = given: x <- ?Find xs, \|n| (Mod n, 2) == 0; ? x

check binds:
    ?Quarter 12 => ? 3
    ?Quarter 6 => nil
    ?Quarter 7 => nil
    ?Half 8 => ? 4

check refutable_patterns:
    ?Side (? (Square 2) ) => ? 2
    ?Side (? (Circle 1) ) => nil
    ?Side nil => nil

Mixed: [Int]
let Mixed = [[1, 3, 4, 6]]
Odd: [Int]
let Odd = [[1, 3]]

check inline:
    ?FirstEven Mixed => ? 4
    ?FirstEven Odd => nil

# `forbid` beside `require` (book2 round 4): the negative guard
?Unpaired: fn Nat -> ?Nat
fn ?Unpaired n:
    forbid (Mod n, 2) == 0
    ? n

check forbids:
    ?Unpaired 3 => ? 3
    ?Unpaired 4 => nil
