# Conformance A.1 and A.2: `=>` opens a step's checks; `#` after `/` is a path segment
test a_row_closes_its_file, @journal:
    build
        => expect Fs.File(path="page1.txt")
    click at 0, click at 1/#0/0     # a comment after a path
        => unrequested Fs.File(..)
    click element 0/[e2]/0
    compute until idle
        => quiet
check calls:
    Call Heron => "fraaank"
let after = a => b
