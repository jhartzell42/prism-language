emit Ui.*
sep @thermostat : @unit
sep @thermostat :
open !down <- Ui.Button ( label = $TEXT(-1) )
sep !up <- Ui.Button ( label = $TEXT(+1) )
sep let !step = -pre 1 on !down <| +pre 1 on !up
sep $target <- 20 then $target + !step
sep $low <- 20 then Min $low , $target + !step
sep $high <- 20 then Max $high , $target + !step
sep Ui.Label ( text = TEXT(Set to {$target}, seen {$low} to {$high}) )
close
sep check range_widens :
open (·(·( Min 18 , 20 ) , ( Max 22 , 20 )·)·) == (·( 18 , 22 )·)
close
