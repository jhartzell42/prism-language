(module
  (emit (row Ui.*))
  (use Birds.*)
  (use Ui)
  (sig Report (fn Nat ?Species -> Text))
  (fn Report (params n nil)
    (text {n} " birds"))
  (fn Report (params n (group (free? s)))
    (text {n} " birds, the last a " {(call Show s)}))
  (sig @main @unit)
  (widget @main
    (bind !robin (call @Spotter Robin))
    (bind !wren (call @Spotter Wren))
    (bind !heron (call @Spotter Heron))
    (let !seen (<| (<| !robin !wren) !heron))
    (hold $count 0 then (on (+ $count 1) !seen))
    (hold $?last nil then (free? !seen))
    (call() Ui.Label text=(group (call Report $count $?last)))))
