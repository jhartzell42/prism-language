(module
  (sig Describe (fn ?Exception -> Text))
  (fn Describe (params nil)
    "no exceptions")
  (fn Describe (params (group (free? x)))
    (text "gave up: " {(. x message)}))
  (sig @Restarting (fn @unit -> @unit))
  (fn @Restarting (params @child)
    (bind !gaveUp Prelude.Exceptions)
    (bind !again (call() Ui.Button label=$"Restart"))
    (hold $gen 0 then (on (+ $gen 1) !again))
    (hold $?last nil then (<| (group (free? !gaveUp)) (group (on nil !again))))
    (call() Ui.Label text=(call Describe $?last))
    (ignore (rebuild $gen
      @child)))
  (sig Body (fn Contents -> Text))
  (fn Body (params c)
    (. c text))
  (widget @motdOnce
    (bind !started @started)
    (bind !~read (call() Fs.File path="/etc/motd" requests=(group (on Read !started))))
    (bind !read (call() Prelude.Unwrap value=!~read))
    (hold $text "(reading...)" then (call Body !read))
    (call() Ui.Label text=$text)))
