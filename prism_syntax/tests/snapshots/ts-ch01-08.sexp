(module
  (sig @Grid (fn Nat (free$ (group (==> Path Elem))) -> @!Routed))
  (sig @Switch (fn $!a -> @!a))
  (sig !Leftmost (fn [!a] -> !a))
  (fn !Leftmost (params events)
    (call Fold events never (lambda (params !acc !e) (<| !acc !e))))
  (sig $Constant (fn a -> $a))
  (fn $Constant (params x)
    (free$ x))
  (sig ?Move (fn Game Sq Sq -> ?Game))
  (fn ?Move (params g from to)
    (bind pc (call ?At g from))
    (require (== (. pc color) (. g turn)))
    (forbid (== from to))
    (let board (call Insert (group (call Remove (. g board) from)) to pc))
    (free? (call() Game board=board turn=(call Opponent (. g turn))))))
