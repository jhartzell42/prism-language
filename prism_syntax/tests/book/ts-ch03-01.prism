# 02-type-system/book/ch-03-traits.md, line 15
@scores: @unit
@scores:
    !home <- Ui.Button(label=$"Home scores")
    !away <- Ui.Button(label=$"Away scores")
    $home <- 0 then $home + 1 on !home
    $away <- 0 then $away + 1 on !away
    let $level = $home == $away
    let $leader = if $home < $away: "away" else: "home"
    Ui.Label(text=$"{$home} to {$away}, {if $level: "level" else: $leader}")
