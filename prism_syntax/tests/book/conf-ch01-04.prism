# 04-conformance/book/ch-01-the-test-language.md, line 242
PageFile: fn Nat -> Text
fn PageFile n = "page{n}.txt"

@journal:
    !turn <- Ui.Button(label=$"Next page")                              # 0
    $page <- 1 then $page + 1 on !turn
    ignore <- rebuild $page:                                            # 1/#g
        ignore <- Fs.File(path=PageFile _, requests=((Write "end of page {_}\n") on !turn))
