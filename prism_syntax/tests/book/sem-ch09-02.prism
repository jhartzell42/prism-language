# 01-semantics/book/ch-09-hosting-and-worlds.md, line 84
# Each: one supplier per place; forwarding is re-emission in the generic arm
@HostDocument: fn @a emit c, (fn Path, Element c o -> @o) -> @((a, $(Path ==> Elem c)))

# Some: nil means "not mine, forward it"
@HostSome: fn @a emit c, (fn Path, Element c o -> ?@o) -> @((a, $(Path ==> Elem c)))

# List: the child's places in hand, answers sent down by path, a supplier for the rest
@HostList: fn @a emit c, !(Path ==> Answer c), (fn Path, Element c o -> @o)
    -> @((a, $(Path ==> Wired c)))
