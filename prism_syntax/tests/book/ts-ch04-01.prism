# 02-type-system/book/ch-04-expressions-and-lifting.md, line 17
@thermostat:
    !up <- Ui.Button(label=$"Warmer")
    !down <- Ui.Button(label=$"Cooler")
    $room <- @Sensor "hall"
    $target <- 20 then $target + (+1 on !up <| -1 on !down)
    let tolerance = 1
    let margin = 2 * tolerance
    let $gap = $target - $room
    Ui.Label(text=$"{$room} in the hall, {$target} wanted")
    Ui.Label(text=$"{if $gap > margin: "heating" else: "idle"}")
