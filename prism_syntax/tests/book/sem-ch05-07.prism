# 01-semantics/book/ch-05-and-blocks.md, line 224
Components: fn Nat, [((Nat, Nat))] -> [Nat]
fn Components n, edges = update [[]]:
    let &parent = Buffer.Numbered n              # 0, 1, ..., n - 1
    for ((a, b)) <- edges:
        let &ra = a
        while ? p <- &parent[&ra] if p != &ra:
            &ra <= p
        let &rb = b
        while ? p <- &parent[&rb] if p != &rb:
            &rb <= p
        &parent[&ra] <= ? &rb
    &_ <= Freeze &parent
