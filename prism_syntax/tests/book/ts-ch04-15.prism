# 02-type-system/book/ch-04-expressions-and-lifting.md, line 419
@scoreboard:
    !home <- Ui.Button(label=$"Home scores")
    !away <- Ui.Button(label=$"Away scores")
    $home <- 0 then $home + 1 on !home
    $away <- 0 then $away + 1 on !away
    let $leader = match Compare $home, $away:
        Less: "away"
        Greater: "home"
        Equal: "level"
    $armed <- @ArmSwitch
    let !shot = if $armed: unit on !home else: never
