# 01-semantics/book/ch-10-errors-and-faults.md, line 13
emit Ui.* | Fs.*

type Contents = record:
    text: Text

Message: fn ~Contents -> Text
fn Message (~ c) = c.text
fn Message (Error(kind=Fs.NotFound, ..)) = "no message today"
fn Message (Error(message=m, ..)) = "cannot read the message: {m}"

@motd:
    $~contents <- Fs.Contents(path="/etc/motd")             # 0
    Ui.Label(text=Message $~contents)                       # 1
