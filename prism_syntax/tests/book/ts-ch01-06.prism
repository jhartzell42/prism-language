# 02-type-system/book/ch-01-names-and-sigils.md, line 242
@viewer: @unit
@viewer:
    $path <- @TextInput "/etc/motd"
    $$~contents <- rebuild $path:
        Fs.Contents(path=_)
    let feed = (($$~contents))                     # plain: the stack is inside
    @Footer feed

@Footer: fn (($$~Contents)) -> @unit
fn @Footer feed:
    Ui.Label(text=$"Ready")
    @StatusLine feed

@StatusLine: fn (($$~Contents)) -> @unit
fn @StatusLine (($$~contents)):
    $~current <- @Flatten $$~contents
    Ui.Label(text=ShowResponse $~current)
