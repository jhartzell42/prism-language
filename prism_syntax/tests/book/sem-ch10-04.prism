# 01-semantics/book/ch-10-errors-and-faults.md, line 190
tag Prelude.Unwrap of Element !a where a: ^Show:
    value: !~a

type Exception = record:
    kind: Fault                        # the fault, or the reporter's own reason
    message: Text
    spans: [Span]                      # Prism source, in the order a reader follows
    path: ?Path                        # the subtree that gave up, when there is one

tag Prelude.Exceptions of Element !Exception
