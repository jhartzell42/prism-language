# 01-semantics/book/ch-04-blocks.md, line 107
@Booking: fn $Room, $Nat -> @!Nat
fn @Booking $room, $nights:
    $!asks <- rebuild $room:                                        # 0/#g
        Ui.Label(text=$"{_.name}, {_.beds} beds, {$nights} nights") # 0/#g/0
        !more <- Ui.Button(label=$"Another guest")                  # 0/#g/1
        $guests <- 1 then $guests + 1 on !more
        @ $guests on !more
    @Switch $!asks
