# 02-type-system/book/ch-03-traits.md, line 358
type Score = record:
    home: Nat
    away: Nat

type Game = record:
    teams: ((Text, Text))
    score: Score

Goal: fn Game -> Game
fn Goal g = Over &.score.home, g, \|n| n + 1

trait ^Lens l:
    type Whole
    type Part
    Get: fn l, Whole l -> Part l
    Set: fn l, Whole l, Part l -> Whole l

Over: fn l, Whole l, (fn Part l -> Part l) -> Whole l where l: ^Lens
fn Over l, w, F = Set l, w, (F (Get l, w))
