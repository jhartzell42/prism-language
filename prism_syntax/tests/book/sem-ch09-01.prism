# 01-semantics/book/ch-09-hosting-and-worlds.md, line 17
module Offline
emit r
use Net

@Offline: fn @a emit Net.* | r -> @a
fn @Offline @child:
    ((x, ignore)) <- @HostDocument @child, \|p, e| match e:
        Net.Http(..): @ never                           # o is !HttpResponse
        Net.Socket(..):                                 # o is ((!SocketEvent, $Link))
            @ ((never, $ (Disconnected "offline")))
        otherwise: @Element e                           # e is an Element r o
    @ x
