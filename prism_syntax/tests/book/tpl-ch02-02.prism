# 03-templates/book/ch-02-code-templates.md, line 124
@ModuleFile: fn $Module -> @$WriteState
fn @ModuleFile $m:
    emit Fs.*
    $text <- @Serialized (@RustText $m)
    Fs.Output(path=$m.path, text=$text)

@RustText: fn $Module -> @unit
fn @RustText $m = output <rust>
// generated from {{$m.path}}
{{
for name, $c <- $m.classes:
    @ClassText $c
}}
</rust>

@ClassText: fn $Class -> @unit
fn @ClassText $c = output <rust>
pub struct {{$c.name}} {
    {{Lines (Map FieldRs $c.fields)}}
}

<@VtableText c={{$c}}/>
</rust>
