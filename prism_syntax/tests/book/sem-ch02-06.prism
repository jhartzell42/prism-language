# 01-semantics/book/ch-02-lexical-structure.md, line 156
!delta                       # attached to a name: an event
@$?draft                     # attached three times: one token
$"Count: {$count}"           # attached to a text literal
$_                           # attached to the topic
&_.regs.acc                  # & attached to the topic, then field access
&.score.home                 # & attached to a field path: a lens value
^Ord                         # attached: a trait
? total                      # free: the optional holding total
~ contents                   # free: a fault that succeeded, holding contents
@ unit                       # free: the widget returning unit
$ supply                     # free: the constant dynamic of supply
@ ((!a, $b))                 # free, before a bracket
@((!a, $b))                  # the same tokens: a bracket is not a name character
