# 01-semantics/book/ch-10-errors-and-faults.md, line 217
Describe: fn ?Exception -> Text
fn Describe nil = "no exceptions"
fn Describe (? x) = "gave up: {x.message}"

@Restarting: fn @unit -> @unit
fn @Restarting @child:
    !gaveUp <- Prelude.Exceptions                           # 0
    !again <- Ui.Button(label=$"Restart")                   # 1
    $gen <- 0 then $gen + 1 on !again
    $?last <- nil then (? !gaveUp) <| (nil on !again)
    Ui.Label(text=Describe $?last)                          # 2
    ignore <- rebuild $gen:                                 # 3/#g
        @child

Body: fn Contents -> Text
fn Body c = c.text

@motdOnce:
    !started <- @started                                    # 0
    !~read <- Fs.File(path="/etc/motd", requests=(Read on !started))   # 1
    !read <- Prelude.Unwrap(value=!~read)                   # 2
    $text <- "(reading...)" then Body !read
    Ui.Label(text=$text)                                    # 3
