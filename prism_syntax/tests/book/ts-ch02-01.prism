# 02-type-system/book/ch-02-values-and-types.md, line 15
emit Ui.*

type Todo = record:
    label: Text
    done: Bool

type Filter = choice:
    All
    Active
    Finished

Visible: fn Filter, Todo -> Bool
fn Visible f, t = match f:
    All: True
    Active: not t.done
    Finished: t.done

@Row: fn $Todo -> @((!Click, !Click))
fn @Row $t:
    !toggle <- Ui.Button(label=$t.label)
    !remove <- Ui.Button(label=$"Remove")
    @ ((!toggle, !remove))
