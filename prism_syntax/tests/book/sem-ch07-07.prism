# 01-semantics/book/ch-07-ticks.md, line 358
@births:
    !again <- Ui.Button(label=$"Again")                     # 0
    $gen <- 0 then $gen + 1 on !again
    $!born <- rebuild $gen:                                 # 1/#g
        !started <- @started                                # 1/#g/0
        @ unit on !started
    !heard <- @Switch $!born
    $count <- 0 then $count + 1 on !heard
    Ui.Label(text=$"heard={$count}")                        # 2

test a_switch_hears_the_birth, @births:
    build
        => expect Ui.Label(text="heard=0")
    tick
        => expect Ui.Label(text="heard=1")
