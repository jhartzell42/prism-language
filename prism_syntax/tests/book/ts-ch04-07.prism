# 02-type-system/book/ch-04-expressions-and-lifting.md, line 239
Double: fn Int -> Int
fn Double n = n * 2

@doubles:
    !tap <- Ui.Button(label=$"Tap")
    $count <- 0 then $count + 1 on !tap
    let four = Double 2                     # plain
    let $twice = Double $count              # $Int: follows the count
    let !jump = Double (1 on !tap)          # !Int: fires 2 with the tap
