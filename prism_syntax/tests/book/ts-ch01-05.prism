# 02-type-system/book/ch-01-names-and-sigils.md, line 216
@Twice: fn @a -> @((a, a))
fn @Twice @inner:
    first <- @inner
    second <- @inner
    @ ((first, second))

@ballot: @unit
@ballot:
    (($left, $right)) <- @Twice (@TextInput "")
    ((!yes, !no)) <- @Twice (@Element Ui.Button(label=$"Vote"))
