# 02-type-system/book/ch-03-traits.md, line 182
trait ^Projects e:
    $LevelOf: fn e o -> $Level                       # plain fields, live fields now
    !EdgeOf: fn e o -> !Edge                         # the requests that fired
    $AnswerLevel: fn e o, o -> $Level                # the answer's level, for pushes
    !AnswerEdge: fn e o, o -> !Edge                  # the answer's edge, for answers
    Spell: fn e o, Level -> Text                     # the transcript's line

trait ^Responds e:
    @Answered: fn e o, @o, !Answer -> @o             # merge answers into an output
    !Answers: fn e o, o -> !Answer                   # and the way back out
