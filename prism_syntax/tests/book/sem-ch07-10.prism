# 01-semantics/book/ch-07-ticks.md, line 524
Normalize: unbounded fn Term -> Term
fn Normalize t = match ?Step t:
    ? t2: Normalize t2
    nil: t

@Normal: fn Term -> @unit
fn @Normal term:
    !done <- @Run Normalize, term                           # 0
    $shown <- "working" then Describe !done
    Ui.Label(text=$shown)                                   # 1
