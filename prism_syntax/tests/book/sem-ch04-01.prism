# 01-semantics/book/ch-04-blocks.md, line 15
emit Ui.*

type Question = record:
    prompt: Text
    truth: Bool

let owls = Question(prompt="Owls are birds", truth=True)
let bats = Question(prompt="Bats are birds", truth=False)
let questions = {1: owls, 2: bats}

?Score: fn (Nat ==> Bool) -> ?Nat
fn ?Score marks:
    require (Size marks) == (Size questions)
    ? Len (Filter (Values marks), \|right| right)

@quiz: @unit
@quiz:
    !again <- Ui.Button(label=$"Start over")                        # 0
    $round <- 1 then $round + 1 on !again
    $!rounds <- rebuild $round:                                     # 1/#g
        Ui.Label(text=$"Round {_}")                                 # 1/#g/0
        for id, q <- questions:                                     # 1/#g/1/[id]
            Ui.Label(text=$ q.prompt)                               # .../[id]/0
            !yes <- Ui.Button(label=$"True")                        # .../[id]/1
            !no <- Ui.Button(label=$"False")                        # .../[id]/2
            @ q.truth on !yes <| (not q.truth) on !no
    !marks <- @Switch $!rounds
    $answers <- {} then {} on !again <| (Union !marks, $answers)
    let $verdict = match ?Score $answers:
        ? n: "{n} right"
        nil: "keep going"
    Ui.Label(text=$verdict)                                         # 2
