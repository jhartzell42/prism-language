# 01-semantics/book/ch-11-purity.md, line 12
@twice:
    !flip <- Ui.Button(label=$"Flip")                       # 0
    $mode <- Editing then Flip $mode on !flip
    $!panel <- rebuild $mode:                               # 1/#g
        @PanelFor _
    !one <- @Switch $!panel
    !two <- @Switch $!panel
    $same <- True then Agree (!Align !one, !two)
    Ui.Label(text=$"{$same}")                               # 2
