# 01-semantics/book/ch-05-and-blocks.md, line 322
type IdentsState = record:
    v: Nat
    c: Cursor

Idents: fn Text -> Nat
fn Idents src = (Loop IdentsState(v=0, c=Start src)).v

Loop: fn IdentsState -> IdentsState
fn Loop s = match ?Step s.c:
    ? ((ch, next)) if IsLetter ch: Loop IdentsState(v=s.v + 1, c=SkipWord next)
    ? ((ignore, next)): Loop IdentsState(v=s.v, c=next)
    nil: s
