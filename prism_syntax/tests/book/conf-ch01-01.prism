# 04-conformance/book/ch-01-the-test-language.md, line 18
emit Ui.* | Fs.*

@motd:
    !started <- @started                                              # 0
    !motd <- Fs.File(path="/etc/motd", requests=(Read on !started))   # 1
    $text <- "(reading...)" then ShowResponse !motd
    Ui.Label(text=$text)                                              # 2
