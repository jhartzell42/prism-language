# 01-semantics/book/ch-07-ticks.md, line 249
@relay:
    !every <- Time.Every(period=1s)                         # 0
    $mode <- Quiet then Toggle $mode on !every
    $!inner <- rebuild $mode:                               # 1/#g
        match _:
            Quiet: @ never
            Doubling: @Doubled !out
    !heard <- @Switch $!inner
    let !out = !heard <| 1 on !every
    $last <- 0 then !out
    Ui.Label(text=$"last: {$last}")                         # 2
