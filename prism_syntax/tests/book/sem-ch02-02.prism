# 01-semantics/book/ch-02-lexical-structure.md, line 29
emit Ui.*

# a thermostat that remembers the coldest and warmest settings
@thermostat: @unit
@thermostat:
    !down <- Ui.Button(label=$"-1")
    !up <- Ui.Button(label=$"+1")
    let !step = -1 on !down <| +1 on !up
    $target <- 20 then $target + !step
    $low <- 20 then Min $low, $target + !step
    $high <- 20 then Max $high, $target + !step
    Ui.Label(text="Set to {$target}, seen {$low} to {$high}")

check range_widens:
    (((Min 18, 20), (Max 22, 20))) == ((18, 22))
