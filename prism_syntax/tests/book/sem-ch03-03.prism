# 01-semantics/book/ch-03-syntax.md, line 88
@editor: @$Text
@editor:
    let width = 40                                       # let: a name, nothing built
    !typed <- Ui.TextInput(name="draft", text=$text)     # bind: an element, emitted
    $text <- "" then !typed                              # hold: state
    @counter                                             # bare blueprint: unit
    Ui.Label(text=$"{Len $text} of {width} chars")       # bare element: unit
    ignore <- rebuild $text:                             # rebuild: result discarded
        Fs.Write(path="draft.txt", contents=_)
    @ $text                                              # last line: the result
