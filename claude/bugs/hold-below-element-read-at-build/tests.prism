# The reads at the build of names bound below: declarations of
# hold-below-element-read-at-build. Written by Claude on the claude-widget-plain branch;
# subject to change.
emit Ui.* | Pad.*
use App.*

test a_build_reads_names_bound_below, @page:
    with Pad.Door(name="front") = "door 1", build
        => expect Ui.Label(text="door 1, hello x")
        => returns "door 1"
