cabal-version:      2.4
name:               prism-hs
version:            0.1.0.0
build-type:         Simple

library
    exposed-modules:  Prism.Syntax, Prism.Lexer, Prism.Parser, Prism.Value, Prism.Runtime, Prism.Eval, Prism.World, Prism.Test
    hs-source-dirs:   src
    build-depends:    base, containers, mtl, text
    default-language: Haskell2010
    ghc-options:      -Wall -Wno-name-shadowing -Wno-unused-matches -Wno-unused-do-bind -Wno-incomplete-patterns -Wno-incomplete-uni-patterns

executable prism-hs
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base, prism-hs, containers, text
    default-language: Haskell2010
