# Documents: the hosting library. A document is what seats take part in; this module holds
# what every document shares: the response, the step's result, the trait a role's seat type
# implements, the order of one tick's requests, what a role's host does with its seats,
# and the in-memory implementation, written once.
# Written by Claude on the claude-document-chess branch; subject to change.
emit rest | Seat.*

# A request's response: accepted, or declined with a reason of the role's own type `a`.
type Response a = choice:
    Accepted
    Declined a
derive ^Eq, ^Show

# What a step gives: the next state, or a denial and its reason.
type Stepped s d = choice:
    Next s
    Denied d
derive ^Eq, ^Show

# One role of one document. A value of `r` is one seat of the role: `Player White`,
# `Spectator "ada"`. The associated types are the role's facts, and `Step` and `Read` are
# its pure rules, each taking the seat that asks. What a seat is told is `Told`: the
# prelude owns `Output`, the type of an element's output in `@HostList`.
trait ^Seat r:
    type State                          # the document's state, the same for every role
    type Request                        # what this role may ask to change
    type Reason                         # why a request of this role is declined
    type Query                          # what this role may ask to know
    type Told                           # what this role is told
    Step: fn State r, r, Request r -> Stepped (State r) (Reason r)
    Read: fn State r, r, Query r -> Told r

# A participant leaves its seat: every role's language has this tag.
tag Seat.Leave of Element:
    !leaves: unit

# Where a request is made: the seat, as a value of the document's seat type `k`, and the
# place within the seat's guest. Places order by seat, then by place.
type Place k = record:
    seat: k
    at: Path
derive ^Eq, ^Ord, ^Show

# A response on its way to the place that asked: the seat, as a value of the role's own
# seat type `k`, the place within the seat's guest, and the response, its reason of that
# role's own type `a`. A role's seat and another role's reason are never in one of these.
type Responded k a = record:
    seat: k
    at: Path
    response: Response a
derive ^Eq, ^Show

# What one request does to the document: the next state or none, and either way what the
# place that asked is sent, as a value of the document's type `d`.
type Took s d = choice:
    Moved s, d
    Stayed d

# One request as the implementation takes it: its place, and the step it asks for, with
# the seat and the request already inside. This is what lets one implementation take the
# requests of every role: the role's types end here.
type Asked s k d = record:
    place: Place k
    step: fn s -> Took s d

# A role's step as the implementation takes it. `Raise` makes the role's response one of
# the document's type: a document with several requesting roles has a choice over them.
Taken: fn (fn Responded k a -> d), k, Path, Stepped s a -> Took s d
fn Taken Raise, seat, at, (Next state) = Moved state, (Raise Responded(seat=seat, at=at, response=Accepted))
fn Taken Raise, seat, at, (Denied why) = Stayed (Raise Responded(seat=seat, at=at, response=(Declined why)))

# A request of a document with one requesting role, whose responses are that role's.
Asking: fn r, Path, Request r -> Asked (State r) r (Responded r (Reason r)) where r: ^Seat
fn Asking seat, at, request = Asked(place=Place(seat=seat, at=at), step=(\|state| Taken (\|responded| responded), seat, at, (Step state, seat, request)))

# A request of a document with several requesting roles: `Among` makes the role's seat one
# of the document's seat type, and `Raise` its response one of the document's.
AskingAs: fn (bounded fn r -> k), (bounded fn Responded r (Reason r) -> d), r, Path, Request r -> Asked (State r) k d where r: ^Seat
fn AskingAs Among, Raise, seat, at, request = Asked(place=Place(seat=(Among seat), at=at), step=(\|state| Taken Raise, seat, at, (Step state, seat, request)))

# ---- what a role's host tells the implementation

# A request a seat's guest makes, or that the program removes a seat. A removed seat's
# requests go with it, those of this tick and those that wait from earlier ticks.
type Notice s k d = choice:
    Brought (Asked s k d)
    Kicked k

Brings: fn [Notice s k d] -> [Asked s k d]
fn Brings notices = Fold notices, [[]], \|all, one| match one:
    Brought asked: Push all, asked
    Kicked seat: all

Kicks: fn [Notice s k d] -> [k]
fn Kicks notices = Fold notices, [[]], \|all, one| match one:
    Brought asked: all
    Kicked seat: Push all, seat

# ---- the order of one tick's requests

# What a document does with the requests that are due in a tick: which it applies in this
# tick, in the order listed, and which wait for the next tick.
type Ordered s k d = record:
    apply: [Asked s k d]
    wait: [Asked s k d]

# The default order: one request a tick. The requests due are those that waited, the
# longest first, then this tick's own by place; the first is applied and each other waits
# a tick, so no request is declined for arriving with another.
OneATick: fn [Asked s k d] -> Ordered s k d
fn OneATick due = Ordered(apply=(Take due, 1), wait=(Drop due, 1))

# This tick's own requests by place: by the document's seat order, then by place in the
# seat's guest.
ByPlace: fn [Asked s k d] -> [Asked s k d] where k: ^Ord
fn ByPlace asked = Values (Fold asked, {{}}, \|all, one| Insert all, one.place, one)

Has: fn [k], k -> Bool where k: ^Eq
fn Has seats, seat = Fold seats, False, \|found, one| found or one == seat

# The state after some requests of one tick, the responses in the order the requests were
# applied, whether any was accepted, and the requests that wait.
type Kept s k d = record:
    state: s
    responses: [d]
    moved: Bool
    waiting: [Asked s k d]

StepOne: fn Kept s k d, Asked s k d -> Kept s k d
fn StepOne kept, asked:
    let Apply = asked.step
    match Apply kept.state:
        Moved state, response: Kept(state=state, responses=(Push kept.responses, response), moved=True, waiting=kept.waiting)
        Stayed response: Kept(state=kept.state, responses=(Push kept.responses, response), moved=kept.moved, waiting=kept.waiting)

# One tick: the requests that waited and those that arrived are due, but for those of a
# seat the program removes in this tick; the document's order says which are applied, each
# against the state the one before left, and which wait.
StepTick: fn (fn [Asked s k d] -> Ordered s k d), s, [Asked s k d], [Notice s k d] -> Kept s k d where k: ^Ord
fn StepTick Order, state, waiting, notices:
    let kicked = Kicks notices
    let staying = Filter waiting, \|asked| not (Has kicked, asked.place.seat)
    let turn = Order (Append staying, (ByPlace (Brings notices)))
    Fold turn.apply, Kept(state=state, responses=[[]], moved=False, waiting=turn.wait), StepOne

?StateOf: fn Kept s k d -> ?s
fn ?StateOf kept = if kept.moved: ? kept.state else: nil

ResponsesOf: fn Kept s k d -> [d]
fn ResponsesOf kept = kept.responses

WaitingOf: fn Kept s k d -> [Asked s k d]
fn WaitingOf kept = kept.waiting

?StillWaiting: fn Kept s k d -> ?unit
fn ?StillWaiting kept = if (Len kept.waiting) == 0: nil else: ? unit

# ---- the in-memory implementation, for every document

# One hold for the state, one for the requests that wait. `HostSeats` is the document's
# own function that hosts its seats; it is given the state and each tick's responses, and
# gives back each tick's notices. `Order` is the document's order of one tick's requests.
# A request that waits is due again a tick later, by the runtime's `@Defer`: no World is
# asked for the time.
@InMemoryOrdered: fn s, (fn [Asked s k d] -> Ordered s k d), (fn $s, ![d] -> @![Notice s k d] emit rest) -> @unit emit rest where k: ^Ord
fn @InMemoryOrdered initial, Order, HostSeats:
    !arrived <- HostSeats $state, (ResponsesOf !outcome)
    !again <- @Defer (!Filter (?StillWaiting !outcome))     # a tick after a request waits
    let !due = !arrived <| ([[]] on !again)
    let !outcome = StepTick Order, $state, $waiting, !due
    $state <- initial then !Filter (?StateOf !outcome)      # the hold
    $waiting <- [[]] then WaitingOf !outcome

# The same with the default order.
@InMemory: fn s, (fn $s, ![d] -> @![Notice s k d] emit rest) -> @unit emit rest where k: ^Ord
fn @InMemory initial, HostSeats = @InMemoryOrdered initial, OneATick, HostSeats

# ---- what a participant is written with

# A dynamic's values as an event: the one it has when the block is built, and each change.
# A participant that acts on what it is told acts on its first answer too.
@Told: fn $a -> @!a emit r
fn @Told $value:
    !first <- @started
    @ (!Updated $value) <| ($value on !first)

# ---- what a role's host is written with

# A seat's guest, built: the blueprint that sits there now, and built again when another
# takes the seat.
@Sitting: fn $(@a emit r) -> @$a emit r
fn @Sitting $@guest:
    rebuild $@guest:
        _

# What a seat's request place is sent: its own response of this tick, if any.
?ResponseTo: fn k, Path, [Responded k a] -> ?(Response a) where k: ^Eq
fn ?ResponseTo seat, at, responded = Fold responded, nil, \|?found, one| if one.seat == seat and one.at == at: ? one.response else: ?found

# One role's responses out of a tick's, for a document with several requesting roles:
# `Mine` gives a response of this role out of the document's type, and nil for a
# response of another role, which is another role's host's to pass on.
Among: fn (fn d -> ?a), [d] -> [a]
fn Among Mine, responded = Fold responded, [[]], \|all, one| match Mine one:
    ? mine: Push all, mine
    nil: all

# when a participant leaves, out of one place of its guest
!LeavesOf: fn Elem (rest | Seat.*) -> !unit
fn !LeavesOf element = match element:
    Seat.Leave(!leaves=!leaves): !leaves
    otherwise: never

# What a role's host hears from one place of a seat's guest: a request, or that the
# participant leaves. A participant that asks and leaves at once fires both in one tick,
# each from its own element.
type Heard a = choice:
    Requested a
    Leaving

# What happens to one role's seats in one tick: `v` is what sits at a seat, a blueprint.
# The first two are the program's doing, the third the participants': which is how a seat
# the program removes is told from a seat whose participant leaves.
type Happening k v a = choice:
    Seating (k ==> v)                                   # the program seats these, or changes what sits there
    Removing [k]                                        # the program removes these
    Hearing (k ==> (Path ==> [Heard a]))                # what each seat's guest fired, by place

# the seats the program removes in a tick
Removed: fn [Happening k v a] -> [k]
fn Removed happenings = Fold happenings, [[]], \|all, one| match one:
    Removing seats: Append all, seats
    Seating more: all
    Hearing heard: all

# everything one seat's guest fired in a tick, in the order of its places
FiredBy: fn (Path ==> [Heard a]) -> [Heard a]
fn FiredBy places = Fold (Values places), [[]], Append

RequestsAmong: fn [Heard a] -> [a]
fn RequestsAmong heard = Fold heard, [[]], \|all, one| match one:
    Requested request: Push all, request
    Leaving: all

Departs: fn [Heard a] -> Bool
fn Departs heard = Fold heard, False, \|gone, one| match one:
    Requested request: gone
    Leaving: True

# A map's entries in key order. The prelude lists a map's keys and its values and has no
# function for the two together, so each key is looked up again; a key `Keys` lists is in
# the map, and the `nil` arm is never taken.
Entries: fn (k ==> v) -> [((k, v))] where k: ^Ord
fn Entries entries = Fold (Keys entries), [[]], \|all, listed| match ?Get entries, listed:
    ? value: Push all, ((listed, value))
    nil: all

# The requests a role's host passes on in a tick. A seat the program removes in this tick
# is gone first: its requests of this tick are dropped. A seat whose participant leaves in
# this tick goes after them: its requests of this tick are passed on.
RequestsOf: fn [Happening k v a] -> [a] where k: ^Ord
fn RequestsOf happenings:
    let removed = Removed happenings
    Fold happenings, [[]], \|all, one| match one:
        Hearing heard: Fold (Entries heard), all, \|some, ((seat, places))| if Has removed, seat: some else: Append some, (RequestsAmong (FiredBy places))
        Seating more: all
        Removing gone: all

# What a role's host gives the implementation for a tick: the seats the program removes,
# each as a seat of the document's type by `Raise`, and the requests passed on.
?Notices: fn (fn r -> k), [Happening r v (Asked s k d)] -> ?[Notice s k d] where r: ^Ord
fn ?Notices Raise, happenings:
    let kicks = Each (Removed happenings), \|seat| Kicked (Raise seat)
    let all = Fold (RequestsOf happenings), kicks, \|some, asked| Push some, (Brought asked)
    if (Len all) == 0: nil else: ? all

# The role's seats after a tick: those the program seats come, those it removes go, and
# those whose participant leaves go.
Reseated: fn (k ==> v), [Happening k v a] -> (k ==> v) where k: ^Ord
fn Reseated seats, happenings = Fold happenings, seats, \|now, one| match one:
    Seating more: Fold (Entries more), now, \|all, ((seat, guest))| Insert all, seat, guest
    Removing gone: Fold gone, now, Remove
    Hearing heard: Fold (Entries heard), now, \|still, ((seat, places))| if Departs (FiredBy places): Remove still, seat else: still
