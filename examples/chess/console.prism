# The console: a terminal that reads a line and prints lines, and nothing else. No cursor,
# no redraw: a shell script, a teletype or a person reading moves off a wooden board can
# stand at the other end. A terminal is named; its reading element and its printing element
# name the same terminal.
# Written by Claude on the claude-document-chess branch; subject to change.
emit Console.*

# Each firing is one line typed at the terminal, without its line end.
tag Console.Read of Element !Text:
    name: Text                         # which terminal

# Each firing of `!lines` is the lines to print at the terminal, in order.
tag Console.Print of Element:
    name: Text
    !lines: [Text]
